---
import MarketingNavActions from '@/components/navigation/marketing/MarketingNavActions.astro';
import MarketingNavLink from '@/components/navigation/marketing/MarketingNavLink.astro';
import { MARKETING_NAV_ICONS } from '@/lib/nav/marketingNavIcons';
import { isMarketingDirectLinkCurrent } from '@/lib/nav/marketingNavigation';
import type {
  MarketingNavAction,
  MarketingNavDirectLink,
  ResolvedMarketingNavGroup,
} from '@/lib/nav/marketingNavigation';

interface Props {
  id: string;
  groups: ResolvedMarketingNavGroup[];
  directLinks: readonly MarketingNavDirectLink[];
  primary: MarketingNavAction;
  secondary: MarketingNavAction;
}

const { id, groups, directLinks, primary, secondary } = Astro.props;
const pathname = Astro.url.pathname;
const insightsLink = directLinks.find((link) => link.id === 'insights');
const remainingDirectLinks = directLinks.filter((link) => link.id !== 'insights');
---

<div id={id} class="mnav-hub" data-mnav-hub hidden inert>
  <div class="mnav-hub__scroll">
    <p class="mnav-hub__context">Booking software for UK barbershops</p>
    <nav class="mnav-hub__nav" aria-label="Main">
      <ul class="mnav-hub__list" role="list">
        {insightsLink ? (
          <li class="mnav-hub__group mnav-hub__group--editorial">
            <a
              class="mnav-hub__row mnav-hub__row--editorial"
              href={insightsLink.href}
              data-mnav-match={insightsLink.href}
              data-mnav-match-prefix={insightsLink.matchPrefix}
              aria-current={isMarketingDirectLinkCurrent(insightsLink, pathname) ? 'page' : undefined}
            >
              <span class="mnav-hub__row-label">Insights</span>
              <span class="mnav-hub__editorial-hint">FOR UK BARBERS <span aria-hidden="true">↗</span></span>
            </a>
          </li>
        ) : null}
        {
          groups.map((group) => (
            <li class="mnav-hub__group">
              <button
                type="button"
                class="mnav-hub__row mnav-hub__row--toggle"
                aria-expanded="false"
                aria-controls={`${id}-${group.id}`}
                data-mnav-accordion={group.id}
              >
                <span class="mnav-hub__row-label">{group.label}</span>
                <span class="mnav-hub__chevron" aria-hidden="true" />
              </button>
              <div id={`${id}-${group.id}`} class="mnav-hub__section" hidden>
                {group.description ? <p class="mnav-hub__lead">{group.description}</p> : null}
                {group.featured.length ? (
                  <ul class="mnav-hub__items mnav-hub__items--featured" role="list">
                    {group.featured.map((item) => (
                      <li>
                        <MarketingNavLink item={item} featured />
                      </li>
                    ))}
                  </ul>
                ) : null}
                {group.sections.map((section) => (
                  <div class="mnav-hub__subsection">
                    {section.label ? <p class="mnav-hub__section-label">{section.label}</p> : null}
                    <ul class="mnav-hub__items" role="list">
                      {section.items.map((item) => (
                        <li>
                          <MarketingNavLink item={item} />
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
                {group.featuredAction ? (
                  <a class="mnav-hub__action" href={group.featuredAction.href}>
                    {group.featuredAction.label}
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d={MARKETING_NAV_ICONS.arrow} />
                    </svg>
                  </a>
                ) : null}
              </div>
            </li>
          ))
        }
        {
          remainingDirectLinks.map((link) => (
            <li class="mnav-hub__group">
              <a
                class="mnav-hub__row"
                href={link.href}
                data-mnav-section={link.sectionId}
                data-mnav-match={link.sectionId ? undefined : link.href}
                data-mnav-match-prefix={link.matchPrefix}
                aria-current={isMarketingDirectLinkCurrent(link, pathname) ? 'page' : undefined}
              >
                <span class="mnav-hub__row-label">{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <MarketingNavActions class="mnav-hub__actions" primary={primary} secondary={secondary} />
</div>
