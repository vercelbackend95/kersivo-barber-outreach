---
import MarketingNavActions from '@/components/navigation/marketing/MarketingNavActions.astro';
import MarketingNavLink from '@/components/navigation/marketing/MarketingNavLink.astro';
import { MARKETING_NAV_ICONS } from '@/lib/nav/marketingNavIcons';
import { buildMarketingNavTopLevelEntries } from '@/lib/nav/marketingNavigation';
import type {
  MarketingNavAction,
  MarketingNavDirectLink,
  ResolvedMarketingNavGroup,
} from '@/lib/nav/marketingNavigation';

interface Props {
  id: string;
  groups: ResolvedMarketingNavGroup[];
  directLinks: readonly MarketingNavDirectLink[];
  primary: MarketingNavAction;
  secondary: MarketingNavAction;
}

const { id, groups, directLinks, primary, secondary } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const navEntries = buildMarketingNavTopLevelEntries(groups, directLinks);
---

<div id={id} class="mnav-hub" data-mnav-hub hidden inert>
  <div class="mnav-hub__scroll">
    <p class="mnav-hub__context">Booking software for UK barbershops</p>
    <nav class="mnav-hub__nav" aria-label="Main">
      <ul class="mnav-hub__list" role="list">
        {
          navEntries.map((entry) => entry.kind === 'group' ? (
            <li class="mnav-hub__group">
              <button
                type="button"
                class="mnav-hub__row mnav-hub__row--toggle"
                aria-expanded="false"
                aria-controls={`${id}-${entry.group.id}`}
                data-mnav-accordion={entry.group.id}
              >
                <span class="mnav-hub__row-label">{entry.group.label}</span>
                <span class="mnav-hub__chevron" aria-hidden="true" />
              </button>
              <div id={`${id}-${entry.group.id}`} class="mnav-hub__section" hidden>
                {entry.group.description ? <p class="mnav-hub__lead">{entry.group.description}</p> : null}
                {entry.group.featured.length ? (
                  <ul class="mnav-hub__items mnav-hub__items--featured" role="list">
                    {entry.group.featured.map((item) => (
                      <li>
                        <MarketingNavLink item={item} featured />
                      </li>
                    ))}
                  </ul>
    </nav>
  </div>
  <MarketingNavActions class="mnav-hub__actions" primary={primary} secondary={secondary} />
</div>
