---
import { isMarketingNavSelfHref, type MarketingNavAction } from '@/lib/nav/marketingNavigation';
import { getRouteFamily } from '@/lib/navigation/routeFamilies';

interface Props {
  primary: MarketingNavAction;
  secondary: MarketingNavAction;
  class?: string;
}

const { primary, secondary, class: className } = Astro.props;
const showPrimary = !isMarketingNavSelfHref(primary.href, Astro.url.pathname);
const family = getRouteFamily(Astro.url.pathname);
const leavesFamily = (href: string | null) => (href ? getRouteFamily(new URL(href, Astro.url).pathname) !== family : false);
// The price suffix sits in its own span so narrow desktop bars can drop it (see marketing-navbar.css).
const priceSuffix = primary.label.match(/\s*—\s*£\d+\/month$/)?.[0] ?? '';
const primaryLead = priceSuffix ? primary.label.slice(0, -priceSuffix.length) : primary.label;
---

<div class:list={['mnav-actions', className]}>
  {
    secondary.href ? (
      <a class="btn btn--outline btn--sm mnav-btn mnav-btn--secondary" href={secondary.href} data-astro-reload={leavesFamily(secondary.href) ? '' : undefined}>
        {secondary.label}
      </a>
    ) : null
  }
  {
    showPrimary && primary.href ? (
      <a
        class="btn btn--primary btn--sm mnav-btn mnav-btn--primary"
        href={primary.href}
        data-track={primary.track}
        data-track-placement={primary.track === 'preview_cta_click' ? 'navbar' : undefined}
        data-astro-reload={leavesFamily(primary.href) ? '' : undefined}
      >
        {primaryLead}{priceSuffix && <span class="mnav-btn__price">{priceSuffix}</span>}
      </a>
    ) : showPrimary ? (
      <button type="button" class="btn btn--primary btn--sm mnav-btn mnav-btn--primary">
        {primaryLead}{priceSuffix && <span class="mnav-btn__price">{priceSuffix}</span>}
      </button>
    ) : null
  }
</div>
