---
import ProcessTimeline from '@/components/editorial/ProcessTimeline.astro';
import {
  FRESHA_SWITCHING_LIMITS,
  FRESHA_SWITCHING_REASSURANCE,
  FRESHA_SWITCHING_STEPS,
  FRESHA_SWITCHING_TITLE,
} from '@/lib/seo/freshaAlternativeContent';
---

<section id="switching" class="fj-section fj-switching" aria-labelledby="fresha-switching-title" data-fj-act="IV">
  <div class="fj-wrap">
    <header class="fj-head">
      <p class="fj-act-label"><span>Act IV</span> The switch</p>
      <h2 id="fresha-switching-title" class="fj-h2">{FRESHA_SWITCHING_TITLE}</h2>
      <p class="fj-lead">{FRESHA_SWITCHING_REASSURANCE} Your clients keep booking as normal until you approve the change.</p>
    </header>

    <ProcessTimeline
      steps={FRESHA_SWITCHING_STEPS}
      noteTitle="Good to know"
      notePoints={FRESHA_SWITCHING_LIMITS}
    >
      <a href="#contact">Ask about moving your Fresha data <span aria-hidden="true">→</span></a>
    </ProcessTimeline>
  </div>
</section>
