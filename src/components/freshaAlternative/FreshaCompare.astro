---
import {
  BarChart3,
  CalendarDays,
  ChevronDown,
  CircleCheck,
  CircleDot,
  CreditCard,
  Globe2,
  ShoppingBag,
  UsersRound,
} from 'lucide-react';

type ComparisonSection = {
  id: string;
  title: string;
  subtitle: string;
  icon: typeof CalendarDays;
  freshaLead: string;
  freshaPoints: string[];
  kersivoLead: string;
  kersivoPoints: string[];
};

const sections: ComparisonSection[] = [
  {
    id: 'bookings',
    title: 'Bookings',
    subtitle: 'Compare the client booking journey and day-to-day scheduling.',
    icon: CalendarDays,
    freshaLead: 'A powerful booking stack inside the Fresha ecosystem.',
    freshaPoints: [
      'Direct booking links, website bookings and Fresha Marketplace',
      'Advanced calendar and scheduling tools',
      'Deposits, upfront payments and no-show policies',
      'Automated booking notifications and reminders',
    ],
    kersivoLead: 'A branded booking journey built around your own barbershop.',
    kersivoPoints: [
      'Branded booking website on your own domain',
      'Services, barbers and availability inside your own flow',
      'Deposits and payment steps built into the booking journey',
      'Bookings managed from one owner dashboard',
    ],
  },
  {
    id: 'payments',
    title: 'Payments & Deposits',
    subtitle: 'How each platform protects bookings and handles payment steps.',
    icon: CreditCard,
    freshaLead: 'Payments, deposits and no-show protection integrated with Fresha.',
    freshaPoints: [
      'Fresha Payments supports deposits and upfront payments',
      'Card capture and no-show payment policies',
      'Online and in-person payment options',
      'Payment activity connected to Fresha reporting',
    ],
    kersivoLead: 'Payment protection inside your own branded booking journey.',
    kersivoPoints: [
      'Optional booking deposits for online appointments',
      'Deposit status visible in the KERSIVO admin',
      'Client payment steps stay connected to your booking flow',
      '0% KERSIVO commission on bookings',
    ],
  },
  {
    id: 'brand',
    title: 'Brand & Domain',
    subtitle: 'Where the client journey lives and whose brand stays in front.',
    icon: Globe2,
    freshaLead: 'Fresha combines direct booking links with its own platform and marketplace.',
    freshaPoints: [
      'Booking links can be shared from your website, social and ads',
      'Marketplace discovery can bring new clients into Fresha',
      'The booking infrastructure remains part of the Fresha ecosystem',
      'Your business operates alongside the Fresha brand',
    ],
    kersivoLead: 'Your website and booking journey stay under your own identity.',
    kersivoPoints: [
      'Your own branded website on your own domain',
      'Your logo, services and shop identity throughout the journey',
      'No marketplace dependency required to take bookings',
      'A direct client relationship built around your business',
    ],
  },
  {
    id: 'retail',
    title: 'Retail & Upsells',
    subtitle: 'How products and post-booking sales fit into the customer journey.',
    icon: ShoppingBag,
    freshaLead: 'Retail, inventory and online product sales inside Fresha.',
    freshaPoints: [
      'Online product store with pickup and shipping options',
      'Inventory and order management in the Fresha workspace',
      'POS tools for services, products and add-ons',
      'Fresha Payments is required for the online product store',
    ],
    kersivoLead: 'Retail pickup built directly into your own barbershop website.',
    kersivoPoints: [
      'Products sold from your own branded website',
      'Pickup orders managed from the KERSIVO admin',
      'Product recommendations can appear after a booking',
      '0% KERSIVO commission on retail sales',
    ],
  },
  {
    id: 'clients',
    title: 'Clients & Communication',
    subtitle: 'CRM, reminders and the relationship after the appointment.',
    icon: UsersRound,
    freshaLead: 'Deep client-management tools inside the Fresha platform.',
    freshaPoints: [
      'Client profiles, booking history, notes and forms',
      'Automated reminders across supported channels',
      'Two-way client communication inside Fresha',
      'Loyalty and retention tools available in the platform',
    ],
    kersivoLead: 'Client records connected directly to your own booking operation.',
    kersivoPoints: [
      'Client profiles and booking history in your admin',
      'Internal notes and operational client context',
      'Email and SMS appointment reminder workflows',
      'The relationship starts from your own website and brand',
    ],
  },
  {
    id: 'reports',
    title: 'Reports & Admin',
    subtitle: 'The owner view behind bookings, clients, team and performance.',
    icon: BarChart3,
    freshaLead: 'Broad operational reporting across the Fresha workspace.',
    freshaPoints: [
      'Reporting tied to bookings, payments and business activity',
      'Team, client and sales management tools',
      'Calendar and operational controls in one platform',
      'Retail, POS and payment activity can feed into reporting',
    ],
    kersivoLead: 'A focused owner dashboard built specifically for independent barbershops.',
    kersivoPoints: [
      'Bookings, team, clients, services, products and orders',
      'Sales, bookings and cancellation reporting',
      'Daily operational view from one dashboard',
      'Built around the workflow of an independent barbershop',
    ],
  },
];
---

<section
  id="comparison"
  class="fresha-alt-compare scroll-mt-24"
  aria-labelledby="fresha-alt-compare-title"
  data-fresha-comparison
>
  <div class="fresha-alt-compare__container">
    <header class="fresha-alt-compare__header">
      <p class="fresha-alt-compare__eyebrow">COMPARISON</p>
      <h2 id="fresha-alt-compare-title" class="fresha-alt-compare__title">
        KERSIVO <span>vs</span> Fresha
      </h2>
      <p class="fresha-alt-compare__lead">
        Two different ways to run a barbershop. Open each category and compare the parts that
        matter to your brand, bookings and client journey.
      </p>
    </header>

    <div class="fresha-alt-compare__accordion">
      {sections.map((section, index) => {
        const Icon = section.icon;

        return (
          <article
            class="fresha-alt-compare__item"
            data-comparison-item
            data-open="false"
          >
            <button
              id={`fresha-compare-trigger-${section.id}`}
              type="button"
              class="fresha-alt-compare__summary"
              aria-expanded="false"
              aria-controls={`fresha-compare-panel-${section.id}`}
              data-comparison-trigger
            >
              <span class="fresha-alt-compare__summary-icon" aria-hidden="true">
                <Icon size={19} strokeWidth={1.8} />
              </span>

              <span class="fresha-alt-compare__summary-copy">
                <span class="fresha-alt-compare__summary-kicker">
                  {String(index + 1).padStart(2, '0')} / 06
                </span>
                <strong>{section.title}</strong>
                <span>{section.subtitle}</span>
              </span>

              <ChevronDown
                className="fresha-alt-compare__chevron"
                size={20}
                strokeWidth={1.8}
                aria-hidden="true"
              />
            </button>

            <div
              class="fresha-alt-compare__reveal"
              data-comparison-reveal
              aria-hidden="true"
            >
              <div
                id={`fresha-compare-panel-${section.id}`}
                class="fresha-alt-compare__reveal-inner"
                role="region"
                aria-labelledby={`fresha-compare-trigger-${section.id}`}
                data-comparison-reveal-inner
                inert
              >
                <div class="fresha-alt-compare__panel">
              <article class="fresha-alt-compare__provider fresha-alt-compare__provider--fresha">
                <div class="fresha-alt-compare__provider-label">FRESHA ECOSYSTEM</div>
                <div class="fresha-alt-compare__provider-head">
                  <span class="fresha-alt-compare__brand-mark fresha-alt-compare__brand-mark--fresha" aria-hidden="true">
                    fresha
                  </span>
                  <div>
                    <p class="fresha-alt-compare__provider-name">Fresha</p>
                    <p class="fresha-alt-compare__provider-lead">{section.freshaLead}</p>
                  </div>
                </div>

                <ul class="fresha-alt-compare__points">
                  {section.freshaPoints.map((point) => (
                    <li>
                      <CircleDot
                        className="fresha-alt-compare__point-icon fresha-alt-compare__point-icon--neutral"
                        size={15}
                        strokeWidth={1.8}
                        aria-hidden="true"
                      />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </article>

              <div class="fresha-alt-compare__vs" aria-hidden="true">VS</div>

              <article class="fresha-alt-compare__provider fresha-alt-compare__provider--kersivo">
                <div class="fresha-alt-compare__provider-label fresha-alt-compare__provider-label--kersivo">
                  YOUR OWN BRAND
                </div>
                <div class="fresha-alt-compare__provider-head">
                  <span class="fresha-alt-compare__brand-mark fresha-alt-compare__brand-mark--kersivo" aria-hidden="true">
                    <img src="/images/logo-kersivo.png" alt="" width="72" height="72" loading="lazy" decoding="async" />
                  </span>
                  <div>
                    <p class="fresha-alt-compare__provider-name">KERSIVO</p>
                    <p class="fresha-alt-compare__provider-lead">{section.kersivoLead}</p>
                  </div>
                </div>

                <ul class="fresha-alt-compare__points">
                  {section.kersivoPoints.map((point) => (
                    <li>
                      <CircleCheck
                        className="fresha-alt-compare__point-icon fresha-alt-compare__point-icon--yes"
                        size={16}
                        strokeWidth={2}
                        aria-hidden="true"
                      />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </article>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <a
      href="/demo"
      class="fresha-alt-compare__demo-cta"
      data-track="view_live_demo_click"
    >
      <span class="fresha-alt-compare__demo-play" aria-hidden="true">▶</span>
      See KERSIVO demo
      <span aria-hidden="true">→</span>
    </a>

    <p class="fresha-alt-compare__footnote">
      Fresha feature descriptions are based on Fresha’s current public product documentation.
      Commercial terms and pricing can change, so check Fresha directly for the latest details.
    </p>
  </div>
</section>

<script>
  const bindFreshaComparison = () => {
    document.querySelectorAll<HTMLElement>('[data-fresha-comparison]').forEach((root) => {
      if (root.dataset.accordionBound === 'true') return;
      root.dataset.accordionBound = 'true';

      const items = Array.from(root.querySelectorAll<HTMLElement>('[data-comparison-item]'));

      const setItemOpen = (item: HTMLElement, open: boolean) => {
        const trigger = item.querySelector<HTMLButtonElement>('[data-comparison-trigger]');
        const reveal = item.querySelector<HTMLElement>('[data-comparison-reveal]');
        const revealInner = item.querySelector<HTMLElement>('[data-comparison-reveal-inner]');

        item.dataset.open = open ? 'true' : 'false';
        trigger?.setAttribute('aria-expanded', open ? 'true' : 'false');
        reveal?.setAttribute('aria-hidden', open ? 'false' : 'true');

        if (open) revealInner?.removeAttribute('inert');
        else revealInner?.setAttribute('inert', '');
      };

      const openOnly = (target: HTMLElement) => {
        items.forEach((item) => setItemOpen(item, item === target));
      };

      items.forEach((item) => {
        item.querySelector<HTMLButtonElement>('[data-comparison-trigger]')?.addEventListener('click', () => {
          root.dataset.userInteracted = 'true';
          const shouldOpen = item.dataset.open !== 'true';
          if (shouldOpen) openOnly(item);
          else setItemOpen(item, false);
        });
      });

      const firstItem = items[0];
      if (!firstItem || !('IntersectionObserver' in window)) return;

      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry?.isIntersecting) return;
          observer.disconnect();

          if (root.dataset.autoOpened === 'true') return;
          root.dataset.autoOpened = 'true';

          if (root.dataset.userInteracted !== 'true') {
            openOnly(firstItem);
          }
        },
        {
          threshold: 0.32,
          rootMargin: '0px 0px -12% 0px',
        },
      );

      observer.observe(firstItem);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindFreshaComparison, { once: true });
  } else {
    bindFreshaComparison();
  }

  document.addEventListener('astro:page-load', bindFreshaComparison);
</script>
