---
import {
  BarChart3,
  CalendarDays,
  ChevronDown,
  CircleCheck,
  CircleDot,
  CreditCard,
  Globe2,
  ShoppingBag,
  UsersRound,
} from 'lucide-react';
import {
  FRESHA_COMPARE_SECTIONS,
  FRESHA_COMPARISON_FOOTNOTE,
  type FreshaCompareSectionId,
} from '@/lib/seo/freshaFacts';

const sectionIcons: Record<FreshaCompareSectionId, typeof CalendarDays> = {
  bookings: CalendarDays,
  payments: CreditCard,
  brand: Globe2,
  retail: ShoppingBag,
  clients: UsersRound,
  reports: BarChart3,
};

const sections = FRESHA_COMPARE_SECTIONS.map((section) => ({
  ...section,
  icon: sectionIcons[section.id],
}));
const sectionCountLabel = String(sections.length).padStart(2, '0');
---

<section
  id="comparison"
  class="fresha-alt-compare scroll-mt-24"
  aria-labelledby="fresha-alt-compare-title"
  data-fresha-comparison
>
  <div class="fresha-alt-compare__container">
    <header class="fresha-alt-compare__header">
      <p class="fresha-alt-compare__eyebrow">COMPARISON</p>
      <h2 id="fresha-alt-compare-title" class="fresha-alt-compare__title">
        <span class="fresha-alt-compare__title-line">KERSIVO</span>
        <span class="fresha-alt-compare__title-line fresha-alt-compare__title-line--vs">VS</span>
        <span class="fresha-alt-compare__title-line">Fresha</span>
      </h2>
      <p class="fresha-alt-compare__lead">
        Two different ways to run a barbershop. Open each category and compare the parts that
        matter to your brand, bookings and client journey.
      </p>
    </header>

    <div class="fresha-alt-compare__accordion">
      {sections.map((section, index) => {
        const Icon = section.icon;

        return (
          <article
            class="fresha-alt-compare__item"
            data-comparison-item
            data-open="false"
          >
            <button
              id={`fresha-compare-trigger-${section.id}`}
              type="button"
              class="fresha-alt-compare__summary"
              aria-expanded="false"
              aria-controls={`fresha-compare-panel-${section.id}`}
              data-comparison-trigger
            >
              <span class="fresha-alt-compare__summary-icon" aria-hidden="true">
                <Icon size={19} strokeWidth={1.8} />
              </span>

              <span class="fresha-alt-compare__summary-copy">
                <span class="fresha-alt-compare__summary-kicker">
                  {String(index + 1).padStart(2, '0')} / {sectionCountLabel}
                </span>
                <strong>{section.title}</strong>
                <span>{section.subtitle}</span>
              </span>

              <ChevronDown
                className="fresha-alt-compare__chevron"
                size={20}
                strokeWidth={1.8}
                aria-hidden="true"
              />
            </button>

            <div
              class="fresha-alt-compare__reveal"
              data-comparison-reveal
              aria-hidden="true"
            >
              <div
                id={`fresha-compare-panel-${section.id}`}
                class="fresha-alt-compare__reveal-inner"
                role="region"
                aria-labelledby={`fresha-compare-trigger-${section.id}`}
                data-comparison-reveal-inner
                inert
              >
                <div class="fresha-alt-compare__panel">
              <article class="fresha-alt-compare__provider fresha-alt-compare__provider--fresha">
                <div class="fresha-alt-compare__provider-label">FRESHA ECOSYSTEM</div>
                <div class="fresha-alt-compare__provider-head">
                  <span class="fresha-alt-compare__brand-mark fresha-alt-compare__brand-mark--fresha" aria-hidden="true">
                    fresha
                  </span>
                  <div>
                    <p class="fresha-alt-compare__provider-name">Fresha</p>
                    <p class="fresha-alt-compare__provider-lead">{section.freshaLead}</p>
                  </div>
                </div>

                <ul class="fresha-alt-compare__points">
                  {section.freshaPoints.map((point) => (
                    <li>
                      <CircleDot
                        className="fresha-alt-compare__point-icon fresha-alt-compare__point-icon--neutral"
                        size={15}
                        strokeWidth={1.8}
                        aria-hidden="true"
                      />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </article>

              <div class="fresha-alt-compare__vs" aria-hidden="true">VS</div>

              <article class="fresha-alt-compare__provider fresha-alt-compare__provider--kersivo">
                <div class="fresha-alt-compare__provider-label fresha-alt-compare__provider-label--kersivo">
                  YOUR OWN BRAND
                </div>
                <div class="fresha-alt-compare__provider-head">
                  <span class="fresha-alt-compare__brand-mark fresha-alt-compare__brand-mark--kersivo" aria-hidden="true">
                    <img src="/images/logo-kersivo.png" alt="" width="72" height="72" loading="lazy" decoding="async" />
                  </span>
                  <div>
                    <p class="fresha-alt-compare__provider-name">KERSIVO</p>
                    <p class="fresha-alt-compare__provider-lead">{section.kersivoLead}</p>
                  </div>
                </div>

                <ul class="fresha-alt-compare__points">
                  {section.kersivoPoints.map((point) => (
                    <li>
                      <CircleCheck
                        className="fresha-alt-compare__point-icon fresha-alt-compare__point-icon--yes"
                        size={16}
                        strokeWidth={2}
                        aria-hidden="true"
                      />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </article>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <a
      href="/demo"
      class="fresha-alt-compare__demo-cta"
      data-track="view_live_demo_click"
    >
      <span class="fresha-alt-compare__demo-play" aria-hidden="true">▶</span>
      See KERSIVO demo
      <span aria-hidden="true">→</span>
    </a>

    <p class="fresha-alt-compare__footnote">
      {FRESHA_COMPARISON_FOOTNOTE} <a href="#sources">See sources</a>
    </p>
  </div>
</section>

<script>
  const bindFreshaComparison = () => {
    document.querySelectorAll<HTMLElement>('[data-fresha-comparison]').forEach((root) => {
      if (root.dataset.accordionBound === 'true') return;
      root.dataset.accordionBound = 'true';

      const items = Array.from(root.querySelectorAll<HTMLElement>('[data-comparison-item]'));

      const setItemOpen = (item: HTMLElement, open: boolean) => {
        const trigger = item.querySelector<HTMLButtonElement>('[data-comparison-trigger]');
        const reveal = item.querySelector<HTMLElement>('[data-comparison-reveal]');
        const revealInner = item.querySelector<HTMLElement>('[data-comparison-reveal-inner]');

        item.dataset.open = open ? 'true' : 'false';
        trigger?.setAttribute('aria-expanded', open ? 'true' : 'false');
        reveal?.setAttribute('aria-hidden', open ? 'false' : 'true');

        if (open) revealInner?.removeAttribute('inert');
        else revealInner?.setAttribute('inert', '');
      };

      const openOnly = (target: HTMLElement) => {
        items.forEach((item) => setItemOpen(item, item === target));
      };

      items.forEach((item) => {
        item.querySelector<HTMLButtonElement>('[data-comparison-trigger]')?.addEventListener('click', () => {
          root.dataset.userInteracted = 'true';
          const shouldOpen = item.dataset.open !== 'true';
          if (shouldOpen) openOnly(item);
          else setItemOpen(item, false);
        });
      });

      const firstItem = items[0];
      if (!firstItem || !('IntersectionObserver' in window)) return;

      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry?.isIntersecting) return;
          observer.disconnect();

          if (root.dataset.autoOpened === 'true') return;
          root.dataset.autoOpened = 'true';

          if (root.dataset.userInteracted !== 'true') {
            openOnly(firstItem);
          }
        },
        {
          threshold: 0.32,
          rootMargin: '0px 0px -12% 0px',
        },
      );

      observer.observe(firstItem);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindFreshaComparison, { once: true });
  } else {
    bindFreshaComparison();
  }

  document.addEventListener('astro:page-load', bindFreshaComparison);
</script>
