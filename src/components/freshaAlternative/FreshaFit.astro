---
import ModelComparison from '@/components/editorial/ModelComparison.astro';
import { FRESHA_FIT_CLOSING, FRESHA_FIT_PATHS } from '@/lib/seo/freshaAlternativeContent';
---

<section id="which-model" class="fj-section fj-fit" aria-labelledby="fresha-alt-fit-title">
  <div class="fj-wrap">
    <header class="fj-head">
      <p class="fj-eyebrow">An honest fit check</p>
      <h2 id="fresha-alt-fit-title" class="fj-h2">Which model fits your barbershop?</h2>
    </header>

    <ModelComparison idPrefix="fresha-alt-fit" models={FRESHA_FIT_PATHS} conclusion={FRESHA_FIT_CLOSING}>
      Also comparing Booksy? <a href="/booksy-alternative">Compare KERSIVO and Booksy <span aria-hidden="true">→</span></a>
      <span> · </span><a href="/square-appointments-alternative">Compare KERSIVO and Square Appointments <span aria-hidden="true">→</span></a>
      <span> · </span><a href="/nearcut-alternative">Compare KERSIVO and Nearcut <span aria-hidden="true">→</span></a>
      <span> · </span><a href="/squire-alternative">Compare KERSIVO and SQUIRE <span aria-hidden="true">→</span></a>
      <span> · </span><a href="/phorest-alternative">Phorest alternative for barbers <span aria-hidden="true">→</span></a>
      <span> · </span><a href="/vagaro-alternative">Vagaro alternative <span aria-hidden="true">→</span></a>
      <span> · </span><a href="/treatwell-alternative">Treatwell alternative <span aria-hidden="true">→</span></a>
      <span> · </span><a href="/setora-alternative">Setora comparison <span aria-hidden="true">→</span></a>
    </ModelComparison>
  </div>
</section>
