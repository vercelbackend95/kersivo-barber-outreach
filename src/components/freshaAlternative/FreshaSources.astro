---
import {
  FRESHA_ALTERNATIVE_LAST_UPDATED_ISO,
  FRESHA_ALTERNATIVE_LAST_UPDATED_LABEL,
} from '@/lib/seo/freshaAlternativeFaq';
import {
  FRESHA_FACTS_CHECKED_DATE,
  FRESHA_FACTS_CHECKED_ISO,
  FRESHA_SOURCES,
  FRESHA_TRADEMARK_DISCLAIMER,
  FRESHA_UK_VAT_PERCENT,
} from '@/lib/seo/freshaFacts';
---

<section id="sources" class="fresha-alt-sources" aria-labelledby="fresha-alt-sources-title">
  <div class="container">
    <header class="fresha-alt-sources__header">
      <h2 id="fresha-alt-sources-title" class="fresha-alt-sources__title">Sources &amp; comparison notes</h2>
      <p class="fresha-alt-sources__meta">
        Fresha facts checked <time datetime={FRESHA_FACTS_CHECKED_ISO}>{FRESHA_FACTS_CHECKED_DATE}</time>
        <span aria-hidden="true">·</span>
        Last updated <time datetime={FRESHA_ALTERNATIVE_LAST_UPDATED_ISO}>{FRESHA_ALTERNATIVE_LAST_UPDATED_LABEL}</time>
      </p>
    </header>
    <p>
      Fresha pricing and features on this page were checked against Fresha’s public website and Help
      Centre. UK prices are taken from Fresha’s UK pricing page, which lists them in pounds sterling
      and exclusive of {FRESHA_UK_VAT_PERCENT}% VAT. Pricing and product features can change, so check
      Fresha directly before making a decision.
    </p>
    <ul class="fresha-alt-sources__list">
      {
        FRESHA_SOURCES.map((source) => (
          <li>
            <a href={source.url} target="_blank" rel="noopener noreferrer">
              {source.label}
            </a>
            <span class="fresha-alt-sources__supports">{source.supports}</span>
          </li>
        ))
      }
    </ul>
    <p class="fresha-alt-sources__trademark">{FRESHA_TRADEMARK_DISCLAIMER}</p>
  </div>
</section>
