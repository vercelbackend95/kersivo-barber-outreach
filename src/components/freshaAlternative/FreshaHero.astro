---
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
---

<section class="fresha-alt-hero" aria-labelledby="fresha-alt-hero-title">
  <div class="fresha-alt-hero__backdrop" aria-hidden="true">
    <span class="fresha-alt-hero__grid"></span>
    <span class="fresha-alt-hero__beam fresha-alt-hero__beam--left"></span>
    <span class="fresha-alt-hero__beam fresha-alt-hero__beam--right"></span>
  </div>

  <div class="container fresha-alt-hero__content">
    <p class="fresha-alt-hero__eyebrow">
      <span class="fresha-alt-hero__eyebrow-dot" aria-hidden="true"></span>
      Fresha alternative for UK barbershops
    </p>

    <h1 id="fresha-alt-hero-title" class="fresha-alt-hero__title">
      A Fresha alternative
      <span>built around your barbershop.</span>
    </h1>

    <p class="fresha-alt-hero__lead">
      Own the website, booking journey and client relationship. KERSIVO gives independent
      barbershops the tools to run bookings, deposits, clients and retail from one branded system.
    </p>

    <div class="fresha-alt-hero__actions">
      <a
        href="/demo"
        class="btn btn--primary btn--lg fresha-alt-hero__action fresha-alt-hero__action--primary"
        data-track="view_live_demo_click"
      >
        Open the full demo
      </a>
      <a
        href="#comparison"
        class="btn btn--secondary btn--lg fresha-alt-hero__action fresha-alt-hero__action--secondary"
      >
        Compare KERSIVO and Fresha
      </a>
    </div>

    <div class="fresha-alt-hero__meta" aria-label="KERSIVO commercial model">
      <span><strong>£{SAAS_MONTHLY_GBP}/month</strong></span>
      <span aria-hidden="true">·</span>
      <span>0% KERSIVO commission</span>
      <span aria-hidden="true">·</span>
      <span>Built for independent UK barbershops</span>
    </div>
  </div>

  <div class="fresha-alt-hero__product-shell">
    <div class="fresha-alt-hero__product-glow" aria-hidden="true"></div>

    <div class="fresha-alt-hero__product-frame">
      <div class="fresha-alt-hero__product-bar">
        <div class="fresha-alt-hero__product-id">
          <span class="fresha-alt-hero__product-mark" aria-hidden="true"></span>
          <span>KERSIVO</span>
          <span class="fresha-alt-hero__product-slash" aria-hidden="true">/</span>
          <span class="fresha-alt-hero__product-area">Owner dashboard</span>
        </div>

        <div class="fresha-alt-hero__product-status">
          <span class="fresha-alt-hero__live">
            <span class="fresha-alt-hero__live-dot" aria-hidden="true"></span>
            Interactive preview
          </span>
          <a href="/demo/admin?section=bookings_dashboard" target="_blank" rel="noreferrer">
            Open full screen
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="fresha-alt-hero__product-viewport">
        <iframe
          src="/demo/admin?embed=hero&section=bookings_dashboard"
          title="Interactive KERSIVO owner dashboard demo"
          loading="eager"
        ></iframe>
      </div>
    </div>

    <p class="fresha-alt-hero__product-caption">
      This is the real KERSIVO demo dashboard. Click around — bookings, team, reports and more.
    </p>
  </div>
</section>
