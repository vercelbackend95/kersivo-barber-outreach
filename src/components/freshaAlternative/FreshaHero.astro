---
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
---

<section class="fresha-alt-hero" aria-labelledby="fresha-alt-hero-title">
  <div class="fresha-alt-hero__atmosphere" aria-hidden="true">
    <span class="fresha-alt-hero__halo"></span>
    <span class="fresha-alt-hero__monogram">K</span>
    <span class="fresha-alt-hero__axis"></span>
  </div>

  <div class="container fresha-alt-hero__inner">
    <div class="fresha-alt-hero__masthead">
      <p class="fresha-alt-hero__eyebrow">
        <span class="fresha-alt-hero__signal" aria-hidden="true"></span>
        FRESHA ALTERNATIVE FOR UK BARBERSHOPS
      </p>
      <p class="fresha-alt-hero__edition" aria-label="KERSIVO independent barbershop platform">
        <span>KERSIVO</span>
        <span aria-hidden="true">/</span>
        <span>INDEPENDENT BARBERS</span>
      </p>
    </div>

    <div class="fresha-alt-hero__headline-wrap">
      <p class="fresha-alt-hero__chapter" aria-hidden="true">01 — OWNERSHIP</p>

      <h1 id="fresha-alt-hero-title" class="fresha-alt-hero__title">
        <span class="fresha-alt-hero__title-line">A FRESHA ALTERNATIVE</span>
        <span class="fresha-alt-hero__title-line fresha-alt-hero__title-line--muted">
          BUILT AROUND
        </span>
        <span class="fresha-alt-hero__title-line fresha-alt-hero__title-line--accent">
          YOUR BRAND.
        </span>
      </h1>
    </div>

    <div class="fresha-alt-hero__rule" aria-hidden="true">
      <span></span>
    </div>

    <div class="fresha-alt-hero__lower">
      <div class="fresha-alt-hero__copy">
        <p class="fresha-alt-hero__intro">
          KERSIVO gives independent barbershops their own branded website, own domain and booking
          journey — with online bookings, deposits, client management, appointment reminders and
          retail pickup in one platform.
        </p>

        <p class="fresha-alt-hero__commercial">
          <strong>£{SAAS_MONTHLY_GBP}/month.</strong>
          <span>0% KERSIVO commission on bookings and retail sales.</span>
        </p>

        <div class="fresha-alt-hero__actions">
          <a
            href="/demo"
            class="btn btn--primary btn--lg fresha-alt-hero__action"
            data-track="view_live_demo_click"
          >
            See KERSIVO in Action
          </a>
          <a
            href="#comparison"
            class="btn btn--secondary btn--lg fresha-alt-hero__action fresha-alt-hero__action--secondary"
          >
            Compare KERSIVO and Fresha
          </a>
        </div>
      </div>

      <div class="fresha-alt-hero__index" aria-label="What KERSIVO keeps centred on your business">
        <p class="fresha-alt-hero__index-label">BUILT AROUND WHAT YOU OWN</p>

        <div class="fresha-alt-hero__index-row">
          <span class="fresha-alt-hero__index-number">01</span>
          <span class="fresha-alt-hero__index-name">YOUR DOMAIN</span>
          <span class="fresha-alt-hero__index-note">Your business online</span>
        </div>

        <div class="fresha-alt-hero__index-row">
          <span class="fresha-alt-hero__index-number">02</span>
          <span class="fresha-alt-hero__index-name">YOUR BOOKINGS</span>
          <span class="fresha-alt-hero__index-note">Your branded journey</span>
        </div>

        <div class="fresha-alt-hero__index-row">
          <span class="fresha-alt-hero__index-number">03</span>
          <span class="fresha-alt-hero__index-name">YOUR CLIENTS</span>
          <span class="fresha-alt-hero__index-note">Your relationship</span>
        </div>
      </div>
    </div>

    <div class="fresha-alt-hero__footer">
      <p>OWN YOUR BRAND. OWN YOUR BOOKINGS.</p>
      <p class="fresha-alt-hero__footer-mark" aria-hidden="true">KERSIVO®</p>
    </div>
  </div>
</section>
