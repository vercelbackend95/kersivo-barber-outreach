---
import ComparisonHeroActions from '@/components/comparison/ComparisonHeroActions.astro';
import HeroDashboardShowcase from '@/components/marketing/HeroDashboardShowcase.astro';
import {
  FRESHA_HERO_EYEBROW,
  FRESHA_HERO_FACTS,
  FRESHA_HERO_LEAD,
  FRESHA_HERO_TITLE_LINES,
  FRESHA_JOURNEY_ACTS,
} from '@/lib/seo/freshaAlternativeContent';
---

<section class="fj-hero" aria-labelledby="fresha-alt-hero-title" data-enter>
  <div class="fj-hero__ground" aria-hidden="true"></div>
  <div class="fj-wrap fj-hero__content">
    <nav class="fj-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Fresha alternative</span>
    </nav>

    <p class="fj-eyebrow fj-enter" style="--i: 0">{FRESHA_HERO_EYEBROW}</p>

    <h1 id="fresha-alt-hero-title" class="fj-hero__title">
      {FRESHA_HERO_TITLE_LINES.map((line, index) => (
        <span class="fj-hero__line fj-enter" style={`--i: ${index + 1}`}>{line}</span>
      ))}
    </h1>

    <p class="fj-hero__lead fj-enter" style="--i: 4">{FRESHA_HERO_LEAD}</p>

    <div class="fj-enter" style="--i: 5">
      <ComparisonHeroActions placement="fresha" />
    </div>

    <ul class="fj-hero__facts fj-enter" style="--i: 6" aria-label="KERSIVO commercial model">
      {FRESHA_HERO_FACTS.map((fact) => <li>{fact}</li>)}
    </ul>

    <nav class="fj-acts fj-enter" style="--i: 7" aria-label="On this page">
      <p class="fj-acts__label">The switch, in four acts</p>
      <ol class="fj-acts__list">
        {FRESHA_JOURNEY_ACTS.map((act) => (
          <li>
            <a class="fj-acts__link" href={`#${act.id}`}>
              <span class="fj-acts__numeral" aria-hidden="true">{act.numeral}</span>
              <span>{act.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>

  <HeroDashboardShowcase />
</section>
