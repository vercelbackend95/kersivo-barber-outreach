---
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
---

<section class="fresha-alt-hero" aria-labelledby="fresha-alt-hero-title">
  <div class="fresha-alt-hero__ambient" aria-hidden="true"></div>

  <div class="container fresha-alt-hero__grid">
    <div class="fresha-alt-hero__copy">
      <p class="fresha-alt-hero__eyebrow">
        <span class="fresha-alt-hero__eyebrow-mark" aria-hidden="true"></span>
        FRESHA ALTERNATIVE FOR UK BARBERSHOPS
      </p>

      <h1 id="fresha-alt-hero-title" class="fresha-alt-hero__title">
        A Fresha Alternative
        <span>Built Around Your Own Brand</span>
      </h1>

      <p class="fresha-alt-hero__intro">
        KERSIVO gives independent barbershops their own branded website, own domain and booking
        journey — with online bookings, deposits, client management, appointment reminders and
        retail pickup in one platform.
      </p>

      <p class="fresha-alt-hero__commercial">
        <strong>£{SAAS_MONTHLY_GBP}/month.</strong>
        <span>0% KERSIVO commission on bookings and retail sales.</span>
      </p>

      <div class="fresha-alt-hero__actions">
        <a
          href="/demo"
          class="btn btn--primary btn--lg fresha-alt-hero__action"
          data-track="view_live_demo_click"
        >
          See KERSIVO in Action
        </a>
        <a
          href="#comparison"
          class="btn btn--secondary btn--lg fresha-alt-hero__action fresha-alt-hero__action--secondary"
        >
          Compare KERSIVO and Fresha
        </a>
      </div>

      <div class="fresha-alt-hero__proof" role="list" aria-label="KERSIVO highlights">
        <span role="listitem">YOUR OWN DOMAIN</span>
        <span role="listitem">£{SAAS_MONTHLY_GBP}/MONTH</span>
        <span role="listitem">0% KERSIVO COMMISSION</span>
      </div>
    </div>

    <div class="fresha-alt-hero__visual" aria-label="A visual example of a barbershop-owned booking journey">
      <div class="fresha-alt-hero__visual-grid" aria-hidden="true"></div>

      <div class="fresha-alt-hero__visual-label">
        <span>BRAND-OWNED JOURNEY</span>
        <span class="fresha-alt-hero__visual-label-dot"></span>
      </div>

      <div class="fresha-alt-hero__browser">
        <div class="fresha-alt-hero__browser-top">
          <div class="fresha-alt-hero__browser-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <div class="fresha-alt-hero__domain">
            <span class="fresha-alt-hero__lock" aria-hidden="true"></span>
            yourbarbers.co.uk
          </div>
          <span class="fresha-alt-hero__browser-kersivo">KERSIVO</span>
        </div>

        <div class="fresha-alt-hero__site">
          <div class="fresha-alt-hero__site-nav">
            <div>
              <p class="fresha-alt-hero__site-kicker">YOUR BARBERSHOP</p>
              <p class="fresha-alt-hero__site-name">YOUR BRAND</p>
            </div>
            <span class="fresha-alt-hero__book-pill">BOOK NOW</span>
          </div>

          <div class="fresha-alt-hero__site-main">
            <div class="fresha-alt-hero__site-copy">
              <span class="fresha-alt-hero__site-label">BOOK DIRECT</span>
              <p class="fresha-alt-hero__site-heading">Your shop stays at the centre.</p>
              <p class="fresha-alt-hero__site-body">
                Your website. Your domain. Your booking experience.
              </p>
            </div>

            <div class="fresha-alt-hero__booking-card">
              <div class="fresha-alt-hero__booking-head">
                <span>BOOK AN APPOINTMENT</span>
                <span>01 / 03</span>
              </div>
              <div class="fresha-alt-hero__booking-row fresha-alt-hero__booking-row--active">
                <div>
                  <span class="fresha-alt-hero__booking-step">01</span>
                  <span>Choose a service</span>
                </div>
                <span>→</span>
              </div>
              <div class="fresha-alt-hero__booking-row">
                <div>
                  <span class="fresha-alt-hero__booking-step">02</span>
                  <span>Choose your barber</span>
                </div>
                <span>→</span>
              </div>
              <div class="fresha-alt-hero__booking-row">
                <div>
                  <span class="fresha-alt-hero__booking-step">03</span>
                  <span>Choose a time</span>
                </div>
                <span>→</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="fresha-alt-hero__ownership-stack">
        <div class="fresha-alt-hero__ownership-item">
          <span class="fresha-alt-hero__ownership-index">01</span>
          <div>
            <span class="fresha-alt-hero__ownership-label">YOUR WEBSITE</span>
            <strong>Own domain</strong>
          </div>
        </div>
        <div class="fresha-alt-hero__ownership-item">
          <span class="fresha-alt-hero__ownership-index">02</span>
          <div>
            <span class="fresha-alt-hero__ownership-label">YOUR BOOKINGS</span>
            <strong>Branded journey</strong>
          </div>
        </div>
        <div class="fresha-alt-hero__ownership-item">
          <span class="fresha-alt-hero__ownership-index">03</span>
          <div>
            <span class="fresha-alt-hero__ownership-label">YOUR BUSINESS</span>
            <strong>Front and centre</strong>
          </div>
        </div>
      </div>

      <div class="fresha-alt-hero__signature">
        <span>BUILT BY</span>
        <strong>KERSIVO</strong>
      </div>
    </div>
  </div>
</section>
