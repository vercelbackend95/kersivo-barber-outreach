---
import HeroDashboardShowcase from '@/components/marketing/HeroDashboardShowcase.astro';
import { KERSIVO_BOOKING_DEPOSIT_GBP, SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
---

<section class="fresha-alt-hero" aria-labelledby="fresha-alt-hero-title">
  <div class="fresha-alt-hero__content">
    <nav class="fresha-alt-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Fresha alternative</span>
    </nav>
    <p class="fresha-alt-hero__eyebrow">
      <span class="fresha-alt-hero__eyebrow-dot" aria-hidden="true"></span>
      Fresha alternative for UK barbershops
    </p>

    <h1 id="fresha-alt-hero-title" class="fresha-alt-hero__title">
      <span class="fresha-alt-hero__title-line fresha-alt-hero__title-line--primary">A Fresha alternative</span>
      <span class="fresha-alt-hero__title-line">built around your</span>
      <span class="fresha-alt-hero__title-line">barbershop.</span>
    </h1>

    <p class="fresha-alt-hero__lead">
      Fresha combines booking software with marketplace discovery. KERSIVO takes a more direct
      route. Starter is £0/month, with a £{KERSIVO_BOOKING_DEPOSIT_GBP} deposit or full payment on every public booking. Full
      KERSIVO moves the complete customer journey onto your own website and domain.
    </p>

    <div class="fresha-alt-hero__actions">
      <a
        href="/demo"
        class="fresha-alt-hero__action fresha-alt-hero__action--primary"
        data-track="view_live_demo_click"
      >
        Open the full demo
      </a>
      <a
        href="#comparison"
        class="fresha-alt-hero__action fresha-alt-hero__action--secondary"
      >
        Compare KERSIVO and Fresha
      </a>
    </div>

    <div class="fresha-alt-hero__meta" aria-label="KERSIVO commercial model">
      <span><strong>Starter £0/month</strong></span>
      <span aria-hidden="true">·</span>
      <span><strong>Full £{SAAS_MONTHLY_GBP}/month per location</strong></span>
      <span aria-hidden="true">·</span>
      <span>0% KERSIVO commission on booking payments</span>
      <span aria-hidden="true">·</span>
      <span>Built for independent UK barbershops</span>
    </div>
  </div>

  <HeroDashboardShowcase />
</section>

<style>
  .fresha-alt-breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 1rem;
    color: #9ca3af;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .fresha-alt-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .fresha-alt-breadcrumb a:hover,
  .fresha-alt-breadcrumb a:focus-visible {
    color: #f9fafb;
    text-decoration: underline;
  }
</style>
