---
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
---

<section class="fresha-alt-hero" aria-labelledby="fresha-alt-hero-title">
  <div class="fresha-alt-hero__content">
    <p class="fresha-alt-hero__eyebrow">
      <span class="fresha-alt-hero__eyebrow-dot" aria-hidden="true"></span>
      Fresha alternative for UK barbershops
    </p>

    <h1 id="fresha-alt-hero-title" class="fresha-alt-hero__title">
      <span class="fresha-alt-hero__title-line fresha-alt-hero__title-line--primary">A Fresha alternative</span>
      <span class="fresha-alt-hero__title-line">built around your</span>
      <span class="fresha-alt-hero__title-line">barbershop.</span>
    </h1>

    <p class="fresha-alt-hero__lead">
      Own your website, bookings and client relationship — all under your own brand.
    </p>

    <div class="fresha-alt-hero__actions">
      <a
        href="/demo"
        class="fresha-alt-hero__action fresha-alt-hero__action--primary"
        data-track="view_live_demo_click"
      >
        Open the full demo
      </a>
      <a
        href="#comparison"
        class="fresha-alt-hero__action fresha-alt-hero__action--secondary"
      >
        Compare KERSIVO and Fresha
      </a>
    </div>

    <div class="fresha-alt-hero__meta" aria-label="KERSIVO commercial model">
      <span><strong>£{SAAS_MONTHLY_GBP}/month</strong></span>
      <span aria-hidden="true">·</span>
      <span>0% KERSIVO commission</span>
      <span aria-hidden="true">·</span>
      <span>Built for independent UK barbershops</span>
    </div>
  </div>

  <div class="fresha-alt-hero__product-shell">
    <div class="fresha-alt-hero__product-glow" aria-hidden="true"></div>

    <div class="fresha-alt-hero__product-viewport" data-deferred-demo-frame data-frame-state="poster">
      <!--
        Each poster is the embed rendered at the measured iframe size for its page band
        (scripts/capture-fresha-dashboard-posters.mjs). 48rem is where the viewport height
        rule changes, 50rem is where the embed leaves its sidebar-only layout, and 96.875rem
        is where the iframe reaches its capped size. Bump the -vN file prefix whenever the
        posters are recaptured so browsers never reuse a stale cached poster.
      -->
      <picture class="fresha-alt-hero__product-poster" aria-hidden="true">
        <source
          media="(max-width: 25rem)"
          srcset="/images/fresha-alternative/dashboard-showcase-v2-mobile.webp 2x"
          width="378"
          height="608"
        />
        <source
          media="(max-width: 38rem)"
          srcset="/images/fresha-alternative/dashboard-showcase-v2-mobile-wide.webp 2x"
          width="418"
          height="640"
        />
        <source
          media="(max-width: 48rem)"
          srcset="/images/fresha-alternative/dashboard-showcase-v2-tablet.webp 2x"
          width="756"
          height="704"
        />
        <source
          media="(max-width: 50rem)"
          srcset="/images/fresha-alternative/dashboard-showcase-v2-tablet-wide.webp 2x"
          width="768"
          height="544"
        />
        <source
          media="(max-width: 53.5rem)"
          srcset="/images/fresha-alternative/dashboard-showcase-v2-desktop-narrow.webp"
          width="769"
          height="544"
        />
        <source
          media="(max-width: 60rem)"
          srcset="/images/fresha-alternative/dashboard-showcase-v2-desktop-mid.webp"
          width="864"
          height="603"
        />
        <source
          media="(max-width: 64rem)"
          srcset="/images/fresha-alternative/dashboard-showcase-v2-desktop-compact.webp"
          width="983"
          height="686"
        />
        <source
          media="(max-width: 85rem)"
          srcset="/images/fresha-alternative/dashboard-showcase-v2-desktop-laptop.webp"
          width="1203"
          height="717"
        />
        <source
          media="(max-width: 96.875rem)"
          srcset="/images/fresha-alternative/dashboard-showcase-v2-desktop.webp"
          width="1354"
          height="806"
        />
        <img
          src="/images/fresha-alternative/dashboard-showcase-v2-desktop-wide.webp"
          alt=""
          width="1458"
          height="816"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <iframe
        class="fresha-alt-hero__product-frame"
        data-deferred-src="/demo/admin?embed=hero&section=bookings_dashboard"
        title="Interactive KERSIVO owner dashboard demo"
      ></iframe>
      <noscript>
        <iframe
          src="/demo/admin?embed=hero&section=bookings_dashboard"
          title="Interactive KERSIVO owner dashboard demo"
        ></iframe>
      </noscript>
    </div>

    <p class="fresha-alt-hero__product-caption">
      This is the real KERSIVO demo dashboard. Click around — bookings, team, reports and more.
    </p>
  </div>
</section>

<script>
  import { HERO_SHOWCASE_READY_MESSAGE_TYPE } from '@/lib/admin/heroShowcase';
  import { receiveHeroShowcaseWheel } from '@/lib/admin/heroShowcaseWheel';
  import { mountDeferredDemoFrame } from '@/lib/performance/deferredDemoFrame';

  const viewport = document.querySelector<HTMLElement>('[data-deferred-demo-frame]');
  const productFrame = viewport?.querySelector<HTMLIFrameElement>('.fresha-alt-hero__product-frame');
  if (productFrame) receiveHeroShowcaseWheel(productFrame, window);
  if (viewport) {
    mountDeferredDemoFrame(viewport, window, {
      readyMessageType: HERO_SHOWCASE_READY_MESSAGE_TYPE,
      onReady: () => {
        viewport.dataset.liveVisible = 'true';
      },
    });
  }
</script>
