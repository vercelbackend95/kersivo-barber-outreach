---
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
---

<section class="fresha-alt-hero" aria-labelledby="fresha-alt-hero-title">
  <div class="fresha-alt-hero__content">
    <p class="fresha-alt-hero__eyebrow">
      <span class="fresha-alt-hero__eyebrow-dot" aria-hidden="true"></span>
      Fresha alternative for UK barbershops
    </p>

    <h1 id="fresha-alt-hero-title" class="fresha-alt-hero__title">
      <span class="fresha-alt-hero__title-line fresha-alt-hero__title-line--primary">A Fresha alternative</span>
      <span class="fresha-alt-hero__title-line">built around your</span>
      <span class="fresha-alt-hero__title-line">barbershop.</span>
    </h1>

    <p class="fresha-alt-hero__lead">
      Own your website, bookings and client relationship — all under your own brand.
    </p>

    <div class="fresha-alt-hero__actions">
      <a
        href="/demo"
        class="fresha-alt-hero__action fresha-alt-hero__action--primary"
        data-track="view_live_demo_click"
      >
        Open the full demo
      </a>
      <a
        href="#comparison"
        class="fresha-alt-hero__action fresha-alt-hero__action--secondary"
      >
        Compare KERSIVO and Fresha
      </a>
    </div>

    <div class="fresha-alt-hero__meta" aria-label="KERSIVO commercial model">
      <span><strong>£{SAAS_MONTHLY_GBP}/month</strong></span>
      <span aria-hidden="true">·</span>
      <span>0% KERSIVO commission</span>
      <span aria-hidden="true">·</span>
      <span>Built for independent UK barbershops</span>
    </div>
  </div>

  <div class="fresha-alt-hero__product-shell">
    <div class="fresha-alt-hero__product-glow" aria-hidden="true"></div>

    <div class="fresha-alt-hero__product-viewport" data-deferred-demo-frame data-frame-state="poster">
      <picture class="fresha-alt-hero__product-poster" aria-hidden="true">
        <source
          media="(max-width: 38rem)"
          srcset="/images/fresha-alternative/dashboard-poster-mobile.webp"
          width="788"
          height="1168"
        />
        <source
          media="(max-width: 49.99rem)"
          srcset="/images/fresha-alternative/dashboard-poster-tablet.webp"
          width="1118"
          height="1041"
        />
        <img
          src="/images/fresha-alternative/dashboard-poster-desktop.webp"
          alt=""
          width="1437"
          height="805"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <iframe
        class="fresha-alt-hero__product-frame"
        data-deferred-src="/demo/admin?embed=hero&section=bookings_dashboard"
        title="Interactive KERSIVO owner dashboard demo"
      ></iframe>
      <noscript>
        <iframe
          src="/demo/admin?embed=hero&section=bookings_dashboard"
          title="Interactive KERSIVO owner dashboard demo"
        ></iframe>
      </noscript>
    </div>

    <p class="fresha-alt-hero__product-caption">
      This is the real KERSIVO demo dashboard. Click around — bookings, team, reports and more.
    </p>
  </div>
</section>

<script>
  import { mountDeferredDemoFrame } from '@/lib/performance/deferredDemoFrame';

  const viewport = document.querySelector<HTMLElement>('[data-deferred-demo-frame]');
  if (viewport) mountDeferredDemoFrame(viewport);
</script>
