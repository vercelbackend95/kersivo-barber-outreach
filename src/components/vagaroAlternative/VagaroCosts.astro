---
import {
  VAGARO_FACTS_CHECKED_DATE,
  getVagaroSource,
  requireVerifiedVagaroFact,
  estimateVagaroDisplayedSubscriptionGbp,
} from '@/lib/seo/vagaroFacts';
const pricingSource = getVagaroSource('pricingUk').url;
const calendarSource = getVagaroSource('ukHome').url;
const termsSource = getVagaroSource('ukParticipation').url;
const promotionalSource = getVagaroSource('fillMyBooks').url;
const cardFeesSource = getVagaroSource('ukCardFees').url;
const first = requireVerifiedVagaroFact('oneCalendarDisplayedMonthlyGbp').value;
const crossed = requireVerifiedVagaroFact('oneCalendarStruckThroughMonthlyGbp').value;
const additional = requireVerifiedVagaroFact('additionalCalendarMonthlyGbp').value;
const newClient = requireVerifiedVagaroFact('marketplaceNewClientFirstBookingPercent').value;
const existingClient = requireVerifiedVagaroFact('fillMyBooksExistingClientPercent').value;
const trial = requireVerifiedVagaroFact('freeTrialDays').value;
const inPersonPct = requireVerifiedVagaroFact('ukCardPresentPercent').value;
const inPersonFixed = requireVerifiedVagaroFact('ukCardPresentFixedGbp').value;
const keyedPct = requireVerifiedVagaroFact('ukKeyedInPercent').value;
const keyedFixed = requireVerifiedVagaroFact('ukKeyedInFixedGbp').value;
const mySite = requireVerifiedVagaroFact('monthlyMySiteAddOnGbp').value;
const exampleBooking = 30;
const exampleFee = Math.round(exampleBooking * newClient) / 100;
const exampleCalendars = [1, 3, 5, 7].map((barbers) => ({ barbers, price: estimateVagaroDisplayedSubscriptionGbp(barbers) }));
---
<section id="vagaro-pricing" class="fresha-alt__section" aria-labelledby="vagaro-alt-costs-title">
  <div class="container">
    <header class="fresha-alt__intro">
      <p class="fresha-alt__eyebrow">VAGARO PRICING UK</p>
      <h2 id="vagaro-alt-costs-title" class="fresha-alt__h2">Vagaro pricing and booking fees for UK barbers</h2>
      <p class="fresha-alt__lead">Vagaro prices its subscriptions by bookable calendar. The UK site currently displays a reduced one-calendar rate, while additional calendars and optional add-ons change the monthly cost. Booking-channel acquisition fees are a separate consideration.</p>
      <p class="fresha-alt-costs__checked">Official facts checked {VAGARO_FACTS_CHECKED_DATE} · <a href={pricingSource} target="_blank" rel="noopener noreferrer">Vagaro UK pricing</a></p>
    </header>
    <ul class="fresha-alt-costs__grid">
      <li class="fresha-alt-card fresha-alt-costs__item">
        <p class="fresha-alt-costs__kicker">VAGARO · ONE BOOKABLE CALENDAR</p>
        <p class="fresha-alt-costs__figure">£{first}</p>
        <p class="fresha-alt-costs__unit">per month displayed · £{crossed} crossed out</p>
        <ul class="fresha-alt-costs__notes">
          <li>Displayed reduced rate; confirm your own price and offer eligibility.</li>
          <li>Vagaro lists an additional £{additional}/month per calendar.</li>
          <li>{trial}-day trial advertised.</li>
          <li>Optional Vagaro MySite website builder: £{mySite}/month.</li>
        </ul>
      </li>
      <li class="fresha-alt-card fresha-alt-costs__item">
        <p class="fresha-alt-costs__kicker">VAGARO · NEW-CLIENT ACQUISITION</p>
        <p class="fresha-alt-costs__figure">{newClient}%</p>
        <p class="fresha-alt-costs__unit">qualifying first appointment</p>
        <ul class="fresha-alt-costs__notes">
          <li>UK Marketplace: new clients booked while your listing is active.</li>
          <li>Partner networks: separate channel conditions.</li>
          <li>Own-channel new clients: the rule depends on Fill My Books.</li>
          <li>Applicable VAT can be added to the connection fee.</li>
        </ul>
      </li>
      <li class="fresha-alt-card fresha-alt-costs__item">
        <p class="fresha-alt-costs__kicker">KERSIVO STARTER</p>
        <p class="fresha-alt-costs__figure">£0</p>
        <p class="fresha-alt-costs__unit">per month · up to four barbers</p>
        <ul class="fresha-alt-costs__notes">
          <li>Core booking system on a KERSIVO-hosted page.</li>
          <li>Public bookings require Stripe and at least £5 online payment.</li>
          <li>0% KERSIVO commission; normal Stripe processing fees apply.</li>
        </ul>
      </li>
      <li class="fresha-alt-card fresha-alt-costs__item">
        <p class="fresha-alt-costs__kicker">FULL KERSIVO</p>
        <p class="fresha-alt-costs__figure">£39</p>
        <p class="fresha-alt-costs__unit">per location / month</p>
        <ul class="fresha-alt-costs__notes">
          <li>Branded website and standard domain included.</li>
          <li>No extra per-barber subscription charge, subject to fair use.</li>
          <li>Advanced clients, reporting, retail pickup and editable payment settings.</li>
        </ul>
      </li>
    </ul>
    <div class="fresha-alt-card fresha-alt-costs__marketplace">
      <div class="fresha-alt-costs__marketplace-body">
        <h3 class="fresha-alt-costs__h3">What could Vagaro cost for your barber team?</h3>
        <ul class="fresha-alt-list">
          {exampleCalendars.map(({barbers,price}) => <li><strong>{barbers} bookable {barbers === 1 ? 'calendar' : 'calendars'}:</strong> £{price}/month at the currently displayed starting price.</li>)}
        </ul>
        <p>These are subscription-only illustrations, not fixed quotes. They use Vagaro's public reduced starting price and the published £{additional} incremental-calendar model. VAT, add-ons, processing fees and acquisition fees are not included. <a href={calendarSource} target="_blank" rel="noopener noreferrer">See the official UK calendar pricing model.</a></p>
      </div>
      <div class="fresha-alt-costs__marketplace-aside">
        <h3 class="fresha-alt-costs__h3">How the marketplace fee works</h3>
        <p class="fresha-alt-costs__example">For illustration, {newClient}% of a qualifying £{exampleBooking} new-client first appointment is £{exampleFee}, before any additional applicable VAT. This is not charged on every booking.</p>
        <p>Vagaro also documents {existingClient}% fees for eligible existing-client bookings generated through Fill My Books / Daily Deals — not a blanket existing-client charge.</p>
        <p class="fresha-alt-costs__checked">Sources: <a href={termsSource} target="_blank" rel="noopener noreferrer">UK agreement §10(p)</a> · <a href={promotionalSource} target="_blank" rel="noopener noreferrer">Fill My Books</a></p>
      </div>
    </div>
    <p class="fresha-alt-costs__note"><strong>Vagaro card-processing fees UK:</strong> the official Help Centre lists in-person swipe/dip/tap at {inPersonPct}% + £{inPersonFixed.toFixed(2)} per transaction, and keyed-in payments, including online payments, at {keyedPct}% + £{keyedFixed.toFixed(2)}. These are the published standard UK processing rates; older merchant agreements may differ. <a href={cardFeesSource} target="_blank" rel="noopener noreferrer">Source: Vagaro UK card-processing rates</a>.</p>
    <p class="fresha-alt-costs__note">Vagaro provides its own marketplace, booking widgets, reminders and wider salon management features. KERSIVO's positioning is direct booking under the barbershop's brand, not a claim that Vagaro lacks those tools. Confirm payment rates and your applicable VAT treatment directly with Vagaro before relying on a total-cost comparison.</p>
  </div>
</section>