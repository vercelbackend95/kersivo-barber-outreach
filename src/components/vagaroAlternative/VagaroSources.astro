---
import { VAGARO_FACTS_CHECKED_DATE, VAGARO_FACTS_CHECKED_ISO, VAGARO_SOURCES } from '@/lib/seo/vagaroAlternativeContent';
import { VAGARO_ALTERNATIVE_LAST_UPDATED_ISO, VAGARO_ALTERNATIVE_LAST_UPDATED_LABEL } from '@/lib/seo/vagaroAlternativeFaq';
---
<section id="sources" class="fresha-alt-sources" aria-labelledby="vagaro-alt-sources-title"><div class="container">
<header class="fresha-alt-sources__header"><h2 id="vagaro-alt-sources-title" class="fresha-alt-sources__title">Sources &amp; comparison notes</h2><p class="fresha-alt-sources__meta">Vagaro facts checked <time datetime={VAGARO_FACTS_CHECKED_ISO}>{VAGARO_FACTS_CHECKED_DATE}</time><span aria-hidden="true">·</span>Last updated <time datetime={VAGARO_ALTERNATIVE_LAST_UPDATED_ISO}>{VAGARO_ALTERNATIVE_LAST_UPDATED_LABEL}</time></p></header>
<p>This is a product comparison by KERSIVO, not an independent ranking. Vagaro prices, discounts, acquisition fees and features may change. UK marketplace charges depend on the booking channel and applicable conditions; check your current terms and shop-specific quote before switching.</p>
<ul class="fresha-alt-sources__list">{VAGARO_SOURCES.map(source=><li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a><span class="fresha-alt-sources__supports">{source.supports}</span></li>)}</ul>
<p class="fresha-alt-sources__trademark">Vagaro is a trademark of its respective owner. KERSIVO is not affiliated with, endorsed by or sponsored by Vagaro.</p>
</div></section>