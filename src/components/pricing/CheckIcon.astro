---
interface Props {
  class?: string;
  label?: string;
}

const { class: className, label } = Astro.props;
---

<span class:list={['pricing-check', className]} aria-hidden={label ? undefined : 'true'}>
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M5 12l5 5 9-10"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  {label ? <span class="sr-only">{label}</span> : null}
</span>
