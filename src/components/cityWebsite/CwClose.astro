---
/**
 * Closing CTA: Full KERSIVO first (free preview when the flow is on), Starter as the secondary button,
 * the pricing micro-copy, then the shared city navigation back into the Websites cluster.
 */
import FullPlanCta from '@/components/cta/FullPlanCta.astro';
import CwCityNav from '@/components/cityWebsite/CwCityNav.astro';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import type { CityPage } from '@/lib/seo/cityPages';

interface Props {
  city: CityPage;
}

const { city } = Astro.props;
const freePreview = isFreePreviewFlowEnabled();
const placement = `city_${city.slug}_final`;
---

<section class="cw-close" aria-labelledby="cw-close-title">
  <div class="cw-shell cw-close__inner">
    <p class="cw-close__domain" aria-hidden="true">{city.journey.shopDomain.replace(/^[^.]+/, 'yourshop')}</p>
    <h2 id="cw-close-title" class="cw-h2 cw-close__title">Ready to put your {city.name} shop on your own domain?</h2>
    <p class="cw-lead cw-close__lead">
      See a free working preview built around your barbershop before you pay a penny&nbsp;— or start free on Starter.
    </p>
    <div class="cw-close__actions">
      {freePreview ? (
        <FullPlanCta part="primary" primaryClass="cw-btn cw-btn--primary" placement={placement} />
      ) : (
        <a href="/admin/launch" class="btn btn--primary btn--lg cw-btn cw-btn--primary" data-track="saas_subscribe_click" data-track-placement={placement}>
          Start Full KERSIVO — £{SAAS_MONTHLY_GBP}/month
        </a>
      )}
      <a href="/starter" class="btn btn--outline btn--lg cw-btn cw-btn--ghost" data-track="starter_plan_explore_click" data-track-placement={placement}>
        Or start on Starter — £0/month
      </a>
    </div>
    <ul class="cw-facts cw-close__facts" role="list" aria-label="Full KERSIVO terms">
      <li>£{SAAS_MONTHLY_GBP}/month per location, not per barber</li>
      <li>No setup fee</li>
      <li>0% KERSIVO commission, Stripe fees apply</li>
    </ul>
    <p class="cw-close__note">
      Typically ready in a few days once we receive all required information, and nothing goes live until you approve it.
    </p>
  </div>
</section>

<CwCityNav city={city} />
