---
import { TIMELY_FACTS_CHECKED_DATE, TIMELY_FACTS_CHECKED_ISO, getTimelySource, requireVerifiedTimelyFact } from '@/lib/seo/timelyFacts';

const payment = requireVerifiedTimelyFact('ukOnlinePaymentProcessing');
const pricing = getTimelySource('pricing');
const fees = getTimelySource('ukPayments');
---
<section id="timely-cost" class="cost-calc__section" aria-labelledby="cost-calc-timely-title">
  <div class="container cost-calc-platform">
    <header class="cost-calc__intro cost-calc-platform__intro">
      <p class="cost-calc__eyebrow">Timely pricing</p>
      <h2 id="cost-calc-timely-title" class="cost-calc__h2">How much does Timely cost for UK barbershops?</h2>
      <p class="cost-calc__lead">
        Timely offers Build, Elevate and Innovate plans with a per-bookable-staff subscription model.
        A verifiable universal UK GBP subscription price is not available from the pricing information checked.
        Enter your <strong>actual monthly Timely subscription invoice total (including any VAT)</strong> under Advanced costs,
        or the result will correctly show Custom pricing rather than invent a cost.
      </p>
      <p class="cost-calc__checked">Checked <time datetime={TIMELY_FACTS_CHECKED_ISO}>{TIMELY_FACTS_CHECKED_DATE}</time> · <a href={pricing.url} target="_blank" rel="noopener noreferrer">{pricing.label}</a></p>
    </header>
    <div class="cost-calc-platform__detail">
      <dl class="cost-calc-facts">
        <div class="cost-calc-facts__row"><dt>UK subscription price</dt><dd>Your real monthly invoice quote (incl. any VAT)</dd></div>
        <div class="cost-calc-facts__row"><dt>Team pricing</dt><dd>Timely bills by active bookable staff; no verified GBP amount is assumed</dd></div>
        <div class="cost-calc-facts__row"><dt>TimelyPay UK domestic online cards</dt><dd>{payment.percent}% + {Math.round(payment.fixedGbp * 100)}p per transaction (published standard rate)</dd></div>
        <div class="cost-calc-facts__row"><dt>Payment example</dt><dd>£5 deposit: 39p fee for a domestic UK card</dd></div>
      </dl>
      <ul class="cost-calc__list cost-calc-platform__notes">
        <li>Timely UK online payment rates changed on 5 August 2026. International and Amex are 3% + 30p; customer-specific pricing can vary.</li>
        <li>The invoice input is already VAT-inclusive where applicable; the calculator cannot separate deductible VAT without your invoice breakdown.</li>
        <li>Deposit processing uses only the domestic UK online card benchmark. Optional Timely products, in-person payment fees and refunds are not estimated.</li>
        <li>Confirm your own charges in TimelyPay and invoice. <a href={fees.url} target="_blank" rel="noopener noreferrer">Timely official processing rates</a>.</li>
      </ul>
      <p class="cost-calc__crosslink"><a href="/timely-alternative">Read the full KERSIVO vs Timely alternative comparison</a></p>
    </div>
  </div>
</section>
