---
import {
  ADVANCED_COSTS_LABEL,
  APPOINTMENTS_FIELD,
  APPOINTMENT_VALUE_FIELD,
  BARBERS_FIELD,
  BOOST_TOGGLE,
  CALC_PANEL_LABEL,
  FRESHA_ADD_ONS,
  FRESHA_ADD_ONS_LEGEND,
  MARKETPLACE_CLIENTS_FIELD,
  MARKETPLACE_HEADING,
  PAYMENTS_TOGGLE,
  SPLIT_ASSUMPTIONS_TOGGLE,
  SPLIT_FIELDS,
  VAT_OPTIONS,
} from '@/lib/costCalculator/calculatorUi';

const helperId = (id: string) => `${id}-helper`;
---

<form
  id="calculator"
  class="cost-calc-surface calc-panel"
  aria-labelledby="calc-panel-title"
  data-calc-form
  novalidate
>
  <div class="calc-panel__head">
    <h2 id="calc-panel-title" class="calc-panel__label">{CALC_PANEL_LABEL}</h2>
    <span class="calc-panel__models" aria-hidden="true">Booksy · Fresha · KERSIVO</span>
  </div>

  <div class="calc-panel__core">
    <div class="calc-field calc-field--barbers">
      <label class="calc-field__label" for={BARBERS_FIELD.id}>{BARBERS_FIELD.label}</label>
      <div class="calc-stepper" data-calc-stepper>
        <button
          type="button"
          class="calc-stepper__btn"
          data-step="-1"
          aria-controls={BARBERS_FIELD.id}
          aria-label="Remove one bookable barber"
        >
          <span aria-hidden="true">−</span>
        </button>
        <input
          id={BARBERS_FIELD.id}
          class="calc-stepper__value"
          type="number"
          inputmode="numeric"
          name={BARBERS_FIELD.name}
          value={BARBERS_FIELD.defaultValue}
          min={BARBERS_FIELD.min}
          max={BARBERS_FIELD.max}
          step={BARBERS_FIELD.step}
        />
        <button
          type="button"
          class="calc-stepper__btn"
          data-step="1"
          aria-controls={BARBERS_FIELD.id}
          aria-label="Add one bookable barber"
        >
          <span aria-hidden="true">+</span>
        </button>
      </div>
    </div>

    <div class="calc-panel__pair">
      <div class="calc-field">
        <label class="calc-field__label" for={APPOINTMENTS_FIELD.id}>{APPOINTMENTS_FIELD.label}</label>
        <input
          id={APPOINTMENTS_FIELD.id}
          class="calc-input"
          type="number"
          inputmode="numeric"
          name={APPOINTMENTS_FIELD.name}
          value={APPOINTMENTS_FIELD.defaultValue}
          min={APPOINTMENTS_FIELD.min}
          max={APPOINTMENTS_FIELD.max}
          step={APPOINTMENTS_FIELD.step}
          aria-describedby={helperId(APPOINTMENTS_FIELD.id)}
        />
        <p id={helperId(APPOINTMENTS_FIELD.id)} class="calc-field__helper">{APPOINTMENTS_FIELD.helper}</p>
      </div>

      <div class="calc-field">
        <label class="calc-field__label" for={APPOINTMENT_VALUE_FIELD.id}>{APPOINTMENT_VALUE_FIELD.label}</label>
        <div class="calc-input calc-input--currency">
          <span class="calc-input__prefix" aria-hidden="true">£</span>
          <input
            id={APPOINTMENT_VALUE_FIELD.id}
            type="number"
            inputmode="decimal"
            name={APPOINTMENT_VALUE_FIELD.name}
            value={APPOINTMENT_VALUE_FIELD.defaultValue}
            min={APPOINTMENT_VALUE_FIELD.min}
            max={APPOINTMENT_VALUE_FIELD.max}
            step={APPOINTMENT_VALUE_FIELD.step}
            aria-describedby={helperId(APPOINTMENT_VALUE_FIELD.id)}
          />
        </div>
        <p id={helperId(APPOINTMENT_VALUE_FIELD.id)} class="calc-field__helper">{APPOINTMENT_VALUE_FIELD.helper}</p>
      </div>
    </div>
  </div>

  <section class="calc-panel__group" aria-labelledby="calc-marketplace-title">
    <h3 id="calc-marketplace-title" class="calc-panel__group-title">{MARKETPLACE_HEADING}</h3>

    <div class="calc-field calc-field--inline">
      <div class="calc-field__text">
        <label class="calc-field__label" for={MARKETPLACE_CLIENTS_FIELD.id}>{MARKETPLACE_CLIENTS_FIELD.label}</label>
        <p id={helperId(MARKETPLACE_CLIENTS_FIELD.id)} class="calc-field__helper">{MARKETPLACE_CLIENTS_FIELD.helper}</p>
      </div>
      <input
        id={MARKETPLACE_CLIENTS_FIELD.id}
        class="calc-input calc-input--compact"
        type="number"
        inputmode="numeric"
        name={MARKETPLACE_CLIENTS_FIELD.name}
        value={MARKETPLACE_CLIENTS_FIELD.defaultValue}
        min={MARKETPLACE_CLIENTS_FIELD.min}
        max={MARKETPLACE_CLIENTS_FIELD.max}
        step={MARKETPLACE_CLIENTS_FIELD.step}
        aria-describedby={helperId(MARKETPLACE_CLIENTS_FIELD.id)}
      />
    </div>

    <div class="calc-field calc-field--inline">
      <div class="calc-field__text">
        <label class="calc-field__label" for={BOOST_TOGGLE.id}>{BOOST_TOGGLE.label}</label>
        <p id={helperId(BOOST_TOGGLE.id)} class="calc-field__helper">{BOOST_TOGGLE.helper}</p>
      </div>
      <span class="calc-switch">
        <input
          id={BOOST_TOGGLE.id}
          class="calc-switch__input"
          type="checkbox"
          role="switch"
          name={BOOST_TOGGLE.name}
          checked={BOOST_TOGGLE.defaultOn}
          aria-describedby={helperId(BOOST_TOGGLE.id)}
        />
        <span class="calc-switch__track" aria-hidden="true"><span class="calc-switch__thumb"></span></span>
        <span class="calc-switch__state" aria-hidden="true">
          <span class="calc-switch__off">Off</span>
          <span class="calc-switch__on">On</span>
        </span>
      </span>
    </div>

    <div class="calc-split">
      <label class="calc-check" for={SPLIT_ASSUMPTIONS_TOGGLE.id}>
        <input
          id={SPLIT_ASSUMPTIONS_TOGGLE.id}
          class="calc-check__input"
          type="checkbox"
          name={SPLIT_ASSUMPTIONS_TOGGLE.name}
          checked={SPLIT_ASSUMPTIONS_TOGGLE.defaultOn}
          aria-controls="calc-split-fields"
          data-calc-reveal
        />
        <span class="calc-check__box" aria-hidden="true"></span>
        <span class="calc-check__label">{SPLIT_ASSUMPTIONS_TOGGLE.label}</span>
      </label>

      <div id="calc-split-fields" class="calc-split__fields" hidden>
        {
          SPLIT_FIELDS.map((field) => (
            <div class="calc-field">
              <label class="calc-field__label" for={field.id}>
                {field.label}
              </label>
              <input
                id={field.id}
                class="calc-input"
                type="number"
                inputmode="numeric"
                name={field.name}
                value={field.defaultValue}
                min={field.min}
                max={field.max}
                step={field.step}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <details class="calc-advanced">
    <summary class="calc-advanced__summary">
      <span>{ADVANCED_COSTS_LABEL}</span>
      <span class="calc-advanced__hint">VAT, Fresha add-ons, payments</span>
      <span class="calc-advanced__chevron" aria-hidden="true"></span>
    </summary>

    <div class="calc-advanced__body">
      <fieldset class="calc-fieldset">
        <legend class="calc-field__label">{VAT_OPTIONS.legend}</legend>
        <div class="calc-segmented calc-segmented--small">
          {
            VAT_OPTIONS.options.map((option) => (
              <label class="calc-segmented__option">
                <input
                  type="radio"
                  name={VAT_OPTIONS.name}
                  value={option.value}
                  checked={option.value === VAT_OPTIONS.defaultValue}
                />
                <span>{option.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="calc-fieldset">
        <legend class="calc-field__label">{FRESHA_ADD_ONS_LEGEND}</legend>
        <div class="calc-addons">
          {
            FRESHA_ADD_ONS.map((addOn) => (
              <label class="calc-check calc-check--row" for={addOn.id}>
                <input id={addOn.id} class="calc-check__input" type="checkbox" name={addOn.name} />
                <span class="calc-check__box" aria-hidden="true" />
                <span class="calc-check__label">{addOn.label}</span>
                <span class="calc-check__meta">{addOn.priceLabel}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="calc-fieldset">
        <div class="calc-field calc-field--inline">
          <label class="calc-field__label" for={PAYMENTS_TOGGLE.id}>{PAYMENTS_TOGGLE.label}</label>
          <span class="calc-switch">
            <input
              id={PAYMENTS_TOGGLE.id}
              class="calc-switch__input"
              type="checkbox"
              role="switch"
              name={PAYMENTS_TOGGLE.name}
              checked={PAYMENTS_TOGGLE.defaultOn}
              aria-controls="calc-payments-note"
              data-calc-reveal
            />
            <span class="calc-switch__track" aria-hidden="true"><span class="calc-switch__thumb"></span></span>
            <span class="calc-switch__state" aria-hidden="true">
              <span class="calc-switch__off">Off</span>
              <span class="calc-switch__on">On</span>
            </span>
          </span>
        </div>
        <p id="calc-payments-note" class="calc-pending" hidden>{PAYMENTS_TOGGLE.pendingNote}</p>
      </div>
    </div>
  </details>
</form>

<script>
  import { initCalculatorShell } from '@/lib/costCalculator/initCalculatorShell';

  initCalculatorShell(document);
  document.addEventListener('astro:page-load', () => initCalculatorShell(document));
</script>
