---
import {
  ADVANCED_COSTS_LABEL,
  APPOINTMENTS_FIELD,
  APPOINTMENT_VALUE_FIELD,
  BARBERS_FIELD,
  BOOST_TOGGLE,
  CALC_PANEL_LABEL,
  FRESHA_ADD_ONS,
  FRESHA_ADD_ONS_LEGEND,
  NEARCUT_SUBSCRIPTION_TOGGLE,
  NEARCUT_QUOTE_FIELD,
  PHOREST_QUOTE_FIELD,
  PHOREST_QUOTE_VAT,
  MARKETPLACE_CLIENTS_FIELD,
  MARKETPLACE_HEADING,
  DEPOSIT_BOOKINGS_FIELD,
  DEPOSIT_PROCESSING_TOGGLE,
  SPLIT_ASSUMPTIONS_TOGGLE,
  SPLIT_FIELDS,
  VAT_OPTIONS,
} from '@/lib/costCalculator/calculatorUi';

const helperId = (id: string) => `${id}-helper`;
const errorId = (id: string) => `${id}-error`;
const describedBy = (id: string, withHelper: boolean) =>
  withHelper ? `${helperId(id)} ${errorId(id)}` : errorId(id);
---

<form
  id="calculator"
  class="cost-calc-surface calc-panel"
  aria-labelledby="calc-panel-title"
  data-calc-form
  novalidate
>
  <div class="calc-panel__head">
    <h2 id="calc-panel-title" class="calc-panel__label">{CALC_PANEL_LABEL}</h2>
    <span class="calc-panel__models" aria-hidden="true">Booksy · Fresha · Nearcut · Setora · Phorest · KERSIVO</span>
  </div>

  <div class="calc-panel__core">
    <div class="calc-field calc-field--barbers">
      <label class="calc-field__label" for={BARBERS_FIELD.id}>{BARBERS_FIELD.label}</label>
      <div class="calc-stepper" data-calc-stepper>
        <button
          type="button"
          class="calc-stepper__btn"
          data-step="-1"
          aria-controls={BARBERS_FIELD.id}
          aria-label="Remove one bookable barber"
        >
          <span aria-hidden="true">−</span>
        </button>
        <input
          id={BARBERS_FIELD.id}
          class="calc-stepper__value"
          type="number"
          inputmode="numeric"
          name={BARBERS_FIELD.name}
          value={BARBERS_FIELD.defaultValue}
          min={BARBERS_FIELD.min}
          max={BARBERS_FIELD.max}
          step={BARBERS_FIELD.step}
          aria-describedby={describedBy(BARBERS_FIELD.id, false)}
        />
        <button
          type="button"
          class="calc-stepper__btn"
          data-step="1"
          aria-controls={BARBERS_FIELD.id}
          aria-label="Add one bookable barber"
        >
          <span aria-hidden="true">+</span>
        </button>
      </div>
      <p id={errorId(BARBERS_FIELD.id)} class="calc-field__error" data-calc-error hidden></p>
    </div>

    <div class="calc-panel__pair">
      <div class="calc-field">
        <label class="calc-field__label" for={APPOINTMENTS_FIELD.id}>{APPOINTMENTS_FIELD.label}</label>
        <input
          id={APPOINTMENTS_FIELD.id}
          class="calc-input"
          type="number"
          inputmode="numeric"
          name={APPOINTMENTS_FIELD.name}
          value={APPOINTMENTS_FIELD.defaultValue}
          min={APPOINTMENTS_FIELD.min}
          max={APPOINTMENTS_FIELD.max}
          step={APPOINTMENTS_FIELD.step}
          aria-describedby={describedBy(APPOINTMENTS_FIELD.id, true)}
        />
        <p id={helperId(APPOINTMENTS_FIELD.id)} class="calc-field__helper">{APPOINTMENTS_FIELD.helper}</p>
        <p id={errorId(APPOINTMENTS_FIELD.id)} class="calc-field__error" data-calc-error hidden></p>
      </div>

      <div class="calc-field">
        <label class="calc-field__label" for={APPOINTMENT_VALUE_FIELD.id}>{APPOINTMENT_VALUE_FIELD.label}</label>
        <div class="calc-input calc-input--currency">
          <span class="calc-input__prefix" aria-hidden="true">£</span>
          <input
            id={APPOINTMENT_VALUE_FIELD.id}
            type="number"
            inputmode="decimal"
            name={APPOINTMENT_VALUE_FIELD.name}
            value={APPOINTMENT_VALUE_FIELD.defaultValue}
            min={APPOINTMENT_VALUE_FIELD.min}
            max={APPOINTMENT_VALUE_FIELD.max}
            step={APPOINTMENT_VALUE_FIELD.step}
            aria-describedby={describedBy(APPOINTMENT_VALUE_FIELD.id, true)}
          />
        </div>
        <p id={helperId(APPOINTMENT_VALUE_FIELD.id)} class="calc-field__helper">{APPOINTMENT_VALUE_FIELD.helper}</p>
        <p id={errorId(APPOINTMENT_VALUE_FIELD.id)} class="calc-field__error" data-calc-error hidden></p>
      </div>
    </div>
  </div>

  <section class="calc-panel__group" aria-labelledby="calc-marketplace-title">
    <h3 id="calc-marketplace-title" class="calc-panel__group-title">{MARKETPLACE_HEADING}</h3>

    <div class="calc-field calc-field--inline">
      <div class="calc-field__text">
        <label class="calc-field__label" for={MARKETPLACE_CLIENTS_FIELD.id}>{MARKETPLACE_CLIENTS_FIELD.label}</label>
        <p id={helperId(MARKETPLACE_CLIENTS_FIELD.id)} class="calc-field__helper">{MARKETPLACE_CLIENTS_FIELD.helper}</p>
      </div>
      <input
        id={MARKETPLACE_CLIENTS_FIELD.id}
        class="calc-input calc-input--compact"
        type="number"
        inputmode="numeric"
        name={MARKETPLACE_CLIENTS_FIELD.name}
        value={MARKETPLACE_CLIENTS_FIELD.defaultValue}
        min={MARKETPLACE_CLIENTS_FIELD.min}
        max={MARKETPLACE_CLIENTS_FIELD.max}
        step={MARKETPLACE_CLIENTS_FIELD.step}
        aria-describedby={describedBy(MARKETPLACE_CLIENTS_FIELD.id, true)}
      />
      <p id={errorId(MARKETPLACE_CLIENTS_FIELD.id)} class="calc-field__error calc-field__error--full" data-calc-error hidden></p>
    </div>

    <div class="calc-field calc-field--inline">
      <div class="calc-field__text">
        <label class="calc-field__label" for={BOOST_TOGGLE.id}>{BOOST_TOGGLE.label}</label>
        <p id={helperId(BOOST_TOGGLE.id)} class="calc-field__helper">{BOOST_TOGGLE.helper}</p>
      </div>
      <span class="calc-switch">
        <input
          id={BOOST_TOGGLE.id}
          class="calc-switch__input"
          type="checkbox"
          role="switch"
          name={BOOST_TOGGLE.name}
          checked={BOOST_TOGGLE.defaultOn}
          aria-describedby={helperId(BOOST_TOGGLE.id)}
        />
        <span class="calc-switch__track" aria-hidden="true"><span class="calc-switch__thumb"></span></span>
        <span class="calc-switch__state" aria-hidden="true">
          <span class="calc-switch__off">Off</span>
          <span class="calc-switch__on">On</span>
        </span>
      </span>
    </div>

    <div class="calc-split">
      <label class="calc-check" for={SPLIT_ASSUMPTIONS_TOGGLE.id}>
        <input
          id={SPLIT_ASSUMPTIONS_TOGGLE.id}
          class="calc-check__input"
          type="checkbox"
          name={SPLIT_ASSUMPTIONS_TOGGLE.name}
          checked={SPLIT_ASSUMPTIONS_TOGGLE.defaultOn}
          aria-controls="calc-split-fields"
          data-calc-reveal
        />
        <span class="calc-check__box" aria-hidden="true"></span>
        <span class="calc-check__label">{SPLIT_ASSUMPTIONS_TOGGLE.label}</span>
      </label>

      <div id="calc-split-fields" class="calc-split__fields" hidden>
        {
          SPLIT_FIELDS.map((field) => (
            <div class="calc-field">
              <label class="calc-field__label" for={field.id}>
                {field.label}
              </label>
              <input
                id={field.id}
                class="calc-input"
                type="number"
                inputmode="numeric"
                name={field.name}
                value={field.defaultValue}
                min={field.min}
                max={field.max}
                step={field.step}
                aria-describedby={describedBy(field.id, false)}
              />
              <p id={errorId(field.id)} class="calc-field__error" data-calc-error hidden />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <details class="calc-advanced">
    <summary class="calc-advanced__summary">
      <span>{ADVANCED_COSTS_LABEL}</span>
      <span class="calc-advanced__hint">VAT, Nearcut, Phorest quote, add-ons, deposits</span>
      <span class="calc-advanced__chevron" aria-hidden="true"></span>
    </summary>

    <div class="calc-advanced__body">
      <fieldset class="calc-fieldset">
        <legend class="calc-field__label">{VAT_OPTIONS.legend}</legend>
        <div class="calc-segmented calc-segmented--small">
          {
            VAT_OPTIONS.options.map((option) => (
              <label class="calc-segmented__option">
                <input
                  type="radio"
                  name={VAT_OPTIONS.name}
                  value={option.value}
                  checked={option.value === VAT_OPTIONS.defaultValue}
                />
                <span>{option.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="calc-fieldset">
        <legend class="calc-field__label">{FRESHA_ADD_ONS_LEGEND}</legend>
        <div class="calc-addons">
          {
            FRESHA_ADD_ONS.map((addOn) => (
              <label class="calc-check calc-check--row" for={addOn.id}>
                <input id={addOn.id} class="calc-check__input" type="checkbox" name={addOn.name} />
                <span class="calc-check__box" aria-hidden="true" />
                <span class="calc-check__label">{addOn.label}</span>
                <span class="calc-check__meta">{addOn.priceLabel}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="calc-fieldset">
        <div class="calc-field calc-field--inline">
          <div>
            <label class="calc-field__label" for={NEARCUT_SUBSCRIPTION_TOGGLE.id}>{NEARCUT_SUBSCRIPTION_TOGGLE.label}</label>
            <p class="calc-field__helper">{NEARCUT_SUBSCRIPTION_TOGGLE.helper}</p>
          </div>
          <span class="calc-switch">
            <input
              id={NEARCUT_SUBSCRIPTION_TOGGLE.id}
              class="calc-switch__input"
              type="checkbox"
              role="switch"
              name={NEARCUT_SUBSCRIPTION_TOGGLE.name}
              checked={NEARCUT_SUBSCRIPTION_TOGGLE.defaultOn}
              aria-controls={NEARCUT_SUBSCRIPTION_TOGGLE.fieldsId}
              data-calc-reveal
            />
            <span class="calc-switch__track" aria-hidden="true"><span class="calc-switch__thumb"></span></span>
            <span class="calc-switch__state" aria-hidden="true">
              <span class="calc-switch__off">Off</span><span class="calc-switch__on">On</span>
            </span>
          </span>
        </div>
        <div id={NEARCUT_SUBSCRIPTION_TOGGLE.fieldsId} class="calc-deposit__fields" hidden={!NEARCUT_SUBSCRIPTION_TOGGLE.defaultOn}>
          <div class="calc-field">
            <label class="calc-field__label" for={NEARCUT_QUOTE_FIELD.id}>{NEARCUT_QUOTE_FIELD.label}</label>
            <input
              id={NEARCUT_QUOTE_FIELD.id}
              class="calc-input"
              type="number"
              inputmode="decimal"
              name={NEARCUT_QUOTE_FIELD.name}
              value={NEARCUT_QUOTE_FIELD.defaultValue}
              min={NEARCUT_QUOTE_FIELD.min}
              max={NEARCUT_QUOTE_FIELD.max}
              step={NEARCUT_QUOTE_FIELD.step}
              aria-describedby={describedBy(NEARCUT_QUOTE_FIELD.id, true)}
            />
            <p id={helperId(NEARCUT_QUOTE_FIELD.id)} class="calc-field__helper">{NEARCUT_QUOTE_FIELD.helper}</p>
            <p id={errorId(NEARCUT_QUOTE_FIELD.id)} class="calc-field__error" data-calc-error hidden></p>
          </div>
        </div>
      </div>


      <fieldset class="calc-fieldset" aria-labelledby="calc-phorest-quote-title">
        <legend id="calc-phorest-quote-title" class="calc-field__label">Phorest · your confirmed quote</legend>
        <p class="calc-field__helper">
          Phorest publishes no universal monthly price for UK shops. Add your own quote to
          compare a monthly subscription. SMS, add-ons and card fees are not assumed.
        </p>
        <div class="calc-field">
          <label class="calc-field__label" for={PHOREST_QUOTE_FIELD.id}>{PHOREST_QUOTE_FIELD.label}</label>
          <div class="calc-input calc-input--currency">
            <span class="calc-input__prefix" aria-hidden="true">£</span>
            <input
              id={PHOREST_QUOTE_FIELD.id}
              type="number"
              inputmode="decimal"
              name={PHOREST_QUOTE_FIELD.name}
              value={PHOREST_QUOTE_FIELD.defaultValue}
              min={PHOREST_QUOTE_FIELD.min}
              max={PHOREST_QUOTE_FIELD.max}
              step={PHOREST_QUOTE_FIELD.step}
              aria-describedby={describedBy(PHOREST_QUOTE_FIELD.id, true)}
            />
          </div>
          <p id={helperId(PHOREST_QUOTE_FIELD.id)} class="calc-field__helper">{PHOREST_QUOTE_FIELD.helper}</p>
          <p id={errorId(PHOREST_QUOTE_FIELD.id)} class="calc-field__error" data-calc-error hidden></p>
        </div>
        <fieldset class="calc-fieldset">
          <legend class="calc-field__label">{PHOREST_QUOTE_VAT.legend}</legend>
          <div class="calc-segmented calc-segmented--small">
            {PHOREST_QUOTE_VAT.options.map(option => (
              <label class="calc-segmented__option">
                <input
                  type="radio"
                  name={PHOREST_QUOTE_VAT.name}
                  value={option.value}
                  checked={option.value === PHOREST_QUOTE_VAT.defaultValue}
                />
                <span>{option.label}</span>
              </label>
            ))}
          </div>
          <p class="calc-field__helper">Only select 20% or No VAT if confirmed by your quote/invoice. Otherwise Phorest stays at Custom pricing.</p>
        </fieldset>
        <p class="calc-field__helper">If you enable booking deposit processing, the Phorest total becomes Custom pricing because a verified PhorestPay rate is not available.</p>
      </fieldset>
      <div class="calc-fieldset">
        <div class="calc-field calc-field--inline">
          <label class="calc-field__label" for={DEPOSIT_PROCESSING_TOGGLE.id}>{DEPOSIT_PROCESSING_TOGGLE.label}</label>
          <span class="calc-switch">
            <input
              id={DEPOSIT_PROCESSING_TOGGLE.id}
              class="calc-switch__input"
              type="checkbox"
              role="switch"
              name={DEPOSIT_PROCESSING_TOGGLE.name}
              checked={DEPOSIT_PROCESSING_TOGGLE.defaultOn}
              aria-controls={DEPOSIT_PROCESSING_TOGGLE.fieldsId}
              data-calc-reveal
            />
            <span class="calc-switch__track" aria-hidden="true"><span class="calc-switch__thumb"></span></span>
            <span class="calc-switch__state" aria-hidden="true">
              <span class="calc-switch__off">Off</span>
              <span class="calc-switch__on">On</span>
            </span>
          </span>
        </div>

        <div id={DEPOSIT_PROCESSING_TOGGLE.fieldsId} class="calc-deposit__fields" hidden={!DEPOSIT_PROCESSING_TOGGLE.defaultOn}>
          <div class="calc-field">
            <label class="calc-field__label" for={DEPOSIT_BOOKINGS_FIELD.id}>{DEPOSIT_BOOKINGS_FIELD.label}</label>
            <input
              id={DEPOSIT_BOOKINGS_FIELD.id}
              class="calc-input"
              type="number"
              inputmode="numeric"
              name={DEPOSIT_BOOKINGS_FIELD.name}
              value={DEPOSIT_BOOKINGS_FIELD.defaultValue}
              min={DEPOSIT_BOOKINGS_FIELD.min}
              max={DEPOSIT_BOOKINGS_FIELD.max}
              step={DEPOSIT_BOOKINGS_FIELD.step}
              aria-describedby={describedBy(DEPOSIT_BOOKINGS_FIELD.id, true)}
            />
            <p id={helperId(DEPOSIT_BOOKINGS_FIELD.id)} class="calc-field__helper">{DEPOSIT_BOOKINGS_FIELD.helper}</p>
            <p id={errorId(DEPOSIT_BOOKINGS_FIELD.id)} class="calc-field__error" data-calc-error hidden></p>
          </div>
        </div>
      </div>
    </div>
  </details>
</form>

<script>
  import { initCalculator } from '@/lib/costCalculator/initCalculator';

  initCalculator(document);
  document.addEventListener('astro:page-load', () => initCalculator(document));
</script>
