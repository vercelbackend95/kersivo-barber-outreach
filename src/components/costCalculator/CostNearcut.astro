---
import { NEARCUT_COST_FACTS, NEARCUT_COST_INTRO, NEARCUT_COST_NOTES } from '@/lib/seo/barberCostCalculatorPage';
import { NEARCUT_FACTS_CHECKED_DATE, NEARCUT_FACTS_CHECKED_ISO, getNearcutSource } from '@/lib/seo/nearcutFacts';

const pricing = getNearcutSource('pricingUk');
---
<section id="nearcut-cost" class="cost-calc__section" aria-labelledby="cost-calc-nearcut-title">
  <div class="container cost-calc-platform">
    <header class="cost-calc__intro cost-calc-platform__intro">
      <p class="cost-calc__eyebrow">Nearcut pricing</p>
      <h2 id="cost-calc-nearcut-title" class="cost-calc__h2">How much does Nearcut cost in the UK?</h2>
      <p class="cost-calc__lead">{NEARCUT_COST_INTRO}</p>
      <p class="cost-calc__checked">
        Checked <time datetime={NEARCUT_FACTS_CHECKED_ISO}>{NEARCUT_FACTS_CHECKED_DATE}</time> ·
        <a href={pricing.url} target="_blank" rel="noopener noreferrer">{pricing.label}</a>
      </p>
    </header>
    <div class="cost-calc-platform__detail">
      <dl class="cost-calc-facts">
        {NEARCUT_COST_FACTS.map((fact) => (
          <div class="cost-calc-facts__row">
            <dt>{fact.label}</dt><dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
      <ul class="cost-calc__list cost-calc-platform__notes">
        {NEARCUT_COST_NOTES.map((note) => <li>{note}</li>)}
      </ul>
      <p class="cost-calc__crosslink"><a href="/nearcut-alternative">See the full KERSIVO vs Nearcut comparison</a></p>
    </div>
  </div>
</section>
