---
import { COST_SCENARIO_TABLES } from '@/lib/costCalculator/costScenarios';
import { formatMoneyGbp } from '@/lib/costCalculator/money';
import { barShare } from '@/lib/costCalculator/costVerdict';
import { BARBER_COST_CALCULATOR_PAGE_PATH, SCENARIOS_INTRO, SCENARIOS_NOTE } from '@/lib/seo/barberCostCalculatorPage';

const displayName = (id: string, name: string) => (id === 'kersivo' ? 'Full KERSIVO' : name);
const tables = COST_SCENARIO_TABLES.map((scenario) => {
  const priced = scenario.rows
    .filter((row): row is typeof row & { monthlyGbp: number } => row.monthlyGbp !== null)
    .sort((a, b) => b.monthlyGbp - a.monthlyGbp);
  const max = Math.max(...priced.map((row) => row.monthlyGbp));
  return {
    ...scenario,
    priced: priced.map((row) => ({ ...row, share: barShare(row.monthlyGbp, max) })),
    quoted: scenario.rows.filter((row) => row.monthlyGbp === null).map((row) => row.name),
  };
});
---

<section id="cost-examples" class="cost-calc__section cost-examples" aria-labelledby="cost-calc-scenarios-title">
  <div class="container">
    <header class="cost-calc__intro">
      <p class="cost-calc__eyebrow">Worked examples</p>
      <h2 id="cost-calc-scenarios-title" class="cost-calc__h2">Cost examples for different UK barbershops</h2>
      <p class="cost-calc__lead">{SCENARIOS_INTRO}</p>
    </header>

    <ul class="cost-calc-scenarios">
      {
        tables.map((scenario) => (
          <li class="cost-calc-scenarios__item">
            <div class="cost-calc-scenarios__head">
              <h3 id={`cost-calc-scenario-${scenario.barbers}`} class="cost-calc-scenarios__title">{scenario.label}</h3>
              <p class="cost-calc-scenarios__barbers">{scenario.inputs}</p>
            </div>

            <ol class="cost-calc-scenarios__bars" aria-hidden="true">
              {scenario.priced.map((row) => (
                <li
                  class="cost-calc-scenarios__bar"
                  data-kersivo={row.providerId === 'kersivo' ? 'true' : undefined}
                  style={`--share:${row.share.toFixed(4)}`}
                >
                  <span class="cost-calc-scenarios__bar-name">{displayName(row.providerId, row.name)}</span>
                  <span class="cost-calc-scenarios__bar-track">
                    <span class="cost-calc-scenarios__bar-fill" />
                  </span>
                  <span class="cost-calc-scenarios__bar-value">{formatMoneyGbp(row.monthlyGbp)}</span>
                </li>
              ))}
            </ol>

            <table class="cost-calc-scenarios__table sr-only" aria-labelledby={`cost-calc-scenario-${scenario.barbers}`}>
              <thead>
                <tr>
                  <th scope="col">Provider</th>
                  <th scope="col">Per month</th>
                </tr>
              </thead>
              <tbody>
                {scenario.rows.map((row) => (
                  <tr data-provider={row.providerId} data-state={row.state}>
                    <th scope="row">{row.name}</th>
                    <td>{row.monthlyTotal}</td>
                  </tr>
                ))}
              </tbody>
            </table>

            <p class="cost-calc-scenarios__quoted">Needs your quote: {scenario.quoted.join(', ')}</p>
            <a
              class="cost-calc-scenarios__load"
              href={`${BARBER_COST_CALCULATOR_PAGE_PATH}?${scenario.loadQuery}#calculator`}
              rel="nofollow"
              data-calc-load
              data-track="cost_calculator_example_load"
              data-track-placement={`cost_calculator_example_${scenario.barbers}`}
            >
              Load this shop into the calculator <span aria-hidden="true">↑</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="cost-calc__closing">{SCENARIOS_NOTE}</p>
  </div>
</section>
