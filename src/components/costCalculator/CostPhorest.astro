---
import { PHOREST_COST_INTRO, PHOREST_COST_FACTS, PHOREST_COST_NOTES } from '@/lib/seo/barberCostCalculatorPage';
import { PHOREST_FACTS_CHECKED_DATE, PHOREST_FACTS_CHECKED_ISO, getPhorestSource } from '@/lib/seo/phorestFacts';
const pricing = getPhorestSource('pricing');
---
<section id="phorest-cost" class="cost-calc__section" aria-labelledby="cost-calc-phorest-title">
  <div class="container cost-calc-platform">
    <header class="cost-calc__intro cost-calc-platform__intro">
      <p class="cost-calc__eyebrow">Phorest pricing UK</p>
      <h2 id="cost-calc-phorest-title" class="cost-calc__h2">How much does Phorest cost in the UK?</h2>
      <p class="cost-calc__lead">{PHOREST_COST_INTRO}</p>
      <p class="cost-calc__checked">
        Checked <time datetime={PHOREST_FACTS_CHECKED_ISO}>{PHOREST_FACTS_CHECKED_DATE}</time> ·
        <a href={pricing.url} target="_blank" rel="noopener noreferrer">{pricing.label}</a>
      </p>
    </header>
    <div class="cost-calc-platform__detail">
      <dl class="cost-calc-facts">
        {PHOREST_COST_FACTS.map(fact => (
          <div class="cost-calc-facts__row">
            <dt>{fact.label}</dt><dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
      <ul class="cost-calc__list cost-calc-platform__notes">
        {PHOREST_COST_NOTES.map(note => <li>{note}</li>)}
      </ul>
      <p class="cost-calc__crosslink">
        <a href="/phorest-alternative">See the full Phorest vs KERSIVO comparison</a>
      </p>
    </div>
  </div>
</section>