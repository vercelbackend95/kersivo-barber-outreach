---
import { COST_AT_A_GLANCE_INTRO, COST_AT_A_GLANCE_MODELS } from '@/lib/seo/barberCostCalculatorPage';
---

<section id="cost-at-a-glance" class="cost-calc__section" aria-labelledby="cost-calc-glance-title">
  <div class="container">
    <header class="cost-calc__intro">
      <p class="cost-calc__eyebrow">Three pricing models</p>
      <h2 id="cost-calc-glance-title" class="cost-calc__h2">Booksy vs Fresha vs KERSIVO: cost at a glance</h2>
      <p class="cost-calc__lead">{COST_AT_A_GLANCE_INTRO}</p>
    </header>

    <div class="cost-calc-models">
      {
        COST_AT_A_GLANCE_MODELS.map((model) => (
          <article class="cost-calc-models__item">
            <h3 class="cost-calc-models__name">{model.name}</h3>
            <p class="cost-calc-models__descriptor">{model.descriptor}</p>
            <ul class="cost-calc__list">
              {model.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
