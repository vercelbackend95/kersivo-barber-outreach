---
import {
  caveatLabel,
  DEFAULT_PERIOD,
  DEFAULT_SCENARIO,
  INSIGHT_EYEBROW,
  NOTES_LABEL,
  PERIOD_OPTIONS,
  PROVIDER_RESULTS,
  RESULTS_HEADING,
  RESULTS_INVALID,
  RESULTS_SUPPORTING,
  SHARED_NOTES_LABEL,
  SHARE_SCENARIO,
  SUMMARY_ROWS,
  THREE_YEAR_NOTE,
} from '@/lib/costCalculator/calculatorUi';
import { buildCalculatorView } from '@/lib/costCalculator/resultView';
import { buildCostVerdict, VERDICT_BAR_ROWS } from '@/lib/costCalculator/costVerdict';
import { formatMoneyGbp } from '@/lib/costCalculator/money';
import SegmentedControl from '@/components/ui/SegmentedControl.astro';
import CostCalcPanel from '@/components/costCalculator/CostCalcPanel.astro';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import { FREE_PREVIEW_CTA_HREF, FREE_PREVIEW_CTA_LABEL, FREE_PREVIEW_CTA_TRACK } from '@/lib/freePreview/fullPlanCta';
import { offer } from '@/content/offer';

const view = buildCalculatorView(DEFAULT_SCENARIO, DEFAULT_PERIOD);
const viewFor = (id: string) => view.providers.find((provider) => provider.id === id)!;
const verdict = buildCostVerdict(view);
const barFor = (id: string) => verdict.bars.findIndex((bar) => bar.id === id);
const freePreview = isFreePreviewFlowEnabled();
const cta = freePreview
  ? { href: FREE_PREVIEW_CTA_HREF, label: FREE_PREVIEW_CTA_LABEL, track: FREE_PREVIEW_CTA_TRACK }
  : { href: '/admin/launch', label: offer.cta.subscribeDirect, track: 'saas_subscribe_click' };
---

<section id="cost-comparison" class="calc-results" aria-labelledby="calc-results-title" data-calc-results>
  <div class="calc-results__inner">
    <div class="calc-workbench">
      <div class="calc-workbench__inputs">
        <CostCalcPanel />
      </div>

      <div class="calc-workbench__output">
        <div class="calc-verdict" data-calc-verdict data-state={verdict.ok ? 'ready' : 'invalid'}>
          <header class="calc-results__header">
            <div class="calc-results__intro">
              <h2 id="calc-results-title" class="calc-results__title">{RESULTS_HEADING}</h2>
              <p class="calc-results__supporting">{RESULTS_SUPPORTING}</p>
            </div>

            <div class="calc-results__period-wrap">
              <SegmentedControl
                as="fieldset"
                name="period"
                legend="Cost period"
                class="calc-results__period"
                data-calc-period
                value={view.period}
                options={PERIOD_OPTIONS}
              />
            </div>
          </header>

          <p class="calc-results__note" data-calc-three-year-note hidden={!view.showThreeYearNote}>{THREE_YEAR_NOTE}</p>
          <p class="calc-results__status" data-slot="results-status" hidden={view.ok}>{RESULTS_INVALID}</p>

          <div class="calc-verdict__hero">
            <p class="calc-verdict__eyebrow"><span class="calc-verdict__dot" aria-hidden="true"></span>Full KERSIVO, whole shop</p>
            <p class="calc-verdict__figure">
              <span class="calc-verdict__amount" data-verdict="kersivo">{verdict.kersivoLabel}</span>
              <span class="calc-verdict__period" data-verdict="period">a month</span>
            </p>
            <p class="calc-verdict__headline" data-verdict="headline">{verdict.headline}</p>
            <ul class="calc-verdict__lines" data-verdict="lines">
              {verdict.lines.map((line) => <li>{line}</li>)}
            </ul>
          </div>

          <ol class="calc-bars" data-calc-bars aria-label="Calculated cash cost by platform, highest first">
            {
              VERDICT_BAR_ROWS.map((provider) => {
                const index = barFor(provider.id);
                const bar = verdict.bars[index];
                return (
                  <li
                    class="calc-bars__row"
                    data-bar={provider.id}
                    data-kersivo={provider.id === 'kersivo' ? 'true' : undefined}
                    hidden={!bar}
                    style={bar ? `order:${index};--share:${bar.share.toFixed(4)}` : undefined}
                  >
                    <span class="calc-bars__name">{provider.name}</span>
                    <span class="calc-bars__track" aria-hidden="true">
                      <span class="calc-bars__fill" />
                    </span>
                    <span class="calc-bars__value" data-bar-value>{bar ? formatMoneyGbp(bar.amountGbp) : ''}</span>
                  </li>
                );
              })
            }
          </ol>

          <p class="calc-verdict__quote" data-verdict="quote" hidden={verdict.quoteNeeded.length === 0}>
            <span class="calc-verdict__quote-label">Needs your quote</span>
            <span data-verdict="quote-names">{verdict.quoteNeeded.join(' · ')}</span>
          </p>

          <div class="calc-verdict__actions">
            <a class="cost-calc-btn cost-calc-btn--primary" href={cta.href} data-track={cta.track} data-track-placement="cost_calculator_results">
              {cta.label}
            </a>
            <div class="calc-share">
              <button type="button" class="calc-share__button" data-calc-share>{SHARE_SCENARIO.label}</button>
              <p class="calc-share__status" data-calc-share-status role="status" aria-live="polite"></p>
            </div>
          </div>
          <p class="sr-only" data-verdict="status" role="status" aria-live="polite"></p>
        </div>
      </div>
    </div>

    <aside class="calc-insight" aria-labelledby="calc-insight-title">
      <p id="calc-insight-title" class="calc-insight__eyebrow">{INSIGHT_EYEBROW}</p>
      <p class="calc-insight__text" data-slot="insight">{view.insight}</p>
    </aside>

    <details class="calc-results__detail">
      <summary class="calc-results__detail-head">
        <span class="calc-results__detail-copy">
          <span class="calc-results__detail-title">Every platform, line by line</span>
          <span class="calc-results__detail-text">The subscription, team fees, marketplace charges, VAT and deposit processing behind each total.</span>
        </span>
        <span class="calc-results__detail-toggle" aria-hidden="true"><span class="calc-advanced__chevron"></span></span>
      </summary>

    <ol class="calc-results__cards">
      {
        PROVIDER_RESULTS.map((provider) => {
          const result = viewFor(provider.id);
          const hasNotes = result.warnings.length + result.assumptions.length > 0;
          return (
            <li class="calc-card" data-provider={provider.id} data-state={result.state}>
              <article class="calc-card__inner" aria-labelledby={`calc-card-${provider.id}`}>
                <h4 id={`calc-card-${provider.id}`} class="calc-card__name">
                  {provider.name}
                </h4>
                <p class="calc-card__period" data-calc-period-label>
                  {view.periodLabel}
                </p>
                <p class="calc-card__total">
                  <span
                    data-slot="total"
                    data-size={result.totalSize}
                    aria-hidden={result.state === 'unavailable' ? 'true' : undefined}
                  >
                    {result.total}
                  </span>
                  <span class="sr-only" data-slot="total-sr">
                    {result.totalSr}
                  </span>
                </p>
                <p class="calc-card__custom" data-slot="custom-note" hidden={!result.customNote}>
                  {result.customNote}
                </p>
                <p class="calc-card__client-note" data-slot="client-fee-note" hidden={!result.clientFeeNote}>{result.clientFeeNote}</p>
                <p class="calc-card__net" data-slot="net">
                  {result.net}
                </p>

                <dl class="calc-card__summary">
                  {SUMMARY_ROWS.map((row) => (
                    <div class="calc-card__row">
                      <dt>{row.label}</dt>
                      <dd data-summary={row.id}>{result.summary[row.id]}</dd>
                    </div>
                  ))}
                </dl>

                <details class="calc-card__breakdown">
                  <summary>
                    View breakdown<span class="sr-only"> for {provider.name}</span>
                    <span class="calc-advanced__chevron" aria-hidden="true" />
                  </summary>
                  <dl class="calc-card__breakdown-list">
                    {provider.breakdown.map((row) => {
                      const cell = result.breakdown[row.id];
                      return (
                        <div class="calc-card__row" data-line={row.id}>
                          <dt>
                            {row.label}
                            <span class="calc-card__detail" data-slot="detail">
                              {cell?.detail}
                            </span>
                          </dt>
                          <dd data-slot="value">{cell?.value}</dd>
                        </div>
                      );
                    })}
                  </dl>
                </details>

                <details class="calc-card__breakdown calc-card__notes" data-slot="notes" hidden={!hasNotes}>
                  <summary>
                    {NOTES_LABEL}
                    <span class="calc-card__notes-flag" data-slot="notes-flag" hidden={result.warnings.length === 0}>
                      {caveatLabel(result.warnings.length)}
                    </span>
                    <span class="sr-only"> for {provider.name}</span>
                    <span class="calc-advanced__chevron" aria-hidden="true" />
                  </summary>
                  <ul class="calc-card__notes-list calc-card__notes-list--warnings" data-slot="warnings">
                    {result.warnings.map((message) => (
                      <li>{message}</li>
                    ))}
                  </ul>
                  <ul class="calc-card__notes-list" data-slot="assumptions">
                    {result.assumptions.map((message) => (
                      <li>{message}</li>
                    ))}
                  </ul>
                </details>
              </article>
            </li>
          );
        })
      }
    </ol>

    <details class="calc-shared-notes" data-slot="shared-notes" hidden={view.sharedAssumptions.length === 0}>
      <summary>
        {SHARED_NOTES_LABEL}
        <span class="calc-advanced__chevron" aria-hidden="true"></span>
      </summary>
      <ul class="calc-card__notes-list" data-slot="shared-assumptions">
        {view.sharedAssumptions.map((message) => <li>{message}</li>)}
      </ul>
    </details>
    </details>

  </div>

  <div class="calc-dock" data-calc-dock data-visible="false" aria-hidden="true">
    <span class="calc-dock__label">KERSIVO</span>
    <span class="calc-dock__amount" data-dock="kersivo">{verdict.kersivoLabel}</span>
    <span class="calc-dock__vs" data-dock="top">{verdict.bars.find((bar) => !bar.isKersivo) ? `${verdict.bars.find((bar) => !bar.isKersivo)!.name} ${formatMoneyGbp(verdict.bars.find((bar) => !bar.isKersivo)!.amountGbp)}` : ''}</span>
    <a class="calc-dock__link" href="#calc-results-title" tabindex="-1">See results</a>
  </div>
</section>
