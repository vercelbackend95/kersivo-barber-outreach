---
import PreviewTopBar from '@/components/freePreview/PreviewTopBar';
import { AdminHubActivityFeed } from './AdminHubActivityFeed';
import { AdminHubColoursTile } from './AdminHubColoursTile';
import { AdminHubContentTile } from './AdminHubContentTile';
import { AdminHubOverviewAnnouncer } from './AdminHubOverviewAnnouncer';
import { AdminHubPreviewPhone } from './AdminHubPreviewPhone';
import { ArrowUpRight, ListChecks, Smartphone, TrendingUp } from '@/components/lucide-react';
import { websiteBuildProgressFromHubStage } from '@/lib/adminHub/buildProgress';
import {
  ADMIN_HUB_OPEN,
  ADMIN_HUB_TILE_ACTIVITY,
  ADMIN_HUB_TILE_CHANGES,
  ADMIN_HUB_TILE_PREVIEW,
  ADMIN_HUB_TILE_PROGRESS,
  ADMIN_HUB_VIEW_ALL,
} from '@/lib/adminHub/copy';
import { ADMIN_HUB_LINKS } from '@/lib/adminHub/links';
import { AdminHubAddMenu } from './AdminHubAddMenu';
import { hubCanAddShopItems, overviewAddMenuFromHub } from '@/lib/adminHub/addMenu';
import {
  isOverviewTerminal,
  overviewActivityFeed,
  overviewChanges,
  overviewHideAddMaterialsPrimary,
  overviewPreviewLocked,
  overviewPrimary,
  overviewShowChangesTile,
  overviewShowLaunch,
  overviewTileHrefs,
} from '@/lib/adminHub/overview';
import type { AdminHubLiveState } from '@/lib/adminHub/liveState';
import {
  HUB_PREVIEW_CARD_LOCKED,
  HUB_PREVIEW_OPEN_WEBSITE,
  HUB_PREVIEW_TRY_BOOKING,
  hubHeaderCopy,
} from '@/lib/freePreview/hubCopy';
import type { HubChangePublic } from '@/lib/freePreview/hubChanges.shared';
import type { HubLaunchProgress } from '@/lib/freePreview/hubLaunch';
import { hostnameOf, type HubActivityItem, type HubStepperStep } from '@/lib/freePreview/hubPage';
import { hubHeaderKind, type HubState } from '@/lib/freePreview/hubStage';
import type { TokenPreviewRequest } from '@/lib/freePreview/previewAccess';

interface Props {
  request: TokenPreviewRequest;
  state: Extract<HubState, { kind: 'hub' }>;
  isOperator: boolean;
  steps?: HubStepperStep[];
  activity: HubActivityItem[];
  hasWebsitePreview: boolean;
  reviewNeed?: string;
  launchProgress?: HubLaunchProgress | null;
  screenshotSrc?: string | null;
  changeItems: HubChangePublic[];
  /** Seeded hub store state: content, colours and preview phone render from it (and update live). */
  liveState: AdminHubLiveState;
}

const {
  request,
  state,
  isOperator,
  activity,
  hasWebsitePreview,
  screenshotSrc,
  changeItems,
  liveState,
} = Astro.props;

const shopName = request.shopName;
const header = hubHeaderCopy(hubHeaderKind(state), shopName);
const primary = overviewPrimary({ state });
const showLaunch = overviewShowLaunch(state);
const buildProgress = websiteBuildProgressFromHubStage(state.stage);
const previewLocked = overviewPreviewLocked(state.stage);
const showChanges = overviewShowChangesTile({ stage: state.stage, hasWebsitePreview });
const hrefs = overviewTileHrefs();
const changes = overviewChanges({
  items: changeItems,
  includedChangeRounds: request.includedChangeRounds,
  changeRoundsUsed: request.changeRoundsUsed,
});
// Half-width tile next to Website content: a few rows, then "View all" (no overflow).
const ACTIVITY_TILE_ROWS = 4;
const feed = overviewActivityFeed(activity, new Date(), ACTIVITY_TILE_ROWS);
const activityHasMore = activity.length > ACTIVITY_TILE_ROWS;
const headerPrimary = primary && !overviewHideAddMaterialsPrimary(state.stage) ? primary : null;
const addMenu = overviewAddMenuFromHub({ stage: state.stage, capabilities: state.capabilities });
const terminal = isOverviewTerminal(state.stage);
---

<article
  class={`admin-hub-overview${!addMenu.empty ? ' admin-has-mobile-fab' : ''}`}
  data-stage={state.stage}
  data-testid="admin-hub-overview"
>
  <div class="admin-section-header">
    <div class="admin-section-header-copy">
      <div class="admin-section-header-title-row">
        <h2 class="admin-section-header-title">{header.h1}</h2>
      </div>
      <p class="admin-section-header-desc">{header.sub}</p>
    </div>
    {
      headerPrimary || showLaunch || !addMenu.empty ? (
        <div class="admin-section-header-actions">
          {showLaunch ? (
            <PreviewTopBar
              client:load
              chrome="checkout-outline"
              token=""
              apiBase="/api/admin-hub"
              shopName={shopName}
              townCity={request.townCity}
              firstName={request.firstName}
              checkoutEmail={request.email}
              hasOwnDomain={request.hasOwnDomain ?? 'not_sure'}
              existingWebsiteHost={hostnameOf(request.websiteUrl)}
              isOperator={isOperator}
              converted={request.status === 'CONVERTED'}
              activeView="website"
              websiteHref={ADMIN_HUB_LINKS.website}
              bookingHref={ADMIN_HUB_LINKS.booking}
            />
          ) : null}
          {headerPrimary ? (
            <a class="btn btn--primary" href={headerPrimary.href} data-testid="admin-hub-primary">
              {headerPrimary.label}
            </a>
          ) : null}
          <AdminHubAddMenu
            client:load
            stage={state.stage}
            capabilities={state.capabilities}
            canAddShop={hubCanAddShopItems(state.stage)}
            tone={addMenu.tone}
            showMobileFab
          />
        </div>
      ) : null
    }
  </div>

  {
    terminal ? (
      <section class="admin-hub-tile admin-hub-calm" data-tile="calm">
        <p>{header.sub}</p>
        {primary ? (
          <a class="btn btn--primary" href={primary.href}>
            {primary.label}
          </a>
        ) : null}
      </section>
    ) : (
      <div class={`admin-hub-bento${showChanges ? '' : ' admin-hub-bento--no-changes'}`}>
        <section class="admin-hub-tile admin-hub-bento__progress" data-tile="progress" aria-labelledby="admin-hub-progress-title">
          <div class="admin-hub-tile__head">
            <span class="admin-hub-tile__icon" aria-hidden="true">
              <TrendingUp width={15} height={15} strokeWidth={1.8} />
            </span>
            <h2 class="admin-hub-tile__title" id="admin-hub-progress-title">{ADMIN_HUB_TILE_PROGRESS}</h2>
          </div>
          {
            buildProgress ? (
              <div
                class="admin-hub-progress"
                style={`--admin-hub-progress-fill:${buildProgress.fillPercent}%`}
                data-stage={buildProgress.stage}
              >
                <div class="admin-hub-progress__rail" aria-hidden="true">
                  <span class="admin-hub-progress__fill"></span>
                </div>
                <ol class="admin-hub-progress__steps" aria-label={ADMIN_HUB_TILE_PROGRESS}>
                  {
                    buildProgress.steps.map((step) => (
                      <li
                        class:list={[
                          'admin-hub-progress__step',
                          step.marker === 'complete' && 'admin-hub-progress__step--done',
                          step.marker === 'current' && 'admin-hub-progress__step--now',
                          step.marker === 'upcoming' && 'admin-hub-progress__step--todo',
                        ]}
                        aria-current={step.marker === 'current' ? 'step' : undefined}
                      >
                        <span class="admin-hub-progress__marker" aria-hidden="true"></span>
                        <span class="admin-hub-progress__label">{step.label}</span>
                        {step.marker === 'current' ? (
                          <span class="admin-hub-sr-only">{buildProgress.stepSr}</span>
                        ) : null}
                      </li>
                    ))
                  }
                </ol>
                <p class="admin-hub-progress__now" aria-hidden="true">
                  <strong>{buildProgress.steps[buildProgress.currentIndex]?.label}</strong>
                  <span>{buildProgress.stepOf}</span>
                </p>
                <p class="admin-hub-progress__copy">{buildProgress.copy}</p>
              </div>
            ) : null
          }
        </section>

        {
          previewLocked ? (
            <section class="admin-hub-tile admin-hub-bento__preview admin-hub-tile--locked" data-tile="preview" aria-labelledby="admin-hub-preview-title">
              <a class="admin-hub-tile__hit" href={hrefs.preview}>
                <span class="admin-hub-sr-only">{ADMIN_HUB_TILE_PREVIEW}</span>
              </a>
              <div class="admin-hub-tile__head">
                <span class="admin-hub-tile__icon" aria-hidden="true">
                  <Smartphone width={15} height={15} strokeWidth={1.8} />
                </span>
                <h2 class="admin-hub-tile__title" id="admin-hub-preview-title">{ADMIN_HUB_TILE_PREVIEW}</h2>
                <span class="admin-hub-tile__open" aria-hidden="true">
                  <ArrowUpRight width={15} height={15} strokeWidth={1.8} />
                </span>
              </div>
              <div class="admin-hub-phonewrap">
                <div class="admin-hub-phone" aria-hidden="true">
                  <div class="admin-hub-phone__screen admin-hub-skel">
                    <span class="admin-hub-phone__notch"></span>
                    <p class="admin-hub-phone__lock">{HUB_PREVIEW_CARD_LOCKED}</p>
                  </div>
                </div>
              </div>
            </section>
          ) : (
            <article class="admin-hub-tile admin-hub-bento__preview" data-tile="preview" aria-labelledby="admin-hub-preview-title">
              <a class="admin-hub-tile__hit" href={hrefs.preview}>
                <span class="admin-hub-sr-only">{ADMIN_HUB_TILE_PREVIEW}</span>
              </a>
              <div class="admin-hub-tile__head">
                <span class="admin-hub-tile__icon" aria-hidden="true">
                  <Smartphone width={15} height={15} strokeWidth={1.8} />
                </span>
                <h2 class="admin-hub-tile__title" id="admin-hub-preview-title">{ADMIN_HUB_TILE_PREVIEW}</h2>
                <span class="admin-hub-tile__open" aria-hidden="true">
                  <ArrowUpRight width={15} height={15} strokeWidth={1.8} />
                </span>
              </div>
              <AdminHubPreviewPhone client:load initialState={liveState} shopName={shopName} screenshotSrc={screenshotSrc} />
              <div class="admin-hub-preview-actions">
                <a class="btn btn--primary btn--sm" href={hrefs.preview}>
                  {HUB_PREVIEW_OPEN_WEBSITE}
                </a>
                <a class="btn btn--outline btn--sm" href={hrefs.booking}>
                  {HUB_PREVIEW_TRY_BOOKING}
                </a>
              </div>
              {!hasWebsitePreview ? <p class="admin-hub-sr-only">Booking preview is available while the website frame is still being added.</p> : null}
            </article>
          )
        }

        <AdminHubContentTile client:load initialState={liveState} stage={state.stage} capabilities={state.capabilities} />

        {
          showChanges ? (
            <a class="admin-hub-tile admin-hub-bento__changes" data-tile="changes" href={hrefs.changes}>
              <div class="admin-hub-tile__head">
                <span class="admin-hub-tile__icon" aria-hidden="true">
                  <ListChecks width={15} height={15} strokeWidth={1.8} />
                </span>
                <span class="admin-hub-tile__title">{ADMIN_HUB_TILE_CHANGES}</span>
                <span class="admin-hub-tile__open" aria-label={ADMIN_HUB_OPEN}>
                  <ArrowUpRight width={15} height={15} strokeWidth={1.8} aria-hidden="true" />
                </span>
              </div>
              <div class="admin-hub-chstats">
                <div class="admin-hub-chstat">
                  <b>{changes.drafts}</b>
                  <span>{changes.labels.drafts}</span>
                </div>
                <div class="admin-hub-chstat">
                  <b>{changes.withKersivo}</b>
                  <span>{changes.labels.withKersivo}</span>
                </div>
                <div class="admin-hub-chstat">
                  <b>{changes.done}</b>
                  <span>{changes.labels.done}</span>
                </div>
              </div>
              {
                changes.latest.length ? (
                  <ul class="admin-hub-chlist">
                    {changes.latest.map((item) => (
                      <li>
                        <span class="admin-hub-chip admin-hub-chip--page">{item.pageLabel}</span>
                        <span class="admin-hub-chlist__body">{item.body}</span>
                        <span class={`admin-hub-chip admin-hub-chip--${item.tone}`}>{item.statusLabel}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="admin-hub-tile__foot">{changes.empty}</p>
                )
              }
              <div class="admin-hub-tile__foot">
                {changes.roundText}
                {changes.sendHint ? (
                  <>
                    {' · '}
                    <strong>{changes.sendHint}</strong>
                  </>
                ) : null}
              </div>
            </a>
          ) : null
        }

        <AdminHubColoursTile client:load initialState={liveState} shopName={shopName} />

        <section class="admin-hub-tile admin-hub-tile--quiet admin-hub-bento__activity" data-tile="activity" aria-labelledby="admin-hub-activity-title">
          <div class="admin-hub-tile__head">
            <span class="admin-hub-tile__icon" aria-hidden="true">
              <TrendingUp width={15} height={15} strokeWidth={1.8} />
            </span>
            <h2 class="admin-hub-tile__title" id="admin-hub-activity-title">{ADMIN_HUB_TILE_ACTIVITY}</h2>
            <a class="admin-hub-tile__open" href={hrefs.activity} aria-label="Open activity">
              <ArrowUpRight width={15} height={15} strokeWidth={1.8} aria-hidden="true" />
            </a>
          </div>
          <AdminHubActivityFeed client:load groups={feed} limit={ACTIVITY_TILE_ROWS} />
          {activityHasMore ? (
            <a class="admin-hub-tile__viewall" href={hrefs.activity} data-testid="admin-hub-activity-all">
              {ADMIN_HUB_VIEW_ALL}
              <span class="admin-hub-sr-only"> activity</span>
            </a>
          ) : null}
        </section>
      </div>
    )
  }
  {terminal ? null : <AdminHubOverviewAnnouncer client:load />}
</article>
