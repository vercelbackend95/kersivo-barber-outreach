---
import { PreviewAdminChrome } from './PreviewAdminChrome';
import { AppHost } from './AppHost';
import type { PreviewHubPageData } from '@/lib/adminHub/previewHubPage';
import type { PreviewHubSection } from '@/lib/adminHub/previewHubPaths';
import { ADMIN_HUB_STATE_SCRIPT_ID, liveStateScriptJson } from '@/lib/adminHub/liveState';

interface Props {
  data: PreviewHubPageData;
  section: PreviewHubSection;
}

const { data, section } = Astro.props;
const profileUser = {
  name: data.ctx.request.firstName || data.shopName,
  email: data.ctx.request.email,
  image: null,
};
---

<script is:inline type="application/json" id={ADMIN_HUB_STATE_SCRIPT_ID} set:html={liveStateScriptJson(data.liveState)} />
<PreviewAdminChrome
  client:load
  section={section}
  shopName={data.shopName}
  shopLogoUrl={data.logoSrc}
  profileUser={profileUser}
  setup={data.view.setup}
  underConstruction={data.underConstruction}
  isOperator={data.ctx.isOperator}
  unreadMessages={data.view.unreadMessages}
>
  <slot />
  <AppHost client:load initialApp={data.location.app} ctx={data.appCtx} />
</PreviewAdminChrome>
