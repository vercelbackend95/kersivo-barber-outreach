---
import { TREATWELL_FACTS_CHECKED_DATE,TREATWELL_FACTS_CHECKED_ISO,TREATWELL_SOURCES,TREATWELL_TRADEMARK_DISCLAIMER } from '@/lib/seo/treatwellFacts';
import { TREATWELL_ALTERNATIVE_LAST_UPDATED_ISO,TREATWELL_ALTERNATIVE_LAST_UPDATED_LABEL } from '@/lib/seo/treatwellAlternativeFaq';
---
<section id="sources" class="fresha-alt-sources" aria-labelledby="treatwell-alt-sources-title"><div class="container">
<header class="fresha-alt-sources__header"><h2 id="treatwell-alt-sources-title" class="fresha-alt-sources__title">Sources &amp; comparison notes</h2>
<p class="fresha-alt-sources__meta">Treatwell facts checked <time datetime={TREATWELL_FACTS_CHECKED_ISO}>{TREATWELL_FACTS_CHECKED_DATE}</time><span aria-hidden="true">·</span>Last updated <time datetime={TREATWELL_ALTERNATIVE_LAST_UPDATED_ISO}>{TREATWELL_ALTERNATIVE_LAST_UPDATED_LABEL}</time></p></header>
<p>This independent comparison uses Treatwell's published UK partner pricing and supplier terms. Its published new-customer marketplace commission applies to eligible first marketplace appointments, not repeat or direct bookings. Online prepayment processing is a separate charge. Individual contract terms and VAT treatment may vary. Confirm your current offer before switching.</p>
<ul class="fresha-alt-sources__list">{TREATWELL_SOURCES.map(source=><li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a><span class="fresha-alt-sources__supports">{source.supports}</span></li>)}</ul>
<p class="fresha-alt-sources__trademark">{TREATWELL_TRADEMARK_DISCLAIMER}</p>
</div></section>