---
import { TW_FIT, TW_FIT_CLOSING } from '@/lib/seo/treatwellAlternativeContent';
---

<section id="which-model" class="tw-section tw-fit" aria-labelledby="treatwell-fit-title">
  <div class="tw-wrap">
    <header class="tw-head">
      <p class="tw-eyebrow">An honest fit check</p>
      <h2 id="treatwell-fit-title" class="tw-h2">Which one fits your shop?</h2>
    </header>
    <div class="tw-fit__grid">
      <div class="tw-card tw-fit__col">
        <h3 class="tw-h3">{TW_FIT.treatwell.heading}</h3>
        <ul class="tw-dots">{TW_FIT.treatwell.points.map((point) => <li>{point}</li>)}</ul>
      </div>
      <div class="tw-card tw-fit__col tw-fit__col--ks">
        <h3 class="tw-h3">{TW_FIT.kersivo.heading}</h3>
        <ul class="tw-ticks">{TW_FIT.kersivo.points.map((point) => <li>{point}</li>)}</ul>
        <a class="tw-text-link" href="/pricing#plan" data-track="view_pricing_click" data-track-placement="treatwell_fit">See Full KERSIVO pricing <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <p class="tw-body tw-fit__closing">{TW_FIT_CLOSING} Comparing more than Treatwell? See the <a href="/fresha-alternative">Fresha alternative</a>, <a href="/booksy-alternative">Booksy alternative</a> or <a href="/compare">every comparison</a>.</p>
  </div>
</section>
