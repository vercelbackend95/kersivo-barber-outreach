---
import { RateCard1Offer } from '@/components/rateCard1';
import { KERSIVO_BOOKING_DEPOSIT_GBP, SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import { getRateCard1LandingLayout } from '@/lib/pricing/rateCard1Copy';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import '@/styles/rateCard1.css';

const freePreview = isFreePreviewFlowEnabled();
const layout = getRateCard1LandingLayout(freePreview);
---

<section id="pricing" class="tw-section tw-pricing scroll-mt-24" aria-labelledby="treatwell-pricing-title">
  <div class="tw-wrap">
    <header class="tw-head">
      <p class="tw-eyebrow">Simple pricing</p>
      <h2 id="treatwell-pricing-title" class="tw-h2">One flat price for your own booking site</h2>
      <p class="tw-lead">
        <strong>Full KERSIVO</strong> is £{SAAS_MONTHLY_GBP}/month per physical location: your branded barbershop
        website and your own domain, larger teams, Pay at shop, deposit or full payment, Advanced Clients,
        Reports, Retail pickup, SMS reminders within a monthly allowance and the KERSIVO Assistant, an AI
        helper for running your shop. 0% KERSIVO commission on booking payments and Full retail sales.
      </p>
      <p class="tw-body">
        Just need a booking page? <strong>KERSIVO Starter</strong> is £0/month for up to 4 active bookable
        barbers, with a £{KERSIVO_BOOKING_DEPOSIT_GBP} deposit or Pay in full on every public booking through
        your connected Stripe account. <a href="/starter">See KERSIVO Starter</a>.
      </p>
    </header>

    <div class="rate-card1--landing tw-pricing__offer">
      <RateCard1Offer freePreview={freePreview} />
      <div class="rate-card1__landing-conditions">
        <p>{layout.conditionsLine1}</p>
        <p>{layout.conditionsLine2}</p>
      </div>
    </div>
  </div>
</section>
