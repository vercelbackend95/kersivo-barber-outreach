---
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import { STRIPE_FEES_NOTE } from '@/lib/pricing/claimsPolicy';
import { requireVerifiedTreatwellFact, TREATWELL_FACTS_CHECKED_DATE } from '@/lib/seo/treatwellFacts';
import {
  TW_COSTS_HONEST,
  TW_COSTS_LEAD,
  TW_COSTS_TITLE,
  TW_ESTIMATOR_DEFAULTS,
  TW_ESTIMATOR_LIMITS,
  TW_FEE_LINES,
} from '@/lib/seo/treatwellAlternativeContent';
import { estimateMonthlyCommission, formatGbp } from '@/lib/landing/treatwellMath';

const commission = requireVerifiedTreatwellFact('newMarketplaceClientCommission');
const prepayment = requireVerifiedTreatwellFact('onlinePrepaymentProcessing');
const initial = estimateMonthlyCommission(TW_ESTIMATOR_DEFAULTS);
const scale = Math.max(initial.inclVatGbp, SAAS_MONTHLY_GBP) * 1.08;
---

<section id="treatwell-pricing" class="tw-section tw-costs" aria-labelledby="treatwell-costs-title">
  <div class="tw-wrap">
    <header class="tw-head">
      <p class="tw-eyebrow">The maths</p>
      <h2 id="treatwell-costs-title" class="tw-h2">{TW_COSTS_TITLE}</h2>
      <p class="tw-lead">{TW_COSTS_LEAD}</p>
    </header>

    <div
      class="tw-card tw-estimator"
      data-tw-estimator
      data-kersivo-gbp={SAAS_MONTHLY_GBP}
      style={`--tw-bar-a: ${initial.inclVatGbp / scale}; --tw-bar-b: ${SAAS_MONTHLY_GBP / scale}`}
    >
      <div class="tw-estimator__controls">
        <div class="tw-field">
          <label for="tw-est-clients">New marketplace clients a month</label>
          <output for="tw-est-clients" data-tw-out="clients">{TW_ESTIMATOR_DEFAULTS.newClients}</output>
          <input id="tw-est-clients" class="tw-range" type="range" {...TW_ESTIMATOR_LIMITS.newClients} value={TW_ESTIMATOR_DEFAULTS.newClients} data-tw-est-clients />
        </div>
        <div class="tw-field">
          <label for="tw-est-price">Average first visit</label>
          <output for="tw-est-price" data-tw-out="est-price">£{TW_ESTIMATOR_DEFAULTS.firstVisitGbp}</output>
          <input id="tw-est-price" class="tw-range" type="range" {...TW_ESTIMATOR_LIMITS.firstVisitGbp} value={TW_ESTIMATOR_DEFAULTS.firstVisitGbp} data-tw-est-price />
        </div>
        <p class="tw-small">
          Treatwell’s published rate: {commission.percent}% + VAT on eligible new-client marketplace bookings, with the 365-day rule deciding who counts as new. VAT shown at 20%.
        </p>
      </div>

      <div class="tw-estimator__out" aria-live="polite">
        <div class="tw-bars">
          <div class="tw-bar tw-bar--tw">
            <p class="tw-bar__label">Treatwell new-client commission</p>
            <span class="tw-bar__track" aria-hidden="true"><span class="tw-bar__fill"></span></span>
            <p class="tw-bar__value"><span data-tw-out="incl" data-value={initial.inclVatGbp}>{formatGbp(initial.inclVatGbp)}</span><small> a month incl. VAT</small></p>
          </div>
          <div class="tw-bar tw-bar--ks">
            <p class="tw-bar__label">Full KERSIVO</p>
            <span class="tw-bar__track" aria-hidden="true"><span class="tw-bar__fill"></span></span>
            <p class="tw-bar__value">£{SAAS_MONTHLY_GBP}<small> a month, flat, per location</small></p>
          </div>
        </div>
        <dl class="tw-estimator__stats">
          <div><dt>Commission before VAT</dt><dd data-tw-out="ex" data-value={initial.exVatGbp}>{formatGbp(initial.exVatGbp)}</dd></div>
          <div><dt>Over a year, incl. VAT</dt><dd data-tw-out="year" data-value={initial.yearlyInclVatGbp}>{formatGbp(initial.yearlyInclVatGbp)}</dd></div>
        </dl>
        <p class="tw-body tw-estimator__honest">{TW_COSTS_HONEST}</p>
      </div>
    </div>

    <div class="tw-fees">
      <h3 class="tw-h3 tw-fees__title">Every published fee, line by line</h3>
      <div class="tw-fees__scroll">
        <table class="tw-fees__table">
          <caption class="sr-only">Treatwell and KERSIVO fees compared</caption>
          <thead>
            <tr><th scope="col">Fee</th><th scope="col">Treatwell</th><th scope="col">KERSIVO</th></tr>
          </thead>
          <tbody>
            {TW_FEE_LINES.map((line) => (
              <tr>
                <th scope="row">{line.item}</th>
                <td data-label="Treatwell">{line.treatwell}</td>
                <td data-label="KERSIVO">{line.kersivo}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="tw-small">
        Treatwell rates from its public UK pricing and September 2026 Partner Terms, checked {TREATWELL_FACTS_CHECKED_DATE}; the 365-day rule and your signed agreement decide eligibility. Online prepayment processing is {prepayment.percent}% + VAT, separate from commission. KERSIVO: 0% KERSIVO commission. {STRIPE_FEES_NOTE}
      </p>
    </div>
  </div>
</section>
