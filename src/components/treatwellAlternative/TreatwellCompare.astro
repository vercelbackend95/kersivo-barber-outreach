---
import { TREATWELL_COMPARE_SECTIONS, TREATWELL_COMPARISON_FOOTNOTE } from '@/lib/seo/treatwellFacts';
import { TW_COMPARE_LEAD, TW_COMPARE_TITLE } from '@/lib/seo/treatwellAlternativeContent';
---

<section id="comparison" class="tw-section tw-compare" aria-labelledby="treatwell-alt-compare-title" data-treatwell-comparison>
  <div class="tw-wrap">
    <header class="tw-head">
      <p class="tw-eyebrow">Treatwell vs KERSIVO</p>
      <h2 id="treatwell-alt-compare-title" class="tw-h2">{TW_COMPARE_TITLE}</h2>
      <p class="tw-lead">{TW_COMPARE_LEAD}</p>
    </header>

    <div class="tw-compare__body" data-tw-tabs>
      <div class="tw-compare__tabs" role="tablist" aria-label="Comparison topics">
        {TREATWELL_COMPARE_SECTIONS.map((section, index) => (
          <button
            type="button"
            role="tab"
            id={`tw-compare-tab-${section.id}`}
            class="tw-compare__tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`tw-compare-${section.id}`}
            tabindex={index === 0 ? 0 : -1}
          >
            {section.title}
          </button>
        ))}
      </div>

      {TREATWELL_COMPARE_SECTIONS.map((section) => (
        <div id={`tw-compare-${section.id}`} class="tw-compare__panel" role="tabpanel" aria-labelledby={`tw-compare-tab-${section.id}`} tabindex="0">
          <h3 class="tw-compare__panel-title">{section.title}<span>{section.subtitle}</span></h3>
          <div class="tw-compare__cols">
            <div class="tw-card tw-compare__col">
              <p class="tw-compare__brand">Treatwell</p>
              <p class="tw-compare__lead">{section.treatwellLead}</p>
              <ul class="tw-dots">{section.treatwellPoints.map((point) => <li>{point}</li>)}</ul>
            </div>
            <div class="tw-card tw-compare__col tw-compare__col--ks">
              <p class="tw-compare__brand">KERSIVO</p>
              <p class="tw-compare__lead">{section.kersivoLead}</p>
              <ul class="tw-ticks">{section.kersivoPoints.map((point) => <li>{point}</li>)}</ul>
            </div>
          </div>
        </div>
      ))}
    </div>
    <p class="tw-small tw-compare__foot">{TREATWELL_COMPARISON_FOOTNOTE}</p>
  </div>
</section>
