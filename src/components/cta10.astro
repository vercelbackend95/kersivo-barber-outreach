---
interface CtaButton {
  text: string;
  url?: string;
}

interface Props {
  heading?: string;
  description?: string;
  buttons?: {
    primary?: CtaButton;
    secondary?: CtaButton;
  };
  className?: string;
}

const {
  heading = "SEE HOW THIS SYSTEM COULD RUN YOUR BARBERSHOP",
  description =
    "Book a demo and we’ll show how this setup can reduce day-to-day chaos and improve booking + retail flow for your shop.",  buttons = {
    primary: {
      text: "GET THE SYSTEM",
      url: "#book-demo",
    },
    secondary: {
      text: "WATCH PERFORMANCE",
      url: "/book",
    },
  },
  className = "",
} = Astro.props as Props;
---

<section class={`cta10 ${className}`.trim()} aria-labelledby="cta10-title">
  <div class="container">
    <div class="cta10__panel">
      <div class="cta10__content">
        <h3 id="cta10-title">{heading}</h3>
        <p>{description}</p>
      </div>

      <div class="cta10__actions">
        {
          buttons.secondary && (
            <button type="button" class="btn btn--secondary" data-system-chooser-open>
              {buttons.secondary.text}
            </button>
          )
        }
        {
          buttons.primary && (
            <a href={buttons.primary.url} class="btn btn--primary" data-demo-cta>
              {buttons.primary.text}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
