---
interface CtaButton {
  text: string;
  url?: string;
}

interface Props {
  heading?: string;
  description?: string;
  buttons?: {
    primary?: CtaButton;
    secondary?: CtaButton;
  };
  className?: string;
}

const {
  heading = "YOUR BOOKING. YOUR BRAND. ZERO KERSIVO COMMISSION.",
  description =
    "Whether you are switching from a marketplace profile or starting your first system, we set it up for you in about two weeks. 0% KERSIVO commission on bookings and retail.",
  buttons = {
    primary: {
      text: "PLAN MY SETUP",
      url: "#book-demo",
    },
  },
  className = "",
} = Astro.props as Props;
---

<section class={`cta10 ${className}`.trim()} aria-labelledby="cta10-title">
  <div class="container">
    <div class="cta10__panel">
      <div class="cta10__content">
        <h3 id="cta10-title">{heading}</h3>
        <p>{description}</p>
      </div>

      <div class="cta10__actions">
        {
          buttons.primary && (
            <a href={buttons.primary.url} class="btn btn--primary btn--lg" data-demo-cta>
              {buttons.primary.text}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
