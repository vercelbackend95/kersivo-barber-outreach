---
interface CtaButton {
  text: string;
  url: string;
}

interface Props {
  heading?: string;
  description?: string;
  buttons?: {
    primary?: CtaButton;
    secondary?: CtaButton;
  };
  className?: string;
}

const {
  heading = "Ready to see how this could work for your barbershop?",
  description =
    "Book a demo and we’ll walk you through the website, booking, shop and admin setup that fits your barbershop best.",  buttons = {
    primary: {
      text: "Book a demo",
      url: "#book-demo",
    },
    secondary: {
      text: "See the system",
      url: "/book",
    },
  },
  className = "",
} = Astro.props as Props;
---

<section class={`cta10 ${className}`.trim()} aria-labelledby="cta10-title">
  <div class="container">
    <div class="cta10__panel">
      <div class="cta10__content">
        <h3 id="cta10-title">{heading}</h3>
        <p>{description}</p>
      </div>

      <div class="cta10__actions">
        {
          buttons.secondary && (
            <a href={buttons.secondary.url} class="btn btn--secondary">
              {buttons.secondary.text}
            </a>
          )
        }
        {
          buttons.primary && (
            <a href={buttons.primary.url} class="btn btn--primary">
              {buttons.primary.text}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
