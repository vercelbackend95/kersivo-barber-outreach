---
import { DEMO_HOME_HREF } from '@/lib/demo/nav';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import '@/styles/components/barbershop-website-design-faq-close.css';

const OFFER_HREF = '/barbershop-websites';
const OFFER_TRACK_EVENT = 'primary_cta_clicked';
const OFFER_TRACK_PLACEMENT = 'barbershop_website_design_final_cta';
const DEMO_TRACK_EVENT = 'view_live_demo_click';
const DEMO_TRACK_PLACEMENT = 'barbershop_website_design_final_demo';
const SUBSCRIPTION_TERMS_HREF = '/terms#subscription';
const UPDATE_SUPPORT_TERMS_HREF = '/terms#website-update-support';

type Faq = {
  id: string;
  question: string;
  answer: string[];
  link?: { href: string; label: string };
};

// Design and delivery questions only; cost, payments, ownership, switching and cancellation are answered on the parent page.
const faqs: Faq[] = [
  {
    id: 'demo',
    question: 'Will my website look exactly like the CUTSTATE demo?',
    answer: [
      'No. CUTSTATE is a fictional demonstration shop showing how branding, content and booking can work together. Your standard Full KERSIVO website is adapted to your own shop name, branding, available photographs and business details.',
      'It’s built on the KERSIVO managed platform, using its standard website structure rather than unlimited bespoke development, so it isn’t a copy of CUTSTATE and it isn’t a custom-coded build.',
    ],
  },
  {
    id: 'changes',
    question: 'Can I request changes before launch?',
    answer: [
      'Yes. You’ll receive a private preview to review your branding, information, photographs and booking journey before approving the website for launch.',
      'If a detail, photograph or line of text needs correcting, tell us before you approve. Nothing goes live until you do. Reasonable corrections to the standard website are handled before launch; a full redesign, bespoke pages or new features aren’t part of the standard setup and may need a separate quote.',
    ],
  },
  {
    id: 'domain',
    question: 'Can I keep my existing domain while the website is prepared?',
    answer: [
      'Yes. If you already own a domain, it stays yours and transferring it to KERSIVO isn’t required. We can help with the DNS and SSL configuration.',
      'Where technically possible, your current website can stay live while we prepare the new one, and the domain is only switched over after you approve the preview. You remain responsible for renewing a domain you already own.',
    ],
  },
  {
    id: 'updates',
    question: 'What can I update after my website goes live?',
    answer: [
      'You can manage barbers, services, prices and working hours through your KERSIVO dashboard. Basic shop details (your shop name, town or city and logo) and your retail products can also be updated there.',
      'For reasonable changes to the website’s supplied text, contact information or photographs, KERSIVO provides standard website update support. It isn’t a self-service website builder: new features, a full redesign or bespoke pages aren’t included, and larger changes may need a separate quote.',
    ],
    link: { href: UPDATE_SUPPORT_TERMS_HREF, label: 'Website update support terms' },
  },
  {
    id: 'pages',
    question: 'Will my website include a gallery and a separate services page?',
    answer: [
      'A gallery can be included when you have suitable photographs, but it isn’t required. Your services are presented in the booking flow, so clients can see what you offer and choose an appointment. A separate services page isn’t guaranteed as part of the standard website package.',
    ],
  },
  {
    id: 'timing',
    question: 'How long will it take to get my website live?',
    answer: [
      'Standard setup typically takes around 1–2 weeks after we’ve received all the information we need. Missing details, domain access and migration requirements can make it take longer. This is an estimate, not a guaranteed launch date.',
    ],
  },
];
---

<section class="bwf" aria-labelledby="bwf-heading">
  <div class="bwf__inner">
    <div class="bwf__grid">
      <header class="bwf__intro">
        <p class="bwf__kicker"><span class="bwf__kicker-mark" aria-hidden="true"></span>Questions before you start</p>
        <h2 id="bwf-heading" class="bwf__heading">Questions About Your Website Design</h2>
        <p class="bwf__lede">
          Before you put your shop online, it’s worth knowing what you can change, what stays yours and how the
          finished website is prepared.
        </p>
      </header>

      <div class="bwf__list">
        {faqs.map((faq, index) => (
          <details class="bwf-item" id={`bwf-${faq.id}`}>
            <summary class="bwf-item__summary">
              <span class="bwf-item__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="bwf-item__question">{faq.question}</h3>
              <span class="bwf-item__icon" aria-hidden="true"></span>
            </summary>
            <div class="bwf-item__answer">
              {faq.answer.map((paragraph) => <p>{paragraph}</p>)}
              {faq.link && (
                <p class="bwf-item__more">
                  <a href={faq.link.href}>{faq.link.label}</a>
                </p>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="bwc" aria-labelledby="bwc-heading">
  <div class="bwc__inner">
    <div class="bwc__panel">
      <div class="bwc__message">
        <p class="bwc__kicker">Full KERSIVO</p>
        <h2 id="bwc-heading" class="bwc__heading">
          <span class="bwc__line bwc__line--primary">Your Shop. Your Look.</span>
          <span class="bwc__line">Your Booking Experience.</span>
        </h2>
        <p class="bwc__lede">
          Bring your branding, services and online bookings together on a professionally prepared website with Full
          KERSIVO.
        </p>
      </div>

      <div class="bwc__actions">
        <a
          class="bwc__primary"
          href={OFFER_HREF}
          data-track={OFFER_TRACK_EVENT}
          data-track-placement={OFFER_TRACK_PLACEMENT}
        >
          Get your barbershop website
        </a>
        <a
          class="bwc__secondary"
          href={DEMO_HOME_HREF}
          data-track={DEMO_TRACK_EVENT}
          data-track-placement={DEMO_TRACK_PLACEMENT}
        >
          Explore the CUTSTATE demo<span class="bwc__arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <p class="bwc__note">
        Full KERSIVO: £{SAAS_MONTHLY_GBP}/month per physical location. Standard website setup included. The first
        payment is taken when you subscribe, before your website goes live. CUTSTATE is a fictional demonstration
        shop.
        <a class="bwc__terms" href={SUBSCRIPTION_TERMS_HREF}>Subscription terms</a>
      </p>
    </div>
  </div>
</section>
