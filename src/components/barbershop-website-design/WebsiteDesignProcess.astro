---
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import '@/styles/components/barbershop-website-design-process.css';

const OFFER_HREF = '/barbershop-websites';
const TRACK_EVENT = 'primary_cta_clicked';
const TRACK_PLACEMENT = 'barbershop_website_design_parent_offer';

// A short version of the parent page's setup process; the full onboarding steps and terms stay there.
const stages = [
  {
    owner: 'you',
    role: 'You provide',
    title: 'Your shop, your details',
    body: 'Share your shop details, services, opening hours and branding, along with any photographs and team information you have.',
  },
  {
    owner: 'kersivo',
    role: 'KERSIVO prepares',
    title: 'We prepare your website',
    body: 'KERSIVO prepares your standard branded website, connects online bookings and helps with your domain setup.',
  },
  {
    owner: 'you',
    role: 'You review',
    title: 'Review before launch',
    body: 'Check a private preview, confirm your details and test the booking journey. Your website goes live after your approval and the final technical checks.',
  },
];

const included = [
  { term: 'Website setup', detail: 'Standard branded' },
  { term: 'Domain', detail: 'One standard domain' },
  { term: 'Hosting', detail: 'Hosting and SSL' },
  { term: 'Bookings', detail: 'Connected online' },
];
---

<section class="bwk" aria-labelledby="bwk-heading">
  <div class="bwk__inner">
    <header class="bwk__intro">
      <p class="bwk__kicker"><span class="bwk__kicker-mark" aria-hidden="true"></span>From design to your website</p>
      <h2 id="bwk-heading" class="bwk__heading">How KERSIVO Brings Your Brand Online</h2>
      <p class="bwk__lede">
        Here’s what you provide, what KERSIVO prepares and what you review before launch.
      </p>
    </header>

    <div class="bwk__grid">
      <ol class="bwk-timeline">
        {stages.map((stage, index) => (
          <li class:list={['bwk-timeline__step', `bwk-timeline__step--${stage.owner}`]}>
            <span class="bwk-timeline__node" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div class="bwk-timeline__content">
              <p class="bwk-timeline__role">{stage.role}</p>
              <h3 class="bwk-timeline__title">{stage.title}</h3>
              <p class="bwk-timeline__body">{stage.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <aside class="bwk-card" aria-labelledby="bwk-card-title">
        <p id="bwk-card-title" class="bwk-card__label">Full KERSIVO</p>
        <p class="bwk-card__price">
          <span class="bwk-card__amount">£{SAAS_MONTHLY_GBP}</span>
          <span class="bwk-card__per">per month, per physical location</span>
        </p>
        <dl class="bwk-card__facts">
          {included.map((item) => (
            <div class="bwk-card__fact">
              <dt>{item.term}</dt>
              <dd>{item.detail}</dd>
            </div>
          ))}
          <div class="bwk-card__fact bwk-card__fact--wide">
            <dt>Setup fee</dt>
            <dd>No separate standard setup fee</dd>
          </div>
        </dl>
        <p class="bwk-card__billing">
          Your first payment is taken when you subscribe, including while your website is being
          prepared. Standard Stripe processing fees apply to online card payments.
        </p>
        <a class="bwk-card__link" href={OFFER_HREF} data-track={TRACK_EVENT} data-track-placement={TRACK_PLACEMENT}>
          See what’s included in Full KERSIVO
        </a>
      </aside>
    </div>

    <div class="bwk-managed">
      <p class="bwk-managed__title">A managed subscription, not a one-off build</p>
      <p class="bwk-managed__body">
        Your business keeps its brand, domain and content. KERSIVO provides the software, templates,
        code and hosting, and keeps them running and updated while Full KERSIVO is active. Standard
        websites carry a subtle “Powered by KERSIVO” mark.
      </p>
    </div>
  </div>
</section>
