---
import { getSetupSteps } from '@/content/setupSteps';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import '@/styles/components/barbershop-website-design-process.css';

const stages = getSetupSteps(isFreePreviewFlowEnabled()).map((step) => ({
  owner: step.owner === 'KERSIVO' ? 'kersivo' : 'you',
  role: step.owner === 'KERSIVO' ? 'KERSIVO prepares' : 'You',
  title: step.title,
  body: step.body,
}));
---

<section class="bwk" aria-labelledby="bwk-heading">
  <div class="bwk__inner">
    <header class="bwk__intro">
      <p class="bwk__kicker"><span class="bwk__kicker-mark" aria-hidden="true"></span>From design to your website</p>
        <h2 id="bwk-heading" class="bwk__heading">How KERSIVO brings your brand online</h2>
      <p class="bwk__lede">
        Here’s what you provide, what KERSIVO prepares and what you review before launch.
      </p>
    </header>

    <div class="bwk__grid">
      <ol class="bwk-timeline">
        {stages.map((stage, index) => (
          <li class:list={['bwk-timeline__step', `bwk-timeline__step--${stage.owner}`]}>
            <span class="bwk-timeline__node" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div class="bwk-timeline__content">
              <p class="bwk-timeline__role">{stage.role}</p>
              <h3 class="bwk-timeline__title">{stage.title}</h3>
              <p class="bwk-timeline__body">{stage.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="bwk-managed">
        <p class="bwk-managed__title">A managed subscription, not a one-off build</p>
        <p class="bwk-managed__body">
          Your business keeps its brand, domain and content. KERSIVO provides the software, templates,
          code and hosting, and keeps them running and updated while Full KERSIVO is active. Standard
          websites carry a subtle “Powered by KERSIVO” mark.
        </p>
      </div>
    </div>
  </div>
</section>
