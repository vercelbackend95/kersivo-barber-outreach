---
import ProcessTimeline from '@/components/editorial/ProcessTimeline.astro';
import {
  PHOREST_SWITCHING_LIMITS,
  PHOREST_SWITCHING_REASSURANCE,
  PHOREST_SWITCHING_STEPS,
} from '@/lib/seo/phorestAlternativeContent';
---

<section id="switching" class="fresha-alt__section" aria-labelledby="fresha-alt-switching-title">
  <div class="container">
    <header class="fresha-alt__intro">
      <p class="fresha-alt__eyebrow">MIGRATION</p>
      <h2 id="fresha-alt-switching-title" class="fresha-alt__h2">Switching from Phorest to KERSIVO</h2>
      <p class="fresha-alt-switching__reassurance">{PHOREST_SWITCHING_REASSURANCE}</p>
    </header>

    <ProcessTimeline
      steps={PHOREST_SWITCHING_STEPS}
      noteTitle="Good to know"
      notePoints={PHOREST_SWITCHING_LIMITS}
    >
      <a href="#contact">Ask about your Phorest migration <span aria-hidden="true">→</span></a>
    </ProcessTimeline>
  </div>
</section>
