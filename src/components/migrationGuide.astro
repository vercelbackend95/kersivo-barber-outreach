---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props as Props;
---

<section
  id="migration"
  class={`mg scroll-mt-24 ${className}`.trim()}
  aria-labelledby="mg-headline"
>
  <div class="mg__glow" aria-hidden="true"></div>

  <div class="container">

    <div class="mg__intro">
      <span class="mg__eyebrow">For switchers &middot; Zero-risk</span>
      <h2 id="mg-headline" class="mg__headline">Before.<br />After.</h2>
    </div>

    <div class="mg__story" role="img" aria-label="Migration story: from paying marketplace fees to zero commission">

      <!-- BEFORE panel -->
      <div class="mg__panel mg__panel--before">
        <div class="mg__panel-fig">
          <img
            src="/images/Ilustracje/grupaludziidzie.png"
            alt="Group of people walking — marketplace dependency before switching"
            class="mg__panel-img"
            loading="lazy"
            draggable="false"
          />
        </div>
        <div class="mg__panel-body">
          <span class="mg__panel-tag mg__panel-tag--before">Before</span>
          <p class="mg__panel-stat">Up to<br />30%</p>
          <p class="mg__panel-label">per booking &mdash; to Booksy.</p>
          <p class="mg__panel-line">Your schedule fills up.<br />Their pocket too.</p>
        </div>
      </div>

      <!-- Connector -->
      <div class="mg__connector" aria-hidden="true">
        <div class="mg__connector-line"></div>
        <span class="mg__connector-badge">~14 days</span>
        <div class="mg__connector-arrow">&#8594;</div>
      </div>

      <!-- AFTER panel -->
      <div class="mg__panel mg__panel--after">
        <div class="mg__panel-fig">
          <img
            src="/images/Ilustracje/barberwelcome.png"
            alt="Barber welcoming clients outside his own shop — zero commission after switching"
            class="mg__panel-img"
            loading="lazy"
            draggable="false"
          />
        </div>
        <div class="mg__panel-body">
          <span class="mg__panel-tag mg__panel-tag--after">After</span>
          <p class="mg__panel-stat">0%</p>
          <p class="mg__panel-label">from us. Always.</p>
          <p class="mg__panel-line">Your site. Your clients.<br />Your money.</p>
        </div>
      </div>

    </div>

    <!-- Short guarantee chips -->
    <ul class="mg__chips" role="list" aria-label="Migration guarantees">
      <li class="mg__chip">
        <span class="mg__chip-check" aria-hidden="true">&#10003;</span>
        Stay on Booksy until you&rsquo;re ready
      </li>
      <li class="mg__chip">
        <span class="mg__chip-check" aria-hidden="true">&#10003;</span>
        50&thinsp;% fee held until go-live
      </li>
      <li class="mg__chip">
        <span class="mg__chip-check" aria-hidden="true">&#10003;</span>
        We flip the link &mdash; you don&rsquo;t touch a thing
      </li>
    </ul>

    <!-- CTA -->
    <div class="mg__cta-block">
      <div class="mg__ctas">
        <a href="#contact" class="btn btn--primary btn--lg" data-demo-cta>
          Plan my switch &mdash; free
        </a>
        <button type="button" class="btn btn--secondary btn--lg" data-system-chooser-open>
          Open the live admin
        </button>
      </div>
      <p class="mg__footnote">
        Client data follows UK GDPR &mdash; any contact list imported must reflect your existing lawful basis for processing.
      </p>
    </div>

  </div>
</section>
