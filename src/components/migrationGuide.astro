---
/**
 * ORPHANED — not imported by live src/pages/index.astro.
 * High-risk competitor fee claims removed (Claims Audit 13 Jul 2026).
 * Do not restore “30% per booking” or competitor monthly cost corridors without legal review.
 */
import Compare3Table from './compare3Table.astro';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props as Props;
---

<section
  id="migration"
  class={`mg scroll-mt-24 ${className}`.trim()}
  aria-labelledby="mg-headline"
>
  <span id="switcher-path" class="mg__hash-anchor" aria-hidden="true"></span>
  <div class="mg__glow" aria-hidden="true"></div>

  <div class="container">

    <div class="mg__intro">
      <span class="mg__eyebrow">For switchers</span>
      <h2 id="mg-headline" class="mg__headline">Before.<br />After.</h2>
      <p class="mg__lead">
        Keep your current booking system live while we set up client booking on your domain, one admin for the floor,
        buy-and-collect retail, and the day&rsquo;s numbers in one panel.
      </p>
    </div>

    <div class="mg__story" role="img" aria-label="Migration story: from marketplace profile to your own branded booking site">

      <!-- BEFORE panel -->
      <div class="mg__panel mg__panel--before">
        <div class="mg__panel-fig">
          <img
            src="/images/Ilustracje/grupaludziidzie.webp"
            alt="Group of people walking — marketplace booking profile before switching"
            class="mg__panel-img"
            loading="lazy"
            draggable="false"
          />
        </div>
        <div class="mg__panel-body">
          <span class="mg__panel-tag mg__panel-tag--before">Before</span>
          <p class="mg__panel-stat">Marketplace<br />profile</p>
          <p class="mg__panel-label">Bookings sit inside someone else&rsquo;s network.</p>
          <p class="mg__panel-line">Your schedule fills up.<br />Their brand stays in the way.</p>
        </div>
      </div>

      <!-- Connector -->
      <div class="mg__connector" aria-hidden="true">
        <div class="mg__connector-line"></div>
        <span class="mg__connector-badge">~14 days</span>
        <div class="mg__connector-arrow">&#8594;</div>
      </div>

      <!-- AFTER panel -->
      <div class="mg__panel mg__panel--after">
        <div class="mg__panel-fig">
          <img
            src="/images/Ilustracje/barberwelcome.webp"
            alt="Barber welcoming clients outside his own shop — branded booking on his domain"
            class="mg__panel-img"
            loading="lazy"
            draggable="false"
          />
        </div>
        <div class="mg__panel-body">
          <span class="mg__panel-tag mg__panel-tag--after">After</span>
          <p class="mg__panel-stat">0%</p>
          <p class="mg__panel-label">KERSIVO commission. Always.</p>
          <p class="mg__panel-line">Your domain. Your clients.<br />Your brand.</p>
        </div>
      </div>

    </div>

    <!-- Short guarantee chips -->
    <ul class="mg__chips" role="list" aria-label="Migration reassurances">
      <li class="mg__chip">
        <span class="mg__chip-check" aria-hidden="true">&#10003;</span>
        Stay on your current system until you&rsquo;re ready
      </li>
      <li class="mg__chip">
        <span class="mg__chip-check" aria-hidden="true">&#10003;</span>
        50&thinsp;% setup deposit; remaining on go-live
      </li>
      <li class="mg__chip">
        <span class="mg__chip-check" aria-hidden="true">&#10003;</span>
        We help move your public booking link when ready
      </li>
    </ul>

    <!-- CTA -->
    <div class="mg__cta-block">
      <div class="mg__ctas">
        <a href="#contact" class="btn btn--primary btn--lg" data-demo-cta>
          Plan my switch
        </a>
        <button
          type="button"
          class="btn btn--secondary btn--lg"
          data-comparison-toggle
          aria-expanded="false"
          aria-controls="mg-comparison-panel"
          data-comparison-label-show="See full comparison"
          data-comparison-label-hide="Hide comparison"
        >
          See full comparison
        </button>
      </div>

      <div
        id="mg-comparison-panel"
        class="mg__comparison"
        hidden
        aria-labelledby="mg-comparison-title"
      >
        <div class="mg__comparison-header">
          <span class="compare3-block__badge">FOR SWITCHERS &middot; TWO MODELS</span>
          <h3 id="mg-comparison-title">Kersivo vs marketplace apps</h3>
          <p>
            Marketplace apps are proven at scale. Kersivo is built for owners who want <strong>0% KERSIVO commission</strong>,
            a booking site on their own domain, and retail plus admin in one stack. Here is how the two postures differ.
          </p>
        </div>

        <Compare3Table />

        <p class="compare3-block__anchor">
          Choose breadth inside a marketplace, or margin and brand control on your own URL &mdash; both are valid; Kersivo is for the latter.
        </p>
      </div>

      <p class="mg__footnote">
        Client data follows UK GDPR &mdash; any contact list imported must reflect your existing lawful basis for processing.
      </p>
    </div>

  </div>
</section>
