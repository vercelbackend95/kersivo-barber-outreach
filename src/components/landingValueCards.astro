---
interface ValueBlock {
  heading: string;
  body: string;
  image: string;
  imageWidth: number;
  imageHeight: number;
  imageAlt: string;
}

interface Props {
  className?: string;
}

const { className = '' } = Astro.props as Props;

function valueCardResponsiveSrc(image: string): string {
  const match = image.match(/\/([^/]+)\.webp$/);
  if (!match) return image;
  const base = match[1];
  const dir = image.replace(/\/[^/]+$/, '');
  return `${dir}/${base}-480w.webp`;
}

function valueCardSrcset(image: string): string {
  const match = image.match(/\/([^/]+)\.webp$/);
  if (!match) return image;
  const base = match[1];
  const dir = image.replace(/\/[^/]+$/, '');
  return [
    `${dir}/${base}-320w.webp 320w`,
    `${dir}/${base}-480w.webp 480w`,
    `${dir}/${base}-768w.webp 768w`,
    `${dir}/${base}-1024w.webp 1024w`,
    `${image} 1536w`,
  ].join(', ');
}

const blocks: ValueBlock[] = [
  {
    heading: 'Easy booking for clients',
    body: 'Service, barber, time \u2014 clients book on your domain in a few taps. No app-store detour. No marketplace maze.',
    image: '/images/Ilustracje/8.webp',
    imageWidth: 1536,
    imageHeight: 1024,
    imageAlt: 'Client in the barber chair on their phone \u2014 easy booking in a few taps',
  },
  {
    heading: 'Your shop online',
    body: 'Your domain, your brand, your booking flow. Clients book and reserve retail products through your barbershop\u2019s own branded website.',
    image: '/images/Ilustracje/shoppyonline.webp',
    imageWidth: 1536,
    imageHeight: 1024,
    imageAlt: 'Barber in the chair on his laptop \u2014 running his shop online from the chair',
  },
  {
    heading: 'Reminders + no-show protection',
    body: 'Unlimited automated SMS reminders and deposit options help protect your schedule and reduce awkward chase-ups.',
    image: '/images/Ilustracje/reminder.webp',
    imageWidth: 928,
    imageHeight: 1152,
    imageAlt: 'Person walking with phone \u2014 SMS appointment reminder pops up',
  },
];

const includedItems = [
  'Booking website',
  'Admin dashboard',
  'Retail pickup shop',
  'Unlimited automated SMS reminders',
  'Deposits',
  '0% KERSIVO commission',
];
---

<section
  class={`landing-value-cards ${className}`.trim()}
  aria-labelledby="landing-value-cards-title"
>
  <div class="container">
    <header class="landing-value-cards__intro">
      <p class="landing-value-cards__eyebrow">WHAT KERSIVO INCLUDES</p>
      <h2 id="landing-value-cards-title" class="landing-value-cards__heading">
        Everything your barbershop needs &mdash; day one.
      </h2>
      <p class="landing-value-cards__lead">
        A branded booking website, retail pickup shop and admin system under your own brand.
      </p>
    </header>

    <ul class="landing-value-cards__blocks" role="list">
      {blocks.map((block, index) => (
        <li
          class:list={[
            'landing-value-cards__row',
            { 'landing-value-cards__row--reverse': index % 2 === 1 },
          ]}
        >
          <div class="landing-value-cards__visual">
            <img
              class="landing-value-cards__image"
              src={valueCardResponsiveSrc(block.image)}
              srcset={valueCardSrcset(block.image)}
              sizes="(max-width: 640px) min(90vw, 280px), (max-width: 1024px) 45vw, 403px"
              alt={block.imageAlt}
              width={block.imageWidth}
              height={block.imageHeight}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>

          <div class="landing-value-cards__content">
            <h3 class="landing-value-cards__block-title">{block.heading}</h3>
            <p class="landing-value-cards__block-body">{block.body}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="landing-value-cards__included">
      <p class="landing-value-cards__included-label">Included from day one:</p>
      <ul class="landing-value-cards__included-items" role="list">
        {includedItems.map((item) => (
          <li class="landing-value-cards__included-chip">{item}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
