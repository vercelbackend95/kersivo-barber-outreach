---
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';

interface ValueBlock {
  heading: string;
  body: string;
  image: string;
  imageWidth: number;
  imageHeight: number;
  imageAlt: string;
  guideHref?: string;
  guideText?: string;
}

interface Props {
  className?: string;
}

const { className = '' } = Astro.props as Props;

function valueCardResponsiveSrc(image: string): string {
  const match = image.match(/\/([^/]+)\.webp$/);
  if (!match) return image;
  const base = match[1];
  const dir = image.replace(/\/[^/]+$/, '');
  return `${dir}/${base}-480w.webp`;
}

function valueCardSrcset(image: string, imageWidth: number): string {
  const match = image.match(/\/([^/]+)\.webp$/);
  if (!match) return image;
  const base = match[1];
  const dir = image.replace(/\/[^/]+$/, '');
  const widths = [320, 480, 768, 1024] as const;
  const entries = widths
    .filter((width) => width < imageWidth)
    .map((width) => `${dir}/${base}-${width}w.webp ${width}w`);
  entries.push(`${image} ${imageWidth}w`);
  return entries.join(', ');
}

const blocks: ValueBlock[] = [
  {
    heading: 'Online booking for barbers, without the marketplace detour',
    body: 'Let clients choose a service, barber and available time through a booking journey that puts your shop first. Full KERSIVO brings that journey onto your own website and domain.',
    guideHref: '/barbershop-online-booking',
    guideText: 'How online booking works for barbershops',
    image: '/images/Ilustracje/8.webp',
    imageWidth: 1536,
    imageHeight: 1024,
    imageAlt: 'Client in the barber chair on their phone \u2014 easy booking in a few taps',
  },
  {
    heading: 'Manage your barbershop from one clear\u00a0system',
    body: 'Manage appointments, clients, barbers, services, working hours and daily activity from one clear admin dashboard.',
    image: '/images/Ilustracje/shoppyonline.webp',
    imageWidth: 1536,
    imageHeight: 1024,
    imageAlt: 'Barber in the chair on his laptop \u2014 running his shop online from the chair',
  },
  {
    heading: 'Payments and reminders that protect your time',
    body: 'Full KERSIVO lets you choose Pay at shop, require a £5 deposit or take full payment upfront. SMS reminders help reduce missed appointments. Starter offers payment-powered bookings with email reminders.',
    image: '/images/Ilustracje/reminder.webp',
    imageWidth: 928,
    imageHeight: 1152,
    imageAlt: 'Person walking with phone \u2014 SMS appointment reminder pops up',
  },
];

const includedItems = [
  `Full KERSIVO — £${SAAS_MONTHLY_GBP}/month per location`,
  'Your own branded website',
  'One standard domain included',
  'Online bookings and payment control',
  'Clients and Reports',
  'Retail pickup',
  '0% KERSIVO commission',
];
---

<section
  class={`landing-value-cards ${className}`.trim()}
  aria-labelledby="landing-value-cards-title"
>
  <div class="container">
    <header class="landing-value-cards__intro">
      <p class="landing-value-cards__eyebrow">WHAT KERSIVO INCLUDES</p>
      <h2 id="landing-value-cards-title" class="landing-value-cards__heading">
        Barbershop software for bookings, clients and daily management
      </h2>
      <p class="landing-value-cards__lead">
        Full KERSIVO combines <a href="/barbershop-websites">your own branded barbershop website</a>,
        online bookings, client management, Reports and Retail in one connected platform.
        KERSIVO Starter remains available for shops that want a free entry plan.
      </p>
    </header>

    <ul class="landing-value-cards__blocks" role="list">
      {blocks.map((block, index) => (
        <li
          class:list={[
            'landing-value-cards__row',
            { 'landing-value-cards__row--reverse': index % 2 === 1 },
          ]}
        >
          <div class="landing-value-cards__visual">
            <img
              class="landing-value-cards__image"
              src={valueCardResponsiveSrc(block.image)}
              srcset={valueCardSrcset(block.image, block.imageWidth)}
              sizes="(max-width: 640px) min(90vw, 280px), (max-width: 1024px) 45vw, 403px"
              alt={block.imageAlt}
              width={block.imageWidth}
              height={block.imageHeight}
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="landing-value-cards__content">
            <h3 class="landing-value-cards__block-title">{block.heading}</h3>
            <p class="landing-value-cards__block-body">{block.body}</p>
            {block.guideHref && block.guideText ? (
              <a class="landing-value-cards__guide" href={block.guideHref}>{block.guideText}</a>
            ) : null}
          </div>
        </li>
      ))}
    </ul>

    <div class="landing-value-cards__included">
      <p class="landing-value-cards__included-label">FULL KERSIVO — ONE CONNECTED PLATFORM</p>
      <ul class="landing-value-cards__included-items" role="list">
        {includedItems.map((item) => (
          <li class="landing-value-cards__included-chip">{item}</li>
        ))}
      </ul>
      <p class="landing-value-cards__included-note">
        Stripe processing fees apply to online payments.
      </p>
    </div>
  </div>
</section>
