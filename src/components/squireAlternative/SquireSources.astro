---
import {
 SQUIRE_FACTS_CHECKED_DATE,
 SQUIRE_FACTS_CHECKED_ISO,
 SQUIRE_OFFICIAL_SOURCES,
} from '@/lib/seo/squireFacts';
import {
 SQUIRE_ALTERNATIVE_LAST_UPDATED_ISO,
 SQUIRE_ALTERNATIVE_LAST_UPDATED_LABEL,
} from '@/lib/seo/squireAlternativeFaq';
---
<section id="sources" class="fresha-alt-sources" aria-labelledby="squire-alt-sources-title">
 <div class="container">
  <header class="fresha-alt-sources__header">
   <h2 id="squire-alt-sources-title" class="fresha-alt-sources__title">Sources &amp; comparison notes</h2>
   <p class="fresha-alt-sources__meta">SQUIRE facts checked <time datetime={SQUIRE_FACTS_CHECKED_ISO}>{SQUIRE_FACTS_CHECKED_DATE}</time>
    <span aria-hidden="true">·</span>
    Last updated <time datetime={SQUIRE_ALTERNATIVE_LAST_UPDATED_ISO}>{SQUIRE_ALTERNATIVE_LAST_UPDATED_LABEL}</time>
   </p>
  </header>
  <p>SQUIRE operates in the UK, as shown by its live UK listings and the Squire Europe Limited entity named in its public documentation. Its publicly available subscription plan prices cited here are in USD and must not be treated as a verified UK GBP quotation. The feature set and additional fees may depend on plan and location. Please check with SQUIRE before choosing a provider.</p>
  <ul class="fresha-alt-sources__list">
   {SQUIRE_OFFICIAL_SOURCES.map(source=><li>
    <a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a>
    <span class="fresha-alt-sources__supports">{source.supports}</span>
   </li>)}
  </ul>
  <p class="fresha-alt-sources__trademark">SQUIRE is a trademark of its respective owner. KERSIVO is an independent platform and is not affiliated with, endorsed by or sponsored by SQUIRE.</p>
 </div>
</section>
