---
import ModelComparison from '@/components/editorial/ModelComparison.astro';
import ProcessTimeline from '@/components/editorial/ProcessTimeline.astro';
import type { ModelComparisonItem } from '@/lib/editorial/insightIcons';

const models:readonly [ModelComparisonItem,ModelComparisonItem]=[
 {label:'SQUIRE',descriptor:'Booking plus in-shop operations',icon:'network',
  summary:[{label:'Best fit',value:'POS and staff payment operations'},{label:'UK list price',value:'From £20/month; check VAT'}],
  heading:'SQUIRE may suit your shop if…',
  points:['You need an in-shop register and more extensive POS tools','You want automated barber payouts or chair-rent collection','Your shop needs advanced marketing or multi-location management','You are willing to confirm plan-level features and UK fees directly']},
 {label:'KERSIVO',descriptor:'Direct bookings and own-brand website',icon:'direct',
  summary:[{label:'Best fit',value:'Branded digital client journey'},{label:'UK pricing',value:'£0 Starter / £39 Full'}],
  heading:'KERSIVO may suit your shop if…',
  points:['You want a branded website and booking flow on your own domain with Full','You value a clear £39/month Full price per physical UK location','A £0/month hosted booking page for up to four barbers is useful','You do not need a fully integrated physical POS or automatic rent collection']},
];

const steps=[
 {title:'Keep SQUIRE taking bookings',body:'Use your existing appointment diary while assessing the new booking flow. Do not interrupt your customers before launch.'},
 {title:'Find out what SQUIRE exports',body:'Confirm with SQUIRE which client, appointment and service data can be exported and in what formats.'},
 {title:'Review your migration scope',body:'KERSIVO can help review and import compatible business data, including supported CSV exports where available.'},
 {title:'Prepare the KERSIVO setup',body:'Configure barbers, services, opening hours and payments; add the branded website and standard domain if you choose Full.'},
 {title:'Check your private preview',body:'Review the complete customer booking flow and your admin setup before making a public change.'},
 {title:'Update your booking links when approved',body:'Direct new bookings to KERSIVO once the new setup is ready and you approve the change.'},
];
---
<section id="which-model" class="fresha-alt__section" aria-labelledby="squire-alt-fit-title">
 <div class="container"><header class="fresha-alt__intro">
   <p class="fresha-alt__eyebrow">TWO MODELS</p>
   <h2 id="squire-alt-fit-title" class="fresha-alt__h2">SQUIRE or KERSIVO: which fits your barbershop?</h2>
 </header>
 <ModelComparison idPrefix="squire-alt-fit" models={models} conclusion="SQUIRE has strengths in physical POS and workforce payments. KERSIVO focuses on an independent barber's direct booking journey and an own-domain website on Full. Compare against the operations you actually use.">
   Also considering <a href="/booksy-alternative">Booksy alternatives</a> or <a href="/fresha-alternative">Fresha alternatives</a>? Compare the platforms before switching.
 </ModelComparison>
 </div>
</section>
<section id="switching" class="fresha-alt__section" aria-labelledby="squire-alt-switch-title">
 <div class="container">
   <header class="fresha-alt__intro">
     <p class="fresha-alt__eyebrow">MIGRATION</p>
     <h2 id="squire-alt-switch-title" class="fresha-alt__h2">Switching from SQUIRE to KERSIVO</h2>
     <p class="fresha-alt-switching__reassurance">Keep SQUIRE live while your new booking setup is prepared.</p>
   </header>
   <ProcessTimeline steps={steps} noteTitle="Before switching" notePoints={['Confirm what data SQUIRE permits you to export. No migration completeness is guaranteed.','Saved card details, reviews and future appointments should not be assumed portable.','Avoid simultaneous booking links that might create double-bookings; agree on a clear cutover.']}>
     <a href="#contact">Ask about switching from SQUIRE <span aria-hidden="true">→</span></a>
   </ProcessTimeline>
 </div>
</section>
