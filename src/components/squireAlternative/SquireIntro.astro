---
import EditorialIntro from '@/components/editorial/EditorialIntro.astro';
import InsightCards from '@/components/editorial/InsightCards.astro';
import { SQUIRE_FACTS_CHECKED_DATE, SQUIRE_OFFICIAL_SOURCES, SQUIRE_US_LIST_PLANS } from '@/lib/seo/squireFacts';

const themes=[
  {icon:'storefront' as const,title:'Your website and booking identity',body:'SQUIRE offers branded booking experiences and additional website options on eligible plans. Full KERSIVO includes an own-domain barbershop website at £39/month per location, with bookings under your brand.'},
  {icon:'seats' as const,title:'What your barbershop really needs',body:'SQUIRE offers an integrated physical POS, staff payouts and rent collection workflows. KERSIVO is more focused: appointments, barbers, client records, payment choices and retail pickup on Full.'},
  {icon:'stack' as const,title:'The real price for UK shops',body:'SQUIRE publishes US-dollar subscription prices. We could not independently verify a current GBP quote for UK shops, nor their VAT, payment-processing or optional platform charges.'},
  {icon:'discovery' as const,title:'How customers reach your booking page',body:'SQUIRE offers hosted shop listings and Google and Instagram bookings on Pro. KERSIVO supports direct links to a hosted Starter page or a branded website and own domain on Full. Neither approach guarantees new customers.'},
];
const ukSource = SQUIRE_OFFICIAL_SOURCES.find(source=>source.id==='ukShop')!;
const pricingSource = SQUIRE_OFFICIAL_SOURCES.find(source=>source.id==='pricing')!;
---
<EditorialIntro
 id="quick-answer" titleId="squire-alt-quick-title" class="fresha-alt-quick"
 kicker="THE SHORT VERSION" title="A SQUIRE alternative centred on your own brand."
 lead="KERSIVO is an alternative to SQUIRE for independent UK barbershops that want simple, direct online bookings and stronger control over their brand. Starter is £0/month for up to four active bookable barbers, with a hosted booking page and at least £5 online payment per public booking. Full is £39/month per location, with a branded website and standard domain. Both have 0% KERSIVO commission; Stripe processing fees still apply."
 detail="SQUIRE also operates in the UK and offers a broader POS and barbershop management platform. Its first-party public pricing page currently shows US-dollar prices. Confirm UK subscription pricing, VAT and local payment charges directly with SQUIRE. Choosing between them depends on the features your shop actually uses."
 facts={[{label:'KERSIVO Starter',value:'£0/month · up to 4 barbers'},{label:'Full KERSIVO',value:'£39/month per location'},{label:'KERSIVO commission',value:'0% · Stripe fees apply'},{label:'SQUIRE UK subscription',value:'Request a GBP quote'}]}
/>

<section id="why-switch" class="fresha-alt__section" aria-labelledby="squire-alt-why-title">
 <div class="container"><header class="fresha-alt__intro">
  <p class="fresha-alt__eyebrow">WHY BARBERS COMPARE</p>
  <h2 id="squire-alt-why-title" class="fresha-alt__h2">Why UK barbers look for a SQUIRE alternative</h2>
  <p class="fresha-alt__lead">SQUIRE can be a good fit for operations-heavy shops. Other barbers want a simpler booking and own-brand website model, without paying for features they do not need.</p>
 </header><InsightCards items={themes} /></div>
</section>

<section id="squire-pricing" class="fresha-alt__section" aria-labelledby="squire-alt-costs-title">
 <div class="container">
  <header class="fresha-alt__intro">
    <p class="fresha-alt__eyebrow">SQUIRE PRICING EXPLAINED</p>
    <h2 id="squire-alt-costs-title" class="fresha-alt__h2">SQUIRE pricing and fees for UK barbershops</h2>
    <p class="fresha-alt__lead">SQUIRE's publicly accessible pricing lists plans in US dollars. These are not confirmed UK prices; request a current GBP quote covering your plan, VAT, UK payment fees and extras.</p>
    <p class="fresha-alt-costs__checked">Facts checked {SQUIRE_FACTS_CHECKED_DATE} · <a href={pricingSource.url} target="_blank" rel="noopener noreferrer">Official SQUIRE pricing</a></p>
  </header>
  <ul class="fresha-alt-costs__grid">
   {SQUIRE_US_LIST_PLANS.map(plan=>(
    <li class="fresha-alt-card fresha-alt-costs__item">
      <p class="fresha-alt-costs__kicker">{plan.label}</p>
      <p class="fresha-alt-costs__figure">${plan.usdMonthly}</p>
      <p class="fresha-alt-costs__unit">USD/month · {plan.audience} · not a UK quote</p>
      <ul class="fresha-alt-costs__notes">{plan.notes.map(note=><li>{note}</li>)}</ul>
    </li>
   ))}
  </ul>
  <div class="fresha-alt-costs__examples">
   <div class="fresha-alt-costs__table-wrap">
     <h3 class="fresha-alt-costs__h3">Does SQUIRE work in the UK?</h3>
     <p>Yes. SQUIRE has <a href={ukSource.url} target="_blank" rel="noopener noreferrer">public barbershop listings in London</a>, and its own company documentation identifies a UK service entity. Our accessible first-party pricing view lists USD prices; a current UK GBP subscription, VAT, payment processing and optional charges need confirmation.</p>
     <p>For a full UK cost comparison, request the GBP subscription and whether it includes VAT, plus any landing page/AI add-ons, shop- or client-paid fees, card processing and cancellation terms.</p>
     <p class="fresha-alt-costs__calculator">Comparing more booking tools? See our <a href="/barber-software-cost-calculator">UK Barber Software Cost Calculator</a> for verified UK costs and clear limitations.</p>
   </div>
   <aside class="fresha-alt-card fresha-alt-costs__kersivo" aria-labelledby="squire-alt-costs-kersivo-title">
     <p class="fresha-alt-costs__kicker">KERSIVO</p>
     <h3 id="squire-alt-costs-kersivo-title" class="fresha-alt-costs__h3">The KERSIVO model</h3>
     <ul class="fresha-alt-list">
       <li>Starter: £0/month for up to 4 active bookable barbers</li>
       <li>Starter public bookings: online £5 deposit or Pay in full</li>
       <li>Full: £39/month per physical UK location</li>
       <li>Full: branded website, standard domain, payment controls and retail pickup</li>
       <li>0% KERSIVO commission on booking payments</li>
       <li>Stripe payment-processing fees are separate</li>
     </ul>
   </aside>
  </div>
 </div>
</section>
