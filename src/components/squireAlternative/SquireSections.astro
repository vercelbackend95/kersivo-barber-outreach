---
import EditorialIntro from '@/components/editorial/EditorialIntro.astro';
import InsightCards from '@/components/editorial/InsightCards.astro';
import ModelComparison from '@/components/editorial/ModelComparison.astro';
import ProcessTimeline from '@/components/editorial/ProcessTimeline.astro';
import FreshaProof from '@/components/freshaAlternative/FreshaProof.astro';
import FreshaPricing from '@/components/freshaAlternative/FreshaPricing.astro';
import {
  SQUIRE_FACTS_CHECKED_DATE,
  SQUIRE_OFFICIAL_SOURCES,
  SQUIRE_ALTERNATIVE_LAST_UPDATED_ISO,
  SQUIRE_ALTERNATIVE_LAST_UPDATED_LABEL,
} from '@/lib/seo/squireAlternativeFaq';

const themes = [
  { icon: 'storefront' as const, title: 'Your website and booking identity', body: 'SQUIRE supports branded booking options and apps on selected plans. Full KERSIVO includes a branded barbershop website and one standard domain in its £39 monthly plan.' },
  { icon: 'seats' as const, title: 'The right tools for your team', body: 'SQUIRE provides advanced POS, staff payouts and chair-rent workflows. KERSIVO focuses on bookings, barbers, clients and a simpler independent-shop operating model.' },
  { icon: 'stack' as const, title: 'Understand the real monthly cost', body: 'Compare local subscription pricing, payment-processing fees and optional add-ons — not just a single headline price. SQUIRE publicly shows US-dollar plan prices; UK rates require direct confirmation.' },
  { icon: 'discovery' as const, title: 'How clients find and book you', body: 'SQUIRE supports discovery and Google or Instagram booking. KERSIVO is centred on your existing brand and channels, with a KERSIVO-hosted booking page on Starter and your domain on Full.' },
];

const paths = [
  { label:'SQUIRE', descriptor:'Broad barbershop operations', icon:'network' as const,
    summary:[{label:'Focus',value:'Booking, POS and barber operations'},{label:'Pricing',value:'Public USD plans; verify UK offer'}],
    heading:'SQUIRE may suit your shop if…',
    points:['You need in-person POS and payment hardware workflows','You want barber payout or chair-rent collection tools','You operate multiple locations or need SQUIRE’s wider business suite','You are comfortable confirming UK plan availability and terms directly'] },
  { label:'KERSIVO', descriptor:'Direct booking and brand', icon:'direct' as const,
    summary:[{label:'Focus',value:'Booking and branded website on Full'},{label:'Pricing',value:'£0 Starter or £39/month Full'}],
    heading:'KERSIVO may suit your shop if…',
    points:['You want to keep your digital client experience under your own barbershop identity','You value a flat £39/month Full subscription per UK shop location','You want a £0/month Starter option for up to four active bookable barbers','You do not need a complete shop POS or automatic chair-rent collection system'] },
] as const;

const steps = [
  {title:'Keep your existing SQUIRE booking link live',body:'Avoid interrupting appointments while you evaluate your next platform.'},
  {title:'Check which SQUIRE data is exportable',body:'Ask SQUIRE which client and appointment data can be exported in a usable format; do not assume every field can transfer.'},
  {title:'Review compatible data with KERSIVO',body:'We can help review usable business information, including supported CSV exports.'},
  {title:'Prepare your new KERSIVO setup',body:'Set up the team, services, availability and booking flow, plus your own website and domain on Full.'},
  {title:'Approve your preview',body:'Review the booking experience and details before changing public links.'},
  {title:'Switch your booking links when ready',body:'Your shop controls when to direct new bookings to KERSIVO.'},
];
const comparisons = [
  {title:'Bookings and availability',squire:'SQUIRE offers booking, scheduling, automated reminders and no-show tools.',kersivo:'Starter includes unlimited bookings, up to four bookable barbers and email reminders. Full adds larger-team support and SMS reminders under its allowance.'},
  {title:'Payments and deposits',squire:'SQUIRE markets online and in-person card payments with integrated POS capabilities.',kersivo:'Starter public bookings require a £5 deposit or full payment; Full offers editable Pay at shop, £5 deposit or full-payment requirements. Stripe processing fees apply.'},
  {title:'Website and branding',squire:'SQUIRE advertises branded booking pages and higher-tier branded app options; some website features may be add-ons.',kersivo:'Full includes a branded barbershop website on a standard domain. Starter is a KERSIVO-hosted booking page.'},
  {title:'Retail and POS',squire:'SQUIRE provides more extensive POS, staff payment and retail-management tools on qualifying plans.',kersivo:'Full includes an online retail pickup shop. KERSIVO is not a like-for-like replacement for SQUIRE’s in-shop POS or automated barber payouts.'},
  {title:'Clients and reminders',squire:'SQUIRE supports client records, reminders and retention tools.',kersivo:'Starter includes Clients Core and email reminders; Full unlocks deeper client records and SMS appointment reminders.'},
  {title:'Reports and team operations',squire:'SQUIRE markets reporting, management and commission or rent collection on higher plans.',kersivo:'Full offers booking and retail reports. KERSIVO does not claim the same commission or booth-rent automation.'},
];
---
<EditorialIntro id="quick-answer" titleId="squire-quick-title" class="fresha-alt-quick" kicker="THE SHORT VERSION"
  title="A SQUIRE alternative for independent UK barbershops."
  lead="KERSIVO is a SQUIRE alternative for UK barbershops looking for direct bookings and greater control over their own brand. Starter is £0/month for up to four active bookable barbers, with a hosted booking page and compulsory online payment of at least £5 for customer-created bookings. Full KERSIVO is £39/month per location and includes your own branded website and standard domain."
  detail="SQUIRE offers a wider POS and barbershop management platform. Its publicly displayed plans are priced in US dollars; UK availability and GBP rates have not been independently verified. The right fit depends on whether your shop needs a comprehensive POS or an own-brand digital booking experience."
  facts={[{label:'KERSIVO Starter',value:'£0/month · up to 4 barbers'},{label:'Full KERSIVO',value:'£39/month per location'},{label:'KERSIVO commission',value:'0% · Stripe fees apply'},{label:'SQUIRE UK prices',value:'Verify with SQUIRE'}]}
/>
<section id="why-switch" class="fresha-alt__section" aria-labelledby="squire-why-title">
  <div class="container"><header class="fresha-alt__intro"><p class="fresha-alt__eyebrow">WHY BARBERS COMPARE</p><h2 id="squire-why-title" class="fresha-alt__h2">Why UK barbers look for a SQUIRE alternative</h2><p class="fresha-alt__lead">Both platforms serve barbers. The meaningful difference is the type of business infrastructure you actually need.</p></header><InsightCards items={themes} /></div>
</section>
<section id="squire-pricing" class="fresha-alt__section" aria-labelledby="squire-costs-title">
 <div class="container"><header class="fresha-alt__intro"><p class="fresha-alt__eyebrow">SQUIRE PRICING EXPLAINED</p><h2 id="squire-costs-title" class="fresha-alt__h2">SQUIRE pricing and fees: what UK barbers should check</h2><p class="fresha-alt__lead">SQUIRE’s official pricing page currently displays US-dollar prices. These are <strong>not verified UK prices</strong>. Ask SQUIRE for a UK quotation, local payment fees and exact included functionality before comparing total costs.</p><p class="fresha-alt-costs__checked">Official pricing checked {SQUIRE_FACTS_CHECKED_DATE} · <a href={SQUIRE_OFFICIAL_SOURCES[0].url} target="_blank" rel="noopener noreferrer">SQUIRE pricing</a></p></header>
 <ul class="fresha-alt-costs__grid">
  <li class="fresha-alt-card fresha-alt-costs__item"><p class="fresha-alt-costs__kicker">INDEPENDENT</p><p class="fresha-alt-costs__figure">$30</p><p class="fresha-alt-costs__unit">USD/month · individual barbers</p><ul class="fresha-alt-costs__notes"><li>Published US pricing, not a UK quote</li><li>Online booking, reminders and no-show protection</li></ul></li>
  <li class="fresha-alt-card fresha-alt-costs__item"><p class="fresha-alt-costs__kicker">PRO</p><p class="fresha-alt-costs__figure">$50</p><p class="fresha-alt-costs__unit">USD/month · single-location shops</p><ul class="fresha-alt-costs__notes"><li>Published US pricing, not a UK quote</li><li>Multiple barber accounts, Google and Instagram booking</li></ul></li>
  <li class="fresha-alt-card fresha-alt-costs__item"><p class="fresha-alt-costs__kicker">EXECUTIVE</p><p class="fresha-alt-costs__figure">$150</p><p class="fresha-alt-costs__unit">USD/month per shop</p><ul class="fresha-alt-costs__notes"><li>Published US pricing, not a UK quote</li><li>Enhanced marketing, commission and rent tools; add-ons may cost extra</li></ul></li>
  <li class="fresha-alt-card fresha-alt-costs__item"><p class="fresha-alt-costs__kicker">TITAN</p><p class="fresha-alt-costs__figure">$250</p><p class="fresha-alt-costs__unit">USD/month per shop</p><ul class="fresha-alt-costs__notes"><li>Published US pricing, not a UK quote</li><li>Multi-location features and advanced management</li></ul></li>
 </ul>
 <div class="fresha-alt-costs__examples"><div class="fresha-alt-costs__table-wrap"><h3 class="fresha-alt-costs__h3">Compare your actual quote, not just currency symbols</h3><p>USD list pricing does not establish GBP subscription rates, tax treatment, UK product availability or UK card-processing fees. Confirm these directly with SQUIRE.</p><p class="fresha-alt-costs__calculator">For verified UK pricing information on other booking platforms, explore our <a href="/barber-software-cost-calculator">Barber Software Cost Calculator</a>.</p></div><aside class="fresha-alt-card fresha-alt-costs__kersivo"><p class="fresha-alt-costs__kicker">KERSIVO</p><h3 class="fresha-alt-costs__h3">The KERSIVO model</h3><ul class="fresha-alt-list"><li>Starter: £0/month, up to 4 bookable barbers</li><li>Full: £39/month per UK shop location</li><li>0% KERSIVO booking commission</li><li>Full branded website and standard domain included</li><li>Standard Stripe processing fees apply</li></ul></aside></div>
 </div>
</section>
<section id="comparison" class="fresha-alt-compare scroll-mt-24" aria-labelledby="squire-compare-title"><div class="container"><header class="fresha-alt__intro"><p class="fresha-alt__eyebrow">FEATURE COMPARISON</p><h2 id="squire-compare-title" class="fresha-alt__h2">KERSIVO vs SQUIRE: feature-by-feature</h2><p class="fresha-alt__lead">Compare functionality without pretending the two systems have identical scopes.</p></header>
 <div class="fresha-alt-compare__accordion" data-squire-comparison>
 {comparisons.map((item,index)=><article class="fresha-alt-compare__item" data-comparison-item data-open={index===0?'true':'false'}>
  <button type="button" id={`squire-trigger-${index}`} class="fresha-alt-compare__summary" aria-controls={`squire-panel-${index}`} aria-expanded={index===0?'true':'false'} data-comparison-trigger><span class="fresha-alt-compare__summary-copy"><span class="fresha-alt-compare__summary-kicker">{String(index+1).padStart(2,'0')} / 06</span><strong>{item.title}</strong><span>Compare SQUIRE and KERSIVO</span></span><span aria-hidden="true">⌄</span></button>
  <div class="fresha-alt-compare__reveal" data-comparison-reveal aria-hidden={index===0?'false':'true'}><div id={`squire-panel-${index}`} class="fresha-alt-compare__reveal-inner" role="region" aria-labelledby={`squire-trigger-${index}`} data-comparison-reveal-inner inert={index!==0}><div class="fresha-alt-compare__panel">
   <article class="fresha-alt-compare__provider fresha-alt-compare__provider--fresha"><div class="fresha-alt-compare__provider-label">SQUIRE</div><h3 class="fresha-alt-compare__provider-name">SQUIRE</h3><p class="fresha-alt-compare__provider-lead">{item.squire}</p></article><div class="fresha-alt-compare__vs" aria-hidden="true">VS</div><article class="fresha-alt-compare__provider fresha-alt-compare__provider--kersivo"><div class="fresha-alt-compare__provider-label fresha-alt-compare__provider-label--kersivo">KERSIVO</div><h3 class="fresha-alt-compare__provider-name">KERSIVO</h3><p class="fresha-alt-compare__provider-lead">{item.kersivo}</p></article>
  </div></div></div></article>)}
 </div><p class="fresha-alt-compare__footnote">SQUIRE information is based on public materials checked {SQUIRE_FACTS_CHECKED_DATE}. <a href="#sources">See official sources and limitations</a>.</p>
 </div></section>
<FreshaProof />
<section id="which-model" class="fresha-alt__section" aria-labelledby="squire-fit-title"><div class="container"><header class="fresha-alt__intro"><p class="fresha-alt__eyebrow">TWO MODELS</p><h2 id="squire-fit-title" class="fresha-alt__h2">Which model fits your barbershop?</h2></header><ModelComparison idPrefix="squire-alt-fit" models={paths} conclusion="SQUIRE is a strong consideration for advanced POS and team payment operations. KERSIVO fits shops prioritising direct booking, branded presence and a clear UK plan price.">
 <p>Also comparing <a href="/fresha-alternative">Fresha</a> or <a href="/booksy-alternative">Booksy</a>? See our other barbershop comparisons.</p>
</ModelComparison></div></section>
<section id="switching" class="fresha-alt__section" aria-labelledby="squire-switch-title"><div class="container"><header class="fresha-alt__intro"><p class="fresha-alt__eyebrow">MIGRATION</p><h2 id="squire-switch-title" class="fresha-alt__h2">Switching from SQUIRE to KERSIVO</h2><p class="fresha-alt-switching__reassurance">Keep SQUIRE live while your new booking setup is prepared.</p></header><ProcessTimeline steps={steps} noteTitle="Before migrating" notePoints={['Verify SQUIRE export availability and supported formats directly.','KERSIVO can only help migrate compatible, lawfully provided data.','Do not assume reviews, saved payment details or every future booking can transfer.']}><a href="#contact">Ask about switching from SQUIRE →</a></ProcessTimeline></div></section>
<FreshaPricing />
<section id="sources" class="fresha-alt-sources" aria-labelledby="squire-sources-title"><div class="container"><header class="fresha-alt-sources__header"><h2 id="squire-sources-title" class="fresha-alt-sources__title">Sources &amp; comparison notes</h2><p class="fresha-alt-sources__meta">SQUIRE facts checked <time datetime="2026-10-08">{SQUIRE_FACTS_CHECKED_DATE}</time> · Last updated <time datetime={SQUIRE_ALTERNATIVE_LAST_UPDATED_ISO}>{SQUIRE_ALTERNATIVE_LAST_UPDATED_LABEL}</time></p></header><p>SQUIRE plan prices above are the public US-dollar figures, not a verified UK price list. Prices, eligibility and features can change. Obtain a direct quote for UK use before making a purchasing decision.</p><ul class="fresha-alt-sources__list">{SQUIRE_OFFICIAL_SOURCES.map(source=><li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a><span class="fresha-alt-sources__supports">{source.supports}</span></li>)}</ul><p class="fresha-alt-sources__trademark">SQUIRE is a trademark of its respective owner. KERSIVO is not affiliated with, endorsed by or sponsored by SQUIRE.</p></div></section>
<script>
 import { bindComparisonAccordions } from '@/lib/landing/comparisonAccordion';
 const bind = () => bindComparisonAccordions('[data-squire-comparison]');
 if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind, {once:true});
 else bind();
 document.addEventListener('astro:page-load',bind);
</script>
