---
import HeroDashboardShowcase from '@/components/marketing/HeroDashboardShowcase.astro';
import { KERSIVO_BOOKING_DEPOSIT_GBP, SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import '@/styles/components/homepage-hero.css';
---

<section id="hero" class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__content">
    <p class="home-hero__eyebrow">
      <span class="home-hero__eyebrow-dot" aria-hidden="true"></span>
      Barbershop software for independent UK shops
    </p>

    <h1 id="home-hero-title" class="home-hero__title">
      <span class="home-hero__title-line home-hero__title-line--primary">Your own barbershop</span><br />
      <span class="home-hero__title-line">website and booking system.</span><br />
      <span class="home-hero__title-line">Not a marketplace listing.</span>
    </h1>

    <p class="home-hero__lead">
      Full KERSIVO gives your shop a branded website on its own domain, online booking,
      client records and retail pickup — set up for you, for £{SAAS_MONTHLY_GBP} a month
      per location, not per barber.
    </p>

    <div class="home-hero__actions">
      <a
        href="/admin/launch"
        class="home-hero__action home-hero__action--primary"
        data-track="saas_subscribe_click"
        data-track-placement="homepage_hero"
      >
        Start Full KERSIVO — £{SAAS_MONTHLY_GBP}/month
      </a>
      <a href="#live-demo" class="home-hero__action home-hero__action--secondary" data-track="view_live_demo_click" data-track-placement="homepage_hero">
        See it working
      </a>
    </div>

    <div class="home-hero__meta" aria-label="KERSIVO commercial model">
      <span>No setup fee</span>
      <span aria-hidden="true">·</span>
      <span>No VAT added</span>
      <span aria-hidden="true">·</span>
      <span>0% KERSIVO commission (Stripe fees apply)</span>
      <span aria-hidden="true">·</span>
      <span>Cancel anytime</span>
    </div>

    <p class="home-hero__honesty">
      Your first payment is taken when you subscribe. Your site is typically ready in a few days
      once we receive all required information, and nothing goes live until you approve it.
    </p>

    <p class="home-hero__starter-path">
      Just need online bookings? KERSIVO Starter is £0/month for up to 4 barbers, with every
      online booking secured by a £{KERSIVO_BOOKING_DEPOSIT_GBP} deposit or full payment through
      Stripe. <a href="/starter" data-track="starter_plan_explore_click" data-track-placement="homepage_hero">Explore KERSIVO Starter</a>
    </p>
  </div>

  <HeroDashboardShowcase />
</section>
