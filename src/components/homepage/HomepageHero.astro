---
import HeroDashboardShowcase from '@/components/marketing/HeroDashboardShowcase.astro';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import '@/styles/components/homepage-hero.css';
---

<section id="hero" class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__content">
    <p class="home-hero__eyebrow">
      <span class="home-hero__eyebrow-dot" aria-hidden="true"></span>
      Built for independent UK barbershops
    </p>

    <h1 id="home-hero-title" class="home-hero__title">
      <span class="home-hero__title-line home-hero__title-line--primary">Barbershop software</span><br />
      <span class="home-hero__title-line">built around your</span><br />
      <span class="home-hero__title-line">brand.</span>
    </h1>

    <p class="home-hero__lead">
      A barber booking system with your own branded website, domain, client management and retail.
      Built for independent UK barbershops that want more control over their customer experience.
    </p>

    <div class="home-hero__actions">
      <a
        href="/admin/launch"
        class="home-hero__action home-hero__action--primary"
        data-track="saas_subscribe_click"
        data-track-placement="homepage_hero"
      >
        Start Full KERSIVO — £{SAAS_MONTHLY_GBP}/month
      </a>
      <a href="#live-demo" class="home-hero__action home-hero__action--secondary" data-track="view_live_demo_click" data-track-placement="homepage_hero">
        See KERSIVO in action
      </a>
    </div>

    <p class="home-hero__starter-path">
      Looking for a free option?
      <a href="/starter" data-track="starter_plan_explore_click" data-track-placement="homepage_hero">Explore KERSIVO Starter</a>.
    </p>

    <div class="home-hero__meta" aria-label="KERSIVO commercial model">
      <span><strong>One physical location per plan</strong></span>
      <span aria-hidden="true">·</span>
      <span>Your own domain included</span>
      <span aria-hidden="true">·</span>
      <span>0% KERSIVO commission</span>
    </div>
  </div>

  <HeroDashboardShowcase prioritizeMobileStill={false} />
</section>
