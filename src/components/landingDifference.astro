---
import '../styles/components/landingDifference.css';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props as Props;

/**
 * Homepage differentiation adopts the same editorial header + feature-card
 * composition as the /starter page's starter-shell feature section.
 * Icons reuse the already-shipped Starter icon assets.
 */
const pillars = [
  {
    icon: 'browser',
    title: 'Your website. Your identity.',
    body: 'Give your services, barbers, bookings and retail one branded home on your own domain — instead of relying on a marketplace profile.',
  },
  {
    icon: 'calendar-time',
    title: 'Bookings that lead to your shop.',
    body: 'Clients choose a service, barber and time through a direct booking experience, without competing shops appearing alongside yours.',
  },
  {
    icon: 'users-four',
    title: 'More control behind the chair.',
    body: 'Manage bookings, clients, your team, payment options and retail pickup through one connected Full KERSIVO system.',
  },
] as const;
---

<section
  id="why-kersivo-is-different"
  class={`landing-difference ${className}`.trim()}
  aria-labelledby="landing-difference-title"
>
  <div class="starter-shell landing-difference__shell">
    <header class="landing-difference__header">
      <p class="landing-difference__eyebrow">BUILT FOR INDEPENDENT BARBERSHOPS</p>
      <h2 id="landing-difference-title">
        Your barbershop should be the destination. Not the marketplace.
      </h2>
      <p class="landing-difference__lead">
        Clients should find your shop, book your barbers and remember your name.
        Full KERSIVO brings your website and booking experience together on your own domain.
      </p>
    </header>

    <div class="landing-difference__grid">
      {pillars.map((pillar) => (
        <article class="landing-difference__card">
          <span
            class="landing-difference__card-icon"
            aria-hidden="true"
            style={`--icon: url('/images/svg/${pillar.icon}.svg')`}
          ></span>
          <h3>{pillar.title}</h3>
          <p>{pillar.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
