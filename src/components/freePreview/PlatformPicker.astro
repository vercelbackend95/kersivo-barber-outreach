---
import { Check, Ellipsis, Globe, MapPin } from 'lucide-react';
import { FREE_PREVIEW_PAGE } from '@/lib/seo/freePreviewPage';
import {
  WORK_LINK_VALUE_MAX,
  WORK_PICKER_COPY,
  WORK_PLATFORMS,
  type WorkPlatformMark,
} from '@/lib/freePreview/workPlatforms';

const marks: Record<Exclude<WorkPlatformMark, null>, typeof Globe> = {
  globe: Globe,
  ellipsis: Ellipsis,
  mappin: MapPin,
};
---

<fieldset class="fp-group" data-platform-picker aria-describedby="fp-links-hint">
  <legend class="fp-group__legend">
    <span class="fp-group__label">{FREE_PREVIEW_PAGE.formGroupLinks}</span>
    <span class="fp-group__hint" id="fp-links-hint">{FREE_PREVIEW_PAGE.formLinksHint}</span>
  </legend>

  <div class="fp-smart">
    <label class="free-preview-form__label" for="fp-smart-paste">{WORK_PICKER_COPY.smartLabel}</label>
    <input
      id="fp-smart-paste"
      class="fp-smart__input"
      type="text"
      inputmode="url"
      autocomplete="url"
      maxlength={WORK_LINK_VALUE_MAX}
      placeholder={WORK_PICKER_COPY.smartPlaceholder}
      data-smart-paste
      aria-describedby="fp-smart-status"
    />
    <p class="fp-smart__status" id="fp-smart-status" data-smart-status role="status" aria-live="polite"></p>
  </div>

  <div class="fp-platforms" role="group" aria-label={FREE_PREVIEW_PAGE.formGroupLinks}>
    {
      WORK_PLATFORMS.map((platform) => {
        const Mark = platform.mark ? marks[platform.mark] : null;
        return (
          <button
            type="button"
            class="fp-platform"
            data-platform={platform.id}
            aria-pressed="false"
            aria-label={platform.name}
          >
            <span class="fp-platform__badge" aria-hidden="true">
              <Check size={10} strokeWidth={2.6} />
            </span>
            <span class="fp-platform__mark" aria-hidden="true" data-has-mark={Mark ? 'true' : 'false'}>
              {Mark ? <Mark size={22} strokeWidth={1.8} /> : null}
            </span>
            <span class="fp-platform__name">{platform.name}</span>
          </button>
        );
      })
    }
  </div>
  <p class="fp-platform-count is-empty" data-platform-count aria-live="polite"></p>
  <div class="fp-platform-inputs" data-platform-inputs></div>
  <p class="fp-platform-undo" data-platform-undo hidden>
    <span data-undo-message></span>
    <button type="button" class="fp-platform-undo__btn" data-undo>Undo</button>
  </p>
  <p class="sr-only" data-platform-live aria-live="polite"></p>
</fieldset>
