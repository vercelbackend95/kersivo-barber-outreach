---
import { Ellipsis, Globe } from 'lucide-react';
import { FREE_PREVIEW_PAGE } from '@/lib/seo/freePreviewPage';
import { WORK_PLATFORMS, type WorkPlatformMark } from '@/lib/freePreview/workPlatforms';

const marks: Record<Exclude<WorkPlatformMark, null>, typeof Globe> = {
  globe: Globe,
  ellipsis: Ellipsis,
};
---

<fieldset class="fp-group" data-platform-picker aria-describedby="fp-links-hint">
  <legend class="fp-group__legend">
    <span class="fp-group__label">{FREE_PREVIEW_PAGE.formGroupLinks}</span>
    <span class="fp-group__hint" id="fp-links-hint">{FREE_PREVIEW_PAGE.formLinksHint}</span>
  </legend>
  <div class="fp-platforms" role="group" aria-label={FREE_PREVIEW_PAGE.formGroupLinks}>
    {
      WORK_PLATFORMS.map((platform) => {
        const Mark = platform.mark ? marks[platform.mark] : null;
        return (
          <button
            type="button"
            class="fp-platform"
            data-platform={platform.id}
            aria-pressed="false"
            aria-label={platform.name}
          >
            {
              Mark ? (
                <span class="fp-platform__mark" aria-hidden="true">
                  <Mark size={20} strokeWidth={1.8} />
                </span>
              ) : null
            }
            <span class="fp-platform__name">{platform.name}</span>
          </button>
        );
      })
    }
  </div>
  <div class="fp-platform-inputs" data-platform-inputs></div>
</fieldset>
