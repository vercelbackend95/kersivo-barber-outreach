---
import { Check } from 'lucide-react';
import PlatformPicker from '@/components/freePreview/PlatformPicker.astro';
import {
  FREE_PREVIEW_AUTHORISATION_LABEL,
  FREE_PREVIEW_BARBER_COUNTS,
  FREE_PREVIEW_BOOKING_SYSTEMS,
  FREE_PREVIEW_DOMAIN_OPTIONS,
  FREE_PREVIEW_MARKETING_LABEL,
  FREE_PREVIEW_NOTES_MAX,
} from '@/lib/freePreview/intake';
import { PREVIEW_OVER_CAP_MESSAGE } from '@/lib/freePreview/config';
import { FREE_PREVIEW_PAGE } from '@/lib/seo/freePreviewPage';
import '@/styles/components/ks-glass-card.css';
---

<div class="fp-card ks-glass-card ks-glass-card--accent" data-free-preview>
  <form class="free-preview-form" data-free-preview-form novalidate>
    <header class="fp-card__header">
      <p class="fp-card__eyebrow">{FREE_PREVIEW_PAGE.formEyebrow}</p>
      <h2 id="free-preview-form-title" class="fp-card__title">{FREE_PREVIEW_PAGE.formHeading}</h2>
      <p class="fp-card__ready">{FREE_PREVIEW_PAGE.formReadyLine}</p>
    </header>

    <div class="hp-field" aria-hidden="true">
      <label>
        Company website
        <input type="text" name="companyWebsite" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="fp-fields fp-fields--two">
      <label class="free-preview-form__field">
        <span class="free-preview-form__label">Barbershop name</span>
        <input
          name="shopName"
          type="text"
          autocomplete="organization"
          required
          maxlength="120"
          placeholder="e.g. Northside Barbers"
          aria-describedby="fp-error-shopName"
        />
        <span class="free-preview-form__error" id="fp-error-shopName" data-error-for="shopName"></span>
      </label>
      <label class="free-preview-form__field">
        <span class="free-preview-form__label">Town or city</span>
        <input
          name="townCity"
          type="text"
          autocomplete="address-level2"
          required
          maxlength="120"
          placeholder="e.g. Leeds"
          aria-describedby="fp-error-townCity"
        />
        <span class="free-preview-form__error" id="fp-error-townCity" data-error-for="townCity"></span>
      </label>
    </div>

    <PlatformPicker />
    <span class="free-preview-form__error" id="fp-error-links" data-error-for="links"></span>

    <div class="fp-fields fp-fields--three">
      <label class="free-preview-form__field">
        <span class="free-preview-form__label">Number of barbers</span>
        <select name="barberCount" required aria-describedby="fp-error-barberCount">
          <option value="" selected disabled>Choose</option>
          {FREE_PREVIEW_BARBER_COUNTS.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
        <span class="free-preview-form__error" id="fp-error-barberCount" data-error-for="barberCount"></span>
      </label>
      <label class="free-preview-form__field">
        <span class="free-preview-form__label">Current booking system</span>
        <select name="currentBookingSystem" required aria-describedby="fp-error-currentBookingSystem">
          <option value="" selected disabled>Choose</option>
          {FREE_PREVIEW_BOOKING_SYSTEMS.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
        <span class="free-preview-form__error" id="fp-error-currentBookingSystem" data-error-for="currentBookingSystem"></span>
      </label>
      <label class="free-preview-form__field">
        <span class="free-preview-form__label">Own domain?</span>
        <select name="hasOwnDomain" required aria-describedby="fp-error-hasOwnDomain">
          <option value="" selected disabled>Choose</option>
          {FREE_PREVIEW_DOMAIN_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
        <span class="free-preview-form__error" id="fp-error-hasOwnDomain" data-error-for="hasOwnDomain"></span>
      </label>
    </div>

    <div class="fp-fields fp-fields--two">
      <label class="free-preview-form__field">
        <span class="free-preview-form__label">First name (optional)</span>
        <input name="firstName" type="text" autocomplete="given-name" maxlength="80" placeholder="e.g. Alex" />
      </label>
      <label class="free-preview-form__field">
        <span class="free-preview-form__label">Email address</span>
        <input
          name="email"
          type="email"
          autocomplete="email"
          required
          maxlength="254"
          placeholder="alex@yourshop.co.uk"
          aria-describedby="fp-error-email"
        />
        <span class="free-preview-form__error" id="fp-error-email" data-error-for="email"></span>
      </label>
    </div>

    <div class="fp-note">
      <button
        type="button"
        class="fp-note__toggle"
        data-fp-note-toggle
        aria-expanded="false"
        aria-controls="fp-note-field"
      >
        {FREE_PREVIEW_PAGE.addNoteLabel}
      </button>
      <label class="free-preview-form__field" id="fp-note-field" data-fp-note-field hidden>
        <span class="free-preview-form__label">Anything else we should know? (optional)</span>
        <textarea
          name="notes"
          maxlength={FREE_PREVIEW_NOTES_MAX}
          rows="3"
          data-fp-autogrow
          placeholder="e.g. photos, a logo, or anything you'd like us to include"
          aria-describedby="fp-error-notes"
        ></textarea>
        <span class="free-preview-form__error" id="fp-error-notes" data-error-for="notes"></span>
      </label>
    </div>

    <div class="fp-checks">
      <label class="free-preview-form__check">
        <input type="checkbox" name="authorisationConsent" required aria-describedby="fp-error-authorisationConsent" />
        <span>{FREE_PREVIEW_AUTHORISATION_LABEL}</span>
      </label>
      <span class="free-preview-form__error" id="fp-error-authorisationConsent" data-error-for="authorisationConsent"></span>

      <label class="free-preview-form__check">
        <input type="checkbox" name="marketingOptIn" />
        <span>{FREE_PREVIEW_MARKETING_LABEL}</span>
      </label>
    </div>

    <p class="free-preview-form__status" data-free-preview-status role="status" aria-live="polite"></p>

    <div class="fp-submit">
      <button
        type="submit"
        class="btn btn--primary btn--lg free-preview-form__submit"
        data-free-preview-submit
      >
        <span class="btn-spinner" data-fp-spinner hidden aria-hidden="true"></span>
        <span data-fp-submit-label>{FREE_PREVIEW_PAGE.submitLabel}</span>
      </button>
      <p class="free-preview-form__note">
        {FREE_PREVIEW_PAGE.submitNote} <a href="/privacy">{FREE_PREVIEW_PAGE.privacyLabel}</a>
      </p>
    </div>
  </form>

  <div class="free-preview-confirmation" data-free-preview-confirmation hidden tabindex="-1">
    <span class="free-preview-confirmation__icon" aria-hidden="true">
      <Check size={24} strokeWidth={2.2} />
    </span>
    <h2 class="free-preview-confirmation__title">{FREE_PREVIEW_PAGE.confirmationHeading}</h2>
    <p class="free-preview-confirmation__text" data-free-preview-confirmation-text data-template={FREE_PREVIEW_PAGE.confirmationText} data-over-cap-text={PREVIEW_OVER_CAP_MESSAGE}></p>
    <p class="free-preview-confirmation__next-label">{FREE_PREVIEW_PAGE.confirmationNextHeading}</p>
    <ol class="free-preview-confirmation__next">
      {FREE_PREVIEW_PAGE.confirmationNext.map((step) => <li>{step}</li>)}
    </ol>
    <a class="free-preview-confirmation__link" href="/demo">{FREE_PREVIEW_PAGE.demoLinkLabel}</a>
  </div>
</div>

<script>
  import { FUNNEL_EVENTS } from '@/lib/analytics/funnelEvents';
  import { trackConsentedEvent } from '@/lib/consent/events';
  import { collectWorkLinks, initPlatformPicker } from '@/lib/freePreview/initPlatformPicker';

  const ENTRY_POINT_PATTERN = /^[a-z0-9-]{1,40}$/;

  function initFreePreviewForm(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>('[data-free-preview-form]');
    const status = root.querySelector<HTMLElement>('[data-free-preview-status]');
    const submit = root.querySelector<HTMLButtonElement>('[data-free-preview-submit]');
    const spinner = root.querySelector<HTMLElement>('[data-fp-spinner]');
    const confirmation = root.querySelector<HTMLElement>('[data-free-preview-confirmation]');
    const confirmationText = root.querySelector<HTMLElement>('[data-free-preview-confirmation-text]');
    if (!form || !status || !submit || !confirmation || !confirmationText) return;
    if (root.dataset.fpReady === 'true') return;
    root.dataset.fpReady = 'true';
    initPlatformPicker(root);

    const autogrow = root.querySelector<HTMLTextAreaElement>('[data-fp-autogrow]');
    const grow = () => {
      if (!autogrow) return;
      autogrow.style.height = 'auto';
      autogrow.style.height = `${autogrow.scrollHeight}px`;
    };
    autogrow?.addEventListener('input', grow);

    // The textarea stays in the form while collapsed, so it still submits when empty.
    const noteToggle = root.querySelector<HTMLButtonElement>('[data-fp-note-toggle]');
    const noteField = root.querySelector<HTMLElement>('[data-fp-note-field]');
    const revealNote = () => {
      if (!noteToggle || !noteField) return;
      noteField.hidden = false;
      noteToggle.hidden = true;
      noteToggle.setAttribute('aria-expanded', 'true');
      grow();
    };
    noteToggle?.addEventListener('click', () => {
      revealNote();
      autogrow?.focus();
    });
    if (autogrow?.value) revealNote();

    const clearErrors = () => {
      root.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
        el.textContent = '';
      });
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    };

    const showErrors = (fieldErrors: Record<string, string>) => {
      let first: HTMLElement | null = null;
      for (const [name, message] of Object.entries(fieldErrors)) {
        if (name === 'notes') revealNote();
        const target = root.querySelector<HTMLElement>('[data-error-for="' + name + '"]');
        if (target) target.textContent = message;
        const input =
          name === 'links'
            ? form.querySelector<HTMLElement>('button.fp-platform')
            : form.querySelector<HTMLElement>(`[name="${name}"]`);
        if (input) {
          input.setAttribute('aria-invalid', 'true');
          first ??= input;
        }
      }
      first?.focus();
    };

    const fillConfirmation = (shopName: string, email: string, overDailyCap: boolean) => {
      const template = confirmationText.dataset.template ?? '';
      confirmationText.textContent = overDailyCap
        ? (confirmationText.dataset.overCapText ?? '')
        : template.replace('{shopName}', shopName).replace('{email}', email);
    };

    const setBusy = (busy: boolean) => {
      submit.disabled = busy;
      submit.setAttribute('aria-busy', busy ? 'true' : 'false');
      form.setAttribute('aria-busy', busy ? 'true' : 'false');
      if (spinner) spinner.hidden = !busy;
    };

    form.addEventListener(
      'focusin',
      () => trackConsentedEvent(FUNNEL_EVENTS.preview_form_start),
      { once: true },
    );

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      status.textContent = '';

      const fd = new FormData(form);
      const text = (name: string) => String(fd.get(name) ?? '').trim();
      const fromParam = new URLSearchParams(window.location.search).get('from')?.trim().toLowerCase() ?? '';
      const payload = {
        companyWebsite: text('companyWebsite'),
        firstName: text('firstName'),
        email: text('email'),
        shopName: text('shopName'),
        townCity: text('townCity'),
        workLinks: collectWorkLinks(root),
        barberCount: text('barberCount'),
        currentBookingSystem: text('currentBookingSystem'),
        hasOwnDomain: text('hasOwnDomain'),
        notes: text('notes'),
        authorisationConsent: fd.get('authorisationConsent') === 'on',
        marketingOptIn: fd.get('marketingOptIn') === 'on',
        ...(ENTRY_POINT_PATTERN.test(fromParam) ? { entryPoint: fromParam } : {}),
      };

      setBusy(true);
      try {
        const response = await fetch('/api/free-preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = (await response.json().catch(() => ({}))) as {
          ok?: boolean;
          overDailyCap?: boolean;
          error?: string;
          fieldErrors?: Record<string, string>;
        };
        if (response.ok && data.ok) {
          trackConsentedEvent(FUNNEL_EVENTS.preview_request_submitted);
          fillConfirmation(payload.shopName, payload.email, Boolean(data.overDailyCap));
          // Hold the card's height so nothing below it jumps when the form is swapped out.
          root.style.minHeight = `${root.offsetHeight}px`;
          form.hidden = true;
          confirmation.hidden = false;
          confirmation.focus();
          return;
        }
        if (data.fieldErrors) showErrors(data.fieldErrors);
        status.textContent =
          response.status === 429
            ? 'Too many requests. Please try again a little later.'
            : data.error || 'Something went wrong. Please try again.';
      } catch {
        status.textContent = 'We could not send your request. Check your connection and try again.';
      } finally {
        setBusy(false);
      }
    });
  }

  const initFreePreviewForms = () =>
    document.querySelectorAll<HTMLElement>('[data-free-preview]').forEach(initFreePreviewForm);

  initFreePreviewForms();
  document.addEventListener('astro:page-load', initFreePreviewForms);
</script>
