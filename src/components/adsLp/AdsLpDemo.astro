---
const PHONE_FRAME_WIDTH = 543;
const PHONE_FRAME_HEIGHT = 1106;
const MOCK_SCREEN_WIDTH = 1179;
const MOCK_SCREEN_HEIGHT = 2556;
const ADMIN_PREVIEW_WIDTH = 4766;
const ADMIN_PREVIEW_HEIGHT = 1290;

const clientHighlights = [
  'Your shop branding',
  'Service, barber and time selection',
  'Online booking deposits',
] as const;

const adminHighlights = [
  'Bookings and client management',
  'Barbers, services and working hours',
  'Reports and retail pickup orders',
] as const;
---

<section
  id="demo"
  class="ads-lp-section ads-lp-demo"
  aria-labelledby="ads-lp-demo-heading"
>
  <div class="container">
    <header class="ads-lp-demo__intro">
      <p class="ads-lp-demo__kicker">Explore the system</p>
      <h2 id="ads-lp-demo-heading" class="ads-lp-demo__heading">
        See both sides of KERSIVO before you subscribe
      </h2>
      <p class="ads-lp-demo__lead">
        Preview the booking experience your clients see and the system your barbershop uses to manage
        bookings, clients, services and retail.
      </p>
    </header>

    <div class="ads-lp-demo__modules">
      <article class="ads-lp-demo__module ads-lp-demo__module--client">
        <div class="ads-lp-demo__visual ads-lp-demo__visual--phone">
          <div class="ads-lp-demo__mock">
            <div class="ads-lp-demo__mock-screen-wrap">
              <img
                class="ads-lp-demo__mock-screen"
                src="/images/hero/iphonemockup.webp"
                alt="Client booking flow preview on a phone screen"
                width={MOCK_SCREEN_WIDTH}
                height={MOCK_SCREEN_HEIGHT}
                loading="lazy"
                decoding="async"
              />
            </div>
            <img
              class="ads-lp-demo__mock-frame"
              src="/images/hero/phone-5.webp"
              alt=""
              width={PHONE_FRAME_WIDTH}
              height={PHONE_FRAME_HEIGHT}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div class="ads-lp-demo__copy">
          <p class="ads-lp-demo__eyebrow">For your clients</p>
          <h3 class="ads-lp-demo__title">Branded online booking</h3>
          <p class="ads-lp-demo__desc">
            See how clients choose a service, barber and available time through a booking experience
            built around your barbershop.
          </p>
          <ul class="ads-lp-demo__highlights">
            {clientHighlights.map((item) => <li>{item}</li>)}
          </ul>
          <a
            class="btn btn--primary btn--lg ads-lp-demo__cta"
            href="/book"
            target="_blank"
            rel="noopener"
            data-track="ads_lp_client_demo_click"
          >
            Open client booking demo
          </a>
        </div>
      </article>

      <article class="ads-lp-demo__module ads-lp-demo__module--admin">
        <div class="ads-lp-demo__visual ads-lp-demo__visual--dashboard">
          <div class="ads-lp-demo__dashboard-frame">
            <img
              class="ads-lp-demo__dashboard-img"
              src="/hero-assets/screens/feature261-bookings-dashboard.jpg"
              alt="KERSIVO admin bookings dashboard preview"
              width={ADMIN_PREVIEW_WIDTH}
              height={ADMIN_PREVIEW_HEIGHT}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div class="ads-lp-demo__copy">
          <p class="ads-lp-demo__eyebrow">For your barbershop</p>
          <h3 class="ads-lp-demo__title">Admin &amp; shop system</h3>
          <p class="ads-lp-demo__desc">
            Explore the dashboard used to manage bookings, clients, barbers, services, reports and
            retail pickup orders.
          </p>
          <ul class="ads-lp-demo__highlights">
            {adminHighlights.map((item) => <li>{item}</li>)}
          </ul>
          <a
            class="btn btn--primary btn--lg ads-lp-demo__cta"
            href="/admin-demo?section=bookings_dashboard"
            target="_blank"
            rel="noopener"
            data-track="ads_lp_admin_demo_click"
          >
            Open admin demo
          </a>
        </div>
      </article>
    </div>

    <p class="ads-lp-demo__note">No signup required. Both demos open in a new tab.</p>
    <p class="ads-lp-demo__soft-cta">
      <a href="#pricing">See the £39 plan</a>
    </p>
  </div>
</section>
