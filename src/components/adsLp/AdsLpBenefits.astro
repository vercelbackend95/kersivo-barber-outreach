---
type Benefit = {
  title: string;
  note?: string;
  icon: 'globe' | 'domain' | 'commission' | 'deposit' | 'sms' | 'clients' | 'retail' | 'hosting';
};

const benefits: Benefit[] = [
  { title: 'Your own branded barbershop website', icon: 'globe' },
  { title: 'Your own domain included', icon: 'domain' },
  {
    title: '0% KERSIVO commission on bookings and retail sales',
    note: 'Stripe processing fees apply.',
    icon: 'commission',
  },
  { title: 'Online booking deposits', icon: 'deposit' },
  { title: 'SMS appointment reminders included', icon: 'sms' },
  { title: 'Client management', icon: 'clients' },
  { title: 'Retail pickup shop', icon: 'retail' },
  { title: 'Hosting, SSL and platform updates included', icon: 'hosting' },
];

const ICON_PATHS: Record<Benefit['icon'], string> = {
  globe:
    'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.5 0 4.5-4 4.5-9S14.5 3 12 3 7.5 7 7.5 12s2 9 4.5 9ZM3 12h18',
  domain: 'M4 7h16v11H4V7Zm2 0V5h12v2M8 11h8M8 15h5',
  commission: 'M12 3v18M17 7H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6',
  deposit: 'M12 3v18M7 8h7a3 3 0 0 1 0 6H9m0 0h6a3 3 0 0 1 0 6H7',
  sms: 'M4 5h16v10H8l-4 4V5Zm4 4h8M8 12h5',
  clients: 'M16 19v-1.5A3.5 3.5 0 0 0 12.5 14h-1A3.5 3.5 0 0 0 8 17.5V19M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
  retail: 'M6 7h12l-1 13H7L6 7Zm3-3h6l1 3H8l1-3Z',
  hosting: 'M4 7h16v4H4V7Zm0 6h16v4H4v-4Zm3 2h.01M7 9h.01',
};
---

<section
  id="benefits"
  class="ads-lp-section ads-lp-benefits"
  aria-labelledby="ads-lp-benefits-heading"
>
  <div class="container">
    <header class="ads-lp-benefits__intro">
      <h2 id="ads-lp-benefits-heading" class="ads-lp-benefits__heading">
        Everything your barbershop needs to run bookings professionally
      </h2>
      <p class="ads-lp-benefits__lead">
        One platform for your website, bookings, clients, deposits and retail — built specifically
        for independent barbershops.
      </p>
    </header>

    <ul class="ads-lp-benefits__grid" role="list">
      {
        benefits.map((benefit) => (
          <li class="ads-lp-benefits__item">
            <span class="ads-lp-benefits__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                  d={ICON_PATHS[benefit.icon]}
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <div class="ads-lp-benefits__body">
              <p class="ads-lp-benefits__title">{benefit.title}</p>
              {benefit.note ? <p class="ads-lp-benefits__note">{benefit.note}</p> : null}
            </div>
          </li>
        ))
      }
    </ul>

    <p class="ads-lp-benefits__soft-cta">
      <a href="#pricing">See the £39 plan</a>
    </p>
  </div>
</section>
