---
type BenefitBlock = {
  title: string;
  description: string;
  detail: string;
  image: string;
  imageWidth: number;
  imageHeight: number;
  imageAlt: string;
};

type IncludedItem = {
  label: string;
  note?: string;
};

function benefitResponsiveSrc(image: string): string {
  const match = image.match(/\/([^/]+)\.webp$/);
  if (!match) return image;
  const base = match[1];
  const dir = image.replace(/\/[^/]+$/, '');
  return `${dir}/${base}-480w.webp`;
}

function benefitSrcset(image: string, imageWidth: number): string {
  const match = image.match(/\/([^/]+)\.webp$/);
  if (!match) return image;
  const base = match[1];
  const dir = image.replace(/\/[^/]+$/, '');
  const variantWidths = [320, 480, 768, 1024] as const;
  const entries = variantWidths
    .filter((width) => width < imageWidth)
    .map((width) => `${dir}/${base}-${width}w.webp ${width}w`);
  entries.push(`${image} ${imageWidth}w`);
  return entries.join(', ');
}

const blocks: BenefitBlock[] = [
  {
    title: 'Your branded booking experience',
    description:
      'Give clients a professional booking experience built around your barbershop — with your branding, services, team and availability.',
    detail: 'Your website · Your domain · Online deposits',
    image: '/images/Ilustracje/8.webp',
    imageWidth: 1536,
    imageHeight: 1024,
    imageAlt: 'Client in the barber chair on their phone — booking through a branded experience',
  },
  {
    title: 'Your barbershop system',
    description:
      'Manage bookings, clients, barbers, services and working hours from one central dashboard.',
    detail: 'Bookings · Clients · Team management',
    image: '/images/Ilustracje/shoppyonline.webp',
    imageWidth: 1536,
    imageHeight: 1024,
    imageAlt: 'Barber managing the shop on a laptop from the chair',
  },
  {
    title: 'Deposits and reminders that protect your time',
    description:
      'Take booking deposits and send appointment reminders to reduce missed appointments and protect valuable chair time.',
    detail: 'Online deposits · SMS reminders · No-show protection',
    image: '/images/Ilustracje/reminder.webp',
    imageWidth: 928,
    imageHeight: 1152,
    imageAlt: 'Person with phone showing an SMS appointment reminder',
  },
];

const includedItems: IncludedItem[] = [
  { label: 'Retail pickup shop' },
  { label: 'Client management' },
  { label: 'Your own domain included' },
  { label: 'Hosting and SSL' },
  { label: 'Platform updates' },
  {
    label: '0% KERSIVO commission on bookings and retail sales',
    note: 'Stripe processing fees apply.',
  },
];
---

<section
  id="benefits"
  class="ads-lp-section ads-lp-benefits"
  aria-labelledby="ads-lp-benefits-heading"
>
  <div class="container">
    <header class="ads-lp-benefits__intro">
      <p class="ads-lp-benefits__kicker">What KERSIVO includes</p>
      <h2 id="ads-lp-benefits-heading" class="ads-lp-benefits__heading">
        Everything your barbershop needs to run bookings professionally
      </h2>
      <p class="ads-lp-benefits__lead">
        Your branded booking experience, barbershop management tools and no-show protection — all
        included in one simple £39 monthly plan.
      </p>
    </header>

    <ul class="ads-lp-benefits__blocks" role="list">
      {
        blocks.map((block, index) => (
          <li
            class:list={[
              'ads-lp-benefits__row',
              { 'ads-lp-benefits__row--reverse': index % 2 === 1 },
            ]}
          >
            <div class="ads-lp-benefits__visual">
              <img
                class="ads-lp-benefits__image"
                src={benefitResponsiveSrc(block.image)}
                srcset={benefitSrcset(block.image, block.imageWidth)}
                sizes="(max-width: 640px) min(90vw, 280px), (max-width: 1024px) 45vw, 403px"
                alt={block.imageAlt}
                width={block.imageWidth}
                height={block.imageHeight}
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="ads-lp-benefits__content">
              <h3 class="ads-lp-benefits__title">{block.title}</h3>
              <p class="ads-lp-benefits__desc">{block.description}</p>
              <p class="ads-lp-benefits__detail">{block.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="ads-lp-benefits__included">
      <h3 class="ads-lp-benefits__included-heading">Also included in your £39 monthly plan</h3>
      <ul class="ads-lp-benefits__included-list">
        {
          includedItems.map((item) => (
            <li class="ads-lp-benefits__included-item">
              <span class="ads-lp-benefits__check" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M3.5 8.5 6.5 11.5 12.5 4.5"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <span class="ads-lp-benefits__included-body">
                <span class="ads-lp-benefits__included-label">{item.label}</span>
                {item.note ? <span class="ads-lp-benefits__included-note">{item.note}</span> : null}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="ads-lp-benefits__soft-cta">
      <a href="#pricing">See the £39 plan</a>
    </p>
  </div>
</section>
