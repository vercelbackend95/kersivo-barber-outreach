---
const PHONE_FRAME_WIDTH = 543;
const PHONE_FRAME_HEIGHT = 1106;
const MOCK_SCREEN_WIDTH = 1179;
const MOCK_SCREEN_HEIGHT = 2556;
---

<section
  id="hero"
  class="ads-lp-section ads-lp-hero"
  aria-labelledby="ads-lp-hero-heading"
  style="--font-antonio: Antonio;"
>
  <div class="container ads-lp-hero__grid">
    <div class="ads-lp-hero__copy">
      <p class="ads-lp-hero__kicker">Built specifically for independent UK barbershops</p>
      <h1 id="ads-lp-hero-heading" class="ads-lp-hero__heading">
        Barbershop Booking Software Built for Independent UK Barbershops
      </h1>
      <p class="ads-lp-hero__sub">
        Get your own branded website and domain, online bookings, deposits, client management and
        retail pickup — all in one simple £39 monthly plan.
      </p>
      <p class="ads-lp-hero__price">£39/month. No setup fee. Cancel anytime.</p>

      <div class="ads-lp-hero__cta">
        <a
          href="#pricing"
          class="btn btn--primary btn--lg ads-lp-hero__cta-primary"
          data-track="ads_lp_hero_pricing_click"
        >
          Get started — £39/month
        </a>
        <button
          type="button"
          class="btn btn--secondary btn--lg ads-lp-hero__cta-secondary"
          data-system-chooser-open
          data-track="view_live_demo_click"
        >
          Explore the live demo
        </button>
      </div>

      <p class="ads-lp-hero__trust" role="list">
        <span class="ads-lp-hero__trust-item" role="listitem">Your own domain included</span>
        <span class="ads-lp-hero__trust-sep" aria-hidden="true">·</span>
        <span class="ads-lp-hero__trust-item" role="listitem">0% KERSIVO commission</span>
        <span class="ads-lp-hero__trust-sep" aria-hidden="true">·</span>
        <span class="ads-lp-hero__trust-item" role="listitem">One location</span>
        <span class="ads-lp-hero__trust-sep" aria-hidden="true">·</span>
        <span class="ads-lp-hero__trust-item" role="listitem">Cancel anytime</span>
      </p>
    </div>

    <div class="ads-lp-hero__visual" aria-hidden="false">
      <div class="ads-lp-hero__mock">
        <div class="ads-lp-hero__mock-screen-wrap">
          <img
            class="ads-lp-hero__mock-screen"
            src="/images/hero/iphonemockup.webp"
            alt="KERSIVO booking preview on an iPhone screen"
            width={MOCK_SCREEN_WIDTH}
            height={MOCK_SCREEN_HEIGHT}
            decoding="async"
          />
        </div>
        <img
          class="ads-lp-hero__mock-frame"
          src="/images/hero/phone-5.webp"
          alt=""
          width={PHONE_FRAME_WIDTH}
          height={PHONE_FRAME_HEIGHT}
          fetchpriority="high"
          decoding="sync"
        />
      </div>
    </div>
  </div>
</section>
