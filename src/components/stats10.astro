---
const outcomes = [
  {
    label: 'Booking clarity',
    title: 'Less back-and-forth',
    text: 'Clients can book without chasing messages.',
  },
  {
    label: 'Daily operations',
    title: 'Cleaner daily flow',
    text: 'Schedules, enquiries and updates stay easier to manage.',
  },
  {
    label: 'Retail system',
    title: 'Retail built in',
    text: 'Products and pickup orders live inside the same website system.',
  },
];
---

<section class="stats10" aria-label="Key outcomes for barbershop owners">
  <div class="container stats10__container">
    <div class="stats10__grid">
      {
        outcomes.map(({ label, title, text }) => (
          <article class="stats10__card">
            <p class="stats10__label">{label}</p>
            <h2 class="stats10__title">{title}</h2>
            <p class="stats10__text">{text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
