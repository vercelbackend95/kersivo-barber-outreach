---
/**
 * A phone built from the real device frames (public/images/website-design/phone-*.webp, transparent glass).
 * The glass is a size container, so anything drawn inside can be laid out in page pixels of a 390-wide
 * phone: 1 page px = 100cqw / 390 (see --wd-px in website-design.css). Glass and island insets were
 * measured from the frame's alpha channel.
 */
interface Props {
  finish?: 'gold' | 'black';
  class?: string;
  /** Draws the status bar (time, signal, battery) at the top of the glass. */
  status?: boolean;
  eager?: boolean;
  [key: `data-${string}`]: string | undefined;
}

const { finish = 'gold', class: className, status = true, eager = false, ...rest } = Astro.props;
const frame = finish === 'gold' ? { src: '/images/website-design/phone-gold.webp', w: 543, h: 1106 } : { src: '/images/website-design/phone-black.webp', w: 590, h: 1278 };
---

<div class:list={['wd-device', `wd-device--${finish}`, className]} {...rest}>
  <div class="wd-device__glass">
    {status && (
      <div class="wd-device__status" aria-hidden="true">
        <span>9:41</span>
        <span class="wd-device__icons"><i class="wd-device__signal"></i><i class="wd-device__battery"></i></span>
      </div>
    )}
    <div class="wd-device__viewport">
      <slot />
    </div>
  </div>
  <img class="wd-device__frame" src={frame.src} width={frame.w} height={frame.h} alt="" aria-hidden="true" loading={eager ? 'eager' : 'lazy'} decoding="async" />
</div>
