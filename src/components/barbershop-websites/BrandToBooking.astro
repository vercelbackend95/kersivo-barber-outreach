---
import '@/styles/components/barbershop-websites-brand-to-booking.css';
import { DEMO_BARBERS, demoBarberBookingHref } from '@/lib/demo/barbers';
import { DEMO_BOOK_HREF, DEMO_HOME_HREF } from '@/lib/demo/nav';
import { DEMO_SERVICES, formatDemoPriceGbp } from '@/lib/demo/services';

const discoverImages = {
  main: {
    src: '/demo/gallery/barber-at-work.webp',
    width: 2000,
    height: 1333,
    alt: 'A barber attending a client at the chair in the fictional BLACKLINE shop.',
  },
  detail: {
    src: '/demo/gallery/scissor-cut.webp',
    width: 1333,
    height: 2000,
    alt: 'Close-up of a scissor cut at the fictional BLACKLINE shop.',
  },
};

const services = DEMO_SERVICES.filter((service) => service.featured).slice(0, 3);
const barbers = DEMO_BARBERS.map((barber) => ({
  name: barber.name,
  href: demoBarberBookingHref(barber.slug),
  thumb: `/images/barbershop-websites/barber-${barber.slug}.webp`,
  alt: barber.image.alt,
}));

const exampleService = services[0];
const exampleBarber = DEMO_BARBERS[0];
---

<section class="bsw-b2b" aria-labelledby="bsw-b2b-heading">
  <div class="bsw-b2b__inner">
    <header class="bsw-b2b__intro">
      <p class="bsw-b2b__eyebrow">From brand to booking</p>
      <h2 id="bsw-b2b-heading" class="bsw-b2b__heading">
        Your brand. Your website. <span class="bsw-b2b__accent">Your bookings.</span>
      </h2>
      <p class="bsw-b2b__lede">
        From discovering your barbershop to booking an appointment, give clients one connected
        experience built around your business.
      </p>
      <p class="bsw-b2b__thought">
        Your website should feel like your shop — with online booking that fits naturally into the
        experience.
      </p>
      <div class="bsw-b2b__actions">
        <a class="bsw-b2b__cta bsw-b2b__cta--primary" href={DEMO_HOME_HREF}>Explore the working demo</a>
        <a class="bsw-b2b__cta bsw-b2b__cta--secondary" href={DEMO_BOOK_HREF}>Try a demo booking</a>
      </div>
      <p class="bsw-b2b__disclosure">
        BLACKLINE Barbers is a fictional demonstration shop. Demo bookings stay in your browser
        session — no real appointment is made and nothing is charged.
      </p>
    </header>

    <ol class="bsw-b2b__journey" role="list">
      <li class="bsw-b2b-step">
        <span class="bsw-b2b-step__number" aria-hidden="true">01</span>
        <div class="bsw-b2b-step__copy">
          <h3 class="bsw-b2b-step__title">Discover the shop</h3>
          <p class="bsw-b2b-step__text">
            Clients meet your name, your photos and your work first, so they know straight away whose
            shop this is.
          </p>
        </div>
        <div class="bsw-b2b-step__visual bsw-b2b-discover">
          <img
            class="bsw-b2b-discover__main"
            src={discoverImages.main.src}
            alt={discoverImages.main.alt}
            width={discoverImages.main.width}
            height={discoverImages.main.height}
            loading="lazy"
            decoding="async"
          />
          <img
            class="bsw-b2b-discover__detail"
            src={discoverImages.detail.src}
            alt={discoverImages.detail.alt}
            width={discoverImages.detail.width}
            height={discoverImages.detail.height}
            loading="lazy"
            decoding="async"
          />
          <div class="bsw-b2b-discover__plate">
            <p class="bsw-b2b-discover__wordmark">BLACKLINE</p>
            <a class="bsw-b2b__link" href={DEMO_HOME_HREF}>Visit the BLACKLINE homepage</a>
          </div>
        </div>
      </li>

      <li class="bsw-b2b-step">
        <span class="bsw-b2b-step__number" aria-hidden="true">02</span>
        <div class="bsw-b2b-step__copy">
          <h3 class="bsw-b2b-step__title">Explore and choose</h3>
          <p class="bsw-b2b-step__text">
            They compare services with clear prices and pick the barber they want, without leaving your
            website.
          </p>
        </div>
        <div class="bsw-b2b-step__visual bsw-b2b-choose">
          <ul class="bsw-b2b-choose__services" role="list" aria-label="Example BLACKLINE services">
            {services.map((service) => (
              <li class="bsw-b2b-choose__service">
                <span class="bsw-b2b-choose__service-name">{service.name}</span>
                <span class="bsw-b2b-choose__service-meta">
                  {service.durationMinutes} min · {formatDemoPriceGbp(service.pricePence)}
                </span>
              </li>
            ))}
          </ul>
          <ul class="bsw-b2b-choose__barbers" role="list" aria-label="BLACKLINE barbers">
            {barbers.map((barber) => (
              <li>
                <a
                  class="bsw-b2b-choose__barber"
                  href={barber.href}
                  aria-label={`Start a demo booking with ${barber.name}`}
                >
                  <img
                    src={barber.thumb}
                    alt={barber.alt}
                    width="160"
                    height="160"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="bsw-b2b-choose__barber-name">{barber.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>

      <li class="bsw-b2b-step">
        <span class="bsw-b2b-step__number" aria-hidden="true">03</span>
        <div class="bsw-b2b-step__copy">
          <h3 class="bsw-b2b-step__title">Book an appointment</h3>
          <p class="bsw-b2b-step__text">
            Then they book on the same website, in the same look, from the first tap to the
            confirmation.
          </p>
        </div>
        <div class="bsw-b2b-step__visual bsw-b2b-book">
          <p class="bsw-b2b-book__label">Example booking summary</p>
          <dl class="bsw-b2b-book__summary">
            <div>
              <dt>Shop</dt>
              <dd>BLACKLINE Barbers</dd>
            </div>
            <div>
              <dt>Service</dt>
              <dd>{exampleService.name} · {formatDemoPriceGbp(exampleService.pricePence)}</dd>
            </div>
            <div>
              <dt>Barber</dt>
              <dd>{exampleBarber.name}</dd>
            </div>
            <div>
              <dt>When</dt>
              <dd>Saturday, 10:30</dd>
            </div>
          </dl>
          <a class="bsw-b2b__link" href={DEMO_BOOK_HREF}>Book in the working demo</a>
        </div>
      </li>
    </ol>
  </div>
</section>
