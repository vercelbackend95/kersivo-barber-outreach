---
import { heritageBarberThumb } from '@/lib/demo/heritage/demoShapes';
import { HERITAGE_DEMO_BARBERS as DEMO_BARBERS, HERITAGE_DEMO_SHOP_NAME as DEMO_SHOP_NAME, HERITAGE_DEMO_SERVICES as DEMO_SERVICES } from '@/lib/demo/heritage/demoShapes';
import { ArrowRight } from 'lucide-react';
import '@/styles/components/barbershop-websites-brand-to-booking.css';
import { demoBarberFirstName, demoBarberRosterIndex } from '@/lib/demo/barbers';
import { HERITAGE_DEMO_SITE_HREF as DEMO_HOME_HREF } from '@/lib/demo/heritage/links';
import { HERITAGE_LOCKUP } from '@/lib/demo/heritage/mock';
import { formatDemoPriceGbp } from '@/lib/demo/services';

const TRACK_EVENT = 'view_live_demo_click';
const TRACK_PLACEMENT = 'barbershop_websites_brand_to_booking';

const barberIndex = Math.max(0, DEMO_BARBERS.findIndex((item) => item.slug === 'kit'));
const barber = DEMO_BARBERS[barberIndex] ?? DEMO_BARBERS[0];
const firstName = demoBarberFirstName(barber.name);

const shopPhoto = {
  src: '/demo/heritage-grooming/assets/img/chairs-960.webp',
  width: 960,
  height: 536,
};

const bookingProgress = ['Service', 'Barber', 'Schedule', 'Details'];
const services = DEMO_SERVICES.filter((service) => service.featured).slice(0, 3);
---

<section class="bsw-b2b" aria-labelledby="bsw-b2b-heading">
  <div class="bsw-b2b__inner">
    <div class="bsw-b2b__showcase">
      <header class="bsw-b2b__header">
        <p class="bsw-b2b__eyebrow">The client journey</p>
        <h2 id="bsw-b2b-heading" class="bsw-b2b__heading">
          <span>From first impression</span>
          <span>to <em class="bsw-b2b__accent">booking</em>.</span>
        </h2>
        <p class="bsw-b2b__lede">
          See how the fictional Heritage Grooming shop example takes a client from its homepage to
          choosing a barber and booking an appointment.
        </p>
      </header>

      <p class="bsw-b2b__swipe" aria-hidden="true">
        Swipe through the journey
        <ArrowRight size={14} strokeWidth={2} aria-hidden="true" />
      </p>

      <div class="bsw-b2b__track" role="region" aria-label="The Heritage Grooming client journey" tabindex="0">
        <ol class="bsw-b2b__moments" role="list">
          <li class="bsw-b2b-moment">
            <div
              class="bsw-b2b-phone"
              role="img"
              aria-label={`Illustrative preview of the Heritage Grooming demo homepage: ${barber.name} at work, the headline A barbershop that takes its time and a Book a chair button.`}
            >
              <div class="bsw-b2b-phone__screen" aria-hidden="true">
                <div class="bsw-b2b-phone__bar">
                  <img
                    class="bsw-b2b-lockup"
                    src={HERITAGE_LOCKUP.src}
                    alt=""
                    width={HERITAGE_LOCKUP.width}
                    height={HERITAGE_LOCKUP.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="bsw-b2b-phone__menu"><i></i><i></i></span>
                </div>
                <img
                  class="bsw-b2b-phone__photo bsw-b2b-phone__photo--shop"
                  src={shopPhoto.src}
                  alt=""
                  width={shopPhoto.width}
                  height={shopPhoto.height}
                  loading="lazy"
                  decoding="async"
                />
                <div class="bsw-b2b-phone__body bsw-b2b-phone__body--hero">
                  <span class="bsw-b2b-phone__eyebrow">Chapel Street · By appointment</span>
                  <span class="bsw-b2b-phone__display">A barbershop that takes its time.</span>
                  <span class="bsw-b2b-phone__lede">Haircuts, beard work and hot-towel shaves, by appointment.</span>
                  <span class="bsw-b2b-phone__actions">
                    <span class="bsw-b2b-phone__btn">Book a chair</span>
                    <span class="bsw-b2b-phone__btn bsw-b2b-phone__btn--ghost">Services</span>
                  </span>
                </div>
              </div>
            </div>
            <div class="bsw-b2b-moment__caption">
              <span class="bsw-b2b-moment__node" aria-hidden="true">01</span>
              <h3 class="bsw-b2b-moment__title">Discover the shop</h3>
              <p class="bsw-b2b-moment__text">
                Clients see the shop’s name, work and location before they book.
              </p>
            </div>
          </li>

          <li class="bsw-b2b-moment">
            <div
              class="bsw-b2b-phone"
              role="img"
              aria-label={`Illustrative preview of the Heritage Grooming demo barbers page: ${barber.name}, ${barber.specialisation}, with a Book with ${firstName} link.`}
            >
              <div class="bsw-b2b-phone__screen" aria-hidden="true">
                <div class="bsw-b2b-phone__bar">
                  <img
                    class="bsw-b2b-lockup"
                    src={HERITAGE_LOCKUP.src}
                    alt=""
                    width={HERITAGE_LOCKUP.width}
                    height={HERITAGE_LOCKUP.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="bsw-b2b-phone__menu"><i></i><i></i></span>
                </div>
                <div class="bsw-b2b-phone__body bsw-b2b-phone__body--roster">
                  <span class="bsw-b2b-phone__display bsw-b2b-phone__display--sm">Choose your chair.</span>
                  <span class="bsw-b2b-roster">
                    <img
                      class="bsw-b2b-phone__photo bsw-b2b-phone__photo--portrait"
                      src={barber.image.src}
                      alt=""
                      width={barber.image.width}
                      height={barber.image.height}
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="bsw-b2b-roster__index">{demoBarberRosterIndex(barberIndex)}</span>
                  </span>
                  <span class="bsw-b2b-roster__details">
                    <span class="bsw-b2b-roster__name">{barber.name}</span>
                    <span class="bsw-b2b-roster__spec">{barber.specialisation}</span>
                    <span class="bsw-b2b-roster__copy">{barber.selectionCopy}</span>
                    <span class="bsw-b2b-roster__book">Book with {firstName} <span class="bsw-b2b-roster__arrow"></span></span>
                  </span>
                </div>
              </div>
            </div>
            <div class="bsw-b2b-moment__caption">
              <span class="bsw-b2b-moment__node" aria-hidden="true">02</span>
              <h3 class="bsw-b2b-moment__title">Explore and choose</h3>
              <p class="bsw-b2b-moment__text">
                Clients get to know your team and choose the barber they want.
              </p>
            </div>
          </li>

          <li class="bsw-b2b-moment bsw-b2b-moment--destination">
            <div
              class="bsw-b2b-phone"
              role="img"
              aria-label={`Illustrative preview of the Heritage Grooming demo booking page, Book a chair, with ${barber.name} already selected as the barber.`}
            >
              <div class="bsw-b2b-phone__screen" aria-hidden="true">
                <div class="bsw-b2b-phone__bar">
                  <img
                    class="bsw-b2b-lockup"
                    src={HERITAGE_LOCKUP.src}
                    alt=""
                    width={HERITAGE_LOCKUP.width}
                    height={HERITAGE_LOCKUP.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="bsw-b2b-phone__menu"><i></i><i></i></span>
                </div>
                <div class="bsw-b2b-booking-head">
                  <span class="bsw-b2b-phone__eyebrow">{DEMO_SHOP_NAME}</span>
                  <span class="bsw-b2b-phone__display bsw-b2b-phone__display--sm">Book a chair</span>
                  <span class="bsw-b2b-progress">
                    {bookingProgress.map((label, index) => (
                      <span class:list={['bsw-b2b-progress__step', { 'is-active': index === 0 }]}>
                        <span class="bsw-b2b-progress__dot">{index + 1}</span>
                        <span class="bsw-b2b-progress__label">{label}</span>
                      </span>
                    ))}
                  </span>
                </div>
                <div class="bsw-b2b-phone__body bsw-b2b-phone__body--booking">
                  <span class="bsw-b2b-carried">
                    <img
                      src={heritageBarberThumb(barber.slug)}
                      alt=""
                      width="160"
                      height="160"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="bsw-b2b-carried__text">
                      <span class="bsw-b2b-carried__label">Your barber</span>
                      <span class="bsw-b2b-carried__value">{barber.name}</span>
                    </span>
                    <span class="bsw-b2b-carried__check"></span>
                  </span>
                  <span class="bsw-b2b-services">
                    <span class="bsw-b2b-services__title">
                      Choose a service
                      <span class="bsw-b2b-services__hint">Pick what you need</span>
                    </span>
                    {services.map((service) => (
                      <span class="bsw-b2b-services__row">
                        <span class="bsw-b2b-services__text">
                          <span class="bsw-b2b-services__name">{service.name}</span>
                          <span class="bsw-b2b-services__meta">{service.durationMinutes} min</span>
                        </span>
                        <span class="bsw-b2b-services__price">{formatDemoPriceGbp(service.pricePence)}</span>
                      </span>
                    ))}
                  </span>
                </div>
              </div>
            </div>
            <div class="bsw-b2b-moment__caption">
              <span class="bsw-b2b-moment__node" aria-hidden="true">03</span>
              <h3 class="bsw-b2b-moment__title">Book an appointment</h3>
              <p class="bsw-b2b-moment__text">
                Booking continues in the same look, with {firstName} already selected.
              </p>
            </div>
          </li>
        </ol>
      </div>

      <footer class="bsw-b2b__close">
        <p class="bsw-b2b__disclosure">
          Heritage Grooming is a fictional demo shop. These previews are illustrative. Demo bookings
          stay in your browser session — no real appointment is created and no payment is taken.
        </p>
        <a
          class="btn btn--primary btn--lg bsw-b2b__cta"
          href={DEMO_HOME_HREF}
          data-track={TRACK_EVENT}
          data-track-placement={TRACK_PLACEMENT}
        >
          Explore the working demo
          <ArrowRight className="bsw-b2b__cta-icon" size={17} strokeWidth={2} aria-hidden="true" />
        </a>
      </footer>
    </div>
  </div>
</section>
