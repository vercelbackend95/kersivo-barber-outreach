---
import { ArrowRight } from 'lucide-react';
import '@/styles/components/barbershop-websites-brand-to-booking.css';
import {
  DEMO_BARBERS,
  demoBarberBookingHref,
  demoBarberFirstName,
  demoBarberRosterIndex,
} from '@/lib/demo/barbers';
import { DEMO_HOME_HREF } from '@/lib/demo/nav';
import { DEMO_SERVICES, formatDemoPriceGbp } from '@/lib/demo/services';

const TRACK_EVENT = 'view_live_demo_click';
const TRACK_PLACEMENT = 'barbershop_websites_brand_to_booking';

const barberIndex = Math.max(0, DEMO_BARBERS.findIndex((item) => item.slug === 'ellis-ward'));
const barber = DEMO_BARBERS[barberIndex] ?? DEMO_BARBERS[0];
const firstName = demoBarberFirstName(barber.name);
const barbersHref = '/demo/barbers';
const bookingHref = demoBarberBookingHref(barber.slug);

const shopPhoto = {
  src: '/demo/gallery/barber-at-work.webp',
  width: 2000,
  height: 1333,
};

const bookingProgress = ['Service', 'Barber', 'Schedule', 'Details'];
const services = DEMO_SERVICES.filter((service) => service.featured).slice(0, 2);
---

<section class="bsw-b2b" aria-labelledby="bsw-b2b-heading">
  <div class="bsw-b2b__inner">
    <header class="bsw-b2b__header">
      <div>
        <p class="bsw-b2b__eyebrow">From brand to booking</p>
        <h2 id="bsw-b2b-heading" class="bsw-b2b__heading">
          Your brand. Your website. <span class="bsw-b2b__accent">Your bookings.</span>
        </h2>
      </div>
      <div class="bsw-b2b__intro">
        <p class="bsw-b2b__lede">
          From discovering your barbershop to booking an appointment, give clients one connected
          experience built around your business. Your name, photography and colours carry through
          every step — booking included.
        </p>
        <a
          class="bsw-b2b__cta"
          href={DEMO_HOME_HREF}
          data-track={TRACK_EVENT}
          data-track-placement={TRACK_PLACEMENT}
        >
          Explore the working demo
          <ArrowRight className="bsw-b2b__cta-icon" size={17} strokeWidth={2} aria-hidden="true" />
        </a>
        <p class="bsw-b2b__disclosure">
          BLACKLINE Barbers is a fictional demonstration shop. Demo bookings stay in your browser
          session — no real appointment is made and nothing is charged.
        </p>
      </div>
    </header>

    <div class="bsw-b2b__stage">
      <div class="bsw-b2b__legend">
        <p class="bsw-b2b__identity">
          <span class="bsw-b2b__identity-label">BLACKLINE identity</span>
          <span class="bsw-b2b__swatches">
            <span class="bsw-b2b__swatch bsw-b2b__swatch--carbon"><span class="sr-only">Carbon</span></span>
            <span class="bsw-b2b__swatch bsw-b2b__swatch--ivory"><span class="sr-only">Ivory</span></span>
            <span class="bsw-b2b__swatch bsw-b2b__swatch--cobalt"><span class="sr-only">Cobalt</span></span>
          </span>
          <span class="bsw-b2b__identity-items">Wordmark · Photography · Voice</span>
        </p>
        <p class="bsw-b2b__note">Illustrative previews of the demo pages. The links open the working demo.</p>
      </div>

      <p class="bsw-b2b__swipe" aria-hidden="true">
        Swipe through the journey
        <ArrowRight size={14} strokeWidth={2} aria-hidden="true" />
      </p>

      <div class="bsw-b2b__track" role="region" aria-label="The BLACKLINE client journey" tabindex="0">
        <ol class="bsw-b2b__moments" role="list">
          <li class="bsw-b2b-moment">
            <div
              class="bsw-b2b-phone"
              role="img"
              aria-label={`Illustrative preview of the BLACKLINE demo homepage: ${barber.name} at work, the headline Precision in every detail and a Book an appointment button.`}
            >
              <div class="bsw-b2b-phone__screen" aria-hidden="true">
                <div class="bsw-b2b-phone__bar">
                  <span class="bsw-b2b-lockup">
                    <span class="bsw-b2b-lockup__name">BLACKLINE</span>
                    <span class="bsw-b2b-lockup__sub"><i></i><span>BARBERS</span><i></i></span>
                  </span>
                  <span class="bsw-b2b-phone__menu"><i></i><i></i></span>
                </div>
                <img
                  class="bsw-b2b-phone__photo bsw-b2b-phone__photo--shop"
                  src={shopPhoto.src}
                  alt=""
                  width={shopPhoto.width}
                  height={shopPhoto.height}
                  loading="lazy"
                  decoding="async"
                />
                <div class="bsw-b2b-phone__body">
                  <span class="bsw-b2b-phone__eyebrow">Manchester · Appointments & walk-ins</span>
                  <span class="bsw-b2b-phone__display">Precision in every detail.</span>
                  <span class="bsw-b2b-phone__actions">
                    <span class="bsw-b2b-phone__btn">Book an appointment</span>
                    <span class="bsw-b2b-phone__btn bsw-b2b-phone__btn--ghost">Services</span>
                  </span>
                </div>
              </div>
            </div>
            <div class="bsw-b2b-moment__caption">
              <span class="bsw-b2b-moment__number" aria-hidden="true">01</span>
              <h3 class="bsw-b2b-moment__title">Discover the shop</h3>
              <p class="bsw-b2b-moment__text">
                Your name, your photography and your voice make the first impression.
              </p>
            </div>
          </li>

          <li class="bsw-b2b-moment">
            <div
              class="bsw-b2b-phone"
              role="img"
              aria-label={`Illustrative preview of the BLACKLINE demo barbers page: ${barber.name}, ${barber.specialisation}, with a Book with ${firstName} link.`}
            >
              <div class="bsw-b2b-phone__screen" aria-hidden="true">
                <div class="bsw-b2b-phone__bar">
                  <span class="bsw-b2b-lockup">
                    <span class="bsw-b2b-lockup__name">BLACKLINE</span>
                    <span class="bsw-b2b-lockup__sub"><i></i><span>BARBERS</span><i></i></span>
                  </span>
                  <span class="bsw-b2b-phone__menu"><i></i><i></i></span>
                </div>
                <div class="bsw-b2b-phone__body bsw-b2b-phone__body--roster">
                  <span class="bsw-b2b-phone__display bsw-b2b-phone__display--sm">Choose your chair.</span>
                  <span class="bsw-b2b-roster">
                    <img
                      class="bsw-b2b-phone__photo bsw-b2b-phone__photo--portrait"
                      src={barber.image.src}
                      alt=""
                      width={barber.image.width}
                      height={barber.image.height}
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="bsw-b2b-roster__index">{demoBarberRosterIndex(barberIndex)}</span>
                  </span>
                  <span class="bsw-b2b-roster__name">{barber.name}</span>
                  <span class="bsw-b2b-roster__spec">{barber.specialisation}</span>
                  <span class="bsw-b2b-roster__book">Book with {firstName} <span class="bsw-b2b-roster__arrow"></span></span>
                </div>
              </div>
            </div>
            <div class="bsw-b2b-moment__caption">
              <span class="bsw-b2b-moment__number" aria-hidden="true">02</span>
              <h3 class="bsw-b2b-moment__title">Explore and choose</h3>
              <p class="bsw-b2b-moment__text">
                Clients get to know your team and choose the barber they want.
              </p>
              <a
                class="bsw-b2b-moment__action"
                href={barbersHref}
                data-track={TRACK_EVENT}
                data-track-placement={TRACK_PLACEMENT}
              >
                <span>Meet the BLACKLINE barbers</span>
                <span class="bsw-b2b-moment__action-icon">
                  <ArrowRight size={14} strokeWidth={2} aria-hidden="true" />
                </span>
              </a>
            </div>
          </li>

          <li class="bsw-b2b-moment">
            <div
              class="bsw-b2b-phone"
              role="img"
              aria-label={`Illustrative preview of the BLACKLINE demo booking page, Book a chair, with ${barber.name} already selected as the barber.`}
            >
              <div class="bsw-b2b-phone__screen" aria-hidden="true">
                <div class="bsw-b2b-phone__bar">
                  <span class="bsw-b2b-lockup">
                    <span class="bsw-b2b-lockup__name">BLACKLINE</span>
                    <span class="bsw-b2b-lockup__sub"><i></i><span>BARBERS</span><i></i></span>
                  </span>
                  <span class="bsw-b2b-phone__menu"><i></i><i></i></span>
                </div>
                <div class="bsw-b2b-phone__body bsw-b2b-phone__body--booking">
                  <span class="bsw-b2b-phone__display bsw-b2b-phone__display--sm">Book a chair</span>
                  <span class="bsw-b2b-progress">
                    {bookingProgress.map((label, index) => (
                      <span class:list={['bsw-b2b-progress__step', { 'is-active': index === 0 }]}>
                        <span class="bsw-b2b-progress__dot">{index + 1}</span>
                        <span class="bsw-b2b-progress__label">{label}</span>
                      </span>
                    ))}
                  </span>
                  <span class="bsw-b2b-carried">
                    <img
                      src={`/images/barbershop-websites/barber-${barber.slug}.webp`}
                      alt=""
                      width="160"
                      height="160"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="bsw-b2b-carried__text">
                      <span class="bsw-b2b-carried__label">Barber</span>
                      <span class="bsw-b2b-carried__value">{barber.name}</span>
                    </span>
                    <span class="bsw-b2b-carried__check"></span>
                  </span>
                  <span class="bsw-b2b-services">
                    <span class="bsw-b2b-services__title">Choose a service</span>
                    {services.map((service) => (
                      <span class="bsw-b2b-services__row">
                        <span class="bsw-b2b-services__name">{service.name}</span>
                        <span class="bsw-b2b-services__meta">
                          {service.durationMinutes} min · {formatDemoPriceGbp(service.pricePence)}
                        </span>
                      </span>
                    ))}
                  </span>
                </div>
              </div>
            </div>
            <div class="bsw-b2b-moment__caption">
              <span class="bsw-b2b-moment__number" aria-hidden="true">03</span>
              <h3 class="bsw-b2b-moment__title">Book an appointment</h3>
              <p class="bsw-b2b-moment__text">
                Booking continues in the same look, with {firstName} already selected.
              </p>
              <a
                class="bsw-b2b-moment__action"
                href={bookingHref}
                data-track={TRACK_EVENT}
                data-track-placement={TRACK_PLACEMENT}
              >
                <span>Start a demo booking with {firstName}</span>
                <span class="bsw-b2b-moment__action-icon">
                  <ArrowRight size={14} strokeWidth={2} aria-hidden="true" />
                </span>
              </a>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </div>
</section>
