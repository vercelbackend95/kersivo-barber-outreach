---
import { ArrowRight } from 'lucide-react';
import { getSetupSteps } from '@/content/setupSteps';
import '@/styles/components/barbershop-websites-setup.css';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import { FREE_PREVIEW_BILLING_CLAIM } from '@/lib/pricing/claimsPolicy';

const SETUP_TERMS_HREF = '/terms#onboarding-and-launch';
const DOMAIN_TERMS_HREF = '/terms#domain';

type Stage = {
  number: string;
  owner: 'You' | 'We';
  title: string;
  copy: string;
};

type Note = {
  title: string;
  points: string[];
  link: { href: string; label: string };
};

const notes: Note[] = [
  {
    title: 'Your domain',
    points: [
      'Already have one? It stays yours, and you don’t need to transfer it.',
      'We help with the technical setup. You keep renewing it as you do now.',
      'No domain yet? A standard one is included and owned by your business.',
      'Premium or unusually expensive names aren’t included as standard.',
    ],
    link: { href: DOMAIN_TERMS_HREF, label: 'Domain terms' },
  },
  {
    title: 'Switching from another booking system',
    points: [
      'Help moving across is part of the standard setup.',
      'What we can bring over depends on what your current provider lets you export, so some history may not transfer.',
      'Where possible, your current bookings keep running while we build.',
    ],
    link: { href: SETUP_TERMS_HREF, label: 'Setup and launch terms' },
  },
];

// FREE_PREVIEW_FLOW_ENABLED shows the preview-first journey; off keeps the four subscribe-first stages.
const freePreview = isFreePreviewFlowEnabled();
const shownStages: Stage[] = getSetupSteps(freePreview).map((step, index) => ({
  number: String(index + 1).padStart(2, '0'),
  owner: step.owner === 'KERSIVO' ? 'We' : 'You',
  title: step.title,
  copy: step.body,
}));
const billingNote = freePreview
  ? FREE_PREVIEW_BILLING_CLAIM
  : 'Your subscription starts when you buy, including while we prepare your site.';
---

<section class="bsw-setup" aria-labelledby="bsw-setup-heading">
  <div class="bsw-setup__inner">
    <header class="bsw-setup__header">
      <div class="bsw-setup__intro">
        <p class="bsw-setup__eyebrow">Getting started</p>
        <h2 id="bsw-setup-heading" class="bsw-setup__heading">How we set up your barbershop website</h2>
        <p class="bsw-setup__lede">
          Share your shop details. We prepare the website and booking setup, then send you a
          private preview to approve.
        </p>
      </div>

      <div class="bsw-setup__timing">
        <p class="bsw-setup__timing-label">Typical setup time</p>
        <p class="bsw-setup__timing-figure">A few days</p>
        <p class="bsw-setup__timing-copy">
          From receipt of all required details. Domain access, missing information or migration may
          extend the timeline.
        </p>
        <p class="bsw-setup__timing-billing">
          {billingNote}
        </p>
      </div>
    </header>

    <ol class="bsw-setup__stages" data-stages={shownStages.length} role="list">
      {shownStages.map((stage) => (
        <li class={`bsw-setup-stage bsw-setup-stage--${stage.owner === 'You' ? 'you' : 'we'}`}>
          <p class="bsw-setup-stage__meta">
            <span class="bsw-setup-stage__number">{stage.number}</span>
            <span class="bsw-setup-stage__owner">{stage.owner === 'You' ? 'You' : 'KERSIVO'}</span>
          </p>
          <h3 class="bsw-setup-stage__title">{stage.title}</h3>
          <p class="bsw-setup-stage__copy">{stage.copy}</p>
        </li>
      ))}
    </ol>

    <div class="bsw-setup__notes">
      {notes.map((note) => (
        <div class="bsw-setup-note">
          <h3 class="bsw-setup-note__title">{note.title}</h3>
          <ul class="bsw-setup-note__points" role="list">
            {note.points.map((point) => <li>{point}</li>)}
          </ul>
          <a class="bsw-setup-note__link" href={note.link.href}>
            {note.link.label}
            <ArrowRight className="bsw-setup-note__link-icon" size={15} strokeWidth={2} aria-hidden="true" />
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
