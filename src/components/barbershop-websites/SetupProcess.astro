---
import '@/styles/components/barbershop-websites-setup.css';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';

const SETUP_ESTIMATE = 'Roughly 1–2 weeks after we receive all required information.';
const SETUP_TERMS_HREF = '/terms#onboarding-and-launch';
const DOMAIN_TERMS_HREF = '/terms#domain';

type Stage = {
  number: string;
  owner: 'You' | 'We';
  title: string;
  copy: string;
};

const stages: Stage[] = [
  {
    number: '01',
    owner: 'You',
    title: 'Choose Full KERSIVO',
    copy: `Subscribe for £${SAAS_MONTHLY_GBP} a month. Your first payment is taken at checkout, and you can send us your details straight away.`,
  },
  {
    number: '02',
    owner: 'You',
    title: 'Tell us about your shop',
    copy: 'Send your shop details, logo, photos, team, services, prices and opening hours. We’ll guide you through what we need. If a few extras like gallery photos aren’t ready, we can work around them.',
  },
  {
    number: '03',
    owner: 'We',
    title: 'We prepare your website',
    copy: 'We put your site together on the KERSIVO platform using your branding, sort out your domain and set up services, barbers and hours to match how your shop works.',
  },
  {
    number: '04',
    owner: 'You',
    title: 'Check it before launch',
    copy: 'A private preview appears in your KERSIVO dashboard. Check the details, try the booking flow and approve the site when you’re happy.',
  },
  {
    number: '05',
    owner: 'We',
    title: 'Go live',
    copy: 'Once you’ve approved it and the domain and booking setup are ready, we publish your website and clients can start booking.',
  },
];
---

<section class="bsw-setup" aria-labelledby="bsw-setup-heading">
  <div class="bsw-setup__inner">
    <header class="bsw-setup__header">
      <div class="bsw-setup__intro">
        <p class="bsw-setup__eyebrow">Getting started</p>
        <h2 id="bsw-setup-heading" class="bsw-setup__heading">How we set up your barbershop website</h2>
        <p class="bsw-setup__lede">
          You tell us about your shop. We build the website, set up your bookings and let you check
          everything before it goes live.
        </p>
      </div>

      <div class="bsw-setup__timing">
        <p class="bsw-setup__timing-label">Typical setup time</p>
        <p class="bsw-setup__timing-figure">1–2 weeks</p>
        <p class="bsw-setup__timing-copy">
          {SETUP_ESTIMATE} It can take longer if details are missing, or if domain access or moving
          your data across needs more time.
        </p>
        <p class="bsw-setup__timing-billing">
          Your subscription starts on the day you buy. Billing doesn’t pause while we prepare your
          site or wait for your materials.
        </p>
      </div>
    </header>

    <ol class="bsw-setup__stages" role="list">
      {stages.map((stage) => (
        <li class={`bsw-setup-stage bsw-setup-stage--${stage.owner === 'You' ? 'you' : 'we'}`}>
          <p class="bsw-setup-stage__meta">
            <span class="bsw-setup-stage__number">{stage.number}</span>
            <span class="bsw-setup-stage__owner">{stage.owner === 'You' ? 'You' : 'KERSIVO'}</span>
          </p>
          <h3 class="bsw-setup-stage__title">{stage.title}</h3>
          <p class="bsw-setup-stage__copy">{stage.copy}</p>
        </li>
      ))}
    </ol>

    <div class="bsw-setup__notes">
      <div class="bsw-setup-note">
        <h3 class="bsw-setup-note__title">Your domain</h3>
        <p class="bsw-setup-note__copy">
          Already have one? It stays yours. You don’t need to transfer it to us. We’ll help with the
          technical setup, and you keep renewing it as you do now.
        </p>
        <p class="bsw-setup-note__copy">
          No domain yet? We can register a standard one for your business, and legal ownership stays
          with you. Premium or unusually expensive names aren’t included as standard.
        </p>
        <a class="bsw-setup-note__link" href={DOMAIN_TERMS_HREF}>Domain terms</a>
      </div>

      <div class="bsw-setup-note">
        <h3 class="bsw-setup-note__title">Switching from another booking system</h3>
        <p class="bsw-setup-note__copy">
          Help with moving across is part of the standard setup. What we can bring over depends on
          what your current system lets you export, so we can’t promise every client record or past
          appointment will transfer.
        </p>
        <p class="bsw-setup-note__copy">
          Where it’s technically possible, your current website and bookings can keep running while
          we build.
        </p>
        <a class="bsw-setup-note__link" href={SETUP_TERMS_HREF}>Setup and launch terms</a>
      </div>
    </div>
  </div>
</section>
