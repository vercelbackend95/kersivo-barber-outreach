---
import { heritageBarberThumb } from '@/lib/demo/heritage/demoShapes';
import { HERITAGE_DEMO_BARBERS as DEMO_BARBERS } from '@/lib/demo/heritage/demoShapes';
import { CalendarDays, ChevronRight, MapPin } from 'lucide-react';
import { HERITAGE_DEMO_BOOK_HREF as DEMO_BOOK_HREF, HERITAGE_DEMO_CONTACT_HREF as DEMO_CONTACT_HREF, HERITAGE_DEMO_SITE_HREF as DEMO_HOME_HREF, HERITAGE_DEMO_SHOP_HREF as DEMO_SHOP_HREF, HERITAGE_DEMO_SERVICES_HREF, HERITAGE_DEMO_TEAM_HREF } from '@/lib/demo/heritage/links';

// One promise: every item opens the working Heritage Grooming demo.
const rows = [
  { key: 'branding', label: 'Branding', body: 'See how to present your barbershop brand.', href: DEMO_HOME_HREF },
  { key: 'services', label: 'Services', body: 'Show your cuts, prices and services.', href: HERITAGE_DEMO_SERVICES_HREF },
  { key: 'team', label: 'Your team', body: 'Present the barbers behind your shop.', href: HERITAGE_DEMO_TEAM_HREF },
  { key: 'retail', label: 'Retail shop', body: 'Sell products for in-shop collection.', href: DEMO_SHOP_HREF },
  { key: 'booking', label: 'Online booking', body: 'See how booking works for clients and your shop.', href: DEMO_BOOK_HREF },
  { key: 'contact', label: 'Contact & location', body: 'Make your shop easy to find.', href: DEMO_CONTACT_HREF },
] as const;
---

<aside class="bsw-panel bsw-features" aria-labelledby="bsw-features-title">
  <p id="bsw-features-title" class="bsw-features__title">Your website. Your business.</p>
  <ul class="bsw-features__list" role="list">
    {rows.map((row) => {
      const labelId = `bsw-feature-${row.key}-label`;
      const bodyId = `bsw-feature-${row.key}-body`;
      return (
      <li>
        <a class="bsw-feature" href={row.href} aria-labelledby={`${labelId} ${bodyId}`}>
          <span class:list={['bsw-thumb', `bsw-thumb--${row.key}`]} aria-hidden="true">
            {row.key === 'branding' && (
              <span class="bsw-swatches"><i></i><i></i><i></i></span>
            )}
            {row.key === 'services' && (
              <img src="/demo/heritage-grooming/assets/img/tools-960.webp" alt="" width="240" height="150" loading="lazy" decoding="async" />
            )}
            {row.key === 'team' &&
              DEMO_BARBERS.map((barber) => (
                <img src={heritageBarberThumb(barber.slug)} alt="" width="160" height="160" loading="lazy" decoding="async" />
              ))}
            {row.key === 'retail' && (
              <img src="/demo/heritage-grooming/assets/img/featured/kestrel-matte-clay.webp" alt="" width="240" height="150" loading="lazy" decoding="async" />
            )}
            {row.key === 'booking' && (
              <span class="bsw-thumb__booking-ui">
                <CalendarDays size={13} strokeWidth={1.7} />
                <span class="bsw-thumb__booking-slots" aria-hidden="true"><i>10:00</i><i>11:00</i></span>
              </span>
            )}
            {row.key === 'contact' && (
              <>
                <img src="/demo/heritage-grooming/assets/img/chairs-960.webp" alt="" width="240" height="150" loading="lazy" decoding="async" />
                <span class="bsw-thumb__location-marker"><MapPin size={16} strokeWidth={2} /></span>
              </>
            )}
          </span>
          <span class="bsw-feature__text">
            <span id={labelId} class="bsw-feature__label">{row.label}</span>
            <span id={bodyId} class="bsw-feature__body">{row.body}</span>
          </span>
          <ChevronRight className="bsw-feature__chevron" size={14} strokeWidth={1.8} aria-hidden="true" />
        </a>
      </li>
      );
    })}
  </ul>
</aside>
