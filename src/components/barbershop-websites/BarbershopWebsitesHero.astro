---
import BlacklineWebsitePreview from './BlacklineWebsitePreview.astro';
import BookingPreview from './BookingPreview.astro';
import WebsiteFeaturesPanel from './WebsiteFeaturesPanel.astro';
import HeroBenefits from './HeroBenefits.astro';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import { STRIPE_FEES_NOTE } from '@/lib/pricing/claimsPolicy';
import { BARBERSHOP_WEBSITES_PAGE_H1 } from '@/lib/seo/barbershopWebsitesPage';
import '@/styles/components/fresha-alternative.css';
import '@/styles/components/barbershop-websites-hero.css';

// The red accent full stop is only drawn when the approved H1 itself ends with one,
// and always sits inside the final line so it can never wrap on its own.
const endsWithFullStop = BARBERSHOP_WEBSITES_PAGE_H1.endsWith('.');
const headline = BARBERSHOP_WEBSITES_PAGE_H1.replace(/\.$/, '');
const splitAt = headline.indexOf(' that ');
const lines = splitAt > 0 ? [headline.slice(0, splitAt), headline.slice(splitAt + 1)] : [headline];
---

<section class="bsw-hero" aria-labelledby="bsw-hero-title">
  <div class="bsw-hero__ambient" aria-hidden="true"></div>

  <div class="bsw-hero__head">
    <nav class="bsw-hero__breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><span aria-current="page">Barbershop websites</span></li>
      </ol>
    </nav>
    <p class="fresha-alt-hero__eyebrow"><span class="fresha-alt-hero__eyebrow-dot" aria-hidden="true"></span>Barbershop websites</p>
    <h1 id="bsw-hero-title" class="bsw-hero__title">
      {lines.map((line, index) => (
        <>
          {index > 0 && ' '}
          <span>{line}{endsWithFullStop && index === lines.length - 1 && <span class="bsw-accent">.</span>}</span>
        </>
      ))}
    </h1>
    <p class="bsw-hero__lead">
      Full KERSIVO brings your shop a branded website, a standard domain, online booking and
      tools to manage the day.
    </p>
    <p class="bsw-hero__price">
      <strong>£{SAAS_MONTHLY_GBP}/month per location</strong>
      <span aria-hidden="true">·</span>
      <span>No setup fee</span>
      <span aria-hidden="true">·</span>
      <span>0% KERSIVO commission</span>
    </p>
    <p class="bsw-hero__price-note">{STRIPE_FEES_NOTE}</p>
    <div class="bsw-hero__actions">
      <a
        href="/demo"
        class="fresha-alt-hero__action fresha-alt-hero__action--primary bsw-hero__action"
        data-track="view_live_demo_click"
        data-track-placement="barbershop_websites_hero"
      >
        Explore the working demo <span aria-hidden="true">→</span>
      </a>
      <a
        href="/pricing#plan"
        class="fresha-alt-hero__action fresha-alt-hero__action--secondary bsw-hero__action"
        data-track="plan_my_setup_click"
        data-track-placement="barbershop_websites_hero"
      >
        Explore Full KERSIVO
      </a>
    </div>


  </div>

  <div class="bsw-stage">
    <div class="bsw-stage__item bsw-stage__item--centre">
      <BlacklineWebsitePreview />
    </div>
    <div class="bsw-stage__item bsw-stage__item--right">
      <BookingPreview />
    </div>
    <div class="bsw-stage__item bsw-stage__item--left">
      <WebsiteFeaturesPanel />
    </div>
  </div>

  <p class="bsw-disclosure">
    CUTSTATE BARBERS is a fictional demonstration shop. These previews are illustrative —
    <a href="/demo">explore the working demo</a> for live behaviour.
  </p>

  <HeroBenefits />
</section>
