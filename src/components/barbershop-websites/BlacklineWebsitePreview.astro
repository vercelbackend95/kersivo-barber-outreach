---
import { ArrowRight, Lock, RotateCw } from 'lucide-react';
import { DEMO_SERVICES, demoBookingHref, formatDemoPriceGbp } from '@/lib/demo/services';
import { DEMO_BOOK_HREF, DEMO_CONTACT_HREF, DEMO_GALLERY_HREF, DEMO_HOME_HREF } from '@/lib/demo/nav';
import { CUTSTATE_LOGO_HEIGHT, CUTSTATE_LOGO_SRC, CUTSTATE_LOGO_WIDTH } from '@/components/demo/BlacklineWordmark';

interface Props {
  /** Hero-only frame without the service strip; used at reduced scale on /free-preview. */
  compact?: boolean;
  imageLoading?: 'eager' | 'lazy';
  imageFetchPriority?: 'high' | 'low' | 'auto';
}

const {
  compact = false,
  imageLoading,
  imageFetchPriority,
} = Astro.props;
const loading = imageLoading ?? (compact ? 'lazy' : undefined);
const fetchPriority = imageFetchPriority ?? (compact ? 'low' : 'high');

const IMG = '/images/barbershop-websites';

const serviceImages = {
  'haircut-finish': `${IMG}/service-haircut.webp`,
  'beard-trim': `${IMG}/service-beard.webp`,
  'skin-fade': `${IMG}/service-fade.webp`,
  'wash-style-finish': `${IMG}/service-style.webp`,
} as const;

const serviceCards = (Object.keys(serviceImages) as (keyof typeof serviceImages)[]).flatMap((slug) => {
  const service = DEMO_SERVICES.find((item) => item.slug === slug);
  return service ? [{ slug, image: serviceImages[slug], service }] : [];
});

const siteNav = [
  { href: DEMO_HOME_HREF, label: 'Home', current: true },
  { href: '/demo/services', label: 'Services' },
  { href: '/demo/barbers', label: 'Barbers' },
  { href: DEMO_GALLERY_HREF, label: 'Gallery' },
  { href: DEMO_CONTACT_HREF, label: 'Contact' },
];
---

<figure class="bsw-browser" aria-label="Illustrated preview of the CUTSTATE BARBERS demo website built on KERSIVO">
  <div class="bsw-browser__toolbar">
    <span class="bsw-browser__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <a class="bsw-browser__address" href={DEMO_HOME_HREF}>
      <Lock size={11} strokeWidth={2} aria-hidden="true" />
      <span>kersivo.co.uk/demo</span>
    </a>
    <span class="bsw-browser__refresh" aria-hidden="true"><RotateCw size={12} strokeWidth={1.8} /></span>
  </div>

  <div class="bsw-site">
    <div class="bsw-site__nav">
      <a class="bsw-site__brand" href={DEMO_HOME_HREF} aria-label="CUTSTATE BARBERS demo home">
        <img
          src={CUTSTATE_LOGO_SRC}
          alt=""
          width={CUTSTATE_LOGO_WIDTH}
          height={CUTSTATE_LOGO_HEIGHT}
          decoding="async"
          draggable="false"
        />
      </a>
      <nav class="bsw-site__links" aria-label="CUTSTATE demo pages">
        {siteNav.map((item) => (
          <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <a class="bsw-site__book" href={DEMO_BOOK_HREF}>Book Now</a>
    </div>

    <div class="bsw-site__hero">
      <picture class="bsw-site__photo">
        <source media="(max-width: 640px)" srcset={`${IMG}/site-hero-640.webp`} />
        <img
          src={compact ? `${IMG}/site-hero-640.webp` : `${IMG}/site-hero-1100.webp`}
          alt="A CUTSTATE demo barber cutting a client's hair with clippers"
          width={compact ? 640 : 1100}
          height={compact ? 524 : 900}
          loading={loading}
          fetchpriority={fetchPriority}
          decoding="async"
        />
      </picture>
      <div class="bsw-site__copy">
        <p class="bsw-site__eyebrow">Precision <span aria-hidden="true">×</span> Style <span aria-hidden="true">×</span> Community</p>
        <p class="bsw-site__headline">More than<br />a haircut<span class="bsw-accent">.</span></p>
        <p class="bsw-site__lead">Modern cuts. Real people. A barbershop built on quality, community and good conversation.</p>
        <a class="bsw-site__cta" href={DEMO_BOOK_HREF}>
          Book an Appointment <ArrowRight size={13} strokeWidth={2} aria-hidden="true" />
        </a>
      </div>
    </div>

    {!compact && (
    <ul class="bsw-site__services" role="list">
      {serviceCards.map((card) => (
        <li>
          <a
            class="bsw-service"
            href={demoBookingHref(card.slug)}
            data-astro-reload
            aria-label={`Book ${card.service.name} in the CUTSTATE demo`}
          >
            <img src={card.image} alt="" width="400" height="300" loading="lazy" decoding="async" />
            <span class="bsw-service__text">
              <span class="bsw-service__name">{card.service.shortName ?? card.service.name}</span>
              <span class="bsw-service__meta">
                <span class="bsw-service__price">From {formatDemoPriceGbp(card.service.pricePence)}</span>
                <span class="bsw-service__book">
                  Book in demo
                  <ArrowRight className="bsw-service__arrow" size={13} strokeWidth={1.8} aria-hidden="true" />
                </span>
                <ArrowRight className="bsw-service__arrow bsw-service__arrow--touch" size={13} strokeWidth={1.8} aria-hidden="true" />
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    )}
  </div>
</figure>
