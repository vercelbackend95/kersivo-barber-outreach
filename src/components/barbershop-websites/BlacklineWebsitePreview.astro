---
import { HERITAGE_DEMO_SERVICES as DEMO_SERVICES, heritageBookingHref as demoBookingHref } from '@/lib/demo/heritage/demoShapes';
import { ArrowRight, Lock, RotateCw } from 'lucide-react';
import { formatDemoPriceGbp } from '@/lib/demo/services';
import { HERITAGE_DEMO_BOOK_HREF as DEMO_BOOK_HREF, HERITAGE_DEMO_CONTACT_HREF as DEMO_CONTACT_HREF, HERITAGE_DEMO_GALLERY_HREF as DEMO_GALLERY_HREF, HERITAGE_DEMO_SITE_HREF as DEMO_HOME_HREF } from '@/lib/demo/heritage/links';
import { HERITAGE_DEMO_SERVICES_HREF, HERITAGE_DEMO_TEAM_HREF } from '@/lib/demo/heritage/links';
import { HERITAGE_LOCKUP, HERITAGE_MOCK_BOOK_LABEL, HERITAGE_MOCK_EYEBROW, HERITAGE_MOCK_LEDE, HERITAGE_MOCK_PHOTOS, HERITAGE_MOCK_TITLE } from '@/lib/demo/heritage/mock';

interface Props {
  /** Hero-only frame without the service strip; used at reduced scale on /free-preview. */
  compact?: boolean;
  imageLoading?: 'eager' | 'lazy';
  imageFetchPriority?: 'high' | 'low' | 'auto';
}

const {
  compact = false,
  imageLoading,
  imageFetchPriority,
} = Astro.props;
const loading = imageLoading ?? (compact ? 'lazy' : undefined);
const fetchPriority = imageFetchPriority ?? (compact ? 'low' : 'high');

const IMG = '/demo/heritage-grooming/assets/img';

const serviceImages = {
  haircut: `${IMG}/work-kit-scissors-500.webp`,
  'skin-fade': `${IMG}/work-arthur-fade-500.webp`,
  'beard-trim': `${IMG}/work-rafi-beard-500.webp`,
  'hot-towel-shave': `${IMG}/work-owen-razor-500.webp`,
} as const;

const serviceCards = (Object.keys(serviceImages) as (keyof typeof serviceImages)[]).flatMap((slug) => {
  const service = DEMO_SERVICES.find((item) => item.slug === slug);
  return service ? [{ slug, image: serviceImages[slug], service }] : [];
});

const siteNav = [
  { href: DEMO_HOME_HREF, label: 'Home', current: true },
  { href: HERITAGE_DEMO_SERVICES_HREF, label: 'Services' },
  { href: HERITAGE_DEMO_TEAM_HREF, label: 'Barbers' },
  { href: DEMO_GALLERY_HREF, label: 'Gallery' },
  { href: DEMO_CONTACT_HREF, label: 'Contact' },
];
---

<figure class="bsw-browser" aria-label="Illustrated preview of the Heritage Grooming demo website built on KERSIVO">
  <div class="bsw-browser__toolbar">
    <span class="bsw-browser__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <a class="bsw-browser__address" href={DEMO_HOME_HREF}>
      <Lock size={11} strokeWidth={2} aria-hidden="true" />
      <span>kersivo.co.uk/demo</span>
    </a>
    <span class="bsw-browser__refresh" aria-hidden="true"><RotateCw size={12} strokeWidth={1.8} /></span>
  </div>

  <div class="bsw-site">
    <div class="bsw-site__nav">
      <a class="bsw-site__brand" href={DEMO_HOME_HREF} aria-label="Heritage Grooming demo home">
        <img
          src={HERITAGE_LOCKUP.src}
          alt=""
          width={HERITAGE_LOCKUP.width}
          height={HERITAGE_LOCKUP.height}
          loading={loading}
          decoding="async"
          draggable="false"
        />
      </a>
      <nav class="bsw-site__links" aria-label="Heritage Grooming demo pages">
        {siteNav.map((item) => (
          <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <a class="bsw-site__book" href={DEMO_BOOK_HREF}>{HERITAGE_MOCK_BOOK_LABEL}</a>
    </div>

    <div class="bsw-site__hero">
      <picture class="bsw-site__photo">
        <source media="(max-width: 640px)" srcset={`${IMG}/chair-960.webp`} />
        <img
          src={compact ? `${IMG}/chair-960.webp` : `${IMG}/chairs-1600.webp`}
          alt={compact ? HERITAGE_MOCK_PHOTOS.chair.alt : HERITAGE_MOCK_PHOTOS.chairs.alt}
          width={compact ? HERITAGE_MOCK_PHOTOS.chair.width : 1600}
          height={compact ? HERITAGE_MOCK_PHOTOS.chair.height : 893}
          loading={loading}
          fetchpriority={fetchPriority}
          decoding="async"
        />
      </picture>
      <div class="bsw-site__copy">
        <p class="bsw-site__eyebrow">{HERITAGE_MOCK_EYEBROW}</p>
        <p class="bsw-site__headline">{HERITAGE_MOCK_TITLE.lead}<br /><em class="bsw-accent">{HERITAGE_MOCK_TITLE.em}</em></p>
        <p class="bsw-site__lead">{HERITAGE_MOCK_LEDE}</p>
        <a class="bsw-site__cta" href={DEMO_BOOK_HREF}>
          {HERITAGE_MOCK_BOOK_LABEL} <ArrowRight size={13} strokeWidth={2} aria-hidden="true" />
        </a>
      </div>
    </div>

    {!compact && (
    <ul class="bsw-site__services" role="list">
      {serviceCards.map((card) => (
        <li>
          {/* Full load: the demo has its own layout, fonts and router. */}
          <a
            class="bsw-service"
            href={demoBookingHref(card.slug)}
            data-astro-reload
            aria-label={`Book ${card.service.name} in the Heritage Grooming demo`}
          >
            <img src={card.image} alt="" width="400" height="300" loading="lazy" decoding="async" />
            <span class="bsw-service__text">
              <span class="bsw-service__name">{card.service.shortName ?? card.service.name}</span>
              <span class="bsw-service__meta">
                <span class="bsw-service__price">From {formatDemoPriceGbp(card.service.pricePence)}</span>
                <span class="bsw-service__book">
                  Book in demo
                  <ArrowRight className="bsw-service__arrow" size={13} strokeWidth={1.8} aria-hidden="true" />
                </span>
                <ArrowRight className="bsw-service__arrow bsw-service__arrow--touch" size={13} strokeWidth={1.8} aria-hidden="true" />
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    )}
  </div>
</figure>
