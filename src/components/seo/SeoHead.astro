---
import { getGoogleSiteVerification, resolvePageSeo, type PageSeo } from '@/lib/seo/meta';
import { SITE_NAME } from '@/lib/seo/defaults';

interface Props extends PageSeo {}

const seo = resolvePageSeo(Astro.props);
const gscVerification = getGoogleSiteVerification();
---

<meta name="description" content={seo.description} />
<link rel="canonical" href={seo.canonical} />
<link rel="alternate" hreflang="en-GB" href={seo.canonical} />
<link rel="alternate" hreflang="x-default" href={seo.canonical} />
{seo.robotsContent ? <meta name="robots" content={seo.robotsContent} /> : null}

<meta property="og:type" content={seo.ogType} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:image" content={seo.ogImage} />
<meta property="og:image:width" content={String(seo.ogImageWidth)} />
<meta property="og:image:height" content={String(seo.ogImageHeight)} />
<meta property="og:image:alt" content={seo.ogImageAlt} />
<meta property="og:locale" content="en_GB" />
<meta property="og:site_name" content={SITE_NAME} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.ogImage} />
<meta name="twitter:image:alt" content={seo.ogImageAlt} />
{seo.twitterHandle ? <meta name="twitter:site" content={seo.twitterHandle} /> : null}

{gscVerification ? (
  <meta name="google-site-verification" content={gscVerification} />
) : null}
