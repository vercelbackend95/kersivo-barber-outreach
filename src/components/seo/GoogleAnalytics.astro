---
import { CONSENT_COOKIE_NAME, CONSENT_VERSION } from '@/lib/consent/config';

interface Props {
  /** Sent as a GA4 event parameter — register `site_section` as a custom dimension to report on it. */
  siteSection?: string;
}

const { siteSection = '' } = Astro.props;

/** Empty when unset — Basic Consent Mode will not load GA4 without an explicit public ID. */
const gaMeasurementId = (
  import.meta.env.PUBLIC_GA4_MEASUREMENT_ID ??
  process.env.PUBLIC_GA4_MEASUREMENT_ID ??
  ''
)
  .toString()
  .trim();

const googleAdsId = (
  import.meta.env.PUBLIC_GOOGLE_ADS_ID ??
  process.env.PUBLIC_GOOGLE_ADS_ID ??
  ''
)
  .toString()
  .trim();

const gaSiteSection = siteSection.trim();
---

{/* Consent Mode v2 defaults must run before any Google tag. Basic mode: do not load gtag.js until consent. */}
<script
  is:inline
  define:vars={{
    gaMeasurementId,
    googleAdsId,
    gaSiteSection,
    consentCookieName: CONSENT_COOKIE_NAME,
    consentVersion: CONSENT_VERSION,
  }}
>
  (function () {
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    window.gtag = window.gtag || gtag;

    gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      wait_for_update: 500,
    });
    window.__kersivoConsentDefaultsApplied = true;

    function readPrefs() {
      try {
        var parts = document.cookie.split(';');
        for (var i = 0; i < parts.length; i++) {
          var part = parts[i].trim();
          if (part.indexOf(consentCookieName + '=') === 0) {
            var raw = decodeURIComponent(part.slice(consentCookieName.length + 1));
            var parsed = JSON.parse(raw);
            if (
              parsed &&
              parsed.version === consentVersion &&
              parsed.necessary === true &&
              typeof parsed.analytics === 'boolean' &&
              typeof parsed.advertisingMeasurement === 'boolean' &&
              typeof parsed.personalisedAdvertising === 'boolean'
            ) {
              return parsed;
            }
          }
        }
      } catch (e) {}
      return null;
    }

    function loadScript(id, onload) {
      if (window.__kersivoGtagScriptLoaded) {
        onload();
        return;
      }
      if (document.querySelector('script[data-kersivo-gtag="1"]')) {
        window.__kersivoGtagScriptLoaded = true;
        onload();
        return;
      }
      var script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
      script.setAttribute('data-kersivo-gtag', '1');
      script.onload = function () {
        window.__kersivoGtagScriptLoaded = true;
        onload();
      };
      document.head.appendChild(script);
    }

    function readInternalCookie() {
      var parts = document.cookie.split(';');
      for (var i = 0; i < parts.length; i++) {
        var part = parts[i].trim();
        if (part.indexOf('kersivo_internal=') === 0) {
          return decodeURIComponent(part.slice('kersivo_internal='.length));
        }
      }
      return '';
    }

    function writeInternalCookie(maxAge) {
      var value = maxAge > 0 ? '1' : '';
      var secure = location.protocol === 'https:' ? '; Secure' : '';
      document.cookie =
        'kersivo_internal=' +
        value +
        '; Path=/; Max-Age=' +
        maxAge +
        '; SameSite=Lax' +
        secure;
    }

    try {
      var internalUrl = new URL(window.location.href);
      var internalFlag = internalUrl.searchParams.get('internal');
      if (internalFlag === '1' || internalFlag === '0') {
        writeInternalCookie(internalFlag === '1' ? 60 * 60 * 24 * 365 : 0);
        internalUrl.searchParams.delete('internal');
        history.replaceState(
          history.state,
          '',
          internalUrl.pathname + internalUrl.search + internalUrl.hash,
        );
      }
    } catch (e) {}

    function gaConfig(extra) {
      var cfg = { anonymize_ip: true };
      if (gaSiteSection) cfg.site_section = gaSiteSection;
      if (readInternalCookie() === '1') cfg.traffic_type = 'internal';
      if (extra) {
        for (var key in extra) cfg[key] = extra[key];
      }
      return cfg;
    }

    function syncTags(prefs) {
      // Capability-aware effective Ads consent: empty googleAdsId => Ads denied
      // even if the stored cookie still has advertisingMeasurement /
      // personalisedAdvertising true (dormant-mode fail-closed).
      var adsCapabilityEnabled = Boolean(googleAdsId);
      var effectiveAdsMeasurement =
        adsCapabilityEnabled && prefs.advertisingMeasurement;
      var effectivePersonalisedAdvertising =
        adsCapabilityEnabled && prefs.personalisedAdvertising;
      var adsGranted = effectiveAdsMeasurement || effectivePersonalisedAdvertising;
      var wantAnalytics = prefs.analytics && gaMeasurementId;
      var wantAds = adsGranted && googleAdsId;
      if (!wantAnalytics && !wantAds) return;

      gtag('consent', 'update', {
        analytics_storage: prefs.analytics ? 'granted' : 'denied',
        ad_storage: adsGranted ? 'granted' : 'denied',
        ad_user_data: adsGranted ? 'granted' : 'denied',
        ad_personalization: effectivePersonalisedAdvertising ? 'granted' : 'denied',
      });

      var primaryId = wantAnalytics ? gaMeasurementId : googleAdsId;
      loadScript(primaryId, function () {
        gtag('js', new Date());
        if (wantAnalytics) {
          gtag('config', gaMeasurementId, gaConfig());
          window.__kersivoGa4Configured = true;
        }
        if (wantAds && !window.__kersivoAdsConfigured) {
          gtag('config', googleAdsId);
          window.__kersivoAdsConfigured = true;
        }
      });
    }

    function trackSpaPageView() {
      if (!gaSiteSection || typeof gtag !== 'function' || !gaMeasurementId) return;
      var prefs = readPrefs();
      if (!prefs || !prefs.analytics) return;
      gtag('config', gaMeasurementId, gaConfig({
        page_path: window.location.pathname + window.location.search,
        page_title: document.title,
      }));
    }

    var spaPageLoadSeen = false;
    document.addEventListener('astro:page-load', function () {
      if (!spaPageLoadSeen) {
        spaPageLoadSeen = true;
        return;
      }
      trackSpaPageView();
    });

    window.__kersivoTagIds = {
      gaMeasurementId: gaMeasurementId,
      googleAdsId: googleAdsId,
    };

    var existing = readPrefs();
    if (existing) {
      syncTags(existing);
    }
  })();
</script>
