---
import { offer } from '@/content/offer';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import {
  FREE_PREVIEW_CTA_HREF,
  FREE_PREVIEW_CTA_LABEL,
  FREE_PREVIEW_CTA_TRACK,
  SUBSCRIBE_NOW_CTA_HREF,
  SUBSCRIBE_NOW_CTA_LABEL,
  SUBSCRIBE_NOW_CTA_TRACK,
} from '@/lib/freePreview/fullPlanCta';
import { STRIPE_FEES_NOTE } from '@/lib/pricing/claimsPolicy';

const freePreview = isFreePreviewFlowEnabled();
const placement = 'homepage_final';
---

<section class="hv2-section hv2-final" aria-labelledby="hv2-final-title">
  <div class="hv2-shell">
    <span class="hv2-glyph hv2-glyph--band" aria-hidden="true" data-hv2-glyph="YOUR SHOP." style="--hv2-glyph-chars: 10"></span>
    <div class="hv2-final__card hv2-card" data-hv2-reveal>
      <p class="hv2-eyebrow">Ready when you are</p>
      <h2 id="hv2-final-title" class="hv2-h2 hv2-final__title">Put your shop’s name on every booking</h2>
      <p class="hv2-lead hv2-final__text">
        Your branded barbershop website, domain, online bookings, clients and retail in one place for {offer.price.full} per location. We prepare your setup and you approve it before it goes live.
      </p>
      <div class="hv2-final__actions">
        {freePreview ? (
          <a href={FREE_PREVIEW_CTA_HREF} class="btn btn--primary btn--lg hv2-btn hv2-btn--primary" data-track={FREE_PREVIEW_CTA_TRACK} data-track-placement={placement} data-hv2-magnetic>
            {FREE_PREVIEW_CTA_LABEL}
          </a>
        ) : (
          <a href="/admin/launch" class="btn btn--primary btn--lg hv2-btn hv2-btn--primary" data-track="saas_subscribe_click" data-track-placement={placement} data-hv2-magnetic>
            Start Full KERSIVO — {offer.price.full}
          </a>
        )}
        {freePreview ? (
          <a href={SUBSCRIBE_NOW_CTA_HREF} class="hv2-final__link" data-track={SUBSCRIBE_NOW_CTA_TRACK} data-track-placement={placement}>
            {SUBSCRIBE_NOW_CTA_LABEL}
          </a>
        ) : null}
      </div>
      <a href="/starter" class="hv2-final__link" data-track="starter_plan_explore_click" data-track-placement={placement}>
        Only need online bookings? Start on KERSIVO Starter (£0/month)
      </a>
      <p class="hv2-final__small">{offer.fees.commission}. {STRIPE_FEES_NOTE}</p>
      <ul class="hv2-final__terms" role="list">
        <li><span>Price</span>{offer.price.full} per location</li>
        <li><span>Setup</span>{offer.fees.setup}</li>
        <li><span>VAT</span>No VAT added</li>
        <li><span>Commission</span>{offer.fees.commission}, Stripe fees apply</li>
        <li><span>Billing</span>Monthly, cancel anytime</li>
      </ul>
    </div>
  </div>
</section>
