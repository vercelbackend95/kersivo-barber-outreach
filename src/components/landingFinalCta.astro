---
import FullPlanCta from '@/components/cta/FullPlanCta.astro';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import '../styles/components/landingFinalCta.css';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props as Props;
const monthlyPriceLabel = `£${SAAS_MONTHLY_GBP}/month`;
---

<section
  class={`landing-final-cta ${className}`.trim()}
  aria-labelledby="landing-final-cta-title"
>
  <div class="container">
    <div class="landing-final-cta__panel">
      <div class="landing-final-cta__content">
        <p class="landing-final-cta__eyebrow">READY WHEN YOU ARE</p>

        <h2 id="landing-final-cta-title" class="landing-final-cta__heading">
          Your barbershop deserves its own brand, bookings and website.
        </h2>

        <p class="landing-final-cta__subheadline">
          Full KERSIVO brings your branded website, domain, online bookings, clients and retail
          into one platform for {monthlyPriceLabel} per location. We prepare your setup and
          you approve it before it goes live.
        </p>
      </div>

      <div class="landing-final-cta__conversion">
        {isFreePreviewFlowEnabled() ? (
          <FullPlanCta
            primaryClass="btn btn--primary btn--lg landing-final-cta__button"
            placement="homepage_final"
          />
        ) : (
        <a
          href="/admin/launch"
          class="btn btn--primary btn--lg landing-final-cta__button"
          data-track="saas_subscribe_click"
          data-track-placement="homepage_final"
        >
          Start Full KERSIVO — {monthlyPriceLabel}
        </a>
        )}

        <p class="landing-final-cta__reassurance">
          0% KERSIVO commission. Standard Stripe processing fees apply to online card payments.
        </p>
        <p class="landing-final-cta__starter">
          <a href="/starter" data-track="starter_plan_explore_click" data-track-placement="homepage_final">
            Only need online bookings? Start on KERSIVO Starter (£0/month) →
          </a>
        </p>
      </div>
    </div>
  </div>
</section>
