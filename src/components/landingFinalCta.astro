---
import {
  INCLUDED_SETUP_SHORT,
  NO_SETUP_FEE_SHORT,
  OWNER_SELF_CONFIG_SHORT,
} from '@/lib/pricing/claimsPolicy';
import '../styles/components/landingFinalCta.css';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props as Props;
---

<section
  class={`landing-final-cta ${className}`.trim()}
  aria-labelledby="landing-final-cta-title"
>
  <div class="container">
    <div class="landing-final-cta__panel">
      <div class="landing-final-cta__content">
        <h2 id="landing-final-cta-title" class="landing-final-cta__heading">
          Ready to run bookings on your own domain?
        </h2>
        <p class="landing-final-cta__subheadline">
          Start your £39/month subscription (one physical location). {NO_SETUP_FEE_SHORT}
          {INCLUDED_SETUP_SHORT} {OWNER_SELF_CONFIG_SHORT}
        </p>
      </div>

      <div class="landing-final-cta__actions">
        <a href="#pricing" class="btn btn--primary btn--lg" data-track="plan_my_setup_click">Get started</a>
        <button type="button" class="btn btn--secondary btn--lg" data-system-chooser-open data-track="view_live_demo_click">
          View Live Demo
        </button>
      </div>

      <p class="landing-final-cta__note">
        Questions first? Email <a href="mailto:hello@kersivo.co.uk">hello@kersivo.co.uk</a>
      </p>
    </div>
  </div>
</section>
