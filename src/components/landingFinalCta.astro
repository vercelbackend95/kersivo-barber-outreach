---
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import '../styles/components/landingFinalCta.css';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props as Props;
const monthlyPriceLabel = `£${SAAS_MONTHLY_GBP}/month`;
---

<section
  class={`landing-final-cta ${className}`.trim()}
  aria-labelledby="landing-final-cta-title"
>
  <div class="container">
    <div class="landing-final-cta__panel">
      <div class="landing-final-cta__content">
        <p class="landing-final-cta__eyebrow">READY WHEN YOU ARE</p>

        <h2 id="landing-final-cta-title" class="landing-final-cta__heading">
          Start with the booking system. Build the full brand when you’re ready.
        </h2>

        <p class="landing-final-cta__subheadline">
          KERSIVO Starter gives your shop the core booking operation for £0/month. Upgrade to Full
          KERSIVO for {monthlyPriceLabel} per location when you want your own branded website,
          domain and wider business toolkit.
        </p>
      </div>

      <div class="landing-final-cta__conversion">
        <a
          href="/admin"
          class="btn btn--primary btn--lg landing-final-cta__button"
          data-track="starter_signup_click"
          data-track-placement="homepage_final"
        >
          Start KERSIVO Starter — £0/month
        </a>

        <p class="landing-final-cta__reassurance">
          0% KERSIVO commission. Standard Stripe processing fees apply to online card payments.
        </p>
      </div>
    </div>
  </div>
</section>
