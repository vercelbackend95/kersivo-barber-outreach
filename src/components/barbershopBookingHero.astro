---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props as Props;

const HERO_H1_LINES_DESKTOP = [
  'Barbershop Booking System ',
  'Built On Your Own Domain',
] as const;

const HERO_H1_LINES_MOBILE = [
  'Barbershop Booking ',
  'System Built ',
  'On Your Own Domain',
] as const;

const HERO_H1_ACCESSIBLE_LABEL = 'Barbershop Booking System Built On Your Own Domain';

const PHONE_FRAME_WIDTH = 543;
const PHONE_FRAME_HEIGHT = 1106;
const MOCK_SCREEN_WIDTH = 1179;
const MOCK_SCREEN_HEIGHT = 2556;

const LINE_CLASS = 'block pb-[0.14em]';
const HEADING_LINE_CLASS = 'hero227-heading-reveal hero227-heading-reveal--landing items-center text-center';

const SCISSORS_PATH_D =
  'M3.5 3.5c-.614-.884-.074-1.962.858-2.5L8 7.226 11.642 1c.932.538 1.472 1.616.858 2.5L8.81 8.61l1.556 2.661a2.5 2.5 0 1 1-.794.637L8 9.73l-1.572 2.177a2.5 2.5 0 1 1-.794-.637L7.19 8.61zm2.5 10a1.5 1.5 0 1 0-3 0 1.5 1.5 0 0 0 3 0m7 0a1.5 1.5 0 1 0-3 0 1.5 1.5 0 0 0 3 0';
---

<section
  id="hero"
  data-hero227=""
  class:list={[
    'hero227-root hero227-root--landing scroll-mt-24 bg-background pb-0 pt-8 md:pt-12 lg:pt-[2.65rem]',
    className,
  ]}
  style="--font-antonio: Antonio;"
>
  <div>
    <div class="hero227-inner hero227-stack hero227-landing-grid flex flex-col items-center justify-center gap-4 text-center">
      <div class="hero227-landing-copy flex w-full flex-col items-center gap-4">
        <div class="hero227-copy-layer w-full max-w-4xl md:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl px-2 sm:px-3">
          <p class="hero227-kicker">Built for independent UK barbershops</p>
          <div class="hero227-heading-wrap relative w-full min-w-0 max-w-full">
            <h1
              aria-label={HERO_H1_ACCESSIBLE_LABEL}
              class="hero227-heading--landing font-antonio block w-full max-w-full font-extrabold tracking-tight text-foreground text-balance hyphens-none px-1 sm:px-0 text-[clamp(2.35rem,10vw,3.75rem)] sm:text-[clamp(2.25rem,7.5vw,3.75rem)] md:text-[clamp(2.5rem,calc(0.65rem+5.5cqi),4.25rem)] lg:text-[clamp(2.75rem,calc(0.7rem+5cqi),4.75rem)] leading-[1.18] md:leading-[1.15]"
            >
              <span class:list={[HEADING_LINE_CLASS, 'md:hidden']}>
                {HERO_H1_LINES_MOBILE.map((line) => (
                  <span class={LINE_CLASS}>{line}</span>
                ))}
              </span>
              <span class:list={[HEADING_LINE_CLASS, 'hidden md:block']}>
                {HERO_H1_LINES_DESKTOP.map((line) => (
                  <span class={LINE_CLASS}>{line}</span>
                ))}
              </span>
            </h1>
            <svg
              class="hero227-scissors-accent pointer-events-none absolute -top-2 right-2 size-6 sm:size-7 md:size-8 lg:top-0 lg:right-4 lg:size-10 shrink-0"
              viewBox="0 0 16 16"
              xmlns="http://www.w3.org/2000/svg"
              fill="#dc2626"
              aria-hidden="true"
            >
              <path d={SCISSORS_PATH_D} />
            </svg>
          </div>
          <p class="mx-auto mt-1 max-w-2xl md:max-w-3xl text-pretty text-sm leading-relaxed text-muted-foreground/85 sm:text-base sm:leading-relaxed">
            Your branded website, online bookings, deposits, client management and
            retail pickup &mdash; all in one simple &pound;39 monthly plan.
          </p>
        </div>

        <div class="hero227-mid-band w-full max-w-3xl space-y-3 px-1 sm:px-2">
          <p class="hero227-price-line">
            &pound;39/month. No setup fee. Cancel anytime.
          </p>
          <div class="hero227-cta-pill flex flex-wrap items-center justify-center gap-3">
            <a
              href="/admin/launch"
              data-track="saas_subscribe_click"
              class="hero227-cta-system text-md inline-flex h-full items-center justify-center rounded-2xl font-medium bg-primary px-4 py-2 min-h-[2.75rem]"
            >
              Get started — £39/month
            </a>
            <a
              href="/demo"
              class="hero227-cta-demo text-md inline-flex items-center justify-center rounded-2xl font-medium border border-input bg-background px-4 py-2 min-h-[2.75rem]"
              data-track="view_live_demo_click"
            >
              See KERSIVO in action
            </a>
          </div>
          <p class="hero227-trust-line hero227-trust-line--landing" role="list">
            <span class="hero227-trust-line__item" role="listitem">Your domain</span>
            <span class="hero227-trust-line__sep" aria-hidden="true">·</span>
            <span class="hero227-trust-line__item" role="listitem">Your clients</span>
            <span class="hero227-trust-line__sep" aria-hidden="true">·</span>
            <span class="hero227-trust-line__item" role="listitem">Booking + retail</span>
            <span class="hero227-trust-line__sep" aria-hidden="true">·</span>
            <span class="hero227-trust-line__item" role="listitem">0% KERSIVO commission</span>
          </p>
        </div>
      </div>

      <div class="hero227-mock-stack relative flex w-full shrink-0 items-center justify-center overflow-visible py-8 md:py-10">
        <div class="hero227-mock-clip shrink-0">
          <div class="hero227-mock relative mx-auto flex shrink-0 items-center justify-center">
            <div class="hero227-mock-screen-wrap">
              <img
                class="hero227-mock-screen"
                src="/images/hero/iphonemockup.webp"
                alt="KERSIVO booking preview on an iPhone screen"
                width={MOCK_SCREEN_WIDTH}
                height={MOCK_SCREEN_HEIGHT}
                decoding="async"
              />
            </div>
            <img
              class="hero227-mock-frame"
              alt=""
              src="/images/hero/phone-5.webp"
              width={PHONE_FRAME_WIDTH}
              height={PHONE_FRAME_HEIGHT}
              fetchpriority="high"
              decoding="sync"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
