---
interface Props {
  page: 'index' | 'article' | 'category';
  category?: string;
  categoryHref?: string;
  dateLabel?: string;
  /** e.g. "Updated 28 October 2026"; omitted when the article has no later revision. */
  updatedLabel?: string;
  currentLabel?: string;
}
const { page, category, categoryHref, dateLabel, updatedLabel, currentLabel = 'Article' } = Astro.props;
---
<header class="insights-masthead">
  <div class="insights-shell">
    <nav class="insights-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">KERSIVO</a>
      <span aria-hidden="true">/</span>
      {page === 'article' || page === 'category' ? (
        <>
          <a href="/insights">Insights</a>
          <span aria-hidden="true">/</span>
          {page === 'article' && category && categoryHref ? (
            <>
              <a href={categoryHref}>{category}</a>
              <span aria-hidden="true">/</span>
              <span aria-current="page">{currentLabel}</span>
            </>
          ) : (
            <span aria-current="page">{currentLabel}</span>
          )}
        </>
      ) : <span aria-current="page">Insights</span>}
    </nav>
    <div class="insights-masthead__identity">
      <div class="insights-masthead__main">
        <p class="insights-eyebrow"><span class="insights-eyebrow__rule" aria-hidden="true"></span> THE BUSINESS BEHIND THE CHAIR</p>
        {page === 'index' ? (
          <h1 class="insights-masthead__name">KERSIVO <span>/</span> INSIGHTS</h1>
        ) : (
          <p class="insights-masthead__name">KERSIVO <span>/</span> INSIGHTS</p>
        )}
      </div>
      <span class="insights-masthead__edition">UK BARBERSHOP INTELLIGENCE</span>
    </div>
    <div class="insights-masthead__divider"></div>
    {page === 'article' ? (
      <div class="insights-article-meta">
        {categoryHref && category ? (
          <a class="insights-article-meta__category" href={categoryHref}>{category}</a>
        ) : (
          <span class="insights-article-meta__category">{category}</span>
        )}
        <span class="insights-article-meta__dot" aria-hidden="true"></span>
        <span>{dateLabel}</span>
        {updatedLabel && (
          <>
            <span class="insights-article-meta__dot" aria-hidden="true"></span>
            <span>{updatedLabel}</span>
          </>
        )}
      </div>
    ) : page === 'category' ? (
      <p class="insights-article-meta">Topic archive for independent UK barbershop owners.</p>
    ) : (
      <p class="insights-article-meta">Practical guides and independent thinking on running a barbershop in the UK.</p>
    )}
  </div>
</header>
