---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props as Props;
---

<section
  id="paths"
  class={`audience-picker scroll-mt-24 ${className}`.trim()}
  aria-labelledby="audience-picker-title"
>
  <div class="container">
    <div class="audience-picker__intro">
      <p class="audience-picker__eyebrow">PICK YOUR PATH</p>
      <h2 id="audience-picker-title" class="audience-picker__heading">Where are you starting from?</h2>
      <p class="audience-picker__lead">
        Two routes through the page. Same product, same price, same 0% commission either way.
      </p>
    </div>

    <div class="audience-picker__grid">
      <a
        class="audience-picker__card audience-picker__card--switcher"
        href="#switcher-path"
        aria-label="Switch — continue to switcher path"
      >
        <div class="audience-picker__stage" aria-hidden="true">
          <div class="audience-picker__blob">
            <div class="audience-picker__figure">
              <img
                class="audience-picker__image"
                src="/images/Ilustracje/switch.png"
                alt=""
                width="1536"
                height="1024"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
        <div class="audience-picker__chapter">
          <h3 class="audience-picker__card-title">Switch</h3>
          <span class="audience-picker__card-cta">
            Continue
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </span>
        </div>
      </a>

      <a
        class="audience-picker__card audience-picker__card--newcomer"
        href="#newcomer-path"
        aria-label="New shop — continue to launch path"
      >
        <div class="audience-picker__stage" aria-hidden="true">
          <div class="audience-picker__blob">
            <div class="audience-picker__figure">
              <img
                class="audience-picker__image"
                src="/images/Ilustracje/newshop.png"
                alt=""
                width="1536"
                height="1024"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
        <div class="audience-picker__chapter">
          <h3 class="audience-picker__card-title">New Shop</h3>
          <span class="audience-picker__card-cta">
            Continue
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </span>
        </div>
      </a>
    </div>
  </div>
</section>
