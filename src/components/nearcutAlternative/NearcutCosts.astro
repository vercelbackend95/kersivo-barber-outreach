---
import {
  NEARCUT_FACTS_CHECKED_DATE,
  getNearcutSource,
  requireIllustrativeNearcutFact,
  requireVerifiedNearcutFact,
} from '@/lib/seo/nearcutFacts';
import { KERSIVO_BOOKING_DEPOSIT_GBP, SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import {
  NEARCUT_COSTS_LEAD,
  NEARCUT_COSTS_TITLE,
  NEARCUT_ESTIMATOR_NOTE,
  NEARCUT_ESTIMATOR_TITLE,
} from '@/lib/seo/nearcutAlternativeContent';
import {
  NEARCUT_BOOKINGS_DEFAULT,
  NEARCUT_BOOKINGS_MAX,
  NEARCUT_BOOKINGS_MIN,
  estimateNearcutClientCharges,
  formatGbpWhole,
} from '@/lib/landing/nearcutMath';

const pricingSource = getNearcutSource('pricingUk').url;
const paymentsSource = getNearcutSource('onlinePayments').url;
const freeMonthly = requireVerifiedNearcutFact('freeForYouMonthlySubscription');
const feeExample = requireIllustrativeNearcutFact('freeForYouCustomerBookingFeeExample');
const subscriptionFee = requireVerifiedNearcutFact('subscriptionCustomerBookingFee');
const trial = requireVerifiedNearcutFact('subscriptionFreeTrialDays');
const setup = requireVerifiedNearcutFact('setupFee');
const standardPayment = requireVerifiedNearcutFact('standardOnlinePaymentProcessing');
const gbp = (amount: number) => Number.isInteger(amount) ? `£${amount}` : `£${amount.toFixed(2)}`;
const percent = (amount: number) => Number.isInteger(amount) ? `${amount}%` : `${amount.toFixed(2)}%`;
const initial = estimateNearcutClientCharges(NEARCUT_BOOKINGS_DEFAULT);
const barMax = NEARCUT_BOOKINGS_MAX * feeExample.amountGbp;

const plans = [
  {
    kicker: 'Nearcut Free for You',
    figure: gbp(freeMonthly.amountGbp!),
    unit: 'per month for the shop',
    notes: [
      'Your clients pay a customer booking charge on top of the service price.',
      `Nearcut illustrates ${gbp(feeExample.amountGbp)} on a ${gbp(feeExample.exampleServicePriceGbp)} haircut; confirm your actual charge with Nearcut.`,
      'Includes a personalised booking site and unlimited SMS reminders for online bookings.',
    ],
  },
  {
    kicker: 'Nearcut Subscription',
    figure: 'Quote',
    unit: 'per month + VAT',
    notes: [
      'Priced on your locations and barbers.',
      `No customer booking charge under Subscription (${gbp(subscriptionFee.amountGbp!)}).`,
      `A ${trial.value}-day trial and no setup fee (${gbp(setup.amountGbp!)}); Business Boosters may add cost.`,
    ],
  },
  {
    kicker: 'Full KERSIVO',
    figure: `£${SAAS_MONTHLY_GBP}`,
    unit: 'per location / month',
    notes: [
      'Branded website and your own domain included.',
      'No per-barber subscription charge, subject to fair use.',
      'Pay at shop, deposits or full payment; reports, client CRM and retail pickup.',
    ],
    ks: true,
  },
  {
    kicker: 'KERSIVO Starter',
    figure: '£0',
    unit: 'per month · up to 4 barbers',
    notes: [
      `Clients pay a £${KERSIVO_BOOKING_DEPOSIT_GBP} deposit towards the service, or pay in full.`,
      '0% KERSIVO commission; Stripe processing fees apply.',
    ],
  },
];
---

<section id="nearcut-pricing" class="nc-section nc-costs" aria-labelledby="nearcut-alt-costs-title">
  <div class="nc-wrap">
    <header class="nc-head">
      <p class="nc-eyebrow">Nearcut pricing explained</p>
      <h2 id="nearcut-alt-costs-title" class="nc-h2">{NEARCUT_COSTS_TITLE}</h2>
      <p class="nc-lead">{NEARCUT_COSTS_LEAD}</p>
      <p class="nc-small">Official Nearcut pricing checked {NEARCUT_FACTS_CHECKED_DATE} · <a href={pricingSource} target="_blank" rel="noopener noreferrer">Nearcut UK pricing</a></p>
    </header>

    <div class="nc-costs__grid">
      <ul class="nc-costs__plans">
        {plans.map((plan) => (
          <li class:list={['nc-card nc-plan', { 'nc-plan--ks': plan.ks }]}>
            <p class="nc-plan__kicker">{plan.kicker}</p>
            <p class="nc-plan__figure">{plan.figure}</p>
            <p class="nc-plan__unit">{plan.unit}</p>
            <ul class="nc-dots">{plan.notes.map((note) => <li>{note}</li>)}</ul>
          </li>
        ))}
      </ul>

      <div class="nc-card nc-est" data-nc-estimator>
        <h3 class="nc-h3">{NEARCUT_ESTIMATOR_TITLE}</h3>
        <label class="nc-est__label" for="nc-bookings">
          <span>Online bookings a month</span>
          <output for="nc-bookings" data-nc-out="bookings">{initial.bookings}</output>
        </label>
        <input
          id="nc-bookings"
          class="nc-range"
          type="range"
          min={NEARCUT_BOOKINGS_MIN}
          max={NEARCUT_BOOKINGS_MAX}
          step="10"
          value={NEARCUT_BOOKINGS_DEFAULT}
          data-nc-bookings
          style={`--fill: ${((NEARCUT_BOOKINGS_DEFAULT - NEARCUT_BOOKINGS_MIN) / (NEARCUT_BOOKINGS_MAX - NEARCUT_BOOKINGS_MIN)) * 100}%`}
        />

        <div class="nc-est__rows" aria-live="polite">
          <div class="nc-est__row">
            <p class="nc-est__name">Nearcut Free for You<span>booking charges paid by your clients</span></p>
            <p class="nc-est__value"><strong data-nc-out="monthly" data-value={initial.clientChargesMonthly}>{formatGbpWhole(initial.clientChargesMonthly)}</strong><span>a month</span></p>
            <span class="nc-est__bar" aria-hidden="true"><i data-nc-bar style={`--w: ${(initial.clientChargesMonthly / barMax) * 100}%`} data-max={barMax}></i></span>
            <p class="nc-est__sub"><span data-nc-out="yearly" data-value={initial.clientChargesYearly}>{formatGbpWhole(initial.clientChargesYearly)}</span> a year on top of your prices</p>
          </div>
          <div class="nc-est__row nc-est__row--ks">
            <p class="nc-est__name">KERSIVO<span>booking charges on your clients</span></p>
            <p class="nc-est__value"><strong>£0</strong><span>always</span></p>
            <span class="nc-est__bar" aria-hidden="true"><i style="--w: 0%"></i></span>
            <p class="nc-est__sub">Full KERSIVO stays £{SAAS_MONTHLY_GBP}/month per location, whatever the bookings</p>
          </div>
        </div>
        <p class="nc-small">{NEARCUT_ESTIMATOR_NOTE}</p>
      </div>
    </div>

    <p class="nc-body nc-costs__note">Nearcut’s Free for You pricing page advertises optional online payments and deposits with zero transaction fees. Its separate <a href={paymentsSource} target="_blank" rel="noopener noreferrer">online payments guide</a> lists standard processing rates from {percent(standardPayment.percent!)} + {gbp(standardPayment.amountGbp!)}, falling at higher monthly volumes. Ask Nearcut which terms apply to your plan. The client booking charge is not a commission on the haircut. On KERSIVO, the £{KERSIVO_BOOKING_DEPOSIT_GBP} deposit counts towards the service; it is not an extra KERSIVO charge, and Stripe processing fees still apply.</p>
  </div>
</section>
