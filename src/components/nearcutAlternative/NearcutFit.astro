---
import { NEARCUT_FIT, NEARCUT_FIT_CLOSING } from '@/lib/seo/nearcutAlternativeContent';
---

<section id="which-model" class="nc-section nc-fit" aria-labelledby="nearcut-alt-fit-title">
  <div class="nc-wrap">
    <header class="nc-head">
      <p class="nc-eyebrow">An honest fit check</p>
      <h2 id="nearcut-alt-fit-title" class="nc-h2">Which one fits your shop?</h2>
    </header>
    <div class="nc-fit__grid">
      <div class="nc-card nc-fit__col">
        <h3 class="nc-h3">{NEARCUT_FIT.nearcut.heading}</h3>
        <ul class="nc-dots">{NEARCUT_FIT.nearcut.points.map((point) => <li>{point}</li>)}</ul>
      </div>
      <div class="nc-card nc-fit__col nc-fit__col--ks">
        <h3 class="nc-h3">{NEARCUT_FIT.kersivo.heading}</h3>
        <ul class="nc-ticks">{NEARCUT_FIT.kersivo.points.map((point) => <li>{point}</li>)}</ul>
        <a class="nc-text-link" href="/pricing#plan" data-track="view_pricing_click" data-track-placement="nearcut_fit">See Full KERSIVO pricing <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <p class="nc-body nc-fit__closing">{NEARCUT_FIT_CLOSING}</p>
    <nav class="nc-fit__others" aria-label="Other comparisons">
      <span class="nc-small">Also comparing other software?</span>
      <ul>
        <li><a class="nc-pill" href="/booksy-alternative">Booksy comparison <span aria-hidden="true">→</span></a></li>
        <li><a class="nc-pill" href="/fresha-alternative">Fresha comparison <span aria-hidden="true">→</span></a></li>
        <li><a class="nc-pill" href="/square-appointments-alternative">Square Appointments alternative <span aria-hidden="true">→</span></a></li>
        <li><a class="nc-pill" href="/squire-alternative">Compare KERSIVO and SQUIRE <span aria-hidden="true">→</span></a></li>
        <li><a class="nc-pill" href="/phorest-alternative">Phorest alternative <span aria-hidden="true">→</span></a></li>
        <li><a class="nc-pill" href="/vagaro-alternative">Vagaro alternative <span aria-hidden="true">→</span></a></li>
        <li><a class="nc-pill" href="/treatwell-alternative">Treatwell alternative <span aria-hidden="true">→</span></a></li>
        <li><a class="nc-pill" href="/setora-alternative">Setora comparison <span aria-hidden="true">→</span></a></li>
        <li><a class="nc-pill" href="/timely-alternative">Timely alternative UK <span aria-hidden="true">→</span></a></li>
      </ul>
    </nav>
  </div>
</section>
