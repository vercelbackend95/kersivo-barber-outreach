---
import ComparisonHeroActions from '@/components/comparison/ComparisonHeroActions.astro';
import NearcutSiteMock from './NearcutSiteMock.astro';
import {
  NEARCUT_HERO_FACTS,
  NEARCUT_HERO_KICKER,
  NEARCUT_HERO_LEAD,
  NEARCUT_HERO_SLIDER_LABEL,
  NEARCUT_HERO_TITLE_LINES,
} from '@/lib/seo/nearcutAlternativeContent';

const plainServices = [
  ['Haircut', '£20'],
  ['Skin fade', '£26'],
  ['Beard trim', '£15'],
  ['Cut & beard', '£34'],
  ['Kids cut', '£15'],
];
---

<section class="nc-hero" aria-labelledby="nearcut-alt-hero-title">
  <div class="nc-wrap nc-hero__grid">
    <div class="nc-hero__copy">
      <nav class="nc-breadcrumb nc-enter" style="--i: 0" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Nearcut alternative</span>
      </nav>

      <h1 id="nearcut-alt-hero-title" class="nc-hero__title">
        <span class="nc-eyebrow nc-hero__kicker nc-enter" style="--i: 1">{NEARCUT_HERO_KICKER}</span>
        {NEARCUT_HERO_TITLE_LINES.map((line, index) => (
          <span class="nc-hero__line nc-enter" style={`--i: ${index + 2}`}>{line}{index === NEARCUT_HERO_TITLE_LINES.length - 1 && <span class="nc-hero__stop">.</span>}</span>
        ))}
      </h1>

      <p class="nc-hero__lead nc-enter" style="--i: 4">{NEARCUT_HERO_LEAD}</p>

      <div class="nc-enter" style="--i: 5">
        <ComparisonHeroActions placement="nearcut" />
      </div>

      <ul class="nc-hero__facts nc-enter" style="--i: 6" aria-label="Full KERSIVO at a glance">
        {NEARCUT_HERO_FACTS.map((fact) => <li>{fact}</li>)}
      </ul>
    </div>

    <div class="nc-hero__stage nc-enter" style="--i: 3">
      <div class="nc-compare" data-nc-compare style="--pos: 50%">
        <NearcutSiteMock priority class="nc-compare__site" />

        <div class="nc-plain" aria-hidden="true">
          <div class="nc-plain__chrome"><span></span><span class="nc-plain__url">booking page</span></div>
          <div class="nc-plain__body">
            <div class="nc-plain__head">
              <span class="nc-plain__avatar">YS</span>
              <span class="nc-plain__name"><strong>Your Shop</strong><span>Select a service</span></span>
            </div>
            <ul class="nc-plain__list">
              {plainServices.map(([name, price]) => (
                <li><span><strong>{name}</strong><i></i></span><b>{price}</b><em>Book</em></li>
              ))}
            </ul>
          </div>
        </div>

        <span class="nc-compare__tag nc-compare__tag--plain" aria-hidden="true">A booking page</span>
        <span class="nc-compare__tag nc-compare__tag--site" aria-hidden="true">Your KERSIVO website</span>

        <span class="nc-compare__handle" aria-hidden="true">
          <span class="nc-compare__knob">
            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M9 6 3 12l6 6M15 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </span>

        <input
          class="nc-compare__range"
          type="range"
          min="0"
          max="100"
          value="50"
          step="1"
          aria-label={NEARCUT_HERO_SLIDER_LABEL}
          aria-valuetext="Half and half"
          data-nc-range
        />
      </div>
      <p class="nc-hero__hint" aria-hidden="true">Drag to compare</p>
    </div>
  </div>
</section>
