---
import NearcutPrimaryCta from './NearcutPrimaryCta.astro';
import {
  NEARCUT_SWITCHING_LIMITS,
  NEARCUT_SWITCHING_REASSURANCE,
  NEARCUT_SWITCHING_STEPS,
} from '@/lib/seo/nearcutAlternativeContent';
---

<section id="switching" class="nc-section nc-switch" aria-labelledby="nearcut-alt-switch-title">
  <div class="nc-wrap">
    <header class="nc-head nc-head--split">
      <div class="nc-head__main">
        <p class="nc-eyebrow">Switching from Nearcut</p>
        <h2 id="nearcut-alt-switch-title" class="nc-h2">Switch without a quiet week</h2>
      </div>
      <p class="nc-lead"><strong>{NEARCUT_SWITCHING_REASSURANCE}</strong> Your clients keep booking the way they do today until your new website is approved and live.</p>
    </header>

    <ol class="nc-switch__steps">
      {NEARCUT_SWITCHING_STEPS.map((step, index) => (
        <li class="nc-card nc-switch__step">
          <span class="nc-switch__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="nc-h3">{step.title}</h3>
          <p class="nc-body">{step.body}</p>
        </li>
      ))}
    </ol>

    <div class="nc-switch__foot">
      <ul class="nc-notes">{NEARCUT_SWITCHING_LIMITS.map((limit) => <li>{limit}</li>)}</ul>
      <NearcutPrimaryCta placement="nearcut_switching" />
    </div>
  </div>
</section>
