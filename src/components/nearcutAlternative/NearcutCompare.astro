---
import { NEARCUT_COMPARE_SECTIONS, NEARCUT_COMPARISON_FOOTNOTE } from '@/lib/seo/nearcutFacts';
---

<section id="comparison" class="nc-section nc-compare-tabs scroll-mt-24" aria-labelledby="nearcut-alt-compare-title" data-nearcut-comparison data-nc-tabs>
  <div class="nc-wrap">
    <header class="nc-head">
      <p class="nc-eyebrow">Line by line</p>
      <h2 id="nearcut-alt-compare-title" class="nc-h2">KERSIVO vs Nearcut, area by area</h2>
      <p class="nc-lead">Pick an area. Nearcut on one side, KERSIVO on the other, nothing left out.</p>
    </header>

    <div class="nc-tabs" role="tablist" aria-label="Comparison areas">
      {NEARCUT_COMPARE_SECTIONS.map((section, index) => (
        <button
          type="button"
          role="tab"
          id={`nc-tab-${section.id}`}
          class="nc-tabs__tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`nc-panel-${section.id}`}
          tabindex={index === 0 ? 0 : -1}
        >
          {section.title}
        </button>
      ))}
    </div>

    {NEARCUT_COMPARE_SECTIONS.map((section) => (
      <div
        id={`nc-panel-${section.id}`}
        class="nc-tabs__panel"
        role="tabpanel"
        aria-labelledby={`nc-tab-${section.id}`}
        tabindex="0"
      >
        <p class="nc-tabs__subtitle">{section.subtitle}</p>
        <div class="nc-tabs__cols">
          <article class="nc-card nc-tabs__col">
            <p class="nc-tabs__brand"><span>Nearcut</span></p>
            <p class="nc-tabs__lead">{section.nearcutLead}</p>
            <ul class="nc-dots">{section.nearcutPoints.map((point) => <li>{point}</li>)}</ul>
          </article>
          <article class="nc-card nc-tabs__col nc-tabs__col--ks">
            <p class="nc-tabs__brand nc-tabs__brand--ks"><span>KERSIVO</span></p>
            <p class="nc-tabs__lead">{section.kersivoLead}</p>
            <ul class="nc-ticks">{section.kersivoPoints.map((point) => <li>{point}</li>)}</ul>
          </article>
        </div>
      </div>
    ))}

    <p class="nc-small nc-compare-tabs__foot">{NEARCUT_COMPARISON_FOOTNOTE}</p>
  </div>
</section>
