---
interface Props {
  adminHref?: string;
}

const { adminHref = '/admin' } = Astro.props;
---

<div class="owner-preview-toolbar" role="region" aria-label="Private storefront preview">
  <div class="container owner-preview-toolbar__inner">
    <div class="owner-preview-toolbar__copy">
      <p class="owner-preview-toolbar__eyebrow">Private preview</p>
      <p class="owner-preview-toolbar__support">You’re viewing your shop as a customer.</p>
    </div>
    <div class="owner-preview-toolbar__actions">
      <a href={adminHref} class="btn btn--secondary btn--sm owner-preview-toolbar__admin-btn">
        Back to Admin
      </a>
    </div>
  </div>
</div>
