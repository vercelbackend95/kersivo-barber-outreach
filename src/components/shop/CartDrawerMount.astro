---
import StorefrontCartDrawer from './storefront/StorefrontCartDrawer';
import type { StorefrontCartMode, StorefrontCartThemeId } from './storefront/StorefrontCartDrawer';
import type { StorefrontPriceFormat } from '@/lib/shop/storefrontCatalog';
import type { StorefrontCheckoutConfig } from '@/lib/shop/storefrontCheckout';
import '@/styles/components/storefront-cart.css';

type Props = {
  mode: StorefrontCartMode;
  shopId: string;
  shopName: string;
  themeId: StorefrontCartThemeId;
  priceFormat?: StorefrontPriceFormat;
  exploreHref: string;
  maxQuantity?: number;
  checkout: StorefrontCheckoutConfig;
  allowedProductIds?: string[];
};

const {
  mode,
  shopId,
  shopName,
  themeId,
  priceFormat = 'gbp',
  exploreHref,
  maxQuantity,
  checkout,
  allowedProductIds,
} = Astro.props;
---

<StorefrontCartDrawer
  client:load
  mode={mode}
  shopId={shopId}
  shopName={shopName}
  themeId={themeId}
  priceFormat={priceFormat}
  exploreHref={exploreHref}
  maxQuantity={maxQuantity}
  checkout={checkout}
  allowedProductIds={allowedProductIds}
/>
