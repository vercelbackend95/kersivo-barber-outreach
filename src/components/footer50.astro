---
import {
  FOOTER_LEGAL_LINKS,
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
  type FooterSocialLink,
  type FooterSocialPlatform,
} from '@/lib/seo/footerSocialLinks';
import '../styles/components/footer50.css';

interface NavItem {
  name: string;
  href: string;
}

interface Footer50Props {
  heading?: string;
  description?: string;
  ctaText?: string;
  ctaHref?: string;
  ctaIsDemo?: boolean;
  ctaTrack?: string;
  showIntro?: boolean;
  brandLine?: string;
  contactEmail?: string;
  copyright?: string;
  navigation?: NavItem[];
  social?: FooterSocialLink[];
  legal?: NavItem[];
  brandName?: string;
  className?: string;
}

const currentYear = new Date().getFullYear();

const {
  heading = 'Ready to run bookings under your own brand?',
  description = 'A branded website, online bookings and business tools built around your barbershop.',
  ctaText = 'Start my KERSIVO subscription',
  ctaHref = '/admin/launch',
  ctaIsDemo = false,
  ctaTrack = 'saas_subscribe_click',
  showIntro = false,
  brandLine = 'Own your brand. Own your bookings.',
  contactEmail = KERSIVO_CONTACT_EMAIL,
  copyright = `© ${currentYear} KERSIVO`,
  navigation = [
    { name: 'Inside the system', href: '/#live-demo' },
    { name: 'Pricing', href: '/#pricing' },
    { name: 'FAQ', href: '/#faq' },
    { name: 'Contact', href: '/#contact' },
    { name: 'Start subscription', href: '/admin/launch' },
  ],
  social = getFooterSocialLinks(),
  legal = [
    FOOTER_LEGAL_LINKS.privacy,
    FOOTER_LEGAL_LINKS.cookies,
    FOOTER_LEGAL_LINKS.cookieSettings,
    FOOTER_LEGAL_LINKS.termsAndCancellation,
  ],
  brandName = 'KERSIVO',
  className = '',
} = Astro.props as Footer50Props;

const footerClassName = [
  'footer50',
  !showIntro && 'footer50--compact',
  className,
].filter(Boolean).join(' ');

function isExternalHref(href: string): boolean {
  return /^https?:\/\//i.test(href);
}

function isSubscribeNavItem(item: NavItem): boolean {
  return /subscription/i.test(item.name) || item.href.includes('/admin/launch');
}

function socialIconPath(id: Exclude<FooterSocialPlatform, 'instagram'>): string {
  switch (id) {
    case 'tiktok':
      return 'M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z';
    case 'facebook':
      return 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z';
  }
}
---

<footer class={footerClassName} aria-label="Footer">
  {showIntro ? (
    <div class="container footer50__intro">
      <h2>{heading}</h2>
      <p>{description}</p>
      <div>
        <a
          class="btn btn--primary footer50__cta"
          href={ctaHref}
          data-demo-cta={ctaIsDemo ? true : undefined}
          data-track={ctaTrack || undefined}
        >
          {ctaText}
        </a>
      </div>
    </div>
  ) : null}

  <div class="container footer50__main">
    <div class="footer50__identity">
      {brandLine ? <p class="footer50__brand-line">{brandLine}</p> : null}
      {contactEmail ? (
        <p class="footer50__contact">
          <span class="footer50__contact-label">Contact</span>
          <a class="footer50__email" href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </p>
      ) : null}
    </div>

    <nav class="footer50__navigation" aria-label="Footer navigation">
      <div class="footer50__group">
        <p class="footer50__group-title">Explore</p>
        <ul class="footer50__menu">
          {navigation.map((item) => (
            <li>
              <a
                class:list={[
                  'footer50__nav-link',
                  isSubscribeNavItem(item) && 'footer50__nav-link--accent',
                ]}
                href={item.href}
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer50__group">
        <p class="footer50__group-title">Legal</p>
        <ul class="footer50__legal">
          {legal.map((item) => (
            <li>
              {item.href === '#cookie-settings' ? (
                <button
                  type="button"
                  class="footer50__cookie-settings"
                  data-cookie-settings
                >
                  {item.name}
                </button>
              ) : (
                <a
                  class="footer50__nav-link"
                  href={item.href}
                  {...(isExternalHref(item.href)
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {})}
                >
                  {item.name}
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>

  <script>
    import { CONSENT_OPEN_EVENT } from '@/lib/consent/config';
    document.querySelectorAll('[data-cookie-settings]').forEach((el) => {
      el.addEventListener('click', () => {
        window.dispatchEvent(
          new CustomEvent(CONSENT_OPEN_EVENT, {
            detail: { trigger: el instanceof HTMLElement ? el : undefined },
          }),
        );
      });
    });
  </script>

  <div class="footer50__brand" aria-label={brandName}>
    <span class="footer50__brand-name">{brandName}</span>
    {social.length > 0 ? (
      <ul class="footer50__social-icons" aria-label="Social media">
        {social.map((item) => (
          <li>
            <a
              href={item.href}
              class="footer50__social-icon"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.name}
            >
              {item.id === 'instagram' ? (
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="2" />
                  <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
              ) : (
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d={socialIconPath(item.id)} />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    ) : null}
    {copyright ? <p class="footer50__copyright">{copyright}</p> : null}
  </div>
</footer>
