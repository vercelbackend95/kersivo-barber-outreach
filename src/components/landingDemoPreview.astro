---
import { blacklineAdminHref } from '@/lib/admin/demoConfig';
import { DEMO_BOOK_HREF, DEMO_SHOP_HREF } from '@/lib/demo/nav';
import { DeferredWidget } from '@/components/landing/DeferredWidget';
import Feature261MonetizationRow from '@/components/feature261/Feature261MonetizationRow.astro';
import Feature261MoreIncluded from '@/components/feature261/Feature261MoreIncluded.astro';
import '../styles/components/feature261.css';
import '../styles/components/landingDemoPreview.css';

type LandingDemoPreviewRow = {
  kicker: string;
  heading: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
  ctaSameTab?: boolean;
  ctaTrack?: string;
  media: 'carousel' | 'widget' | 'booking';
};

type PreviewIntro = {
  kicker: string;
  heading: string;
  description: string;
};

interface Props {
  className?: string;
  intro?: PreviewIntro;
  rows?: LandingDemoPreviewRow[];
  showReports?: boolean;
  showMoreIncluded?: boolean;
  showFooterNote?: boolean;
  sectionId?: string;
  headingId?: string;
}

const DEFAULT_INTRO: PreviewIntro = {
  kicker: 'INSIDE THE SYSTEM',
  heading: 'See KERSIVO barbershop management software in\u00a0action',
  description:
    'Explore the admin and client booking experience, plus the retail pickup shop and reports included with Full KERSIVO.',
};

const DEFAULT_ROWS: LandingDemoPreviewRow[] = [
  {
    kicker: 'ADMIN SYSTEM',
    heading: 'Run your day from one clear admin view',
    description:
      'Manage appointments, clients, barbers, services, working hours and daily activity from one central dashboard.',
    ctaLabel: 'Explore the admin system',
    ctaHref: blacklineAdminHref('bookings_dashboard'),
    ctaSameTab: false,
    ctaTrack: 'view_live_demo_click',
    media: 'widget',
  },
  {
    kicker: 'ONLINE BOOKING FOR BARBERS',
    heading: 'Service, barber, time — not an app.',
    description:
      'Clients choose a service, barber and available time through a booking experience built around your barbershop — with no app download. Full KERSIVO adds your own branded website and domain.',
    ctaLabel: 'Try the booking experience',
    ctaHref: DEMO_BOOK_HREF,
    ctaSameTab: false,
    ctaTrack: 'view_live_demo_click',
    media: 'booking',
  },
  {
    kicker: 'RETAIL PICKUP SHOP',
    heading: 'Sell retail through your own website',
    description:
      'Let clients browse products online, place pickup orders and collect them from your barbershop.',
    ctaLabel: 'Explore the retail shop',
    ctaHref: DEMO_SHOP_HREF,
    ctaSameTab: false,
    ctaTrack: 'view_live_demo_click',
    media: 'carousel',
  },
];

const {
  className = '',
  intro = DEFAULT_INTRO,
  rows = DEFAULT_ROWS,
  showReports = true,
  showMoreIncluded = true,
  showFooterNote = true,
  sectionId = 'live-demo',
  headingId = 'landing-demo-preview-title',
} = Astro.props as Props;
---

<section
  id={sectionId}
  class={`feature261 landing-demo-preview landing-demo-preview--compact ${className}`.trim()}
  aria-labelledby={headingId}
>
  <div class="feature261__glow" aria-hidden="true"></div>
  <div class="container">
    <header class="feature261__intro">
      <p class="ks-eyebrow">{intro.kicker}</p>
      <h2 id={headingId} class="feature261__heading">
        {intro.heading}
      </h2>
      <p class="feature261__description">
        {intro.description}
      </p>
    </header>

    <ul class="feature261__rows" role="list">
      {rows.map((row, index) => (
        <li
          data-feature261-card
          class:list={['feature261__row', index % 2 === 0 && 'feature261__row--reverse']}
        >
          {row.media === 'carousel' ? (
            <div class="feature261__media feature261__media--carousel">
              <div class="sf-shop sf-shop--blackline" data-sf-theme="blackline">
                <DeferredWidget client:visible={{ rootMargin: '200px' }} kind="retail" />
              </div>
              <p class="landing-demo-still__caption">CUTSTATE is a fictional demonstration shop.</p>
            </div>
          ) : row.media === 'widget' ? (
            <div class="feature261__media feature261__media--widget">
              <DeferredWidget client:visible={{ rootMargin: '200px' }} kind="admin" />
              <p class="landing-demo-still__caption">CUTSTATE is a fictional demonstration shop.</p>
            </div>
          ) : (
            <div class="feature261__media feature261__media--widget">
              <DeferredWidget client:visible={{ rootMargin: '200px' }} kind="booking" />
              <p class="landing-demo-still__caption">CUTSTATE is a fictional demonstration shop.</p>
            </div>
          )}

          <div class="feature261__copy">
            <p class="feature261__row-kicker">{row.kicker}</p>
            <h3 class="feature261__row-heading">{row.heading}</h3>
            <p class="feature261__row-body">{row.description}</p>
          </div>

          <a
            href={row.ctaHref}
            class="btn btn--ghost feature261__row-cta feature261__row-cta--ghost"
            target={row.ctaSameTab ? undefined : '_blank'}
            rel={row.ctaSameTab ? undefined : 'noopener noreferrer'}
            data-track={row.ctaTrack}
          >
            {row.ctaLabel}
          </a>
        </li>
      ))}
      {showReports ? <Feature261MonetizationRow /> : null}
    </ul>
    {showMoreIncluded ? <Feature261MoreIncluded /> : null}

    {showFooterNote ? (
      <div class="landing-demo-preview__footer">
        <p class="landing-demo-preview__footer-note">
          CUTSTATE is a fictional demonstration shop. Open the demo to click around — no sign-up needed.
        </p>
      </div>
    ) : null}
  </div>
</section>
