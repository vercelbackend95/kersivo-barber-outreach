---
import { ShopProductCarousel } from '@/components/shop/ShopProductCarousel';
import { InsideSystemLiveWidget } from '@/components/InsideSystemLiveWidget';
import { LandingBookingWidget } from '@/components/LandingBookingWidget';
import type { CarouselProduct } from '@/lib/shop/carouselProducts';
import type { LandingBarber } from '@/lib/landing/liveTimelineData';
import type { LandingBookingData } from '@/lib/landing/landingBookingData';
import { getLandingDemoBookingFallback } from '@/lib/landing/landingDemoBookingFallback';
import {
  getLandingDemoPreviewConfig,
  type LandingDemoPreviewVariant,
} from '@/lib/landing/landingDemoPreviewConfig';
import { Feature261MonetizationRow } from '@/components/feature261/Feature261MonetizationRow';
import { Feature261MoreIncluded } from '@/components/feature261/Feature261MoreIncluded';
import '../styles/components/feature261.css';
import '../styles/components/landingDemoPreview.css';
import '../styles/components/shopProductCards6.css';

interface Props {
  className?: string;
  variant?: LandingDemoPreviewVariant;
  retailProducts?: CarouselProduct[];
  barbers?: LandingBarber[];
  bookingData?: LandingBookingData;
}

const {
  className = '',
  variant = 'landing',
  retailProducts = [],
  barbers = [],
  bookingData,
} = Astro.props as Props;

const resolvedBookingData = bookingData ?? getLandingDemoBookingFallback();
const config = getLandingDemoPreviewConfig(variant);
const { intro, rows } = config;
---

<section
  id={config.sectionId}
  class={`feature261 landing-demo-preview landing-demo-preview--compact ${config.sectionClassExtra} ${className}`.trim()}
  aria-labelledby={config.ariaLabelledBy}
>
  <div class="feature261__glow" aria-hidden="true"></div>
  <div class="container">
    <header class="feature261__intro">
      <p class="feature261__kicker">{intro.kicker}</p>
      <h2 id={config.headingId} class="feature261__heading">
        {intro.heading}
      </h2>
      <p class="feature261__description">
        {intro.description}
      </p>
    </header>

    <ul class="feature261__rows" role="list">
      {rows.map((row, index) => (
        <li
          data-feature261-card
          class:list={['feature261__row', index % 2 === 0 && 'feature261__row--reverse']}
        >
          {row.media === 'carousel' ? (
            <div class="feature261__media feature261__media--carousel">
              <ShopProductCarousel
                products={retailProducts}
                className="feature261-retail-carousel"
                showControls={false}
                previewMode={true}
              />
            </div>
          ) : row.media === 'widget' ? (
            <div class="feature261__media feature261__media--widget">
              <InsideSystemLiveWidget barbers={barbers} client:visible={{ rootMargin: '200px' }} />
            </div>
          ) : (
            <div class="feature261__media feature261__media--widget">
              <LandingBookingWidget
                services={resolvedBookingData.services}
                barbers={resolvedBookingData.barbers}
                shopDetails={resolvedBookingData.shopDetails}
                client:visible={{ rootMargin: '200px' }}
              />
            </div>
          )}

          <div class="feature261__copy">
            <p class="feature261__row-kicker">{row.kicker}</p>
            <h3 class="feature261__row-heading">{row.heading}</h3>
            <p class="feature261__row-body">{row.description}</p>
          </div>

          {row.ghostCtaLabel && row.ghostCtaHref ? (
            <div class="feature261__row-ctas">
              <a
                href={row.ctaHref}
                class="btn btn--primary feature261__row-cta"
                data-track={row.ctaTrack}
              >
                {row.ctaLabel}
              </a>
              <a
                href={row.ghostCtaHref}
                class="btn btn--ghost feature261__row-cta feature261__row-cta--ghost"
                target="_blank"
                rel="noopener noreferrer"
              >
                {row.ghostCtaLabel}
              </a>
            </div>
          ) : (
            <a
              href={row.ctaHref}
              class="btn btn--primary feature261__row-cta"
              target={row.ctaSameTab ? undefined : '_blank'}
              rel={row.ctaSameTab ? undefined : 'noopener noreferrer'}
              data-track={row.ctaTrack}
            >
              {row.ctaLabel}
            </a>
          )}
        </li>
      ))}
      {config.showMonetization ? (
        <Feature261MonetizationRow client:visible={{ rootMargin: '200px' }} />
      ) : null}
    </ul>
    {config.showMoreIncluded ? (
      <Feature261MoreIncluded client:visible={{ rootMargin: '200px' }} />
    ) : null}

    {config.showAdsFooter ? (
      <div class="landing-demo-preview__ads-footer">
        <p class="landing-demo-preview__ads-note">
          No signup required. Demos open in a new tab.
        </p>
        <p class="landing-demo-preview__ads-soft-cta">
          <a href="#pricing">See the £39 plan</a>
        </p>
      </div>
    ) : null}
  </div>
</section>
