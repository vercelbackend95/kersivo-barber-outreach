---
import { adminDemoHref } from '@/lib/admin/demoConfig';
import { ProductRail } from '@/components/shop/ProductRail';
import { InsideSystemLiveWidget } from '@/components/InsideSystemLiveWidget';
import { LandingBookingWidget } from '@/components/LandingBookingWidget';
import type { CarouselProduct } from '@/lib/shop/carouselProducts';
import type { LandingBarber } from '@/lib/landing/liveTimelineData';
import {
  BLACKLINE_LANDING_BOOKING_DATA,
  type BlacklineLandingBookingData,
} from '@/lib/landing/blacklineLandingBookingData';
import Feature261MonetizationRow from '@/components/feature261/Feature261MonetizationRow.astro';
import { Feature261MoreIncluded } from '@/components/feature261/Feature261MoreIncluded';
import '../styles/components/feature261.css';
import '../styles/components/landingDemoPreview.css';
import '../styles/components/shopProductCards6.css';
import '../styles/components/storefront.css';
import '../styles/components/productRail.css';

type LandingDemoPreviewRow = {
  kicker: string;
  heading: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
  ctaSameTab?: boolean;
  ctaTrack?: string;
  media: 'carousel' | 'widget' | 'booking';
};

type PreviewIntro = {
  kicker: string;
  heading: string;
  description: string;
};

interface Props {
  className?: string;
  retailProducts?: CarouselProduct[];
  barbers?: LandingBarber[];
  bookingData?: BlacklineLandingBookingData;
  intro?: PreviewIntro;
  rows?: LandingDemoPreviewRow[];
  showReports?: boolean;
  showMoreIncluded?: boolean;
  showFooterNote?: boolean;
  sectionId?: string;
  headingId?: string;
}

const DEFAULT_INTRO: PreviewIntro = {
  kicker: 'INSIDE THE SYSTEM',
  heading: 'See the system your barbershop will actually use',
  description:
    'Explore the admin, client booking experience, retail pickup shop and reports before you subscribe.',
};

const DEFAULT_ROWS: LandingDemoPreviewRow[] = [
  {
    kicker: 'ADMIN SYSTEM',
    heading: 'Run your day from one clear admin view',
    description:
      'Manage bookings, clients, barbers, services and daily activity from one central dashboard.',
    ctaLabel: 'Explore the admin system',
    ctaHref: adminDemoHref('timeline'),
    ctaSameTab: false,
    ctaTrack: 'view_live_demo_click',
    media: 'widget',
  },
  {
    kicker: 'CLIENT BOOKING EXPERIENCE',
    heading: 'Service, barber, time — your URL, your brand, not their app.',
    description:
      'Clients choose a service, barber and available time through your own branded website — with no app download.',
    ctaLabel: 'Try the booking experience',
    ctaHref: '/demo/book',
    ctaSameTab: false,
    ctaTrack: 'view_live_demo_click',
    media: 'booking',
  },
  {
    kicker: 'RETAIL PICKUP SHOP',
    heading: 'Sell retail products through your own website',
    description:
      'Let clients browse products online, place pickup orders and collect them from your barbershop.',
    ctaLabel: 'Explore the retail shop',
    ctaHref: '/shop',
    ctaSameTab: false,
    ctaTrack: 'view_live_demo_click',
    media: 'carousel',
  },
];

const {
  className = '',
  retailProducts = [],
  barbers = [],
  bookingData = BLACKLINE_LANDING_BOOKING_DATA,
  intro = DEFAULT_INTRO,
  rows = DEFAULT_ROWS,
  showReports = true,
  showMoreIncluded = true,
  showFooterNote = true,
  sectionId = 'live-demo',
  headingId = 'landing-demo-preview-title',
} = Astro.props as Props;
---

<section
  id={sectionId}
  class={`feature261 landing-demo-preview landing-demo-preview--compact ${className}`.trim()}
  aria-labelledby={headingId}
>
  <div class="feature261__glow" aria-hidden="true"></div>
  <div class="container">
    <header class="feature261__intro">
      <p class="feature261__kicker">{intro.kicker}</p>
      <h2 id={headingId} class="feature261__heading">
        {intro.heading}
      </h2>
      <p class="feature261__description">
        {intro.description}
      </p>
    </header>

    <ul class="feature261__rows" role="list">
      {rows.map((row, index) => (
        <li
          data-feature261-card
          class:list={['feature261__row', index % 2 === 0 && 'feature261__row--reverse']}
        >
          {row.media === 'carousel' ? (
            <div class="feature261__media feature261__media--carousel">
              <div class="sf-shop sf-shop--blackline" data-sf-theme="blackline">
                <ProductRail
                  client:visible={{ rootMargin: '200px' }}
                  products={retailProducts}
                  className="feature261-retail-carousel"
                  productHrefBase="/demo/shop"
                  variant="storefront"
                  imageFallback="wordmark"
                  priceFormat="demo"
                  density="compact"
                  showAction="add-to-cart"
                  showControls={false}
                  showProgress={false}
                  showCategory={true}
                  showPrice={true}
                  fallbackBrandMark="BL"
                  shopName="BLACKLINE"
                  addToBagLabel="Add to bag"
                  addToBagShortLabel="Add"
                  addedLabel="Added"
                  chooseOptionsLabel="Choose options"
                  soldOutLabel="Sold out"
                  ariaLabel="Blackline products"
                />
              </div>
            </div>
          ) : row.media === 'widget' ? (
            <div class="feature261__media feature261__media--widget">
              <InsideSystemLiveWidget barbers={barbers} client:visible={{ rootMargin: '200px' }} />
            </div>
          ) : (
            <div class="feature261__media feature261__media--widget">
              <LandingBookingWidget
                services={[...bookingData.services]}
                barbers={[...bookingData.barbers]}
                shopDetails={bookingData.shopDetails}
                categoryOrder={bookingData.categoryOrder}
                presentation={bookingData.presentation}
                client:visible={{ rootMargin: '200px' }}
              />
            </div>
          )}

          <div class="feature261__copy">
            <p class="feature261__row-kicker">{row.kicker}</p>
            <h3 class="feature261__row-heading">{row.heading}</h3>
            <p class="feature261__row-body">{row.description}</p>
          </div>

          <a
            href={row.ctaHref}
            class="btn btn--ghost feature261__row-cta feature261__row-cta--ghost"
            target={row.ctaSameTab ? undefined : '_blank'}
            rel={row.ctaSameTab ? undefined : 'noopener noreferrer'}
            data-track={row.ctaTrack}
          >
            {row.ctaLabel}
          </a>
        </li>
      ))}
      {showReports ? <Feature261MonetizationRow /> : null}
    </ul>
    {showMoreIncluded ? (
      <Feature261MoreIncluded client:visible={{ rootMargin: '200px' }} />
    ) : null}

    {showFooterNote ? (
      <div class="landing-demo-preview__footer">
        <p class="landing-demo-preview__footer-note">
          Previews use example barbershop data. No signup required.
        </p>
      </div>
    ) : null}
  </div>
</section>
