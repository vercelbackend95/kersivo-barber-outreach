---
import {
  COST_BUYING_MODELS,
  COST_MODELS_EYEBROW,
  COST_MODELS_IMAGE_HEIGHT,
  COST_MODELS_IMAGE_WIDTH,
  COST_MODELS_INSIGHT_BODY,
  COST_MODELS_INSIGHT_CTA_HREF,
  COST_MODELS_INSIGHT_CTA_LABEL,
  COST_MODELS_INSIGHT_EYEBROW,
  COST_MODELS_INSIGHT_IMAGE_SRC,
  COST_MODELS_INSIGHT_TITLE,
  COST_MODELS_LEDE,
  COST_MODELS_SECTION_ID,
  COST_SCOPE_CARDS,
} from '@/lib/seo/barbershopWebsiteCostPage';
---

<section
  class="bwcost-section bwcost-models"
  id={COST_MODELS_SECTION_ID}
  aria-labelledby="bwcost-models-heading"
>
  <div class="bwcost-section__inner bwcost-models__inner">
    <header class="bwcost-models__header">
      <p class="bwcost-models__eyebrow">
        <span class="bwcost-models__eyebrow-rule" aria-hidden="true"></span>
        {COST_MODELS_EYEBROW}
      </p>
      <h2 id="bwcost-models-heading" class="bwcost-models__title">
        What are you actually paying for?
      </h2>
      <p class="bwcost-models__lede">{COST_MODELS_LEDE}</p>
    </header>

    <ul class="bwcost-models__scope">
      {
        COST_SCOPE_CARDS.map((card) => (
          <li class="bwcost-models__scope-card">
            <div class="bwcost-models__scope-top">
              <span class="bwcost-models__index" aria-hidden="true">
                {card.index}
              </span>
              <h3 class="bwcost-models__scope-title">{card.title}</h3>
            </div>
            <div class="bwcost-models__scope-body">
              <div class="bwcost-models__scope-media">
                <img
                  class="bwcost-models__scope-img"
                  src={card.imageSrc}
                  alt=""
                  width={card.imageWidth}
                  height={card.imageHeight}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <ul class="bwcost-models__points">
                {card.points.map((point) => (
                  <li>
                    <span class="bwcost-models__check" aria-hidden="true"></span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>

    <ul class="bwcost-models__fit">
      {
        COST_BUYING_MODELS.map((row) => (
          <li
            class:list={[
              'bwcost-models__fit-card',
              row.emphasized && 'bwcost-models__fit-card--accent',
            ]}
          >
            {row.badge ? <span class="bwcost-models__fit-badge">{row.badge}</span> : null}
            <span
              class:list={['bwcost-models__fit-icon', `bwcost-models__fit-icon--${row.icon}`]}
              aria-hidden="true"
            ></span>
            <h3 class="bwcost-models__fit-title">{row.model}</h3>
            <p class="bwcost-models__fit-best">
              <span class="bwcost-models__fit-best-label">Best for:</span>
              {row.bestSuitedTo}
            </p>
          </li>
        ))
      }
    </ul>

    <aside class="bwcost-models__insight" aria-labelledby="bwcost-four-chair">
      <div class="bwcost-models__insight-copy">
        <p class="bwcost-models__eyebrow bwcost-models__eyebrow--insight">
          <span class="bwcost-models__eyebrow-rule" aria-hidden="true"></span>
          {COST_MODELS_INSIGHT_EYEBROW}
        </p>
        <h3 id="bwcost-four-chair" class="bwcost-models__insight-title">
          {COST_MODELS_INSIGHT_TITLE}
        </h3>
        <p class="bwcost-models__insight-body">{COST_MODELS_INSIGHT_BODY}</p>
        <a class="bwcost-models__insight-cta" href={COST_MODELS_INSIGHT_CTA_HREF}>
          <span aria-hidden="true">→</span>
          {COST_MODELS_INSIGHT_CTA_LABEL}
        </a>
      </div>
      <div class="bwcost-models__insight-media" aria-hidden="true">
        <img
          class="bwcost-models__insight-img"
          src={COST_MODELS_INSIGHT_IMAGE_SRC}
          alt=""
          width={COST_MODELS_IMAGE_WIDTH}
          height={COST_MODELS_IMAGE_HEIGHT}
          loading="lazy"
          decoding="async"
        />
      </div>
    </aside>
  </div>
</section>
