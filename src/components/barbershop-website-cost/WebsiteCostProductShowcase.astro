---
import WebsiteCostReportsChart from '@/components/barbershop-website-cost/WebsiteCostReportsChart';
import { DEMO_BARBERS } from '@/lib/demo/barbers';
import { DEMO_HOME_HREF } from '@/lib/demo/nav';
import { getDemoProductBySlug } from '@/lib/demo/products';
import { DEMO_SHOP_NAME } from '@/lib/demo/site';
import { CATEGORY_LABELS } from '@/lib/shop/productPresentation';
import { buildAppointmentReminderBody } from '@/lib/sms/templates';
import '@/styles/components/booking-flow.css';

const DEMO_ADMIN_HREF = '/demo/admin';
const DEMO_TRACK = 'view_live_demo_click';
const DEMO_PLACEMENT = 'barbershop_website_cost_showcase';

const clay = getDemoProductBySlug('matte-clay');
const clayPrice =
  clay == null
    ? ''
    : new Intl.NumberFormat('en-GB', {
        style: 'currency',
        currency: 'GBP',
        minimumFractionDigits: 0,
        maximumFractionDigits: 2,
      }).format(clay.pricePence / 100);

const selectedBarberId = DEMO_BARBERS[0]?.id;
const previewDays = [
  { weekday: 'Thu', day: '22', label: 'Thursday 22 October 2026', selected: false },
  { weekday: 'Fri', day: '23', label: 'Friday 23 October 2026', selected: true },
  { weekday: 'Sat', day: '24', label: 'Saturday 24 October 2026', selected: false },
  { weekday: 'Sun', day: '25', label: 'Sunday 25 October 2026', selected: false },
] as const;
/** Same illustrative slots as BookingFlow PREVIEW_STATIC_SLOTS. Not live availability. */
const bookingSlots = ['09:00', '09:30', '10:00', '10:30', '11:00', '11:30', '14:00', '14:30'] as const;
const selectedSlot = '11:00';
const smsPreview = buildAppointmentReminderBody({
  shopName: DEMO_SHOP_NAME,
  serviceName: 'Skin Fade',
  startAt: new Date('2026-10-23T10:00:00Z'),
  timezone: 'Europe/London',
});
---

<section class="bwcost-section bwcost-showcase" id="product-showcase" aria-labelledby="bwcost-showcase-heading">
  <div class="bwcost-section__inner">
    <header class="bwcost-showcase__intro">
      <p class="bwcost-showcase__eyebrow">
        <span class="bwcost-showcase__eyebrow-dot" aria-hidden="true"></span>
        05 / See what you're actually paying for
      </p>
      <h2 id="bwcost-showcase-heading" class="bwcost-showcase__title">
        See what you're actually<br />
        <span class="bwcost-showcase__title-accent">paying for.</span>
      </h2>
      <p class="bwcost-showcase__lede">
        A professionally branded website for your customers. Online bookings and management tools for your
        barbershop — connected in one platform.
      </p>
    </header>

    <div class="bwcost-showcase__layout">
      <article class="bwcost-showcase__hero" aria-labelledby="bwcost-showcase-hero-heading">
        <p class="bwcost-showcase__kicker">The complete experience</p>
        <h3 id="bwcost-showcase-hero-heading" class="bwcost-showcase__hero-title">
          One platform, built for barbershops.
        </h3>
        <p class="bwcost-showcase__hero-copy">
          Your branded website, online bookings, client management and everyday shop tools — working together in
          one platform.
        </p>
        <ul class="bwcost-showcase__checks">
          <li>Your website and bookings work together</li>
          <li>Built for independent barbershops</li>
          <li>No technical skills needed to use the core system</li>
        </ul>
        <div class="bwcost-showcase__actions">
          <a
            class="bwcost-btn bwcost-btn--primary"
            href={DEMO_HOME_HREF}
            data-track={DEMO_TRACK}
            data-track-placement={DEMO_PLACEMENT}
          >
            View the working demo
          </a>
          <a class="bwcost-showcase__dash-link" href={DEMO_ADMIN_HREF}>Explore the owner dashboard</a>
        </div>

        <div class="bwcost-showcase__devices">
          <figure class="bwcost-showcase__laptop">
            <div class="bwcost-showcase__laptop-bar" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <img
              src="/images/barbershop-website-cost/section-05/cutstate-desktop.webp"
              alt="CUTSTATE BARBERS demonstration website, the customer-facing shop used to show Full KERSIVO."
              width="1280"
              height="800"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <figure class="bwcost-showcase__phone">
            <img
              src="/images/barbershop-website-cost/section-05/cutstate-booking-mobile.webp"
              alt="CUTSTATE demonstration booking screen on a phone, choosing a service, barber and time."
              width="390"
              height="844"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </article>

      <div class="bwcost-showcase__bento">
        <article class="bwcost-showcase__card bwcost-showcase__card--wide">
          <header class="bwcost-showcase__card-head">
            <span class="bwcost-showcase__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16"><rect x="3" y="4" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3 8h18" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </span>
            <h3>Website</h3>
          </header>
          <p>The branded shop site clients actually see.</p>
          <div class="bwcost-showcase__browser">
            <div class="bwcost-showcase__chrome" aria-hidden="true"><span></span><span></span><span></span><em>cutstate.demo</em></div>
            <div class="bwcost-showcase__site">
              <div class="bwcost-showcase__site-copy">
                <p class="bwcost-showcase__site-eyebrow">Manchester · Appointments & walk-ins</p>
                <p class="bwcost-showcase__site-name">Cutstate Barbers</p>
                <p class="bwcost-showcase__site-display">Precision in every detail.</p>
                <span class="bwcost-showcase__site-book">Book an appointment</span>
              </div>
              <img
                src="/demo/heroimg.webp"
                alt="Barber using clippers and a comb in the CUTSTATE demonstration shop."
                width="1800"
                height="2700"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </article>

        <article class="bwcost-showcase__card bwcost-showcase__card--wide">
          <header class="bwcost-showcase__card-head">
            <span class="bwcost-showcase__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16"><rect x="4" y="5" width="16" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 3v4M16 3v4M4 10h16" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </span>
            <h3>Bookings</h3>
          </header>
          <p>Choose a day and an available time.</p>
          <p class="bwcost-sr-only">Illustrative booking preview. Friday 23 October at 11:00 is shown selected. No appointment is created.</p>
          <div class="booking-flow--wizard booking-shell bwcost-showcase__flow" aria-hidden="true">
            <div class="booking-date-carousel">
              <div class="booking-date-carousel__header">
                <strong>October 2026</strong>
              </div>
              <div class="booking-date-carousel__rail">
                {
                  previewDays.map((day) => (
                    <div class:list={['booking-date-carousel__day', day.selected && 'is-selected']}>
                      <span>{day.weekday}</span>
                      <strong>{day.day}</strong>
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="booking-slots-section">
              <div class="booking-slots-section__head">
                <label>Available times</label>
                <span class="muted">Preview</span>
              </div>
              <div class="slot-grid">
                {
                  bookingSlots.map((slot) => (
                    <div class:list={['booking-choice', 'booking-slot', slot === selectedSlot && 'is-selected']}>
                      <span class="booking-slot__label">{slot}</span>
                      <span class="booking-choice__mark booking-choice__mark--compact" aria-hidden="true">
                        <svg viewBox="0 0 16 16" focusable="false"><path d="M3.5 8.2 6.4 11l6.1-6.4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </article>

        <article class="bwcost-showcase__card bwcost-showcase__card--wide">
          <header class="bwcost-showcase__card-head">
            <span class="bwcost-showcase__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16"><circle cx="9" cy="9" r="3" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 19c.6-2.6 2.6-4 5-4s4.4 1.4 5 4" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="9" r="2" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </span>
            <h3>Team</h3>
          </header>
          <p>Clients pick their barber.</p>
          <p class="bwcost-sr-only">Barber selection preview for Ellis Ward, Noah Reid and Marcus Bell. Ellis Ward is shown selected.</p>
          <div class="booking-flow--wizard booking-shell bwcost-showcase__flow" aria-hidden="true">
            <div class="booking-choice-grid booking-choice-grid--barbers">
              {
                DEMO_BARBERS.map((barber) => (
                  <div class:list={['booking-choice', 'booking-choice-card', 'booking-choice-card--barber', barber.id === selectedBarberId && 'is-selected']}>
                    <span class="booking-choice-card__avatar">
                      <img
                        src={barber.image.src}
                        alt=""
                        width={barber.image.width}
                        height={barber.image.height}
                        style={`object-position: ${barber.rosterObjectPosition}`}
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                    <span class="booking-choice-card__content">
                      <span class="booking-choice-card__title">{barber.name}</span>
                    </span>
                    <span class="booking-choice__mark" aria-hidden="true">
                      <svg viewBox="0 0 16 16" focusable="false"><path d="M3.5 8.2 6.4 11l6.1-6.4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
        </article>

        <article class="bwcost-showcase__card bwcost-showcase__card--wide">
          <header class="bwcost-showcase__card-head">
            <span class="bwcost-showcase__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16"><circle cx="12" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M5 19c1-3 3.2-4.5 7-4.5S18 16 19 19" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </span>
            <h3>Client data</h3>
          </header>
          <p>A client record with visit history.</p>
          <div class="bwcost-showcase__client">
            <div class="bwcost-showcase__client-id">
              <span class="admin-clients-avatar" aria-hidden="true">
                <span class="admin-clients-avatar-initials">AD</span>
              </span>
              <div>
                <p class="bwcost-showcase__client-kicker">Illustrative demo record</p>
                <p class="bwcost-showcase__client-name">Alex Demo</p>
              </div>
              <span class="bwcost-showcase__client-badge">Demo</span>
            </div>
            <dl class="bwcost-showcase__client-meta">
              <div>
                <dt>Last visit</dt>
                <dd>Skin Fade · Ellis Ward</dd>
              </div>
              <div>
                <dt>Next booking</dt>
                <dd>Fri 23 Oct · 11:00</dd>
              </div>
            </dl>
          </div>
        </article>

        <article class="bwcost-showcase__card">
          <header class="bwcost-showcase__card-head">
            <span class="bwcost-showcase__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16"><path d="M6 8h12l-1 11H7L6 8z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M9 8V7a3 3 0 0 1 6 0v1" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </span>
            <h3>Retail pickup</h3>
          </header>
          <p>Products collected at the shop.</p>
          {
            clay ? (
              <article class="sf-card bwcost-showcase__retail">
                <div class="sf-card-media">
                  <img
                    src={clay.image.src}
                    alt={clay.image.alt}
                    width={clay.image.width}
                    height={clay.image.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="sf-card-body">
                  <p class="sf-card-category">{CATEGORY_LABELS[clay.category]}</p>
                  <p class="sf-card-name">{clay.name}</p>
                  <p class="sf-card-price">{clayPrice}</p>
                  <p class="bwcost-showcase__pickup">Collect in shop</p>
                </div>
              </article>
            ) : null
          }
        </article>

        <article class="bwcost-showcase__card">
          <header class="bwcost-showcase__card-head">
            <span class="bwcost-showcase__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16"><path d="M4 19V5M4 19h16" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 16v-4M12 16V8M16 16v-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </span>
            <h3>Reports</h3>
          </header>
          <p>Bookings · Last 7 days</p>
          <div class="bwcost-showcase__reports">
            <WebsiteCostReportsChart client:visible />
          </div>
          <p class="bwcost-showcase__sample">Demo data · not live results</p>
        </article>

        <article class="bwcost-showcase__card">
          <header class="bwcost-showcase__card-head">
            <span class="bwcost-showcase__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16"><path d="M5 6h14v9H8l-3 3V6z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            </span>
            <h3>SMS reminders</h3>
          </header>
          <p>A day-before appointment reminder.</p>
          <div class="bwcost-showcase__sms">
            <p class="bwcost-showcase__sms-kicker">Illustrative preview · not a sent message</p>
            <div class="bwcost-showcase__sms-phone">
              <p class="bwcost-showcase__sms-from">{DEMO_SHOP_NAME}</p>
              <p class="bwcost-showcase__sms-meta">Reminder · Fri 23 Oct</p>
              <p class="bwcost-showcase__sms-bubble">{smsPreview}</p>
            </div>
          </div>
          <p class="bwcost-showcase__sample">Subject to the monthly allowance</p>
        </article>
      </div>
    </div>

    <ul class="bwcost-showcase__benefits">
      <li>
        <span aria-hidden="true"></span>
        <strong>Less admin</strong>
        <em>Keep daily tasks organised.</em>
      </li>
      <li>
        <span aria-hidden="true"></span>
        <strong>Clearer bookings</strong>
        <em>Manage appointments in one place.</em>
      </li>
      <li>
        <span aria-hidden="true"></span>
        <strong>A better client experience</strong>
        <em>Branded, mobile-friendly booking.</em>
      </li>
      <li>
        <span aria-hidden="true"></span>
        <strong>Ready to grow</strong>
        <em>Tools built for independent barbershops.</em>
      </li>
    </ul>
  </div>
</section>
