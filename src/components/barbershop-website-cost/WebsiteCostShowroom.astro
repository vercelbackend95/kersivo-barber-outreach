---
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';

export const HERO_SHOWROOM_SRC = '/images/barbershop-website-cost/hero-39-showroom.webp';
export const HERO_SHOWROOM_WIDTH = 1672;
export const HERO_SHOWROOM_HEIGHT = 941;

type FeatureTile = {
  id: string;
  label: string;
  lines: [string, string] | [string, string, string];
  icon: 'website' | 'bookings' | 'retail' | 'hosting' | 'domain' | 'management';
};

const features: FeatureTile[] = [
  { id: 'website', label: 'Branded website', lines: ['Branded', 'website'], icon: 'website' },
  { id: 'bookings', label: 'Integrated bookings', lines: ['Integrated', 'bookings'], icon: 'bookings' },
  { id: 'retail', label: 'Retail capability', lines: ['Retail', 'capability'], icon: 'retail' },
  { id: 'hosting', label: 'Hosting included', lines: ['Hosting', 'included'], icon: 'hosting' },
  { id: 'domain', label: 'Own domain', lines: ['Own', 'domain'], icon: 'domain' },
  {
    id: 'management',
    label: 'Shop management tools',
    lines: ['Shop', 'management', 'tools'],
    icon: 'management',
  },
];
---

{/* Overlay only — full-bleed WebP lives on .bwcost-hero__media in WebsiteCostHero. */}
<div class="bwcost-showroom">
  <p class="bwcost-showroom__kicker">FULL KERSIVO FOR JUST</p>

  <div class="bwcost-showroom__price-space" aria-hidden="true"></div>

  <p class="bwcost-showroom__mobile-price">
    <span class="bwcost-showroom__mobile-amount">£{SAAS_MONTHLY_GBP}</span>
    <span class="bwcost-showroom__mobile-period">/month per location</span>
  </p>

  <div class="bwcost-showroom__podium">
    <p class="bwcost-showroom__caption">
      PER MONTH <span class="bwcost-showroom__slash" aria-hidden="true">/</span> PER LOCATION
    </p>

    <ul class="bwcost-showroom__tiles">
      {
        features.map((feature) => (
          <li class={`bwcost-showroom__tile bwcost-showroom__tile--${feature.id}`}>
            <span class="bwcost-showroom__tile-icon" aria-hidden="true">
              {feature.icon === 'website' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M3 12h18M12 3c2.4 2.7 3.6 5.7 3.6 9s-1.2 6.3-3.6 9c-2.4-2.7-3.6-5.7-3.6-9s1.2-6.3 3.6-9Z" />
                </svg>
              )}
              {feature.icon === 'bookings' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3.5" y="5" width="17" height="15" rx="2" />
                  <path d="M3.5 10h17M8 3v4M16 3v4" />
                </svg>
              )}
              {feature.icon === 'retail' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6.5 8.5h11l-1 10.5h-9l-1-10.5Z" />
                  <path d="M9 8.5V7.2a3 3 0 0 1 6 0v1.3" />
                </svg>
              )}
              {feature.icon === 'hosting' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 17.5c-2.2 0-4-1.3-4-3s1.8-3 4-3c.3-2.4 2.4-4.2 5-4.2 2.4 0 4.4 1.5 5 3.6 1.9.2 3.5 1.7 3.5 3.6 0 2-1.8 3.5-4 3.5H6Z" />
                </svg>
              )}
              {feature.icon === 'domain' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 13a5 5 0 0 0 7.1.1l1.4-1.4a5 5 0 0 0-7.1-7.1L10 6" />
                  <path d="M14 11a5 5 0 0 0-7.1-.1L5.5 12.3a5 5 0 0 0 7.1 7.1L14 18" />
                </svg>
              )}
              {feature.icon === 'management' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 19V5M4 19h16" />
                  <path d="M8 15v-3M12 15V9M16 15V7" />
                </svg>
              )}
            </span>
            <span class="bwcost-showroom__tile-label">
              {feature.lines.map((line) => (
                <span class="bwcost-showroom__tile-line">{line}</span>
              ))}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
