---
import { BARBERSHOP_WEBSITES_PAGE_PATH } from '@/lib/seo/barbershopWebsitesPage';
import {
  WEBSITE_SERVICE_COMPARISON_ASSUMPTION,
  WEBSITE_SERVICE_COMPARISON_PRICES_CHECKED_LABEL,
  WEBSITE_SERVICE_COMPARISON_SECTION_ID,
  getPrimaryWebsiteServiceComparisonOptions,
  type WebsiteServiceComparisonOption,
} from '@/lib/seo/websiteServiceComparison';

const options = getPrimaryWebsiteServiceComparisonOptions();
const sourced = options.filter(
  (row): row is WebsiteServiceComparisonOption & { sourceHref: string } =>
    Boolean(row.sourceHref),
);

const OPTIONS_HREF = '#cost-options';
const EXPLORE_HREF = BARBERSHOP_WEBSITES_PAGE_PATH;

function padIndex(i: number): string {
  return String(i + 1).padStart(2, '0');
}
---

<section
  class="bwcost-section bwcost-svc"
  id={WEBSITE_SERVICE_COMPARISON_SECTION_ID}
  aria-labelledby="bwcost-svc-heading"
>
  <div class="bwcost-section__inner bwcost-svc__inner">
    <header class="bwcost-svc__intro">
      <div class="bwcost-svc__intro-main">
        <p class="bwcost-svc__eyebrow">
          <span class="bwcost-svc__eyebrow-dot" aria-hidden="true"></span>
          01 / WEBSITE + BOOKING COMPARISON
        </p>
        <h2 id="bwcost-svc-heading" class="bwcost-svc__title">
          What does a complete barbershop website and booking setup actually cost?
        </h2>
        <p class="bwcost-svc__assumption">{WEBSITE_SERVICE_COMPARISON_ASSUMPTION}</p>
      </div>

      <div class="bwcost-svc__intro-aside">
        <p class="bwcost-svc__aside-copy">
          A website is only one part of running a barbershop online. Compare the website, booking
          system, staff calendars, reminders, client management and shop tools — not just the
          headline price.
        </p>
        <div class="bwcost-svc__actions">
          <a class="bwcost-btn bwcost-btn--primary bwcost-svc__btn" href={OPTIONS_HREF}>
            See what affects the price <span aria-hidden="true">↗</span>
          </a>
          <a class="bwcost-btn bwcost-svc__btn bwcost-svc__btn--ghost" href={EXPLORE_HREF}>
            Explore KERSIVO <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </header>

    <div class="bwcost-svc__desktop">
      <div class="bwcost-svc__table-wrap">
        <table class="bwcost-svc__table">
          <caption class="bwcost-sr-only">
            Barbershop website and booking comparison for four bookable barbers: Vagaro Pro + MySite,
            Fresha Team + Smart Website, Nearcut Subscription, Setora, UXHM + Booksy, and Full
            KERSIVO. Each row shows whether the website is self-build, configurable or done-for-you.
          </caption>
          <colgroup>
            <col class="bwcost-svc__col-offer" />
            <col class="bwcost-svc__col-price" />
            <col class="bwcost-svc__col-scope" />
            <col class="bwcost-svc__col-check" />
          </colgroup>
          <thead>
            <tr>
              <th scope="col" class="bwcost-svc__th-offer">Published offer</th>
              <th scope="col">Price structure</th>
              <th scope="col">Scope snapshot</th>
              <th scope="col">What to check</th>
            </tr>
          </thead>
          <tbody>
            {
              options.map((row, index) => (
                <tr class:list={['bwcost-svc__row', row.emphasized && 'bwcost-svc__row--kersivo']}>
                  <th scope="row" class="bwcost-svc__offer">
                    <div class="bwcost-svc__cell">
                      <div class="bwcost-svc__offer-inner">
                        <span
                          class:list={['bwcost-svc__index', row.emphasized && 'bwcost-svc__index--accent']}
                          aria-hidden="true"
                        >
                          {padIndex(index)}
                        </span>
                        <div class="bwcost-svc__offer-copy">
                          <span class="bwcost-svc__name">{row.name}</span>
                          <span class="bwcost-svc__scope">{row.scopeLabel}</span>
                          <span
                            class:list={[
                              'bwcost-svc__delivery',
                              `bwcost-svc__delivery--${row.deliveryMethodKind}`,
                            ]}
                          >
                            <span class="bwcost-svc__delivery-label">{row.deliveryMethodLabel}</span>
                          </span>
                        </div>
                      </div>
                    </div>
                  </th>
                  <td class="bwcost-svc__price">
                    <div class="bwcost-svc__cell">
                      <span class="bwcost-svc__price-figure">
                        {row.priceFigure}
                        {row.priceFigureSecondary ? (
                          <span class="bwcost-svc__price-figure-sec">{row.priceFigureSecondary}</span>
                        ) : null}
                      </span>
                      <span class="bwcost-svc__price-caption">{row.priceCaption}</span>
                      {row.priceNote ? <span class="bwcost-svc__price-note">{row.priceNote}</span> : null}
                    </div>
                  </td>
                  <td class="bwcost-svc__matrix-cell">
                    <div class="bwcost-svc__cell">
                      <ul class="bwcost-svc__matrix" aria-label={`Scope for ${row.name}`}>
                        {row.scopeChips.map((chip) => (
                          <li
                            class:list={[
                              'bwcost-svc__matrix-item',
                              `bwcost-svc__matrix-item--${chip.status}`,
                            ]}
                          >
                            <span class="bwcost-svc__matrix-label">{chip.label}</span>
                            <span class="bwcost-svc__matrix-status">
                              <span class="bwcost-svc__matrix-icon" aria-hidden="true">{chip.statusSymbol}</span>
                              <span class="bwcost-svc__matrix-text">{chip.statusDisplay}</span>
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </td>
                  <td class="bwcost-svc__check">
                    <div class="bwcost-svc__cell">
                      <p class="bwcost-svc__check-copy">{row.whatToCheckShort}</p>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="bwcost-svc__footer">
        <p class="bwcost-svc__disclosure" role="note">
          * Published and researched supplier prices checked {WEBSITE_SERVICE_COMPARISON_PRICES_CHECKED_LABEL}.
          Packages differ in website delivery method, scope and billing model. Some figures are indicative or
          require checkout confirmation. Amounts may exclude VAT where not stated. KERSIVO publishes this
          comparison as a provider with a commercial interest.
        </p>
        <ul class="bwcost-svc__sources">
          {
            sourced.map((row) => (
              <li>
                <a
                  class="bwcost-svc__source"
                  href={row.sourceHref}
                  {...(row.sourceHref.startsWith('http')
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {})}
                >
                  {row.sourceShortLabel ?? row.name}
                  <span aria-hidden="true"> ↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="bwcost-svc__mobile">
      <ul class="bwcost-svc__cards">
        {
          options.map((row, index) => (
            <li class:list={['bwcost-svc__card', row.emphasized && 'bwcost-svc__card--kersivo']}>
              <div class="bwcost-svc__card-top">
                <span
                  class:list={['bwcost-svc__index', row.emphasized && 'bwcost-svc__index--accent']}
                  aria-hidden="true"
                >
                  {padIndex(index)}
                </span>
                <div>
                  <p class="bwcost-svc__card-name">{row.name}</p>
                  <p class="bwcost-svc__card-scope">{row.scopeLabel}</p>
                  <p
                    class:list={[
                      'bwcost-svc__delivery',
                      `bwcost-svc__delivery--${row.deliveryMethodKind}`,
                    ]}
                  >
                    <span class="bwcost-svc__delivery-label">{row.deliveryMethodLabel}</span>
                  </p>
                </div>
              </div>

              <p class="bwcost-svc__card-price">
                <span class="bwcost-svc__price-figure">
                  {row.priceFigure}
                  {row.priceFigureSecondary ? (
                    <span class="bwcost-svc__price-figure-sec">{row.priceFigureSecondary}</span>
                  ) : null}
                </span>
                <span class="bwcost-svc__price-caption">{row.priceCaption}</span>
              </p>
              {row.priceNote ? <p class="bwcost-svc__card-price-secondary">{row.priceNote}</p> : null}

              <ul class="bwcost-svc__matrix" aria-label={`Scope for ${row.name}`}>
                {row.scopeChips.map((chip) => (
                  <li
                    class:list={[
                      'bwcost-svc__matrix-item',
                      `bwcost-svc__matrix-item--${chip.status}`,
                    ]}
                  >
                    <span class="bwcost-svc__matrix-label">{chip.label}</span>
                    <span class="bwcost-svc__matrix-status">
                      <span class="bwcost-svc__matrix-icon" aria-hidden="true">{chip.statusSymbol}</span>
                      <span class="bwcost-svc__matrix-text">{chip.statusDisplay}</span>
                    </span>
                  </li>
                ))}
              </ul>

              <p class="bwcost-svc__card-highlight">
                <span class="bwcost-svc__card-label">What to check</span>
                {row.whatToCheckShort}
              </p>

              {row.caveat ? <p class="bwcost-svc__card-caveat">{row.caveat}</p> : null}

              <details class="bwcost-svc__details">
                <summary>More detail</summary>
                <div class="bwcost-svc__details-body">
                  <p>
                    <strong>Website delivery.</strong> {row.deliveryMethodSummary}{' '}
                    {row.websiteDelivery}
                  </p>
                  <p>
                    <strong>Billing.</strong> {row.billingModel}
                  </p>
                  <p>
                    <strong>Bookings + shop tools.</strong> {row.bookingsRetail}
                  </p>
                  <p>
                    <strong>What to check.</strong> {row.whatToCheck}
                  </p>
                  {row.sourceHref ? (
                    <p>
                      <a
                        class="bwcost-svc__source"
                        href={row.sourceHref}
                        {...(row.sourceHref.startsWith('http')
                          ? { target: '_blank', rel: 'noopener noreferrer' }
                          : {})}
                      >
                        {row.sourceLabel ?? 'View supplier pricing'}
                        <span aria-hidden="true"> ↗</span>
                      </a>
                    </p>
                  ) : null}
                </div>
              </details>
            </li>
          ))
        }
      </ul>

      <p class="bwcost-svc__disclosure" role="note">
        * Published and researched supplier prices checked {WEBSITE_SERVICE_COMPARISON_PRICES_CHECKED_LABEL}.
        Packages differ in website delivery method, scope and billing model. Some figures are indicative or
        require checkout confirmation. Amounts may exclude VAT where not stated. KERSIVO publishes this
        comparison as a provider with a commercial interest.
      </p>
    </div>

    <aside class="bwcost-svc__diy" aria-labelledby="bwcost-svc-diy-heading">
      <h3 id="bwcost-svc-diy-heading" class="bwcost-svc__diy-title">Read the website delivery label first</h3>
      <p>
        “Website included” does not always mean a supplier builds a complete site for you. Some rows are
        self-build or configurable platform websites; others are done-for-you builds with booking software
        attached separately. Use the delivery label under each provider name before comparing headline prices.
      </p>
    </aside>
  </div>
</section>
