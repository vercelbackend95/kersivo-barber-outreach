---
const comparisonRows = [
  {
    topic: 'Bookings',
    kersivo: 'Booking flow built into the website experience.',
    alternative: 'Separate tools or generic booking pages.',

  },
  {
   topic: 'Shop & pickup',
    kersivo: 'Retail and pickup managed in the same system.',
    alternative: 'No store at all or disconnected ecommerce add-ons.',

  },
  {
    topic: 'Barber schedules',
    kersivo: 'Clear service and team availability in one place.',
    alternative: 'Manual updates or platform limitations.',

  },
  {
    topic: 'Admin updates',
    kersivo: 'Update content, products and key details without chaos.',
    alternative: 'Scattered edits across tools or slow agency changes.',

  },
  {
    topic: 'Brand feel',
    kersivo: 'Premium barber-first experience across the whole site.',
    alternative: 'Template feel or platform-driven layout limits.',

  },
];
---

<section class="compare3" aria-label="Why barbers choose Kersivo">
  <div class="container compare3__container">
    <header class="compare3__header">

      <p class="compare3__eyebrow">Comparison</p>
      <h2>Why barbers choose Kersivo</h2>
      <p class="compare3__lead">
        A premium website, bookings, admin and retail flow — all working together in one place.
      </p>
        </header>

    <div class="compare3__column-intros" role="group" aria-label="Kersivo compared with alternatives">
      <article class="compare3__intro-card compare3__intro-card--kersivo">
        <h3>Kersivo</h3>
        <p>Built for barbers who want a premium website, online bookings and retail in one place.</p>
      </article>


      <article class="compare3__intro-card">
        <h3>Typical alternatives</h3>
        <p>Often split across generic templates, booking tools and disconnected admin flows.</p>
      </article>
    </div>


    <div class="compare3__rows" role="list" aria-label="Kersivo vs typical alternatives">
      {
        comparisonRows.map((row) => (
          <article class="compare3__row" role="listitem">
            <h3 class="compare3__topic">{row.topic}</h3>
            <div class="compare3__value compare3__value--kersivo">
              <p class="compare3__value-label">Kersivo</p>
              <p>{row.kersivo}</p>
            </div>
            <div class="compare3__value">
              <p class="compare3__value-label">Typical alternatives</p>
              <p>{row.alternative}</p>
            </div>
          </article>
        ))
      }
    </div>
    <div class="compare3__cta-wrap">
      <a class="btn btn--primary compare3__cta" href="#book-demo" data-demo-cta>Book a demo</a>

    </div>
  </div>
</section>
