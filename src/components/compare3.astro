---
const comparisonRows = [
  {
    title: 'Bookings',
    kersivo: 'Built into the website from the start.',
    alternatives: 'Usually pushed into separate tools or generic booking pages.'
  },
  {
    title: 'Shop & pickup',
    kersivo: 'Products and pickup live inside the same system.',
    alternatives: 'Often no store at all — or a disconnected add-on that feels separate.'
  },
  {
    title: 'Barber schedules',
    kersivo: 'Services, barbers and availability stay clear in one place.',
    alternatives: 'Manual workarounds, limited control or platform restrictions.'
  },
  {
    title: 'Admin updates',
    kersivo: 'Update key details, services and products without the mess.',
    alternatives: 'Edits get scattered across tools — or depend on slow agency updates.'
  },
  {
    title: 'Brand feel',
    kersivo: 'The whole site feels like one premium barber brand.',
    alternatives: 'Often stuck with a template feel or platform-style layout limits.'
  }
];
---

<section id="system" class="compare3-block" aria-label="Comparison">
  <div class="container">
    <div class="compare3-block__header">
      <span class="compare3-block__badge">WHY IT WORKS BETTER</span>
      <h2>WHY BARBERS PICK KERSIVO</h2>
      <p>
        A premium website, bookings, admin and retail flow — all working together in one place.
      </p>
    </div>

    <div class="compare3-block__table-wrap">
      <div class="compare3-block__grid" role="table" aria-label="Comparison table">
        <div class="compare3-block__item compare3-block__brand compare3-block__brand--highlight" role="columnheader">
          <img
            src="https://deifkwefumgah.cloudfront.net/shadcnblocks/block/block-1.svg"
            alt="Kersivo logo"
            class="compare3-block__logo"
            loading="lazy"
            decoding="async"
          />
          <p class="compare3-block__brand-title">Kersivo</p>
          <p class="compare3-block__brand-copy">Premium barber website system</p>
        </div>
        <div class="compare3-block__item compare3-block__brand" role="columnheader">
          <img
            src="https://deifkwefumgah.cloudfront.net/shadcnblocks/block/block-2.svg"
            alt="Typical alternatives"
            class="compare3-block__logo"
            loading="lazy"
            decoding="async"
          />
          <p class="compare3-block__brand-title">Typical alternatives</p>
          <p class="compare3-block__brand-copy">Templates, platforms or disconnected tools</p>
        </div>
        {
          comparisonRows.map((row) => (
            <>
              <div class="compare3-block__item compare3-block__value compare3-block__value--featured">
                <span class="compare3-block__row-title">{row.title}</span>
                <span class="compare3-block__status compare3-block__status--ok">✓</span>
                <span>{row.kersivo}</span>
              </div>
              <div class="compare3-block__item compare3-block__value">
                <span class="compare3-block__row-title">{row.title}</span>
                <span class="compare3-block__status compare3-block__status--bad">−</span>
                <span>{row.alternatives}</span>
              </div>
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>