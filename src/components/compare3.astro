        <div class="compare3-block__cell compare3-block__value"><span class="compare3-block__status compare3-block__status--ok">✓</span><span>Limited options</span></div>
        <div class="compare3-block__cell compare3-block__feature"><span>💻</span><strong>API Access</strong></div>
        <div class="compare3-block__cell compare3-block__value compare3-block__value--highlight"><span class="compare3-block__status compare3-block__status--ok">✓</span><span>Robust API</span></div>
        <div class="compare3-block__cell compare3-block__value"><span class="compare3-block__status compare3-block__status--bad">−</span><span>No API available</span></div>

        <div class="compare3-block__cell compare3-block__feature"><span>📈</span><strong>Advanced Analytics</strong><em>Soon</em></div>
        <div class="compare3-block__cell compare3-block__value compare3-block__value--highlight"><span class="compare3-block__status compare3-block__status--bad">−</span><span>Coming Q3 2025</span></div>
        <div class="compare3-block__cell compare3-block__value"><span class="compare3-block__status compare3-block__status--ok">✓</span><span>Basic reporting</span></div>

        <div class="compare3-block__cell compare3-block__feature"><span>🎧</span><strong>Customer Support</strong></div>
        <div class="compare3-block__cell compare3-block__value compare3-block__value--highlight"><span class="compare3-block__status compare3-block__status--ok">✓</span><span>24/7 dedicated team</span></div>
        <div class="compare3-block__cell compare3-block__value"><span class="compare3-block__status compare3-block__status--bad">−</span><span>Email support only</span></div>

        <div class="compare3-block__cell compare3-block__cell--foot-empty"></div>
        <div class="compare3-block__cell compare3-block__cta-wrap compare3-block__value--highlight">
