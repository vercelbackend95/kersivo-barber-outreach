---
const comparisonRows = [
  {
    title: 'Bookings',
    kersivo: 'Self-book on your URL. £0 booking fees from us.',
    alternatives: 'Apps that tax every chair—or own the client, not you.',
  },
  {
    title: 'Retail',
    kersivo: 'Buy-and-collect on the same site. No shop cut from us.',
    alternatives: 'No store—or a separate stack that skims again.',
  },
  {
    title: 'Team',
    kersivo: 'Add barbers & services freely. One admin stays in sync.',
    alternatives: 'Seat caps, rigid plans, spreadsheet + DM chaos.',
  },
  {
    title: 'Operations',
    kersivo: 'Bookings, orders, reports—one dashboard.',
    alternatives: 'Split tools. Nobody sees the whole day.',
  },
  {
    title: 'Brand',
    kersivo: 'Your site, your look—not a rented profile.',
    alternatives: 'Generic templates. Traffic that isn’t really yours.',
  },
  {
    title: 'Go-live',
    kersivo: '~14 days to a full launch—booking, retail pickup & admin together.',
    alternatives: 'Long agency loops—or a slick site with booking still “later.”',
  },
];
---

<section id="system" class="compare3-block" aria-label="Comparison">
  <div class="container">
    <div class="compare3-block__header">
      <span class="compare3-block__badge">WHY IT WORKS BETTER</span>
      <h2>ONE STACK. YOUR DOMAIN. YOUR MARGIN.</h2>
      <p>
        One connected stack on your domain. The usual mix splits booking, retail, and admin across apps and sites that
        tax you again—or park clients where you don&apos;t own the relationship.
      </p>
    </div>

    <div class="compare3-block__table-wrap">
      <div class="compare3-block__grid" role="table" aria-label="Comparison table">
        <div class="compare3-block__item compare3-block__brand compare3-block__brand--highlight" role="columnheader">
          <span class="compare3-block__logo compare3-block__logo--kersivo" aria-hidden="true">K</span>
          <p class="compare3-block__brand-title">Kersivo</p>
          <p class="compare3-block__brand-copy">Booking · retail pickup · one admin</p>
        </div>
        <div class="compare3-block__item compare3-block__brand" role="columnheader">
          <span class="compare3-block__logo compare3-block__logo--alt" aria-hidden="true"></span>
          <p class="compare3-block__brand-title">Typical mix</p>
          <p class="compare3-block__brand-copy">Apps · templates · extra tools</p>
        </div>
        {
          comparisonRows.map((row) => (
            <>
              <div class="compare3-block__item compare3-block__value compare3-block__value--featured">
                <span class="compare3-block__row-title">{row.title}</span>
                <span class="compare3-block__status compare3-block__status--ok">✓</span>
                <span>{row.kersivo}</span>
              </div>
              <div class="compare3-block__item compare3-block__value">
                <span class="compare3-block__row-title">{row.title}</span>
                <span class="compare3-block__status compare3-block__status--bad">−</span>
                <span>{row.alternatives}</span>
              </div>
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>