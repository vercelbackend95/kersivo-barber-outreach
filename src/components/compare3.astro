---
const comparisonRows = [
  {
    icon: '📅',
    title: 'Bookings',
    kersivo: 'Booking flow built into the website experience.',
    alternatives: 'Separate tools or generic booking pages.'
  },
  {
    icon: '🛍️',
    title: 'Shop & pickup',
    kersivo: 'Retail and pickup managed in the same system.',
    alternatives: 'No store at all or disconnected ecommerce add-ons.'
  },
  {
    icon: '🧑‍💼',
    title: 'Barber schedules',
    kersivo: 'Clear service and team availability in one place.',
    alternatives: 'Manual updates or platform limitations.'
  },
  {
    icon: '🛠️',
    title: 'Admin updates',
    kersivo: 'Update content, products and key details without chaos.',
    alternatives: 'Scattered edits across tools or slow agency changes.'
  },
  {
    icon: '✂️',
    title: 'Brand feel',
    kersivo: 'Premium barber-first experience across the whole site.',
    alternatives: 'Template feel or platform-driven layout limits.'
  }
];
---


<section class="compare3-block" aria-label="Comparison">
  <div class="container">
    <div class="compare3-block__header">
      <span class="compare3-block__badge">Comparison</span>
      <h2>Why barbers choose Kersivo</h2>
      <p>
        A premium website, bookings, admin and retail flow — all working together in one place.
      </p>
    </div>
        <div class="compare3-block__desktop" aria-hidden="false">
      <div class="compare3-block__table-wrap">
        <div class="compare3-block__grid" role="table" aria-label="Comparison table">
          <div class="compare3-block__cell compare3-block__cell--head-empty"></div>
          <div class="compare3-block__cell compare3-block__brand compare3-block__brand--highlight" role="columnheader">
            <img
              src="https://deifkwefumgah.cloudfront.net/shadcnblocks/block/block-1.svg"
              alt="Kersivo logo"
              class="compare3-block__logo"
              loading="lazy"
              decoding="async"
            />
            <p class="compare3-block__brand-title">Kersivo</p>
            <p class="compare3-block__brand-copy">Premium barber website system</p>
          </div>
          <div class="compare3-block__cell compare3-block__brand" role="columnheader">
            <img
              src="https://deifkwefumgah.cloudfront.net/shadcnblocks/block/block-2.svg"
              alt="Typical alternatives"
              class="compare3-block__logo"
              loading="lazy"
              decoding="async"
            />
            <p class="compare3-block__brand-title">Typical alternatives</p>
            <p class="compare3-block__brand-copy">Templates, platforms or disconnected tools</p>
          </div>
          {
            comparisonRows.map((row) => (
              <>
                <div class="compare3-block__cell compare3-block__feature">
                  <span>{row.icon}</span>
                  <strong>{row.title}</strong>
                </div>
                <div class="compare3-block__cell compare3-block__value compare3-block__value--highlight">
                  <span class="compare3-block__status compare3-block__status--ok">✓</span>
                  <span>{row.kersivo}</span>
                </div>
                <div class="compare3-block__cell compare3-block__value">
                  <span class="compare3-block__status compare3-block__status--bad">−</span>
                  <span>{row.alternatives}</span>
                </div>
              </>
            ))
          }
          <div class="compare3-block__cell compare3-block__cta-wrap compare3-block__value--highlight">
            <a class="compare3-block__cta" href="#book-demo" data-demo-cta>Book a demo</a>
          </div>

        </div>

      </div>
    </div>

    <div class="compare3-block__mobile" aria-label="Mobile comparison">
      {
        comparisonRows.map((row) => (
          <details class="compare3-block__accordion-item">
            <summary class="compare3-block__accordion-summary">
              <span class="compare3-block__accordion-heading">
                <span class="compare3-block__accordion-icon" aria-hidden="true">{row.icon}</span>
                <span>{row.title}</span>
              </span>
              <span class="compare3-block__accordion-indicator" aria-hidden="true"></span>
            </summary>
            <div class="compare3-block__accordion-panel">
              <div class="compare3-block__accordion-content compare3-block__accordion-content--highlight">
                <p class="compare3-block__mobile-label">Kersivo</p>
                <p class="compare3-block__mobile-copy">{row.kersivo}</p>
              </div>
              <div class="compare3-block__accordion-content">
                <p class="compare3-block__mobile-label">Typical alternatives</p>
                <p class="compare3-block__mobile-copy">{row.alternatives}</p>
              </div>

            </div>
          </details>
        ))
      }

      <div class="compare3-block__mobile-cta-wrap">
        <a class="compare3-block__cta" href="#book-demo" data-demo-cta>Book a demo</a>
      </div>


    </div>
  </div>
</section>
