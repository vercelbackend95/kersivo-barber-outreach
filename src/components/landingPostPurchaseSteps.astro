---
import FullPlanCta from '@/components/cta/FullPlanCta.astro';
import { getSetupSteps } from '@/content/setupSteps';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import '../styles/components/landingPostPurchaseSteps.css';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props as Props;

// FREE_PREVIEW_FLOW_ENABLED swaps in the §10.3 copy; off keeps the original section.
const freePreview = isFreePreviewFlowEnabled();
const steps = getSetupSteps(freePreview);
---

<section
  id="what-happens-after-you-buy"
  class={`landing-post-purchase-steps ${className}`.trim()}
  aria-labelledby="landing-post-purchase-steps-title"
>
  <div class="container">
    <div class="landing-post-purchase-steps__layout">
      <header class="landing-post-purchase-steps__intro">
        <p class="landing-post-purchase-steps__eyebrow">GETTING STARTED</p>
        {freePreview ? (
          <>
            <h2 id="landing-post-purchase-steps-title" class="landing-post-purchase-steps__heading">
              From free preview to launch in four steps
            </h2>
            <p class="landing-post-purchase-steps__lead">
              We design your website first. You decide after you've seen it.
            </p>
          </>
        ) : (
          <>
        <h2 id="landing-post-purchase-steps-title" class="landing-post-purchase-steps__heading">
          From subscription to launch in four steps
        </h2>
        <p class="landing-post-purchase-steps__lead">
          We prepare your branded KERSIVO setup after you send us the information we need. You
          review a private preview before anything goes live.
        </p>
          </>
        )}
        <p class="landing-post-purchase-steps__reassurance">
          Nothing goes live until you approve it.
        </p>
        <div class="landing-post-purchase-steps__illustration" aria-hidden="true">
          <img
            src="/images/Ilustracje/shoppyonline.webp"
            alt=""
            width="1536"
            height="1024"
            loading="lazy"
            decoding="async"
            class="landing-post-purchase-steps__illustration-img"
          />
        </div>
      </header>

      <div class="landing-post-purchase-steps__process">
        <ol class="landing-post-purchase-steps__timeline">
          {steps.map((step, index) => (
            <li class="landing-post-purchase-steps__step">
              <article aria-label={`Step ${index + 1}: ${step.title}`}>
                <div class="landing-post-purchase-steps__number" aria-hidden="true">
                  0{index + 1}
                </div>
                <div class="landing-post-purchase-steps__content">
                  <h3 class="landing-post-purchase-steps__title">
                    <span class="sr-only">Step {index + 1} of {steps.length}: </span>
                    {step.title}
                  </h3>
                  <p class="landing-post-purchase-steps__body">{step.body}</p>
                </div>
              </article>
            </li>
          ))}
        </ol>

        <p class="landing-post-purchase-steps__after-note">
          <span class="landing-post-purchase-steps__after-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.85"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="7" height="9" x="3" y="3" rx="1"></rect>
              <rect width="7" height="5" x="14" y="3" rx="1"></rect>
              <rect width="7" height="9" x="14" y="12" rx="1"></rect>
              <rect width="7" height="5" x="3" y="16" rx="1"></rect>
            </svg>
          </span>
          After launch, manage barbers, services, prices, working hours and products from your
          dashboard.
        </p>

        {freePreview ? (
          <FullPlanCta
            part="primary"
            primaryClass="btn btn--primary btn--lg landing-post-purchase-steps__cta"
            placement="homepage_getting_started"
          />
        ) : (
        <a
          href="/admin/launch"
          class="btn btn--primary btn--lg landing-post-purchase-steps__cta"
          data-track="saas_subscribe_click"
        >
          Start my KERSIVO subscription
        </a>
        )}
      </div>
    </div>
  </div>
</section>
