---
import {
  INCLUDED_SETUP_SHORT,
  NO_SETUP_FEE_SHORT,
  ONBOARDING_BILLING_INDEPENDENT_CLAIM,
  ONBOARDING_TIMELINE_CLAIM,
  OWNER_SELF_CONFIG_SHORT,
  PREVIEW_LAUNCH_CLAIM,
} from '@/lib/pricing/claimsPolicy';
import '../styles/components/landingPostPurchaseSteps.css';

interface Props {
  className?: string;
}

interface Step {
  title: string;
  body: string;
}

const { className = '' } = Astro.props as Props;

const steps: Step[] = [
  {
    title: 'Start your subscription',
    body: `Subscribe for £39/month per physical location securely through Stripe — billed today. ${NO_SETUP_FEE_SHORT} ${ONBOARDING_BILLING_INDEPENDENT_CLAIM}`,
  },
  {
    title: 'Complete your onboarding form',
    body: 'Share business name, address, contact details, logo, photos, team, hours, social links, salon description and any migration details we need.',
  },
  {
    title: 'We prepare your standard setup',
    body: `${INCLUDED_SETUP_SHORT} ${ONBOARDING_TIMELINE_CLAIM}`,
  },
  {
    title: 'Configure in your dashboard',
    body: OWNER_SELF_CONFIG_SHORT,
  },
  {
    title: 'Private preview, then Approve and launch',
    body: PREVIEW_LAUNCH_CLAIM,
  },
  {
    title: 'Your shop goes live',
    body: 'After approval, DNS is switched and your booking website launches on your domain when you are ready.',
  },
];
---

<section
  id="what-happens-after-you-buy"
  class={`landing-post-purchase-steps ${className}`.trim()}
  aria-labelledby="landing-post-purchase-steps-title"
>
  <div class="container">
    <div class="landing-post-purchase-steps__layout">
      <header class="landing-post-purchase-steps__intro">
        <p class="landing-post-purchase-steps__eyebrow">GETTING STARTED</p>
        <h2 id="landing-post-purchase-steps-title" class="landing-post-purchase-steps__heading">
          What happens<br />
          after you subscribe?
        </h2>
        <p class="landing-post-purchase-steps__lead">
          Billing starts when you subscribe. Setup timeline starts after we have your required information.
        </p>
        <p class="landing-post-purchase-steps__support">
          Subscribe, complete onboarding, review a private preview, approve launch, then go live — with day-to-day control in your dashboard.
        </p>
        <p class="landing-post-purchase-steps__reassurance">
          Nothing goes live without your approval. DNS switches only after you approve.
        </p>
        <div class="landing-post-purchase-steps__illustration" aria-hidden="true">
          <img
            src="/images/Ilustracje/shoppyonline.webp"
            alt="Barber running his shop online from the chair — KERSIVO setup"
            width="1536"
            height="1024"
            loading="lazy"
            decoding="async"
            class="landing-post-purchase-steps__illustration-img"
          />
        </div>
      </header>

      <ol class="landing-post-purchase-steps__timeline">
        {steps.map((step, index) => (
          <li class="landing-post-purchase-steps__step">
            <article aria-label={`Step ${index + 1}: ${step.title}`}>
              <div class="landing-post-purchase-steps__number" aria-hidden="true">
                0{index + 1}
              </div>
              <div class="landing-post-purchase-steps__content">
                <h3 class="landing-post-purchase-steps__title">
                  <span class="sr-only">Step {index + 1} of {steps.length}: </span>
                  {step.title}
                </h3>
                <p class="landing-post-purchase-steps__body">{step.body}</p>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
