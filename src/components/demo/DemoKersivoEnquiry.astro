---
import BlacklineKersivoContactForm from '@/components/demo/BlacklineKersivoContactForm';
---

<section
  class="bl-kersivo-enquiry"
  data-surface="dark"
  aria-labelledby="bl-kersivo-enquiry-heading"
  data-bl-reveal
>
  <div class="bl-container bl-kersivo-enquiry-inner">
    <p class="bl-kersivo-enquiry-brand" aria-hidden="true">KERSIVO</p>
    <p class="bl-kersivo-enquiry-eyebrow">QUESTIONS ABOUT KERSIVO?</p>
    <h2 class="bl-kersivo-enquiry-heading" id="bl-kersivo-enquiry-heading">
      Like what you’re seeing but want to ask something first?
    </h2>
    <p class="bl-kersivo-enquiry-lede">
      Ask us about setup, switching, pricing or how KERSIVO would work for your shop.
    </p>
    <p class="bl-kersivo-enquiry-note">
      This form emails the real KERSIVO team — not the fictional BLACKLINE shop above.
    </p>
    <BlacklineKersivoContactForm client:load />
  </div>
</section>
