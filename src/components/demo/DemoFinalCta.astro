---
import { DEMO_BOOK_HREF } from '@/lib/demo/nav';
---

<section
  class="bl-final"
  data-surface="dark"
  data-tone="graphite"
  aria-labelledby="blackline-final-cta-heading"
>
  <div class="bl-container bl-final-inner">
    <h2 class="bl-final-heading" id="blackline-final-cta-heading">
      <span>Your next cut</span>
      <span>Starts here.</span>
    </h2>
    <p class="bl-final-lede">Choose your barber, service and time in under a minute.</p>
    <a class="bl-btn bl-btn--primary bl-final-cta" href={DEMO_BOOK_HREF}>
      <span>Book an appointment</span>
      <span class="bl-final-arrow" aria-hidden="true"></span>
    </a>
  </div>
</section>
