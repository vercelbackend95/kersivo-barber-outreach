---
import {
  demoGalleryIndexLabel,
  demoGalleryOpenLabel,
  demoGallerySequence,
} from '@/lib/demo/gallery';
import {
  demoGalleryBentoClassName,
  demoGalleryBentoClusters,
  demoGalleryBentoSizes,
  type DemoGalleryBentoTile,
} from '@/lib/demo/galleryBento';

const frames = demoGallerySequence();
const clusters = demoGalleryBentoClusters(frames);
const total = frames.length;
const firstFrame = frames[0];

function tileStyle(tile: DemoGalleryBentoTile): string {
  return `--bl-work-pos: ${tile.image.objectPosition.desktop}; --bl-work-pos-mobile: ${tile.image.objectPosition.mobile}; --bl-work-ratio: ${tile.ratio}; --bl-work-ratio-mobile: ${tile.ratioMobile}`;
}
---

<section
  class="bl-work-index bl-work-index--editorial"
  data-surface="light"
  aria-labelledby="blackline-gallery-heading"
>
  <div class="bl-container">
    <div class="bl-work-clusters">
      <div class="bl-work-cluster bl-work-cluster--primary">
        <article
          class={demoGalleryBentoClassName(clusters.primary.featured)}
          data-bl-reveal
          style={tileStyle(clusters.primary.featured)}
        >
          <figure class="bl-work-frame">
            <button
              class="bl-work-open"
              type="button"
              data-work-open={String(clusters.primary.featured.index)}
              data-work-alt={clusters.primary.featured.image.alt}
              aria-label={demoGalleryOpenLabel(
                clusters.primary.featured.image,
                clusters.primary.featured.index,
                total,
              )}
            >
              <span class="bl-work-stage">
                <img
                  src={clusters.primary.featured.image.src}
                  alt=""
                  width={clusters.primary.featured.image.width}
                  height={clusters.primary.featured.image.height}
                  sizes={demoGalleryBentoSizes(clusters.primary.featured)}
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
                <span class="bl-work-view" aria-hidden="true">View image</span>
              </span>
            </button>
            <figcaption class="bl-work-meta">
              <p class="bl-work-index-label">
                {demoGalleryIndexLabel(clusters.primary.featured.index, total)}
              </p>
              <p class="bl-work-caption">{clusters.primary.featured.image.caption}</p>
            </figcaption>
          </figure>
        </article>

        <div class="bl-work-cluster-stack">
          {
            clusters.primary.stack.map((tile) => (
              <article
                class={demoGalleryBentoClassName(tile)}
                data-bl-reveal
                style={tileStyle(tile)}
              >
                <figure class="bl-work-frame">
                  <button
                    class="bl-work-open"
                    type="button"
                    data-work-open={String(tile.index)}
                    data-work-alt={tile.image.alt}
                    aria-label={demoGalleryOpenLabel(tile.image, tile.index, total)}
                  >
                    <span class="bl-work-stage">
                      <img
                        src={tile.image.src}
                        alt=""
                        width={tile.image.width}
                        height={tile.image.height}
                        sizes={demoGalleryBentoSizes(tile)}
                        loading={tile.index < 2 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                      <span class="bl-work-view" aria-hidden="true">View image</span>
                    </span>
                  </button>
                  <figcaption class="bl-work-meta">
                    <p class="bl-work-index-label">{demoGalleryIndexLabel(tile.index, total)}</p>
                    <p class="bl-work-caption">{tile.image.caption}</p>
                  </figcaption>
                </figure>
              </article>
            ))
          }
        </div>
      </div>

      <div class="bl-work-cluster bl-work-cluster--secondary">
        {
          clusters.secondary.map((tile) => (
            <article
              class={demoGalleryBentoClassName(tile)}
              data-bl-reveal
              style={tileStyle(tile)}
            >
              <figure class="bl-work-frame">
                <button
                  class="bl-work-open"
                  type="button"
                  data-work-open={String(tile.index)}
                  data-work-alt={tile.image.alt}
                  aria-label={demoGalleryOpenLabel(tile.image, tile.index, total)}
                >
                  <span class="bl-work-stage">
                    <img
                      src={tile.image.src}
                      alt=""
                      width={tile.image.width}
                      height={tile.image.height}
                      sizes={demoGalleryBentoSizes(tile)}
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="bl-work-view" aria-hidden="true">View image</span>
                  </span>
                </button>
                <figcaption class="bl-work-meta">
                  <p class="bl-work-index-label">{demoGalleryIndexLabel(tile.index, total)}</p>
                  <p class="bl-work-caption">{tile.image.caption}</p>
                </figcaption>
              </figure>
            </article>
          ))
        }
      </div>

      <div class="bl-work-cluster bl-work-cluster--closing">
        <article
          class={demoGalleryBentoClassName(clusters.closing)}
          data-bl-reveal
          style={tileStyle(clusters.closing)}
        >
          <figure class="bl-work-frame">
            <button
              class="bl-work-open"
              type="button"
              data-work-open={String(clusters.closing.index)}
              data-work-alt={clusters.closing.image.alt}
              aria-label={demoGalleryOpenLabel(clusters.closing.image, clusters.closing.index, total)}
            >
              <span class="bl-work-stage">
                <img
                  src={clusters.closing.image.src}
                  alt=""
                  width={clusters.closing.image.width}
                  height={clusters.closing.image.height}
                  sizes={demoGalleryBentoSizes(clusters.closing)}
                  loading="lazy"
                  decoding="async"
                />
                <span class="bl-work-view" aria-hidden="true">View image</span>
              </span>
            </button>
            <figcaption class="bl-work-meta">
              <p class="bl-work-index-label">{demoGalleryIndexLabel(clusters.closing.index, total)}</p>
              <p class="bl-work-caption">{clusters.closing.image.caption}</p>
            </figcaption>
          </figure>
        </article>
      </div>
    </div>
  </div>

  <dialog
    class="bl-work-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="bl-work-dialog-caption"
  >
    <div class="bl-work-dialog-inner">
      <button
        class="bl-work-dialog-control bl-work-dialog-close"
        type="button"
        data-work-close
        aria-label="Close gallery"
        title="Close"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M6.5 6.5 17.5 17.5M17.5 6.5 6.5 17.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
        </svg>
      </button>
      <figure class="bl-work-dialog-figure">
        <div class="bl-work-dialog-stage" data-work-stage>
          <img
            class="bl-work-dialog-image"
            src={firstFrame?.src}
            alt={firstFrame?.alt ?? ''}
            width={firstFrame?.width}
            height={firstFrame?.height}
            data-work-image
          />
          <button
            class="bl-work-dialog-control bl-work-dialog-prev"
            type="button"
            data-work-prev
            aria-label="Previous image"
            title="Previous"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M14.5 6.5 8.5 12l6 5.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <button
            class="bl-work-dialog-control bl-work-dialog-next"
            type="button"
            data-work-next
            aria-label="Next image"
            title="Next"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9.5 6.5 15.5 12l-6 5.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
        <figcaption class="bl-work-dialog-meta">
          <p class="bl-work-dialog-count" data-work-count>
            {firstFrame ? demoGalleryIndexLabel(0, total) : ''}
          </p>
          <p class="bl-work-dialog-caption" id="bl-work-dialog-caption" data-work-caption>
            {firstFrame?.caption}
          </p>
        </figcaption>
      </figure>
    </div>
  </dialog>
</section>
