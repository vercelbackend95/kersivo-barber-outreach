---
import {
  demoGalleryIndexLabel,
  demoGalleryOpenLabel,
  demoGallerySequence,
} from '@/lib/demo/gallery';
import {
  demoGalleryBentoClassName,
  demoGalleryBentoSizes,
  demoGalleryBentoTiles,
} from '@/lib/demo/galleryBento';

const frames = demoGallerySequence();
const tiles = demoGalleryBentoTiles(frames);
const total = frames.length;
const firstFrame = frames[0];
---

<section
  class="bl-work-index"
  data-surface="light"
  aria-labelledby="blackline-gallery-heading"
>
  <div class="bl-container">
    <ol class="bl-work-grid">
      {
        tiles.map((tile) => (
          <li
            class={demoGalleryBentoClassName(tile)}
            data-bl-reveal
            style={`--bl-work-pos: ${tile.image.objectPosition.desktop}; --bl-work-pos-mobile: ${tile.image.objectPosition.mobile}`}
          >
            <figure class="bl-work-frame">
              <button
                class="bl-work-open"
                type="button"
                data-work-open={String(tile.index)}
                data-work-alt={tile.image.alt}
                aria-label={demoGalleryOpenLabel(tile.image, tile.index, total)}
              >
                <span class="bl-work-stage">
                  <img
                    src={tile.image.src}
                    alt=""
                    width={tile.image.width}
                    height={tile.image.height}
                    sizes={demoGalleryBentoSizes(tile)}
                    loading={tile.index < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <span class="bl-work-view" aria-hidden="true">View image</span>
                </span>
              </button>
              <figcaption class="bl-work-meta">
                <p class="bl-work-index-label">{demoGalleryIndexLabel(tile.index, total)}</p>
                <p class="bl-work-caption">{tile.image.caption}</p>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ol>
  </div>

  <dialog
    class="bl-work-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="bl-work-dialog-caption"
  >
    <div class="bl-work-dialog-inner">
      <button
        class="bl-work-dialog-control bl-work-dialog-close"
        type="button"
        data-work-close
        aria-label="Close gallery"
        title="Close"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M6.5 6.5 17.5 17.5M17.5 6.5 6.5 17.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
        </svg>
      </button>
      <figure class="bl-work-dialog-figure">
        <div class="bl-work-dialog-stage" data-work-stage>
          <img
            class="bl-work-dialog-image"
            src={firstFrame?.src}
            alt={firstFrame?.alt ?? ''}
            width={firstFrame?.width}
            height={firstFrame?.height}
            data-work-image
          />
          <button
            class="bl-work-dialog-control bl-work-dialog-prev"
            type="button"
            data-work-prev
            aria-label="Previous image"
            title="Previous"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M14.5 6.5 8.5 12l6 5.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <button
            class="bl-work-dialog-control bl-work-dialog-next"
            type="button"
            data-work-next
            aria-label="Next image"
            title="Next"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9.5 6.5 15.5 12l-6 5.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
        <figcaption class="bl-work-dialog-meta">
          <p class="bl-work-dialog-count" data-work-count>
            {firstFrame ? demoGalleryIndexLabel(0, total) : ''}
          </p>
          <p class="bl-work-dialog-caption" id="bl-work-dialog-caption" data-work-caption>
            {firstFrame?.caption}
          </p>
        </figcaption>
      </figure>
    </div>
  </dialog>
</section>
