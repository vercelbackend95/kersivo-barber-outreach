---
import { ProductRail } from '@/components/shop/ProductRail';
import { toBlacklineCarouselProducts } from '@/lib/demo/blacklineShop';
import { DEMO_SHOP_HREF } from '@/lib/demo/nav';
import type { DemoProduct } from '@/lib/demo/products';
import '@/styles/components/productRail.css';
import '@/styles/components/storefront.css';

interface Props {
  products: DemoProduct[];
}

const { products } = Astro.props;
const carouselProducts = toBlacklineCarouselProducts(products);
---

<section
  class="bl-shop"
  data-surface="light"
  aria-labelledby="blackline-shop-preview-heading"
>
  <div class="bl-container bl-shop-layout">
    <p class="bl-shop-eyebrow">
      <span class="bl-shop-eyebrow-index">05</span>
      <span aria-hidden="true"> · </span>
      The Shop
    </p>
    <h2 class="bl-shop-heading" id="blackline-shop-preview-heading">
      <span>THE PRODUCTS WE USE.</span>
      <span>READY TO COLLECT.</span>
    </h2>
    <p class="bl-shop-lede">Order online and collect from the shop.</p>

    <div class="bl-shop-rail">
      <ProductRail
        client:visible
        products={carouselProducts}
        productHrefBase="/demo/shop"
        variant="blackline"
        density="editorial"
        showAction="add-to-cart"
        showControls={true}
        showProgress={true}
        showCategory={true}
        showPrice={true}
        fallbackBrandMark="BL"
        shopName="BLACKLINE"
        addToBagLabel="Add to bag"
        addedLabel="Added"
        chooseOptionsLabel="Choose options"
        soldOutLabel="Sold out"
        ariaLabel="Blackline products"
      />
    </div>

    <a class="bl-shop-cta" href={DEMO_SHOP_HREF}>
      <span>Shop products</span>
      <span class="bl-shop-arrow" aria-hidden="true"></span>
    </a>
  </div>
</section>
