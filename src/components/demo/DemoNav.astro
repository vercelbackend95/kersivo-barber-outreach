---
import StorefrontHeader from '@/components/shop/storefront/StorefrontHeader.astro';
import BlacklineWordmark from '@/components/demo/BlacklineWordmark';
import { DEMO_BOOK_HREF, DEMO_HOME_HREF, DEMO_NAV } from '@/lib/demo/nav';
import { DEMO_LOCATION, DEMO_LOCATION_NOTE, DEMO_SHOP_NAME } from '@/lib/demo/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<StorefrontHeader
  themeId="blackline"
  currentPath={currentPath}
  homeHref={DEMO_HOME_HREF}
  homeLabel="BLACKLINE demo home"
  items={[...DEMO_NAV]}
  bookHref={DEMO_BOOK_HREF}
  shopName={DEMO_SHOP_NAME}
  showBag
  placeLabel={DEMO_LOCATION}
  placeNote={DEMO_LOCATION_NOTE}
>
  <BlacklineWordmark slot="logo" size="default" />
</StorefrontHeader>
