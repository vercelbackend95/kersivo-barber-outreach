---
import {
  demoBookingHref,
  demoServiceAccessibleName,
  demoServiceCategoryAnchorId,
  demoServiceDurationRatio,
  demoServiceIndex,
  demoServiceNavigatorGroups,
  demoServicesMeta,
  formatDemoPriceGbp,
  isDemoFeaturedService,
} from '@/lib/demo/services';

const groups = demoServiceNavigatorGroups();
const maxDuration = demoServicesMeta().maxDurationMinutes;
const initial = groups[0]!;
const categoryCount = groups.length;
---

<section
  class="bl-services-menu"
  data-surface="light"
  data-bl-reveal
  data-bl-service-menu
  data-active-category={initial.slug}
  aria-labelledby="blackline-service-menu-heading"
>
  <div class="bl-container bl-services-menu-shell">
    <div class="bl-services-menu-layout">
      <aside class="bl-services-viewing" aria-label="Current service category" data-bl-services-viewing>
        <p class="bl-services-viewing-eyebrow">Now viewing</p>
        <div class="bl-services-viewing-copy" data-bl-viewing-copy>
          <p class="bl-services-viewing-index" data-bl-viewing-index>
            {initial.indexLabel} / {demoServiceIndex(categoryCount - 1)}
          </p>
          <p class="bl-services-viewing-name" data-bl-viewing-name>{initial.label}</p>
          <p class="bl-services-viewing-meta" data-bl-viewing-meta>
            {initial.countLabel} · {initial.fromPriceLabel}
          </p>
        </div>
        <p class="bl-services-viewing-hint">Scroll to explore</p>
        <div class="bl-services-viewing-progress" aria-hidden="true">
          <span
            class="bl-services-viewing-progress-fill"
            data-bl-viewing-progress
            style={`transform: scaleX(${1 / categoryCount})`}
          ></span>
        </div>
      </aside>

      <div class="bl-services-results">
        <header class="bl-services-menu-intro">
          <p class="bl-services-menu-eyebrow">Find your service</p>
          <h2 class="bl-services-menu-heading" id="blackline-service-menu-heading">Choose your finish.</h2>
          <p class="bl-services-menu-lede">
            The complete Blackline menu is on this page. Scroll to explore every cut, beard and grooming option.
          </p>
        </header>

        {
          groups.map((group, groupIndex) => (
            <section
              class="bl-service-group"
              id={demoServiceCategoryAnchorId(group.slug)}
              data-category-slug={group.slug}
              data-category-anchor={demoServiceCategoryAnchorId(group.slug)}
              data-category-label={group.label}
              data-count-label={group.countLabel}
              data-from-price={group.fromPriceLabel}
              data-index-label={group.indexLabel}
              data-category-index={String(groupIndex)}
              data-category-total={String(categoryCount)}
              aria-labelledby={`blackline-category-${group.slug}`}
            >
              <header class="bl-service-group-head">
                <h3 class="bl-service-group-name" id={`blackline-category-${group.slug}`}>
                  <span class="bl-service-group-index">{group.indexLabel}</span>
                  <span aria-hidden="true"> · </span>
                  {group.label}
                </h3>
                <p class="bl-service-group-count">{group.countLabel}</p>
                <p class="bl-service-group-desc">{group.description}</p>
              </header>

              <ol class="bl-services-list">
                {group.services.map((service, index) => (
                  <li
                    class="bl-service-item"
                    data-service-slug={service.slug}
                    data-service-name={service.name}
                    data-category-label={group.label}
                    data-duration={`${service.durationMinutes} min`}
                    data-price={formatDemoPriceGbp(service.pricePence)}
                    data-book-href={demoBookingHref(service.slug)}
                    style={`--bl-service-duration-ratio: ${demoServiceDurationRatio(service.durationMinutes, maxDuration)}; --bl-stagger-index: ${index}`}
                  >
                    <article class="bl-service-row" aria-labelledby={`blackline-service-${service.slug}`}>
                      <p class="bl-service-index">{demoServiceIndex(index)}</p>
                      <div class="bl-service-copy">
                        <div class="bl-service-name-row">
                          <h4 class="bl-service-name" id={`blackline-service-${service.slug}`}>
                            {service.name}
                          </h4>
                          {isDemoFeaturedService(service.id) ? <span class="bl-service-chip">Featured</span> : null}
                        </div>
                        <p class="bl-service-desc">{service.description}</p>
                      </div>
                      <p class="bl-service-duration">{service.durationMinutes} min</p>
                      <p class="bl-service-price">{formatDemoPriceGbp(service.pricePence)}</p>
                      <span class="bl-service-duration-track" aria-hidden="true">
                        <span class="bl-service-duration-fill"></span>
                      </span>
                      <a
                        class="bl-service-book"
                        href={demoBookingHref(service.slug)}
                        aria-label={demoServiceAccessibleName(service)}
                      >
                        <span>Book this service</span>
                        <span class="bl-service-arrow" aria-hidden="true"></span>
                      </a>
                    </article>
                  </li>
                ))}
              </ol>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</section>
