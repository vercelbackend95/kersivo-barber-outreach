---
import { DEMO_BOOK_HREF } from '@/lib/demo/nav';
---

<section
  class="bl-work-close"
  data-surface="dark"
  data-tone="graphite"
  data-bl-reveal
  aria-labelledby="blackline-gallery-close-heading"
>
  <div class="bl-container bl-work-close-inner">
    <p class="bl-work-close-eyebrow">Ready when you are</p>
    <h2 class="bl-work-close-heading" id="blackline-gallery-close-heading">Your turn in the chair.</h2>
    <p class="bl-work-close-lede">Choose your barber, service and time.</p>
    <a class="bl-btn bl-btn--primary bl-work-close-cta" href={DEMO_BOOK_HREF}>
      <span>Book an appointment</span>
      <span class="bl-work-close-arrow" aria-hidden="true"></span>
    </a>
  </div>
</section>
