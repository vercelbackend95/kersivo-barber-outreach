<div class="system-chooser" data-system-chooser hidden>
  <div class="system-chooser__backdrop" data-system-chooser-close aria-hidden="true"></div>
  <div class="system-chooser__glow" aria-hidden="true"></div>
  <section
    class="system-chooser__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="system-chooser-title"
    aria-describedby="system-chooser-description"
  >
    <div class="system-chooser__header">
      <div class="system-chooser__header-copy">
        <p class="system-chooser__eyebrow">Live product preview</p>
        <h2 id="system-chooser-title">See both sides of KERSIVO</h2>
        <p id="system-chooser-description" class="system-chooser__header-lead">
          Preview the client booking experience or the barbershop system. Each opens in a new tab.
        </p>
      </div>
      <button
        class="system-chooser__close"
        type="button"
        data-system-chooser-close
        aria-label="Close preview chooser"
      >
        <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="system-chooser__grid">

      <!-- Tile 1: Client Booking Experience -->
      <article
        class="system-chooser__tile system-chooser__tile--clients"
        role="link"
        tabindex="0"
        data-tile-href="/book"
        aria-label="Booking Experience — opens the client booking preview in a new tab"
      >
        <span class="system-chooser__tile-label">For clients</span>
        <h3 class="system-chooser__tile-title">Booking Experience</h3>
        <p class="system-chooser__tile-desc">See exactly what clients see when they book.</p>
        <p class="system-chooser__tile-meta">Client side &middot; New tab</p>
        <p class="system-chooser__tile-loading" role="status" aria-live="polite">
          <span class="system-chooser__tile-spinner" aria-hidden="true"></span>
          <span>Opening preview&hellip;</span>
        </p>
        <span class="system-chooser__tile-arrow" aria-hidden="true">&rarr;</span>
      </article>

      <!-- Tile 2: Admin & Shop System (bookings dashboard; shop lives in same admin) -->
      <article
        class="system-chooser__tile system-chooser__tile--barbers"
        role="link"
        tabindex="0"
        data-tile-href="/admin-demo?section=bookings_dashboard"
        aria-label="Admin & Shop System — opens the admin preview in a new tab"
      >
        <span class="system-chooser__tile-label">For barbers</span>
        <h3 class="system-chooser__tile-title">Admin &amp; Shop System</h3>
        <p class="system-chooser__tile-desc">See bookings, admin, reports and retail tools.</p>
        <p class="system-chooser__tile-meta">Shop side &middot; New tab</p>
        <p class="system-chooser__tile-loading" role="status" aria-live="polite">
          <span class="system-chooser__tile-spinner" aria-hidden="true"></span>
          <span>Opening preview&hellip;</span>
        </p>
        <span class="system-chooser__tile-arrow" aria-hidden="true">&rarr;</span>
      </article>

    </div>

    <p class="system-chooser__footer">No signup required. Both previews open in a new tab.</p>
  </section>
</div>
