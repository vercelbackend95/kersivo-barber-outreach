---
import InsightCards from '@/components/editorial/InsightCards.astro';
import { BOOKSY_WHY_INTRO, BOOKSY_WHY_THEMES } from '@/lib/seo/booksyAlternativeContent';
---

<section id="why-switch" class="fresha-alt__section" aria-labelledby="booksy-alt-why-title">
  <div class="container">
    <header class="fresha-alt__intro">
      <p class="fresha-alt__eyebrow">WHY BARBERS COMPARE</p>
      <h2 id="booksy-alt-why-title" class="fresha-alt__h2">
        Why UK barbers look for a Booksy alternative
      </h2>
      <p class="fresha-alt__lead">{BOOKSY_WHY_INTRO}</p>
    </header>

    <InsightCards items={BOOKSY_WHY_THEMES} />
  </div>
</section>
