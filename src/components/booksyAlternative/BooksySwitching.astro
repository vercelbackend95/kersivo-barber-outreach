---
import ProcessTimeline from '@/components/editorial/ProcessTimeline.astro';
import {
  BOOKSY_SWITCHING_LIMITS,
  BOOKSY_SWITCHING_REASSURANCE,
  BOOKSY_SWITCHING_STEPS,
} from '@/lib/seo/booksyAlternativeContent';
---

<section id="switching" class="fresha-alt__section" aria-labelledby="booksy-alt-switching-title">
  <div class="container">
    <header class="fresha-alt__intro">
      <p class="fresha-alt__eyebrow">MIGRATION</p>
      <h2 id="booksy-alt-switching-title" class="fresha-alt__h2">Switching from Booksy to KERSIVO</h2>
      <p class="fresha-alt-switching__reassurance">{BOOKSY_SWITCHING_REASSURANCE}</p>
    </header>

    <ProcessTimeline
      steps={BOOKSY_SWITCHING_STEPS}
      noteTitle="Good to know"
      notePoints={BOOKSY_SWITCHING_LIMITS}
    >
      <a href="#contact">Ask about moving your Booksy data <span aria-hidden="true">→</span></a>
    </ProcessTimeline>
  </div>
</section>
