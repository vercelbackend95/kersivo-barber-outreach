---
import ModelComparison from '@/components/editorial/ModelComparison.astro';
import { BOOKSY_FIT_CLOSING, BOOKSY_FIT_PATHS } from '@/lib/seo/booksyAlternativeContent';
---

<section id="which-model" class="fresha-alt__section" aria-labelledby="booksy-alt-fit-title">
  <div class="container">
    <header class="fresha-alt__intro">
      <p class="fresha-alt__eyebrow">TWO MODELS</p>
      <h2 id="booksy-alt-fit-title" class="fresha-alt__h2">Which model fits your barbershop?</h2>
    </header>

    <ModelComparison idPrefix="booksy-alt-fit" models={BOOKSY_FIT_PATHS} conclusion={BOOKSY_FIT_CLOSING}>
      Also considering <a href="/fresha-alternative">Fresha alternatives</a> or <a href="/squire-alternative">SQUIRE alternatives for UK barbers</a>? Explore another comparison <span aria-hidden="true">→</span>
    </ModelComparison>
  </div>
</section>
