---
import HeroDashboardShowcase from '@/components/marketing/HeroDashboardShowcase.astro';
import { BOOKSY_ALTERNATIVE_H1_LINES } from '@/lib/seo/booksyAlternativeFaq';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';

const [firstLine, secondLine, thirdLine] = BOOKSY_ALTERNATIVE_H1_LINES;
---

<section class="fresha-alt-hero" aria-labelledby="booksy-alt-hero-title">
  <div class="fresha-alt-hero__content">
    <p class="fresha-alt-hero__eyebrow">
      <span class="fresha-alt-hero__eyebrow-dot" aria-hidden="true"></span>
      Booksy alternative for UK barbershops
    </p>

    <h1 id="booksy-alt-hero-title" class="fresha-alt-hero__title">
      <span class="fresha-alt-hero__title-line fresha-alt-hero__title-line--primary">{firstLine}</span>
      <span class="fresha-alt-hero__title-line">{secondLine}</span>
      <span class="fresha-alt-hero__title-line">{thirdLine}</span>
    </h1>

    <p class="fresha-alt-hero__lead">
      Booksy pairs booking software with its Marketplace and customer app. KERSIVO takes a more
      direct route: start at £0/month on Starter with £5-deposit-or-full-payment bookings, or move
      the complete customer journey onto your own website and domain with Full KERSIVO for
      £{SAAS_MONTHLY_GBP}/month per location.
    </p>

    <div class="fresha-alt-hero__actions">
      <a
        href="/demo"
        class="fresha-alt-hero__action fresha-alt-hero__action--primary"
        data-track="view_live_demo_click"
      >
        See KERSIVO in Action
      </a>
      <a
        href="#comparison"
        class="fresha-alt-hero__action fresha-alt-hero__action--secondary"
      >
        Compare KERSIVO and Booksy
      </a>
    </div>

    <div class="fresha-alt-hero__meta" aria-label="KERSIVO commercial model">
      <span><strong>Starter £0/month</strong></span>
      <span aria-hidden="true">·</span>
      <span><strong>Full £{SAAS_MONTHLY_GBP}/month per location</strong></span>
      <span aria-hidden="true">·</span>
      <span>0% KERSIVO commission on booking payments</span>
      <span aria-hidden="true">·</span>
      <span>Built for independent UK barbershops</span>
    </div>
  </div>

  <HeroDashboardShowcase />
</section>
