---
import Footer50 from '@/components/footer50.astro';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import { getFooterSocialLinks } from '@/lib/seo/footerSocialLinks';

const currentYear = new Date().getFullYear();
---

<Footer50
  showIntro={true}
  heading="Your brand. Your bookings. 0% KERSIVO commission."
  description={`Full KERSIVO is £${SAAS_MONTHLY_GBP}/month per location. Your website is typically ready 1–2 weeks after we receive all required information. Standard Stripe processing fees apply to online payments.`}
  ctaText="See pricing"
  ctaHref="/pricing"
  ctaIsDemo={false}
  ctaTrack="plan_my_setup_click"
  brandName="KERSIVO"
  copyright={`© ${currentYear} KERSIVO`}
  social={getFooterSocialLinks()}
/>
