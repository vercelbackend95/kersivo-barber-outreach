---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props as Props;

const ownBrandReasons = [
  {
    title: 'A real website for YOUR barbershop—not a tucked-away cloud screen',
    body: 'Guests book on your domain in the browser using a branded, barber-shop flow tailored to your chairs and services. It reads as yours on the doorstep of Google—not a generic tenant inside an app marketplace.',
  },
  {
    title: 'Returning clients ride the same URL; Kersivo take stays at 0%',
    body: 'Every repeat cut goes through your own booking surface. Predictable margins on bookings and retail from day one—with no incremental platform commission from us.',
  },
  {
    title: 'Compounding upside lives on assets you actually own',
    body: 'Search visibility, Maps presence, SMS opt-ins and review history reinforce your trading name—not a directory\u2019s brand. Growing the base you keep matters more every year.',
  },
];

const launchExtras = [
  'Branded booking website on your URL—looks like YOUR shop online, built for bookings + retail cues',
  'Google Business Profile setup so people find you on Maps alongside your owned domain flow',
  'Stripe deposits from booking \u2014 fewer no-shows from day one',
  'SMS reminders, win-back nudges, and review requests baked into the workflow',
];
---

<section
  id="newcomer-path"
  class={`newcomer-path scroll-mt-24 ${className}`.trim()}
  aria-labelledby="newcomer-path-title"
>
  <div class="newcomer-path__backdrop" aria-hidden="true">
    <div class="newcomer-path__halftone"></div>
    <div class="newcomer-path__glow"></div>
  </div>

  <div class="container">
    <header class="newcomer-path__intro">
      <p class="newcomer-path__eyebrow">FOR NEW SHOPS &middot; NO SYSTEM YET</p>
    </header>

    <div class="newcomer-path__spread">
      <div class="newcomer-path__pov-col">
        <div class="newcomer-path__pov-frame">
          <div class="newcomer-path__pov-halftone newcomer-path__pov-halftone--tl" aria-hidden="true"></div>
          <div class="newcomer-path__pov-halftone newcomer-path__pov-halftone--br" aria-hidden="true"></div>
          <img
            src="/images/Ilustracje/POV.png"
            alt="POV: barber in the chair checking bookings on a tablet — your shop, your system"
            class="newcomer-path__pov-img"
            width="1536"
            height="1024"
            loading="lazy"
            draggable="false"
          />
        </div>
        <p class="newcomer-path__bubble" role="note">
          Open the tablet.<br />That&apos;s your shop.
        </p>
      </div>

      <div class="newcomer-path__copy-col">
        <h2 id="newcomer-path-title" class="newcomer-path__heading">
          Day one starts in your chair &mdash; not in a marketplace queue.
        </h2>
        <p class="newcomer-path__lead">
          We deliver a branded booking website on your domain &mdash; front-of-house polish with admin in the browser.
          Your list, your URL, 0% booking take from Kersivo.
        </p>

        <div class="newcomer-path__pull-quotes" aria-label="Key launch facts">
          <p class="newcomer-path__pull newcomer-path__pull--zero">
            <span class="newcomer-path__pull-value">0%</span>
            <span class="newcomer-path__pull-label">from us</span>
          </p>
          <p class="newcomer-path__pull newcomer-path__pull--days">
            <span class="newcomer-path__pull-value">~14</span>
            <span class="newcomer-path__pull-label">days to live</span>
          </p>
        </div>
      </div>
    </div>

    <ul class="newcomer-path__beats" role="list" aria-label="Why own your brand URL">
      {ownBrandReasons.map((reason, index) => (
        <li class={`newcomer-path__beat newcomer-path__beat--${index + 1}`}>
          <span class="newcomer-path__beat-num" aria-hidden="true">{`0${index + 1}`}</span>
          <div class="newcomer-path__beat-inner">
            <p class="newcomer-path__beat-title">{reason.title}</p>
            <p class="newcomer-path__beat-body">{reason.body}</p>
          </div>
        </li>
      ))}
    </ul>

    <aside class="newcomer-path__manifest" aria-label="What you get from day one">
      <p class="newcomer-path__manifest-kicker">From booking #1</p>
      <ul class="newcomer-path__manifest-list" role="list">
        {launchExtras.map((extra) => (
          <li class="newcomer-path__manifest-item">
            <span class="newcomer-path__manifest-bullet" aria-hidden="true"></span>
            {extra}
          </li>
        ))}
      </ul>
    </aside>

    <div class="newcomer-path__cta-block">
      <a href="#book-demo" class="btn btn--primary btn--lg" data-demo-cta>Plan my setup &mdash; free</a>
      <button type="button" class="btn btn--secondary btn--lg" data-system-chooser-open>
        Open the live admin
      </button>
      <p class="newcomer-path__footnote">
        Most shops go live in about two weeks. We confirm your timeline before you commit, and you stay in control of when you go live.
      </p>
    </div>
  </div>
</section>
