---
interface Props {
  className?: string;
}

type DayOneIcon =
  | 'booking'
  | 'admin'
  | 'shop'
  | 'sms'
  | 'shield'
  | 'reports';

interface DayOneItem {
  icon: DayOneIcon;
  title: string;
  body: string;
}

const { className = '' } = Astro.props as Props;

// "Menu board" — everything live on day one. Rewritten for conviction.
const dayOneItems: DayOneItem[] = [
  {
    icon: 'booking',
    title: 'Your own booking site',
    body: 'On your domain, three-tap flow — no app-store detour, no marketplace.',
  },
  {
    icon: 'admin',
    title: 'One-login floor admin',
    body: 'Bookings, barbers, services and clients in a single panel.',
  },
  {
    icon: 'shop',
    title: 'Buy-and-collect shop',
    body: 'Pomades, oils and gift sets — 0% Kersivo on every retail order.',
  },
  {
    icon: 'sms',
    title: 'SMS that fills chairs',
    body: 'Reminders, win-backs and review nudges from booking #1.',
  },
  {
    icon: 'shield',
    title: 'No-show protection',
    body: 'Stripe deposits on your rules — stop eating empty slots.',
  },
  {
    icon: 'reports',
    title: 'End-of-day clarity',
    body: 'Today\u2019s takings and tomorrow\u2019s book in one glance.',
  },
];

const ownBrandReasons = [
  {
    title: 'A real website for YOUR barbershop—not a tucked-away cloud screen',
    body: 'Guests book on your domain in the browser using a branded, barber-shop flow tailored to your chairs and services. It reads as yours on the doorstep of Google—not a generic tenant inside an app marketplace.',
  },
  {
    title: 'Returning clients ride the same URL; Kersivo take stays at 0%',
    body: 'Every repeat cut goes through your own booking surface. Predictable margins on bookings and retail from day one—with no incremental platform commission from us.',
  },
  {
    title: 'Compounding upside lives on assets you actually own',
    body: 'Search visibility, Maps presence, SMS opt-ins and review history reinforce your trading name—not a directory\u2019s brand. Growing the base you keep matters more every year.',
  },
];
---

<section
  id="newcomer-path"
  class={`newcomer-path scroll-mt-24 ${className}`.trim()}
  aria-labelledby="newcomer-path-title"
>
  <div class="newcomer-path__stage" aria-hidden="true"></div>
  <div class="newcomer-path__glow" aria-hidden="true"></div>

  <!-- Hero collage — left copy aligns to container, right media bleeds to edge -->
  <div class="newcomer-path__hero">
    <div class="newcomer-path__hero-copy">
      <p class="newcomer-path__kicker">
        <span class="newcomer-path__kicker-sign">
          <span class="newcomer-path__kicker-dot" aria-hidden="true"></span>
          Grand opening
        </span>
        <span class="newcomer-path__kicker-meta">For new shops &middot; No system yet</span>
      </p>

      <h2 id="newcomer-path-title" class="newcomer-path__heading">
        Open the doors<br />on a <em class="newcomer-path__accent">full house.</em>
      </h2>

      <p class="newcomer-path__lead">
        The complete Kersivo stack goes live before you flip the sign &mdash; branded booking, floor
        admin, retail, SMS, deposits and daily reports. Not a trial. Not half a system. The exact
        setup switchers pay to move to &mdash; yours from booking #1.
      </p>

      <ul class="newcomer-path__bombs" role="list">
        <li class="newcomer-path__bomb">0% Kersivo commission</li>
        <li class="newcomer-path__bomb">Live in ~2 weeks</li>
        <li class="newcomer-path__bomb">Your domain, your list</li>
      </ul>
    </div>

    <div class="newcomer-path__media" aria-hidden="true">
      <div class="newcomer-path__media-glow"></div>
      <img
        src="/images/Ilustracje/POV.webp"
        alt=""
        class="newcomer-path__shot"
        width="1536"
        height="1024"
        loading="lazy"
        draggable="false"
      />
    </div>
  </div>

  <div class="container">
    <!-- Menu board — everything included, styled like a barbershop service list -->
    <div class="newcomer-path__board">
      <div class="newcomer-path__board-head">
        <p class="newcomer-path__board-title">Everything. Day one.</p>
        <p class="newcomer-path__board-sub">No add-ons, no tiers to unlock.</p>
      </div>
      <ul class="newcomer-path__board-list" role="list" aria-label="Everything included at launch">
        {dayOneItems.map((item) => (
          <li class="newcomer-path__board-row">
            <span class="newcomer-path__board-icon" aria-hidden="true">
              {item.icon === 'booking' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" />
                  <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
              )}
              {item.icon === 'admin' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="9" rx="1" />
                  <rect x="14" y="3" width="7" height="5" rx="1" />
                  <rect x="14" y="12" width="7" height="9" rx="1" />
                  <rect x="3" y="16" width="7" height="5" rx="1" />
                </svg>
              )}
              {item.icon === 'shop' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
                  <path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
                </svg>
              )}
              {item.icon === 'sms' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                  <path d="M8 10h.01M12 10h.01M16 10h.01" />
                </svg>
              )}
              {item.icon === 'shield' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
              )}
              {item.icon === 'reports' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 3v18h18" />
                  <path d="M18 17V9M13 17V5M8 17v-3" />
                </svg>
              )}
            </span>
            <span class="newcomer-path__board-text">
              <span class="newcomer-path__board-feature">{item.title}</span>
              <span class="newcomer-path__board-note">{item.body}</span>
            </span>
            <span class="newcomer-path__board-tag">
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="newcomer-path__board-tag-label">Included</span>
            </span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Beats — unchanged -->
    <ul class="newcomer-path__beats" role="list" aria-label="Why own your brand URL">
      {ownBrandReasons.map((reason, index) => (
        <li class={`newcomer-path__beat newcomer-path__beat--${index + 1}`}>
          <span class="newcomer-path__beat-num" aria-hidden="true">{`0${index + 1}`}</span>
          <div class="newcomer-path__beat-inner">
            <p class="newcomer-path__beat-title">{reason.title}</p>
            <p class="newcomer-path__beat-body">{reason.body}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="newcomer-path__cta-block">
      <ul class="newcomer-path__conviction" role="list">
        <li class="newcomer-path__conviction-item">~2 weeks to live</li>
        <li class="newcomer-path__conviction-item">0% Kersivo commission</li>
        <li class="newcomer-path__conviction-item">You own the data</li>
        <li class="newcomer-path__conviction-item">Cancel Ongoing Care anytime</li>
      </ul>
      <div class="newcomer-path__cta-actions">
        <a href="#book-demo" class="btn btn--primary btn--lg" data-demo-cta>Plan my setup &mdash; free</a>
        <button type="button" class="btn btn--secondary btn--lg" data-system-chooser-open>
          View Admin Demo
        </button>
      </div>
      <p class="newcomer-path__footnote">
        Most shops go live in about two weeks. We confirm your timeline before you commit &mdash; and
        you decide the day you open.
      </p>
    </div>
  </div>
</section>
