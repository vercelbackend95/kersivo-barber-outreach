---
import { buildEntryPointsExample } from '@/lib/barbershopOnlineBooking/entryPointsExample';
import '@/styles/components/barbershop-online-booking-entry.css';

const example = buildEntryPointsExample();
---

<section class="bob-ep" aria-labelledby="bob-ep-title">
  <div class="bob-ep__inner">
    <header class="bob-ep__head">
      <p class="bob-ep__eyebrow">Where bookings start</p>
      <h2 id="bob-ep-title" class="bob-ep__title">One Booking Journey, Several Ways to Reach It</h2>
      <p class="bob-ep__lead">
        Put your booking link on your website, add it to your Google Business Profile or social bio, or use it
        with a shop QR code. Google booking-link setup is guided, not a native booking integration.
      </p>
    </header>

    <div class="bob-ep-stage">
      <ul class="bob-ep-sources" role="list">
        {
          example.channels.map((channel, index) => (
            <li class={`bob-ep-source bob-ep-source--${channel.id}`}>
              <div class="bob-ep-source__visual" aria-hidden="true">
                {channel.visual.kind === 'website' && (
                  <span class="bob-ep-viz bob-ep-viz--website">
                    <img
                      class="bob-ep-viz__hero"
                      src={channel.visual.heroSrc}
                      alt=""
                      width="900"
                      height="1350"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="bob-ep-viz__chrome">
                      <img
                        class="bob-ep-viz__logo"
                        src={channel.visual.logoSrc}
                        alt=""
                        width="217"
                        height="72"
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="bob-ep-viz__book">{channel.visual.bookLabel}</span>
                    </span>
                    <span class="bob-ep-viz__shop">{channel.visual.shopName}</span>
                  </span>
                )}

                {channel.visual.kind === 'google' && (
                  <span class="bob-ep-viz bob-ep-viz--google">
                    <img
                      class="bob-ep-viz__mark"
                      src={channel.visual.markSrc}
                      alt=""
                      width="192"
                      height="192"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                )}

                {channel.visual.kind === 'instagram' && (
                  <span class="bob-ep-viz bob-ep-viz--instagram">
                    <span class="bob-ep-ig">
                      <span class="bob-ep-ig__head">
                        <span class="bob-ep-ig__ring">
                          <img
                            class="bob-ep-ig__avatar"
                            src={channel.visual.avatarSrc}
                            alt=""
                            width="72"
                            height="72"
                            loading="lazy"
                            decoding="async"
                          />
                        </span>
                        <span class="bob-ep-ig__meta">
                          <span class="bob-ep-ig__name">{channel.visual.shopName}</span>
                          <span class="bob-ep-ig__handle">{channel.visual.handle}</span>
                        </span>
                      </span>
                      <span class="bob-ep-ig__book">{channel.visual.bookLabel}</span>
                      <span class="bob-ep-ig__grid">
                        {channel.visual.gridSrcs.map((src) => (
                          <img
                            class="bob-ep-ig__cell"
                            src={src}
                            alt=""
                            width="200"
                            height="200"
                            loading="lazy"
                            decoding="async"
                          />
                        ))}
                      </span>
                    </span>
                  </span>
                )}

                {channel.visual.kind === 'qr' && (
                  <span class="bob-ep-viz bob-ep-viz--qr">
                    <img
                      class="bob-ep-viz__qr"
                      src={channel.visual.src}
                      alt=""
                      width={channel.visual.width}
                      height={channel.visual.height}
                      loading="lazy"
                      decoding="async"
                      style={`object-position: ${channel.visual.objectPosition}`}
                    />
                  </span>
                )}
              </div>
              <p class="bob-ep-source__meta">
                <span class="bob-ep-source__index">{String(index + 1).padStart(2, '0')}</span>
                <span class="bob-ep-source__name">{channel.shortLabel}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
