---
/**
 * 06 · Where bookings start: four places one link lives, pulsing into one booking page and one
 * diary (a hub diagram with a pause control). 07 · After the booking: confirmation, diary,
 * reminder and change request, in order.
 */
import { heritageAdminHref } from '@/lib/admin/demoConfig';
import { BOB_AFTER, BOB_CHANNELS, BOB_CHANNELS_SECTION } from '@/lib/seo/barbershopOnlineBookingContent';
import { buildBookingSimulatorData, minuteLabel, offeredStarts } from '@/lib/barbershopOnlineBooking/bookingSimulator';
import { HERITAGE_DEMO_BOOK_HREF } from '@/lib/demo/heritage/links';
import { encodeQr, qrSvgPath } from '@/lib/qr/qrSvg';
import { getPublicSiteUrl } from '@/lib/setup/siteUrl';

const TRACK_EVENT = 'view_live_demo_click';
const TRACK_PLACEMENT = 'barbershop_online_booking_after';
const OWNER_TIMELINE_HREF = heritageAdminHref('bookings_dashboard');

/* Instagram and TikTok glyphs are the same paths the site footer uses. */
const TIKTOK =
  'M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z';
const ARROW =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>';

/* A real, scannable code: it opens the demo shop's booking page. */
const qr = qrSvgPath(encodeQr(new URL(HERITAGE_DEMO_BOOK_HREF, getPublicSiteUrl()).toString()));

/* The diary node: a slice of one barber's demo day, drawn like the KERSIVO owner timeline. */
const sim = buildBookingSimulatorData();
const kit = sim.barbers.find((b) => b.firstName === 'Kit') ?? sim.barbers.find((b) => b.working)!;
const skinFade = sim.services.find((s) => s.name === 'Skin fade') ?? sim.services[0]!;
const newStart = offeredStarts(kit.appointments, sim.open, sim.close, skinFade.duration).find((m) => m >= 12 * 60) ?? kit.appointments[0]!.start;
const before = kit.appointments.filter((a) => a.start < newStart).slice(-2);
const miniRows = [
  ...before.map((a) => ({ start: a.start, end: a.end, service: a.service, isNew: false })),
  { start: newStart, end: newStart + skinFade.duration, service: skinFade.name, isNew: true },
];

/* Source rows sit at 12.5 / 37.5 / 62.5 / 87.5 % of the diagram height. */
const ROWS = [12.5, 37.5, 62.5, 87.5];
---

<section class="bob-section bob-reach" id={BOB_CHANNELS_SECTION.id} aria-labelledby="bob-reach-title">
  <div class="bob-wrap">
    <header class="bob-head bob-head--split">
      <div>
        <p class="ks-eyebrow">{BOB_CHANNELS_SECTION.eyebrow}</p>
        <h2 id="bob-reach-title" class="bob-h2">{BOB_CHANNELS_SECTION.title}</h2>
      </div>
      <p class="bob-lead">{BOB_CHANNELS_SECTION.lead}</p>
    </header>

    <div class="bob-hub" data-bob-hub>
      <svg class="bob-hub__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        {ROWS.map((y) => (
          <g>
            <path class="bob-hub__wire" d={`M 37 ${y} C 43 ${y}, 42.5 50, 48.3 50`} pathLength="100" vector-effect="non-scaling-stroke" />
            <path class="bob-hub__pulse" d={`M 37 ${y} C 43 ${y}, 42.5 50, 48.3 50`} pathLength="100" vector-effect="non-scaling-stroke" />
          </g>
        ))}
        <path class="bob-hub__wire" d="M 71.6 50 L 76.8 50" pathLength="100" vector-effect="non-scaling-stroke" />
        <path class="bob-hub__pulse bob-hub__pulse--out" d="M 71.6 50 L 76.8 50" pathLength="100" vector-effect="non-scaling-stroke" />
      </svg>

      <ul class="bob-hub__sources">
        {BOB_CHANNELS.map((channel) => (
          <li class="bob-source" id={`channel-${channel.id}`}>
            <span class:list={['bob-source__icon', `bob-source__icon--${channel.id}`]} aria-hidden="true">
              {channel.id === 'website' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2.5" /><path d="M3 9h18" /><path d="M6.5 6.5h.01M9 6.5h.01" /></svg>
              )}
              {channel.id === 'google' && (
                <img src="/images/starter/google-g-192.webp" alt="" width="192" height="192" loading="lazy" decoding="async" />
              )}
              {channel.id === 'social' && (
                <span class="bob-source__pair">
                  <svg class="bob-source__ig" viewBox="0 0 24 24" focusable="false">
                    <defs>
                      <radialGradient id="bob-ig-grad" cx="30%" cy="107%" r="150%">
                        <stop offset="0" stop-color="#fdf497" /><stop offset="0.05" stop-color="#fdf497" />
                        <stop offset="0.45" stop-color="#fd5949" /><stop offset="0.6" stop-color="#d6249f" />
                        <stop offset="0.9" stop-color="#285AEB" />
                      </radialGradient>
                    </defs>
                    <rect x="1" y="1" width="22" height="22" rx="6.5" fill="url(#bob-ig-grad)" />
                    <rect x="5.5" y="5.5" width="13" height="13" rx="4" fill="none" stroke="#fff" stroke-width="1.8" />
                    <circle cx="12" cy="12" r="3.2" fill="none" stroke="#fff" stroke-width="1.8" />
                    <circle cx="16.4" cy="7.6" r="0.95" fill="#fff" />
                  </svg>
                  <svg class="bob-source__tt" viewBox="0 0 24 24" focusable="false">
                    <rect width="24" height="24" rx="6" fill="#000" />
                    <g transform="translate(3.2 3) scale(0.75)">
                      <path d={TIKTOK} fill="#25F4EE" transform="translate(-0.9 -0.9)" />
                      <path d={TIKTOK} fill="#FE2C55" transform="translate(0.9 0.9)" />
                      <path d={TIKTOK} fill="#fff" />
                    </g>
                  </svg>
                </span>
              )}
              {channel.id === 'qr' && (
                <svg class="bob-source__qr" viewBox={qr.viewBox} shape-rendering="crispEdges" focusable="false"><rect width="100%" height="100%" fill="#fff" /><path d={qr.d} fill="#0b0b0c" /></svg>
              )}
            </span>
            <span class="bob-source__text">
              <h3 class="bob-source__title">{channel.title}</h3>
              <p>{channel.body}</p>
            </span>
          </li>
        ))}
      </ul>

      <div class="bob-hub__core" aria-hidden="true">
        <div class="bob-node bob-node--page">
          <p class="bob-node__label">One booking page</p>
          <p class="bob-node__url"><span class="bob-node__lock"></span>yourshop.co.uk/book</p>
          <ol class="bob-node__steps"><li>Service</li><li>Barber</li><li>Time</li><li class="bob-node__confirm">Confirm</li></ol>
        </div>
        <div class="bob-node bob-node--diary">
          <p class="bob-node__label">One diary <span class="bob-node__live"><i></i>Live</span></p>
          <div class="bob-mini-tl">
            {miniRows.map((row, i) => (
              <div class:list={['bob-mini-tl__row', { 'is-new': row.isNew, 'is-past': i === 0 }]}>
                <span class="bob-mini-tl__time">{minuteLabel(row.start)}</span>
                <span class="bob-mini-tl__lane">
                  <span class="bob-mini-tl__meta"><b>{row.isNew ? 'New online booking' : row.service}</b><small>{row.isNew ? `${row.service} · ${kit.firstName}` : `with ${kit.firstName}`}</small></span>
                  <span class="bob-mini-tl__track"><span class="bob-mini-tl__fill"></span><img src={kit.thumb} alt="" width="160" height="160" loading="lazy" decoding="async" /></span>
                </span>
                <span class="bob-mini-tl__end">{minuteLabel(row.end)}</span>
              </div>
            ))}
            <span class="bob-mini-tl__now" aria-hidden="true"></span>
          </div>
        </div>
      </div>

      <button type="button" class="bob-hub__pause" data-bob-hub-pause aria-pressed="false">
        <span class="bob-hub__pause-icon" aria-hidden="true"></span><span data-bob-hub-pause-label>Pause animation</span>
      </button>
    </div>
  </div>
</section>

<section class="bob-section bob-after" id={BOB_AFTER.id} aria-labelledby="bob-after-title">
  <div class="bob-wrap">
    <header class="bob-head bob-head--split">
      <div>
        <p class="ks-eyebrow">{BOB_AFTER.eyebrow}</p>
        <h2 id="bob-after-title" class="bob-h2">{BOB_AFTER.title}</h2>
      </div>
      <p class="bob-lead">
        {BOB_AFTER.lead} Need wording for deposits and no-shows? Use our
        <a class="bob-link" href={BOB_AFTER.policyLink.href}>{BOB_AFTER.policyLink.label}</a>.
      </p>
    </header>

    <ol class="bob-after__line">
      {BOB_AFTER.steps.map((step, i) => (
        <li class="bob-after__step" style={`--i:${i}`}>
          <span class="bob-after__dot" aria-hidden="true"></span>
          <p class="bob-after__when">{step.when}</p>
          <h3 class="bob-after__title">{step.title}</h3>
          <p class="bob-after__body">{step.body}</p>
        </li>
      ))}
    </ol>

    <a class="bob-textlink" href={OWNER_TIMELINE_HREF} data-track={TRACK_EVENT} data-track-placement={TRACK_PLACEMENT}>
      {BOB_AFTER.diaryLabel}<span class="bob-textlink__arrow" set:html={ARROW} />
    </a>
  </div>
</section>
