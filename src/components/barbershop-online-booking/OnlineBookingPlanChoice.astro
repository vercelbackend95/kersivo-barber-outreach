---
import FullPlanCta from '@/components/cta/FullPlanCta.astro';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import { PLAN_CHOICE_INTENTS, buildPlanChoiceContent } from '@/lib/barbershopOnlineBooking/planChoiceContent';
import '@/styles/components/barbershop-online-booking-plan-choice.css';

const content = buildPlanChoiceContent();
const PLAN_CHOICE_TRACK_PLACEMENT = 'barbershop_online_booking_chooser';
// FREE_PREVIEW_FLOW_ENABLED replaces the Full primary CTA (docs/free-preview-spec.md §10.2).
const freePreview = isFreePreviewFlowEnabled();
---

<section class="bob-pc" id={content.sectionId} aria-labelledby="bob-pc-title">
  <div class="bob-pc__inner">
    <header class="bob-pc__head">
      <p class="bob-pc__eyebrow">Choose your setup</p>
      <h2 id="bob-pc-title" class="bob-pc__title">{content.h2}</h2>
      <p class="bob-pc__lead">{content.lead}</p>
    </header>

    <div class="bob-pc-intents">
      {PLAN_CHOICE_INTENTS.map((option) => (
        <article
          class:list={['bob-pc-intent', `bob-pc-intent--${option.id}`]}
          aria-labelledby={`bob-pc-intent-${option.id}`}
        >
          <p class="bob-pc-intent__label">
            <span>{option.label}</span>
            <span class="bob-pc-intent__price">{option.price}</span>
          </p>
          <h3 id={`bob-pc-intent-${option.id}`} class="bob-pc-intent__heading">{option.heading}</h3>
          <ul class="bob-pc-intent__list">
            {option.intents.map((intent) => <li>{intent}</li>)}
          </ul>
          <div class="bob-pc-intent__actions">
            {freePreview && option.id === 'full' ? (
              <FullPlanCta
                part="primary"
                primaryClass="bob-pc-intent__cta bob-pc-intent__cta--primary"
                placement={PLAN_CHOICE_TRACK_PLACEMENT}
              />
            ) : (
            <a
              href={option.primary.href}
              class:list={['bob-pc-intent__cta', { 'bob-pc-intent__cta--primary': option.id === 'full' }]}
              data-track={option.primary.trackEvent}
              data-track-placement={PLAN_CHOICE_TRACK_PLACEMENT}
            >
              {option.primary.label}{option.id === 'starter' && <span aria-hidden="true">→</span>}
            </a>
            )}
            {option.secondary && (
              <a
                href={option.secondary.href}
                class="bob-pc-intent__cta"
                data-track={option.secondary.trackEvent}
                data-track-placement={PLAN_CHOICE_TRACK_PLACEMENT}
              >
                {option.secondary.label} <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
          {freePreview && option.id === 'full' && (
            <FullPlanCta part="subscribe" placement={PLAN_CHOICE_TRACK_PLACEMENT} />
          )}
        </article>
      ))}
    </div>

    <div class="bob-pc-disclosure">
      <p class="bob-pc-disclosure__label">Before you choose</p>
      <ul class="bob-pc-disclosure__list">
        {content.disclosure.map((line) => (
          <li>{line}</li>
        ))}
      </ul>
    </div>

    <div class="bob-pc-faq">
      <h3 class="bob-pc-faq__title">A Few Things Worth Knowing.</h3>
      <div class="bob-pc-faq__list">
        {content.faqs.map((faq) => (
          <details class="bob-pc-faq__item" name="bob-pc-faq">
            <summary class="bob-pc-faq__summary">
              <span class="bob-pc-faq__question">{faq.question}</span>
              <span class="bob-pc-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="bob-pc-faq__answer">
              {faq.answer.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </details>
        ))}
      </div>
    </div>

    <p class="bob-pc__close">{content.close}</p>
  </div>
</section>
