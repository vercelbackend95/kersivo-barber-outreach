---
import { blacklineAdminHref } from '@/lib/admin/demoConfig';
import { buildAfterBookingExample } from '@/lib/barbershopOnlineBooking/afterBookingExample';
import { DEMO_SHOP_NAME } from '@/lib/demo/site';
import '@/styles/components/barbershop-online-booking-after.css';

const TRACK_EVENT = 'view_live_demo_click';
const TRACK_PLACEMENT = 'barbershop_online_booking_after';
const OWNER_TIMELINE_HREF = blacklineAdminHref('bookings_dashboard');

const example = buildAfterBookingExample();
const confirmScene = example.scenes.find((scene) => scene.id === 'confirmReminder')!;
const thanksScene = example.scenes.find((scene) => scene.id === 'thanksReview')!;
const rebookScene = example.scenes.find((scene) => scene.id === 'rebook')!;

const ARROW =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
---

<section class="bob-ab" data-bob-ab aria-labelledby="bob-ab-title" style="--bob-ab-p: 0">
  <div class="bob-ab__inner">
    <header class="bob-ab__head">
      <p class="bob-ab__eyebrow">After the booking</p>
      <h2 id="bob-ab-title" class="bob-ab__title">The Next Booking Starts With the Last Visit.</h2>
      <p class="bob-ab__support">Keep the connection. Make it easy to come back.</p>
    </header>

    <p class="bob-ab-handoff">
      <span class="bob-ab-handoff__from">From the booking journey</span>
      <span class="bob-ab-handoff__chip">
        <span class="bob-ab-handoff__status">{confirmScene.statusLabel}</span>
        <span class="bob-ab-handoff__label">{example.handoffLabel}</span>
      </span>
    </p>

    <div class="bob-ab-story" data-bob-ab-track>
      <div class="bob-ab-stage">
        <!-- Scene A: confirm + reminder SMS -->
        <article
          class="bob-ab-scene bob-ab-scene--a"
          data-bob-ab-scene="confirmReminder"
          aria-label="Confirmation and appointment reminder"
        >
          <p class="bob-ab-scene__status bob-ab-scene__status--live">{confirmScene.statusLabel}</p>
          <p class="bob-ab-scene__shop">{DEMO_SHOP_NAME}</p>
          <p class="bob-ab-scene__confirm">{example.confirmationSubject}</p>
          <div class="bob-ab-sms" aria-label="Illustrative SMS reminder">
            <p class="bob-ab-sms__from">{DEMO_SHOP_NAME}</p>
            <p class="bob-ab-sms__body">{example.smsPreviewLine}</p>
          </div>
          <p class="bob-ab-scene__body">{example.emailReminderNote}</p>
          <p class="bob-ab-scene__note">
            <span class="bob-ab-scene__note-label">Full SMS</span>
            {example.smsNote}
          </p>
        </article>

        <!-- Scene B: thank-you + Google review -->
        <article
          class="bob-ab-scene bob-ab-scene--b"
          data-bob-ab-scene="thanksReview"
          aria-label="Thank you and Google review"
        >
          <p class="bob-ab-scene__status bob-ab-scene__status--planned">{thanksScene.statusLabel}</p>
          <p class="bob-ab-scene__display">{thanksScene.display}</p>
          <p class="bob-ab-scene__title">{thanksScene.title}</p>
          {thanksScene.body && <p class="bob-ab-scene__body">{thanksScene.body}</p>}
          <div class="bob-ab-review">
            <img
              class="bob-ab-review__mark"
              src={example.googleMarkSrc}
              alt=""
              width="40"
              height="40"
              decoding="async"
              loading="lazy"
            />
            <p class="bob-ab-review__cta" aria-hidden="true">{thanksScene.ctaLabel}</p>
          </div>
        </article>

        <!-- Scene C: book again -->
        <article
          class="bob-ab-scene bob-ab-scene--c"
          data-bob-ab-scene="rebook"
          aria-label="Book again"
        >
          <p class="bob-ab-scene__status bob-ab-scene__status--planned">{rebookScene.statusLabel}</p>
          <p class="bob-ab-scene__display">{rebookScene.display}</p>
          <p class="bob-ab-scene__title">{rebookScene.title}</p>
          <p class="bob-ab-rebook__cta" aria-hidden="true">{rebookScene.ctaLabel}</p>
        </article>
      </div>
    </div>

    <div class="bob-ab-foot">
      <p class="bob-ab__disclosure">{example.disclosure}</p>
      <a
        class="bob-ab__cta"
        href={OWNER_TIMELINE_HREF}
        data-track={TRACK_EVENT}
        data-track-placement={TRACK_PLACEMENT}
      >
        Explore the admin demo
        <span class="bob-ab__cta-icon" set:html={ARROW} />
      </a>
    </div>
  </div>
</section>

<script>
  import { bindAfterBookingScroll } from '@/lib/barbershopOnlineBooking/afterBookingScroll';

  bindAfterBookingScroll();
  document.addEventListener('astro:page-load', () => bindAfterBookingScroll());
</script>
