---
import { blacklineAdminHref } from '@/lib/admin/demoConfig';
import { buildAfterBookingExample } from '@/lib/barbershopOnlineBooking/afterBookingExample';
import '@/styles/components/barbershop-online-booking-after.css';

const TRACK_EVENT = 'view_live_demo_click';
const TRACK_PLACEMENT = 'barbershop_online_booking_after';
const OWNER_TIMELINE_HREF = blacklineAdminHref('bookings_dashboard');

const example = buildAfterBookingExample();
const thanks = example.moments.find((moment) => moment.id === 'thanks')!;
const review = example.moments.find((moment) => moment.id === 'review')!;
const rebook = example.moments.find((moment) => moment.id === 'rebook')!;

const ARROW =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
---

<section class="bob-ab" aria-labelledby="bob-ab-title">
  <div class="bob-ab__inner">
    <header class="bob-ab__head">
      <p class="bob-ab__eyebrow">After the visit</p>
      <h2 id="bob-ab-title" class="bob-ab__title">The Next Booking Starts With the Last Visit.</h2>
      <p class="bob-ab__lead">
        Once the cut is done, keep the connection — thank the client, invite an honest review, and make coming back easy.
      </p>
    </header>

    <div class="bob-ab-showcase" aria-label="Post-visit communication concepts">
      <div class="bob-ab-showcase__banner">
        <p class="bob-ab-concept">{example.conceptStatus}</p>
        <p class="bob-ab-showcase__note">{example.disclosure}</p>
      </div>

      <!-- Moment 01: Thank-you email -->
      <article class="bob-ab-beat bob-ab-beat--thanks" aria-label="Thank you after the visit">
        <div class="bob-ab-beat__copy">
          <span class="bob-ab-beat__index">{thanks.index}</span>
          <p class="bob-ab-display">{thanks.display}</p>
          {thanks.support && <p class="bob-ab-beat__support">{thanks.support}</p>}
        </div>

        {thanks.thanksPreview && (
          <div class="bob-ab-mail" aria-hidden="true">
            <div class="bob-ab-mail__chrome">
              <span class="bob-ab-mail__dot"></span>
              <span class="bob-ab-mail__dot"></span>
              <span class="bob-ab-mail__dot"></span>
              <span class="bob-ab-mail__kind">Email</span>
            </div>
            <dl class="bob-ab-mail__meta">
              <div class="bob-ab-mail__row">
                <dt>{thanks.thanksPreview.fromLabel}</dt>
                <dd>{thanks.thanksPreview.from}</dd>
              </div>
              <div class="bob-ab-mail__row">
                <dt>{thanks.thanksPreview.subjectLabel}</dt>
                <dd>{thanks.thanksPreview.subject}</dd>
              </div>
            </dl>
            <p class="bob-ab-mail__body">{thanks.thanksPreview.message}</p>
          </div>
        )}
      </article>

      <!-- Moment 02: Google review -->
      <article class="bob-ab-beat bob-ab-beat--review" aria-label="Google review invitation">
        <div class="bob-ab-beat__copy">
          {review.stageLabel && <p class="bob-ab-beat__stage">{review.stageLabel}</p>}
          <p class="bob-ab-display bob-ab-display--review">{review.display}</p>
        </div>

        {review.reviewPreview && (
          <div class="bob-ab-invite" aria-hidden="true">
            <img
              class="bob-ab-invite__mark"
              src={example.googleMarkSrc}
              alt=""
              width="40"
              height="40"
              decoding="async"
              loading="lazy"
            />
            <p class="bob-ab-invite__heading">{review.reviewPreview.heading}</p>
            <p class="bob-ab-invite__body">{review.reviewPreview.body}</p>
            <p class="bob-ab-invite__cta">
              <img
                class="bob-ab-invite__cta-mark"
                src={example.googleMarkSrc}
                alt=""
                width="18"
                height="18"
                decoding="async"
                loading="lazy"
              />
              <span>{review.reviewPreview.ctaLabel}</span>
            </p>
          </div>
        )}
      </article>

      <!-- Moment 03: Rebook -->
      <article class="bob-ab-beat bob-ab-beat--rebook" aria-label="Book again">
        <div class="bob-ab-beat__copy">
          <span class="bob-ab-beat__index">{rebook.index}</span>
          <p class="bob-ab-display bob-ab-display--climax">{rebook.display}</p>
          {rebook.support && <p class="bob-ab-beat__support">{rebook.support}</p>}
        </div>

        {rebook.rebookPreview && (
          <div class="bob-ab-return" aria-hidden="true">
            <p class="bob-ab-return__shop">{rebook.rebookPreview.shopName}</p>
            <p class="bob-ab-return__heading">{rebook.rebookPreview.heading}</p>
            <p class="bob-ab-return__cta">
              <span>{rebook.rebookPreview.ctaLabel}</span>
              <span class="bob-ab-return__arrow" set:html={ARROW} />
            </p>
          </div>
        )}
      </article>
    </div>

    <footer class="bob-ab-end">
      <a
        class="bob-ab__cta"
        href={OWNER_TIMELINE_HREF}
        data-track={TRACK_EVENT}
        data-track-placement={TRACK_PLACEMENT}
      >
        See bookings in the admin demo
        <span class="bob-ab__cta-icon" set:html={ARROW} />
      </a>
    </footer>
  </div>
</section>
