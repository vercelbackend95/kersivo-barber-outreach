---
interface FlowStep {
  title: string;
  description: string;

}

interface Props {
  eyebrow?: string;
  heading?: string;
  subHeading?: string;
  outcomes?: string[];
  steps?: FlowStep[];
}

const {
  eyebrow = 'Connected operations',
  heading = 'How your barbershop website keeps the day running smoothly',
  subHeading =
    'Every key action is linked in one clear flow, so clients, barbers and front desk staff stay aligned from first booking to final confirmation.',
  outcomes = [
    'Fewer back-and-forth messages',
    'Cleaner daily scheduling',
    'Pickup-ready retail built in',
  ],
  steps = [
    {
      title: 'Online Booking',
      description: 'Clients choose a service and lock in a slot in under a minute.',
    },
    {
      title: 'Team Schedule',
      description: "Each barber's calendar stays clear, updated and easy to manage.",
    },
    {
      title: 'Client Enquiry',
      description: 'Questions arrive in one place so your team can respond quickly.',
    },
    {
      title: 'Shop Pickup',
      description: 'Product orders are placed online and prepared for smooth collection.',
    },
    {
      title: 'Order Confirmation',
      description: 'Automatic confirmations keep clients informed and reduce no-shows.',
    },
  ],
} = Astro.props as Props;
---

<section class="integrations3a" aria-labelledby="integrations3a-title">
  <div class="container integrations3a__container">
    <header class="integrations3a__intro">
      <p class="integrations3a__eyebrow">{eyebrow}</p>
      <h2 id="integrations3a-title">{heading}</h2>
      <p class="integrations3a__lead">{subHeading}</p>
      <ul class="integrations3a__outcomes" aria-label="Operational outcomes">
        {outcomes.map((outcome, index) => (
          <li class="integrations3a__outcome" key={`${outcome}-${index}`}>{outcome}</li>
        ))}
      </ul>
        </header>

    <ol class="integrations3a__flow" aria-label="How the website system works together">
      {steps.map((step, index) => (
        <li class="integrations3a__step" key={`${step.title}-${index}`}>
          <article class="integrations3a__card">
            <p class="integrations3a__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
            <h3 class="integrations3a__name">{step.title}</h3>
            <p class="integrations3a__description">{step.description}</p>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>
