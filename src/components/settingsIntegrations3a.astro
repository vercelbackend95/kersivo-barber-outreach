---
interface SystemModule {
  title: string;
  description: string;
  label?: string;
}

interface Props {
    eyebrow?: string;
  heading?: string;
  subHeading?: string;
  modules?: SystemModule[];
}

const {
  eyebrow = 'System proof',
  heading = 'Built for barber operations, not just looks',
  subHeading =
    'Kersivo combines booking, team schedules, shop and admin into one practical website system your barbershop can run daily.',
  modules = [
    {
      title: 'Bookings',
      description: 'Let clients reserve appointments online in seconds without back-and-forth messages.',
      label: 'Client flow',
    },
    {
      title: 'Team Schedule',
      description: 'Show each barber\'s services, shifts and availability in one clean view.',
      label: 'Staff control',
    },
    {
      title: 'Shop & Pickup',
      description: 'Sell retail products on your site and prepare orders for in-shop collection.',
      label: 'Extra revenue',
    },
    {
      title: 'Enquiries',
      description: 'Capture haircut, beard and partnership questions through clear contact paths.',
      label: 'Lead capture',
    },
    {
      title: 'Admin Dashboard',
      description: 'Update products, services and key website content without touching code.',
      label: 'Owner friendly',
    },
    {
      title: 'Email Confirmations',
      description: 'Automatically send booking and order confirmations so clients always know what\'s next.',
      label: 'Auto updates',
    },
  ],
} = Astro.props as Props;
---

<section class="integrations3a" aria-labelledby="integrations3a-title">
  <div class="container integrations3a__container">
    <header class="integrations3a__header">
      <p class="integrations3a__eyebrow">{eyebrow}</p>
      <h2 id="integrations3a-title">{heading}</h2>
      <p class="integrations3a__lead">{subHeading}</p>
    </header>

    <ul class="integrations3a__grid">
      {
        modules.map((module, index) => (
          <li class="integrations3a__item" key={`${module.title}-${index}`}>
            <article class="integrations3a__card">
              {module.label ? <p class="integrations3a__label">{module.label}</p> : null}
              <h3 class="integrations3a__name">{module.title}</h3>
              <p class="integrations3a__description">{module.description}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
