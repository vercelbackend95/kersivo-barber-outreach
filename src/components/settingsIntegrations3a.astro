---


interface HeroFeature {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  features?: HeroFeature[];
}

const {
  eyebrow = 'One system. Real business impact.',
  heading = 'PROTECT MARGIN, TIME, AND CLIENT CONTROL IN ONE STACK.',
  description =
    "Kersivo connects booking, deposits, reminders, campaigns, and pay & collect retail so your team stops patching tools and starts running cleaner days.",

  features = [
    {
      title: 'Commission-free bookings',
      description:
        "Kersivo takes 0% from your booking revenue. Clients book directly in your system, not through a platform that skims each return visit.",
    },
    {
      title: 'No-show protection built in',
      description:
        "Use Stripe deposits at booking to reduce dead slots. Committed clients show up more often, so chair time turns into paid appointments.",
    },
    {
      title: 'Automations that recover clients',
      description:
        "Email reminders and post-visit follow-ups help you do fewer manual chases and keep retention moving.",
    },
    {
      title: 'Retail without platform cuts',
      description:
        "Sell products with pay & collect in the same system. Kersivo takes no sales commission; Stripe handles online cards on your account.",
    },
  ],
} = Astro.props as Props;
---

<section class="hero261" aria-labelledby="hero261-title">
  <div class="container hero261__layout">
    <div class="hero261__content">
      {eyebrow && <p class="hero261__eyebrow">{eyebrow}</p>}
      <h2 id="hero261-title" class="hero261__heading">{heading}</h2>

      {description && <p class="hero261__description">{description}</p>}

    </div>
    <div class="hero261__features" aria-label="Connected operations highlights">
      {features.map((feature, index) => (
        <article class="hero261__feature" key={`${feature.title}-${index}`}>
          <span class="hero261__feature-icon" aria-hidden="true"></span>
          <div>
            <h3 class="hero261__feature-title">{feature.title}</h3>
            <p class="hero261__feature-description">{feature.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>


</section>
