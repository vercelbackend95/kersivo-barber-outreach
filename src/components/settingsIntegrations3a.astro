---
interface SystemModule {
  title: string;
  description: string;

}

interface Props {
  eyebrow?: string;
  heading?: string;
  subHeading?: string;
  outcomes?: string[];
  modules?: SystemModule[];
}

const {
  eyebrow = 'Connected operations',
  heading = 'One website system that keeps your barbershop in sync',
  subHeading =
    'Booking, schedule, enquiries and shop orders stay connected in one operational hub, so your team works faster with less friction.',
  outcomes = [
    'Bookings, enquiries and orders in one place',
    'Clear visibility for barbers and front desk',
    'Less manual follow-up across the day',

  ],
  modules = [
    {
      title: 'Online Booking',
      description: 'Clients lock a slot quickly with service details already attached.',
      tone: 'booking',

    },
    {
      title: 'Team Schedule',
      description: 'Live calendar visibility keeps every barber aligned through the day.',
      tone: 'schedule',

    },
    {
      title: 'Shop Pickup',
      description: 'Orders are prepared on time with pickup status tracked automatically.',
      tone: 'shop',

    },
    {
      title: 'Easy Admin',
      description: 'Confirmations and enquiries are handled from one clean control layer.',
      tone: 'admin',

    },
  ],
} = Astro.props as Props;
---

<section class="integrations3a" aria-labelledby="integrations3a-title">
  <div class="container integrations3a__container">
    <header class="integrations3a__intro">
      <p class="integrations3a__eyebrow">{eyebrow}</p>
      <h2 id="integrations3a-title">{heading}</h2>
      <p class="integrations3a__lead">{subHeading}</p>
      <ul class="integrations3a__outcomes" aria-label="Operational outcomes">
        {outcomes.map((outcome, index) => (
          <li class="integrations3a__outcome" key={`${outcome}-${index}`}>{outcome}</li>
        ))}
      </ul>
        </header>

    <div class="integrations3a__system" aria-label="Connected website system preview">
      <article class="integrations3a__core" aria-label="Website system overview panel">
        <p class="integrations3a__core-kicker">Website system</p>
        <h3 class="integrations3a__core-title">Daily operations overview</h3>
        <div class="integrations3a__core-grid" aria-hidden="true">
          <div class="integrations3a__core-metric">
            <span class="integrations3a__metric-label">Bookings</span>
            <strong class="integrations3a__metric-value">18 Today</strong>
          </div>
          <div class="integrations3a__core-metric">
            <span class="integrations3a__metric-label">Pending Enquiries</span>
            <strong class="integrations3a__metric-value">4 Active</strong>
          </div>
          <div class="integrations3a__core-metric">
            <span class="integrations3a__metric-label">Pickup Orders</span>
            <strong class="integrations3a__metric-value">6 Ready</strong>
          </div>
          <div class="integrations3a__core-metric">
            <span class="integrations3a__metric-label">Team Availability</span>
            <strong class="integrations3a__metric-value">On Track</strong>
          </div>
        </div>
      </article>

      <ul class="integrations3a__modules" aria-label="Connected system modules">
        {modules.map((module, index) => (
          <li class="integrations3a__module-item" key={`${module.title}-${index}`}>
            <article class={`integrations3a__module integrations3a__module--${module.tone ?? 'booking'}`}>
              <h3 class="integrations3a__module-title">{module.title}</h3>
              <p class="integrations3a__module-description">{module.description}</p>
            </article>
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>
