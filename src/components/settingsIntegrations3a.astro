---
interface SystemModule {
  title: string;
  description: string;

}

interface Props {
  eyebrow?: string;
  heading?: string;
  subHeading?: string;
  modules?: SystemModule[];
}

const {
  eyebrow = 'Connected operations',
  heading = 'One website system that keeps your barbershop moving',
  subHeading =
    'From online bookings to pickup-ready product orders, every key touchpoint works together so your team stays focused behind the chair.',
    modules = [
    {
      title: 'Online Bookings',
      description: 'Clients lock in appointments fast, without DMs or back-and-forth calls.',
    },
    {
      title: 'Barber Schedules',
      description: 'Keep each barber\'s availability and service slots clear for the full week.',
    },
    {
      title: 'Shop & Pickup',
      description: 'Sell products on-site and prepare clean pickup orders at the front desk.',
    },
    {
      title: 'Client Enquiries',
      description: 'Collect haircut, beard and service questions in one reliable inbox.',
    },
    {
      title: 'Easy Admin',
      description: 'Update services, hours and offers in minutes without technical hassle.',
    },
    {
      title: 'Order Confirmations',
      description: 'Automatically confirm bookings and purchases so clients always know what\'s next.',
    },
  ],
} = Astro.props as Props;
const [featuredModule, ...supportingModules] = modules;
---

<section class="integrations3a" aria-labelledby="integrations3a-title">
  <div class="container integrations3a__container">
    <header class="integrations3a__header">
      <p class="integrations3a__eyebrow">{eyebrow}</p>
      <h2 id="integrations3a-title">{heading}</h2>
      <p class="integrations3a__lead">{subHeading}</p>
            <p class="integrations3a__microcopy">One connected flow for bookings, team availability, enquiries and retail.</p>
    </header>
    <div class="integrations3a__system" aria-label="Barbershop system modules">
      {featuredModule ? (
        <article class="integrations3a__card integrations3a__card--featured">
          <p class="integrations3a__kicker">Core module</p>
          <h3 class="integrations3a__name">{featuredModule.title}</h3>
          <p class="integrations3a__description">{featuredModule.description}</p>
        </article>
      ) : null}

      <ul class="integrations3a__supporting">
        {supportingModules.map((module, index) => (
          <li class="integrations3a__item" key={`${module.title}-${index}`}>
            <article class="integrations3a__card">

              <h3 class="integrations3a__name">{module.title}</h3>
              <p class="integrations3a__description">{module.description}</p>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
