---
interface HeroButton {
  text: string;
  href: string;
}

interface HeroFeature {
  title: string;
  description: string;
}
interface HeroImage {
  src: string;
  alt: string;
}

interface Props {

  heading?: string;
  description?: string;
  buttonPrimary?: HeroButton;
  buttonSecondary?: HeroButton;
  features?: HeroFeature[];
  images?: HeroImage[];
}

const {
  heading = 'BUILD FASTER WITH SHADCNBLOCKS',
  description = 'Components and blocks built with shadcn/ui, Tailwind CSS and React for modern product teams.',
  buttonPrimary = {
    text: 'Get started',
    href: '#',
  },
  buttonSecondary = {
    text: 'Learn more',
    href: '#',
  },
  features = [
    {
     title: 'Tailored workflows',
      description: 'Track progress across custom issue flows for your team.',

    },
    {
      title: 'Cross-team projects',
      description: 'Collaborate across teams and departments.',

    },
    {
      title: 'Milestones',
      description: 'Break projects down into concrete phases.',

    },
    {
      title: 'Progress insights',
      description: 'Track scope, velocity, and progress over time.',
    },
  ],
  images = [
    {
      src: 'https://deifkwefumgah.cloudfront.net/shadcnblocks/block/dashboard/kanban-ui-dashboard-mainline.png',
      alt: 'Product dashboard preview',

    },
  ],
} = Astro.props as Props;
---

<section class="hero261" aria-labelledby="hero261-title">
  <div class="container hero261__layout">
    <div class="hero261__content">
      <h2 id="hero261-title" class="hero261__heading">{heading}</h2>

      {description && <p class="hero261__description">{description}</p>}
      <div class="hero261__actions">
        {buttonPrimary && (
          <a class="btn btn--primary" href={buttonPrimary.href}>
            {buttonPrimary.text}
          </a>
        )}
        {buttonSecondary && (
          <a class="btn btn--ghost hero261__secondary" href={buttonSecondary.href}>
            {buttonSecondary.text}
            <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </div>
    <div class="hero261__features" aria-label="Feature highlights">
      {features.map((feature, index) => (
        <article class="hero261__feature" key={`${feature.title}-${index}`}>
          <span class="hero261__feature-icon" aria-hidden="true"></span>
          <div>
            <h3 class="hero261__feature-title">{feature.title}</h3>
            <p class="hero261__feature-description">{feature.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="hero261__preview-wrap">
    <div class="hero261__preview-grid" aria-hidden="true"></div>
    <img src={images[0].src} alt={images[0].alt} class="hero261__preview-image" loading="lazy" />
  </div>
</section>
