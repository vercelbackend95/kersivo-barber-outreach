---


interface HeroFeature {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  features?: HeroFeature[];
}

const {
  eyebrow = 'Connected operations',
  heading = 'SAME DETAILS. EVERYWHERE THAT MATTERS.',
  description =
    "Your booking link, today's column, retail orders, and the headline figures all run off the same admin—set services, hours, and catalog once, and they stay aligned everywhere clients and staff look.",

  features = [
    {
      title: 'Client booking',
      description:
        "Service, barber, and time slot on your site; confirmation email arrives with reschedule and cancel links whenever your shop rules allow them.",
    },
    {
      title: 'Roster, hours & menu',
      description:
        "Each barber's shifts, the services on their card, and how long each cut takes—the slot a client locks in is the slot your team sees on the day.",
    },
    {
      title: 'Checkout & pickup',
      description:
        "Cards are charged through Stripe; orders sit beside bookings in admin. Flip them to ready when the product is waiting at the chair.",
    },
    {
      title: 'Figures when you need them',
      description:
        "Booking and shop totals live in the same place as the diary—no second login, no export detour, for a straight read on how the week is moving.",
    },
  ],
} = Astro.props as Props;
---

<section class="hero261" aria-labelledby="hero261-title">
  <div class="container hero261__layout">
    <div class="hero261__content">
      {eyebrow && <p class="hero261__eyebrow">{eyebrow}</p>}
      <h2 id="hero261-title" class="hero261__heading">{heading}</h2>

      {description && <p class="hero261__description">{description}</p>}

    </div>
    <div class="hero261__features" aria-label="Connected operations highlights">
      {features.map((feature, index) => (
        <article class="hero261__feature" key={`${feature.title}-${index}`}>
          <span class="hero261__feature-icon" aria-hidden="true"></span>
          <div>
            <h3 class="hero261__feature-title">{feature.title}</h3>
            <p class="hero261__feature-description">{feature.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>


</section>
