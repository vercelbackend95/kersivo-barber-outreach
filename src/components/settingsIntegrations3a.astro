---


interface HeroFeature {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  features?: HeroFeature[];
}

const {
  eyebrow = 'Connected operations',
  heading = 'ONE SYSTEM. LESS DAILY CHAOS.',
  description =
    'Keep bookings, schedules, shop orders and daily updates connected in one clear barber-first system.',

  features = [
    {
      title: 'Online bookings',
      description: 'Cut out the back-and-forth with built-in booking.',

    },
    {
      title: 'Barber schedules',
      description: 'Keep services, availability and the day’s schedule clear.',

    },
    {
      title: 'Client enquiries',
      description: 'Keep service questions and client enquiries in one place.',
    },
    {
      title: 'Shop & pickup',
      description: 'Sell products online and keep pickup simple in the shop.',
    },
  ],
} = Astro.props as Props;
---

<section class="hero261" aria-labelledby="hero261-title">
  <div class="container hero261__layout">
    <div class="hero261__content">
      {eyebrow && <p class="hero261__eyebrow">{eyebrow}</p>}
      <h2 id="hero261-title" class="hero261__heading">{heading}</h2>

      {description && <p class="hero261__description">{description}</p>}

    </div>
    <div class="hero261__features" aria-label="Connected operations highlights">
      {features.map((feature, index) => (
        <article class="hero261__feature" key={`${feature.title}-${index}`}>
          <span class="hero261__feature-icon" aria-hidden="true"></span>
          <div>
            <h3 class="hero261__feature-title">{feature.title}</h3>
            <p class="hero261__feature-description">{feature.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>


</section>
