---
interface HeroButton {
  text: string;
  href: string;
}

interface HeroFeature {
  title: string;
  description: string;
}
interface HeroImage {
  src: string;
  alt: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  buttonPrimary?: HeroButton;
  buttonSecondary?: HeroButton | null;
  features?: HeroFeature[];
  images?: HeroImage[];
}

const {
  eyebrow = 'Connected operations',
  heading = 'One Website System for Modern Barbershops',
  description =
    'Bookings, barber schedules, client enquiries and pickup orders all stay connected in one clean website system.',
  buttonPrimary = {
    text: 'See how it works',
    href: '#',
  },
    buttonSecondary = null,
  features = [
    {
      title: 'Online bookings',
      description: 'Clients book in minutes without back-and-forth messages.',

    },
    {
      title: 'Barber schedules',
      description: 'Keep availability, services and daily calendars clear.',

    },
    {
      title: 'Client enquiries',
      description: 'Capture haircut, beard and service questions in one place.',
    },
    {
      title: 'Shop & pickup',
      description: 'Sell products online and prepare smooth in-shop collection.',
    },
  ],
  images = [
    {
      src: 'https://deifkwefumgah.cloudfront.net/shadcnblocks/block/dashboard/kanban-ui-dashboard-mainline.png',
      alt: 'Barbershop website dashboard overview',

    },
  ],
} = Astro.props as Props;
---

<section class="hero261" aria-labelledby="hero261-title">
  <div class="container hero261__layout">
    <div class="hero261__content">
            {eyebrow && <p class="hero261__eyebrow">{eyebrow}</p>}
      <h2 id="hero261-title" class="hero261__heading">{heading}</h2>

      {description && <p class="hero261__description">{description}</p>}
      <div class="hero261__actions">
        {buttonPrimary && (
          <a class="btn btn--primary" href={buttonPrimary.href}>
            {buttonPrimary.text}
          </a>
        )}
        {buttonSecondary && (
          <a class="btn btn--ghost hero261__secondary" href={buttonSecondary.href}>
            {buttonSecondary.text}
            <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </div>
    <div class="hero261__features" aria-label="Connected operations highlights">
      {features.map((feature, index) => (
        <article class="hero261__feature" key={`${feature.title}-${index}`}>
          <span class="hero261__feature-icon" aria-hidden="true"></span>
          <div>
            <h3 class="hero261__feature-title">{feature.title}</h3>
            <p class="hero261__feature-description">{feature.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="hero261__preview-wrap">
    <div class="hero261__preview-grid" aria-hidden="true"></div>
    <img src={images[0].src} alt={images[0].alt} class="hero261__preview-image" loading="lazy" />
  </div>
</section>
