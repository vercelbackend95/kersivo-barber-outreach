---
interface Bullet {
  text: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  highlightedWord?: string;
  description?: string;
  bullets?: Bullet[];
  ctaText?: string;
  imageUrl?: string;
  imageAlt?: string;
}

const {
  eyebrow = "OPERATIONS WITHOUT PLATFORM TAX",
  title = "ONE SYSTEM. MORE KEPT REVENUE.",
  highlightedWord = "MORE",
  description =
    "Booking, admin, and pay & collect retail in one setup. No commission skim from Kersivo on your bookings or product sales.",
  bullets = [
    { text: "0% Kersivo commission. Stripe applies only for online card payments." },
    { text: "Cash in-shop can run at 0% fee with no platform cut." },
    { text: "Booking + retail + ops in one stack your team can run daily." },
  ],
  ctaText = "SEE HOW THE SWITCH WORKS",
  imageUrl =
    "https://images.unsplash.com/photo-1621605815971-fbc98d665033?auto=format&fit=crop&w=1280&q=80",
  imageAlt = "Barber preparing tools in a modern barbershop",
} = Astro.props as Props;

const highlightTitle = title.replace(highlightedWord, `<span class=\"hero108__highlight\">${highlightedWord}</span>`);
---

<section class="hero108" aria-labelledby="hero108-title">
  <div class="container hero108__layout">
    <div class="hero108__content">
      <p class="hero108__eyebrow">{eyebrow}</p>
      <h2 id="hero108-title" set:html={highlightTitle} />
      <p class="hero108__description">{description}</p>

      <ul class="hero108__list" aria-label="Core benefits">
        {
          bullets.map((bullet) => (
            <li class="hero108__list-item">
              <span class="hero108__check" aria-hidden="true">
                <svg class="hero108__check-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M20 6.5 9.5 17 4 11.5"
                    stroke="currentColor"
                    stroke-width="2.125"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <span>{bullet.text}</span>
            </li>
          ))
        }
      </ul>

      <button class="btn btn--primary hero108__cta" type="button" data-system-chooser-open>
        <span>{ctaText}</span>
        <span class="hero108__arrow" aria-hidden="true">→</span>
      </button>
    </div>

    <div class="hero108__media">
      <img src={imageUrl} alt={imageAlt} loading="lazy" />
      <div class="hero108__overlay" aria-hidden="true"></div>
    </div>
  </div>
</section>