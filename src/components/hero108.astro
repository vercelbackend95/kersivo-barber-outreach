---
interface Bullet {
  text: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  highlightedWord?: string;
  description?: string;
  bullets?: Bullet[];
  ctaText?: string;
  imageUrl?: string;
  imageAlt?: string;
}

const {
  eyebrow = "BUILT FOR BARBERSHOPS",
  title = "ONE SITE. THE FULL SHOP.",
  highlightedWord = "FULL",
  description =
    "UK barbershops: booking, buy-and-collect retail, and back office on your own domain—your brand, your link, no middleman app in the middle.",
  bullets = [
    { text: "Whoever is on the desk sees bookings and pickup in one place." },
    { text: "Built for a real trading week—not a brochure that gathers dust after launch." },
    { text: "Room to grow your team and product lines—we don't cap how many barbers you run." },
  ],
  ctaText = "SEE THE SYSTEM",
  imageUrl =
    "https://images.unsplash.com/photo-1621605815971-fbc98d665033?auto=format&fit=crop&w=1280&q=80",
  imageAlt = "Barber preparing tools in a modern barbershop",
} = Astro.props as Props;

const highlightTitle = title.replace(highlightedWord, `<span class=\"hero108__highlight\">${highlightedWord}</span>`);
---

<section class="hero108" aria-labelledby="hero108-title">
  <div class="container hero108__layout">
    <div class="hero108__content">
      <p class="hero108__eyebrow">{eyebrow}</p>
      <h2 id="hero108-title" set:html={highlightTitle} />
      <p class="hero108__description">{description}</p>

      <ul class="hero108__list" aria-label="Core benefits">
        {
          bullets.map((bullet) => (
            <li class="hero108__list-item">
              <span class="hero108__check" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 12.5L9.2 16.7L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter"></path>
                </svg>
              </span>
              <span>{bullet.text}</span>
            </li>
          ))
        }
      </ul>

      <button class="btn btn--primary hero108__cta" type="button" data-system-chooser-open>
        <span>{ctaText}</span>
        <span class="hero108__arrow" aria-hidden="true">→</span>
      </button>
    </div>

    <div class="hero108__media">
      <img src={imageUrl} alt={imageAlt} loading="lazy" />
      <div class="hero108__overlay" aria-hidden="true"></div>
    </div>
  </div>
</section>