---
/**
 * Overview › Build brief on /ops/preview-requests/[id]: everything the owner supplied, from loadBuildPack.
 * Owner text is rendered as text, never injected as HTML; line breaks are kept with CSS.
 */
import { OpsBrandColours } from '@/components/ops/previewRequests/OpsBrandColours';
import type { BuildPack, BuildPackAsset, BuildPackRemoteImage } from '@/lib/ops/buildPack';
import { buildPackFiles, buildPackLogos, buildPackShopName, buildPackTownCity, memberPhotoCount } from '@/lib/ops/buildPack';
import { isAllowedRemoteImageUrl, remoteImageStoreHost } from '@/lib/ops/buildPackRemoteImages';
import { remoteImageThumbUrl, type RemoteImageThumbWidth } from '@/lib/ops/buildPackRemoteImageThumb';
import { buildPackFileSummary, buildPackFileSummaryLabel } from '@/lib/ops/buildPackZipPlan';
import { formatBytes } from '@/lib/freePreview/hubAssets';

type Props = { pack: BuildPack; requestId: string };
const { pack, requestId } = Astro.props;

const assetUrl = (asset: Pick<BuildPackAsset, 'id'>, size: 'thumb' | 'full') =>
  `/api/ops/preview-requests/${requestId}/assets/${asset.id}?size=${size}`;

function money(pence: number, from = false): string {
  const value = `£${(pence / 100).toFixed(2).replace(/\.00$/, '')}`;
  return from ? `From ${value}` : value;
}

function minutes(value: number): string {
  if (value < 60) return `${value} min`;
  const h = Math.floor(value / 60);
  const m = value % 60;
  return m ? `${h} h ${m} min` : `${h} h`;
}

function formatDate(value: string | null): string {
  if (!value) return '—';
  return new Date(value).toLocaleString('en-GB', { timeZone: 'Europe/London', dateStyle: 'medium', timeStyle: 'short' });
}

/** Only http(s) links become clickable; anything else is shown as text. */
function safeHref(value: string | null | undefined): string | null {
  const v = (value ?? '').trim();
  if (!v) return null;
  if (/^https?:\/\//i.test(v)) return v;
  if (/^[a-z0-9.-]+\.[a-z]{2,}(\/\S*)?$/i.test(v)) return `https://${v}`;
  return null;
}

function dims(asset: BuildPackAsset): string | null {
  return asset.width && asset.height ? `${asset.width}×${asset.height}` : null;
}

const files = buildPackFiles(pack);
const packUrl = `/api/ops/preview-requests/${requestId}/build-pack`;
const assetById = new Map(files.map((file) => [file.id, file]));
const logoGroups = buildPackLogos(pack);
const currentLogo = logoGroups.current;
const duplicateIds = new Set(logoGroups.duplicates.map((d) => d.asset.id));
// Older uploads, oldest first, with exact re-uploads marked (they are left out of the zip).
const earlierLogos = pack.assets.LOGO.filter((logo) => logo !== currentLogo).sort((a, b) => a.createdAt.localeCompare(b.createdAt));

// Dashboard images (public Blob URLs from admin input): only this project's store is rendered as <img>.
const storeHost = remoteImageStoreHost();
const isAllowed = (url: string | null | undefined) => isAllowedRemoteImageUrl(url, storeHost);
const remoteFor = (source: BuildPackRemoteImage['source'], ownerId: string) =>
  pack.remoteImages.find((image) => image.source === source && image.ownerId === ownerId) ?? null;
// Overview thumbnails are resized WebP from the remote-image route (originals are often 1.5 MB+ PNGs).
// Downloads and the zip keep the originals.
const thumbFor = (source: BuildPackRemoteImage['source'], ownerId: string, width: RemoteImageThumbWidth) => {
  const image = remoteFor(source, ownerId);
  return image && isAllowed(image.url) ? remoteImageThumbUrl(requestId, image, width) : null;
};
const shopLogoImage = pack.remoteImages.find((image) => image.source === 'shopLogo') ?? null;
const shopLogoThumb = shopLogoImage && isAllowed(shopLogoImage.url) ? remoteImageThumbUrl(requestId, shopLogoImage, 240) : null;
const fileSummary = buildPackFileSummaryLabel(buildPackFileSummary(pack, (url) => isAllowed(url)), formatBytes);

/** Display only: "shaving" → "Shaving". Stored data is never changed. */
function displayCategory(value: string | null): string {
  if (!value) return '—';
  return value.charAt(0).toUpperCase() + value.slice(1);
}
// Town alone is not an address: only build the line when the owner entered a street or postcode.
const address =
  pack.contact.addressLine1 || pack.contact.postcode
    ? [pack.contact.addressLine1, pack.contact.addressLine2, buildPackTownCity(pack), pack.contact.postcode].filter(Boolean).join(', ')
    : '';
const anyHours = pack.shop.draftShopId !== null;

const socials: Array<{ label: string; value: string | null }> = [
  { label: 'Instagram (hub / preview form)', value: pack.links.instagram.request },
  { label: 'Instagram (shop profile)', value: pack.links.instagram.profile },
  { label: 'Facebook', value: pack.links.facebook },
  { label: 'TikTok', value: pack.links.tiktok },
  { label: 'Other social', value: pack.links.other },
];
const urlKey = (v: string | null | undefined) =>
  (v ?? '').trim().toLowerCase().replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/\/+$/, '');
// One row per URL: the hub Instagram is often the same column as the preview-form link.
const seenUrls = new Set(pack.links.work.map((link) => urlKey(link.url ?? link.value)));
const socialRows = socials.filter((row) => {
  if (!row.value) return false;
  const key = urlKey(row.value);
  if (seenUrls.has(key)) return false;
  seenUrls.add(key);
  return true;
});

const photoGroups: Array<{ title: string; items: BuildPackAsset[] }> = [
  { title: 'Shop photos', items: pack.assets.SHOP_PHOTO },
  { title: 'Team photos', items: pack.assets.TEAM_PHOTO },
];
const documentGroups: Array<{ title: string; items: BuildPackAsset[] }> = [
  { title: 'Price list', items: pack.assets.PRICE_LIST },
  { title: 'Other files', items: pack.assets.OTHER },
];
---

<div class="ops-bb" data-testid="ops-build-brief">
  <section class="ops-bb__card ops-bb__readiness" aria-labelledby="ops-bb-ready">
    <div class="ops-bb__head">
      <h2 id="ops-bb-ready" class="ops-bb__title">Build brief</h2>
      <p class="ops-bb__meta" data-testid="ops-bb-file-summary">{fileSummary}</p>
    </div>
    <div class="ops-bb__actions">
      <a class="btn btn--primary btn--sm" href={packUrl} download data-testid="ops-bb-download">Download build pack (.zip)</a>
      <button type="button" class="btn btn--secondary btn--sm" data-ops-copy-brief={`${packUrl}?format=md`} aria-controls="ops-bb-brief-dialog">
        Copy brief
      </button>
      <a class="btn btn--ghost btn--sm" href={`${packUrl}?format=json`} download>Download shop.json</a>
      <span class="ops-bb__meta" role="status" aria-live="polite" data-ops-copy-status></span>
    </div>
    <ul class="ops-bb__chips" aria-label="What the owner has provided">
      {
        pack.readiness.map((item) => (
          <li class:list={['ops-bb__chip', item.ok ? 'ops-bb__chip--ok' : 'ops-bb__chip--missing']}>
            <span aria-hidden="true">{item.ok ? '✓' : '✗'}</span>
            <span>{item.label}</span>
            <span class="sr-only">{item.ok ? 'provided' : 'missing'}</span>
          </li>
        ))
      }
    </ul>
    {
      pack.missing.length ? (
        <p class="ops-bb__missing">
          <strong>Not provided:</strong> {pack.missing.join(' · ')}
        </p>
      ) : (
        <p class="ops-bb__missing">Everything on the checklist has been provided.</p>
      )
    }
    {
      pack.conflicts.length ? (
        <div class="ops-bb__warning" role="note" data-testid="ops-bb-conflicts">
          <p>
            <strong>Sources disagree — confirm with the owner before building:</strong>
          </p>
          <ul>
            {pack.conflicts.map((conflict) => (
              <li>
                {conflict.label}:{' '}
                {conflict.values.map((entry, index) => (
                  <>
                    {index > 0 ? ' vs ' : ''}
                    <span class="ops-bb__pre">“{entry.value}”</span> ({entry.label})
                  </>
                ))}
              </li>
            ))}
          </ul>
        </div>
      ) : null
    }
  </section>

  <section class="ops-bb__card" aria-labelledby="ops-bb-business">
    <h2 id="ops-bb-business" class="ops-bb__title">Business &amp; contact</h2>
    <dl class="ops-bb__dl">
      <div><dt>Shop name</dt><dd>{buildPackShopName(pack)}</dd></div>
      <div><dt>Town / city</dt><dd>{buildPackTownCity(pack)}</dd></div>
      <div><dt>Tagline</dt><dd class="ops-bb__pre">{pack.contact.tagline ?? '—'}</dd></div>
      <div><dt>Address</dt><dd>{address || '—'}</dd></div>
      <div><dt>Phone</dt><dd>{pack.contact.phone ?? '—'}</dd></div>
      <div><dt>Public email</dt><dd>{pack.contact.email ?? '—'}</dd></div>
      <div><dt>Own domain</dt><dd>{pack.contact.hasOwnDomain}</dd></div>
      {pack.shop.bookingSlug ? <div><dt>Booking slug</dt><dd>{pack.shop.bookingSlug}</dd></div> : null}
    </dl>
    {pack.shop.draftShopId ? null : <p class="ops-pr__empty">No draft shop yet: business details are entered after it is created.</p>}
  </section>

  <section class="ops-bb__card" aria-labelledby="ops-bb-hours">
    <h2 id="ops-bb-hours" class="ops-bb__title">Opening hours</h2>
    {
      anyHours && pack.hours.saved ? (
        <table class="ops-bb__table ops-bb__table--hours">
          <tbody>
            {pack.hours.days.map((day) => (
              <tr>
                <th scope="row">{day.day}</th>
                <td>{day.isOpen ? `${day.opens}–${day.closes}` : 'Closed'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="ops-pr__empty">Owner has not set hours yet.</p>
      )
    }
  </section>

  <section class="ops-bb__card" aria-labelledby="ops-bb-brand">
    <h2 id="ops-bb-brand" class="ops-bb__title">Brand</h2>
    <div class="ops-bb__brand">
      <div class="ops-bb__logos" data-testid="ops-bb-logos">
        {
          currentLogo ? (
            <figure class="ops-bb__logo" data-testid="ops-bb-current-logo">
              <div class="ops-bb__logo-img">
                <img src={assetUrl(currentLogo, 'thumb')} alt={`Current logo: ${currentLogo.fileName}`} loading="lazy" decoding="async" />
              </div>
              <figcaption>
                <span class="ops-bb__badge">Current logo</span>
                <br />
                {currentLogo.fileName}
                {dims(currentLogo) ? ` · ${dims(currentLogo)}` : ''} · {formatBytes(currentLogo.sizeBytes)}
                <br />
                <a class="btn btn--ghost btn--sm" href={assetUrl(currentLogo, 'full')}>Download</a>
              </figcaption>
            </figure>
          ) : pack.brand.shopLogoUrl && isAllowed(pack.brand.shopLogoUrl) ? null : (
            <p class="ops-pr__empty">No logo uploaded.</p>
          )
        }
        {
          pack.brand.shopLogoUrl && shopLogoThumb ? (
            <figure class="ops-bb__logo">
              <div class="ops-bb__logo-img">
                <img
                  src={shopLogoThumb}
                  alt="Logo set in the dashboard shop settings"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                />
              </div>
              <figcaption>
                {currentLogo ? null : (
                  <>
                    <span class="ops-bb__badge">Current logo</span>
                    <br />
                  </>
                )}
                Shop settings logo (dashboard)
              </figcaption>
            </figure>
          ) : pack.brand.shopLogoUrl ? (
            <p class="ops-bb__meta">
              Shop settings logo URL (not on KERSIVO storage, not downloaded): <span class="ops-bb__url">{pack.brand.shopLogoUrl}</span>
            </p>
          ) : null
        }
        {
          earlierLogos.length ? (
            <details class="ops-bb__details ops-bb__earlier" data-testid="ops-bb-earlier-logos">
              <summary>Earlier uploads ({earlierLogos.length})</summary>
              <div class="ops-bb__logos">
                {earlierLogos.map((logo) => (
                  <figure class="ops-bb__logo">
                    <div class="ops-bb__logo-img">
                      <img src={assetUrl(logo, 'thumb')} alt={`Earlier logo: ${logo.fileName}`} loading="lazy" decoding="async" />
                    </div>
                    <figcaption>
                      {duplicateIds.has(logo.id) ? (
                        <>
                          <span class="ops-bb__tag ops-bb__tag--flush">Duplicate, not in the pack</span>
                          <br />
                        </>
                      ) : null}
                      {logo.fileName}
                      {dims(logo) ? ` · ${dims(logo)}` : ''} · {formatBytes(logo.sizeBytes)} · {formatDate(logo.createdAt)}
                      <br />
                      <a class="btn btn--ghost btn--sm" href={assetUrl(logo, 'full')}>Download</a>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </details>
          ) : null
        }
      </div>
      <div>
        <OpsBrandColours
          client:visible
          primary={pack.brand.primary.request ?? pack.brand.primary.profile}
          secondary={pack.brand.secondary.request ?? pack.brand.secondary.profile}
          tone={pack.brand.backgroundTone}
          source={pack.brand.source}
          sentAt={pack.brand.submittedAt}
          palette={pack.brand.paletteExtracted}
        />
        <dl class="ops-bb__dl">
          <div>
            <dt>Shop profile colours</dt>
            <dd>
              {pack.brand.primary.profile || pack.brand.secondary.profile
                ? `${pack.brand.primary.profile ?? '—'} / ${pack.brand.secondary.profile ?? '—'}`
                : '—'}
            </dd>
          </div>
          <div>
            <dt>Sent to KERSIVO</dt>
            <dd>
              {pack.brand.submittedSnapshot
                ? `${formatDate(pack.brand.submittedAt)} · ${pack.brand.submittedSnapshot.brandPrimaryColour ?? '—'} / ${
                    pack.brand.submittedSnapshot.brandSecondaryColour ?? '—'
                  } · logo: ${pack.brand.submittedSnapshot.logoOriginalFileName ?? '—'}`
                : 'Not sent yet'}
            </dd>
          </div>
          <div><dt>Style notes</dt><dd class="ops-bb__pre">{pack.brand.styleNotes ?? '—'}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="ops-bb__card" aria-labelledby="ops-bb-text">
    <h2 id="ops-bb-text" class="ops-bb__title">Website text</h2>
    <dl class="ops-bb__dl ops-bb__dl--stacked">
      <div><dt>About your shop (hub)</dt><dd class="ops-bb__pre">{pack.text.about ?? '—'}</dd></div>
      {
        pack.text.description && pack.text.description !== pack.text.about ? (
          <div><dt>Shop profile description</dt><dd class="ops-bb__pre">{pack.text.description}</dd></div>
        ) : null
      }
      <div><dt>Tagline</dt><dd class="ops-bb__pre">{pack.contact.tagline ?? '—'}</dd></div>
      <div><dt>Anything else</dt><dd class="ops-bb__pre">{pack.text.websiteExtra ?? '—'}</dd></div>
    </dl>
  </section>

  <section class="ops-bb__card" aria-labelledby="ops-bb-links">
    <h2 id="ops-bb-links" class="ops-bb__title">Socials &amp; links</h2>
    {
      pack.links.work.length || socialRows.length ? (
        <ul class="ops-bb__links">
          {pack.links.work.map((link) => (
            <li>
              <span class="ops-bb__label">{link.label}</span>
              {safeHref(link.url) ? (
                <a href={safeHref(link.url)} target="_blank" rel="noopener noreferrer nofollow">
                  {link.url}
                </a>
              ) : (
                <span>{link.value}</span>
              )}
            </li>
          ))}
          {socialRows.map((row) => (
            <li>
              <span class="ops-bb__label">{row.label}</span>
              {safeHref(row.value) ? (
                <a href={safeHref(row.value)} target="_blank" rel="noopener noreferrer nofollow">
                  {row.value}
                </a>
              ) : (
                <span>{row.value}</span>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p class="ops-pr__empty">No links provided.</p>
      )
    }
  </section>

  <section class="ops-bb__card" aria-labelledby="ops-bb-services">
    <h2 id="ops-bb-services" class="ops-bb__title">Services ({pack.services.length})</h2>
    {
      pack.services.length ? (
        <div class="ops-bb__scroll">
          <table class="ops-bb__table">
            <thead>
              <tr>
                <th scope="col">Service</th>
                <th scope="col">Duration</th>
                <th scope="col">Price</th>
                <th scope="col">Category</th>
              </tr>
            </thead>
            <tbody>
              {pack.services.map((service) => (
                <tr>
                  <td>
                    <div class="ops-bb__item">
                      {thumbFor('service', service.id, 96) ? (
                        <img
                          class="ops-bb__thumb"
                          src={thumbFor('service', service.id, 96)}
                          alt={`Photo for ${service.name}`}
                          width="48"
                          height="48"
                          loading="lazy"
                          decoding="async"
                          referrerpolicy="no-referrer"
                        />
                      ) : null}
                      <div>
                        {service.name}
                        {service.featured ? <span class="ops-bb__tag">Featured</span> : null}
                        {service.description ? <span class="ops-bb__sub ops-bb__pre">{service.description}</span> : null}
                        {service.imageUrl && !isAllowed(service.imageUrl) ? (
                          <span class="ops-bb__sub ops-bb__url">Photo URL (not downloaded): {service.imageUrl}</span>
                        ) : null}
                      </div>
                    </div>
                  </td>
                  <td>{minutes(service.durationMinutes)}</td>
                  <td>{money(service.pricePence, service.priceFrom)}</td>
                  <td>{displayCategory(service.category)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="ops-pr__empty">No services added yet.</p>
      )
    }
  </section>

  <section class="ops-bb__card" aria-labelledby="ops-bb-team">
    <h2 id="ops-bb-team" class="ops-bb__title">Team ({pack.team.length})</h2>
    {
      pack.team.length ? (
        <ul class="ops-bb__team">
          {pack.team.map((member) => {
            const photo = member.photoAssetIds.map((id) => assetById.get(id)).find(Boolean) ?? null;
            const avatar = thumbFor('barber', member.id, 96);
            const count = memberPhotoCount(member);
            return (
              <li class="ops-bb__member" data-testid="ops-bb-member">
                <div class="ops-bb__avatar">
                  {photo ? (
                    <img src={assetUrl(photo, 'thumb')} alt={`Photo of ${member.name}`} loading="lazy" decoding="async" />
                  ) : avatar ? (
                    <img src={avatar} alt={`Photo of ${member.name}`} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  ) : (
                    <span aria-hidden="true">{member.name.slice(0, 1).toUpperCase()}</span>
                  )}
                </div>
                <div>
                  <p class="ops-bb__member-name">{member.name}</p>
                  <p class="ops-bb__meta">
                    {member.role ?? 'No role given'}
                    {count ? ` · ${count} photo${count > 1 ? 's' : ''}` : ' · no photo'}
                  </p>
                  {member.avatarUrl && !isAllowed(member.avatarUrl) ? (
                    <p class="ops-bb__sub ops-bb__url">Photo URL (not downloaded): {member.avatarUrl}</p>
                  ) : null}
                  {member.bio ? <p class="ops-bb__sub ops-bb__pre">{member.bio}</p> : null}
                </div>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="ops-pr__empty">No team members added yet.</p>
      )
    }
  </section>

  {
    pack.products.length ? (
      <section class="ops-bb__card" aria-labelledby="ops-bb-products">
        <h2 id="ops-bb-products" class="ops-bb__title">Products ({pack.products.length})</h2>
        <div class="ops-bb__scroll">
          <table class="ops-bb__table">
            <thead>
              <tr>
                <th scope="col" class="ops-bb__thumb-col">Photo</th>
                <th scope="col">Product</th>
                <th scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              {pack.products.map((product) => (
                <tr>
                  <td class="ops-bb__thumb-col">
                    {thumbFor('product', product.id, 96) ? (
                      <img
                        class="ops-bb__thumb"
                        src={thumbFor('product', product.id, 96)}
                        alt={`Photo of ${product.name}`}
                        width="48"
                        height="48"
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                      />
                    ) : (
                      <span class="ops-bb__meta">—</span>
                    )}
                  </td>
                  <td>
                    {product.name}
                    {product.description ? <span class="ops-bb__sub ops-bb__pre">{product.description}</span> : null}
                    {product.imageUrl && !isAllowed(product.imageUrl) ? (
                      <span class="ops-bb__sub ops-bb__url">Photo URL: {product.imageUrl}</span>
                    ) : null}
                  </td>
                  <td>{money(product.pricePence)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ) : null
  }

  <section class="ops-bb__card" aria-labelledby="ops-bb-photos">
    <h2 id="ops-bb-photos" class="ops-bb__title">Photos</h2>
    {
      photoGroups.map((group) => (
        <div class="ops-bb__group">
          <h3 class="ops-bb__subtitle">
            {group.title} ({group.items.length})
          </h3>
          {group.items.length ? (
            <ul class="ops-pr-files__grid">
              {group.items.map((asset) => (
                <li class="ops-pr-files__item">
                  <div class="ops-pr-files__thumb">
                    {asset.isImage || asset.hasThumb ? (
                      <img src={assetUrl(asset, 'thumb')} alt={asset.caption ?? asset.fileName} loading="lazy" decoding="async" />
                    ) : (
                      <span>{asset.kind}</span>
                    )}
                  </div>
                  <p class="ops-pr-files__name" title={asset.fileName}>{asset.fileName}</p>
                  {asset.caption ? <p class="ops-bb__caption ops-bb__pre">{asset.caption}</p> : null}
                  <p class="ops-pr-files__meta">
                    {asset.barberName ? `${asset.barberName} · ` : asset.barberId ? 'Barber removed · ' : ''}
                    {dims(asset) ? `${dims(asset)} · ` : ''}
                    {formatBytes(asset.sizeBytes)}
                  </p>
                  <a class="btn btn--ghost btn--sm" href={assetUrl(asset, 'full')}>Download</a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="ops-pr__empty">None uploaded.</p>
          )}
        </div>
      ))
    }
  </section>

  <section class="ops-bb__card" aria-labelledby="ops-bb-docs">
    <h2 id="ops-bb-docs" class="ops-bb__title">Documents</h2>
    {
      documentGroups.map((group) => (
        <div class="ops-bb__group">
          <h3 class="ops-bb__subtitle">
            {group.title} ({group.items.length})
          </h3>
          {group.items.length ? (
            <ul class="ops-bb__files">
              {group.items.map((asset) => (
                <li>
                  <a href={assetUrl(asset, 'full')}>{asset.fileName}</a>
                  <span class="ops-bb__meta">
                    {' '}
                    · {asset.contentType} · {formatBytes(asset.sizeBytes)}
                    {asset.caption ? ` · ${asset.caption}` : ''}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="ops-pr__empty">None uploaded.</p>
          )}
        </div>
      ))
    }
    {
      pack.revisionFiles.length ? (
        <p class="ops-bb__meta">
          {pack.revisionFiles.length} message / change-request attachment{pack.revisionFiles.length > 1 ? 's' : ''} on
          the Files tab.
        </p>
      ) : null
    }
  </section>

  {
    pack.changeRequests.length || pack.legacyChangesRequested ? (
      <section class="ops-bb__card" aria-labelledby="ops-bb-changes">
        <h2 id="ops-bb-changes" class="ops-bb__title">Open change requests ({pack.changeRequests.length})</h2>
        <ul class="ops-bb__links">
          {pack.changeRequests.map((change) => (
            <li>
              <span class="ops-bb__label">
                {change.page}
                {change.round ? ` · round ${change.round}` : ''} · {change.status}
              </span>
              <span class="ops-bb__pre">{change.body}</span>
            </li>
          ))}
          {pack.legacyChangesRequested ? (
            <li>
              <span class="ops-bb__label">Changes requested (preview page) · {formatDate(pack.legacyChangesRequested.at)}</span>
              <span class="ops-bb__pre">{pack.legacyChangesRequested.text}</span>
            </li>
          ) : null}
        </ul>
      </section>
    ) : null
  }

  <section class="ops-bb__card" aria-labelledby="ops-bb-intake">
    <h2 id="ops-bb-intake" class="ops-bb__title">Intake</h2>
    <dl class="ops-bb__dl">
      <div><dt>Barbers</dt><dd>{pack.intake.barberCount}</dd></div>
      <div><dt>Booking system</dt><dd>{pack.intake.currentBookingSystem}</dd></div>
      <div><dt>Notes</dt><dd class="ops-bb__pre">{pack.intake.notes ?? '—'}</dd></div>
    </dl>
  </section>
</div>

<dialog id="ops-bb-brief-dialog" class="ops-bb__dialog" aria-labelledby="ops-bb-brief-dialog-title" data-ops-brief-dialog>
  <div class="ops-bb__dialog-head">
    <h2 id="ops-bb-brief-dialog-title" class="ops-bb__title">Copy the brief</h2>
    <button type="button" class="btn btn--ghost btn--sm" data-ops-brief-close>Close</button>
  </div>
  <p class="ops-bb__meta" id="ops-bb-brief-dialog-help">
    This browser blocked the clipboard. The brief is selected below: press Ctrl+C (⌘C on a Mac) to copy it, or download it.
  </p>
  <label class="sr-only" for="ops-bb-brief-text">Brief (brief.md)</label>
  <textarea id="ops-bb-brief-text" class="ops-bb__dialog-text" readonly rows="16" aria-describedby="ops-bb-brief-dialog-help" data-ops-brief-text
  ></textarea>
  <div class="ops-bb__actions">
    <a class="btn btn--secondary btn--sm" href={`${packUrl}?format=md&download=1`} download data-testid="ops-bb-brief-download">Download brief.md</a>
  </div>
</dialog>

<script>
  // "Copy brief": brief.md onto the clipboard, text only. clipboard.write() is called straight from the
  // click, with the fetch as a promise inside the ClipboardItem, so Safari keeps the user gesture. When
  // every clipboard route is refused, the brief opens in a dialog, selected, to copy by hand or download.
  const dialog = document.querySelector<HTMLDialogElement>('[data-ops-brief-dialog]');
  const dialogText = dialog?.querySelector<HTMLTextAreaElement>('[data-ops-brief-text]') ?? null;
  dialog?.querySelector<HTMLButtonElement>('[data-ops-brief-close]')?.addEventListener('click', () => dialog.close());
  // Click on the backdrop closes it too (Esc is native to a modal <dialog>).
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  // Some browsers leave clipboard.write() pending for ~7 s before rejecting a blocked write (the
  // ClipboardItem promise just hangs). Give up after 2.5 s and offer the dialog instead.
  const CLIPBOARD_TIMEOUT_MS = 2500;
  const CLIPBOARD_TIMEOUT = Symbol('clipboard-timeout');
  function withClipboardTimeout<T>(promise: Promise<T>): Promise<T> {
    promise.catch(() => {});
    let timer: ReturnType<typeof setTimeout> | undefined;
    const timeout = new Promise<never>((_, reject) => {
      timer = setTimeout(() => reject(CLIPBOARD_TIMEOUT), CLIPBOARD_TIMEOUT_MS);
    });
    return Promise.race([promise, timeout]).finally(() => clearTimeout(timer));
  }

  function openBriefDialog(text: string, opener: HTMLElement) {
    if (!dialog || !dialogText) return false;
    dialogText.value = text;
    if (typeof dialog.showModal === 'function') dialog.showModal();
    else dialog.setAttribute('open', '');
    dialogText.focus();
    dialogText.select();
    dialogText.setSelectionRange(0, text.length);
    // Back to "Copy brief" once closed (after the browser's own focus restore).
    dialog.addEventListener('close', () => requestAnimationFrame(() => opener.focus()), { once: true });
    return true;
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-ops-copy-brief]')) {
    const status = button.parentElement?.querySelector<HTMLElement>('[data-ops-copy-status]') ?? null;
    button.addEventListener('click', async () => {
      const url = button.dataset.opsCopyBrief;
      // Busy flag rather than `disabled`: a disabled button drops focus, so it could not get it back.
      if (!url || button.getAttribute('aria-busy') === 'true') return;
      button.setAttribute('aria-busy', 'true');
      if (status) status.textContent = 'Copying…';
      const textPromise = fetch(url, { credentials: 'same-origin', cache: 'no-store' }).then((response) => {
        if (!response.ok) throw new Error(String(response.status));
        return response.text();
      });
      textPromise.catch(() => {});
      let copied = false;
      let timedOut = false;
      try {
        if (navigator.clipboard?.write && typeof ClipboardItem !== 'undefined') {
          const item = new ClipboardItem({ 'text/plain': textPromise.then((text) => new Blob([text], { type: 'text/plain' })) });
          await withClipboardTimeout(navigator.clipboard.write([item]));
          copied = true;
        }
      } catch (error) {
        copied = false;
        timedOut = error === CLIPBOARD_TIMEOUT;
      }
      // A write that hung until the timeout means the browser is sitting on a blocked clipboard: a second
      // attempt would hang the same way, so go straight to the dialog.
      if (!copied && !timedOut) {
        try {
          if (navigator.clipboard?.writeText) {
            await withClipboardTimeout(navigator.clipboard.writeText(await textPromise));
            copied = true;
          }
        } catch {
          copied = false;
        }
      }
      try {
        if (copied) {
          if (status) status.textContent = 'Brief copied.';
          return;
        }
        const text = await textPromise;
        const opened = openBriefDialog(text, button);
        if (status) {
          status.textContent = opened
            ? 'Clipboard blocked by this browser — brief opened below to copy.'
            : 'Could not copy the brief. Use Download shop.json or try again.';
        }
      } catch {
        if (status) status.textContent = 'Could not load the brief. Try again.';
      } finally {
        button.removeAttribute('aria-busy');
      }
    });
  }
</script>
