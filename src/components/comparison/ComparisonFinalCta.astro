---
/**
 * Shared closing CTA for /compare, the cost calculator and every *-alternative page.
 * Full KERSIVO leads; Starter and the switching question are secondary text links.
 */
import FinalCta from '@/components/FinalCta.astro';
import { offer } from '@/content/offer';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import {
  FREE_PREVIEW_CTA_HREF,
  FREE_PREVIEW_CTA_LABEL,
  FREE_PREVIEW_CTA_TRACK,
  SUBSCRIBE_NOW_CTA_HREF,
  SUBSCRIBE_NOW_CTA_LABEL,
  SUBSCRIBE_NOW_CTA_TRACK,
} from '@/lib/freePreview/fullPlanCta';
import { STRIPE_FEES_NOTE } from '@/lib/pricing/claimsPolicy';
import {
  COMPARISON_FINAL_CTA_HEADING,
  comparisonFinalCtaSwitchLabel,
  COMPARISON_FINAL_CTA_STARTER_LABEL,
} from '@/lib/seo/comparisonCtas';

interface Props {
  /** Analytics placement prefix, e.g. "booksy" → "booksy_final". */
  placement: string;
  /** Competitor name for the switching link; omit on pages without a #contact section. */
  competitor?: string;
}

const { placement, competitor } = Astro.props as Props;
const trackPlacement = `${placement}_final`;
const titleId = `${placement}-final-cta-title`;
const monthlyPriceLabel = offer.price.full;
const freePreview = isFreePreviewFlowEnabled();
---

<FinalCta
  class="comparison-final-cta"
  eyebrow="OWN YOUR BRAND. OWN YOUR BOOKINGS."
  heading={COMPARISON_FINAL_CTA_HEADING}
  headingId={titleId}
  text={`Full KERSIVO is ${monthlyPriceLabel} per location, with your branded website, domain and online booking. 0% KERSIVO commission. ${STRIPE_FEES_NOTE}`}
  primary={
    freePreview
      ? {
          href: FREE_PREVIEW_CTA_HREF,
          label: FREE_PREVIEW_CTA_LABEL,
          track: FREE_PREVIEW_CTA_TRACK,
          placement: trackPlacement,
        }
      : {
          href: '/admin/launch',
          label: `Start Full KERSIVO — ${monthlyPriceLabel}`,
          track: 'saas_subscribe_click',
          placement: trackPlacement,
        }
  }
  links={[
    ...(freePreview
      ? [
          {
            href: SUBSCRIBE_NOW_CTA_HREF,
            label: SUBSCRIBE_NOW_CTA_LABEL,
            track: SUBSCRIBE_NOW_CTA_TRACK,
            placement: trackPlacement,
          },
        ]
      : []),
    {
      href: '/starter',
      label: COMPARISON_FINAL_CTA_STARTER_LABEL,
      track: 'starter_plan_explore_click',
      placement: trackPlacement,
    },
    ...(competitor
      ? [{ href: '#contact', label: comparisonFinalCtaSwitchLabel(competitor) }]
      : []),
  ]}
/>
