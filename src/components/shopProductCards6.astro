---
import { ShopProductCarousel } from '@/components/shop/ShopProductCarousel';
import { expandCarouselProducts, fetchCarouselProducts, type CarouselProduct } from '@/lib/shop/carouselProducts';

interface Props {
  products?: CarouselProduct[];
}

const { products: productsProp } = Astro.props as Props;

const carouselProducts = productsProp ? expandCarouselProducts(productsProp) : await fetchCarouselProducts();
---

<section class="shop6" aria-labelledby="shop6-title">
  <div class="container shop6__container">
    <div class="shop6__content-column">
      <p class="shop6__eyebrow">A SECOND REVENUE LINE</p>
      <h2 id="shop6-title">A second revenue line. Zero headache.</h2>
      <p class="shop6__lead">
        Sell pomades, beard oils and gift sets straight from your own website.<br />
        Client orders online &rarr; grabs it in the chair &rarr; money hits your account.<br />
        Zero commission. Zero extra shop. All in one admin.
      </p>

      <div class="shop6__ctas">
        <a class="btn btn--primary" href="/shop">View the shop page</a>
        <button type="button" class="btn btn--secondary" data-system-chooser-open>
          Open the shop admin
        </button>
      </div>
    </div>
    <ShopProductCarousel products={carouselProducts} />
  </div>
</section>

<script>
  import { initShop6Carousels } from '@/lib/shop/initShop6Carousel';

  initShop6Carousels();
</script>
