---
import { prisma } from '../lib/db/client';
import { resolveShopId } from '../lib/db/shopScope';
import { formatGbp } from '../lib/shop/money';

const shopId = await resolveShopId();
const products = await prisma.product.findMany({
  where: { shopId, active: true },
  orderBy: [{ sortOrder: 'asc' }, { featured: 'desc' }, { updatedAt: 'desc' }],
  take: 10
});
const MIN_CAROUSEL_ITEMS = 10;

const carouselProducts =
  products.length > 0 && products.length < MIN_CAROUSEL_ITEMS
    ? Array.from({ length: MIN_CAROUSEL_ITEMS }, (_, index) => products[index % products.length])
    : products;


const CATEGORY_LABELS: Record<string, string> = {
  POMADES_AND_CLAYS: 'Pomades',
  BEARD_CARE: 'Beard',
  HAIR_WASH: 'Wash',
  STYLING: 'Styling',
  TOOLS: 'Tools',
  GIFT_SETS: 'Sets'
};

---

<section class="shop6" aria-labelledby="shop6-title">
  <div class="container shop6__container">
    <div class="shop6__content-column">
      <p class="shop6__eyebrow">Retail built in</p>
      <h2 id="shop6-title">Curated barber essentials, ready for pickup</h2>
      <p class="shop6__lead">
        Sell premium barber products directly from your site with a smooth add-to-cart and in-shop pickup flow.
      </p>

      <ul class="shop6__usps" aria-label="Retail highlights">
        <li>Ready for pickup</li>
        <li>Curated for barbers</li>
        <li>Managed in admin</li>
        <li>Built into your site</li>
      </ul>

      <div class="shop6__ctas">
        <a class="btn btn--primary" href="/shop">Explore the shop</a>
      </div>
    </div>
    <div class="shop6__carousel" data-shop6-carousel-root>
      <ul class="shop6__grid" aria-label="Featured products" data-shop6-carousel>
        {carouselProducts.length === 0 ? (
          <li class="shop6__item">
            <article class="shop6__card shop6__card--empty">
              <div class="shop6__card-body">
                <p class="shop6__category">Shop preview</p>
                <h3>Add products to launch this retail section</h3>
                <p class="shop6__price">Ready when your catalog is live</p>
                <a class="btn btn--secondary" href="/shop">Open shop page</a>

              </div>
                          </article>
          </li>
        ) : carouselProducts.map((product, index) => (
          <li class:list={["shop6__item", index >= 3 && 'shop6__item--mobile-extra']} key={`${product.id}-${index}`}>

            <article class="shop-card" data-category={product.category}>
              <a href={`/shop/${product.id}`} class="shop-media-link" aria-label={`View ${product.name}`}>
                <div class="shop-media">
                  {product.imageUrl ? (
                    <img src={product.imageUrl} alt={product.name} loading="lazy" class="shop-image" />
                  ) : (
                    <div class="shop-image shop-image--placeholder" aria-hidden="true"></div>
                  )}
                </div>
              </a>

              <div class="shop-card-body">
                <p class="shop-category">{CATEGORY_LABELS[product.category] ?? 'Styling'}</p>
                <h3><a href={`/shop/${product.id}`}>{product.name}</a></h3>
                <p class="shop-price">{formatGbp(product.pricePence)}</p>

                <div class="shop-card-actions">
                  <button
                    class="btn btn--primary"
                    type="button"
                    data-add-to-cart
                    data-product-id={product.id}
                    data-product-name={product.name}
                    data-product-price-pence={String(product.pricePence)}
                    data-product-image-url={product.imageUrl ?? ''}
                  >
                    Add to cart
                  </button>
                  <a class="btn btn--secondary shop6__quick-view" href={`/shop/${product.id}`}>Quick view</a>
                </div>

              </div>

            </article>
          </li>
        ))}
      </ul>

      {carouselProducts.length > 0 && (
        <div class="shop6__controls" aria-label="Carousel controls">
          <button class="shop6__control" type="button" data-shop6-prev aria-label="Previous products">Prev</button>
          <button class="shop6__control" type="button" data-shop6-next aria-label="Next products">Next</button>
        </div>
      )}
    </div>

  </div>
</section>

<script>
  const desktopQuery = window.matchMedia('(min-width: 48rem)');
  const roots = document.querySelectorAll('[data-shop6-carousel-root]');
  const SCROLL_TOLERANCE = 2;
  roots.forEach((root) => {
    const carousel = root.querySelector('[data-shop6-carousel]');
    const prevButton = root.querySelector('[data-shop6-prev]');
    const nextButton = root.querySelector('[data-shop6-next]');
    const firstItem = carousel?.querySelector('.shop6__item');

    if (!(carousel instanceof HTMLElement) || !(firstItem instanceof HTMLElement)) return;
    const getMaxScroll = () => Math.max(0, carousel.scrollWidth - carousel.clientWidth);
    const cardStep = () => {
      const itemWidth = firstItem.getBoundingClientRect().width;
      const carouselStyles = window.getComputedStyle(carousel);
      const gap = Number.parseFloat(carouselStyles.columnGap || carouselStyles.gap || '0') || 0;
      return itemWidth + gap;
    };
    const cardsPerPage = () => {
      const step = cardStep();
      if (step <= 0) return 1;
      return Math.max(1, Math.floor((carousel.clientWidth + SCROLL_TOLERANCE) / step));
    };


    const updateControls = () => {
      if (!(prevButton instanceof HTMLButtonElement) || !(nextButton instanceof HTMLButtonElement)) return;

      const maxScroll = getMaxScroll();
      const currentScroll = carousel.scrollLeft;
      const canScroll = desktopQuery.matches && maxScroll > SCROLL_TOLERANCE;

      prevButton.disabled = !canScroll || currentScroll <= SCROLL_TOLERANCE;
      nextButton.disabled = !canScroll || currentScroll >= maxScroll - SCROLL_TOLERANCE;
      root.classList.toggle('shop6__carousel--no-scroll', !canScroll);
    };

    const scrollCards = (direction) => {
      if (!desktopQuery.matches) return;

      const maxScroll = getMaxScroll();
      if (maxScroll <= SCROLL_TOLERANCE) return;

      const pageStep = cardStep() * cardsPerPage();
      const target = Math.max(0, Math.min(maxScroll, carousel.scrollLeft + pageStep * direction));
      carousel.scrollTo({ left: target, behavior: 'smooth' });
    };

    prevButton?.addEventListener('click', () => scrollCards(-1));
    nextButton?.addEventListener('click', () => scrollCards(1));

    carousel.addEventListener(
      'wheel',
      (event) => {
        if (!desktopQuery.matches) return;
        if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;

        event.preventDefault();
        carousel.scrollBy({
          left: event.deltaY,
          behavior: 'auto'
        });
      },
      { passive: false }
    );
    carousel.addEventListener('scroll', updateControls, { passive: true });
    window.addEventListener('resize', updateControls);
    desktopQuery.addEventListener('change', updateControls);
    updateControls();
  });

</script>
