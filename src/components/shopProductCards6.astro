---
import { prisma } from '../lib/db/client';
import { resolveShopId } from '../lib/db/shopScope';
import { formatGbp } from '../lib/shop/money';

const shopId = await resolveShopId();
const products = await prisma.product.findMany({
  where: { shopId, active: true },
  orderBy: [{ sortOrder: 'asc' }, { featured: 'desc' }, { updatedAt: 'desc' }],
  take: 3
});

const CATEGORY_LABELS: Record<string, string> = {
  POMADES_AND_CLAYS: 'Pomades',
  BEARD_CARE: 'Beard',
  HAIR_WASH: 'Wash',
  STYLING: 'Styling',
  TOOLS: 'Tools',
  GIFT_SETS: 'Sets'
};

---

<section class="shop6" aria-labelledby="shop6-title">
  <div class="container shop6__container">
    <div class="shop6__content-column">
      <p class="shop6__eyebrow">Retail built in</p>
      <h2 id="shop6-title">Curated barber essentials, ready for pickup</h2>
      <p class="shop6__lead">
        Showcase premium hair, beard and styling products directly on your site. Customers can browse, add to cart,
        and collect in-shop with a smooth retail flow.
      </p>

      <ul class="shop6__usps" aria-label="Retail highlights">
        <li>
          <span class="shop6__usp-value">Same-day</span>
          <span class="shop6__usp-label">Ready for pickup</span>
        </li>
        <li>
          <span class="shop6__usp-value">Curated</span>
          <span class="shop6__usp-label">For barber clients</span>
        </li>
        <li>
          <span class="shop6__usp-value">Managed</span>
          <span class="shop6__usp-label">In admin panel</span>
        </li>
        <li>
          <span class="shop6__usp-value">Integrated</span>
          <span class="shop6__usp-label">Inside your website</span>
        </li>
      </ul>

      <div class="shop6__ctas">
        <a class="btn btn--primary" href="/shop">Explore the shop</a>
        <a class="btn btn--ghost" href="/shop">View all products</a>
      </div>
    </div>

    <ul class="shop6__grid" aria-label="Featured products">
      {products.length === 0 ? (
        <li class="shop6__item">
          <article class="shop6__card shop6__card--empty">
            <div class="shop6__card-body">
              <p class="shop6__category">Shop preview</p>
              <h3>Add products to launch this retail section</h3>
              <p class="shop6__price">Ready when your catalog is live</p>
              <a class="btn btn--secondary" href="/shop">Open shop page</a>
            </div>
          </article>
        </li>
      ) : products.map((product) => (
        <li class="shop6__item" key={product.id}>
          <article class="shop-card" data-category={product.category}>
            <a href={`/shop/${product.id}`} class="shop-media-link" aria-label={`View ${product.name}`}>
              <div class="shop-media">
                {product.imageUrl ? (
                  <img src={product.imageUrl} alt={product.name} loading="lazy" class="shop-image" />
                ) : (
                  <div class="shop-image shop-image--placeholder" aria-hidden="true"></div>
                )}
              </div>
            </a>

            <div class="shop-card-body">
              <p class="shop-category">{CATEGORY_LABELS[product.category] ?? 'Styling'}</p>
              <h3><a href={`/shop/${product.id}`}>{product.name}</a></h3>
              <p class="shop-price">{formatGbp(product.pricePence)}</p>

              <div class="shop-card-actions">
                <button
                  class="btn btn--primary"
                  type="button"
                  data-add-to-cart
                  data-product-id={product.id}
                  data-product-name={product.name}
                  data-product-price-pence={String(product.pricePence)}
                  data-product-image-url={product.imageUrl ?? ''}
                >
                  Add to cart
                </button>
                <a class="btn btn--secondary" href={`/shop/${product.id}`}>Quick view</a>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>
