---
import {
  FEATURE261_MORE_INCLUDED_LABEL,
  FEATURE261_MORE_INCLUDED_PILLS,
} from '@/lib/landing/feature261MoreIncluded';
---

<div class="feature261__more-included">
  <p class="feature261__more-included-label">{FEATURE261_MORE_INCLUDED_LABEL}</p>
  <ul class="feature261__more-included-pills" role="list">
    {FEATURE261_MORE_INCLUDED_PILLS.map((pill) => (
      <li class="feature261__more-included-pill">{pill}</li>
    ))}
  </ul>
</div>
