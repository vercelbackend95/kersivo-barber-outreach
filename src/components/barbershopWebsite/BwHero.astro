---
import FullPlanCta from '@/components/cta/FullPlanCta.astro';
import BwSite from '@/components/barbershopWebsite/BwSite.astro';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import { BARBERSHOP_WEBSITES_PAGE_H1 } from '@/lib/seo/barbershopWebsitesPage';

const freePreview = isFreePreviewFlowEnabled();
const placement = 'barbershop_websites_hero';
// Split the approved H1 so its last three words can carry the red underline sweep.
const words = BARBERSHOP_WEBSITES_PAGE_H1.split(' ');
const lead = words.slice(0, -4).join(' ');
const tail = words.slice(-4).join(' ');
---

<section class="bw-hero" aria-labelledby="bw-hero-title">
  <div class="bw-shell bw-hero__inner">
    <nav class="bw-crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><span aria-current="page">Barbershop Websites</span></li>
      </ol>
    </nav>

    <div class="bw-hero__copy">
      <h1 id="bw-hero-title" class="bw-hero__title" data-bw-split>
        {lead} <span class="bw-hero__mark">{tail}</span>
      </h1>
      <p class="bw-hero__lead">
        Your barbershop website is the address clients find on Google, tap in your Instagram bio and
        book from. Here is why it matters, what it should include and how clients book from it. When
        you want one, KERSIVO sets it up on your own domain for £{SAAS_MONTHLY_GBP}/month per location.
      </p>

      <div class="bw-hero__actions">
        {freePreview ? (
          <FullPlanCta part="primary" primaryClass="bw-btn bw-btn--primary" placement={placement} />
        ) : (
          <a href="/admin/launch" class="btn btn--primary btn--lg bw-btn bw-btn--primary" data-track="saas_subscribe_click" data-track-placement={placement}>
            Start Full KERSIVO — £{SAAS_MONTHLY_GBP}/month
          </a>
        )}
        <a href="/demo" class="btn btn--outline btn--lg bw-btn bw-btn--ghost" data-track="view_live_demo_click" data-track-placement={placement}>
          See a demo website
        </a>
      </div>
      {freePreview && <FullPlanCta part="subscribe" class="bw-hero__subscribe" placement={placement} />}

      <ul class="bw-facts" role="list" aria-label="Full KERSIVO terms">
        <li>No setup fee</li>
        <li>No VAT added</li>
        <li>0% KERSIVO commission, Stripe fees apply</li>
      </ul>
    </div>

    <div class="bw-hero__stage">
      <BwSite
        eager
        class="bw-site--hero"
        label="Illustration of a barbershop website on its own domain, cutstate.co.uk: the shop logo, a Book now button, a photo of a barber at work, services with prices, the barbers and opening hours."
      />
      <p class="bw-note">CUTSTATE Barbers is a fictional demonstration shop.</p>
    </div>
  </div>
</section>
