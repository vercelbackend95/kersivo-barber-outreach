---
import FullPlanCta from '@/components/cta/FullPlanCta.astro';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import { DEMO_HOME_HREF } from '@/lib/demo/nav';
import { STRIPE_FEES_NOTE } from '@/lib/pricing/claimsPolicy';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import { getBarbershopWebsitesFaqs } from '@/lib/seo/barbershopWebsitesPage';

const freePreview = isFreePreviewFlowEnabled();
const faqs = getBarbershopWebsitesFaqs(freePreview);
const placement = 'barbershop_websites_final_full_cta';
---

<section class="bw-section bw-faq" aria-labelledby="bw-faq-title">
  <div class="bw-shell bw-faq__grid">
    <div class="bw-head">
      <h2 id="bw-faq-title" class="bw-h2">Barbershop website questions</h2>
      <p class="bw-lead">Straight answers on websites, booking, domains, cost and setup.</p>
    </div>
    <div class="bw-faq__list">
      {faqs.map((faq) => (
        <details class="bw-faq__item" id={`bw-faq-${faq.id}`}>
          <summary>
            <h3 class="bw-faq__q">{faq.question}</h3>
            <span class="bw-faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="bw-faq__a">
            {faq.answer.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="bw-final" aria-labelledby="bw-final-title" data-bw-final>
  <div class="bw-shell bw-final__inner">
    <p class="bw-eyebrow bw-final__eyebrow"><span class="bw-eyebrow__dot" aria-hidden="true"></span>Final scene · Your name in lights</p>
    <p class="bw-final__domain" aria-hidden="true"><span data-bw-final-domain>yourshop.co.uk</span></p>
    <h2 id="bw-final-title" class="bw-final__title">Put your shop’s name in the address bar</h2>

    <div class="bw-final__try" data-bw-final-try>
      <label class="bw-final__label" for="bw-final-name">Try it with your shop’s name</label>
      <div class="bw-final__field">
        <input
          id="bw-final-name"
          class="bw-final__input"
          type="text"
          inputmode="text"
          autocomplete="off"
          spellcheck="false"
          maxlength="40"
          placeholder="e.g. Fade Street Barbers"
          aria-describedby="bw-final-hint"
          data-bw-final-input
        />
        <span class="bw-final__bar" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="13" height="13"><path d="M4.5 7V5.2a3.5 3.5 0 0 1 7 0V7" fill="none" stroke="currentColor" stroke-width="1.5" /><rect x="3" y="7" width="10" height="7" rx="1.6" fill="currentColor" /></svg>
          <span data-bw-final-preview>yourshop.co.uk</span>
        </span>
      </div>
      <ul class="bw-final__places" role="list" aria-hidden="true">
        <li class="bw-final__place bw-final__place--sign">
          <span class="bw-final__place-head">On your shopfront</span>
          <span class="bw-final__view bw-final__sign"><b data-bw-final-name>YOUR SHOP</b><i data-bw-final-out>yourshop.co.uk</i></span>
        </li>
        <li class="bw-final__place bw-final__place--ig">
          <span class="bw-final__place-head">In your Instagram bio</span>
          <span class="bw-final__view bw-final__ig">
            <span class="bw-final__ig-avatar"></span>
            <span class="bw-final__ig-text">
              <b data-bw-final-name>Your shop</b>
              <span>Fades, beards, hot towel. Book your next cut</span>
              <u><svg viewBox="0 0 16 16" width="11" height="11"><path d="M6.8 9.2a2.6 2.6 0 0 0 3.7 0l2.1-2.1a2.6 2.6 0 0 0-3.7-3.7l-.9.9M9.2 6.8a2.6 2.6 0 0 0-3.7 0L3.4 8.9a2.6 2.6 0 0 0 3.7 3.7l.9-.9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg><span><span data-bw-final-out>yourshop.co.uk</span>/book</span></u>
            </span>
          </span>
        </li>
        <li class="bw-final__place bw-final__place--google">
          <span class="bw-final__place-head">On Google</span>
          <span class="bw-final__view bw-final__g">
            <span class="bw-final__g-site"><span class="bw-final__g-fav" data-bw-final-initial>Y</span><i data-bw-final-out>yourshop.co.uk</i></span>
            <b data-bw-final-name>Your shop</b>
            <span class="bw-final__g-chips"><span>Website</span><span>Book online</span></span>
          </span>
        </li>
      </ul>
      <p class="bw-final__hint" id="bw-final-hint">
        An example of how your address could look; nothing you type is saved or sent. We check the
        name is available when we set it up, and one standard domain per location is included.
      </p>
    </div>
    <p class="bw-lead bw-final__lead">
      Your barbershop website, online booking and the tools behind it, set up by KERSIVO for
      £{SAAS_MONTHLY_GBP}/month per location. You approve it before it goes live.
    </p>
    <div class="bw-final__actions">
      {freePreview ? (
        <FullPlanCta part="primary" primaryClass="bw-btn bw-btn--primary" placement={placement} />
      ) : (
        <a href="/admin/launch" class="btn btn--primary btn--lg bw-btn bw-btn--primary" data-track="saas_subscribe_click" data-track-placement={placement}>
          Start Full KERSIVO — £{SAAS_MONTHLY_GBP}/month
        </a>
      )}
      <a href={DEMO_HOME_HREF} class="btn btn--outline btn--lg bw-btn bw-btn--ghost" data-track="view_live_demo_click" data-track-placement="barbershop_websites_final_demo">
        Explore the working demo
      </a>
    </div>
    {freePreview && <FullPlanCta part="subscribe" class="bw-final__subscribe" placement={placement} />}
    <p class="bw-final__fine">No setup fee. No VAT added. 0% KERSIVO commission. {STRIPE_FEES_NOTE}</p>
  </div>
</section>
