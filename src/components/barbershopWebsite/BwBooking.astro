---
/**
 * How clients book from the website: five tabs drive an illustrative phone. The phone screens are
 * static markup (no form controls). Auto-advance runs once when the section comes into view and
 * stops on any interaction; a pause control is always available.
 */
import { DEMO_BARBERS } from '@/lib/demo/barbers';
import { DEMO_BOOK_HREF } from '@/lib/demo/nav';
import { DEMO_SERVICES, formatDemoPriceGbp } from '@/lib/demo/services';
import { BARBERSHOP_ONLINE_BOOKING_PAGE_PATH } from '@/lib/seo/barbershopOnlineBookingPage';
import { KERSIVO_BOOKING_DEPOSIT_GBP } from '@/lib/seo/defaults';
import { STRIPE_FEES_NOTE } from '@/lib/pricing/claimsPolicy';

const services = DEMO_SERVICES.filter((service) => service.featured).slice(0, 3);
const chosenService = services.find((service) => service.slug === 'skin-fade') ?? services[0];
const team = DEMO_BARBERS.slice(0, 3);
const chosenBarber = team.find((barber) => barber.slug === 'ellis-ward') ?? team[0];
const days = ['Thu', 'Fri', 'Sat', 'Sun'];
const times = ['09:30', '10:15', '11:00', '13:45', '15:30', '16:15'];

type Step = { id: string; title: string; copy: string };
const steps: Step[] = [
  { id: 'service', title: 'Choose a service', copy: 'Clients see every service with its price and length, then pick one.' },
  { id: 'barber', title: 'Choose a barber', copy: 'They book the barber they want, or anyone available.' },
  { id: 'time', title: 'Pick a time', copy: 'Only real free slots appear, based on your hours and each barber’s diary.' },
  { id: 'details', title: 'Add details and pay', copy: `Name, phone and email. You decide whether they pay at the shop, leave a £${KERSIVO_BOOKING_DEPOSIT_GBP} deposit or pay in full.` },
  { id: 'booked', title: 'Booked', copy: 'They get an email confirmation and reminders. The booking lands in your diary.' },
];
---

<section class="bw-section bw-booking" id="bw-booking" aria-labelledby="bw-booking-title" data-bw-booking>
  <div class="bw-shell">
    <div class="bw-head bw-head--wide">
      <p class="bw-eyebrow"><span class="bw-eyebrow__dot" aria-hidden="true"></span>Scene 04 · The booking</p>
      <h2 id="bw-booking-title" class="bw-h2">How clients book appointments from your website</h2>
      <p class="bw-lead">
        The best barbershop websites turn a visit into a booking without a phone call or a DM. With
        Full KERSIVO, booking happens on your own site, in your colours, in five short steps.
      </p>
    </div>

    <div class="bw-booking__layout">
      <div class="bw-booking__steps">
        <div class="bw-booking__tabs" role="tablist" aria-label="Booking steps" aria-orientation="vertical">
          {steps.map((step, index) => (
            <button
              type="button"
              role="tab"
              id={`bw-tab-${step.id}`}
              class="bw-booking__tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`bw-panel-${step.id}`}
              tabindex={index === 0 ? '0' : '-1'}
              data-bw-tab={index}
            >
              <span class="bw-booking__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="bw-booking__bar" aria-hidden="true"><span></span></span>
              <span class="bw-booking__tab-title">{step.title}</span>
              <span class="bw-booking__tab-copy">{step.copy}</span>
            </button>
          ))}
        </div>
        <button type="button" class="bw-booking__pause" aria-pressed="false" data-bw-pause>
          <span class="bw-booking__pause-label">Pause the walkthrough</span>
        </button>
      </div>

      <div class="bw-booking__device">
      <span class="bw-booking__glow" aria-hidden="true"></span>
      <div class="bw-phone" aria-hidden="false">
        <span class="bw-phone__tap" aria-hidden="true" data-bw-tap></span>
        <div class="bw-phone__screen">
          <div class="bw-phone__top" aria-hidden="true">
            <img src="/images/home-v2/cutstate-logo.webp" alt="" width="216" height="72" loading="lazy" decoding="async" />
            <span class="bw-phone__url">cutstate.co.uk/book</span>
          </div>

          <div class="bw-phone__panel is-active" role="tabpanel" id="bw-panel-service" aria-labelledby="bw-tab-service" data-bw-panel="0">
            <p class="bw-phone__h">Choose a service</p>
            {services.map((service) => (
              <p class:list={['bw-phone__option', { 'is-picked': service.slug === chosenService.slug }]}>
                <span><strong>{service.name}</strong><small>{service.durationMinutes} min</small></span>
                <span class="bw-phone__price">{formatDemoPriceGbp(service.pricePence)}</span>
              </p>
            ))}
          </div>

          <div class="bw-phone__panel" role="tabpanel" id="bw-panel-barber" aria-labelledby="bw-tab-barber" data-bw-panel="1" hidden>
            <p class="bw-phone__h">Choose a barber</p>
            {team.map((barber) => (
              <p class:list={['bw-phone__option bw-phone__option--barber', { 'is-picked': barber.slug === chosenBarber.slug }]}>
                <img src={`/images/barbershop-websites/barber-${barber.slug}.webp`} alt="" width="160" height="160" loading="lazy" decoding="async" />
                <span><strong>{barber.name}</strong><small>{barber.specialisation}</small></span>
              </p>
            ))}
          </div>

          <div class="bw-phone__panel" role="tabpanel" id="bw-panel-time" aria-labelledby="bw-tab-time" data-bw-panel="2" hidden>
            <p class="bw-phone__h">Pick a time</p>
            <p class="bw-phone__days">
              {days.map((day) => <span class:list={{ 'is-picked': day === 'Sat' }}>{day}</span>)}
            </p>
            <p class="bw-phone__slots">
              {times.map((time) => <span class:list={{ 'is-picked': time === '10:15' }}>{time}</span>)}
            </p>
            <p class="bw-phone__hint">Example times</p>
          </div>

          <div class="bw-phone__panel" role="tabpanel" id="bw-panel-details" aria-labelledby="bw-tab-details" data-bw-panel="3" hidden>
            <p class="bw-phone__h">Your details</p>
            <p class="bw-phone__field"><small>Name</small><span>Sam Taylor</span></p>
            <p class="bw-phone__field"><small>Mobile</small><span>07700 900123</span></p>
            <p class="bw-phone__h bw-phone__h--sm">How would you like to pay?</p>
            <p class="bw-phone__pay">
              <span>Pay at shop</span>
              <span class="is-picked">£{KERSIVO_BOOKING_DEPOSIT_GBP} deposit</span>
              <span>Pay in full</span>
            </p>
          </div>

          <div class="bw-phone__panel" role="tabpanel" id="bw-panel-booked" aria-labelledby="bw-tab-booked" data-bw-panel="4" hidden>
            <p class="bw-phone__stamp">Booked</p>
            <p class="bw-phone__summary">
              <strong>{chosenService.name}</strong>
              <span>with {chosenBarber.name}</span>
              <span>Saturday, 10:15</span>
            </p>
            <p class="bw-phone__sent">Confirmation sent by email</p>
            <p class="bw-phone__sent">Reminder before the appointment</p>
          </div>
        </div>
      </div>

      <div class="bw-diary" aria-hidden="true">
        <p class="bw-diary__head"><span>Your diary</span><span>Saturday</span></p>
        <p class="bw-diary__row"><time>09:30</time><span class="bw-diary__slot">Haircut · {team[0].name.split(' ')[0]}</span></p>
        <p class="bw-diary__row bw-diary__row--new"><time>10:15</time><span class="bw-diary__slot bw-diary__slot--new"><b>{chosenService.name}</b> · {chosenBarber.name.split(' ')[0]}<em>New</em></span></p>
        <p class="bw-diary__row"><time>11:00</time><span class="bw-diary__slot bw-diary__slot--free">Free</span></p>
        <p class="bw-diary__row"><time>11:45</time><span class="bw-diary__slot">Beard trim · {team[2].name.split(' ')[0]}</span></p>
      </div>
      <p class="bw-booking__toast" aria-hidden="true"><span class="bw-booking__toast-dot"></span>Confirmation email sent to Sam</p>
      </div>
    </div>

    <p class="bw-aside">
      SMS reminders are included within a monthly allowance. Deposit and full-payment modes need your
      shop’s connected Stripe account. {STRIPE_FEES_NOTE} Sam Taylor is an example client. Try it yourself on the
      <a href={DEMO_BOOK_HREF} data-track="view_live_demo_click" data-track-placement="barbershop_websites_booking">demo booking page</a>,
      or read the full <a href={BARBERSHOP_ONLINE_BOOKING_PAGE_PATH}>online booking guide</a>.
    </p>
  </div>
</section>
