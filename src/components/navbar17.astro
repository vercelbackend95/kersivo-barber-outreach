---
import Navbar17ClientScript from '@/components/Navbar17ClientScript.astro';
import NavbarCartButton from '@/components/shop/NavbarCartButton.astro';
import {
  getNavbar17CtaHref,
  getNavbar17CtaLabel,
  getNavbar17Items,
  navbar17ShowsCart,
  type Navbar17CtaTrack,
  type Navbar17Variant,
} from '@/lib/nav/navbar17Items';

/** Browser-safe CTA shape — resolved on the server and passed in as a prop. */
type Navbar17PreviewCtaProp = {
  label: string;
  href: string | null;
  track?: Navbar17CtaTrack;
};

interface Props {
  variant?: Navbar17Variant;
  /** Custom shop logo (e.g. admin test-shop). Falls back to Kersivo wordmark. */
  brandLogoUrl?: string | null;
  /** Override brand link aria-label (e.g. shop name when showing custom logo). */
  brandAriaLabel?: string;
  /**
   * Server-resolved preview CTA for landing / shop / testShop.
   * Must be computed outside this component so client scripts never see auth/Prisma.
   */
  previewCta?: Navbar17PreviewCtaProp | null;
}

const {
  variant = 'default',
  brandLogoUrl = null,
  brandAriaLabel: brandAriaLabelProp,
  previewCta: previewCtaProp = null,
} = Astro.props as Props;

const navItems = getNavbar17Items(variant);
const showCart = navbar17ShowsCart(variant);
const isLanding = variant === 'landing';
const isTestShop = variant === 'testShop';
const usesLandingCta = variant === 'landing' || variant === 'shop' || variant === 'testShop';

const previewCta =
  previewCtaProp ?? (usesLandingCta ? (Astro.locals.navbarPreviewCta ?? null) : null);

const ctaLabel = previewCta?.label ?? getNavbar17CtaLabel(variant);
const ctaHref = previewCta ? previewCta.href : getNavbar17CtaHref(variant);
const ctaTrack = previewCta?.track;
const ctaDemoAttr = usesLandingCta ? undefined : true;

const hasCustomBrandLogo = Boolean(brandLogoUrl);
const brandAriaLabel =
  brandAriaLabelProp ??
  (isLanding ? 'KERSIVO – back to top' : isTestShop ? 'Back to shop' : 'Kersivo – back to homepage');
const brandHref = isLanding ? '#hero' : isTestShop ? '/admin/test-shop' : '/#home';
---

<header class="navbar17" data-navbar17 data-navbar-variant={variant}>
  <div class="navbar17__stack" data-navbar17-stack>
    <div class="navbar17__bar">
      <div class="container navbar17__wrap">
        <a href={brandHref} class="navbar17__brand" aria-label={brandAriaLabel}>
          {
            hasCustomBrandLogo ? (
              <img
                class="navbar17__brand-img navbar17__brand-img--custom"
                src={brandLogoUrl!}
                alt=""
                width="64"
                height="64"
                decoding="async"
                fetchpriority="high"
              />
            ) : (
              <img
                class="navbar17__brand-img"
                src="/images/brand/logo-navbar-228.webp"
                srcset="/images/brand/logo-navbar-228.webp 1x, /images/brand/logo-navbar-456.webp 2x"
                alt=""
                width="228"
                height="159"
                decoding="async"
                {...(!isLanding ? { fetchpriority: 'high' as const } : {})}
              />
            )
          }
        </a>

        <nav class="navbar17__desktop" aria-label="Primary navigation">
          <ul class="navbar17__list" data-nav-list role="list">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.link}
                  class="navbar17__link"
                  data-nav-item
                  data-nav-section={item.sectionId || undefined}
                  data-nav-page={item.isPage ? item.link : undefined}
                >
                  {item.name}
                </a>
              </li>
            ))}
            <span class="navbar17__indicator" data-nav-indicator aria-hidden="true"></span>
          </ul>
        </nav>

        <div class="navbar17__right">
          <!-- Desktop actions -->
          <div class="navbar17__actions">
            {showCart ? <NavbarCartButton class="navbar17__cart-btn" /> : null}
            {
              ctaHref ? (
                <a href={ctaHref} class="navbar17__cta-btn" data-demo-cta={ctaDemoAttr} data-track={ctaTrack}>{ctaLabel}</a>
              ) : (
                <button type="button" class="navbar17__cta-btn">{ctaLabel}</button>
              )
            }
          </div>

          <!-- Mobile controls: hamburger -->
          <div class="navbar17__mobile-controls">
            {
              ctaHref ? (
                <a href={ctaHref} class="navbar17__mobile-bar-cta" data-demo-cta={ctaDemoAttr} data-track={ctaTrack}>{ctaLabel}</a>
              ) : (
                <button type="button" class="navbar17__mobile-bar-cta">{ctaLabel}</button>
              )
            }
            <button
              class="navbar17__toggle"
              type="button"
              aria-expanded="false"
              aria-haspopup="dialog"
              aria-controls="mobile-menu"
              data-nav-toggle
            >
              <span class="navbar17__toggle-icon" aria-hidden="true"></span>
              <span class="sr-only">Open navigation menu</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <nav
      id="mobile-menu"
      class="navbar17__mobile"
      aria-label="Mobile navigation"
      data-mobile-nav
      aria-hidden="true"
      inert
    >
      <ul class="navbar17__mobile-list" role="list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.link}
              class="navbar17__mobile-link"
              data-mobile-item
              data-nav-section={item.sectionId || undefined}
              data-nav-page={item.isPage ? item.link : undefined}
            >
              <span class="navbar17__mobile-link-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={item.icon}></path>
                </svg>
              </span>
              {item.name}
            </a>
          </li>
        ))}
        {showCart ? (
          <li class="navbar17__mobile-cart-item">
            <NavbarCartButton class="navbar17__cart-btn navbar17__cart-btn--mobile-list" mobileSheet />
          </li>
        ) : null}
      </ul>
    </nav>
  </div>

  <div
    class="navbar17__mobile-backdrop"
    data-mobile-nav-backdrop
    aria-hidden="true"
  ></div>
</header>

<Navbar17ClientScript />
