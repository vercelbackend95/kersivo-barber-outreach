---
import NavbarCartButton from '@/components/shop/NavbarCartButton.astro';

const navItems = [
  { name: 'Home',    link: '/#home',    sectionId: 'home',    isPage: false },
  { name: 'System',  link: '/#system',  sectionId: 'system',  isPage: false },
  { name: 'Pricing', link: '/#pricing', sectionId: 'pricing', isPage: false },
  { name: 'FAQ',     link: '/#faq',     sectionId: 'faq',     isPage: false },
  { name: 'Shop',    link: '/shop',     sectionId: null,      isPage: true  },
  { name: 'Contact', link: '/#contact', sectionId: 'contact', isPage: false },
];
---

<header class="navbar17" data-navbar17>
  <div class="container navbar17__wrap">

    <a href="/#home" class="navbar17__brand" aria-label="Kersivo – back to homepage">
      <!-- Local monogram mark – no external CDN dependency; swap for real logo asset when ready -->
      <span class="navbar17__brand-mark" aria-hidden="true">K</span>
      <span class="navbar17__brand-name">Kersivo</span>
    </a>

    <nav class="navbar17__desktop" aria-label="Primary navigation">
      <ul class="navbar17__list" data-nav-list role="list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.link}
              class="navbar17__link"
              data-nav-item
              data-nav-section={item.sectionId || undefined}
              data-nav-page={item.isPage ? item.link : undefined}
            >
              {item.name}
            </a>
          </li>
        ))}
        <span class="navbar17__indicator" data-nav-indicator aria-hidden="true"></span>
      </ul>
    </nav>

    <div class="navbar17__right">
      <!-- Desktop actions -->
      <div class="navbar17__actions">
        <NavbarCartButton class="navbar17__cart-btn" />
        <a href="/book" class="navbar17__cta-btn">Book Demo</a>
      </div>

      <!-- Mobile controls: cart icon + hamburger -->
      <div class="navbar17__mobile-controls">
        <NavbarCartButton class="navbar17__cart-btn navbar17__cart-btn--mobile" />
        <button
          class="navbar17__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-nav-toggle
        >
          <span class="navbar17__toggle-icon" aria-hidden="true"></span>
          <span class="sr-only">Open navigation menu</span>
        </button>
      </div>
    </div>

  </div>

  <div
    class="navbar17__mobile-backdrop"
    data-mobile-nav-backdrop
    aria-hidden="true"
  ></div>

  <nav
    id="mobile-menu"
    class="navbar17__mobile"
    aria-label="Mobile navigation"
    data-mobile-nav
    aria-hidden="true"
    inert
  >
    <ul class="navbar17__mobile-list" role="list">
      {navItems.map((item) => (
        <li>
          <a
            href={item.link}
            class="navbar17__mobile-link"
            data-mobile-item
            data-nav-section={item.sectionId || undefined}
            data-nav-page={item.isPage ? item.link : undefined}
          >
            {item.name}
          </a>
        </li>
      ))}
    </ul>
    <div class="navbar17__mobile-footer">
      <a href="/book" class="navbar17__mobile-cta">Book Demo</a>
    </div>
  </nav>
</header>

<script type="module">
  const navbar = document.querySelector('[data-navbar17]');
  if (!navbar) { /* guard */ }
  else {
    const links       = [...navbar.querySelectorAll('[data-nav-item]')];
    const mobileLinks = [...navbar.querySelectorAll('[data-mobile-item]')];
    const indicator   = navbar.querySelector('[data-nav-indicator]');
    const navList     = navbar.querySelector('[data-nav-list]');
    const toggle      = navbar.querySelector('[data-nav-toggle]');
    const mobileNav   = navbar.querySelector('[data-mobile-nav]');
    const mobileBackdrop = navbar.querySelector('[data-mobile-nav-backdrop]');

    /* ── Indicator ─────────────────────────────────────────── */
    const moveIndicator = (linkEl) => {
      if (!(indicator instanceof HTMLElement) || !(navList instanceof HTMLElement)) return;
      if (!linkEl) {
        indicator.style.width   = '0px';
        indicator.style.opacity = '0';
        return;
      }
      const listRect   = navList.getBoundingClientRect();
      const activeRect = linkEl.getBoundingClientRect();
      indicator.style.width     = `${activeRect.width}px`;
      indicator.style.transform = `translateX(${activeRect.left - listRect.left}px)`;
      indicator.style.opacity   = '1';
    };

    /* ── Active state setters ───────────────────────────────── */
    const setActiveById = (sectionId) => {
      [...links, ...mobileLinks].forEach((link) => {
        link.classList.toggle(
          'is-active',
          link.getAttribute('data-nav-section') === sectionId
        );
      });
      moveIndicator(links.find((l) => l.classList.contains('is-active')) ?? null);
    };

    const setActiveByPage = (pathname) => {
      [...links, ...mobileLinks].forEach((link) => {
        const page = link.getAttribute('data-nav-page');
        link.classList.toggle('is-active', !!page && pathname.startsWith(page));
      });
      // Delay indicator positioning until after layout paint
      requestAnimationFrame(() => {
        moveIndicator(links.find((l) => l.classList.contains('is-active')) ?? null);
      });
    };

    /* ── Scroll state (frosted glass sticky) ────────────────── */
    const updateScrollState = () => {
      navbar.toggleAttribute('data-scrolled', window.scrollY > 10);
    };
    window.addEventListener('scroll', updateScrollState, { passive: true });
    updateScrollState();

    /* ── IntersectionObserver scroll-spy ────────────────────── */
    const initScrollSpy = () => {
      const sectionIds = [
        ...new Set(links.map((l) => l.getAttribute('data-nav-section')).filter(Boolean)),
      ];
      if (!sectionIds.length) return;

      const visible = new Set();

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) visible.add(entry.target.id);
            else visible.delete(entry.target.id);
          });

          if (!visible.size) return;

          // Among currently visible sections, pick the one whose top is
          // closest to the viewport's top edge — most-prominent rule
          let closestId   = null;
          let closestDist = Infinity;
          visible.forEach((id) => {
            const el = document.getElementById(id);
            if (!el) return;
            const dist = Math.abs(el.getBoundingClientRect().top);
            if (dist < closestDist) { closestDist = dist; closestId = id; }
          });

          if (closestId) setActiveById(closestId);
        },
        // Root margin: top 5% dead zone, bottom 40% cut-off — ensures the
        // section that dominates the upper viewport is the one marked active
        { threshold: 0, rootMargin: '-5% 0px -40% 0px' }
      );

      sectionIds.forEach((id) => {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
      });
    };

    /* ── Mobile: right off-canvas + backdrop + a11y ─────────── */
    const FOCUSABLE_SELECTOR =
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

    let mobileKeyHandler = null;

    const setMenuButtonLabel = (open) => {
      const label = toggle?.querySelector('.sr-only');
      if (label) label.textContent = open ? 'Close navigation menu' : 'Open navigation menu';
    };

    const closeMobileMenu = () => {
      if (!(toggle instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
      if (toggle.getAttribute('aria-expanded') !== 'true') return;

      toggle.setAttribute('aria-expanded', 'false');
      navbar.classList.remove('navbar17--mobile-nav-open');
      mobileNav.setAttribute('aria-hidden', 'true');
      mobileNav.setAttribute('inert', '');
      document.body.style.overflow = '';
      setMenuButtonLabel(false);

      if (mobileKeyHandler) {
        document.removeEventListener('keydown', mobileKeyHandler);
        mobileKeyHandler = null;
      }

      if (!window.matchMedia('(min-width: 64rem)').matches) {
        toggle.focus();
      }
    };

    const openMobileMenu = () => {
      if (!(toggle instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
      if (toggle.getAttribute('aria-expanded') === 'true') return;

      toggle.setAttribute('aria-expanded', 'true');
      navbar.classList.add('navbar17--mobile-nav-open');
      mobileNav.removeAttribute('inert');
      mobileNav.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      setMenuButtonLabel(true);

      const focusable = [...mobileNav.querySelectorAll(FOCUSABLE_SELECTOR)].filter(
        (el) => el instanceof HTMLElement,
      );
      focusable[0]?.focus();

      mobileKeyHandler = (event) => {
        if (event.key === 'Escape') {
          event.preventDefault();
          closeMobileMenu();
          return;
        }
        if (event.key !== 'Tab' || focusable.length === 0) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      };

      document.addEventListener('keydown', mobileKeyHandler);
    };

    if (toggle instanceof HTMLButtonElement && mobileNav instanceof HTMLElement) {
      toggle.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        if (isOpen) closeMobileMenu();
        else openMobileMenu();
      });
    }

    mobileBackdrop?.addEventListener('click', () => {
      closeMobileMenu();
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', closeMobileMenu);
    });

    const desktopNavMq = window.matchMedia('(min-width: 64rem)');
    const onDesktopNavBreakpoint = () => {
      if (desktopNavMq.matches) closeMobileMenu();
    };
    desktopNavMq.addEventListener('change', onDesktopNavBreakpoint);

    /* ── Init ───────────────────────────────────────────────── */
    const pathname = window.location.pathname.replace(/\/$/, '') || '/';
    const isHome   = pathname === '/';

    if (isHome) {
      initScrollSpy();
      const hash = window.location.hash.replace('#', '');
      setActiveById(hash || 'home');
      window.addEventListener('hashchange', () => {
        const h = window.location.hash.replace('#', '');
        setActiveById(h || 'home');
      });
    } else {
      setActiveByPage(pathname);
    }

    // Recalculate indicator on resize (handles font/layout shifts)
    window.addEventListener('resize', () => {
      const active = links.find((l) => l.classList.contains('is-active'));
      if (active) moveIndicator(active);
    });
  }
</script>
