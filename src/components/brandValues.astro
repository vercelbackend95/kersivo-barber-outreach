---
interface ValueCard {
  heading: string;
  body: string;
  glyph: 'shop' | 'zero' | 'system' | 'setup' | 'open';
  /** PNG/WebP with transparency — floats into section background (no photo frame). */
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  /** Flat marketing illustration (Booksy-style), not a boxed photo. */
  imageStyle?: 'illustration' | 'photo';
}

interface Props {
  values?: ValueCard[];
}

const {
  values = [
    {
      heading: 'Easy booking for clients',
      body: 'Service, barber, slot \u2014 three taps and they\u2019re in. No app-store detour, no marketplace maze. Your page, their phone, booked before the fade\u2019s dry.',
      glyph: 'shop',
      image: '/images/Ilustracje/8.webp',
      imageWidth: 1536,
      imageHeight: 1024,
      imageAlt: 'Client in the barber chair on their phone \u2014 easy booking in a few taps',
      imageStyle: 'illustration',
    },
    {
      heading: 'Own your shop online',
      body: 'Your domain, your brand \u2014 not a tile in someone else\u2019s marketplace. Clients book easy and pre-order for pickup at the chair while they\u2019re getting the cut. Money lands in your Stripe account. Simple.',
      glyph: 'zero',
      image: '/images/Ilustracje/shoppyonline.webp',
      imageWidth: 1536,
      imageHeight: 1024,
      imageAlt: 'Barber in the chair on his laptop \u2014 running his shop online from the chair',
      imageStyle: 'illustration',
    },
    {
      heading: 'SMS reminders',
      body: 'Clients get a ping before their cut \u2014 fewer no-shows. QR on the shop window: passers-by scan it, see your next free slot, and book on the spot.',
      glyph: 'system',
      image: '/images/Ilustracje/reminder.webp',
      imageWidth: 928,
      imageHeight: 1152,
      imageAlt: 'Person walking with phone \u2014 SMS appointment reminder pops up',
      imageStyle: 'illustration',
    },
    {
      heading: 'No-show protection',
      body: 'Deposits, reminders, and booking safeguards that keep your chair filled and your schedule protected. Ghost slots? Not today.',
      glyph: 'setup',
      image: '/images/Ilustracje/3.webp',
      imageWidth: 912,
      imageHeight: 1136,
      imageAlt: 'Barber chair with shield icons \u2014 no-show protection keeps your schedule safe',
      imageStyle: 'illustration',
    },
    {
      heading: '0% commission',
      body: 'Monthly Care is all we charge \u2014 zero cut on bookings, zero cut on retail. Not a penny more from Kersivo. Stripe handles cards; your margin stays yours.',
      glyph: 'open',
      image: '/images/Ilustracje/0%25.webp',
      imageWidth: 822,
      imageHeight: 1024,
      imageAlt: 'Barber in chair on his phone \u2014 speech bubble reads 0% commission!',
      imageStyle: 'illustration',
    },
    {
      heading: 'Build your own brand',
      body: 'Every booking strengthens your business, not somebody else\u2019s platform. Your domain, your customers, your reputation \u2014 compounding on your name, not theirs.',
      glyph: 'shop',
      image: '/images/Ilustracje/barberszyld.webp',
      imageWidth: 1536,
      imageHeight: 1024,
      imageAlt: 'Barber on a ladder outside his barbershop \u2014 BARBER sign mounted on the building',
      imageStyle: 'illustration',
    },
  ],
} = Astro.props as Props;
---

<section class="brand-values" aria-labelledby="brand-values-title">
  <div class="container">
    <div class="brand-values__intro">
      <p class="brand-values__eyebrow">WHAT KERSIVO IS</p>
      <h2 id="brand-values-title" class="brand-values__heading">YOUR BOOKING. YOUR BRAND. ZERO KERSIVO COMMISSION.</h2>
      <p class="brand-values__lead">
        A complete booking, admin and retail system on your own domain &mdash; built and launched for you, then yours to run.
      </p>
    </div>

    <ul class="brand-values__list" role="list">
      {values.map((value, index) => (
        <li
          class:list={[
            'brand-values__row',
            { 'brand-values__row--reverse': index % 2 === 1 },
            { 'brand-values__row--visual': Boolean(value.image) || value.imageStyle === 'illustration' },
            { 'brand-values__row--illustration': value.imageStyle === 'illustration' },
          ]}
        >
          <div
            class:list={[
              'brand-values__visual',
              { 'brand-values__visual--illustration': value.imageStyle === 'illustration' },
            ]}
          >
            {value.image ? (
              <img
                class:list={[
                  'brand-values__image',
                  { 'brand-values__image--illustration': value.imageStyle === 'illustration' },
                ]}
                src={value.image}
                alt={value.imageAlt ?? ''}
                width={value.imageWidth ?? (value.imageStyle === 'illustration' ? 912 : 1600)}
                height={value.imageHeight ?? (value.imageStyle === 'illustration' ? 1136 : 1000)}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            ) : value.imageStyle === 'illustration' ? (
              <div class="brand-values__illustration-placeholder" aria-hidden="true"></div>
            ) : (
              <div class="brand-values__visual-fallback" aria-hidden="true">
                <span class="brand-values__icon">
                  {value.glyph === 'zero' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <ellipse cx="12" cy="12" rx="6" ry="8"/>
                      <path d="m5 5 14 14"/>
                    </svg>
                  )}
                  {value.glyph === 'system' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="6" rx="1.5"/>
                      <rect x="3" y="14" width="8" height="6" rx="1.5"/>
                      <rect x="13" y="14" width="8" height="6" rx="1.5"/>
                    </svg>
                  )}
                  {value.glyph === 'setup' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14.7 6.3a4 4 0 1 1-5 5L4 17v3h3l5.7-5.7"/>
                      <path d="m14 8 2 2"/>
                      <path d="M17 3l4 4-3 3-4-4z"/>
                    </svg>
                  )}
                  {value.glyph === 'open' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="11" width="18" height="10" rx="1.5"/>
                      <path d="M7 11V8a5 5 0 0 1 10 0"/>
                      <circle cx="12" cy="16" r="1"/>
                    </svg>
                  )}
                </span>
              </div>
            )}
            {value.imageStyle !== 'illustration' && (
              <div class="brand-values__visual-fade" aria-hidden="true"></div>
            )}
          </div>

          <div class="brand-values__content">
            <h3 class="brand-values__card-title">{value.heading}</h3>
            <p class="brand-values__card-body-text">{value.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
