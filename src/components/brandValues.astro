---
interface ValueCard {
  heading: string;
  body: string;
  glyph: 'shop' | 'zero' | 'system' | 'setup' | 'open';
  /** PNG/WebP with transparency — floats into section background (no photo frame). */
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  /** Flat marketing illustration (Booksy-style), not a boxed photo. */
  imageStyle?: 'illustration' | 'photo';
}

interface Props {
  values?: ValueCard[];
}

const {
  values = [
    {
      heading: 'Own your shop online',
      body: 'Your domain. Your brand. Your client list. Not a tile in someone else\u2019s marketplace.',
      glyph: 'shop',
      image: '/images/Ilustracje/8.png',
      imageWidth: 918,
      imageHeight: 1152,
      imageAlt: 'Barber and client in the chair, both on their phones — your shop online, your brand',
      imageStyle: 'illustration',
    },
    {
      heading: '0% commission, by design',
      body: 'Never a cut on bookings or retail. Stripe applies only to online card payments.',
      glyph: 'zero',
      image: '/images/Ilustracje/0%25.png',
      imageWidth: 822,
      imageHeight: 1024,
      imageAlt: 'Barber in chair on his phone; speech bubble reads 0% commission!',
      imageStyle: 'illustration',
    },
    {
      heading: 'One system for the day',
      body: 'Booking, admin and retail under one login. No glued-together stack.',
      glyph: 'system',
      image: '/images/Ilustracje/reminder.png',
      imageWidth: 928,
      imageHeight: 1152,
      imageAlt: 'Barber walking with phone and a Kersivo speech bubble reminder',
      imageStyle: 'illustration',
    },
    {
      heading: 'Set up for you',
      body: 'Services, team, deposits, reminders, retail, domain. We build, you run your shop.',
      glyph: 'setup',
      image: '/images/Ilustracje/3.png',
      imageWidth: 912,
      imageHeight: 1136,
      imageAlt: 'Barber chair with shield icons — Kersivo sets up your shop for you',
      imageStyle: 'illustration',
    },
    {
      heading: 'Transparent. No lock-in.',
      body: 'Setup + monthly Care + Stripe = the whole bill. Your data exports anytime.',
      glyph: 'open',
      image: '/images/Ilustracje/0%25.png',
      imageWidth: 822,
      imageHeight: 1024,
      imageAlt: 'Barber in chair on his phone; speech bubble reads 0% — transparent pricing, no lock-in',
      imageStyle: 'illustration',
    },
  ],
} = Astro.props as Props;
---

<section class="brand-values" aria-labelledby="brand-values-title">
  <div class="container">
    <div class="brand-values__intro">
      <p class="brand-values__eyebrow">WHAT KERSIVO IS</p>
      <h2 id="brand-values-title" class="brand-values__heading">YOUR BOOKING. YOUR BRAND. ZERO COMMISSION.</h2>
      <p class="brand-values__lead">
        A complete booking, admin and retail system on your own domain &mdash; built and launched for you, then yours to run.
      </p>
    </div>

    <ul class="brand-values__list" role="list">
      {values.map((value, index) => (
        <li
          class:list={[
            'brand-values__row',
            { 'brand-values__row--reverse': index % 2 === 1 },
            { 'brand-values__row--visual': Boolean(value.image) },
            { 'brand-values__row--illustration': value.imageStyle === 'illustration' },
          ]}
        >
          <div
            class:list={[
              'brand-values__visual',
              { 'brand-values__visual--illustration': value.imageStyle === 'illustration' },
            ]}
          >
            {value.image ? (
              <img
                class:list={[
                  'brand-values__image',
                  { 'brand-values__image--illustration': value.imageStyle === 'illustration' },
                ]}
                src={value.image}
                alt={value.imageAlt ?? ''}
                width={value.imageWidth ?? (value.imageStyle === 'illustration' ? 912 : 1600)}
                height={value.imageHeight ?? (value.imageStyle === 'illustration' ? 1136 : 1000)}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            ) : (
              <div class="brand-values__visual-fallback" aria-hidden="true">
                <span class="brand-values__icon">
                  {value.glyph === 'zero' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <ellipse cx="12" cy="12" rx="6" ry="8"/>
                      <path d="m5 5 14 14"/>
                    </svg>
                  )}
                  {value.glyph === 'system' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="6" rx="1.5"/>
                      <rect x="3" y="14" width="8" height="6" rx="1.5"/>
                      <rect x="13" y="14" width="8" height="6" rx="1.5"/>
                    </svg>
                  )}
                  {value.glyph === 'setup' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14.7 6.3a4 4 0 1 1-5 5L4 17v3h3l5.7-5.7"/>
                      <path d="m14 8 2 2"/>
                      <path d="M17 3l4 4-3 3-4-4z"/>
                    </svg>
                  )}
                  {value.glyph === 'open' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="11" width="18" height="10" rx="1.5"/>
                      <path d="M7 11V8a5 5 0 0 1 10 0"/>
                      <circle cx="12" cy="16" r="1"/>
                    </svg>
                  )}
                </span>
              </div>
            )}
            {value.imageStyle !== 'illustration' && (
              <div class="brand-values__visual-fade" aria-hidden="true"></div>
            )}
          </div>

          <div class="brand-values__content">
            <h3 class="brand-values__card-title">{value.heading}</h3>
            <p class="brand-values__card-body-text">{value.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
