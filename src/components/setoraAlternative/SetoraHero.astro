---
import HeroDashboardShowcase from '@/components/marketing/HeroDashboardShowcase.astro';
import { KERSIVO_BOOKING_DEPOSIT_GBP, SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import { requireVerifiedSetoraFact } from '@/lib/seo/setoraFacts';
const setoraMonthly = requireVerifiedSetoraFact('canonicalMonthlyGbp').value;
---

<section class="fresha-alt-hero" aria-labelledby="setora-alt-hero-title">
  <div class="fresha-alt-hero__content">
    <nav class="setora-alt-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Setora alternative</span>
    </nav>
    <p class="fresha-alt-hero__eyebrow"><span class="fresha-alt-hero__eyebrow-dot" aria-hidden="true"></span>
      Setora alternative for UK barbershops
    </p>
    <h1 id="setora-alt-hero-title" class="fresha-alt-hero__title">
      <span class="fresha-alt-hero__title-line fresha-alt-hero__title-line--primary">A Setora alternative</span>
      <span class="fresha-alt-hero__title-line">built for your</span>
      <span class="fresha-alt-hero__title-line">barbershop.</span>
    </h1>
    <p class="fresha-alt-hero__lead">
      Setora's main UK pricing page lists £{setoraMonthly}/month per location with unlimited staff
      and no platform commission. Full KERSIVO is £{SAAS_MONTHLY_GBP}/month per location and includes
      a branded website and standard domain. Or start with KERSIVO Starter at £0/month for up to four
      active bookable barbers; public bookings require a £{KERSIVO_BOOKING_DEPOSIT_GBP} deposit or full payment through Stripe.
    </p>
    <div class="fresha-alt-hero__actions">
      <a href="/demo" class="fresha-alt-hero__action fresha-alt-hero__action--primary" data-track="view_live_demo_click">
        Open the full demo
      </a>
      <a href="#comparison" class="fresha-alt-hero__action fresha-alt-hero__action--secondary">Compare KERSIVO and Setora</a>
    </div>
    <div class="fresha-alt-hero__meta" aria-label="KERSIVO commercial model">
      <span><strong>Starter £0/month</strong></span><span aria-hidden="true">·</span>
      <span><strong>Full £{SAAS_MONTHLY_GBP}/month per location</strong></span><span aria-hidden="true">·</span>
      <span>0% KERSIVO commission</span><span aria-hidden="true">·</span>
      <span>Independent UK barbershops</span>
    </div>
  </div>
  <HeroDashboardShowcase />
</section>

<style>
  .setora-alt-breadcrumb {
    display: flex; align-items: center; flex-wrap: wrap; gap: .55rem; margin-bottom: 1rem;
    color: #9ca3af; font-size: .75rem; line-height: 1.5;
  }
  .setora-alt-breadcrumb a { color: inherit; text-decoration: none; }
  .setora-alt-breadcrumb a:hover, .setora-alt-breadcrumb a:focus-visible {
    color: #f9fafb; text-decoration: underline;
  }
</style>
