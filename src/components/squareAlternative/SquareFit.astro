---
import ModelComparison from '@/components/editorial/ModelComparison.astro';
import { SQUARE_FIT_CLOSING, SQUARE_FIT_PATHS } from '@/lib/seo/squareAlternativeContent';
---

<section id="which-model" class="fresha-alt__section" aria-labelledby="fresha-alt-fit-title">
  <div class="container">
    <header class="fresha-alt__intro">
      <p class="fresha-alt__eyebrow">TWO MODELS</p>
      <h2 id="fresha-alt-fit-title" class="fresha-alt__h2">Which model fits your barbershop?</h2>
    </header>

    <ModelComparison idPrefix="fresha-alt-fit" models={SQUARE_FIT_PATHS} conclusion={SQUARE_FIT_CLOSING}>
      Also comparing Booksy? <a href="/booksy-alternative">Compare KERSIVO and Booksy <span aria-hidden="true">→</span></a>
      <span> · </span><a href="/nearcut-alternative">Compare KERSIVO and Nearcut <span aria-hidden="true">→</span></a>
      <span> · </span><a href="/squire-alternative">Compare KERSIVO and SQUIRE <span aria-hidden="true">→</span></a>
      <span> · </span><a href="/setora-alternative">Setora comparison <span aria-hidden="true">→</span></a>
    </ModelComparison>
  </div>
</section>
