---
import {SQUARE_ALTERNATIVE_LAST_UPDATED_ISO,SQUARE_ALTERNATIVE_LAST_UPDATED_LABEL} from '@/lib/seo/squareAlternativeFaq';
import {SQUARE_FACTS_CHECKED_ISO,SQUARE_FACTS_CHECKED_DATE,SQUARE_SOURCES,SQUARE_TRADEMARK_DISCLAIMER} from '@/lib/seo/squareFacts';
---
<section id="sources" class="fresha-alt-sources" aria-labelledby="square-sources-title">
 <div class="container">
  <header class="fresha-alt-sources__header"><h2 id="square-sources-title" class="fresha-alt-sources__title">Sources &amp; comparison notes</h2><p class="fresha-alt-sources__meta">Square facts checked <time datetime={SQUARE_FACTS_CHECKED_ISO}>{SQUARE_FACTS_CHECKED_DATE}</time><span aria-hidden="true"> · </span>Last updated <time datetime={SQUARE_ALTERNATIVE_LAST_UPDATED_ISO}>{SQUARE_ALTERNATIVE_LAST_UPDATED_LABEL}</time></p></header>
  <p>Pricing and features were checked against Square’s official UK pages and Help Centre. Square’s listed subscription prices and processing rates may change. This is a product comparison published by KERSIVO, not an independent review of every Square feature.</p>
  <ul class="fresha-alt-sources__list">{SQUARE_SOURCES.map(source=>(<li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a><span class="fresha-alt-sources__supports">{source.supports}</span></li>))}</ul>
  <p class="fresha-alt-sources__trademark">{SQUARE_TRADEMARK_DISCLAIMER}</p>
 </div>
</section>