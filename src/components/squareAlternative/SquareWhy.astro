---
import InsightCards from '@/components/editorial/InsightCards.astro';
import { SQUARE_WHY_INTRO, SQUARE_WHY_THEMES } from '@/lib/seo/squareAlternativeContent';
---

<section id="why-switch" class="square-alt__section" aria-labelledby="square-alt-why-title">
  <div class="container">
    <header class="square-alt__intro">
      <p class="square-alt__eyebrow">WHY BARBERS COMPARE</p>
      <h2 id="square-alt-why-title" class="square-alt__h2">
        Why UK barbers look for a Square Appointments alternative
      </h2>
      <p class="square-alt__lead">{SQUARE_WHY_INTRO}</p>
    </header>

    <InsightCards items={SQUARE_WHY_THEMES} />
  </div>
</section>
