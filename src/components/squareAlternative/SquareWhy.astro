---
import InsightCards from '@/components/editorial/InsightCards.astro';
import { SQUARE_WHY_INTRO, SQUARE_WHY_THEMES } from '@/lib/seo/squareAlternativeContent';
---

<section id="why-switch" class="fresha-alt__section" aria-labelledby="fresha-alt-why-title">
  <div class="container">
    <header class="fresha-alt__intro">
      <p class="fresha-alt__eyebrow">WHY BARBERS COMPARE</p>
      <h2 id="fresha-alt-why-title" class="fresha-alt__h2">
        Why UK barbers look for a Square Appointments alternative
      </h2>
      <p class="fresha-alt__lead">{SQUARE_WHY_INTRO}</p>
    </header>

    <InsightCards items={SQUARE_WHY_THEMES} />
    <p class="fresha-alt__lead">Square actively supports barbershops too — see <a href="https://squareup.com/gb/en/solutions/barbershop" target="_blank" rel="noopener noreferrer">Square for Barbershops</a>. The meaningful distinction is Square's integrated POS ecosystem versus the own-domain digital experience included with Full KERSIVO.</p>
  </div>
</section>
