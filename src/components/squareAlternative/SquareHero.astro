---
import HeroDashboardShowcase from '@/components/marketing/HeroDashboardShowcase.astro';
import { KERSIVO_BOOKING_DEPOSIT_GBP, SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
---

<section class="square-alt-hero" aria-labelledby="square appointments-alt-hero-title">
  <div class="square-alt-hero__content">
    <nav class="square appointments-alt-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Square Appointments alternative</span>
    </nav>
    <p class="square-alt-hero__eyebrow">
      <span class="square-alt-hero__eyebrow-dot" aria-hidden="true"></span>
      Square Appointments alternative for UK barbershops
    </p>

    <h1 id="square appointments-alt-hero-title" class="square-alt-hero__title">
      <span class="square-alt-hero__title-line square-alt-hero__title-line--primary">A Square Appointments alternative</span>
      <span class="square-alt-hero__title-line">built around your</span>
      <span class="square-alt-hero__title-line">barbershop.</span>
    </h1>

    <p class="square-alt-hero__lead">
      Square Appointments combines scheduling with payments and POS. Square Free is £0/month, Plus is £29/month and Premium is £69/month per location. KERSIVO Starter is £0/month for up to four bookable barbers; Full KERSIVO is £39/month per location with your own branded website and standard domain.
    </p>

    <div class="square-alt-hero__actions">
      <a
        href="/demo"
        class="square-alt-hero__action square-alt-hero__action--primary"
        data-track="view_live_demo_click"
      >
        Open the full demo
      </a>
      <a
        href="#comparison"
        class="square-alt-hero__action square-alt-hero__action--secondary"
      >
        Compare KERSIVO and Square Appointments
      </a>
    </div>

    <div class="square-alt-hero__meta" aria-label="KERSIVO commercial model">
      <span><strong>Starter £0/month</strong></span>
      <span aria-hidden="true">·</span>
      <span><strong>Full £{SAAS_MONTHLY_GBP}/month per location</strong></span>
      <span aria-hidden="true">·</span>
      <span>0% KERSIVO commission on booking payments</span>
      <span aria-hidden="true">·</span>
      <span>Built for independent UK barbershops</span>
    </div>
  </div>

  <HeroDashboardShowcase />
</section>


<style>
  .square appointments-alt-breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 1rem;
    color: #9ca3af;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .square appointments-alt-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .square appointments-alt-breadcrumb a:hover,
  .square appointments-alt-breadcrumb a:focus-visible {
    color: #f9fafb;
    text-decoration: underline;
  }
</style>
