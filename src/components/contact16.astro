---
interface Contact16Props {
  className?: string;
}

const { className = "" } = Astro.props as Contact16Props;
---

<section id="contact" class={`contact16 ${className}`.trim()} aria-labelledby="contact16-title">
  <span id="book-demo" aria-hidden="true"></span>

  <div class="container">
    <h2 id="contact16-title" class="contact16__title">GET THIS PERFORMANCE FOR YOUR SHOP.</h2>

    <div class="contact16__layout">
      <div class="contact16__info">
        <p class="contact16__description">
          Ready to outpace your competition? Send us a few details and we'll show you how a sub-second website with zero-commission bookings can scale your business.
        </p>
        <p class="contact16__note">We usually reply within 24 hours.</p>
      </div>

      <form class="contact16__form" data-contact-form novalidate>
        <p class="contact16__status contact16__status--idle" data-contact-status role="status" aria-live="polite"></p>
        <input type="hidden" name="intent" value="" data-demo-intent />
        <label>
          <span class="sr-only">Name</span>
          <input type="text" name="name" placeholder="Name*" required />
        </label>
        <label>
          <span class="sr-only">Email</span>
          <input type="email" name="email" placeholder="Email*" required />
        </label>
        <label>
          <span class="contact16__field-label">Tell us about your shop</span>
          <textarea
            name="message"
            placeholder="Tell us what your barbershop needs"
            rows="4"

            required
            data-demo-message
          ></textarea>

        </label>

        <button type="submit" class="btn btn--ghost contact16__submit" data-contact-submit>
          ↳ GET STARTED
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector('[data-contact-form]');
  const statusEl = document.querySelector('[data-contact-status]');
  const submitBtn = document.querySelector('[data-contact-submit]');

  if (form instanceof HTMLFormElement && statusEl instanceof HTMLElement) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const fd = new FormData(form);
      const name = String(fd.get('name') ?? '').trim();
      const email = String(fd.get('email') ?? '').trim();
      const message = String(fd.get('message') ?? '').trim();
      const intent = String(fd.get('intent') ?? '').trim();

      statusEl.textContent = '';
      statusEl.className = 'contact16__status contact16__status--idle';

      if (!name || !email || !message) {
        statusEl.textContent = 'Please fill in name, email and your message.';
        statusEl.classList.add('contact16__status--error');
        return;
      }

      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = true;
      }

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, message, intent }),
        });
        const data = (await response.json().catch(() => ({}))) as { ok?: boolean; error?: string };

        if (!response.ok || !data.ok) {
          statusEl.textContent = data.error ?? 'Something went wrong. Please try again.';
          statusEl.className = 'contact16__status contact16__status--error';
          return;
        }

        statusEl.textContent = 'Thanks — we’ve received your message and will be in touch shortly.';
        statusEl.className = 'contact16__status contact16__status--success';
        form.reset();
      } catch {
        statusEl.textContent = 'Network error. Check your connection and try again.';
        statusEl.className = 'contact16__status contact16__status--error';
      } finally {
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = false;
        }
      }
    });
  }
</script>
