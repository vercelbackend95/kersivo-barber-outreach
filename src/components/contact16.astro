---
import '../styles/components/contact16.css';

interface Contact16Props {
  className?: string;
  eyebrow?: string;
  submitLabel?: string;
  title?: string;
  description?: string;
  note?: string;
}

const {
  className = "",
  eyebrow = "CONTACT KERSIVO",
  submitLabel = "Send my question",
  title = "Have a question before you subscribe?",
  description = "Tell us what you use today and what you want to improve. We’ll reply with a clear, practical answer for your barbershop.",
  note = "We’ll reply by email — no sales call required.",
} = Astro.props as Contact16Props;
---

<section id="contact" class={`contact16 ${className}`.trim()} aria-labelledby="contact16-title">
  <span id="book-demo" aria-hidden="true"></span>

  <div class="container">
    <div class="contact16__layout">
      <div class="contact16__info">
        <p class="contact16__eyebrow">{eyebrow}</p>
        <h2 id="contact16-title" class="contact16__title">{title}</h2>
        <p class="contact16__description">{description}</p>
        <p class="contact16__note">{note}</p>
      </div>

      <form class="contact16__form" data-contact-form novalidate>
        <p class="contact16__status contact16__status--idle" data-contact-status role="status" aria-live="polite"></p>
        <input type="hidden" name="intent" value="" data-demo-intent />
        <div class="hp-field" aria-hidden="true">
          <label>
            Company website
            <input
              type="text"
              name="companyWebsite"
              tabindex="-1"
              autocomplete="off"
            />
          </label>
        </div>

        <div class="contact16__field-grid">
          <label>
            <span class="contact16__field-label">Your name</span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              maxlength="200"
              placeholder="Alex Smith"
            />
          </label>
          <label>
            <span class="contact16__field-label">Email address</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              maxlength="254"
              inputmode="email"
              placeholder="alex@barbershop.co.uk"
            />
          </label>
        </div>

        <div class="contact16__field-grid">
          <label>
            <span class="contact16__field-label">Barbershop name</span>
            <input
              type="text"
              name="shopName"
              required
              autocomplete="organization"
              maxlength="160"
              placeholder="Your barbershop name"
            />
          </label>
          <label>
            <span class="contact16__field-label">Current booking system</span>
            <select name="currentStack" required>
              <option value="">Select your current system</option>
              <option value="booksy">Booksy</option>
              <option value="fresha">Fresha</option>
              <option value="nearcut">Nearcut</option>
              <option value="other-platform">Other booking platform</option>
              <option value="mixed-manual">Manual bookings / mixed tools</option>
              <option value="none">No booking system</option>
            </select>
          </label>
        </div>

        <label>
          <span class="contact16__field-label">What would you like help with?</span>
          <textarea
            name="message"
            required
            rows="5"
            maxlength="8000"
            data-demo-message
            placeholder="For example: switching from Booksy, setting up deposits, moving client data or launching a new booking website."
          ></textarea>
        </label>

        <button type="submit" class="btn btn--ghost contact16__submit" data-contact-submit>
          {submitLabel}
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  import { trackConsentedEvent } from '@/lib/consent/events';
  import { FUNNEL_EVENTS } from '@/lib/analytics/funnelEvents';

  const form = document.querySelector('[data-contact-form]');
  const statusEl = document.querySelector('[data-contact-status]');
  const submitBtn = document.querySelector('[data-contact-submit]');

  if (form instanceof HTMLFormElement && statusEl instanceof HTMLElement) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (submitBtn instanceof HTMLButtonElement && submitBtn.disabled) {
        return;
      }

      statusEl.textContent = '';
      statusEl.className = 'contact16__status contact16__status--idle';

      if (!form.checkValidity()) {
        form.reportValidity();
        statusEl.textContent =
          'Please complete all required fields and enter a valid email address.';
        statusEl.className = 'contact16__status contact16__status--error';
        return;
      }

      const fd = new FormData(form);
      const companyWebsite = String(fd.get('companyWebsite') ?? '').trim();
      const name = String(fd.get('name') ?? '').trim();
      const email = String(fd.get('email') ?? '').trim();
      const shopName = String(fd.get('shopName') ?? '').trim();
      const currentStack = String(fd.get('currentStack') ?? '').trim();
      const message = String(fd.get('message') ?? '').trim();
      const intent = String(fd.get('intent') ?? '').trim();

      const originalLabel =
        submitBtn instanceof HTMLButtonElement ? submitBtn.textContent : null;

      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      }
      form.setAttribute('aria-busy', 'true');

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            email,
            shopName,
            currentStack,
            message,
            intent,
            companyWebsite,
          }),
        });
        const data = (await response.json().catch(() => ({}))) as { ok?: boolean; error?: string };

        if (!response.ok || !data.ok) {
          statusEl.textContent = data.error ?? 'Something went wrong. Please try again.';
          statusEl.className = 'contact16__status contact16__status--error';
          return;
        }

        // Track only after the API confirms real email delivery (not a fake/dev success).
        trackConsentedEvent(FUNNEL_EVENTS.setup_enquiry_submit, undefined, 'analytics');
        statusEl.textContent =
          'Thanks — we’ve received your message. We’ll reply by email shortly.';
        statusEl.className = 'contact16__status contact16__status--success';
        form.reset();
      } catch {
        statusEl.textContent = 'Network error. Check your connection and try again.';
        statusEl.className = 'contact16__status contact16__status--error';
      } finally {
        form.setAttribute('aria-busy', 'false');
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = false;
          if (originalLabel != null) {
            submitBtn.textContent = originalLabel;
          }
        }
      }
    });
  }
</script>
