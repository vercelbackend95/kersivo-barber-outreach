---
import {
  CHAIR_RENT_CALCULATOR_BREADCRUMB_NAME,
  CHAIR_RENT_CALCULATOR_LAST_UPDATED_ISO,
  CHAIR_RENT_CALCULATOR_LAST_UPDATED_LABEL,
  CHAIR_RENT_HERO,
} from '@/lib/seo/chairRentCalculatorPage';
---

<header class="cost-calc-hero crc-hero" aria-labelledby="crc-hero-title">
  <div class="crc-hero__inner">
    <nav class="crc-breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">{CHAIR_RENT_CALCULATOR_BREADCRUMB_NAME}</li>
      </ol>
    </nav>
    <p class="cost-calc-hero__eyebrow">
      <span class="cost-calc-hero__eyebrow-dot" aria-hidden="true"></span>
      {CHAIR_RENT_HERO.eyebrow}
    </p>
    <h1 id="crc-hero-title" class="cost-calc-hero__title">{CHAIR_RENT_HERO.title}</h1>
    <p class="cost-calc-hero__lead">{CHAIR_RENT_HERO.lead}</p>
    <p class="cost-calc-hero__supporting">{CHAIR_RENT_HERO.supporting}</p>
    <p class="cost-calc-hero__note">
      {CHAIR_RENT_HERO.privacy}
      <span class="cost-calc-hero__updated">
        Last updated <time datetime={CHAIR_RENT_CALCULATOR_LAST_UPDATED_ISO}>{CHAIR_RENT_CALCULATOR_LAST_UPDATED_LABEL}</time>
      </span>
    </p>
  </div>
</header>
