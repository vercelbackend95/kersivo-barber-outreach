---
import PreviewTopBar from '@/components/freePreview/PreviewTopBar';
import {
  HUB_ACTIVITY_EMPTY,
  HUB_ACTIVITY_TITLE,
  HUB_CHECKLIST_PROGRESS,
  HUB_CHECKLIST_TITLE,
  HUB_HELP_EMAIL,
  HUB_HELP_EMAIL_HREF,
  HUB_HELP_MESSAGE,
  HUB_HELP_TITLE,
  HUB_LAUNCH_DONE,
  HUB_LAUNCH_FINISH_DASHBOARD,
  HUB_LAUNCH_ITEM_APPROVE,
  HUB_LAUNCH_ITEM_BUSINESS,
  HUB_LAUNCH_ITEM_DOMAIN,
  HUB_LAUNCH_ITEM_MIGRATION,
  HUB_LAUNCH_ITEM_PAYMENTS,
  HUB_LAUNCH_OUR_DOMAIN,
  HUB_LAUNCH_OUR_PUBLISH,
  HUB_LAUNCH_OUR_SSL,
  HUB_LAUNCH_OUR_STEPS,
  HUB_LAUNCH_PENDING,
  HUB_LAUNCH_TO_DO,
  HUB_LAUNCH_YOUR_STEPS,
  HUB_LIVE_NEXT_DEPOSITS,
  HUB_LIVE_NEXT_GOOGLE,
  HUB_LIVE_NEXT_HOURS,
  HUB_LIVE_NEXT_QR,
  HUB_LIVE_NEXT_RETAIL,
  HUB_LIVE_NEXT_TITLE,
  HUB_LIVE_OPEN_SITE,
  HUB_NOW,
  HUB_NOW_LABEL_DOING,
  HUB_NOW_LABEL_NEED,
  HUB_PREVIEW_CARD_LOCKED,
  HUB_PREVIEW_OPEN_WEBSITE,
  HUB_PREVIEW_TRY_BOOKING,
  HUB_PRIMARY,
  hubHeaderCopy,
} from '@/lib/freePreview/hubCopy';
import type { HubLaunchProgress, LaunchItem, OurLaunchStep } from '@/lib/freePreview/hubLaunch';
import type { HubChecklistItem } from '@/lib/freePreview/hubChecklist';
import { HubReviewCards, type HubReviewMap } from '@/components/previewHub/HubReviewCards';
import type { HubReviewShopData } from '@/lib/freePreview/hubReviews';
import { PREVIEW_ONBOARDING_PATH, previewPagePath } from '@/lib/freePreview/config';
import {
  formatHubStepDate,
  hostnameOf,
  type HubActivityItem,
  type HubStepperStep,
} from '@/lib/freePreview/hubPage';
import { hubHeaderKind, type HubState } from '@/lib/freePreview/hubStage';
import type { TokenPreviewRequest } from '@/lib/freePreview/previewAccess';

interface Props {
  token: string;
  request: TokenPreviewRequest;
  state: Extract<HubState, { kind: 'hub' }>;
  isOperator: boolean;
  steps: HubStepperStep[];
  activity: HubActivityItem[];
  hasWebsitePreview: boolean;
  checklist?: { items: HubChecklistItem[]; done: number; total: number };
  reviews?: HubReviewMap;
  reviewShop?: HubReviewShopData | null;
  reviewNeed?: string;
  launchProgress?: HubLaunchProgress | null;
  logoAssetId?: string | null;
  brandColour?: string | null;
}

const { token, request, state, isOperator, steps, activity, hasWebsitePreview, checklist, reviews, reviewShop, reviewNeed, launchProgress, logoAssetId, brandColour } = Astro.props;
function shopInitials(name: string) {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return 'K';
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return `${parts[0][0] ?? ''}${parts[1][0] ?? ''}`.toUpperCase();
}
const previewColour = brandColour?.trim() || '#d72638';
const logoSrc = logoAssetId
  ? `/api/preview-hub/${encodeURIComponent(token)}/assets/${encodeURIComponent(logoAssetId)}?size=thumb`
  : null;
const YOUR_STEP_LABEL: Record<LaunchItem, string> = {
  business: HUB_LAUNCH_ITEM_BUSINESS,
  domain: HUB_LAUNCH_ITEM_DOMAIN,
  payments: HUB_LAUNCH_ITEM_PAYMENTS,
  migration: HUB_LAUNCH_ITEM_MIGRATION,
  approve: HUB_LAUNCH_ITEM_APPROVE,
};
const OUR_STEP_LABEL: Record<OurLaunchStep, string> = {
  domain: HUB_LAUNCH_OUR_DOMAIN,
  ssl: HUB_LAUNCH_OUR_SSL,
  live: HUB_LAUNCH_OUR_PUBLISH,
};
const LIVE_NEXT = [
  { href: '/insights/google-business-profile-booking-link-barbershop', label: HUB_LIVE_NEXT_GOOGLE },
  { href: '/admin?section=barbershop_settings#qr-kit', label: HUB_LIVE_NEXT_QR },
  { href: '/admin?section=barbershop_settings', label: HUB_LIVE_NEXT_DEPOSITS },
  { href: '/admin/retail-onboarding', label: HUB_LIVE_NEXT_RETAIL },
  { href: '/admin?section=team', label: HUB_LIVE_NEXT_HOURS },
] as const;
const shopName = request.shopName;
const header = hubHeaderCopy(hubHeaderKind(state), shopName);
const nowCopy = state.stage === 'review' && state.reviewSubstate === 'changes_sent' ? HUB_NOW.reviewChangesSent : HUB_NOW[state.stage];
const nowNeed = state.stage === 'review' && state.reviewSubstate !== 'changes_sent' && reviewNeed ? reviewNeed : nowCopy.need;
const base = previewPagePath(token);
const primaryHref =
  state.stage === 'requested' || state.stage === 'designing'
    ? `${base}/details`
    : state.stage === 'review'
      ? `${base}/website`
      : state.stage === 'launch'
        ? PREVIEW_ONBOARDING_PATH
        : state.stage === 'live'
          ? '/admin'
          : state.stage === 'declined'
            ? `${base}/messages?draft=message`
            : state.stage === 'expired'
              ? `${base}/messages?draft=reopen`
              : undefined;
const primaryLabel =
  state.stage === 'review' && state.reviewSubstate === 'changes_sent'
    ? HUB_PRIMARY.reviewChangesSent
    : HUB_PRIMARY[state.stage];
---

<article class="hub-overview">
  <header class="hub-header">
    <div>
      <h1>{header.h1}</h1>
      <p class="hub-header__sub">{header.sub}</p>
    </div>
    <div class="hub-header__actions">
      {
        primaryHref ? (
          <a class="btn btn--primary" href={primaryHref}>
            {primaryLabel}
          </a>
        ) : null
      }
      {
        state.capabilities.canCheckout ? (
          <PreviewTopBar
            client:load
            chrome="checkout"
            token={token}
            shopName={shopName}
            townCity={request.townCity}
            firstName={request.firstName}
            checkoutEmail={request.email}
            hasOwnDomain={request.hasOwnDomain ?? 'not_sure'}
            existingWebsiteHost={hostnameOf(request.websiteUrl)}
            isOperator={isOperator}
            converted={request.status === 'CONVERTED'}
            activeView="website"
            websiteHref={`${base}/website`}
            bookingHref={`${base}/website?view=booking`}
          />
        ) : null
      }
    </div>
  </header>

  <ol class="hub-stepper" aria-label="Preview progress">
    {
      steps.map((step) => (
        <li class:list={['hub-stepper__item', `is-${step.status}`]}>
          <span class="hub-stepper__bar" aria-hidden="true" />
          <span class="hub-stepper__label">{step.label}</span>
          {step.date ? <span class="hub-stepper__date">{formatHubStepDate(step.date)}</span> : null}
        </li>
      ))
    }
  </ol>

  <section class="hub-card ks-glass-card ks-glass-card--accent" aria-labelledby="hub-now-title">
    <h2 id="hub-now-title" class="hub-card__title">Now</h2>
    <div class="hub-now">
      <div>
        <h3>{HUB_NOW_LABEL_DOING}</h3>
        <p>{nowCopy.doing}</p>
      </div>
      <div>
        <h3>{HUB_NOW_LABEL_NEED}</h3>
        <p>{nowNeed}</p>
      </div>
    </div>
  </section>

  {
    state.stage === 'launch' && launchProgress ? (
      <section class="hub-card ks-glass-card" aria-labelledby="hub-launch-title">
        <h2 id="hub-launch-title" class="hub-card__title">Launch progress</h2>
        <div class="hub-launch-progress">
          <div>
            <h3>{HUB_LAUNCH_YOUR_STEPS}</h3>
            <ul class="hub-checklist">
              {launchProgress.yourSteps.map((item) => (
                <li class:list={['hub-checklist__item', item.done ? 'is-done' : 'is-todo']}>
                  <span class="hub-checklist__mark" aria-hidden="true" />
                  <span>
                    {YOUR_STEP_LABEL[item.id]}
                    <span class="hub-checklist__hint">{item.done ? HUB_LAUNCH_DONE : HUB_LAUNCH_TO_DO}</span>
                  </span>
                </li>
              ))}
            </ul>
            <a class="btn btn--primary btn--sm" href={PREVIEW_ONBOARDING_PATH}>
              {HUB_LAUNCH_FINISH_DASHBOARD}
            </a>
          </div>
          <div>
            <h3>{HUB_LAUNCH_OUR_STEPS}</h3>
            <ul class="hub-checklist">
              {launchProgress.ourSteps.map((item) => (
                <li class:list={['hub-checklist__item', item.status === 'done' ? 'is-done' : 'is-todo']}>
                  <span class="hub-checklist__mark" aria-hidden="true" />
                  <span>
                    {OUR_STEP_LABEL[item.id]}
                    <span class="hub-checklist__hint">{item.status === 'done' ? HUB_LAUNCH_DONE : HUB_LAUNCH_PENDING}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ) : state.stage === 'live' ? (
      <section class="hub-card ks-glass-card" aria-labelledby="hub-preview-title">
        <h2 id="hub-preview-title" class="hub-card__title">{shopName}</h2>
        {launchProgress?.liveUrl ? (
          <a class="btn btn--primary btn--sm" href={launchProgress.liveUrl} rel="noopener noreferrer">
            {HUB_LIVE_OPEN_SITE}
          </a>
        ) : null}
      </section>
    ) : (
      <section class="hub-card ks-glass-card" aria-labelledby="hub-preview-title">
        <h2 id="hub-preview-title" class="hub-card__title">Your preview</h2>
        {
          state.capabilities.showPreview ? (
            <>
              <div class="hub-phone-frame" aria-hidden="true">
                <div class="hub-phone-frame__screen" style={`background:${previewColour}`}>
                  {logoSrc ? (
                    <img class="hub-phone-frame__logo" src={logoSrc} alt="" />
                  ) : (
                    <span class="hub-phone-frame__initials">{shopInitials(shopName)}</span>
                  )}
                </div>
              </div>
              <p class="hub-card__body">{shopName}</p>
              <div class="hub-preview-actions">
                <a class="btn btn--primary btn--sm" href={`${base}/website`}>
                  {HUB_PREVIEW_OPEN_WEBSITE}
                </a>
                <a class="btn btn--secondary btn--sm" href={`${base}/website?view=booking`}>
                  {HUB_PREVIEW_TRY_BOOKING}
                </a>
              </div>
              {!hasWebsitePreview ? (
                <p class="hub-card__body" style="margin-top:12px">
                  We're still adding services and barbers to this booking page.
                </p>
              ) : null}
            </>
          ) : (
            <div class="hub-preview-lock">
              <p class="ks-eyebrow">{shopName}</p>
              <p>{HUB_PREVIEW_CARD_LOCKED}</p>
            </div>
          )
        }
      </section>
    )
  }

  {
    state.capabilities.canReview && reviews ? (
      <HubReviewCards
        client:load
        token={token}
        detailsHref={`${base}/details`}
        canReview={state.capabilities.canReview}
        shop={reviewShop ?? null}
        reviews={reviews}
        mode="strip"
      />
    ) : null
  }

  {
    state.stage === 'live' ? (
      <section class="hub-card ks-glass-card" aria-labelledby="hub-next-title">
        <h2 id="hub-next-title" class="hub-card__title">{HUB_LIVE_NEXT_TITLE}</h2>
        <ul class="hub-live-next">
          {LIVE_NEXT.map((card) => (
            <li>
              <a class="hub-live-next__card" href={card.href}>
                {card.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : checklist && state.stage !== 'launch' ? (
      <section class="hub-card ks-glass-card" aria-labelledby="hub-checklist-title">
        <h2 id="hub-checklist-title" class="hub-card__title">
          {HUB_CHECKLIST_TITLE}
          <span class="hub-checklist__progress">{HUB_CHECKLIST_PROGRESS(checklist.done, checklist.total)}</span>
        </h2>
        <ul class="hub-checklist">
          {checklist.items.map((item) => (
            <li class:list={['hub-checklist__item', `is-${item.status}`]}>
              <span class="hub-checklist__mark" aria-hidden="true" />
              <span>
                {item.label}
                {item.hint ? <span class="hub-checklist__hint">{item.hint}</span> : null}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  <section class="hub-card ks-glass-card" aria-labelledby="hub-activity-title">
    <h2 id="hub-activity-title" class="hub-card__title">{HUB_ACTIVITY_TITLE}</h2>
    {
      activity.length ? (
        <ol class="hub-activity">
          {activity.map((item) => (
            <li>
              <span>{item.label}</span>
              <time datetime={item.at.toISOString()} title={item.absolute}>
                {item.relative}
              </time>
            </li>
          ))}
        </ol>
      ) : (
        <p class="hub-card__body">{HUB_ACTIVITY_EMPTY}</p>
      )
    }
  </section>

  <section class="hub-card ks-glass-card" aria-labelledby="hub-help-title">
    <h2 id="hub-help-title" class="hub-card__title">{HUB_HELP_TITLE}</h2>
    <p class="hub-card__body">Questions about your preview? Message us here or by email.</p>
    <div class="hub-help__row">
      <a class="btn btn--secondary btn--sm" href={`${base}/messages`}>
        {HUB_HELP_MESSAGE}
      </a>
      <a class="btn btn--ghost btn--sm" href={HUB_HELP_EMAIL_HREF}>
        {HUB_HELP_EMAIL}
      </a>
    </div>
  </section>
</article>
