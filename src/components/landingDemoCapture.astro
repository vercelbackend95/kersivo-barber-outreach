---
import '../styles/components/landingDemoCapture.css';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props as Props;
---

<section
  class={`landing-demo-capture ${className}`.trim()}
  aria-labelledby="landing-demo-capture-title"
>
  <div class="container">
    <div class="landing-demo-capture__soft">
      <p class="landing-demo-capture__soft-line">
        Not ready to subscribe yet?{' '}
        <button
          type="button"
          class="landing-demo-capture__trigger"
          data-demo-capture-trigger
          aria-expanded="false"
          aria-controls="landing-demo-capture-panel"
        >
          Send yourself the demo &amp; pricing
        </button>
      </p>
      <p class="landing-demo-capture__soft-line">
        Questions first?{' '}
        <a href="#contact" data-track="ask-about-setup">Ask About My Setup</a>
      </p>
    </div>

    <div
      class="landing-demo-capture__panel"
      id="landing-demo-capture-panel"
      data-demo-capture-panel
    >
      <div class="landing-demo-capture__panel-inner">
        <div class="landing-demo-capture__box">
          <h2 id="landing-demo-capture-title" class="landing-demo-capture__title">
            Send the KERSIVO demo and pricing to your inbox.
          </h2>

          <form class="landing-demo-capture__form" data-demo-capture-form novalidate>
            <div class="hp-field" aria-hidden="true">
              <label>
                Company website
                <input
                  type="text"
                  name="companyWebsite"
                  tabindex="-1"
                  autocomplete="off"
                />
              </label>
            </div>
            <label class="landing-demo-capture__field">
              <span class="sr-only">Email</span>
              <input type="email" name="email" placeholder="Email*" required data-demo-capture-email />
            </label>
            <label class="landing-demo-capture__field">
              <span class="sr-only">Barbershop name</span>
              <input type="text" name="shopName" placeholder="Barbershop name*" required />
            </label>
            <button
              type="submit"
              class="btn btn--secondary landing-demo-capture__submit"
              data-demo-capture-submit
            >
              Send Me The Demo
            </button>
          </form>

          <p
            class="landing-demo-capture__status landing-demo-capture__status--idle"
            data-demo-capture-status
            role="status"
            aria-live="polite"
          ></p>

          <p class="landing-demo-capture__microcopy">
            No spam. Just the demo link and setup details.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { trackConsentedEvent } from '@/lib/consent/events';
  import { FUNNEL_EVENTS } from '@/lib/analytics/funnelEvents';

  const trigger = document.querySelector('[data-demo-capture-trigger]');
  const panel = document.querySelector('[data-demo-capture-panel]');
  const emailInput = document.querySelector('[data-demo-capture-email]');
  const form = document.querySelector('[data-demo-capture-form]');
  const statusEl = document.querySelector('[data-demo-capture-status]');
  const submitBtn = document.querySelector('[data-demo-capture-submit]');
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  if (trigger instanceof HTMLButtonElement && panel instanceof HTMLElement) {
    trigger.addEventListener('click', () => {
      const isOpen = panel.hasAttribute('data-open');
      if (isOpen) {
        panel.removeAttribute('data-open');
        trigger.setAttribute('aria-expanded', 'false');
      } else {
        panel.setAttribute('data-open', '');
        trigger.setAttribute('aria-expanded', 'true');
        if (emailInput instanceof HTMLInputElement) {
          window.requestAnimationFrame(() => emailInput.focus());
        }
      }
    });
  }

  if (form instanceof HTMLFormElement && statusEl instanceof HTMLElement) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const fd = new FormData(form);
      const email = String(fd.get('email') ?? '').trim();
      const shopName = String(fd.get('shopName') ?? '').trim();
      const companyWebsite = String(fd.get('companyWebsite') ?? '').trim();

      statusEl.textContent = '';
      statusEl.className = 'landing-demo-capture__status landing-demo-capture__status--idle';

      if (!email || !EMAIL_RE.test(email)) {
        statusEl.textContent = 'Please enter a valid email address.';
        statusEl.className = 'landing-demo-capture__status landing-demo-capture__status--error';
        return;
      }

      if (!shopName) {
        statusEl.textContent = 'Please enter your barbershop name.';
        statusEl.className = 'landing-demo-capture__status landing-demo-capture__status--error';
        return;
      }

      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = true;
      }

      try {
        const response = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, shopName, companyWebsite }),
        });
        const data = (await response.json().catch(() => ({}))) as { ok?: boolean; error?: string };

        if (!response.ok || !data.ok) {
          statusEl.textContent = data.error ?? 'Something went wrong. Please try again.';
          statusEl.className = 'landing-demo-capture__status landing-demo-capture__status--error';
          return;
        }

        // Track only after the API confirms both lead + visitor emails were delivered.
        trackConsentedEvent(FUNNEL_EVENTS.demo_pricing_capture_submit, undefined, 'analytics');
        statusEl.textContent = 'Thanks — we’ve sent the KERSIVO demo and pricing details to your inbox.';
        statusEl.className = 'landing-demo-capture__status landing-demo-capture__status--success';
        form.reset();
      } catch {
        statusEl.textContent = 'Network error. Check your connection and try again.';
        statusEl.className = 'landing-demo-capture__status landing-demo-capture__status--error';
      } finally {
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = false;
        }
      }
    });
  }
</script>
