---
import Accordion from '@/components/ui/Accordion.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import '../styles/components/faq4.css';

interface FaqItem {
  question: string;
  answer: string;
  /** Optional extra context for teams that want more depth. */
  details?: string;
}

interface Props {
  heading?: string;
  subHeading?: string;
  supportHeading?: string;
  supportText?: string;
  supportLinkLabel?: string;
  supportLinkHref?: string;
  supportSecondaryLinkLabel?: string;
  supportSecondaryLinkOpensDemo?: boolean;
  faqs?: FaqItem[];
  className?: string;
}

const {
  heading = "Questions barbers ask before signing on",
  subHeading =
    "Straight answers on fees, migration, traffic, no-show protection, and what happens if you ever want to leave.",
  supportHeading = "Still have questions?",
  supportText = "Tell us your current setup \u2014 or that you have none yet \u2014 and we will map the cleanest setup path for your shop.",
  supportLinkLabel = "Talk to us about your shop",
  supportLinkHref = "#contact",
  supportSecondaryLinkLabel,
  supportSecondaryLinkOpensDemo = false,
  faqs = [],
  className = '',
} = Astro.props as Props;

const items = faqs.map((faq, index) => ({
  id: `faq-${index + 1}`,
  title: faq.question,
  body: faq.details ? `${faq.answer} ${faq.details}` : faq.answer,
}));
---

<section id="faq" class={`faq4 ${className}`.trim()} aria-labelledby="faq4-title">
  <div class="container faq4__container">
    <SectionHeader eyebrow="FAQ" title={heading} lead={subHeading} titleId="faq4-title" />

    <Accordion items={items} />

    <hr class="faq4__separator" />

    <div class="faq4__footer">
      <div>
        <h3>{supportHeading}</h3>
        <p>{supportText}</p>
      </div>
      <div class="faq4__footer-actions">
        <a href={supportLinkHref} class="btn btn--link faq4__support-link">
          {supportLinkLabel}
          <span aria-hidden="true">→</span>
        </a>
        {
          supportSecondaryLinkLabel ? (
            supportSecondaryLinkOpensDemo ? (
              <button type="button" class="btn btn--link faq4__support-link faq4__support-link--secondary" data-system-chooser-open>
                {supportSecondaryLinkLabel}
                <span aria-hidden="true">→</span>
              </button>
            ) : null
          ) : null
        }
      </div>
    </div>
  </div>
</section>
