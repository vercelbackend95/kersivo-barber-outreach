---
interface FaqItem {
  question: string;
  answer: string;
  /** Optional extra context for teams that want more depth. */
  details?: string;
}

interface Props {
  heading?: string;
  subHeading?: string;
  supportHeading?: string;
  supportText?: string;
  supportLinkLabel?: string;
  supportLinkHref?: string;
  faqs?: FaqItem[];
}

const {
  heading = "Questions Barbers Usually Ask Before Launch",
  subHeading =
    "What’s in the box, how Essential vs PRO differs, Managed Care (£40/m), domains, Stripe, and what happens if you don’t continue Care.",
  supportHeading = "Still have questions?",
  supportText = "If you want to talk through your shop's setup first, we can walk you through the best option.",
  supportLinkLabel = "Contact Support",
  supportLinkHref = "#contact",
  faqs = [
    {
      question: "What’s included in the website system?",
      answer:
        "Both tiers give you the same software stack: a custom site built to your brief, booking on your domain, a full admin (team, diary, shop, reports), buy-and-collect checkout, plus contact details, map and hours.",
      details:
        "Essential includes setup for up to 20 products and 1 month of hosting plus admin access. PRO includes up to 50 products, 3 months of hosting plus admin, featured products, more homepage and visual polish (per brief), priority in the launch queue, stronger go-live support, and we prep SMS on Managed Care (when you want it enabled) at go-live.",
    },
    {
      question: "What’s the difference between Essential and PRO?",
      answer:
        "Same platform—PRO adds a longer included period (3 months vs 1 month), more products at setup (50 vs 20), featured products, extra layout and polish on the homepage and key pages (per brief), priority launch, tighter go-live support, and SMS prep on Managed Care when you choose to turn it on.",
    },
    {
      question: "Does Kersivo take a cut of bookings or shop sales?",
      answer:
        "No. We don’t charge commission on bookings or retail run through your site. Card payments go through Stripe on your own Stripe account, so only Stripe’s standard processing fees apply there.",
    },
    {
      question: "How does payment work for the build?",
      answer:
        "It’s 50% to start and 50% before go-live. Prices are the totals shown for Essential or PRO. You review the near-final site before the balance is due and can request a small round of final tweaks as part of sign-off.",
    },
    {
      question: "Is booking included in every package?",
      answer:
        "Yes—integrated booking is part of both packages. The system is designed to work best with our built-in flow on your domain.",
      details:
        "If you already rely on another tool, we can discuss options, but the integrated booking path is what the product is optimised for.",
    },
    {
      question: "Can I sell products through the site?",
      answer:
        "Yes. There’s a built-in shop with pickup (no delivery step). Essential covers setup for up to 20 products; PRO up to 50. If you don’t use retail, the package price is unchanged.",
      details:
        "Returns and in-store pickup rules are yours to set as the seller; card payments are processed by Stripe on your account.",
    },
    {
      question: "What does Managed Care (£40/month) include?",
      answer:
        "After your included hosting/admin months end, Managed Care covers hosting, maintenance, security monitoring, full admin and shop access, optional client SMS when you want it enabled, and up to one hour of small in-scope changes from us each month.",
    },
    {
      question: "What happens if I don’t take Managed Care after the included period?",
      answer:
        "Our admin and integrated shop are switched off. We usually help you point clients to a third-party booking flow—for example Booksy or another scheduling tool you choose. The built-in shop stays off until Managed Care is on. There’s no self-serve way to keep our admin or shop without Managed Care.",
    },
    {
      question: "What about my domain name?",
      answer:
        "Your first year of domain registration is included in Essential and PRO—you don’t pay us an extra domain fee for that initial registration as part of those packages.",
      details:
        "If you are not on Managed Care (£40/month), renewal after the first 12 months is your responsibility: you pay the registrar’s renewal cost directly (or through the billing path we agree). Keep contact details on the registration up to date so you don’t lose the name.",
    },
    {
      question: "How long does a project usually take?",
      answer:
        "Most shops go live in about 14 days from kickoff, depending on how quickly you send assets and feedback. PRO gets priority in the queue when timelines are tight.",
    },
    {
      question: "Can I get SMS reminders for clients?",
      answer:
        "Yes, when you want them. SMS on Managed Care can be enabled for your shop; we’ll wire the integration when you’re ready. Until then, email confirmations and links still cover the core journey.",
    },
    {
      question: "What do you need from me before you start—and do I need to be technical?",
      answer:
        "We’ll need your logo, photos, service list, hours, contact details, and product info if you’re using the shop. Written content helps, but we can help shape copy during setup.",
      details:
        "You don’t need developer skills for day-to-day work on Managed Care—the admin is built for shop staff. Larger changes outside the monthly scope can be quoted separately.",
    },
  ],
} = Astro.props as Props;
---

<section id="faq" class="faq4" aria-labelledby="faq4-title">
  <div class="container faq4__container">
    <div class="faq4__header">
      <p class="faq4__badge">FAQ</p>
      <h2 id="faq4-title">{heading}</h2>
      <p>{subHeading}</p>
    </div>

    <div class="faq4__list" role="list">
      {
        faqs.map((faq) => (
          <details class="faq4__item" name="faq4-group" role="listitem">
            <summary>
              <span>{faq.question}</span>
              <span class="faq4__icon" aria-hidden="true">→</span>
            </summary>
            <div class="faq4__answer">
              <p>{faq.answer}</p>
              {faq.details ? (
                <details class="faq4__more">
                  <summary>More detail</summary>
                  <p>{faq.details}</p>
                </details>
              ) : null}
            </div>
          </details>
        ))
      }
    </div>

    <hr class="faq4__separator" />

    <div class="faq4__footer">
      <div>
        <h3>{supportHeading}</h3>
        <p>{supportText}</p>
      </div>
      <a href={supportLinkHref} class="faq4__support-link">
        {supportLinkLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
