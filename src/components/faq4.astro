---
import { FAQ_ITEMS } from '@/lib/seo/faqItems';
import '../styles/components/faq4.css';

interface FaqItem {
  question: string;
  answer: string;
  /** Optional extra context for teams that want more depth. */
  details?: string;
}

interface Props {
  heading?: string;
  subHeading?: string;
  supportHeading?: string;
  supportText?: string;
  supportLinkLabel?: string;
  supportLinkHref?: string;
  supportSecondaryLinkLabel?: string;
  supportSecondaryLinkOpensDemo?: boolean;
  faqs?: FaqItem[];
  className?: string;
}

const {
  heading = "Questions barbers ask before signing on",
  subHeading =
    "Straight answers on fees, migration, traffic, no-show protection, and what happens if you ever want to leave.",
  supportHeading = "Still have questions?",
  supportText = "Tell us your current setup \u2014 or that you have none yet \u2014 and we will map the cleanest setup path for your shop.",
  supportLinkLabel = "Talk to us about your shop",
  supportLinkHref = "#contact",
  supportSecondaryLinkLabel,
  supportSecondaryLinkOpensDemo = false,
  faqs = FAQ_ITEMS,
  className = '',
} = Astro.props as Props;
---

<section id="faq" class={`faq4 ${className}`.trim()} aria-labelledby="faq4-title">
  <div class="container faq4__container">
    <div class="faq4__header">
      <p class="faq4__badge">FAQ</p>
      <h2 id="faq4-title">{heading}</h2>
      <p>{subHeading}</p>
    </div>

    <div class="faq4__list">
      {
        faqs.map((faq) => (
          <details class="faq4__item" name="faq4-group">
            <summary>
              <span>{faq.question}</span>
              <span class="faq4__icon" aria-hidden="true">
                <span class="faq4__icon-plus">+</span>
                <span class="faq4__icon-minus">−</span>
              </span>
            </summary>
            <div class="faq4__answer">
              <p>{faq.answer}</p>
              {faq.details ? (
                <details class="faq4__more">
                  <summary>More detail</summary>
                  <p>{faq.details}</p>
                </details>
              ) : null}
            </div>
          </details>
        ))
      }
    </div>

    <hr class="faq4__separator" />

    <div class="faq4__footer">
      <div>
        <h3>{supportHeading}</h3>
        <p>{supportText}</p>
      </div>
      <div class="faq4__footer-actions">
        <a href={supportLinkHref} class="faq4__support-link">
          {supportLinkLabel}
          <span aria-hidden="true">→</span>
        </a>
        {
          supportSecondaryLinkLabel ? (
            supportSecondaryLinkOpensDemo ? (
              <button type="button" class="faq4__support-link faq4__support-link--secondary" data-system-chooser-open>
                {supportSecondaryLinkLabel}
                <span aria-hidden="true">→</span>
              </button>
            ) : null
          ) : null
        }
      </div>
    </div>
  </div>
</section>
