---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  heading?: string;
  subHeading?: string;
  supportHeading?: string;
  supportText?: string;
  supportLinkLabel?: string;
  supportLinkHref?: string;
  faqs?: FaqItem[];
}

const {
  heading = "Questions Barbers Usually Ask Before Launch",
  subHeading = "Clear answers on what is included, how setup works, and how monthly care supports your shop after launch.",
  supportHeading = "Still have questions?",
  supportText = "If you want to talk through your shop's setup first, we can walk you through the best option.",
  supportLinkLabel = "Contact Support",
  supportLinkHref = "#contact",
  faqs = [
    {
      question: "What’s included in the website system?",
      answer:
        "Every website includes a custom barber website, built-in booking flow, shop setup, admin system access, mobile-first design, contact details, map and opening hours. Base and Premium differ in scope, polish and product capacity, but both are built around the same core system.",
    },
    {
      question: "What’s the difference between Base and Premium?",
      answer:
        "Base is a strong starting point for shops that want a professional website with the full core system in place. Premium adds a more tailored presentation, a stronger homepage sales flow, more product capacity, featured product setup, priority launch and launch promotion support.",
    },
    {
      question: "Is booking included in every package?",
      answer:
        "Yes. Booking is part of the website system in both Base and Premium. If a shop strongly prefers an existing external booking tool, that can be discussed, but the system is built to work best with the integrated setup.",
    },
    {
      question: "Can I sell products through the site?",
      answer:
        "Yes. The system includes a built-in shop with pickup flow. Base includes setup for up to 20 products, while Premium includes setup for up to 50 products. If you choose not to use the shop, the package price does not change.",
    },
    {
      question: "What does the £40/month care plan include?",
      answer:
        "The monthly care plan keeps the full management side of the system running smoothly. It includes hosting, maintenance, security, updates, full admin access, shop management, booking management and 1 hour of small support updates each month.",
    },
    {
      question: "Can I use the website without the monthly care plan?",
      answer:
        "Yes, but with limits. Your website can stay live, your contact form still works, and customers can still submit bookings. However, the full admin and management side of the system is tied to the care plan. That includes things like managing bookings, editing services, updating shop products, changing opening hours and handling the wider day-to-day system from the admin side.",
    },
    {
      question: "How does payment work?",
      answer:
        "Projects are paid in two stages: 50% deposit to begin, and 50% before launch. Before the final payment, you’ll be able to review the site and request a small number of final adjustments if needed.",
    },
    {
      question: "How long does a project usually take?",
      answer:
        "Most projects are completed in around 2 weeks, depending on the package, the materials provided and final revisions. Premium projects are given priority.",
    },
    {
      question: "What do you need from me before you start?",
      answer:
        "The essentials are usually your logo, photos, service list, opening hours, contact details and product information if you want to use the shop. If you already have written content, that helps — but copy can also be created for you as part of the setup.",
    },
    {
      question: "Do I need technical skills to use the system?",
      answer:
        "No. If you’re on the monthly care plan, the system is designed to be easy to manage through the admin side without technical knowledge. If you need larger changes beyond normal ongoing updates, those can be quoted separately.",
    },
  ],
} = Astro.props as Props;
---

<section id="faq" class="faq4" aria-labelledby="faq4-title">
  <div class="container faq4__container">
    <div class="faq4__header">
      <p class="faq4__badge">FAQ</p>
      <h2 id="faq4-title">{heading}</h2>
      <p>{subHeading}</p>
    </div>

    <div class="faq4__list" role="list">
      {
        faqs.map((faq, index) => (
          <details class="faq4__item" name="faq4-group" role="listitem">
            <summary>
              <span>{faq.question}</span>
              <span class="faq4__icon" aria-hidden="true">→</span>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>

    <hr class="faq4__separator" />

    <div class="faq4__footer">
      <div>
        <h3>{supportHeading}</h3>
        <p>{supportText}</p>
      </div>
      <a href={supportLinkHref} class="faq4__support-link">
        {supportLinkLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>