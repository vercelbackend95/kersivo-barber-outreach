---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  heading?: string;
  subHeading?: string;
  supportHeading?: string;
  supportText?: string;
  supportLinkLabel?: string;
  supportLinkHref?: string;
  faqs?: FaqItem[];
}

const {
  heading = "Questions Barbers Usually Ask Before Launch",
  subHeading = "What’s in the box, how Essential vs PRO differs, and what £40/mo Care does after launch.",
  supportHeading = "Still have questions?",
  supportText = "If you want to talk through your shop's setup first, we can walk you through the best option.",
  supportLinkLabel = "Contact Support",
  supportLinkHref = "#contact",
  faqs = [
    {
      question: "What’s included in the website system?",
      answer:
        "Same stack on both tiers: custom site (per brief), booking on your domain, full admin (team, diary, shop, reports), buy-and-collect with Stripe, contact + map + hours. Essential: 20 products at setup, 1 month hosting + admin. PRO: 50 products, 3 months, featured products, stronger homepage, extra polish, priority launch, go-live support, plus SMS on Managed Care (where enabled) prepped at launch.",
    },
    {
      question: "What’s the difference between Essential and PRO?",
      answer:
        "Same software—PRO adds 3 months included (vs 1), 50 vs 20 products, featured products, more homepage and visual polish (per brief), priority queue, tighter go-live support, and SMS on Managed Care (where enabled) prepped at go-live.",
    },
    {
      question: "Is booking included in every package?",
      answer:
        "Yes. Booking is part of the website system in both Essential and PRO. If a shop strongly prefers an existing external booking tool, that can be discussed, but the system is built to work best with the integrated setup.",
    },
    {
      question: "Can I sell products through the site?",
      answer:
        "Yes. The system includes a built-in shop with pickup flow. Essential includes setup for up to 20 products, while PRO includes setup for up to 50 products. If you choose not to use the shop, the package price does not change.",
    },
    {
      question: "What does the £40/month care plan include?",
      answer:
        "Hosting, maintenance, security monitoring, full admin + shop, client SMS (where enabled), and 1h Kersivo dev per month for small changes. It kicks in after your included hosting/admin period ends.",
    },
    {
      question: "What happens if I don’t take Managed Care after the included period?",
      answer:
        "Our admin and integrated shop switch off. We can help point booking to a third-party tool if you need one; the built-in shop stays off until Care is on. There’s no separate self-serve way to keep our admin or shop without Care.",
    },
    {
      question: "How does payment work?",
      answer:
        "50% to start, 50% before go-live. Prices are totals as shown (we’re not VAT-registered). You review before the final payment and can request a small round of final tweaks.",
    },
    {
      question: "How long does a project usually take?",
      answer:
        "Most projects are completed in around 2 weeks, depending on the package, the materials provided and final revisions. PRO projects are given priority.",
    },
    {
      question: "What do you need from me before you start?",
      answer:
        "The essentials are usually your logo, photos, service list, opening hours, contact details and product information if you want to use the shop. If you already have written content, that helps — but copy can also be created for you as part of the setup.",
    },
    {
      question: "Do I need technical skills to use the system?",
      answer:
        "No. If you’re on the monthly care plan, the system is designed to be easy to manage through the admin side without technical knowledge. If you need larger changes beyond normal ongoing updates, those can be quoted separately.",
    },
  ],
} = Astro.props as Props;
---

<section id="faq" class="faq4" aria-labelledby="faq4-title">
  <div class="container faq4__container">
    <div class="faq4__header">
      <p class="faq4__badge">FAQ</p>
      <h2 id="faq4-title">{heading}</h2>
      <p>{subHeading}</p>
    </div>

    <div class="faq4__list" role="list">
      {
        faqs.map((faq, index) => (
          <details class="faq4__item" name="faq4-group" role="listitem">
            <summary>
              <span>{faq.question}</span>
              <span class="faq4__icon" aria-hidden="true">→</span>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>

    <hr class="faq4__separator" />

    <div class="faq4__footer">
      <div>
        <h3>{supportHeading}</h3>
        <p>{supportText}</p>
      </div>
      <a href={supportLinkHref} class="faq4__support-link">
        {supportLinkLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>