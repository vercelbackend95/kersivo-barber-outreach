---
/**
 * 24px outline icons for insight cards. Strokes use currentColor; one
 * element per icon carries the `insight-icon__signal` accent.
 */
import type { InsightIconName } from '@/lib/editorial/insightIcons';

interface Props {
  name: InsightIconName;
}

const { name } = Astro.props;
---

<svg
  class={`insight-icon insight-icon--${name}`}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'seats' && (
      <>
        <path d="M2.75 20.5h18.5" />
        <rect x="3.75" y="15" width="3.5" height="5.5" rx="1" />
        <rect x="10.25" y="12" width="3.5" height="8.5" rx="1" />
        <rect x="16.75" y="9" width="3.5" height="11.5" rx="1" />
        <circle cx="5.5" cy="11.6" r="1.6" />
        <circle cx="12" cy="8.6" r="1.6" />
        <circle class="insight-icon__signal" cx="18.5" cy="5.6" r="1.6" />
      </>
    )
  }
  {
    name === 'storefront' && (
      <>
        <rect x="2.75" y="4.25" width="18.5" height="15.5" rx="2.5" />
        <path d="M2.75 8.25h18.5" />
        <path d="M5.4 6.25h.01M7.4 6.25h.01" />
        <path d="M10.5 6.25h7.75" opacity="0.55" />
        <path d="M6 12.25h6.5M6 15.25h4" />
        <rect class="insight-icon__signal" x="14.25" y="12.5" width="4" height="3.25" rx="1" />
      </>
    )
  }
  {
    name === 'discovery' && (
      <>
        <path d="M12 20.25s-5.75-5.2-5.75-9.75a5.75 5.75 0 0 1 11.5 0c0 4.55-5.75 9.75-5.75 9.75z" />
        <circle class="insight-icon__signal" cx="12" cy="10.5" r="2" />
        <path d="M2.75 10.5h1.5M19.75 10.5h1.5M4.6 4.6l1.05 1.05M19.4 4.6l-1.05 1.05" opacity="0.55" />
      </>
    )
  }
  {
    name === 'network' && (
      <>
        <path d="M10.2 10.4L6.1 6.9M13.8 10.4l4.1-3.5M10.2 13.6l-4.1 3.5M13.8 13.6l4.1 3.5" opacity="0.8" />
        <circle cx="4.75" cy="5.75" r="1.75" />
        <circle cx="19.25" cy="5.75" r="1.75" />
        <circle cx="4.75" cy="18.25" r="1.75" />
        <circle cx="19.25" cy="18.25" r="1.75" />
        <circle class="insight-icon__signal" cx="12" cy="12" r="2.75" />
      </>
    )
  }
  {
    name === 'direct' && (
      <>
        <rect x="2.75" y="7.25" width="9" height="9" rx="2.25" />
        <path class="insight-icon__signal" d="M7.25 9.5l2.1 2.25-2.1 2.25-2.1-2.25z" />
        <path d="M11.75 11.75h3.5" />
        <circle cx="18.5" cy="9.25" r="2.25" />
        <path d="M14.75 17.75c.5-2 2-3.25 3.75-3.25s3.25 1.25 3.75 3.25" />
      </>
    )
  }
  {
    name === 'stack' && (
      <>
        <path class="insight-icon__signal" d="M12 3.5l8.5 4.25L12 12 3.5 7.75z" />
        <path d="M3.5 12L12 16.25 20.5 12" />
        <path d="M3.5 16.25L12 20.5l8.5-4.25" />
      </>
    )
  }
</svg>
