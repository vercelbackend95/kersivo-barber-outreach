---
import { ClientRouter } from 'astro:transitions';
import GoogleAnalytics from '@/components/seo/GoogleAnalytics.astro';
import CookieConsentMount from '@/components/consent/CookieConsentMount.astro';
import FaviconLinks from '@/components/seo/FaviconLinks.astro';
import SeoHead from '@/components/seo/SeoHead.astro';
import MarketingNavbar from '@/components/navigation/marketing/MarketingNavbar.astro';
import InitDataTrackScript from '@/components/InitDataTrackScript.astro';
import RouteTransitionRoot from '@/components/navigation/RouteTransitionRoot.astro';
import type { PageSeo } from '@/lib/seo/meta';
import fontFallbackFaces from '@/styles/fonts-fallback.css?raw';
import fontFaces from '@/styles/fonts-landing.css?raw';
import '@/styles/motion.css';
import '@/styles/tokens.css';
import '@/styles/global.css';
import '@/styles/components/buttons.css';
import '@/styles/components/marketing-navbar.css';
import '@/styles/components/route-transition.css';
import '@/styles/components/marketing-a11y.css';

interface Props extends PageSeo {
  title: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Insights pages preload editorial fonts via slot="head"; skip unused marketing preloads. */
  suppressMarketingFontPreloads?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogImagePath,
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
  ogType,
  noindex,
  robotsFollow,
  jsonLd,
  suppressMarketingFontPreloads = false,
} = Astro.props;

const persistentFontFaces = `${fontFallbackFaces}${fontFaces}`.replace(new RegExp('/[*][^]*?[*]/', 'g'), '');

const jsonLdBlocks = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---

<html lang="en-GB" data-app="marketing" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <GoogleAnalytics />
    <FaviconLinks />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!suppressMarketingFontPreloads && (
      <>
        <link rel="preload" href="/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/bebas-neue-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
      </>
    )}
    {/* Persisted across client-side navigation: re-creating @font-face rules makes the browser reload the fonts and repaint in the fallback. */}
    <style is:inline data-astro-transition-persist="ks-font-faces" set:html={persistentFontFaces} />
    <title>{title}</title>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImagePath={ogImagePath}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
      noindex={noindex}
      robotsFollow={robotsFollow}
    />
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    <style is:inline>
      html[data-app='marketing'],
      html[data-app='marketing'] body {
        background: #0b0d10;
      }
    </style>
    {/* fallback="none": browsers without view transitions keep normal page loads, so the veil can never stick. */}
    <ClientRouter fallback="none" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <MarketingNavbar />
    <RouteTransitionRoot variant="marketing">
      <slot />
    </RouteTransitionRoot>
    <div transition:persist="ks-cookie">
      <CookieConsentMount />
    </div>
    <InitDataTrackScript />
  </body>
</html>
