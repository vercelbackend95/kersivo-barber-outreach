---
import { ClientRouter } from 'astro:transitions';
import GoogleAnalytics from '@/components/seo/GoogleAnalytics.astro';
import CookieConsentMount from '@/components/consent/CookieConsentMount.astro';
import FaviconLinks from '@/components/seo/FaviconLinks.astro';
import SeoHead from '@/components/seo/SeoHead.astro';
import Navbar17 from '@/components/navbar17.astro';
import InitDataTrackScript from '@/components/InitDataTrackScript.astro';
import RouteTransitionRoot from '@/components/navigation/RouteTransitionRoot.astro';
import type { Navbar17CtaTrack, Navbar17Variant } from '@/lib/nav/navbar17Items';
import type { PageSeo } from '@/lib/seo/meta';
import '@/styles/motion.css';
import '@/styles/tokens.css';
import '@/styles/fonts-landing.css';
import '@/styles/global.css';
import '@/styles/components/buttons.css';
import '@/styles/components/navbar17.css';
import '@/styles/components/route-transition.css';

type LandingNavbarPreviewCta = {
  label: string;
  href: string | null;
  track?: Navbar17CtaTrack;
};

interface Props extends PageSeo {
  title: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Defaults to `landing` (homepage). Also used for shop marketing pages. */
  navbarVariant?: Navbar17Variant;
  /** When set, overrides middleware-resolved navbar CTA. */
  previewCta?: LandingNavbarPreviewCta | null;
}

const {
  title,
  description,
  canonicalPath,
  ogImagePath,
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
  ogType,
  noindex,
  robotsFollow,
  jsonLd,
  navbarVariant = 'landing',
  previewCta = null,
} = Astro.props;

const jsonLdBlocks = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---

<html lang="en-GB" data-app="marketing" transition:animate="none">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <FaviconLinks />
    <meta name="viewport" content="width=device-width" />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/antonio-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bebas-neue-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImagePath={ogImagePath}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
      noindex={noindex}
      robotsFollow={robotsFollow}
    />
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    <style is:inline>
      html[data-app='marketing'],
      html[data-app='marketing'] body {
        background: #0b0d10;
      }
    </style>
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body>
    <Navbar17 variant={navbarVariant} previewCta={previewCta} />
    <RouteTransitionRoot variant="marketing">
      <slot />
    </RouteTransitionRoot>
    <div transition:persist="ks-cookie">
      <CookieConsentMount />
    </div>
    <InitDataTrackScript />
  </body>
</html>
