---
import { ClientRouter } from 'astro:transitions';
import BarberDemoJsonLd from '@/components/seo/BarberDemoJsonLd.astro';
import GoogleAnalytics from '@/components/seo/GoogleAnalytics.astro';
import CookieConsentMount from '@/components/consent/CookieConsentMount.astro';
import FaviconLinks from '@/components/seo/FaviconLinks.astro';
import SeoHead from '@/components/seo/SeoHead.astro';
import Navbar17 from '@/components/navbar17.astro';
import StorefrontHeader from '@/components/shop/storefront/StorefrontHeader.astro';
import InitDataTrackScript from '@/components/InitDataTrackScript.astro';
import CartDrawerMount from '@/components/shop/CartDrawerMount.astro';
import RouteTransitionRoot from '@/components/navigation/RouteTransitionRoot.astro';
import type { PageSeo } from '@/lib/seo/meta';
import '@/styles/motion.css';
import '@/styles/tokens.css';
import '@/styles/fonts.css';
import '@/styles/global.css';
import '@/styles/components/buttons.css';
import '@/styles/components/badge.css';
import '@/styles/components/inputs.css';
import '@/styles/components/navbar17.css';
import '@/styles/components/shop.css';
import '@/styles/components/storefront-cart.css';
import '@/styles/components/empty-state.css';
import '@/styles/components/shop-product.css';
import '@/styles/components/route-transition.css';

import type { Navbar17Variant } from '@/lib/nav/navbar17Items';
import '@/styles/components/shop-product.css';

interface Props extends PageSeo {
  title: string;
  /** BarberDemo home JSON-LD (@graph); only enable on the main marketing landing page. */
  barberDemoJsonLd?: boolean;
  /** Optional extra JSON-LD object(s) rendered as script tags. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Navbar variant — `landing` simplifies nav on Google Ads pages. */
  navbarVariant?: Navbar17Variant;
  /** Public `/shop` sandbox — cart completes locally (no Stripe). */
  publicDemoMode?: boolean;
  /** Live tenant shop id — cart posts to public Connect checkout. */
  shopId?: string;
  /** Display name in the cart collection line. */
  shopName?: string;
  /** Tenant shop logo for the storefront header. */
  brandLogoUrl?: string | null;
  /** Empty-bag explore link. */
  exploreHref?: string;
}

const {
  title,
  description,
  canonicalPath,
  ogImagePath,
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
  ogType,
  noindex,
  robotsFollow,
  barberDemoJsonLd = false,
  jsonLd,
  navbarVariant = 'default',
  publicDemoMode = false,
  shopId,
  shopName,
  brandLogoUrl = null,
  exploreHref,
} = Astro.props;

const jsonLdBlocks = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];

const cartNamespace = shopId ? { shopId } : null;
const cartShopName = shopName?.trim() || (publicDemoMode ? 'KERSIVO' : 'Shop');
const cartExploreHref = exploreHref ?? (shopId ? `/shop/${shopId}` : '/shop');
const cartCheckout = publicDemoMode ? { type: 'publicDemo' as const } : { type: 'live' as const };
const currentPath = Astro.url.pathname;
const useTenantStorefrontHeader = Boolean(shopId) && navbarVariant === 'shop' && !publicDemoMode;
---

<html lang="en-GB" data-app="marketing" transition:animate="none">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <FaviconLinks />
    <meta name="viewport" content="width=device-width" />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/antonio-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImagePath={ogImagePath}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
      noindex={noindex}
      robotsFollow={robotsFollow}
    />
    {barberDemoJsonLd ? <BarberDemoJsonLd /> : null}
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    <style is:inline>
      html[data-app='marketing'],
      html[data-app='marketing'] body {
        background: #0b0d10;
      }
    </style>
    <ClientRouter fallback="swap" />
    {
      cartNamespace ? (
        <script is:inline define:vars={{ cartNamespace }}>
          window.__KERSIVO_CART_NAMESPACE__ = cartNamespace;
        </script>
      ) : null
    }
    <slot name="head" />
  </head>
  <body>
    <div data-sf-page-shell>
      {
        useTenantStorefrontHeader ? (
          <StorefrontHeader
            themeId="kersivo"
            currentPath={currentPath}
            homeHref={`/shop/${shopId}`}
            navHomeHref="/"
            homeLabel={`${cartShopName} shop`}
            items={[{ href: `/shop/${shopId}`, label: 'Shop' }]}
            bookHref={`/book/${shopId}`}
            shopName={cartShopName}
            logoUrl={brandLogoUrl}
            showBag
          />
        ) : (
          <Navbar17 variant={navbarVariant} />
        )
      }
      {
        useTenantStorefrontHeader ? (
          <div data-sf-header-inert>
            <RouteTransitionRoot variant="marketing">
              <slot />
            </RouteTransitionRoot>
          </div>
        ) : (
          <RouteTransitionRoot variant="marketing">
            <slot />
          </RouteTransitionRoot>
        )
      }
    </div>
    {
      navbarVariant === 'shop' ? (
        <div transition:persist="ks-cart">
          <CartDrawerMount
            mode={publicDemoMode ? 'publicDemo' : 'production'}
            shopId={shopId ?? ''}
            shopName={cartShopName}
            themeId="kersivo"
            priceFormat="gbp"
            exploreHref={cartExploreHref}
            checkout={cartCheckout}
          />
        </div>
      ) : null
    }
    <div transition:persist="ks-cookie">
      <CookieConsentMount />
    </div>
    <InitDataTrackScript />
  </body>
</html>
