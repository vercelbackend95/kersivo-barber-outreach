---
import BarberDemoJsonLd from '@/components/seo/BarberDemoJsonLd.astro';
import GoogleAnalytics from '@/components/seo/GoogleAnalytics.astro';
import CookieConsentMount from '@/components/consent/CookieConsentMount.astro';
import FaviconLinks from '@/components/seo/FaviconLinks.astro';
import SeoHead from '@/components/seo/SeoHead.astro';
import Navbar17 from '@/components/navbar17.astro';
import InitDataTrackScript from '@/components/InitDataTrackScript.astro';
import CartDrawerMount from '@/components/shop/CartDrawerMount.astro';
import type { PageSeo } from '@/lib/seo/meta';
import '@/styles/tokens.css';
import '@/styles/fonts.css';
import '@/styles/global.css';
import '@/styles/components/buttons.css';
import '@/styles/components/badge.css';
import '@/styles/components/inputs.css';
import '@/styles/components/navbar17.css';
import '@/styles/components/shop.css';
import '@/styles/components/empty-state.css';
import '@/styles/components/shop-product.css';

import type { Navbar17Variant } from '@/lib/nav/navbar17Items';
import '@/styles/components/shop-product.css';

interface Props extends PageSeo {
  title: string;
  /** BarberDemo home JSON-LD (@graph); only enable on the main marketing landing page. */
  barberDemoJsonLd?: boolean;
  /** Optional extra JSON-LD object(s) rendered as script tags. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Navbar variant — `landing` simplifies nav on Google Ads pages. */
  navbarVariant?: Navbar17Variant;
  /** Public `/shop` sandbox — CartDrawer completes locally (no Stripe). */
  publicDemoMode?: boolean;
  /** Live tenant shop id — CartDrawer posts to public Connect checkout. */
  shopId?: string;
}

const {
  title,
  description,
  canonicalPath,
  ogImagePath,
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
  ogType,
  noindex,
  robotsFollow,
  barberDemoJsonLd = false,
  jsonLd,
  navbarVariant = 'default',
  publicDemoMode = false,
  shopId,
} = Astro.props;

const jsonLdBlocks = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---

<html lang="en-GB">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <FaviconLinks />
    <meta name="viewport" content="width=device-width" />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/antonio-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImagePath={ogImagePath}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
      noindex={noindex}
      robotsFollow={robotsFollow}
    />
    {barberDemoJsonLd ? <BarberDemoJsonLd /> : null}
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    <slot name="head" />
  </head>
  <body>
    <Navbar17 variant={navbarVariant} />
    <slot />
    {
      navbarVariant === 'shop' ? (
        <CartDrawerMount publicDemoMode={publicDemoMode} shopId={shopId} />
      ) : null
    }
    <CookieConsentMount />
    <InitDataTrackScript />
  </body>
</html>
