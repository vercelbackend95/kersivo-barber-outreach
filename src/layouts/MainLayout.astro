---
import BarberDemoJsonLd from '@/components/seo/BarberDemoJsonLd.astro';
import Navbar17 from '@/components/navbar17.astro';
import CartDrawerMount from '@/components/shop/CartDrawerMount.astro';
import '@/styles/tokens.css';
import '@/styles/global.css';
import '@/styles/components/buttons.css';
import '@/styles/components/badge.css';
import '@/styles/components/inputs.css';
import '@/styles/components/navbar17.css';
import '@/styles/components/shop.css';
import '@/styles/components/empty-state.css';
import '@/styles/components/shop-product.css';
interface Props {
  title: string;
  /** BarberDemo home JSON-LD (@graph); only enable on the main marketing landing page. */
  barberDemoJsonLd?: boolean;
}

const { title, barberDemoJsonLd = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/images/logo-kersivo-dynamic.svg" />
    <link rel="icon" type="image/png" href="/images/logo-kersivo.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {barberDemoJsonLd ? <BarberDemoJsonLd /> : null}
  </head>
  <body>
    <Navbar17 />
    <slot />
    <CartDrawerMount />
  </body>
</html>