---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Footer50 from '@/components/footer50.astro';
import InsightsMasthead from '@/components/insights/InsightsMasthead.astro';
import InsightsDataTables from '@/components/insights/InsightsDataTables.astro';
import InsightsRelatedReading from '@/components/insights/InsightsRelatedReading.astro';
import InsightsCommercialNext from '@/components/insights/InsightsCommercialNext.astro';
import InsightsOwnerNote from '@/components/insights/InsightsOwnerNote.astro';
import InsightsCta from '@/components/insights/InsightsCta.astro';
import InsightsShortAnswer from '@/components/insights/InsightsShortAnswer.astro';
import '@/styles/components/insights-preview.css';
import {
  buildInsightsArticleJsonLd,
  formatInsightsDateLabel,
  isInsightsArticlePublished,
} from '@/lib/seo/insights';
import { getInsightsCategory, type InsightsCategoryId } from '@/lib/insights/categories';
import {
  getInsightsAudience,
  getInsightsCommercialNext,
  getInsightsOwnerNote,
  getInsightsRelatedLinks,
} from '@/lib/insights/insightsLinking';
import {
  findInsightsReferencesStart,
  getInsightsCta,
  hasInsightsCta,
  splitInsightsBodyAtMiddle,
} from '@/lib/insights/insightsCta';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import { EDITORIAL_STANDARDS_PATH, extractInsightsCitations } from '@/lib/insights/editorialStandards';
import { findInsightsShortAnswerSlot, getInsightsShortAnswer } from '@/lib/insights/insightsShortAnswers';

interface Props {
  title: string;
  description: string;
  slug: string;
  categoryId: InsightsCategoryId;
  /** Display label — derived from taxonomy; kept for masthead convenience. */
  category?: string;
  dateLabel?: string;
  sourceUrl: string;
  coverImage?: string;
  coverImageAlt?: string;
  headline: string;
  publishedDate: string;
  verifiedDate: string;
  updatedDate?: string;
  heroImage: string;
  ogImage?: string;
  ogImageAlt?: string;
  published?: boolean;
  suppressMarketingFontPreloads?: boolean;
}
const {
  title,
  description,
  slug,
  categoryId,
  category,
  dateLabel,
  sourceUrl,
  coverImage,
  coverImageAlt,
  headline,
  publishedDate,
  verifiedDate,
  updatedDate,
  heroImage,
  ogImage,
  ogImageAlt,
  published = false,
  suppressMarketingFontPreloads = true,
} = Astro.props;
const path = `/insights/${slug}`;
const taxonomy = getInsightsCategory(categoryId);
const categoryLabel = category ?? taxonomy.name;
/** Indexable only when the page asks for publish AND the slug is in the owner-approved registry. */
const isPublic = published && isInsightsArticlePublished(slug);
const related = getInsightsRelatedLinks(slug);
const commercialNext = getInsightsCommercialNext(slug);
const ownerNote = getInsightsOwnerNote(slug);
const audience = getInsightsAudience(slug);
/**
 * The owner note and the end CTA sit at the end of the article text, before the References/Sources list
 * (and the rule above it), so readers meet them before the citations. Owner-facing articles also get a
 * compact CTA before the middle section heading.
 */
const showCta = isPublic && hasInsightsCta(slug);
const freePreviewEnabled = isFreePreviewFlowEnabled();
const midCta = showCta ? getInsightsCta('mid', freePreviewEnabled) : undefined;
const endCta = showCta ? getInsightsCta('end', freePreviewEnabled) : undefined;
/** Answer-first block under the hero (GEO/AEO): question + quotable answer, also used as Article.abstract. */
const shortAnswer = isPublic ? getInsightsShortAnswer(slug) : undefined;
let bodyLead = '';
let bodyMain: string | undefined;
let bodyMid = '';
let bodyRefs = '';
if (isPublic && (shortAnswer || ownerNote || showCta)) {
  let html = await Astro.slots.render('default');
  const slot = shortAnswer ? findInsightsShortAnswerSlot(html) : -1;
  if (slot >= 0) {
    bodyLead = html.slice(0, slot);
    html = html.slice(slot);
  }
  const refsStart = findInsightsReferencesStart(html);
  const main = refsStart >= 0 ? html.slice(0, refsStart) : html;
  bodyRefs = refsStart >= 0 ? html.slice(refsStart) : '';
  const split = midCta ? splitInsightsBodyAtMiddle(main) : undefined;
  bodyMain = split ? split.before : main;
  bodyMid = split ? split.after : '';
}
const resolvedDateLabel = dateLabel ?? formatInsightsDateLabel(publishedDate);
/** Visible only when an editorial revision date differs from the publication date. */
const updatedDateLabel =
  updatedDate && updatedDate !== publishedDate ? `Updated ${formatInsightsDateLabel(updatedDate)}` : undefined;
const socialImage = ogImage ?? coverImage;
const socialAlt = ogImageAlt ?? coverImageAlt ?? headline;
---

<LandingLayout
  title={title}
  description={description}
  canonicalPath={path}
  ogType="article"
  ogImagePath={socialImage?.startsWith('/') || socialImage?.startsWith('http') ? socialImage : undefined}
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageAlt={socialAlt}
  noindex={!isPublic}
  suppressMarketingFontPreloads={suppressMarketingFontPreloads}
  jsonLd={
    isPublic
      ? buildInsightsArticleJsonLd({
          path,
          headline,
          description,
          publishedDate,
          verifiedDate,
          updatedDate,
          heroImage,
          ogImage,
          categoryId,
          abstract: shortAnswer?.answer,
          citation: bodyRefs ? extractInsightsCitations(bodyRefs) : undefined,
        })
      : undefined
  }
>
  <link
    slot="head"
    rel="preload"
    href="/fonts/newsreader-latin-700-normal.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <main class="insights-page">
    <InsightsMasthead
      page="article"
      category={categoryLabel}
      categoryHref={taxonomy.path}
      dateLabel={resolvedDateLabel}
      updatedLabel={updatedDateLabel}
      currentLabel={headline}
    />
    <div class="insights-paper">
      <article class="insights-article" aria-label={headline}>
        {audience && <p class="insights-article__audience">{audience}</p>}
        <div class="insights-article__body">
          {bodyMain !== undefined ? (
            <Fragment>
              {bodyLead && <Fragment set:html={bodyLead} />}
              {bodyLead && shortAnswer && <InsightsShortAnswer shortAnswer={shortAnswer} />}
              <Fragment set:html={bodyMain} />
              {midCta && bodyMid && <InsightsCta cta={midCta} />}
              {bodyMid && <Fragment set:html={bodyMid} />}
              {ownerNote && <InsightsOwnerNote note={ownerNote} />}
              {endCta && <InsightsCta cta={endCta} />}
              <Fragment set:html={bodyRefs} />
            </Fragment>
          ) : (
            <slot />
          )}
        </div>
        {!isPublic && (
          <div class="insights-article__provenance">
            <span>EDITORIAL PREVIEW</span>
            <p>Preview copy is imported from the approved Notion draft version. Not yet publicly published.</p>
            <a href={sourceUrl} target="_blank" rel="noopener noreferrer">Open editorial record <span aria-hidden="true">↗</span></a>
          </div>
        )}
                {isPublic && <InsightsRelatedReading links={related} />}
        {isPublic && commercialNext && <InsightsCommercialNext next={commercialNext} />}
      </article>
      <aside class="insights-read-next" aria-label="About KERSIVO Insights">
        <div class="insights-read-next__inner">
          <p class="insights-read-next__kicker">ABOUT THIS PUBLICATION</p>
          <h2>Independent thinking for independent barbers.</h2>
          <p>KERSIVO Insights explores the decisions behind running a barbershop in the UK, from reputation and client relationships to costs and bookings.</p>
          <div class="insights-read-next__links">
            <a href="/insights">Explore Insights <span aria-hidden="true">↗</span></a>
            <a href={EDITORIAL_STANDARDS_PATH}>How we check articles <span aria-hidden="true">↗</span></a>
            <a href="/about">About KERSIVO <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </aside>
    </div>
  </main>
  <InsightsDataTables />
  <Footer50 showIntro={false} />
</LandingLayout>
