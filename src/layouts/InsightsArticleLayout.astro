---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Footer50 from '@/components/footer50.astro';
import InsightsMasthead from '@/components/insights/InsightsMasthead.astro';
import InsightsDataTables from '@/components/insights/InsightsDataTables.astro';
import InsightsRelatedReading from '@/components/insights/InsightsRelatedReading.astro';
import InsightsCommercialNext from '@/components/insights/InsightsCommercialNext.astro';
import '@/styles/components/insights-preview.css';
import {
  buildInsightsArticleJsonLd,
  formatInsightsDateLabel,
  isInsightsArticlePublished,
} from '@/lib/seo/insights';
import { getInsightsCategory, type InsightsCategoryId } from '@/lib/insights/categories';
import {
  getInsightsCommercialNext,
  getInsightsRelatedLinks,
} from '@/lib/insights/insightsLinking';

interface Props {
  title: string;
  description: string;
  slug: string;
  categoryId: InsightsCategoryId;
  /** Display label — derived from taxonomy; kept for masthead convenience. */
  category?: string;
  dateLabel?: string;
  sourceUrl: string;
  coverImage?: string;
  coverImageAlt?: string;
  headline: string;
  publishedDate: string;
  verifiedDate: string;
  modifiedDate?: string;
  heroImage: string;
  ogImage?: string;
  ogImageAlt?: string;
  published?: boolean;
  suppressMarketingFontPreloads?: boolean;
}
const {
  title,
  description,
  slug,
  categoryId,
  category,
  dateLabel,
  sourceUrl,
  coverImage,
  coverImageAlt,
  headline,
  publishedDate,
  verifiedDate,
  modifiedDate,
  heroImage,
  ogImage,
  ogImageAlt,
  published = false,
  suppressMarketingFontPreloads = true,
} = Astro.props;
const path = `/insights/${slug}`;
const taxonomy = getInsightsCategory(categoryId);
const categoryLabel = category ?? taxonomy.name;
/** Indexable only when the page asks for publish AND the slug is in the owner-approved registry. */
const isPublic = published && isInsightsArticlePublished(slug);
const related = getInsightsRelatedLinks(slug);
const commercialNext = getInsightsCommercialNext(slug);
const resolvedDateLabel = dateLabel ?? formatInsightsDateLabel(publishedDate);
const socialImage = ogImage ?? coverImage;
const socialAlt = ogImageAlt ?? coverImageAlt ?? headline;
---

<LandingLayout
  title={title}
  description={description}
  canonicalPath={path}
  ogType="article"
  ogImagePath={socialImage?.startsWith('/') || socialImage?.startsWith('http') ? socialImage : undefined}
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageAlt={socialAlt}
  noindex={!isPublic}
  suppressMarketingFontPreloads={suppressMarketingFontPreloads}
  jsonLd={
    isPublic
      ? buildInsightsArticleJsonLd({
          path,
          headline,
          description,
          publishedDate,
          verifiedDate,
          modifiedDate,
          heroImage,
          ogImage,
          categoryId,
        })
      : undefined
  }
>
  <link
    slot="head"
    rel="preload"
    href="/fonts/newsreader-latin-700-normal.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <main class="insights-page">
    <InsightsMasthead
      page="article"
      category={categoryLabel}
      categoryHref={taxonomy.path}
      dateLabel={resolvedDateLabel}
      currentLabel={headline}
    />
    <div class="insights-paper">
      <article class="insights-article" aria-label={headline}>
        <div class="insights-article__body">
          <slot />
        </div>
        {!isPublic && (
          <div class="insights-article__provenance">
            <span>EDITORIAL PREVIEW</span>
            <p>Preview copy is imported from the approved Notion draft version. Not yet publicly published.</p>
            <a href={sourceUrl} target="_blank" rel="noopener noreferrer">Open editorial record <span aria-hidden="true">↗</span></a>
          </div>
        )}
        {isPublic && <InsightsRelatedReading links={related} />}
        {isPublic && commercialNext && <InsightsCommercialNext next={commercialNext} />}
      </article>
      <aside class="insights-read-next" aria-label="About KERSIVO Insights">
        <div class="insights-read-next__inner">
          <p class="insights-read-next__kicker">ABOUT THIS PUBLICATION</p>
          <h2>Independent thinking for independent barbers.</h2>
          <p>KERSIVO Insights explores the decisions behind running a barbershop in the UK, from reputation and client relationships to costs and bookings.</p>
          <div class="insights-read-next__links">
            <a href="/insights">Explore Insights <span aria-hidden="true">↗</span></a>
            <a href="/about">About KERSIVO <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </aside>
    </div>
  </main>
  <InsightsDataTables />
  <Footer50 showIntro={false} />
</LandingLayout>
