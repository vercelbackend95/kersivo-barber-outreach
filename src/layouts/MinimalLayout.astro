---
import GoogleAnalytics from '@/components/seo/GoogleAnalytics.astro';
import CookieConsentMount from '@/components/consent/CookieConsentMount.astro';
import FaviconLinks from '@/components/seo/FaviconLinks.astro';
import SeoHead from '@/components/seo/SeoHead.astro';
import type { PageSeo } from '@/lib/seo/meta';

interface Props extends PageSeo {
  title: string;
  bodyClass?: string;
  htmlClass?: string;
  noindex?: boolean;
  viewportContent?: string;
  /** When false, skip cookie banner/launcher (e.g. /book* sticky CTA). Default true. */
  showCookieConsent?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogImagePath,
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
  ogType,
  noindex = true,
  bodyClass,
  htmlClass,
  viewportContent = 'width=device-width, initial-scale=1',
  showCookieConsent = true,
} = Astro.props;
---

<html lang="en-GB" class={htmlClass}>
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <FaviconLinks />
    <meta name="viewport" content={viewportContent} />
    <title>{title}</title>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImagePath={ogImagePath}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    {showCookieConsent ? <CookieConsentMount /> : null}
  </body>
</html>
