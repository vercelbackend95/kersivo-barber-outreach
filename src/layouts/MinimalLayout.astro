---
import { ClientRouter } from 'astro:transitions';
import GoogleAnalytics from '@/components/seo/GoogleAnalytics.astro';
import CookieConsentMount from '@/components/consent/CookieConsentMount.astro';
import FaviconLinks from '@/components/seo/FaviconLinks.astro';
import SeoHead from '@/components/seo/SeoHead.astro';
import RouteTransitionRoot from '@/components/navigation/RouteTransitionRoot.astro';
import CartDrawerMount from '@/components/shop/CartDrawerMount.astro';
import type { PageSeo } from '@/lib/seo/meta';
import '@/styles/motion.css';
import '@/styles/components/route-transition.css';

interface Props extends PageSeo {
  title: string;
  bodyClass?: string;
  htmlClass?: string;
  noindex?: boolean;
  viewportContent?: string;
  /** When false, skip cookie banner/launcher (e.g. /book* sticky CTA). Default true. */
  showCookieConsent?: boolean;
  /** When false, omit Google Analytics. Default true. */
  enableAnalytics?: boolean;
  /** When false, omit Astro ClientRouter. Default true. */
  enableClientRouter?: boolean;
  /**
   * Opt-in production retail cart for real tenant booking pages.
   * Do not enable for demo, preview, or admin test-book flows.
   */
  enableProductionCart?: boolean;
  shopId?: string;
  shopName?: string;
}

const {
  title,
  description,
  canonicalPath,
  ogImagePath,
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
  ogType,
  noindex = true,
  robotsFollow,
  bodyClass,
  htmlClass,
  viewportContent = 'width=device-width, initial-scale=1',
  showCookieConsent = true,
  enableAnalytics = true,
  enableClientRouter = true,
  enableProductionCart = false,
  shopId,
  shopName,
} = Astro.props;

const path = Astro.url.pathname;
const isAdminSurface =
  path === '/admin' ||
  path === '/admin-demo' ||
  path.startsWith('/admin/') ||
  path === '/demo/admin' ||
  path.startsWith('/demo/admin/') ||
  path === '/ops' ||
  path.startsWith('/ops/');
const app = isAdminSurface ? 'admin' : 'flow';

const productionCartShopId = enableProductionCart ? shopId?.trim() || '' : '';
const productionCartEnabled = Boolean(productionCartShopId);
const cartNamespace = productionCartEnabled ? { shopId: productionCartShopId } : null;
const cartShopName = shopName?.trim() || 'Shop';
const cartExploreHref = productionCartEnabled ? `/shop/${productionCartShopId}` : '/shop';
---

<html lang="en-GB" class={htmlClass} data-app={app} transition:animate="none">
  <head>
    {enableAnalytics ? <GoogleAnalytics /> : null}
    <meta charset="utf-8" />
    <FaviconLinks />
    <meta name="viewport" content={viewportContent} />
    <title>{title}</title>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImagePath={ogImagePath}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
      noindex={noindex}
      robotsFollow={robotsFollow}
    />
    <style is:inline>
      html[data-app='admin'],
      html[data-app='admin'] body,
      html[data-app='flow'],
      html[data-app='flow'] body {
        background: #030303;
      }
    </style>
    {enableClientRouter ? <ClientRouter fallback="swap" /> : null}
    {
      cartNamespace ? (
        <script is:inline define:vars={{ cartNamespace }}>
          window.__KERSIVO_CART_NAMESPACE__ = cartNamespace;
        </script>
      ) : null
    }
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <RouteTransitionRoot variant="flow">
      <slot />
    </RouteTransitionRoot>
    {
      productionCartEnabled ? (
        <div transition:persist="ks-cart">
          <CartDrawerMount
            mode="production"
            shopId={productionCartShopId}
            shopName={cartShopName}
            themeId="kersivo"
            priceFormat="gbp"
            exploreHref={cartExploreHref}
            checkout={{ type: 'live' }}
          />
        </div>
      ) : null
    }
    {showCookieConsent ? (
      <div transition:persist="ks-cookie">
        <CookieConsentMount />
      </div>
    ) : null}
  </body>
</html>
