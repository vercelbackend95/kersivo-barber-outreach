---
/*
 * /barbershop-reports — KERSIVO Admin & Reports, the interactive explainer.
 * Kind: software. One effect (three.js Reports chart in the hero), two dealt moments
 * (the dashboard as a pinned scroll film, the scroll-lit statement), all fed by the
 * fictional Heritage Grooming demo data, card loops with a pause control.
 * Every word a search engine or assistant needs is in the server HTML; motion only decorates it.
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import Footer50 from '@/components/footer50.astro';
import { buildKersivoEntityJsonLd } from '@/lib/seo/kersivoEntityJsonLd';
import { buildAdminReportsJsonLd } from '@/lib/seo/adminReportsJsonLd';
import { KERSIVO_CONTACT_EMAIL, getFooterSocialLinks } from '@/lib/seo/footerSocialLinks';
import { FREE_PREVIEW_CTA_HREF } from '@/lib/freePreview/fullPlanCta';
import { buildKarStudioData, KAR_STUDIO_RANGES, type KarRangeKey } from '@/lib/landing/kar/reportsDemo';
import { karKpis, karMetricTotal, normalise } from '@/lib/landing/kar/studioFormat';
import { buildSmoothPath } from '@/lib/admin/chartUtils';
import {
  KAR_ANSWER,
  KAR_ANSWER_TITLE,
  KAR_CHAPTERS,
  KAR_CHAPTERS_LEAD,
  KAR_CHAPTERS_TITLE,
  KAR_CLOSE_LEAD,
  KAR_CLOSE_NOTE,
  KAR_CLOSE_STARTER,
  KAR_CLOSE_TITLE,
  KAR_DEMO_REPORTS_HREF,
  KAR_DESCRIPTION,
  KAR_DIFFERENCES,
  KAR_DIFFERENCES_TITLE,
  KAR_FACTS,
  KAR_FAQ_TITLE,
  KAR_FAQS,
  KAR_FILM_NOTE,
  KAR_HERO,
  KAR_METRICS,
  KAR_METRICS_LEAD,
  KAR_METRICS_TITLE,
  KAR_PAGE_PATH,
  KAR_PLAN_ROWS,
  KAR_PLANS_LEAD,
  KAR_PLANS_TITLE,
  KAR_STATEMENT,
  KAR_TITLE,
} from '@/lib/seo/adminReportsExperience';
import '@/styles/components/ks-glass-card.css';
import '@/styles/components/admin-reports.css';

const currentYear = new Date().getFullYear();
const studio = buildKarStudioData();
const statementWords = KAR_STATEMENT.split(' ');
// The film: the real owner dashboard of the Heritage Grooming demo, framed for embedding.
const FILM_SRC = '/demo/heritage-grooming/admin?embed=hero&section=bookings_dashboard';
const FILM_POSTER = '/landing/barbershop-reports/film-poster.webp';
// Hero: one Reports chart (booking value) and the widgets beside it, cycling through the ranges.
// Long ranges are averaged down to at most 12 points so the line reads as a shape, not noise.
const averageTo = (values: readonly number[], n: number) => {
  if (values.length <= n) return [...values];
  return Array.from({ length: n }, (_, i) => {
    const from = Math.floor((i * values.length) / n);
    const to = Math.max(from + 1, Math.floor(((i + 1) * values.length) / n));
    const chunk = values.slice(from, to);
    return chunk.reduce((a, b) => a + b, 0) / chunk.length;
  });
};
const HERO_START: KarRangeKey = '7d';
const heroRanges = KAR_STUDIO_RANGES.map(({ key }) => {
  const r = studio[key];
  const k = karKpis(r);
  const top = Math.max(1, ...r.leaderboard.map((row) => row.count));
  return {
    key,
    short: r.short,
    total: karMetricTotal(r, 'value'),
    bookings: k.bookings.value,
    bookingsDelta: k.bookings.delta,
    bookingsTone: k.bookings.tone,
    util: r.utilisationPct ?? 0,
    utilLabel: k.utilisation.value,
    utilDelta: k.utilisation.delta,
    utilTone: k.utilisation.tone,
    cancelled: k.cancelled.value,
    cancelledDelta: k.cancelled.delta,
    cancelledTone: k.cancelled.tone,
    peak: r.peak ?? '—',
    service: r.popularService ?? '—',
    leaders: r.leaderboard.slice(0, 3).map((row) => ({ name: row.name, count: row.count, share: Math.round((row.count / top) * 1000) / 10 })),
    series: normalise(averageTo(r.series.value, 12)).map((v) => Math.round(v * 1000) / 1000),
  };
});
const hero = heroRanges.find((r) => r.key === HERO_START)!;
const UTIL_R = 26;
// "Fair to every chair": three barbers over the shop total, Tuesday to Saturday (illustrative).
const CHAIR_DAYS = ['Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const CHAIR_LINES = [
  { name: 'Kit', values: [0.28, 0.44, 0.52, 0.68, 0.96] },
  { name: 'Arthur', values: [0.46, 0.36, 0.5, 0.46, 0.66] },
  { name: 'Rafi', values: [0.1, 0.2, 0.16, 0.28, 0.38] },
];
const chairPoint = (v: number, i: number) => ({ x: 12 + (i / (CHAIR_DAYS.length - 1)) * 216, y: 92 - v * 80 });
const chairPaths = CHAIR_LINES.map((line) => ({
  ...line,
  d: buildSmoothPath(line.values.map(chairPoint)),
  end: chairPoint(line.values[line.values.length - 1], line.values.length - 1),
}));
const chairTotal = buildSmoothPath(
  CHAIR_DAYS.map((_, i) => chairPoint(Math.min(0.98, CHAIR_LINES.reduce((sum, l) => sum + l.values[i], 0) / 2.4), i)),
);
---

<LandingLayout
  title={KAR_TITLE}
  description={KAR_DESCRIPTION}
  canonicalPath={KAR_PAGE_PATH}
  jsonLd={[buildKersivoEntityJsonLd(), buildAdminReportsJsonLd()]}
>
  <main class="kar landing-overflow-guard" data-kar>
    <script is:inline>
      // Hide the hero lines before first paint only when they will animate; a failsafe shows them.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('kar-js');
        window.setTimeout(function () {
          var hero = document.querySelector('[data-kar-hero]');
          if (hero) hero.classList.add('is-in');
        }, 2500);
      }
    </script>

    <!-- 1 · Hero: one Reports chart in three.js, with the rest of Reports in widgets around it -->
    <section class="kar-hero" aria-labelledby="kar-hero-title" data-kar-hero>
      <div class="kar-hero__visual" aria-hidden="true" data-kar-visual>
        <canvas class="kar-hero__canvas" data-kar-canvas></canvas>
      </div>
      <div class="kar-hero__board" aria-hidden="true" data-kar-board>
        <script type="application/json" data-kar-hero-data set:html={JSON.stringify(heroRanges)} />
        <div class="kar-w kar-w--value" data-kar-w>
          <p class="kar-w__eyebrow"><i></i>Booking value <span>· demo shop</span></p>
          <p class="kar-w__big" data-kar-hv="total">{hero.total}</p>
          <p class="kar-w__sub">
            <b data-kar-hv="bookings">{hero.bookings}</b> bookings
            <span class={`kar-w__delta is-${hero.bookingsTone}`} data-kar-hv="bookingsDelta">{hero.bookingsDelta}</span>
          </p>
          <span class="kar-w__seg">
            {heroRanges.map((r) => (
              <span class:list={['kar-w__seg-btn', { 'is-on': r.key === HERO_START }]} data-kar-hrange={r.key}>{r.short}</span>
            ))}
            <span class="kar-w__seg-thumb" data-kar-hthumb></span>
          </span>
        </div>

        <div class="kar-w kar-w--util" data-kar-w>
          <span class="kar-w__ring" style={`--p:${hero.util / 100}`} data-kar-hring>
            <svg viewBox="0 0 64 64">
              <circle cx="32" cy="32" r={UTIL_R} pathLength="100"></circle>
              <circle class="kar-w__ring-fill" cx="32" cy="32" r={UTIL_R} pathLength="100"></circle>
            </svg>
          </span>
          <span class="kar-w__util">
            <span class="kar-w__eyebrow">Utilisation</span>
            <b class="kar-w__mid" data-kar-hv="utilLabel">{hero.utilLabel}</b>
            <span class={`kar-w__delta is-${hero.utilTone}`} data-kar-hv="utilDelta">{hero.utilDelta}</span>
          </span>
        </div>

        <div class="kar-w kar-w--leaders" data-kar-w>
          <p class="kar-w__eyebrow">Barber leaderboard</p>
          <ol class="kar-w__leaders" data-kar-hleaders>
            {hero.leaders.map((row, i) => (
              <li>
                <span class="kar-w__rank">{i + 1}</span>
                <span class="kar-w__name">{row.name}</span>
                <span class="kar-w__bar"><span style={`--w:${row.share}%`}></span></span>
                <b>{row.count}</b>
              </li>
            ))}
          </ol>
        </div>

        <div class="kar-w kar-w--stats" data-kar-w>
          <dl class="kar-w__stats">
            <div><dt>Peak day and hour</dt><dd data-kar-hv="peak">{hero.peak}</dd></div>
            <div><dt>Most popular service</dt><dd data-kar-hv="service">{hero.service}</dd></div>
            <div>
              <dt>Cancelled rate</dt>
              <dd><span data-kar-hv="cancelled">{hero.cancelled}</span> <small class={`is-${hero.cancelledTone}`} data-kar-hv="cancelledDelta">{hero.cancelledDelta}</small></dd>
            </div>
          </dl>
        </div>
      </div>
      <div class="kar-wrap kar-hero__inner">
        <p class="ks-eyebrow" data-kar-enter>{KAR_HERO.eyebrow}</p>
        <h1 id="kar-hero-title" class="kar-hero__title">
          {KAR_HERO.titleLines.map((line, i) => (
            <span class="kar-hero__line">
              <span class:list={['kar-hero__line-inner', { 'kar-red': i === 1 }]} data-kar-rise>{line}</span>
            </span>
          ))}
        </h1>
        <p class="kar-hero__lead" data-kar-enter>{KAR_HERO.lead}</p>
        <ul class="kar-hero__facts" data-kar-enter>
          {KAR_HERO.facts.map((fact) => <li>{fact}</li>)}
        </ul>
        <div class="kar-actions" data-kar-enter>
          <a class="btn btn--primary kar-btn" href={FREE_PREVIEW_CTA_HREF} data-track="build_preview_click">
            {KAR_HERO.primary}
            <span class="kar-btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--outline kar-btn" href={KAR_DEMO_REPORTS_HREF} data-track="view_live_demo_click">{KAR_HERO.secondary}</a>
        </div>
      </div>
      <a class="kar-hero__cue" href="#in-short" aria-label="Scroll to what Admin & Reports is" data-kar-enter>
        <span class="kar-hero__cue-line" aria-hidden="true"></span>
      </a>
    </section>

    <!-- 2 · In short: the direct answer -->
    <section class="kar-answer" id="in-short" aria-labelledby="kar-answer-title">
      <div class="kar-wrap kar-answer__grid">
        <div>
          <p class="ks-eyebrow">In short</p>
          <h2 id="kar-answer-title" class="kar-h2">{KAR_ANSWER_TITLE}</h2>
        </div>
        <div class="kar-answer__body">
          <p class="kar-answer__text">{KAR_ANSWER}</p>
          <dl class="kar-answer__facts">
            {KAR_FACTS.map((fact) => (
              <div class="kar-answer__fact">
                <dt>{fact.term}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- 3 · Moment 1: the dashboard as a film. The section pins and the scroll walks the sidebar. -->
    <section class="kar-film" id="day" aria-labelledby="kar-day-title" data-kar-film>
      <div class="kar-wrap kar-film__intro">
        <p class="ks-eyebrow">The dashboard</p>
        <h2 id="kar-day-title" class="kar-h2">{KAR_CHAPTERS_TITLE}</h2>
        <p class="kar-lead">{KAR_CHAPTERS_LEAD}</p>
      </div>

      <div class="kar-film__pin" data-kar-film-pin>
        <div class="kar-film__frame">
          <ol class="kar-film__captions" data-kar-captions>
            {KAR_CHAPTERS.map((chapter, i) => (
              <li class:list={['kar-film__caption', { 'is-active': i === 0 }]} id={`kar-chapter-${chapter.id}`} data-kar-caption={i}>
                <p class="kar-film__meta">
                  <span class="kar-film__count">{chapter.index}<span aria-hidden="true"> / {String(KAR_CHAPTERS.length).padStart(2, '0')}</span></span>
                  <span class="kar-film__section">{chapter.section}</span>
                </p>
                <h3 class="kar-film__title">{chapter.title}</h3>
                <p class="kar-film__body">{chapter.body}</p>
                <ul class="kar-film__notes" aria-label={`What to look at on ${chapter.section}`}>
                  {chapter.callouts.map((note) => <li class="kar-callout"><i aria-hidden="true"></i>{note}</li>)}
                </ul>
              </li>
            ))}
          </ol>

          <div class="kar-film__stage" aria-hidden="true" data-kar-stage data-chapter="0">
            <span class="kar-film__scan" data-kar-scan="top"></span>
            <span class="kar-film__scan" data-kar-scan="bottom"></span>
            <div class="kar-app kar-app--film" data-kar-film-app>
              <div class="kar-live" data-kar-live data-frame-state="poster">
                <div class="kar-live__canvas" data-kar-live-canvas>
                  <iframe class="kar-live__frame" data-deferred-src={FILM_SRC} title="KERSIVO owner dashboard, Heritage Grooming demo" tabindex="-1" width="1180" height="720"></iframe>
                  <div class="kar-live__fx" data-kar-fx>
                    <span class="kar-live__ring" data-kar-ring></span>
                    <span class="kar-live__tag" data-kar-tag><i></i><span data-kar-tag-text></span></span>
                    <span class="kar-live__cursor" data-kar-cursor>
                      <svg viewBox="0 0 24 24" width="24" height="24"><path d="M4.5 2.8v16.6l4.3-4.1 2.9 6.4 3-1.4-2.9-6.3h6z"></path></svg>
                    </span>
                  </div>
                </div>
                <img class="kar-live__poster" src={FILM_POSTER} alt="" width="1180" height="720" loading="lazy" decoding="async" />
                <span class="kar-live__loading"><i></i>Opening the demo dashboard</span>
              </div>
            </div>
          </div>

          <div class="kar-film__reel" role="group" aria-label="Dashboard screens">
            {KAR_CHAPTERS.map((chapter, i) => (
              <button
                type="button"
                class="kar-reel__btn"
                data-kar-reel={i}
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-controls={`kar-chapter-${chapter.id}`}
                style={`--kar-weight:${chapter.id === 'reports' ? 2 : 1}`}
              >
                <span class="kar-reel__label"><span>{chapter.index}</span>{chapter.section}</span>
                <span class="kar-reel__bar" aria-hidden="true"><span data-kar-reel-fill></span></span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="kar-wrap kar-film__foot">
        <p class="kar-note">{KAR_FILM_NOTE}</p>
        <a class="kar-link" href={KAR_DEMO_REPORTS_HREF} data-track="view_live_demo_click">Open Reports in the demo dashboard <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- 5 · Moment 2: the statement lights up -->
    <section class="kar-statement" aria-label="How the dashboard connects" data-kar-statement>
      <div class="kar-wrap">
        <p class="kar-statement__text">
          {statementWords.map((word) => (
            <span class:list={['kar-word', { 'kar-word--key': word === 'once,' }]} data-kar-word>{word} </span>
          ))}
        </p>
      </div>
    </section>

    <!-- 6 · What is different: cards with short loops -->
    <section class="kar-diff" aria-labelledby="kar-diff-title" data-kar-features>
      <div class="kar-wrap">
        <div class="kar-diff__head">
          <div>
            <p class="ks-eyebrow">What’s different</p>
            <h2 id="kar-diff-title" class="kar-h2">{KAR_DIFFERENCES_TITLE}</h2>
          </div>
          <button type="button" class="kar-pause" aria-pressed="false" data-kar-pause>
            <span class="kar-pause__icon" aria-hidden="true"></span>
            <span data-kar-pause-label>Pause animations</span>
          </button>
        </div>
        <ul class="kar-diff__grid">
          {KAR_DIFFERENCES.map((item) => (
            <li class="kar-card ks-glass-card" data-kar-card={item.id}>
              <div class="kar-card__visual" aria-hidden="true">
                {item.id === 'compare' && (
                  <div class="kar-vis-compare">
                    <span class="kar-vis-compare__prev">66.1%<small>Last week</small></span>
                    <span class="kar-vis-compare__now"><b data-kar-count>72.3%</b><small>This week</small></span>
                    <span class="kar-vis-compare__chip">+6.2 pts</span>
                  </div>
                )}
                {item.id === 'sample' && (
                  <div class="kar-vis-sample">
                    <span class="kar-vis-sample__dots">{Array.from({ length: 10 }, () => <i></i>)}</span>
                    <span class="kar-flag kar-vis-sample__flag">Small sample</span>
                  </div>
                )}
                {item.id === 'utilisation' && (
                  <div class="kar-vis-util">
                    <svg viewBox="0 0 80 80"><circle cx="40" cy="40" r="32" pathLength="100"></circle><circle class="kar-vis-util__fill" cx="40" cy="40" r="32" pathLength="100"></circle></svg>
                    <span class="kar-vis-util__text"><b>72%</b><small>booked of available</small></span>
                  </div>
                )}
                {item.id === 'barbers' && (
                  <div class="kar-vis-chairs">
                    <svg class="kar-vis-chairs__svg" viewBox="0 0 240 104">
                      <defs>
                        <clipPath id="kar-chairs-sweep"><rect class="kar-vis-chairs__sweep" x="12" y="0" width="216" height="104"></rect></clipPath>
                      </defs>
                      <path class="kar-vis-chairs__total" d={`${chairTotal} L228,96 L12,96 Z`} clip-path="url(#kar-chairs-sweep)"></path>
                      <line class="kar-vis-chairs__base" x1="12" x2="228" y1="96" y2="96"></line>
                      {chairPaths.map((line, i) => (
                        <path class={`kar-vis-chairs__line kar-vis-chairs__line--${i}`} d={line.d} pathLength="1"></path>
                      ))}
                      {chairPaths.map((line, i) => (
                        <circle class={`kar-vis-chairs__dot kar-vis-chairs__dot--${i}`} cx={line.end.x} cy={line.end.y} r="3.6"></circle>
                      ))}
                    </svg>
                    <ul class="kar-vis-chairs__legend">
                      {chairPaths.map((line, i) => (
                        <li class={`kar-vis-chairs__chip kar-vis-chairs__chip--${i}`}><i></i>{line.name}{i === 0 && <b class="kar-vis-chairs__lead">Sat</b>}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
              <p class="kar-card__kicker">{item.kicker}</p>
              <h3 class="kar-card__title">{item.title}</h3>
              <p class="kar-card__body">{item.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7 · Metric glossary -->
    <section class="kar-metrics" id="metrics" aria-labelledby="kar-metrics-title">
      <div class="kar-wrap">
        <div class="kar-metrics__head">
          <div>
            <p class="ks-eyebrow">The numbers</p>
            <h2 id="kar-metrics-title" class="kar-h2">{KAR_METRICS_TITLE}</h2>
          </div>
          <p class="kar-lead">{KAR_METRICS_LEAD}</p>
        </div>
        <ol class="kar-metrics__grid">
          {KAR_METRICS.map((metric, i) => (
            <li class="kar-metric" id={`metric-${metric.id}`}>
              <span class="kar-metric__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="kar-metric__name">{metric.name}</h3>
              <p class="kar-metric__def"><span class="kar-metric__tag">Measures</span>{metric.definition}</p>
              <p class="kar-metric__act"><span class="kar-metric__tag kar-metric__tag--red">If it slips</span>{metric.action}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 8 · Starter vs Full -->
    <section class="kar-plans" aria-labelledby="kar-plans-title">
      <div class="kar-wrap">
        <p class="ks-eyebrow">Plans</p>
        <h2 id="kar-plans-title" class="kar-h2">{KAR_PLANS_TITLE}</h2>
        <p class="kar-lead">{KAR_PLANS_LEAD}</p>
        <table class="kar-table">
          <caption class="sr-only">Owner tools in KERSIVO Starter and Full KERSIVO</caption>
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col">KERSIVO Starter</th>
              <th scope="col" class="kar-table__full">Full KERSIVO</th>
            </tr>
          </thead>
          <tbody>
            {KAR_PLAN_ROWS.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td data-plan="Starter" class:list={{ 'is-none': row.starter === 'Not included' }}>{row.starter}</td>
                <td data-plan="Full" class="kar-table__full">{row.full}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="kar-plans__more">
          <a class="kar-link" href="/pricing#plan" data-track="plan_my_setup_click">See Full KERSIVO pricing <span aria-hidden="true">→</span></a>
          <a class="kar-link kar-link--quiet" href="/starter" data-track="starter_plan_explore_click">How Starter works</a>
        </p>
      </div>
    </section>

    <!-- 9 · FAQ -->
    <section class="kar-faq" id="faq" aria-labelledby="kar-faq-title">
      <div class="kar-wrap kar-faq__grid">
        <div>
          <p class="ks-eyebrow">FAQ</p>
          <h2 id="kar-faq-title" class="kar-h2">{KAR_FAQ_TITLE}</h2>
        </div>
        <div class="kar-faq__list">
          {KAR_FAQS.map((faq, i) => (
            <details class="kar-faq__item" open={i === 0}>
              <summary class="kar-faq__q"><h3>{faq.question}</h3><span class="kar-faq__icon" aria-hidden="true"></span></summary>
              <p class="kar-faq__a">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 10 · Close -->
    <section class="kar-close" aria-labelledby="kar-close-title">
      <div class="kar-wrap kar-close__inner">
        <h2 id="kar-close-title" class="kar-close__title">{KAR_CLOSE_TITLE}</h2>
        <p class="kar-lead kar-close__lead">{KAR_CLOSE_LEAD}</p>
        <div class="kar-actions kar-close__actions">
          <a class="btn btn--primary kar-btn" href={FREE_PREVIEW_CTA_HREF} data-track="build_preview_click">
            {KAR_HERO.primary}
            <span class="kar-btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="kar-link" href="/starter" data-track="starter_plan_explore_click">{KAR_CLOSE_STARTER}</a>
        </div>
        <p class="kar-note kar-close__legal">{KAR_CLOSE_NOTE}</p>
      </div>
    </section>

    <Footer50
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      social={getFooterSocialLinks()}
    />
  </main>
</LandingLayout>

<script>
  import { initAdminReports } from '@/lib/landing/kar/experience';

  const boot = () => {
    const root = document.querySelector<HTMLElement>('main[data-kar]');
    if (!root || root.dataset.karBound === 'true') return;
    root.dataset.karBound = 'true';
    const cleanup = initAdminReports(root);
