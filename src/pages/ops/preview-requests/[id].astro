---
export const prerender = false;

import MinimalLayout from '@/layouts/MinimalLayout.astro';
import PrivateDemoAuthPanel from '@/components/admin/PrivateDemoAuthPanel';
import PreviewRequestActions from '@/components/ops/previewRequests/PreviewRequestActions';
import {
  OpsAccessDenied,
  OpsAccessUnconfigured,
} from '@/components/ops/recommendations/OpsPageGates';
import { OPS_PREVIEW_REQUESTS_PATH, isAdminHubEnabled, isFreePreviewFlowEnabled, isPreviewHubEnabled } from '@/lib/freePreview/config';
import { parseBrandPalette } from '@/lib/adminHub/brandColours';
import { OpsBrandColours } from '@/components/ops/previewRequests/OpsBrandColours';
import { ownerFacingStageLabel, resolveHubState } from '@/lib/freePreview/hubStage';
import { previewPageUrl } from '@/lib/freePreview/emails';
import { currentBookingSystemLabel } from '@/lib/forms/currentBookingSystems';
import {
  FREE_PREVIEW_BARBER_COUNTS,
  FREE_PREVIEW_DOMAIN_OPTIONS,
  labelFor,
} from '@/lib/freePreview/intake';
import {
  PREVIEW_STATUS_LABELS,
  getPreviewRequestDetail,
  isOverDailyCap,
  markPreviewRequestOpsSeen,
  previewRequestLinks,
} from '@/lib/freePreview/opsQueries';
import { formatBytes } from '@/lib/freePreview/hubAssets';
import { HubMessages } from '@/components/previewHub/HubMessages';
import { OpsHubContent } from '@/components/ops/previewRequests/OpsHubContent';
import { OpsHubChanges } from '@/components/ops/previewRequests/OpsHubChanges';
import { loadHubMessages, markOwnerMessagesReadByOps } from '@/lib/freePreview/hubMessages';
import { loadHubChanges } from '@/lib/freePreview/hubChanges';
import { loadHubReviewShopData, loadLatestHubReviews, reviewDiff } from '@/lib/freePreview/hubReviews';
import { PREVIEW_REQUEST_ACTIONS } from '@/lib/freePreview/createPreviewRequest';
import { prisma } from '@/lib/db/client';
import {
  HUB_OPS_ABOUT,
  HUB_OPS_BRAND_COLOURS,
  HUB_OPS_DOWNLOAD,
  HUB_OPS_FILES_EMPTY,
  HUB_OPS_FILES_TITLE,
  HUB_OPS_STYLE_NOTES,
  HUB_OPS_TAB_CHANGES,
  HUB_OPS_TAB_CONTENT,
  HUB_OPS_TAB_FILES,
  HUB_OPS_TAB_MESSAGES,
  HUB_OPS_TAB_OVERVIEW,
  HUB_OPS_UNREAD_MESSAGES,
  HUB_OPS_UPLOADED_BY_KERSIVO,
  HUB_OPS_UPLOADED_BY_OWNER,
} from '@/lib/freePreview/hubCopy';
import { unreadOwnerMessageCount } from '@/lib/freePreview/opsQueries';
import { resolveOperatorAccess } from '@/lib/ops/operatorAuth';
import { resolveOpsPageView } from '@/lib/ops/opsPageView';
import '@/styles/tokens.css';
import '@/styles/fonts-admin.css';
import '@/styles/global.css';
import '@/styles/components/inputs.css';
import '@/styles/components/buttons.css';
import '@/styles/components/admin-login.css';
import '@/styles/components/ops-recommendations.css';
import '@/styles/components/ops-preview-requests.css';
import '@/styles/components/preview-hub.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Vary', 'Cookie');

const auth = await resolveOperatorAccess(Astro.request);
const view = resolveOpsPageView(auth);

const id = (Astro.params.id ?? '').trim();
const request = view === 'dashboard' && id && id.length <= 64 ? await getPreviewRequestDetail(id) : null;
if (view === 'dashboard' && request) {
  await markPreviewRequestOpsSeen(request.id).catch((error) => {
    console.error('[ops/preview-requests] opsLastSeenAt failed', error instanceof Error ? error.message : error);
  });
}
if (view === 'dashboard' && !request) {
  return new Response('Preview request not found', {
    status: 404,
    headers: { 'Cache-Control': 'private, no-store' },
  });
}

function formatDate(value: Date | null | undefined): string {
  if (!value) return '—';
  return value.toLocaleString('en-GB', { timeZone: 'Europe/London', dateStyle: 'medium', timeStyle: 'short' });
}

const hubEnabled = isPreviewHubEnabled();
const adminHubEnabled = isAdminHubEnabled();
const hubState = request
  ? resolveHubState({
      request,
      isOperator: true,
      now: new Date(),
      liveMarker: request.liveAt,
    })
  : { kind: 'not_found' as const };
const hubStageLabel = hubEnabled ? ownerFacingStageLabel(hubState) : null;
const tabParam = (Astro.url.searchParams.get('tab') ?? '').trim().toLowerCase();
const activeTab =
  tabParam === 'files' || tabParam === 'messages' || tabParam === 'content' || tabParam === 'changes'
    ? tabParam
    : 'overview';
const unreadOpsMessages = request ? unreadOwnerMessageCount(request) : 0;
const hubMessages =
  view === 'dashboard' && request && hubEnabled && activeTab === 'messages'
    ? await loadHubMessages(request.id)
    : [];
const opsReviews = view === 'dashboard' && request && hubEnabled && activeTab === 'content'
  ? await loadLatestHubReviews(request.id)
  : null;
const opsReviewShop =
  view === 'dashboard' && request && hubEnabled && activeTab === 'content' && request.draftShopId
    ? await loadHubReviewShopData(request.draftShopId, request.id)
    : null;
const opsReviewDiffs = opsReviews && opsReviewShop
  ? {
      SERVICES: opsReviews.SERVICES
        ? reviewDiff({ section: 'SERVICES', current: opsReviewShop, proposal: opsReviews.SERVICES.proposal })
        : [],
      TEAM: opsReviews.TEAM ? reviewDiff({ section: 'TEAM', current: opsReviewShop, proposal: opsReviews.TEAM.proposal }) : [],
      HOURS: opsReviews.HOURS ? reviewDiff({ section: 'HOURS', current: opsReviewShop, proposal: opsReviews.HOURS.proposal }) : [],
    }
  : { SERVICES: [], TEAM: [], HOURS: [] };
const opsChanges =
  view === 'dashboard' && request && hubEnabled && activeTab === 'changes'
    ? await loadHubChanges(request.id)
    : [];
if (view === 'dashboard' && request && hubEnabled && activeTab === 'messages') {
  const marked = await markOwnerMessagesReadByOps({ previewRequestId: request.id }).catch(() => 0);
  if (marked > 0) {
    await prisma.previewRequestEvent
      .create({
        data: {
          previewRequestId: request.id,
          action: PREVIEW_REQUEST_ACTIONS.OPS_HUB_MESSAGES_READ,
          actorEmail: auth.ok ? auth.access.email : null,
          meta: { marked },
        },
      })
      .catch((error) => {
        console.error('[ops/preview-requests] mark messages read failed', error instanceof Error ? error.message : error);
      });
  }
}

const fields: Array<[string, string]> = request
  ? [
      ['Status', PREVIEW_STATUS_LABELS[request.status]],
      ...(hubStageLabel ? ([['Owner-facing stage', hubStageLabel]] as Array<[string, string]>) : []),
      ...(isOverDailyCap(request)
        ? ([['Daily cap', 'Over the cap: owner told it may take up to 3 working days']] as Array<[string, string]>)
        : []),
      ['First name', request.firstName ?? '—'],
      ['Email', request.email],
      ['Shop', request.shopName],
      ['Town / city', request.townCity],
      ['Barbers', labelFor(FREE_PREVIEW_BARBER_COUNTS, request.barberCount)],
      ['Booking system', currentBookingSystemLabel(request.currentBookingSystem)],
      ['Own domain', labelFor(FREE_PREVIEW_DOMAIN_OPTIONS, request.hasOwnDomain)],
      ['Notes', request.notes ?? '—'],
      ['Authorisation consent', formatDate(request.authorisationConsentAt)],
      ['Authorisation statement', request.authorisationStatementVersion ?? 'Checkbox (earlier form)'],
      ['Marketing opt-in', request.marketingOptInAt ? formatDate(request.marketingOptInAt) : 'No'],
      ['Entry point', request.entryPoint ?? '—'],
      ['Requested', formatDate(request.createdAt)],
      ['Preview ready', formatDate(request.previewReadyAt)],
      ['Expires', formatDate(request.expiresAt)],
      ['First viewed', formatDate(request.firstViewedAt)],
      ['Last viewed', formatDate(request.lastViewedAt)],
      ['Views', String(request.viewCount)],
      ['Changes requested', request.changesRequestedText ? `${formatDate(request.changesRequestedAt)} — ${request.changesRequestedText}` : '—'],
      ['Converted', formatDate(request.convertedAt)],
      ['Declined', formatDate(request.declinedAt)],
      ['Rejected', formatDate(request.rejectedAt)],
      ['Follow-up sent (E5)', formatDate(request.followupSentAt)],
      ['Expiry reminder sent (E6)', formatDate(request.expiryReminderSentAt)],
      ['Email opt-out', request.emailOptOut ? formatDate(request.emailOptOutAt) : 'No'],
      ['Personal data deleted', formatDate(request.anonymisedAt)],
      ['Draft shop', request.draftShop ? `${request.draftShop.name} (${request.draftShop.id})` : '—'],
      ['Site preview URL', request.draftShop?.sitePreviewUrl ?? '—'],
      ['Site version', request.draftShop?.sitePreviewVersion ?? '—'],
    ]
  : [];
---

<MinimalLayout
  title="Preview request | KERSIVO Ops"
  description="Internal free website preview request."
  canonicalPath={OPS_PREVIEW_REQUESTS_PATH}
  htmlClass="admin-app-scroll"
  bodyClass="admin-theme-premium-black ops-app"
  noindex={true}
  robotsFollow={false}
  showCookieConsent={false}
  enableAnalytics={false}
  enableClientRouter={false}
  viewportContent="width=device-width, initial-scale=1, viewport-fit=cover"
>
  <main class="container page-wrap">
    {
      view === 'sign_in' ? (
        <div class="ops-gate">
          <p class="ops-gate__brand">KERSIVO Ops</p>
          <h1 class="ops-gate__title">Preview request</h1>
          <p class="ops-gate__body">Sign in with an authorized operator account to continue.</p>
          <PrivateDemoAuthPanel
            client:load
            initialMode="login"
            callbackURL={Astro.url.pathname}
            title="Operator sign in"
            subtitle="Platform operators only. This is not shop admin access."
            showGoogle={false}
            allowSignup={false}
            passwordResetRedirectTo="/ops/reset-password"
          />
        </div>
      ) : null
    }
    {view === 'denied' ? <OpsAccessDenied /> : null}
    {view === 'unconfigured' ? <OpsAccessUnconfigured /> : null}
    {
      view === 'dashboard' && request ? (
        <div class="ops-cr ops-pr">
          <header class="ops-cr__header">
            <div class="ops-cr__brand">
              <p class="ops-cr__brand-kicker">
                <a href={OPS_PREVIEW_REQUESTS_PATH}>← Free preview requests</a>
              </p>
              <h1 class="ops-cr__title">{request.shopName}</h1>
              <p class="ops-cr__subtitle">
                {request.townCity} · {PREVIEW_STATUS_LABELS[request.status]}
              </p>
            </div>
          </header>

          <div class="ops-pr-detail">
            {
              hubEnabled ? (
                <nav class="ops-pr-tabs" aria-label="Request workspace">
                  <a
                    href={`${OPS_PREVIEW_REQUESTS_PATH}/${request.id}`}
                    aria-current={activeTab === 'overview' ? 'page' : undefined}
                  >
                    {HUB_OPS_TAB_OVERVIEW}
                  </a>
                  <a
                    href={`${OPS_PREVIEW_REQUESTS_PATH}/${request.id}?tab=files`}
                    aria-current={activeTab === 'files' ? 'page' : undefined}
                  >
                    {HUB_OPS_TAB_FILES}
                  </a>
                  <a
                    href={`${OPS_PREVIEW_REQUESTS_PATH}/${request.id}?tab=content`}
                    aria-current={activeTab === 'content' ? 'page' : undefined}
                  >
                    {HUB_OPS_TAB_CONTENT}
                  </a>
                  <a
                    href={`${OPS_PREVIEW_REQUESTS_PATH}/${request.id}?tab=changes`}
                    aria-current={activeTab === 'changes' ? 'page' : undefined}
                  >
                    {HUB_OPS_TAB_CHANGES}
                  </a>
                  <a
                    href={`${OPS_PREVIEW_REQUESTS_PATH}/${request.id}?tab=messages`}
                    aria-current={activeTab === 'messages' ? 'page' : undefined}
                  >
                    {HUB_OPS_TAB_MESSAGES}
                    {unreadOpsMessages > 0 ? ` · ${HUB_OPS_UNREAD_MESSAGES(unreadOpsMessages)}` : ''}
                  </a>
                </nav>
              ) : null
            }
            {
              hubEnabled && activeTab === 'content' && opsReviews ? (
                <section class="ops-pr-detail__fields" aria-label={HUB_OPS_TAB_CONTENT}>
                  <OpsHubContent
                    client:load
                    requestId={request.id}
                    reviews={opsReviews}
                    diffs={opsReviewDiffs}
                    shop={opsReviewShop}
                    hasSeparateWebsite={Boolean(request.draftShop?.sitePreviewUrl)}
                  />
                </section>
              ) : null
            }
            {
              hubEnabled && activeTab === 'changes' ? (
                <section class="ops-pr-detail__fields" aria-label={HUB_OPS_TAB_CHANGES}>
                  <OpsHubChanges
                    client:load
                    requestId={request.id}
                    initialItems={opsChanges}
                    includedChangeRounds={request.includedChangeRounds}
                    changeRoundsUsed={request.changeRoundsUsed}
                  />
                </section>
              ) : null
            }
            {
              hubEnabled && activeTab === 'messages' ? (
                <section class="ops-pr-detail__fields" aria-label={HUB_OPS_TAB_MESSAGES}>
                  <HubMessages
                    client:load
                    token={request.publicToken}
                    viewer="ops"
                    requestId={request.id}
                    shopName={request.shopName}
                    initialMessages={hubMessages}
                    canAttach
                  />
                </section>
              ) : null
            }
            <section class="ops-pr-detail__fields" aria-label="Request details" hidden={hubEnabled && (activeTab === 'messages' || activeTab === 'content' || activeTab === 'changes')}>
              <h2 class="ops-pr-actions__title">Links</h2>
              <ul class="ops-pr__links ops-pr__links--stacked">
                {previewRequestLinks(request).map((link) => (
                  <li>
                    {link.label}:{' '}
                    {link.url ? (
                      <a href={link.url} target="_blank" rel="noopener noreferrer nofollow">
                        {link.url}
                      </a>
                    ) : (
                      link.value
                    )}
                    {link.url && link.value !== link.url ? ` (${link.value})` : ''}
                  </li>
                ))}
              </ul>
              <dl class="ops-pr-detail__list">
                {fields.map(([label, value]) => (
                  <div class="ops-pr-detail__item">
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
              {
                adminHubEnabled && (!hubEnabled || activeTab === 'overview') ? (
                  <OpsBrandColours
                    client:load
                    primary={request.brandPrimaryColour}
                    secondary={request.brandSecondaryColour}
                    tone={request.brandBackgroundTone}
                    source={request.brandColoursSource}
                    sentAt={request.brandColoursSentAt ? request.brandColoursSentAt.toISOString() : null}
                    palette={parseBrandPalette(request.brandPaletteExtracted)}
                  />
                ) : null
              }

              {
                hubEnabled && activeTab !== 'overview' ? (
                  <section class="ops-pr-files" aria-label={HUB_OPS_FILES_TITLE} hidden={activeTab !== 'files'}>
                    <h2 class="ops-pr-actions__title">{HUB_OPS_FILES_TITLE}</h2>
                    <dl class="ops-pr-detail__list">
                      <div class="ops-pr-detail__item">
                        <dt>{HUB_OPS_BRAND_COLOURS}</dt>
                        <dd>
                          {request.brandPrimaryColour || request.brandSecondaryColour
                            ? `${request.brandPrimaryColour ?? '—'} / ${request.brandSecondaryColour ?? '—'}`
                            : '—'}
                        </dd>
                      </div>
                      <div class="ops-pr-detail__item">
                        <dt>{HUB_OPS_STYLE_NOTES}</dt>
                        <dd>{request.styleNotes ?? '—'}</dd>
                      </div>
                      <div class="ops-pr-detail__item">
                        <dt>{HUB_OPS_ABOUT}</dt>
                        <dd>{request.aboutText ?? '—'}</dd>
                      </div>
                    </dl>
                    {request.hubAssets.length === 0 ? (
                      <p class="ops-pr__empty">{HUB_OPS_FILES_EMPTY}</p>
                    ) : (
                      <ul class="ops-pr-files__grid">
                        {request.hubAssets.map((asset) => (
                          <li class="ops-pr-files__item">
                            <div class="ops-pr-files__thumb">
                              {asset.thumbPath || asset.contentType.startsWith('image/') ? (
                                <img
                                  src={`/api/ops/preview-requests/${request.id}/assets/${asset.id}?size=thumb`}
                                  alt=""
                                />
                              ) : (
                                <span>{asset.kind}</span>
                              )}
                            </div>
                            <p class="ops-pr-files__name">{asset.originalFileName}</p>
                            <p class="ops-pr-files__meta">
                              {asset.kind} · {formatBytes(asset.sizeBytes)} · {formatDate(asset.createdAt)} ·{' '}
                              {asset.uploadedBy === 'OWNER' ? HUB_OPS_UPLOADED_BY_OWNER : HUB_OPS_UPLOADED_BY_KERSIVO}
                            </p>
                            <a
                              class="btn btn--ghost btn--sm"
                              href={`/api/ops/preview-requests/${request.id}/assets/${asset.id}?size=full`}
                            >
                              {HUB_OPS_DOWNLOAD}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </section>
                ) : null
              }

              <h2 class="ops-pr-actions__title">History</h2>
              <ol class="ops-pr-detail__events">
                {request.events.map((event) => (
                  <li>
                    <span class="ops-pr-detail__event-time">{formatDate(event.createdAt)}</span>{' '}
                    {event.action}
                    {event.fromStatus || event.toStatus
                      ? ` (${event.fromStatus ?? '—'} → ${event.toStatus ?? '—'})`
                      : ''}
                    {event.actorEmail ? ` · ${event.actorEmail}` : ''}
                  </li>
                ))}
              </ol>
            </section>

            <aside class="ops-pr-detail__actions">
              <PreviewRequestActions
                client:load
                requestId={request.id}
                status={request.status}
                draftShopId={request.draftShopId}
                internalNotes={request.internalNotes ?? ''}
                previewUrl={previewPageUrl(request.publicToken)}
                sitePreviewUrl={request.draftShop?.sitePreviewUrl ?? null}
                sitePreviewVersion={request.draftShop?.sitePreviewVersion ?? null}
                flowEnabled={isFreePreviewFlowEnabled()}
                hubEnabled={hubEnabled}
                hubStageLabel={hubStageLabel ?? undefined}
                launchApprovedAt={request.launchApprovedAt?.toISOString() ?? null}
                liveAt={request.liveAt?.toISOString() ?? null}
                ourStepDomainAt={request.ourStepDomainAt?.toISOString() ?? null}
                ourStepSslAt={request.ourStepSslAt?.toISOString() ?? null}
              />
            </aside>
          </div>
        </div>
      ) : null
    }
  </main>
</MinimalLayout>
