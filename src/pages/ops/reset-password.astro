---
export const prerender = false;

import MinimalLayout from '@/layouts/MinimalLayout.astro';
import OpsResetPasswordForm from '@/components/ops/OpsResetPasswordForm';
import '@/styles/tokens.css';
import '@/styles/fonts-admin.css';
import '@/styles/global.css';
import '@/styles/components/inputs.css';
import '@/styles/components/buttons.css';
import '@/styles/components/admin-login.css';
import '@/styles/components/ops-recommendations.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Vary', 'Cookie');
---

<MinimalLayout
  title="Reset password | KERSIVO Ops"
  description="Set a new password for a KERSIVO operator account."
  canonicalPath="/ops/reset-password"
  htmlClass="admin-app-scroll"
  bodyClass="admin-theme-premium-black ops-app"
  noindex={true}
  robotsFollow={false}
  showCookieConsent={false}
  enableAnalytics={false}
  enableClientRouter={false}
  viewportContent="width=device-width, initial-scale=1, viewport-fit=cover"
>
  <main class="container page-wrap">
    <div class="ops-gate">
      <p class="ops-gate__brand">KERSIVO Ops</p>
      <h1 class="ops-gate__title">Password reset</h1>
      <p class="ops-gate__body">
        After updating your password, sign in with an allowlisted operator email to open the Control Room.
      </p>
      <div class="admin-login-viewport ops-gate__auth">
        <div class="auth-gate-card">
          <OpsResetPasswordForm client:load />
        </div>
      </div>
    </div>
  </main>
</MinimalLayout>
