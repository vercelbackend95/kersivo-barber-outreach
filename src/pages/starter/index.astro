---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Faq4 from '@/components/faq4.astro';
import Footer50 from '@/components/footer50.astro';
import {
  STARTER_FAQ_ITEMS,
  STARTER_PAGE_DESCRIPTION,
  STARTER_PAGE_H1,
  STARTER_PAGE_LAST_UPDATED_ISO,
  STARTER_PAGE_LAST_UPDATED_LABEL,
  STARTER_PAGE_PATH,
  STARTER_PAGE_TITLE,
  buildStarterFaqJsonLd,
  buildStarterWebPageJsonLd,
} from '@/lib/seo/starterPage';
import {
  FOOTER_LEGAL_LINKS,
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import { buildKersivoEntityJsonLd } from '@/lib/seo/kersivoEntityJsonLd';
import { CreditCard, UserRound, UsersRound } from 'lucide-react';
import '@/styles/components/fresha-alternative.css';
import '@/styles/components/starter-landing.css';

const currentYear = new Date().getFullYear();

const heroTitleLines = (() => {
  const forAt = STARTER_PAGE_H1.indexOf(' for ');
  const dashAt = STARTER_PAGE_H1.indexOf(' — ');
  if (forAt < 0 || dashAt < forAt) return [STARTER_PAGE_H1];
  return [
    STARTER_PAGE_H1.slice(0, forAt + 1),
    STARTER_PAGE_H1.slice(forAt + 1, dashAt + 1),
    STARTER_PAGE_H1.slice(dashAt + 1),
  ];
})();

const starterFeatures = [
  {
    title: 'Hosted booking page',
    icon: 'browser',
    body: 'Give clients a clean KERSIVO-hosted booking page they can open from Google, a QR code or a link — no website build needed.',
  },
  {
    title: 'Bookings and timeline',
    icon: 'calendar-time',
    body: 'See every current and upcoming booking on the timeline, and add walk-ins and phone bookings manually with the same availability rules.',
  },
  {
    title: 'Team, services and availability',
    icon: 'users-four',
    body: 'Set up to 4 active bookable barbers, your services and prices, and when each barber can be booked.',
  },
  {
    title: 'Rolling 90-day history',
    icon: 'history',
    body: 'Keep the last 90 days of past bookings to hand for day-to-day questions, alongside all current and future bookings.',
  },
  {
    title: 'Clients Core',
    icon: 'address-book',
    body: 'Find client contact details and recent booking context quickly while you run the day.',
  },
  {
    title: 'Automated email reminders',
    icon: 'mail',
    body: 'Booking confirmations and appointment reminders go out by email automatically, so clients remember to turn up.',
  },
] as const;

const fullOnly = [
  'Your own branded website and domain',
  'More than 4 active bookable barbers',
  'Full booking history',
  'Advanced Clients / CRM',
  'Reports',
  'Retail, Products, Orders and Sales',
  'SMS reminders',
  'Live KERSIVO Assistant',
  'Editable booking payment controls, including Pay at shop',
] as const;
---

<LandingLayout
  title={STARTER_PAGE_TITLE}
  description={STARTER_PAGE_DESCRIPTION}
  canonicalPath={STARTER_PAGE_PATH}
  jsonLd={[buildKersivoEntityJsonLd(), buildStarterWebPageJsonLd(), buildStarterFaqJsonLd()]}
>
  <main class="starter-landing">
    <section class="starter-hero" aria-labelledby="starter-hero-title">
      <div class="starter-shell starter-hero__grid">
        <div class="starter-hero__copy">
          <p class="starter-kicker starter-hero__eyebrow">
            <span class="starter-kicker__dot" aria-hidden="true"></span>
            KERSIVO STARTER · BUILT FOR UK BARBERSHOPS
          </p>
          <h1 id="starter-hero-title" class="starter-hero__title">{heroTitleLines.map((line, index) => (
            <span class:list={['starter-hero__title-line', { 'starter-hero__title-line--primary': index === 0 }]}>{line}</span>
          ))}</h1>
          <p class="starter-hero__lead">
            A serious booking system for independent UK barbershops. Set up your diary, team,
            services and clients, then connect Stripe to launch a booking flow where every public
            appointment is secured by £5 or paid in full.
          </p>

          <div class="starter-hero__actions">
            <a
              href="/admin"
              class="fresha-alt-hero__action fresha-alt-hero__action--primary"
              data-track="starter_signup_click"
              data-track-placement="starter_hero"
            >
              Start KERSIVO Starter
            </a>
            <a href="/demo" class="fresha-alt-hero__action fresha-alt-hero__action--secondary" data-track="view_live_demo_click">
              See KERSIVO in action
            </a>
          </div>

          <div class="starter-hero__price-row" aria-label="KERSIVO Starter pricing">
            <strong>£0/month</strong>
            <span aria-hidden="true">·</span>
            <strong>0% KERSIVO commission</strong>
          </div>

          <p class="starter-hero__fine">
            A connected Stripe account is required before public bookings go live. Standard Stripe
            processing fees apply. KERSIVO adds 0% platform fee.
          </p>

          <p class="starter-updated">
            Last updated <time datetime={STARTER_PAGE_LAST_UPDATED_ISO}>{STARTER_PAGE_LAST_UPDATED_LABEL}</time>
          </p>
        </div>

        <aside class="starter-glance-card starter-hero__card" aria-label="KERSIVO Starter quick facts">
          <p class="starter-card__eyebrow starter-glance__label">STARTER AT A GLANCE</p>
          <dl class="starter-glance">
            <div class="starter-glance__value">
              <dt>Monthly fee</dt>
              <dd>£0</dd>
            </div>
            <div class="starter-glance__value">
              <dt>KERSIVO commission</dt>
              <dd>0%</dd>
            </div>
            <div class="starter-glance__detail">
              <dt>Bookable barbers</dt>
              <dd>Up to 4</dd>
            </div>
            <div class="starter-glance__detail">
              <dt>Booking page</dt>
              <dd>KERSIVO hosted</dd>
            </div>
            <div class="starter-glance__detail starter-glance__detail--wide">
              <dt>Public booking payment</dt>
              <dd>£5 deposit or Pay in full</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="starter-section" aria-labelledby="starter-core-title">
      <div class="starter-shell">
        <header class="starter-section__header">
          <p class="starter-section__eyebrow">RUN THE DIARY</p>
          <h2 id="starter-core-title">The core tools to take bookings and run the day.</h2>
          <p>
            Starter is not a temporary trial. It is a real operating plan for independent shops that
            want a straightforward booking setup before they need the wider Full KERSIVO toolkit.
          </p>
        </header>

        <div class="starter-feature-grid">
          {starterFeatures.map((feature) => (
            <article class="starter-feature">
              <span
                class="starter-feature__icon"
                aria-hidden="true"
                style={`--icon: url('/images/svg/${feature.icon}.svg')`}
              ></span>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="starter-dist" aria-labelledby="starter-distribution-title" data-dist>
      <div class="starter-shell">
        <header class="starter-dist__scene starter-dist__intro" data-dist-scene>
          <p class="starter-section__eyebrow starter-dist__eyebrow" data-dist-item style="--i: 0">GET FOUND. GET SCANNED. GET BOOKED.</p>
          <h2 id="starter-distribution-title" class="starter-dist__title" data-dist-item data-dist-keep style="--i: 1">Turn Google, your window and your shop into booking entry points.</h2>
          <p class="starter-dist__lead" data-dist-item style="--i: 2">
            Starter is built to help clients reach your booking page from places they already use.
          </p>
        </header>

        <div class="starter-dist__scene starter-dist__scene--google" data-dist-scene>
          <div class="starter-dist__text">
            <span class="starter-dist__step" aria-hidden="true" data-dist-item style="--i: 0">01</span>
            <h3 data-dist-item style="--i: 1">Google booking setup</h3>
            <p data-dist-item style="--i: 2">
              KERSIVO gives you the correct booking URL and a guided setup for your Google Business
              Profile. Google controls eligibility and where booking actions appear.
            </p>
          </div>
          <div class="starter-dist__logo-slot" aria-hidden="true" data-google-logo-slot data-dist-item data-dist-fade style="--i: 3">
            <img src="/images/starter/google-g-192.webp" alt="" width="192" height="192" loading="lazy" decoding="async" />
          </div>
        </div>

        <div class="starter-dist__scene starter-dist__scene--qr" data-dist-scene>
          <div class="starter-dist__text">
            <span class="starter-dist__step" aria-hidden="true" data-dist-item style="--i: 1">02</span>
            <h3 data-dist-item style="--i: 2">Included initial QR Kit</h3>
            <p data-dist-item style="--i: 3">
              Eligible verified UK Starter locations can request one initial kit with two separate
              QR codes: WINDOW for inside the shop glass and REBOOK for the counter. Both open your
              booking page and keep working if you later move to Full.
            </p>
            <p class="starter-note" data-dist-item style="--i: 4">
              Shop details are verified before the kit goes to print. Replacements and reorders are
              handled separately.
            </p>
          </div>
          <figure class="starter-dist__media" data-dist-item data-dist-fade style="--i: 0">
            <img
              src="/images/starter/kersivo-book-now-qr-glass-sign-900.webp"
              srcset="/images/starter/kersivo-book-now-qr-glass-sign-640.webp 640w, /images/starter/kersivo-book-now-qr-glass-sign-900.webp 900w, /images/starter/kersivo-book-now-qr-glass-sign.webp 1122w"
              sizes="(min-width: 1220px) 480px, (min-width: 641px) 40vw, 20rem"
              alt="KERSIVO WINDOW QR code sticker on shop glass: Book now, scan to book, powered by KERSIVO"
              width="1122"
              height="1402"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>

        <div class="starter-dist__scene starter-dist__scene--browser" data-dist-scene>
          <div class="starter-dist__text">
            <span class="starter-dist__step" aria-hidden="true" data-dist-item style="--i: 0">03</span>
            <h3 data-dist-item style="--i: 1">No customer app required</h3>
            <p data-dist-item style="--i: 2">
              Clients book in the browser through your KERSIVO-hosted booking page. No customer app
              download is required.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="starter-section" aria-labelledby="starter-payments-title">
      <div class="starter-shell starter-split">
        <div>
          <p class="starter-section__eyebrow">PAYMENT-POWERED STARTER</p>
          <h2 id="starter-payments-title">Every public booking starts with at least £5 online.</h2>
          <p class="starter-section__body">
            For services above £5, clients choose a £5 deposit or Pay in full. A £5 service is paid
            in full. Starter keeps this payment rule fixed so there is nothing to configure; Full
            KERSIVO unlocks control over how customers pay when they book.
          </p>
        </div>
        <div class="starter-glance-card starter-payment-card">
          <dl class="starter-glance">
            <div class="starter-glance__value starter-glance__value--term">
              <dt>£5 deposit</dt>
              <dd>Available on services above £5</dd>
            </div>
            <div class="starter-glance__value starter-glance__value--term">
              <dt>Pay in full</dt>
              <dd>Available on every public booking</dd>
            </div>
            <div class="starter-glance__detail">
              <dt>Public Pay at shop</dt>
              <dd>Unlocked with Full KERSIVO</dd>
            </div>
            <div class="starter-glance__detail">
              <dt>KERSIVO fee</dt>
              <dd>0%</dd>
            </div>
          </dl>
          <small class="starter-payment-card__note">A connected Stripe account is required for public Starter bookings. Standard Stripe processing fees apply.</small>
        </div>
      </div>
    </section>

    <section class="starter-section starter-section--compare" aria-labelledby="starter-compare-title">
      <div class="starter-shell">
        <header class="starter-section__header">
          <p class="starter-section__eyebrow">START SMALL. UPGRADE FOR OWNERSHIP.</p>
          <h2 id="starter-compare-title">Starter runs the core booking operation. Full builds the complete brand.</h2>
          <p>
            Upgrade when your shop needs more capacity, deeper client tools or a complete branded
            customer experience.
          </p>
        </header>

        <div class="starter-plan-grid">
          <article class="starter-plan-card starter-plan-card--active">
            <p class="starter-plan-card__label">KERSIVO STARTER</p>
            <p class="starter-plan-card__price">£0<span>/month</span></p>
            <ul>
              <li>KERSIVO-hosted booking page</li>
              <li>Up to 4 active bookable barbers</li>
              <li>Bookings, team, services and availability</li>
              <li>Manual bookings</li>
              <li>Rolling 90-day booking history</li>
              <li>Clients Core</li>
              <li>Automated email reminders</li>
              <li>£5 deposit or Pay in full on every public booking</li>
              <li>Guided Google booking-link setup</li>
              <li>Included initial QR Kit for eligible verified UK locations</li>
            </ul>
            <a
              href="/admin"
              class="fresha-alt-hero__action fresha-alt-hero__action--primary"
              data-track="starter_signup_click"
              data-track-placement="starter_compare"
            >
              Start KERSIVO Starter
            </a>
          </article>

          <article class="starter-plan-card">
            <p class="starter-plan-card__label">FULL KERSIVO</p>
            <p class="starter-plan-card__price">£{SAAS_MONTHLY_GBP}<span>/month per location</span></p>
            <p class="starter-plan-card__intro">
              Everything in the Starter booking operation, plus the full KERSIVO ownership layer:
            </p>
            <ul>
              {fullOnly.map((item) => <li>{item}</li>)}
            </ul>
            <a href="/pricing#plan" class="fresha-alt-hero__action fresha-alt-hero__action--secondary">See Full KERSIVO pricing</a>
          </article>
        </div>
      </div>
    </section>

    <section
      class="starter-section starter-section--steps starter-flow"
      aria-labelledby="starter-steps-title"
      data-dist
    >
      <div class="starter-shell" data-dist-scene>
        <header class="starter-flow__intro">
          <p class="starter-section__eyebrow starter-flow__eyebrow" data-dist-item style="--i: 0">START IN THREE STEPS</p>
          <h2 id="starter-steps-title" class="starter-flow__title" data-dist-item data-dist-keep style="--i: 1">Set up first. Connect Stripe when you are ready to launch.</h2>
          <p class="starter-flow__lead" data-dist-item style="--i: 2">
            Build the workspace before taking any public bookings. Starter stays £0/month; public
            booking only goes live after you choose Starter and finish the Stripe connection.
          </p>
        </header>

        <ol class="starter-steps">
          {[
            {
              number: '01',
              icon: UserRound,
              title: 'Create your KERSIVO account',
              body: 'Sign up and add the basic details for your shop.',
            },
            {
              number: '02',
              icon: UsersRound,
              title: 'Add your team, services and availability',
              body: 'Set up who takes bookings, what they offer and when clients can book.',
            },
            {
              number: '03',
              icon: CreditCard,
              title: 'Choose Starter, connect Stripe and launch',
              body: 'Pick Starter at £0/month, connect Stripe and finish setup. Once your services are £5 or more, your booking page can take £5 deposits or full payments.',
            },
          ].map((step, index) => {
            const Icon = step.icon;
            return (
              <li class="starter-steps__item" data-dist-item style={`--i: ${index + 3}`}>
                <span class="starter-steps__marker">{step.number}</span>
                <span class="starter-steps__icon" aria-hidden="true">
                  <Icon size={22} strokeWidth={1.6} />
                </span>
                <div class="starter-steps__copy">
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <Faq4
      className="faq4--landing"
      heading="Questions about KERSIVO Starter?"
      subHeading="Clear answers on pricing, Stripe, the QR Kit, Google booking and upgrading to Full."
      supportHeading="Still have a question?"
      supportText="Tell us about your barbershop and we’ll give you a clear answer."
      supportLinkLabel="Email KERSIVO"
      supportLinkHref={`mailto:${KERSIVO_CONTACT_EMAIL}`}
      faqs={STARTER_FAQ_ITEMS}
    />

    <section class="starter-final" aria-labelledby="starter-final-title">
      <div class="starter-shell starter-final__panel">
        <div>
          <p class="starter-section__eyebrow">KERSIVO STARTER</p>
          <h2 id="starter-final-title">Start taking payment-backed bookings without a monthly software bill.</h2>
          <p>
            £0/month. 0% KERSIVO commission. £5 deposit or Pay in full on every public booking.
            Move to Full when you want the complete branded experience and control over how clients pay.
          </p>
        </div>
        <div class="starter-final__actions">
          <a
            href="/admin"
            class="fresha-alt-hero__action fresha-alt-hero__action--primary"
            data-track="starter_signup_click"
            data-track-placement="starter_final"
          >
            Start KERSIVO Starter
          </a>
          <a href="/pricing" class="starter-text-link">Compare with Full KERSIVO →</a>
        </div>
      </div>
    </section>

    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      navigation={[
        { name: 'Home', href: '/' },
        { name: 'Starter', href: '/starter' },
        { name: 'Pricing', href: '/pricing' },
        { name: 'Live demo', href: '/demo' },
        { name: 'Booksy comparison', href: '/booksy-alternative' },
        { name: 'Fresha comparison', href: '/fresha-alternative' },
      ]}
      social={getFooterSocialLinks()}
      legal={[
        FOOTER_LEGAL_LINKS.privacy,
        FOOTER_LEGAL_LINKS.cookies,
        FOOTER_LEGAL_LINKS.cookieSettings,
        FOOTER_LEGAL_LINKS.dpa,
        FOOTER_LEGAL_LINKS.termsAndCancellation,
      ]}
    />
  </main>
</LandingLayout>

<script>
  import { initScrollSceneReveal } from '@/lib/landing/initScrollSceneReveal';

  const bindDistributionScenes = () => {
    for (const section of document.querySelectorAll<HTMLElement>('[data-dist]')) {
      if (section.dataset.distBound === 'true') continue;
      section.dataset.distBound = 'true';
      const stop = initScrollSceneReveal(section);
      document.addEventListener('astro:before-swap', stop, { once: true });
    }
  };

  bindDistributionScenes();
  document.addEventListener('astro:page-load', bindDistributionScenes);
</script>
