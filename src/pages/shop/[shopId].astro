---
import MainLayout from '@/layouts/MainLayout.astro';
import { prisma } from '@/lib/db/client';
import { DEMO_SHOP_ID } from '@/lib/db/shopScope';
import {
  PUBLIC_BOOKING_UNAVAILABLE_MESSAGE,
  withPrismaQuotaFallback,
} from '@/lib/db/resilience';
import { canSellRetail } from '@/lib/shop/cardPaymentsGate';
import { shopAcceptsPublicBookings } from '@/lib/setup/shopPublicBookingGate';
import { formatGbp } from '@/lib/shop/money';
import '@/styles/components/shop.css';
import '@/styles/components/badge.css';

export const prerender = false;

const shopId = Astro.params.shopId?.trim() ?? '';
const checkoutCancelled = Astro.url.searchParams.get('checkout') === 'cancelled';

if (!shopId || shopId === DEMO_SHOP_ID) {
  return Astro.redirect('/shop');
}

const outageShop = {
  id: shopId,
  name: 'Barbershop',
  shopPaidAt: null as Date | null,
  smsRemindersEnabled: false,
  retailEnabled: false,
  stripeConnectAccountId: null as string | null,
  stripeConnectChargesEnabled: false,
  publicActivityPaused: true,
};

const pageData = await withPrismaQuotaFallback(
  'shop/[shopId].astro',
  async () => {
    const shop = await prisma.shopSettings.findUnique({
      where: { id: shopId },
      select: {
        id: true,
        name: true,
        shopPaidAt: true,
        smsRemindersEnabled: true,
        retailEnabled: true,
        stripeConnectAccountId: true,
        stripeConnectChargesEnabled: true,
        publicActivityPaused: true,
      },
    });

    if (!shop) {
      return { notFound: true as const };
    }

    const acceptsPublic = await shopAcceptsPublicBookings(shopId);
    if (!acceptsPublic) {
      return {
        notFound: false as const,
        shop,
        products: [],
        retailReady: false,
        shopUnavailable: true,
      };
    }

    const products = await prisma.product.findMany({
      where: { shopId, active: true },
      orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }],
      select: {
        id: true,
        name: true,
        pricePence: true,
        imageUrl: true,
        category: true,
        featured: true,
      },
    });

    return {
      notFound: false as const,
      shop,
      products,
      retailReady: canSellRetail(shop) && !shop.publicActivityPaused,
      shopUnavailable: false,
    };
  },
  {
    notFound: false as const,
    shop: outageShop,
    products: [] as Array<{
      id: string;
      name: string;
      pricePence: number;
      imageUrl: string | null;
      category: string;
      featured: boolean;
    }>,
    retailReady: false,
    shopUnavailable: true,
  },
);

if (pageData.notFound) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { shop, products, retailReady, shopUnavailable } = pageData;
const title = `${shop.name} — Shop | Kersivo`;
const description = `Order products for pickup at ${shop.name}.`;
---

<MainLayout
  title={title}
  description={description}
  canonicalPath={`/shop/${shopId}`}
  noindex
  navbarVariant="shop"
  shopId={shopId}
>
  <main class="container shop-page">
    <header class="shop-header">
      <p class="shop-kicker">Pickup only</p>
      <h1>{shop.name}</h1>
      <p class="muted">Order online and collect in store. No shipping.</p>
      {checkoutCancelled ? (
        <p class="admin-inline-error" role="status">Checkout was cancelled. Your bag is unchanged.</p>
      ) : null}
    </header>

    {shopUnavailable || !retailReady ? (
      <article class="shop-promo-card shop-promo-card--empty">
        <p class="shop-promo-kicker">Temporarily unavailable</p>
        <h2>Online shop is not available right now</h2>
        <p>{PUBLIC_BOOKING_UNAVAILABLE_MESSAGE}</p>
      </article>
    ) : products.length === 0 ? (
      <article class="shop-promo-card shop-promo-card--empty">
        <p class="shop-promo-kicker">Coming soon</p>
        <h2>No products listed yet</h2>
        <p>Check back soon or ask the barbershop in person.</p>
      </article>
    ) : (
      <section class="shop-layout" aria-label="Products">
        <ul class="shop-grid" aria-label="Products">
          {products.map((product) => (
            <li>
              <article class="shop-card">
                <div class="shop-media">
                  {product.featured ? <span class="shop-badge">Featured</span> : null}
                  {product.imageUrl ? (
                    <img src={product.imageUrl} alt={product.name} class="shop-image" loading="lazy" />
                  ) : (
                    <div class="shop-image--placeholder" aria-hidden="true"></div>
                  )}
                </div>
                <div class="shop-card-body">
                  <h3>{product.name}</h3>
                  <p class="shop-price">{formatGbp(product.pricePence)}</p>
                  <div class="shop-card-actions">
                    <button
                      type="button"
                      class="btn btn--primary btn--atc"
                      data-add-to-cart
                      data-product-id={product.id}
                      data-product-name={product.name}
                      data-product-price-pence={String(product.pricePence)}
                      data-product-image-url={product.imageUrl ?? ''}
                      data-atc-label="Add to cart"
                    >
                      Add to cart
                    </button>
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</MainLayout>
