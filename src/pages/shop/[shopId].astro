---
import MainLayout from '@/layouts/MainLayout.astro';
import StorefrontShopPage from '@/components/shop/storefront/StorefrontShopPage';
import { prisma } from '@/lib/db/client';
import { BLACKLINE_SHOP_ID } from '@/lib/demo/products';
import { isDemoShopId } from '@/lib/shop/cardPaymentsGate';
import {
  PUBLIC_BOOKING_UNAVAILABLE_MESSAGE,
  withPrismaQuotaFallback,
} from '@/lib/db/resilience';
import { canSellRetail } from '@/lib/shop/cardPaymentsGate';
import { shopAcceptsPublicBookings } from '@/lib/setup/shopPublicBookingGate';
import {
  parseStorefrontCategoryParam,
  storefrontCategoryOptions,
  storefrontProductFromPrisma,
  type StorefrontProduct,
} from '@/lib/shop/storefrontCatalog';
import { buildTenantShopItemListJsonLd } from '@/lib/seo/productJsonLd';
import '@/styles/components/shop.css';
import '@/styles/components/badge.css';
import '@/styles/components/storefront.css';

export const prerender = false;

const shopId = Astro.params.shopId?.trim() ?? '';
const checkoutCancelled = Astro.url.searchParams.get('checkout') === 'cancelled';

if (!shopId || isDemoShopId(shopId)) {
  return Astro.redirect(shopId === BLACKLINE_SHOP_ID ? '/demo/shop' : '/shop');
}

const outageShop = {
  id: shopId,
  name: 'Barbershop',
  logoUrl: null as string | null,
  shopPaidAt: null as Date | null,
  smsRemindersEnabled: false,
  retailEnabled: false,
  stripeConnectAccountId: null as string | null,
  stripeConnectChargesEnabled: false,
  publicActivityPaused: true,
};

const pageData = await withPrismaQuotaFallback(
  'shop/[shopId].astro',
  async () => {
    const shop = await prisma.shopSettings.findUnique({
      where: { id: shopId },
      select: {
        id: true,
        name: true,
        logoUrl: true,
        shopPaidAt: true,
        smsRemindersEnabled: true,
        retailEnabled: true,
        stripeConnectAccountId: true,
        stripeConnectChargesEnabled: true,
        publicActivityPaused: true,
      },
    });

    if (!shop) {
      return { notFound: true as const };
    }

    const acceptsPublic = await shopAcceptsPublicBookings(shopId);
    if (!acceptsPublic) {
      return {
        notFound: false as const,
        shop,
        products: [] as StorefrontProduct[],
        retailReady: false,
        shopUnavailable: true,
      };
    }

    const rows = await prisma.product.findMany({
      where: { shopId, active: true },
      orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }],
      select: {
        id: true,
        name: true,
        description: true,
        pricePence: true,
        imageUrl: true,
        category: true,
        featured: true,
        sortOrder: true,
        active: true,
      },
    });

    return {
      notFound: false as const,
      shop,
      products: rows.map(storefrontProductFromPrisma),
      retailReady: canSellRetail(shop) && !shop.publicActivityPaused,
      shopUnavailable: false,
    };
  },
  {
    notFound: false as const,
    shop: outageShop,
    products: [] as StorefrontProduct[],
    retailReady: false,
    shopUnavailable: true,
  },
);

if (pageData.notFound) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { shop, products, retailReady, shopUnavailable } = pageData;
const selectedCategory = parseStorefrontCategoryParam(
  Astro.url.searchParams.get('category'),
  storefrontCategoryOptions(products).map((option) => option.value),
);
const title = `${shop.name} — Shop | Kersivo`;
const description = `Order products for pickup at ${shop.name}.`;
const listingJsonLd =
  !shopUnavailable && retailReady && products.length > 0
    ? buildTenantShopItemListJsonLd({
        shopId,
        shopName: shop.name,
        products,
      })
    : undefined;
---

<MainLayout
  title={title}
  description={description}
  canonicalPath={`/shop/${shopId}`}
  noindex
  navbarVariant="shop"
  shopId={shopId}
  shopName={shop.name}
  brandLogoUrl={shop.logoUrl}
  jsonLd={listingJsonLd}
>
  <main class="container shop-page" data-active-category={selectedCategory}>
    {checkoutCancelled ? (
      <p class="admin-inline-error" role="status">Checkout was cancelled. Your bag is unchanged.</p>
    ) : null}

    {shopUnavailable || !retailReady ? (
      <article class="shop-promo-card shop-promo-card--empty">
        <p class="shop-promo-kicker">Temporarily unavailable</p>
        <h2>Online shop is not available right now</h2>
        <p>{PUBLIC_BOOKING_UNAVAILABLE_MESSAGE}</p>
      </article>
    ) : (
      <StorefrontShopPage
        client:load
        products={products}
        themeId="kersivo"
        shopName={shop.name}
        productHrefPrefix={`/shop/${shopId}`}
        priceFormat="gbp"
        imageFallback="initial"
        selectedCategory={selectedCategory}
        intro={{
          eyebrow: 'Pickup only',
          heading: shop.name,
          headingId: 'storefront-heading',
          description: 'Order online and collect in store. No shipping.',
          fulfilmentLabel: 'Collect in shop',
        }}
        showPoweredBy
        emptyTitle="No products listed yet"
        emptyDescription="Check back soon or ask the barbershop in person."
      />
    )}
  </main>
</MainLayout>
