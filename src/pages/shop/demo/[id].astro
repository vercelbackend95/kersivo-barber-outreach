---
import MainLayout from '@/layouts/MainLayout.astro';
import DemoNotice from '@/components/shop/DemoNotice.astro';
import StorefrontProductDetail from '@/components/shop/storefront/StorefrontProductDetail';
import Footer50 from '@/components/footer50.astro';
import '@/styles/components/footer50.css';
import '@/styles/components/storefront.css';
import { getFooterSocialLinks } from '@/lib/seo/footerSocialLinks';
import {
  getDemoCatalogProductById,
  getDemoCatalogProducts,
} from '@/lib/shop/demoCatalog';
import { buildDemoProductBreadcrumbJsonLd } from '@/lib/seo/productJsonLd';
import { relatedStorefrontProducts, storefrontProductFromCatalog } from '@/lib/shop/storefrontCatalog';

const { id } = Astro.params;
const catalog = getDemoCatalogProducts().map(storefrontProductFromCatalog);
const product = id ? catalog.find((item) => item.id === id) ?? null : null;
const related = product ? relatedStorefrontProducts(catalog, product.id) : [];
const source = id ? getDemoCatalogProductById(id) : null;

const FOOTER_PROPS = {
  showIntro: true,
  heading: 'Ready to launch a better website system for your barbershop?',
  description: 'Plan your setup and we’ll help you choose the right setup for your website, booking flow, shop and admin tools.',
  ctaText: 'GET STARTED',
  ctaHref: '/#book-demo',
  ctaIsDemo: false,
  brandName: 'Kersivo',
  navigation: [
    { name: 'Home', href: '/#home' },
    { name: 'Paths', href: '/#paths' },
    { name: 'Pricing', href: '/#pricing' },
    { name: 'FAQ', href: '/#faq' },
    { name: 'Contact', href: '/#contact' },
    { name: 'Retail Demo', href: '/shop' }
  ],
  social: getFooterSocialLinks(),
  legal: [
    { name: 'Privacy Policy', href: '/privacy' },
    { name: 'Cookie Policy', href: '/cookies' },
    { name: 'Cookie settings', href: '#cookie-settings' },
    { name: 'Terms', href: '/terms' }
  ]
};

if (!product) {
  Astro.response.status = 404;
}

const demoBreadcrumbJsonLd = product
  ? buildDemoProductBreadcrumbJsonLd(product.name, `/shop/demo/${product.id}`)
  : null;
---

{!product ? (
  <MainLayout
    title="Product not found | Kersivo"
    description="This demo product is not available. Browse the Kersivo retail demo catalog."
    canonicalPath={id ? `/shop/demo/${id}` : '/shop'}
    noindex
  >
    <main class="container shop-page">
      <a href="/shop" class="sf-pdp-back product-back-link">← Back to retail demo</a>
      <section class="sf-pdp-copy" aria-label="Product not found">
        <h1 class="sf-pdp-name">Product not found</h1>
        <p class="sf-pdp-desc">This product is not in the retail demo catalog.</p>
        <a href="/shop" class="sf-atc">Back to retail demo</a>
      </section>
    </main>
    <Footer50 {...FOOTER_PROPS} />
  </MainLayout>
) : (
  <MainLayout
    title={`${product.name} | Kersivo Retail Demo`}
    description={product.description}
    canonicalPath={`/shop/demo/${product.id}`}
    ogImagePath={source?.imageUrl?.startsWith('/') ? source.imageUrl : undefined}
    ogImageAlt={`${product.name} — Kersivo demo grooming shop`}
    jsonLd={demoBreadcrumbJsonLd!}
    navbarVariant="shop"
    publicDemoMode
    noindex
    robotsFollow
  >
    <main class="container shop-page">
      <DemoNotice />
      <StorefrontProductDetail
        client:load
        product={product}
        related={related}
        themeId="kersivo"
        shopName="KERSIVO"
        backHref="/shop"
        productHrefPrefix="/shop/demo"
        priceFormat="gbp"
        imageFallback="initial"
        fulfilmentLabel="Demo pickup — no payment is taken and no real order is created."
        addToBagLabel="Add to bag"
      />
    </main>
    <Footer50 {...FOOTER_PROPS} />
  </MainLayout>
)}
