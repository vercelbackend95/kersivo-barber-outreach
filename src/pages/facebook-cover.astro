---
import FacebookCoverHero from '@/components/facebookCoverHero.astro';
import '@/styles/tokens.css';
import '@/styles/fonts-landing.css';
import '@/styles/global.css';
import '@/styles/components/hero227.css';
import '@/styles/components/facebook-cover-hero.css';
---

<html lang="en-GB" class="facebook-cover-page">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1702" />
    <meta name="robots" content="noindex, nofollow" />
    <title>KERSIVO Facebook cover</title>
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/antonio-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" as="image" href="/images/hero/phone-5.png" fetchpriority="high" />
    <link rel="preload" as="image" href="/images/hero/iphonemockup.jpg" fetchpriority="high" />
  </head>
  <body>
    <FacebookCoverHero />
  </body>
</html>
