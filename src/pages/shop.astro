---
import MainLayout from '@/layouts/MainLayout.astro';
import { prisma } from '../lib/db/client';
import { resolveShopId } from '../lib/db/shopScope';
import { formatGbp } from '../lib/shop/money';


const shopId = await resolveShopId();
const products = await prisma.product.findMany({
  where: { shopId, active: true },
  orderBy: [{ featured: 'desc' }, { sortOrder: 'asc' }, { updatedAt: 'desc' }]
});

const CATEGORY_LABELS: Record<string, string> = {
  POMADES_AND_CLAYS: 'Pomades',
  BEARD_CARE: 'Beard',
  HAIR_WASH: 'Wash',
  STYLING: 'Styling',
  TOOLS: 'Tools',
  GIFT_SETS: 'Sets'
};
const featuredPromotions = [
  {
    kicker: 'Elevate your routine',
    title: 'Premium grooming products selected by barbers.',
    ctaLabel: 'Shop all products',
    ctaLink: '/shop'
  },
  {
    kicker: 'Details that set you apart',
    title: 'From texture to beard care, every finish in one place.',
    ctaLabel: 'Explore essentials',
    ctaLink: '/shop'
  }
];

const productGroups: typeof products[] = [];
for (let index = 0; index < products.length; index += 8) {
  productGroups.push(products.slice(index, index + 8));
}

const productRows = productGroups.length > 0
  ? productGroups.map((group, index) => ({
      products: group,
      promotion: featuredPromotions[index % featuredPromotions.length],
      reverse: index % 2 === 1
    }))
  : [];


---

<MainLayout title="Shop | Kersivo Barber Outreach">
    <main class="container shop-page" aria-labelledby="shop-page-title">
    <header class="shop-header-block">
      <p class="shop-eyebrow">Curated grooming store</p>
      <h1 id="shop-page-title">Barber retail essentials</h1>
      <p class="shop-intro">A clean product layout inspired by editorial storefronts. Browse quickly, add to cart in one click, and collect in the shop.</p>
    </header>

    {productRows.length === 0 ? (
      <section class="shop-row" aria-label="Shop preview">
        <article class="shop-promo-card">
          <p class="shop-promo-kicker">Retail built in</p>
          <h2>Add products to launch your storefront</h2>
          <p>Publish products in admin and they will appear here instantly.</p>
          <a class="btn btn--primary" href="/shop">Open shop page</a>

        </article>
      </section>
    ) : (
      <section class="shop-layout" aria-label="Products">
        {productRows.map((row) => (
          <div class:list={["shop-row", row.reverse && "shop-row--reverse"]}>
            <article class="shop-promo-card">
              <p class="shop-promo-kicker">{row.promotion.kicker}</p>
              <h2>{row.promotion.title}</h2>
              <a class="btn btn--primary" href={row.promotion.ctaLink}>{row.promotion.ctaLabel}</a>
            </article>

            <ul class="shop-grid" aria-label="Products">
              {row.products.map((product) => (
                <li>
                  <article class="shop-card" data-category={product.category}>
                    <a href={`/shop/${product.id}`} class="shop-media-link" aria-label={`View ${product.name}`}>
                      <div class="shop-media">
                        {product.featured ? <p class="shop-badge">Featured</p> : null}
                        {product.imageUrl ? <img src={product.imageUrl} alt={product.name} class="shop-image" loading="lazy" /> : <div class="shop-image shop-image--placeholder" aria-hidden="true"></div>}
                      </div>
                    </a>

                    <div class="shop-card-body">
                      <p class="shop-category">{CATEGORY_LABELS[product.category] ?? 'Styling'}</p>
                      <h3><a href={`/shop/${product.id}`}>{product.name}</a></h3>
                      <p class="shop-price">{formatGbp(product.pricePence)}</p>

                      <div class="shop-card-actions">
                        <button
                          type="button"
                          class="btn btn--primary"
                          data-add-to-cart
                          data-product-id={product.id}
                          data-product-name={product.name}
                          data-product-price-pence={String(product.pricePence)}
                          data-product-image-url={product.imageUrl ?? ''}
                        >
                          Add to cart
                        </button>
                        <a href={`/shop/${product.id}`} class="btn btn--secondary">Quick view</a>
                      </div>
                    </div>
                  </article>
                </li>
              ))}
            </ul>

          </div>
                  ))}
      </section>
    )}

  </main>
</MainLayout>
