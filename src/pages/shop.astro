---
import MainLayout from '@/layouts/MainLayout.astro';
import DemoNotice from '@/components/shop/DemoNotice.astro';
import RetailDemoBanner from '@/components/shop/RetailDemoBanner.astro';
import StorefrontShopPage from '@/components/shop/storefront/StorefrontShopPage';
import { PAGE_DESCRIPTIONS } from '@/lib/seo/defaults';
import { buildShopBreadcrumbJsonLd } from '@/lib/seo/productJsonLd';
import Footer50 from '../components/footer50.astro';
import '../styles/components/footer50.css';
import '@/styles/components/storefront.css';
import { getFooterSocialLinks } from '@/lib/seo/footerSocialLinks';
import { getDemoCatalogProducts } from '../lib/shop/demoCatalog';
import {
  parseStorefrontCategoryParam,
  storefrontCategoryOptions,
  storefrontProductFromCatalog,
} from '../lib/shop/storefrontCatalog';

const products = getDemoCatalogProducts().map(storefrontProductFromCatalog);
const selectedCategory = parseStorefrontCategoryParam(
  Astro.url.searchParams.get('category'),
  storefrontCategoryOptions(products).map((option) => option.value),
);

const FOOTER_PROPS = {
  showIntro: true,
  heading: 'Ready to launch a better website system for your barbershop?',
  description: 'Plan your setup and we’ll help you choose the right setup for your website, booking flow, shop and admin tools.',
  ctaText: 'GET STARTED',
  ctaHref: '/#book-demo',
  ctaIsDemo: false,
  brandName: 'Kersivo',
  navigation: [
    { name: 'Home', href: '/#home' },
    { name: 'Paths', href: '/#paths' },
    { name: 'Pricing', href: '/#pricing' },
    { name: 'FAQ', href: '/#faq' },
    { name: 'Contact', href: '/#contact' },
    { name: 'Retail Demo', href: '/shop' }
  ],
  social: getFooterSocialLinks(),
  legal: [
    { name: 'Privacy Policy', href: '/privacy' },
    { name: 'Cookie Policy', href: '/cookies' },
    { name: 'Cookie settings', href: '#cookie-settings' },
    { name: 'Terms', href: '/terms' }
  ]
};
---

<MainLayout
  title="Retail Demo | Kersivo"
  description={PAGE_DESCRIPTIONS.shop}
  canonicalPath="/shop"
  jsonLd={buildShopBreadcrumbJsonLd()}
  navbarVariant="shop"
  publicDemoMode
  noindex
  robotsFollow
>
  <main class="container shop-page" aria-labelledby="storefront-heading" data-active-category={selectedCategory}>
    <RetailDemoBanner />
    <DemoNotice />
    <StorefrontShopPage
      client:load
      products={products}
      themeId="kersivo"
      shopName="KERSIVO"
      productHrefPrefix="/shop/demo"
      priceFormat="gbp"
      imageFallback="initial"
      selectedCategory={selectedCategory}
      intro={{
        eyebrow: 'Pick up in shop',
        heading: 'Grooming essentials',
        headingId: 'storefront-heading',
        description: 'Pomades, beard care and styling — try the demo bag. No payment is taken and no real order is created.',
        fulfilmentLabel: 'Collect in shop',
      }}
      emptyTitle="No products in this category"
      emptyDescription="Try another filter or browse all products."
      emptyActionHref="/shop"
      emptyActionLabel="View retail demo"
    />
  </main>

  <Footer50 {...FOOTER_PROPS} />
</MainLayout>
