---
import { KERSIVO_LIVE_DEMO_HREF } from '@/lib/demo/heritage/links';
import LandingLayout from '@/layouts/LandingLayout.astro';
import Footer50 from '@/components/footer50.astro';
import Contact16 from '@/components/contact16.astro';
import EditorialIntro from '@/components/editorial/EditorialIntro.astro';
import FinalCta from '@/components/FinalCta.astro';
import InsightCards from '@/components/editorial/InsightCards.astro';
import {
  ABOUT_AT_A_GLANCE,
  ABOUT_AT_A_GLANCE_TITLE,
  ABOUT_AUDIENCE,
  ABOUT_AUDIENCE_INTRO,
  ABOUT_ENTITY_DEFINITION,
  ABOUT_FACTS,
  ABOUT_DATA_PARAGRAPH,
  ABOUT_INCLUDED_ITEMS,
  ABOUT_SETUP_PARAGRAPH,
  ABOUT_SUPPORT_PARAGRAPH,
  ABOUT_MODEL_POINTS,
  ABOUT_PAGE_DESCRIPTION,
  ABOUT_PAGE_H1,
  ABOUT_PAGE_LAST_UPDATED_ISO,
  ABOUT_PAGE_LAST_UPDATED_LABEL,
  ABOUT_PAGE_PATH,
  ABOUT_PAGE_TITLE,
  ABOUT_PRICING_SUMMARY,
  ABOUT_WHAT_IT_IS_DETAIL,
  ABOUT_WHAT_IT_IS_LEAD,
  ABOUT_WHY_PARAGRAPHS,
  ABOUT_WHY_TITLE,
  buildAboutBreadcrumbJsonLd,
  buildAboutPageJsonLd,
  getAboutOfficialProfiles,
} from '@/lib/seo/aboutPage';
import { buildKersivoEntityJsonLd } from '@/lib/seo/kersivoEntityJsonLd';
import PageBreadcrumbs from '@/components/seo/PageBreadcrumbs.astro';
import { ABOUT_BREADCRUMBS } from '@/lib/seo/breadcrumbs';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import {
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';
import '@/styles/components/fresha-alternative.css';
import '@/styles/components/company-pages.css';
import '@/styles/components/ks-glass-card.css';

const currentYear = new Date().getFullYear();
const officialProfiles = getAboutOfficialProfiles();
---

<LandingLayout
  title={ABOUT_PAGE_TITLE}
  description={ABOUT_PAGE_DESCRIPTION}
  canonicalPath={ABOUT_PAGE_PATH}
  jsonLd={[buildKersivoEntityJsonLd(), buildAboutPageJsonLd(), buildAboutBreadcrumbJsonLd()]}
>
  <main class="fresha-alt landing-overflow-guard">
    <section class="fresha-alt-hero company-hero" aria-labelledby="about-hero-title">
      <div class="fresha-alt-hero__content">
        <PageBreadcrumbs trail={ABOUT_BREADCRUMBS} />
        <p class="fresha-alt-hero__eyebrow">
          <span class="fresha-alt-hero__eyebrow-dot" aria-hidden="true"></span>
          Booking software for UK barbershops
        </p>
        <h1 id="about-hero-title" class="fresha-alt-hero__title">
          <span class="fresha-alt-hero__title-line fresha-alt-hero__title-line--primary">
            {ABOUT_PAGE_H1}
          </span>
        </h1>
        <p class="fresha-alt-hero__lead">{ABOUT_ENTITY_DEFINITION}</p>
        <div class="fresha-alt-hero__actions">
          <a
            href={KERSIVO_LIVE_DEMO_HREF}
            class="fresha-alt-hero__action fresha-alt-hero__action--primary"
            data-track="view_live_demo_click"
          >
            See KERSIVO in Action
          </a>
          <a href="/pricing" class="fresha-alt-hero__action fresha-alt-hero__action--secondary">
            View pricing
          </a>
        </div>
        <p class="company-hero__updated">
          Last updated <time datetime={ABOUT_PAGE_LAST_UPDATED_ISO}>{ABOUT_PAGE_LAST_UPDATED_LABEL}</time>
        </p>
      </div>
    </section>

    <EditorialIntro
      id="what-it-is"
      titleId="about-what-title"
      class="fresha-alt-quick"
      kicker="WHAT KERSIVO IS"
      title="One system for your website, bookings and shop"
      lead={ABOUT_WHAT_IT_IS_LEAD}
      detail={ABOUT_WHAT_IT_IS_DETAIL}
      facts={ABOUT_FACTS}
    />

    <section id="who-its-for" class="fresha-alt__section" aria-labelledby="about-who-title">
      <div class="container">
        <header class="fresha-alt__intro">
          <p class="fresha-alt__eyebrow">WHO IT’S FOR</p>
          <h2 id="about-who-title" class="fresha-alt__h2">Built for independent barbershops</h2>
          <p class="fresha-alt__lead">{ABOUT_AUDIENCE_INTRO}</p>
        </header>
        <InsightCards items={ABOUT_AUDIENCE} />
      </div>
    </section>

    <section id="why" class="fresha-alt__section" aria-labelledby="about-why-title">
      <div class="fresha-alt__glow" aria-hidden="true"></div>
      <div class="container">
        <header class="fresha-alt__intro">
          <p class="fresha-alt__eyebrow">WHY KERSIVO EXISTS</p>
          <h2 id="about-why-title" class="fresha-alt__h2">{ABOUT_WHY_TITLE}</h2>
        </header>
        <div class="company-prose">
          {ABOUT_WHY_PARAGRAPHS.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section id="included" class="fresha-alt__section" aria-labelledby="about-included-title">
      <div class="container">
        <header class="fresha-alt__intro">
          <p class="fresha-alt__eyebrow">WHAT’S INCLUDED</p>
          <h2 id="about-included-title" class="fresha-alt__h2">What each plan includes</h2>
        </header>
        <ul class="company-checks company-checks--columns">
          {ABOUT_INCLUDED_ITEMS.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section id="setup" class="fresha-alt__section" aria-labelledby="about-setup-title">
      <div class="container">
        <header class="fresha-alt__intro">
          <h2 id="about-setup-title" class="fresha-alt__h2">How setup works</h2>
        </header>
        <p>{ABOUT_SETUP_PARAGRAPH}</p>
      </div>
    </section>

    <section id="support" class="fresha-alt__section" aria-labelledby="about-support-title">
      <div class="container">
        <header class="fresha-alt__intro">
          <h2 id="about-support-title" class="fresha-alt__h2">Support and contact</h2>
        </header>
        <p>{ABOUT_SUPPORT_PARAGRAPH}</p>
      </div>
    </section>

    <section id="your-data" class="fresha-alt__section" aria-labelledby="about-data-title">
      <div class="container">
        <header class="fresha-alt__intro">
          <h2 id="about-data-title" class="fresha-alt__h2">Your data and leaving</h2>
        </header>
        <p>
          {ABOUT_DATA_PARAGRAPH} Read the <a href="/terms#subscription">Terms &amp; Cancellation</a> and <a href="/privacy">Privacy Policy</a> for the details.
        </p>
      </div>
    </section>

    <section id="own-brand" class="fresha-alt__section" aria-labelledby="about-model-title">
      <div class="container">
        <header class="fresha-alt__intro">
          <p class="fresha-alt__eyebrow">THE KERSIVO MODEL</p>
          <h2 id="about-model-title" class="fresha-alt__h2">Your brand, direct booking, your domain on Full</h2>
        </header>
        <ul class="company-points">
          {
            ABOUT_MODEL_POINTS.map((point) => (
              <li class="company-point">
                <h3 class="company-point__title">{point.title}</h3>
                <p class="company-point__body">{point.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="pricing" class="fresha-alt__section" aria-labelledby="about-pricing-title">
      <div class="fresha-alt__glow" aria-hidden="true"></div>
      <div class="container">
        <header class="fresha-alt__intro">
          <p class="fresha-alt__eyebrow">PRICING</p>
          <h2 id="about-pricing-title" class="fresha-alt__h2">Two plans. Full KERSIVO £{SAAS_MONTHLY_GBP} a month, or Starter £0.</h2>
        </header>
        <div class="company-summary">
          <p class="company-summary__text">{ABOUT_PRICING_SUMMARY}</p>
          <a href="/pricing" class="company-link">See full KERSIVO pricing <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section id="at-a-glance" class="fresha-alt__section" aria-labelledby="about-glance-title">
      <div class="container">
        <header class="fresha-alt__intro">
          <p class="fresha-alt__eyebrow">ENTITY FACTS</p>
          <h2 id="about-glance-title" class="fresha-alt__h2">{ABOUT_AT_A_GLANCE_TITLE}</h2>
        </header>
        <div class="about-glance ks-glass-card ks-glass-card--accent">
          <dl class="about-glance__list">
            {ABOUT_AT_A_GLANCE.map((fact) => (
              <div class="about-glance__row">
                <dt class="ks-eyebrow ks-eyebrow--neutral">{fact.label}</dt>
                <dd>{fact.href ? <a href={fact.href}>{fact.value}</a> : fact.value}</dd>
              </div>
            ))}
            <div class="about-glance__row">
              <dt class="ks-eyebrow ks-eyebrow--neutral">Official profiles</dt>
              <dd>
                <ul class="about-glance__profiles">
                  {officialProfiles.map((profile) => (
                    <li><a href={profile.href} rel="me noopener" target="_blank">{profile.label}</a></li>
                  ))}
                </ul>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <FinalCta
      eyebrow="SEE IT FOR YOURSELF"
      heading="Explore the KERSIVO demo"
      headingId="about-demo-title"
      text="Open the live demo to see the barbershop website, booking journey and admin dashboard — no signup needed."
      primary={{
        href: KERSIVO_LIVE_DEMO_HREF,
        label: 'See KERSIVO in Action',
        track: 'view_live_demo_click',
      }}
    />

    <Contact16
      eyebrow="CONTACT KERSIVO"
      title="Questions about KERSIVO?"
      description={`Email ${KERSIVO_CONTACT_EMAIL} or send a message below. Tell us about your barbershop and what you use today, and we’ll reply with a clear answer.`}
      note="We’ll reply by email — no sales call required."
      submitLabel="Send my question"
    />

    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      social={getFooterSocialLinks()}
    />
  </main>
</LandingLayout>

<style is:global>
  .landing-overflow-guard {
    overflow-x: clip;
  }
</style>

<style>
  .about-glance {
    --ks-glass-pad: clamp(1.25rem, 3vw, 2rem);
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding: 0.5rem var(--ks-glass-pad);
  }

  .about-glance__list {
    margin: 0;
  }

  .about-glance__row {
    display: grid;
    grid-template-columns: minmax(9rem, 14rem) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.05rem;
  }

  .about-glance__row + .about-glance__row {
    border-top: 1px solid var(--ks-glass-line);
  }

  .about-glance__row dd {
    margin: 0;
    color: #e7e7e9;
    font-size: 0.98rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .about-glance__row a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 0.2em;
  }

  .about-glance__row a:hover,
  .about-glance__row a:focus-visible {
    text-decoration-color: currentColor;
  }

  .about-glance__profiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 40rem) {
    .about-glance__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
    }
  }
</style>
