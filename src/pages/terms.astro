---
import MainLayout from '@/layouts/MainLayout.astro';
import LegalFooter from '@/components/LegalFooter.astro';
import {
  BILLING_CYCLE_CLAIM,
  DATA_EXPORT_RETENTION_CLAIM,
  DOMAIN_AUTH_TEXT,
  DOMAIN_EXISTING_CLAIM,
  DOMAIN_INCLUDED_CLAIM,
  DOMAIN_LIMIT_CLAIM,
  DOMAIN_NEW_CLAIM,
  FAILED_PAYMENT_CLAIM,
  FAIR_USE_IMMEDIATE_RESTRICTION_CLAIM,
  FAIR_USE_IMMEDIATE_TRIGGERS,
  FAIR_USE_INTRO,
  FAIR_USE_ORDINARY_BREACH_CLAIM,
  FAIR_USE_PROHIBITED_LIST,
  FAIR_USE_UNLIMITED_LIST,
  INCLUDED_SETUP_CLAIM,
  NO_PAUSE_CLAIM,
  NO_SETUP_FEE_CLAIM,
  ONBOARDING_BILLING_INDEPENDENT_CLAIM,
  ONBOARDING_MATERIALS_CLAIM,
  ONBOARDING_TIMELINE_CLAIM,
  OWNER_SELF_CONFIG_CLAIM,
  PLAN_SCOPE_CLAIM,
  PLAN_SCOPE_FULL_LIST,
  POWERED_BY_KERSIVO_CLAIM,
  PREVIEW_LAUNCH_CLAIM,
  PRICE_CHANGE_NOTICE_CLAIM,
  PRICE_VAT_DISCLAIMER,
  MISSING_CRITICAL_MATERIALS_CLAIM,
  MISSING_OPTIONAL_MATERIALS_CLAIM,
  NO_FAKE_STOCK_CLAIM,
  REFUND_CLAIM,
  SMS_MONTHLY_ALLOWANCE_TERMS,
  STANDARD_SITE_NOT_BESPOKE_CLAIM,
  STANDARD_SITE_SCOPE_CLAIM,
  SUPPORT_RESPONSE_CLAIM,
  WEBSITE_UPDATE_SUPPORT_CLAIM,
} from '@/lib/pricing/claimsPolicy';
import {
  LEGAL_OPERATOR_LOCATION,
  LEGAL_OPERATOR_NAME,
  TRADING_NAME,
} from '@/lib/legal/businessIdentity';
import { CURRENT_TERMS_VERSION, formatTermsLastUpdated } from '@/lib/legal/termsVersion';
import { PAGE_DESCRIPTIONS, SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import '@/styles/legal-pages.css';
---

<MainLayout
  title="Terms of Service | Kersivo"
  description={PAGE_DESCRIPTIONS.terms}
  canonicalPath="/terms"
>
  <main class="legal-page">
    <article class="container legal-page__inner">
      <h1 class="legal-page__title">Terms of Service</h1>
      <p class="legal-page__updated">Last updated: {formatTermsLastUpdated(CURRENT_TERMS_VERSION)}</p>

      <p>
        These Terms govern the provision of barbershop website, booking, and retail pickup software and related services
        offered under the KERSIVO name. They are intended for business customers (barbershops) in the UK.
      </p>

      <h2>Parties</h2>
      <p>
        The <strong>Service provider</strong> is <strong>{LEGAL_OPERATOR_NAME}</strong>, trading as {TRADING_NAME}, based
        in {LEGAL_OPERATOR_LOCATION}. References in these Terms to &ldquo;{TRADING_NAME}&rdquo;, &ldquo;we&rdquo;,
        &ldquo;us&rdquo; and &ldquo;our&rdquo; mean {LEGAL_OPERATOR_NAME} trading as {TRADING_NAME}, unless the context
        refers specifically to the {TRADING_NAME} software or brand. For enquiries, contact
        <a href="mailto:hello@kersivo.co.uk">hello@kersivo.co.uk</a>.
      </p>
      <p>
        <strong>Client</strong> means the barbershop or business that uses KERSIVO. By ticking the Terms acceptance
        box when activating KERSIVO Starter, purchasing Full KERSIVO, or choosing KERSIVO Starter after Full, you agree
        to these Terms on behalf of the Client. If you act for a business, you confirm that you have authority to bind
        that business. Continued use of the service after access is granted remains subject to the applicable Terms.
      </p>

      <h2>What we provide</h2>
      <p>
        KERSIVO is offered in two service levels for UK barbershops:
      </p>
      <ul>
        <li>
          <strong>KERSIVO Starter — £0/month.</strong> Starter provides the core booking operation on a
          KERSIVO-hosted booking page, including bookings, team, services, availability, manual bookings, recent
          booking history, Clients Core and automated email reminders, subject to the Starter limits in these Terms.
        </li>
        <li>
          <strong>Full KERSIVO — £{SAAS_MONTHLY_GBP}/month per physical location.</strong> Full adds the branded
          website / own-domain experience and the wider business toolkit, including the Full-only features described
          below.
        </li>
      </ul>
      <p>
        Feature lists and fees on our <a href="/pricing">pricing page</a> form part of these Terms by reference.
        KERSIVO takes <strong>0% KERSIVO commission / platform / application fee</strong> on new booking payments in
        both Starter and Full. <strong>Standard Stripe payment-processing fees still apply</strong> under the
        barbershop&rsquo;s agreement with Stripe where online card payments are enabled.
      </p>

      <h2 id="website">Full KERSIVO website and domain</h2>
      <p>{STANDARD_SITE_SCOPE_CLAIM}</p>
      <p>{STANDARD_SITE_NOT_BESPOKE_CLAIM}</p>
      <p>{POWERED_BY_KERSIVO_CLAIM}</p>

      <h2 id="website-update-support">Website update support</h2>
      <p>{WEBSITE_UPDATE_SUPPORT_CLAIM}</p>

      <h2>Admin access</h2>
      <p>
        When you sign in to the barbershop admin panel, we use necessary first-party session cookies so you can stay
        signed in for your convenience and security (typically for up to 30 days). Details are set out in our
        <a href="/cookies">Cookie Policy</a> and <a href="/privacy">Privacy Policy</a>.
      </p>

      <h2 id="fees">Fees and payment</h2>
      <p>
        <strong>KERSIVO Starter is £0/month.</strong> It does not create a KERSIVO SaaS subscription charge.
        <strong>Full KERSIVO is £{SAAS_MONTHLY_GBP}/month per physical barbershop location.</strong>
        {NO_SETUP_FEE_CLAIM} For Full KERSIVO, {BILLING_CYCLE_CLAIM} Subscription billing runs via Stripe unless we
        agree otherwise in writing.
      </p>
      <p>
        <strong>{PRICE_VAT_DISCLAIMER}</strong>
      </p>
      <p>For Full KERSIVO: {PLAN_SCOPE_CLAIM}</p>
      <p>{INCLUDED_SETUP_CLAIM}</p>
      <p>{OWNER_SELF_CONFIG_CLAIM}</p>
      <p>{PRICE_CHANGE_NOTICE_CLAIM}</p>

      <h2 id="refunds">Refunds</h2>
      <p>{REFUND_CLAIM}</p>

      <h2 id="starter">KERSIVO Starter</h2>
      <p>
        KERSIVO Starter is a genuine <strong>£0/month</strong> service level for one physical barbershop location. It is
        not a time-limited trial and KERSIVO adds <strong>0% commission / platform / application fee</strong> to new
        booking payments. Starter may be used in Pay at shop mode without connecting Stripe.
      </p>
      <p>Starter includes, subject to reasonable fair use:</p>
      <ul>
        <li>a KERSIVO-hosted booking page;</li>
        <li>bookings, team, services and availability;</li>
        <li>up to <strong>4 active bookable barbers</strong> at the location;</li>
        <li>manual bookings;</li>
        <li>a rolling <strong>90-day</strong> view of past booking history plus current and future bookings;</li>
        <li><strong>Clients Core</strong>, rather than the Full advanced CRM layer;</li>
        <li>automated email reminders;</li>
        <li>a visible but <strong>OFFLINE</strong> KERSIVO Assistant with no live AI processing;</li>
        <li>guided Google Business Profile booking-link setup; and</li>
        <li>eligibility to request one initial physical QR Kit for an eligible verified UK location under the QR Kit terms below.</li>
      </ul>
      <p>
        Starter does not include the Full branded website / own-domain service, more than 4 active bookable barbers,
        full historical booking archive, Advanced Clients, Reports, Retail / Products / Orders / Sales, SMS reminders
        or the live KERSIVO Assistant.
      </p>

      <h2 id="subscription">Full KERSIVO monthly subscription</h2>
      <p>
        Full KERSIVO is <strong>£{SAAS_MONTHLY_GBP}/month</strong> per physical location, unless we agree a different
        rate in writing (for example for larger networks). There is <strong>no minimum term</strong> and
        <strong>no notice period</strong> to cancel. {NO_PAUSE_CLAIM}
      </p>
      <p>While the Full subscription is active, it includes:</p>
      <ul>
        {PLAN_SCOPE_FULL_LIST.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p>
        You configure day-to-day shop details yourself in the admin dashboard (barbers, services, prices, working hours,
        retail products and basic shop details such as name, town/city and logo).
      </p>
      <p>{SMS_MONTHLY_ALLOWANCE_TERMS}</p>

      <h2 id="fair-use">Limits and fair use</h2>
      <p>{FAIR_USE_INTRO}</p>
      <p>For Full KERSIVO, within one location and subject to fair use, the Full plan covers unlimited:</p>
      <ul>
        {FAIR_USE_UNLIMITED_LIST.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p>Reasonable fair use applies. Fair use does not allow:</p>
      <ul>
        {FAIR_USE_PROHIBITED_LIST.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p>{FAIR_USE_ORDINARY_BREACH_CLAIM}</p>
      <p>{FAIR_USE_IMMEDIATE_RESTRICTION_CLAIM}</p>
      <p>Immediate restriction may follow:</p>
      <ul>
        {FAIR_USE_IMMEDIATE_TRIGGERS.map((item) => (
          <li>{item}</li>
        ))}
      </ul>

      <h2>Changing or ending KERSIVO service</h2>
      <p>
        Ending a Full subscription does <strong>not</strong> automatically mean leaving KERSIVO. When Full KERSIVO is
        scheduled to end, the Owner may explicitly choose to continue on KERSIVO Starter. Full remains active until the
        end of the already-paid period; after that, Full-only website/domain and premium modules cease and the shop
        continues at the Starter entitlement. If more than 4 barbers are actively bookable, the Owner must choose which
        maximum 4 remain bookable on Starter; KERSIVO does not choose for you.
      </p>
      <p>
        If the Owner chooses <strong>Leave KERSIVO</strong>, or Full ends without an explicit Starter choice, the shop
        enters KERSIVO&rsquo;s departure / wind-down lifecycle. New public bookings stop. Existing future accepted
        appointments are not silently deleted; where they remain, limited operational access may continue so they can
        be handled safely before the shop enters post-service retention.
      </p>
      <p>
        A pure Starter shop may also use the Owner-only <strong>Leave KERSIVO</strong> flow. Complete departure from
        KERSIVO — not merely the end of Full — is the event that starts the standard post-service export / retention
        lifecycle.
      </p>

      <h2 id="failed-payments">Failed or overdue payments</h2>
      <p>{FAILED_PAYMENT_CLAIM}</p>

      <h2 id="domain">Domain name</h2>
      <p>{DOMAIN_INCLUDED_CLAIM}</p>
      <p>{DOMAIN_NEW_CLAIM}</p>
      <p>
        Where KERSIVO registers a domain for you, you must confirm authorisation (collected in the post-purchase
        KERSIVO client onboarding), including agreement to:
      </p>
      <blockquote>
        <p>{DOMAIN_AUTH_TEXT}</p>
      </blockquote>
      <p>{DOMAIN_EXISTING_CLAIM}</p>
      <p>{DOMAIN_LIMIT_CLAIM}</p>
      <p>
        The KERSIVO platform software is <strong>not</strong> transferred with the domain when the engagement ends.
      </p>

      <h2 id="onboarding-and-launch">Onboarding, preparation and launch</h2>
      <p>{ONBOARDING_MATERIALS_CLAIM}</p>
      <p>{ONBOARDING_BILLING_INDEPENDENT_CLAIM}</p>
      <p>{ONBOARDING_TIMELINE_CLAIM}</p>
      <p>{PREVIEW_LAUNCH_CLAIM}</p>

      <h2 id="missing-materials">Missing materials</h2>
      <p>{MISSING_OPTIONAL_MATERIALS_CLAIM}</p>
      <p>{MISSING_CRITICAL_MATERIALS_CLAIM}</p>
      <p>{NO_FAKE_STOCK_CLAIM}</p>

      <h2>Stripe, booking payments and retail</h2>
      <p>
        Where online card payments are enabled, live booking payments use the barbershop&rsquo;s
        <strong>connected Stripe account</strong> under a direct-charge model and the barbershop remains the merchant /
        seller of record for its services. New public Stripe connections are onboarded using Stripe Standard; historical
        Express connections may remain supported where already established. KERSIVO does not store full card numbers or
        CVC and adds <strong>0% application / platform fee</strong> to new Starter and Full booking payments.
        Standard Stripe processing fees are charged separately by Stripe under the barbershop&rsquo;s Stripe terms.
      </p>
      <p>
        KERSIVO may separately receive compensation or revenue share from Stripe under Stripe&rsquo;s own partner
        arrangements if KERSIVO qualifies. Any such Stripe-paid compensation is not a commission or fee deducted by
        KERSIVO from the barbershop&rsquo;s booking payment, and KERSIVO does not promise a particular revenue-share rate.
      </p>
      <p>
        Retail / Products / Orders / Sales are Full KERSIVO features. The public <strong>/shop</strong> retail demo is a
        <strong>simulation only</strong>: no payment is taken, no Stripe Checkout session is created, and no order is
        stored. Private owner shop tests in the admin may create <strong>marked test orders</strong> without payment.
        You remain responsible for accurate pricing, product descriptions, taxes, returns and pickup-only fulfilment
        unless we agree otherwise in writing.
      </p>

      <h2>Data ownership, export, and leaving</h2>
      <p>
        You own your domain, brand, content, client relationship and exported business data. KERSIVO does not sell your
        client data.
      </p>
      <p>{DATA_EXPORT_RETENTION_CLAIM}</p>
      <p>
        Leaving KERSIVO completely shuts down new public booking intake for the location. Existing future accepted
        appointments are preserved for safe wind-down rather than silently deleted. Existing dynamic KERSIVO QR codes
        are not reassigned to another business and stop leading to an active new-booking flow while the shop is leaving.
        If you previously added the KERSIVO booking URL to Google Business Profile, you are responsible for removing or
        replacing that merchant-managed link. KERSIVO does not claim to edit Google automatically.
      </p>
      <p>
        Your Stripe account remains yours and KERSIVO does not close it merely because you leave KERSIVO. Historical
        payment, refund and connected-account identifiers may be retained where needed for reconciliation, accounting,
        legal obligations or disputes. How we handle personal data (including your clients&rsquo; data) is described in
        our <a href="/privacy">Privacy Policy</a>.
      </p>

      <h2 id="qr-kit">Starter QR Kit</h2>
      <p>
        One initial physical KERSIVO QR Kit may be requested for an eligible verified UK physical location using
        KERSIVO Starter. The kit is subject to shop-detail verification before print, has no cash alternative, and
        dispatch or delivery timing is not guaranteed unless KERSIVO expressly states otherwise in writing.
        Replacement or reorder kits may be subject to a separate policy or charge.
      </p>
      <p>
        The kit uses KERSIVO-controlled dynamic QR identifiers. Those physical QR codes may continue to exist across
        plan changes, but their booking destination is resolved according to the shop&rsquo;s current KERSIVO service
        state. Leaving KERSIVO stops those QR codes from leading to an active new-booking flow.
      </p>

      <h2 id="google-booking">Google Business Profile booking link</h2>
      <p>
        KERSIVO provides guided setup and the current booking URL that the Client may add to its Google Business
        Profile. This is a merchant-managed link: the Client remains responsible for adding, updating or removing it in
        Google. Google controls profile eligibility, display and placement of booking actions, and KERSIVO does not
        guarantee that Google will show a particular Book button or placement.
      </p>

      <h2 id="dpa">Data Processing Agreement</h2>
      <p>
        When {TRADING_NAME} processes Customer Personal Data on the Client&rsquo;s behalf, the
        <a href="/dpa">Data Processing Agreement</a> at <a href="/dpa">/dpa</a> forms part of these Terms and governs
        that processing. For that Customer Personal Data, the <strong>Client is the Controller</strong> and
        {LEGAL_OPERATOR_NAME}, trading as {TRADING_NAME}, is the <strong>Processor</strong>.
      </p>
      <p>
        {TRADING_NAME} may separately act as an independent Controller for its own business, account, billing, security,
        support, legal, tax, marketing and operational processing, as described in the
        <a href="/privacy">Privacy Policy</a>. That independent-controller processing is outside the DPA.
      </p>

      <h2>Your content and intellectual property</h2>
      <p>
        You retain ownership of your branding, text, images, and other materials you supply. You grant us a licence to
        host, display, and use them solely to deliver the project and run the service for you.
      </p>
      <p>
        KERSIVO owns the source code, platform, admin software, retail software and infrastructure. Your active
        KERSIVO service level gives you a <strong>licence</strong> to use the applicable platform features while that
        service is active; it does <strong>not</strong> transfer ownership of the underlying software to you.
      </p>

      <h2>Acceptable use</h2>
      <p>
        You will not use the service for unlawful activity, to infringe others&rsquo; rights, or to transmit malware. You
        are responsible for the accuracy of opening hours, services, and product information shown to the public.
      </p>

      <h2>Availability and support</h2>
      <p>
        We aim to keep the service reasonably available but do not guarantee uninterrupted access.
        {' '}{SUPPORT_RESPONSE_CLAIM}
      </p>

      <h2>Limitation of liability</h2>
      <p>
        To the maximum extent permitted by applicable law, we are not liable for indirect or consequential loss, loss of
        profit, or loss of data, except where such exclusion is not allowed by law. To the maximum extent permitted by
        law, our total aggregate liability arising out of or in connection with the Services in any twelve-month period
        will not exceed the greater of <strong>(a) £1,000</strong> or <strong>(b) the total fees paid by the Client to
        KERSIVO for the Services during the twelve months preceding the event giving rise to the claim</strong>.
        Stripe processing fees paid to Stripe and any compensation paid by Stripe to KERSIVO are not fees paid by the
        Client to KERSIVO for this purpose. This cap does not apply to death or personal injury caused by negligence,
        fraud, fraudulent misrepresentation, or any other liability that cannot lawfully be excluded or limited.
        Nothing in these Terms is intended to exclude or restrict rights that cannot lawfully be excluded.
      </p>

      <h2>Force majeure</h2>
      <p>
        We are not liable for delay or failure caused by events outside our reasonable control (for example outages of
        major cloud providers, strikes, or natural disasters).
      </p>

      <h2>Governing law and disputes</h2>
      <p>
        These Terms are governed by the law of England and Wales. Any dispute arising out of or in connection with
        these Terms that cannot be resolved by negotiation will be subject to the exclusive jurisdiction of the
        courts of England and Wales.
      </p>

      <h2>Changes to these Terms</h2>
      <p>
        We may update these Terms. We will post the new version on this page and change the &ldquo;Last updated&rdquo;
        date. For active clients, material changes may also be communicated by email or through the admin where
        appropriate.
      </p>
    </article>
  </main>
  <LegalFooter />
</MainLayout>
