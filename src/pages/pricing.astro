---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Footer50 from '@/components/footer50.astro';
import Contact16 from '@/components/contact16.astro';
import EditorialIntro from '@/components/editorial/EditorialIntro.astro';
import FullPlanCta from '@/components/cta/FullPlanCta.astro';
import PricingCompareTable from '@/components/pricing/PricingCompareTable.astro';
import PricingPlans from '@/components/pricing/PricingPlans.astro';
import PricingFees from '@/components/pricing/PricingFees.astro';
import PricingFaq from '@/components/pricing/PricingFaq.astro';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import { getRateCard1LandingLayout } from '@/lib/pricing/rateCard1Copy';
import {
  PRICING_PAGE_DESCRIPTION,
  PRICING_PAGE_H1,
  PRICING_PAGE_LAST_UPDATED_ISO,
  PRICING_PAGE_LAST_UPDATED_LABEL,
  PRICING_PAGE_PATH,
  PRICING_PAGE_TITLE,
  PRICING_QUICK_ANSWER,
  PRICING_QUICK_FACTS,
  buildPricingBreadcrumbJsonLd,
  buildPricingFaqJsonLd,
  buildPricingWebPageJsonLd,
} from '@/lib/seo/pricingPage';
import { buildKersivoEntityJsonLd } from '@/lib/seo/kersivoEntityJsonLd';
import PageBreadcrumbs from '@/components/seo/PageBreadcrumbs.astro';
import { PRICING_BREADCRUMBS } from '@/lib/seo/breadcrumbs';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import {
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';
import '@/styles/components/fresha-alternative.css';
import '@/styles/components/company-pages.css';
import '@/styles/components/landingFinalCta.css';

// FREE_PREVIEW_FLOW_ENABLED (docs/free-preview-spec.md §10.4); off renders the page unchanged.
const freePreview = isFreePreviewFlowEnabled();
const layout = getRateCard1LandingLayout(freePreview);
const currentYear = new Date().getFullYear();
---

<LandingLayout
  title={PRICING_PAGE_TITLE}
  description={PRICING_PAGE_DESCRIPTION}
  canonicalPath={PRICING_PAGE_PATH}
  jsonLd={[buildKersivoEntityJsonLd(), buildPricingWebPageJsonLd(), buildPricingBreadcrumbJsonLd(), buildPricingFaqJsonLd(freePreview)]}
>
  <main class="fresha-alt landing-overflow-guard">
    <section class="fresha-alt-hero company-hero" aria-labelledby="pricing-hero-title">
      <div class="fresha-alt-hero__content">
        <PageBreadcrumbs trail={PRICING_BREADCRUMBS} />
        <p class="fresha-alt-hero__eyebrow">
          <span class="fresha-alt-hero__eyebrow-dot" aria-hidden="true"></span>
          KERSIVO pricing
        </p>
        <h1 id="pricing-hero-title" class="fresha-alt-hero__title">
          <span class="fresha-alt-hero__title-line fresha-alt-hero__title-line--primary">
            {PRICING_PAGE_H1}
          </span>
        </h1>
        <p class="fresha-alt-hero__lead">
          Full KERSIVO is £{SAAS_MONTHLY_GBP}/month per location — your branded website, own domain, online booking with payment control, clients, reports and retail pickup. KERSIVO Starter is £0/month for shops that only need online bookings. 0% KERSIVO commission on both; Stripe fees apply.
        </p>
        {freePreview ? (
          <>
            <div class="fresha-alt-hero__actions">
              <FullPlanCta
                part="primary"
                primaryClass="fresha-alt-hero__action fresha-alt-hero__action--primary"
                placement="pricing_hero"
              />
              <a href="#plan" class="btn btn--outline btn--lg fresha-alt-hero__action fresha-alt-hero__action--secondary">
                Compare the two plans
              </a>
            </div>
            <FullPlanCta part="subscribe" placement="pricing_hero" />
          </>
        ) : (
        <div class="fresha-alt-hero__actions">
          <a
            href="/admin/launch"
            class="btn btn--primary btn--lg fresha-alt-hero__action fresha-alt-hero__action--primary"
            data-track="saas_subscribe_click"
            data-track-placement="pricing_hero"
          >
            Start Full KERSIVO — £{SAAS_MONTHLY_GBP}/month
          </a>
          <a href="#plan" class="btn btn--outline btn--lg fresha-alt-hero__action fresha-alt-hero__action--secondary">
            Compare the two plans
          </a>
        </div>
        )}
        <p class="company-hero__updated">
          Or <a href="/demo">see the demo</a> first.
        </p>
        <p class="company-hero__updated">
          Last updated <time datetime={PRICING_PAGE_LAST_UPDATED_ISO}>{PRICING_PAGE_LAST_UPDATED_LABEL}</time>
        </p>
      </div>
    </section>

    <EditorialIntro
      id="quick-answer"
      titleId="pricing-quick-title"
      class="fresha-alt-quick"
      kicker="QUICK ANSWER"
      title="How much does KERSIVO cost?"
      lead={PRICING_QUICK_ANSWER}
      facts={PRICING_QUICK_FACTS}
    />

    <PricingPlans freePreview={freePreview} />

    <PricingCompareTable freePreview={freePreview} />

    <PricingFees />

    <PricingFaq freePreview={freePreview} />

    <section class="landing-final-cta fresha-alt-final" aria-labelledby="pricing-final-title">
      <div class="container">
        <div class="landing-final-cta__panel">
          <div class="landing-final-cta__content">
            <p class="landing-final-cta__eyebrow">OWN YOUR BRAND. OWN YOUR BOOKINGS.</p>
            <h2 id="pricing-final-title" class="landing-final-cta__heading">
              See what KERSIVO can do for your barbershop
            </h2>
            <p class="landing-final-cta__subheadline">
              Full KERSIVO gives your shop its own website, domain and booking system for £{SAAS_MONTHLY_GBP}/month per location. Only need online bookings? Start on Starter for £0/month.
            </p>
          </div>
          <div class="landing-final-cta__conversion">
            <div class="fresha-alt-final__actions">
              {freePreview ? (
                <FullPlanCta part="primary" primaryClass="btn btn--primary btn--lg landing-final-cta__button" />
              ) : (
              <a
                href="/admin/launch"
                class="btn btn--primary btn--lg landing-final-cta__button"
                data-track="saas_subscribe_click"
              >
                {layout.ctaLabel}
              </a>
              )}
              <a
                href="/admin"
                class="btn btn--outline btn--lg landing-final-cta__button"
                data-track="starter_signup_click"
                data-track-placement="pricing_final"
              >
                Start KERSIVO Starter
              </a>
              <a href="/demo" class="company-link">See the demo</a>
            </div>
            {freePreview && <FullPlanCta part="subscribe" class="pricing-final-subscribe" />}
          </div>
        </div>
      </div>
    </section>

    <Contact16
      eyebrow="CONTACT KERSIVO"
      title="Have a pricing question?"
      description="Tell us about your barbershop and what you use today. We’ll reply with a clear, practical answer."
      note="We’ll reply by email — no sales call required."
      submitLabel="Send my question"
    />

    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      social={getFooterSocialLinks()}
    />
  </main>
</LandingLayout>

<style is:global>
  .landing-overflow-guard {
    overflow-x: clip;
  }

  .pricing-final-subscribe {
    margin-top: 1rem;
    text-align: center;
  }
</style>
