---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Faq4 from '@/components/faq4.astro';
import Footer50 from '@/components/footer50.astro';
import Contact16 from '@/components/contact16.astro';
import EditorialIntro from '@/components/editorial/EditorialIntro.astro';
import { RateCard1Offer } from '@/components/rateCard1';
import { getRateCard1LandingLayout } from '@/lib/pricing/rateCard1Copy';
import {
  PRICING_FAQ_ITEMS,
  PRICING_FEES_POINTS,
  PRICING_INCLUDED_GROUPS,
  PRICING_PAGE_DESCRIPTION,
  PRICING_PAGE_H1,
  PRICING_PAGE_LAST_UPDATED_ISO,
  PRICING_PAGE_LAST_UPDATED_LABEL,
  PRICING_PAGE_PATH,
  PRICING_PAGE_TITLE,
  PRICING_QUICK_ANSWER,
  PRICING_QUICK_FACTS,
  buildPricingFaqJsonLd,
  buildPricingWebPageJsonLd,
} from '@/lib/seo/pricingPage';
import { buildKersivoEntityJsonLd } from '@/lib/seo/kersivoEntityJsonLd';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import {
  FOOTER_LEGAL_LINKS,
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';
import '@/styles/rateCard1.css';
import '@/styles/components/fresha-alternative.css';
import '@/styles/components/company-pages.css';
import '@/styles/components/landingFinalCta.css';

const layout = getRateCard1LandingLayout();
const currentYear = new Date().getFullYear();
---

<LandingLayout
  title={PRICING_PAGE_TITLE}
  description={PRICING_PAGE_DESCRIPTION}
  canonicalPath={PRICING_PAGE_PATH}
  jsonLd={[buildKersivoEntityJsonLd(), buildPricingWebPageJsonLd(), buildPricingFaqJsonLd()]}
>
  <main class="fresha-alt landing-overflow-guard">
    <section class="fresha-alt-hero company-hero" aria-labelledby="pricing-hero-title">
      <div class="fresha-alt-hero__content">
        <p class="fresha-alt-hero__eyebrow">
          <span class="fresha-alt-hero__eyebrow-dot" aria-hidden="true"></span>
          KERSIVO pricing
        </p>
        <h1 id="pricing-hero-title" class="fresha-alt-hero__title">
          <span class="fresha-alt-hero__title-line fresha-alt-hero__title-line--primary">
            {PRICING_PAGE_H1}
          </span>
        </h1>
        <p class="fresha-alt-hero__lead">
          Two plans for one barbershop location. Starter gives you a payment-powered booking
          system for £0/month. Full KERSIVO is £{SAAS_MONTHLY_GBP}/month per location and adds your
          branded website, own domain, wider business toolkit and control over how customers pay.
          0% KERSIVO commission on both.
        </p>
        <div class="fresha-alt-hero__actions">
          <a
            href="/demo"
            class="fresha-alt-hero__action fresha-alt-hero__action--primary"
            data-track="view_live_demo_click"
          >
            See KERSIVO in action
          </a>
          <a href="#plan" class="fresha-alt-hero__action fresha-alt-hero__action--secondary">
            Compare Starter and Full
          </a>
        </div>
        <p class="company-hero__updated">
          Last updated <time datetime={PRICING_PAGE_LAST_UPDATED_ISO}>{PRICING_PAGE_LAST_UPDATED_LABEL}</time>
        </p>
      </div>
    </section>

    <EditorialIntro
      id="quick-answer"
      titleId="pricing-quick-title"
      class="fresha-alt-quick"
      kicker="QUICK ANSWER"
      title="How much does KERSIVO cost?"
      lead={PRICING_QUICK_ANSWER}
      facts={PRICING_QUICK_FACTS}
    />

    <section id="included" class="fresha-alt__section" aria-labelledby="pricing-included-title">
      <div class="container">
        <header class="fresha-alt__intro">
          <p class="fresha-alt__eyebrow">WHAT’S INCLUDED</p>
          <h2 id="pricing-included-title" class="fresha-alt__h2">
            What each plan includes
          </h2>
        </header>
        <ul class="company-groups">
          {
            PRICING_INCLUDED_GROUPS.map((group) => (
              <li class="company-group">
                <h3 class="company-group__title">{group.title}</h3>
                <ul class="company-checks">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="plan" class="fresha-alt__section scroll-mt-24" aria-labelledby="pricing-plan-title">
      <div class="fresha-alt__glow" aria-hidden="true"></div>
      <div class="container">
        <header class="fresha-alt__intro">
          <p class="fresha-alt__eyebrow">TWO PLANS</p>
          <h2 id="pricing-plan-title" class="fresha-alt__h2">
            Start on Starter. Move to Full when you want the complete brand.
          </h2>
        </header>
        <article class="pricing-starter-offer" aria-labelledby="pricing-starter-title">
          <div class="pricing-starter-offer__head">
            <p class="pricing-starter-offer__label">KERSIVO STARTER</p>
            <h3 id="pricing-starter-title" class="pricing-starter-offer__price">
              £0<span>/month</span>
            </h3>
            <p class="pricing-starter-offer__lead">
              A real booking system for one shop: hosted booking page, up to 4 active bookable
              barbers, Clients Core and email reminders. Public bookings use a £5 deposit or Pay in
              full through your connected Stripe account. 0% KERSIVO commission.
            </p>
          </div>
          <div class="pricing-starter-offer__actions">
            <a
              href="/admin"
              class="btn btn--primary"
              data-track="starter_signup_click"
              data-track-placement="pricing_plans"
            >
              Start KERSIVO Starter
            </a>
            <a href="/starter" class="company-link">What’s in KERSIVO Starter →</a>
          </div>
        </article>
        <p class="fresha-alt__eyebrow pricing-full-offer__label">FULL KERSIVO</p>
        <div class="rate-card1--landing fresha-alt-pricing__offer-host">
          <RateCard1Offer />
          <div class="rate-card1__landing-conditions">
            <p>{layout.conditionsLine1}</p>
            <p>{layout.conditionsLine2}</p>
          </div>
        </div>
      </div>
    </section>

    <section id="fees" class="fresha-alt__section" aria-labelledby="pricing-fees-title">
      <div class="container">
        <header class="fresha-alt__intro">
          <p class="fresha-alt__eyebrow">FEES AND BILLING</p>
          <h2 id="pricing-fees-title" class="fresha-alt__h2">What you pay, and what you don’t</h2>
        </header>
        <ul class="company-checks company-checks--columns">
          {PRICING_FEES_POINTS.map((point) => <li>{point}</li>)}
        </ul>
        <p class="company-note">
          Looking for the £0 entry plan? <a href="/starter" class="company-link">Explore KERSIVO Starter</a>.
          Comparing platforms? See how KERSIVO compares with
          <a href="/booksy-alternative" class="company-link">Booksy</a> and
          <a href="/fresha-alternative" class="company-link">Fresha</a>.
        </p>
      </div>
    </section>

    <Faq4
      className="faq4--landing"
      heading="Questions about KERSIVO pricing?"
      subHeading="Clear answers on Starter and Full KERSIVO, fees, VAT, SMS reminders and cancelling."
      supportHeading="Still have a question?"
      supportText="Tell us about your barbershop and we’ll give you a clear answer."
      supportLinkLabel="Ask a question"
      supportLinkHref="#contact"
      faqs={PRICING_FAQ_ITEMS}
    />

    <section class="landing-final-cta fresha-alt-final" aria-labelledby="pricing-final-title">
      <div class="container">
        <div class="landing-final-cta__panel">
          <div class="landing-final-cta__content">
            <p class="landing-final-cta__eyebrow">OWN YOUR BRAND. OWN YOUR BOOKINGS.</p>
            <h2 id="pricing-final-title" class="landing-final-cta__heading">
              See what KERSIVO can do for your barbershop
            </h2>
            <p class="landing-final-cta__subheadline">
              Start on KERSIVO Starter for £0/month, or go straight to Full KERSIVO for
              £{SAAS_MONTHLY_GBP}/month when you want your own website, domain and payment control.
              The live demo shows the wider KERSIVO experience before you decide.
            </p>
          </div>
          <div class="landing-final-cta__conversion">
            <div class="fresha-alt-final__actions">
              <a
                href="/demo"
                class="btn btn--primary btn--lg landing-final-cta__button"
                data-track="view_live_demo_click"
              >
                See KERSIVO in action
              </a>
              <a
                href="/admin"
                class="btn btn--secondary btn--lg landing-final-cta__button"
                data-track="starter_signup_click"
                data-track-placement="pricing_final"
              >
                Start KERSIVO Starter
              </a>
              <a
                href="/admin/launch"
                class="btn btn--secondary btn--lg landing-final-cta__button"
                data-track="saas_subscribe_click"
              >
                {layout.ctaLabel}
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Contact16
      eyebrow="CONTACT KERSIVO"
      title="Have a pricing question?"
      description="Tell us about your barbershop and what you use today. We’ll reply with a clear, practical answer."
      note="We’ll reply by email — no sales call required."
      submitLabel="Send my question"
    />

    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      navigation={[
        { name: 'Home', href: '/' },
        { name: 'KERSIVO Starter', href: '/starter' },
        { name: 'Live demo', href: '/demo' },
        { name: 'About', href: '/about' },
        { name: 'FAQ', href: '#faq' },
        { name: 'Contact', href: '#contact' },
        { name: 'Start Full KERSIVO', href: '/admin/launch' },
      ]}
      social={getFooterSocialLinks()}
      legal={[
        FOOTER_LEGAL_LINKS.privacy,
        FOOTER_LEGAL_LINKS.cookies,
        FOOTER_LEGAL_LINKS.cookieSettings,
        FOOTER_LEGAL_LINKS.dpa,
        FOOTER_LEGAL_LINKS.termsAndCancellation,
      ]}
    />
  </main>
</LandingLayout>

<style is:global>
  .landing-overflow-guard {
    overflow-x: clip;
  }

  .pricing-starter-offer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem 2rem;
    align-items: center;
    margin: 0 auto 2.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 1.15rem;
    background: color-mix(in srgb, var(--fg) 4%, transparent);
  }

  .pricing-starter-offer__label,
  .pricing-full-offer__label {
    margin: 0 0 0.6rem;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .pricing-full-offer__label {
    margin-bottom: 1rem;
  }

  .pricing-starter-offer__price {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .pricing-starter-offer__price span {
    margin-left: 0.3rem;
    font-size: 0.95rem;
    font-weight: 500;
    opacity: 0.7;
  }

  .pricing-starter-offer__lead {
    margin: 0.85rem 0 0;
    max-width: 44rem;
    line-height: 1.6;
    opacity: 0.82;
  }

  .pricing-starter-offer__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: stretch;
    text-align: center;
  }

  @media (max-width: 720px) {
    .pricing-starter-offer {
      grid-template-columns: 1fr;
    }
  }
</style>
