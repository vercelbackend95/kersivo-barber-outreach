---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Footer50 from '@/components/footer50.astro';
import Contact16 from '@/components/contact16.astro';
import FinalCta from '@/components/FinalCta.astro';
import PricingHero from '@/components/pricingPage/PricingHero.astro';
import PricingFit from '@/components/pricingPage/PricingFit.astro';
import PricingPlanCards from '@/components/pricingPage/PricingPlanCards.astro';
import PricingOutcomes from '@/components/pricingPage/PricingOutcomes.astro';
import PricingIncluded from '@/components/pricingPage/PricingIncluded.astro';
import PricingBill from '@/components/pricingPage/PricingBill.astro';
import PricingStart from '@/components/pricingPage/PricingStart.astro';
import PricingCompareLinks from '@/components/pricingPage/PricingCompareLinks.astro';
import PricingFaqList from '@/components/pricingPage/PricingFaqList.astro';
import PricingSticky from '@/components/pricingPage/PricingSticky.astro';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import {
  FREE_PREVIEW_CTA_HREF,
  FREE_PREVIEW_CTA_LABEL,
  FREE_PREVIEW_CTA_TRACK,
  SUBSCRIBE_NOW_CTA_HREF,
  SUBSCRIBE_NOW_CTA_LABEL,
  SUBSCRIBE_NOW_CTA_TRACK,
} from '@/lib/freePreview/fullPlanCta';
import { getRateCard1LandingLayout } from '@/lib/pricing/rateCard1Copy';
import {
  PRICING_PAGE_DESCRIPTION,
  PRICING_PAGE_PATH,
  PRICING_PAGE_TITLE,
  buildPricingBreadcrumbJsonLd,
  buildPricingFaqJsonLd,
  buildPricingWebPageJsonLd,
} from '@/lib/seo/pricingPage';
import { buildKersivoEntityJsonLd } from '@/lib/seo/kersivoEntityJsonLd';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import {
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';
import '@/styles/components/pricing-page.css';

// FREE_PREVIEW_FLOW_ENABLED (docs/free-preview-spec.md §10.4); off keeps the direct subscribe CTAs.
const freePreview = isFreePreviewFlowEnabled();
const layout = getRateCard1LandingLayout(freePreview);
const currentYear = new Date().getFullYear();
---

<LandingLayout
  title={PRICING_PAGE_TITLE}
  description={PRICING_PAGE_DESCRIPTION}
  canonicalPath={PRICING_PAGE_PATH}
  jsonLd={[buildKersivoEntityJsonLd(), buildPricingWebPageJsonLd(), buildPricingBreadcrumbJsonLd(), buildPricingFaqJsonLd(freePreview)]}
>
  <main class="pr landing-overflow-guard">
    <PricingHero freePreview={freePreview} />
    <PricingFit freePreview={freePreview} />
    <PricingPlanCards freePreview={freePreview} />
    <PricingOutcomes />
    <PricingIncluded />
    <PricingBill />
    <PricingStart freePreview={freePreview} />
    <PricingCompareLinks />
    <PricingFaqList freePreview={freePreview} />

    <div data-pr-final>
      <FinalCta
        eyebrow="OWN YOUR BRAND. OWN YOUR BOOKINGS."
        heading="See what KERSIVO can do for your barbershop"
        headingId="pricing-final-title"
        text={`Full KERSIVO gives your shop its own website, domain and booking system for £${SAAS_MONTHLY_GBP}/month per location. Only need online bookings? Start on Starter for £0/month.`}
        primary={
          freePreview
            ? {
                href: FREE_PREVIEW_CTA_HREF,
                label: FREE_PREVIEW_CTA_LABEL,
                track: FREE_PREVIEW_CTA_TRACK,
                placement: 'pricing_final',
              }
            : {
                href: '/admin/launch',
                label: layout.ctaLabel,
                track: 'saas_subscribe_click',
                placement: 'pricing_final',
              }
        }
        secondary={{
          href: '/admin',
          label: 'Start KERSIVO Starter',
          track: 'starter_signup_click',
          placement: 'pricing_final',
        }}
        links={[
          { href: '/demo', label: 'See the demo' },
          ...(freePreview
            ? [
                {
                  href: SUBSCRIBE_NOW_CTA_HREF,
                  label: SUBSCRIBE_NOW_CTA_LABEL,
                  track: SUBSCRIBE_NOW_CTA_TRACK,
                },
              ]
            : []),
        ]}
      />
    </div>

    <Contact16
      eyebrow="CONTACT KERSIVO"
      title="Have a pricing question?"
      description="Tell us about your barbershop and what you use today. We’ll reply with a clear, practical answer."
      note="We’ll reply by email — no sales call required."
      submitLabel="Send my question"
    />

    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      social={getFooterSocialLinks()}
    />

    <PricingSticky freePreview={freePreview} />
  </main>
</LandingLayout>

<script>
  import { initPricingPage } from '@/lib/landing/pricingPage';

  let cleanup: (() => void) | null = null;
  const boot = () => {
    const root = document.querySelector<HTMLElement>('main.pr');
    if (!root || root.dataset.prBound === 'true') return;
    root.dataset.prBound = 'true';
    cleanup = initPricingPage(root);
  };

  boot();
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style is:global>
  .landing-overflow-guard {
    overflow-x: clip;
  }
</style>
