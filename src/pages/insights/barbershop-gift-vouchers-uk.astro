---
import InsightsArticleLayout from '@/layouts/InsightsArticleLayout.astro';
import { Content as VoucherArticle } from '../../../editorial-staging/insights/barbershop-gift-vouchers-uk-display.md';
import { INSIGHTS_GIFT_VOUCHERS as article } from '@/lib/seo/insights';
---
<InsightsArticleLayout
  title={article.seoTitle}
  description={article.description}
  slug={article.slug}
  category={article.category}
  dateLabel="17 October 2026"
  sourceUrl={article.notionUrl}
  headline={article.headline}
  heroImage={article.heroImage}
  coverImage={article.heroImage}
  coverImageAlt="Original editorial illustration of a fictional thirty-pound barbershop gift voucher"
  verifiedDate={article.verifiedDate}
  publishedDate={article.publishedDate}
  published={true}
>
  <VoucherArticle />
</InsightsArticleLayout>
