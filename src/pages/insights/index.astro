---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Footer50 from '@/components/footer50.astro';
import InsightsMasthead from '@/components/insights/InsightsMasthead.astro';
import '@/styles/components/insights-preview.css';
const articlePath = '/insights/google-reviews-barbershop-uk-rules';
---

<LandingLayout
  title="KERSIVO Insights | The Business Behind the Chair"
  description="Useful thinking for UK barbershop owners: branding, customer relationships, bookings and the business behind the chair."
  canonicalPath="/insights"
  noindex={true}
>
  <main class="insights-page">
    <InsightsMasthead page="index" />
    <section class="insights-index" aria-labelledby="insights-featured">
      <div class="insights-index__inner">
        <h2 class="insights-index__label" id="insights-featured">FEATURED READING</h2>
        <a href={articlePath} class="insights-index__feature">
          <div>
            <p class="insights-article-meta__category" style="color:#982431; font-size:.72rem; letter-spacing:.13em; margin-bottom:1rem">BRAND &amp; MARKETING</p>
            <h3 class="insights-index__title">Google Reviews for Barbershops: Two Rulebooks, One Habit</h3>
            <p class="insights-index__summary">What UK consumer law and Google's review policies actually mean for a barbershop asking clients for feedback.</p>
            <span class="insights-index__read">READ THE ARTICLE <span aria-hidden="true">↗</span></span>
          </div>
          <span class="insights-index__media">
            <img src="https://images.unsplash.com/photo-1768678218016-6bed23a35116?auto=format&amp;fit=crop&amp;fm=jpg&amp;ixid=NHwxMjA3fDA%3D&amp;ixlib=rb-4.1.0&amp;q=60&amp;w=3000" alt="Barbers working in a barbershop in Aldershot, UK" width="700" height="850" loading="eager" decoding="async" />
            <span class="insights-index__media-credit">BRUCE BARROW / UNSPLASH</span>
          </span>
        </a>
      </div>
    </section>
  </main>
  <Footer50 showIntro={false} navigation={[
    { name: 'KERSIVO', href: '/' },
    { name: 'About', href: '/about' },
    { name: 'Pricing', href: '/pricing' },
  ]} />
</LandingLayout>
