---
/**
 * Public KERSIVO Insights hub — magazine homepage.
 * Published article links only from the Insights registry.
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import Footer50 from '@/components/footer50.astro';
import InsightsEditorialMasthead from '@/components/insights/InsightsEditorialMasthead.astro';
import InsightsFeatureMosaic from '@/components/insights/InsightsFeatureMosaic.astro';
import InsightsTopicStrip from '@/components/insights/InsightsTopicStrip.astro';
import InsightsLatestThinking from '@/components/insights/InsightsLatestThinking.astro';
import InsightsOwnersDesk from '@/components/insights/InsightsOwnersDesk.astro';
import {
  INSIGHTS_HOME_FEATURE_DOMINANT,
  INSIGHTS_HOME_FEATURE_STACK,
  INSIGHTS_HOME_FEATURE_VERTICAL,
  INSIGHTS_HOME_LATEST,
  INSIGHTS_HOME_MASTHEAD,
  INSIGHTS_HOME_OWNERS_DESK,
  INSIGHTS_HOME_TOPICS,
} from '@/lib/insights/insightsHome';
import {
  INSIGHTS_INDEX_DESCRIPTION,
  INSIGHTS_INDEX_PATH,
  INSIGHTS_INDEX_TITLE,
  buildInsightsIndexJsonLd,
} from '@/lib/seo/insights';
import {
  FOOTER_LEGAL_LINKS,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';
import '@/styles/components/fonts-insights.css';
import '@/styles/components/insights-tokens.css';
import '@/styles/components/insights-gate1.css';

const currentYear = new Date().getFullYear();
---

<LandingLayout
  title={INSIGHTS_INDEX_TITLE}
  description={INSIGHTS_INDEX_DESCRIPTION}
  canonicalPath={INSIGHTS_INDEX_PATH}
  ogType="website"
  suppressMarketingFontPreloads
  jsonLd={buildInsightsIndexJsonLd()}
>
  <link
    slot="head"
    rel="preload"
    href="/fonts/newsreader-latin-700-normal.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link
    slot="head"
    rel="preload"
    href="/fonts/barlow-condensed-latin-800-normal.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />

  <main class="insights-shell landing-overflow-guard" id="insights-top">
    <div class="ins-frame ins-page">
      <InsightsEditorialMasthead
        mark={INSIGHTS_HOME_MASTHEAD.mark}
        headlineLines={INSIGHTS_HOME_MASTHEAD.headlineLines}
        lead={INSIGHTS_HOME_MASTHEAD.lead}
        statementLines={INSIGHTS_HOME_MASTHEAD.statementLines}
        audienceLines={INSIGHTS_HOME_MASTHEAD.audienceLines}
      />

      <InsightsFeatureMosaic
        dominant={{
          label: INSIGHTS_HOME_FEATURE_DOMINANT.label,
          titleLines: INSIGHTS_HOME_FEATURE_DOMINANT.titleLines,
          deck: INSIGHTS_HOME_FEATURE_DOMINANT.deck,
          cta: INSIGHTS_HOME_FEATURE_DOMINANT.cta,
          href: INSIGHTS_HOME_FEATURE_DOMINANT.href,
          imageSrc: INSIGHTS_HOME_FEATURE_DOMINANT.imageSrc,
          imageAlt: INSIGHTS_HOME_FEATURE_DOMINANT.imageAlt,
        }}
        vertical={{
          category: INSIGHTS_HOME_FEATURE_VERTICAL.category,
          coverLines: INSIGHTS_HOME_FEATURE_VERTICAL.coverLines,
          footer: INSIGHTS_HOME_FEATURE_VERTICAL.footer,
          imageSrc: INSIGHTS_HOME_FEATURE_VERTICAL.imageSrc,
          imageAlt: INSIGHTS_HOME_FEATURE_VERTICAL.imageAlt,
        }}
        stack={INSIGHTS_HOME_FEATURE_STACK}
      />

      <InsightsTopicStrip topics={INSIGHTS_HOME_TOPICS} />

      <InsightsLatestThinking items={INSIGHTS_HOME_LATEST} />

      <InsightsOwnersDesk
        eyebrow={INSIGHTS_HOME_OWNERS_DESK.eyebrow}
        heading={INSIGHTS_HOME_OWNERS_DESK.heading}
        lead={INSIGHTS_HOME_OWNERS_DESK.lead}
        tools={INSIGHTS_HOME_OWNERS_DESK.tools}
      />
    </div>

    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      copyright={`© ${currentYear} KERSIVO`}
      social={getFooterSocialLinks()}
      legal={[
        FOOTER_LEGAL_LINKS.privacy,
        FOOTER_LEGAL_LINKS.cookies,
        FOOTER_LEGAL_LINKS.cookieSettings,
        FOOTER_LEGAL_LINKS.dpa,
        FOOTER_LEGAL_LINKS.termsAndCancellation,
      ]}
    />
  </main>
</LandingLayout>

<style is:global>
  .landing-overflow-guard {
    overflow-x: clip;
  }
</style>
