---
import InsightsArticleLayout from '@/layouts/InsightsArticleLayout.astro';
import { Content as ReviewArticle } from '../../../editorial-staging/insights/google-reviews-barbershop-uk-rules-display.md';
import { INSIGHTS_GOOGLE_REVIEWS as article } from '@/lib/seo/insights';
---
<InsightsArticleLayout
  title={article.seoTitle}
  description={article.description}
  slug={article.slug}
  category={article.category}
  dateLabel="17 October 2026"
  sourceUrl={article.notionUrl}
  headline={article.headline}
  publishedDate={article.publishedDate}
  verifiedDate={article.verifiedDate}
  heroImage={article.heroImage}
  published={true}
>
  <ReviewArticle />
</InsightsArticleLayout>
