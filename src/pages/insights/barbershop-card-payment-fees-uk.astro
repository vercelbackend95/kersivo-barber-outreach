---
import InsightsArticleLayout from '@/layouts/InsightsArticleLayout.astro';
import { Content as CardFeesArticle } from '../../../editorial-staging/insights/barbershop-card-payment-fees-uk-display.md';
import { INSIGHTS_CARD_FEES as article } from '@/lib/seo/insights';
---
<InsightsArticleLayout
  title={article.seoTitle}
  description={article.description}
  slug={article.slug}
  category={article.category}
  dateLabel="17 October 2026"
  sourceUrl={article.notionUrl}
  headline={article.headline}
  heroImage={article.heroImage}
  coverImage={article.heroImage}
  coverImageAlt="Original KERSIVO Insights illustration of a 20p fixed card-processing fee"
  verifiedDate={article.verifiedDate}
  publishedDate={article.publishedDate}
  published={true}
>
  <CardFeesArticle />
</InsightsArticleLayout>
