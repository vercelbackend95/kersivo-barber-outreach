---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Faq4 from '@/components/faq4.astro';
import Footer50 from '@/components/footer50.astro';
import Contact16 from '@/components/contact16.astro';
import SquareHero from '@/components/squareAlternative/SquareHero.astro';
import SquareCompare from '@/components/squareAlternative/SquareCompare.astro';
import SquareProof from '@/components/squareAlternative/SquareProof.astro';
import SquarePricing from '@/components/squareAlternative/SquarePricing.astro';
import SquareFinalCta from '@/components/squareAlternative/SquareFinalCta.astro';
import SquareQuickAnswer from '@/components/squareAlternative/SquareQuickAnswer.astro';
import SquareWhy from '@/components/squareAlternative/SquareWhy.astro';
import SquareCosts from '@/components/squareAlternative/SquareCosts.astro';
import SquareFit from '@/components/squareAlternative/SquareFit.astro';
import SquareSwitching from '@/components/squareAlternative/SquareSwitching.astro';
import SquareSources from '@/components/squareAlternative/SquareSources.astro';
import {
  SQUARE_ALTERNATIVE_DESCRIPTION,
  SQUARE_ALTERNATIVE_FAQ_ITEMS,
  SQUARE_ALTERNATIVE_PAGE_PATH,
  SQUARE_ALTERNATIVE_TITLE,
  buildSquareAlternativeFaqJsonLd,
} from '@/lib/seo/squareAlternativeFaq';
import { buildSquareAlternativeWebPageJsonLd } from '@/lib/seo/squareAlternativeJsonLd';
import {
  FOOTER_LEGAL_LINKS,
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';
import '@/styles/components/fresha-alternative.css';

const currentYear = new Date().getFullYear();
---

<LandingLayout
  title={SQUARE_ALTERNATIVE_TITLE}
  description={SQUARE_ALTERNATIVE_DESCRIPTION}
  canonicalPath={SQUARE_ALTERNATIVE_PAGE_PATH}
  jsonLd={[buildSquareAlternativeWebPageJsonLd(), buildSquareAlternativeBreadcrumbJsonLd(), buildSquareAlternativeFaqJsonLd()]}
>
  <main class="fresha-alt landing-overflow-guard">
    <SquareHero />
    <SquareQuickAnswer />
    <SquareWhy />
    <SquareCosts />
    <SquareCompare />
    <SquareProof />
    <SquareFit />
    <SquareSwitching />
    <SquarePricing />

    <Faq4
      className="faq4--landing"
      heading="Questions about Square Appointments and KERSIVO?"
      subHeading="Answers on Square Free, Plus, Premium, card fees, deposits, websites and switching."
      supportHeading="Still comparing options?"
      supportText="Tell us what you use today and what you want your booking journey to look like."
      supportLinkLabel="Ask KERSIVO a question"
      supportLinkHref="#contact"
      faqs={SQUARE_ALTERNATIVE_FAQ_ITEMS}
    />

    <SquareFinalCta />

    <Contact16
      eyebrow="CONTACT KERSIVO"
      title="Still comparing KERSIVO and Square Appointments?"
      description="Tell us what you use today and what you want to change. We’ll reply with a clear, practical answer for your barbershop."
      note="We’ll reply by email — no sales call required."
      submitLabel="Send my question"
      messagePlaceholder="For example: Square Appointments plans, moving customer records or launching your own branded booking website."
    />

    <SquareSources />

    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      navigation={[
        { name: 'Home', href: '/' },
        { name: 'Live demo', href: '/demo' },
        { name: 'Pricing', href: '/pricing' },
        { name: 'FAQ', href: '#faq' },
        { name: 'About', href: '/about' },
        { name: 'Contact', href: '#contact' },
        { name: 'Start KERSIVO Starter', href: '/admin' },
      ]}
      social={getFooterSocialLinks()}
      legal={[
        FOOTER_LEGAL_LINKS.privacy,
        FOOTER_LEGAL_LINKS.cookies,
        FOOTER_LEGAL_LINKS.cookieSettings,
        FOOTER_LEGAL_LINKS.dpa,
        FOOTER_LEGAL_LINKS.termsAndCancellation,
      ]}
    />
  </main>
</LandingLayout>

<script>
  import { initFeature261StaggerReveal } from '@/lib/landing/initFeature261StaggerReveal';

  const scheduleInit = () => {
    requestAnimationFrame(() => {
      const section = document.querySelector('.feature261');
      if (!(section instanceof HTMLElement) || section.dataset.feature261Enhanced === 'true') return;
      const cleanup = initFeature261StaggerReveal(section);
      document.addEventListener('astro:before-swap', cleanup, { once: true });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleInit, { once: true });
  } else {
    scheduleInit();
  }
  document.addEventListener('astro:page-load', scheduleInit);
</script>

<script>
  import { destroyProductRails, initProductRails } from '@/lib/shop/initProductRail';

  const bootProductRails = () => {
    destroyProductRails();
    initProductRails();
  };

  bootProductRails();
  document.addEventListener('astro:page-load', bootProductRails);
</script>

<style is:global>
  .landing-overflow-guard {
    overflow-x: clip;
  }
</style>
