---
import MinimalLayout from '@/layouts/MinimalLayout.astro';
import { PAGE_DESCRIPTIONS } from '@/lib/seo/defaults';
import '@/styles/tokens.css';
import '@/styles/fonts-landing.css';
import '@/styles/global.css';
import '@/styles/components/buttons.css';
import '@/styles/components/setup-success.css';
---

<MinimalLayout
  title="Checkout cancelled — KERSIVO"
  description={PAGE_DESCRIPTIONS.setupCancel}
  canonicalPath="/setup/cancel"
  noindex={true}
  bodyClass="setup-success-body"
>
  <main class="setup-success">
    <div class="setup-success__card">
      <a class="setup-success__brand" href="/" aria-label="KERSIVO home">
        <img
          src="/images/brand/logo-navbar-228.webp"
          srcset="/images/brand/logo-navbar-228.webp 1x, /images/brand/logo-navbar-456.webp 2x"
          width="160"
          height="40"
          alt="KERSIVO"
        />
      </a>
      <h1 class="setup-success__title">Checkout cancelled</h1>
      <p class="setup-success__note">No payment was taken. You can try again from pricing or contact us.</p>
      <div class="setup-success__actions">
        <a href="/#pricing" class="btn btn--primary">Back to pricing</a>
        <a href="/#contact" class="btn btn--secondary">Contact us</a>
      </div>
    </div>
  </main>
</MinimalLayout>
