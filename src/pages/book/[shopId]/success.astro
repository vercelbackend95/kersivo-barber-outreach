---
import MinimalLayout from '@/layouts/MinimalLayout.astro';
import BookingConfirmationPanel from '@/components/booking/BookingConfirmationPanel';
import BookingThemeRoot from '@/components/booking/BookingThemeRoot';
import { prisma } from '@/lib/db/client';
import { retrieveBookingDepositSession } from '@/lib/shop/stripeConnect';
import { getCheckoutPaymentIntentId } from '@/lib/shop/stripe';
import { BOOKING_DEPOSIT_METADATA_TYPE } from '@/lib/booking/depositGate';
import { confirmPaidDeposit } from '@/lib/booking/confirmPaidDeposit';
import { formatInTimeZone } from 'date-fns-tz';
import '@/styles/tokens.css';
import '@/styles/fonts.css';
import '@/styles/global.css';
import '@/styles/components/buttons.css';
import '@/styles/components/booking.css';
import '@/styles/components/booking-flow.css';
import '@/styles/components/booking-mobile.css';

export const prerender = false;

const shopId = Astro.params.shopId?.trim() ?? '';
const sessionId = Astro.url.searchParams.get('session_id')?.trim() ?? '';

type ConfirmSummary = {
  service: string;
  barber: string;
  date: string;
  time: string;
};

let ok = false;
let errorMessage = 'Unable to confirm deposit payment.';
let summary: ConfirmSummary | null = null;
let shopTimezone = 'Europe/London';

if (shopId && sessionId) {
  try {
    const shopForConnect = await prisma.shopSettings.findUnique({
      where: { id: shopId },
      select: { name: true, timezone: true, stripeConnectAccountId: true },
    });
    const connectAccountId = shopForConnect?.stripeConnectAccountId?.trim();
    if (!connectAccountId) {
      errorMessage = 'This shop is not ready to confirm deposit payments.';
    } else {
      const session = await retrieveBookingDepositSession(sessionId, connectAccountId);
      const metadata = session.metadata ?? {};
      if (
        metadata.type === BOOKING_DEPOSIT_METADATA_TYPE &&
        metadata.shopId === shopId &&
        metadata.bookingId &&
        (session.payment_status ?? '').toLowerCase() === 'paid'
      ) {
        shopTimezone = shopForConnect?.timezone?.trim() || 'Europe/London';

        const result = await confirmPaidDeposit({
          bookingId: metadata.bookingId,
          shopId,
          sessionId,
          paymentIntentId: getCheckoutPaymentIntentId(session),
        });

        if (
          result.outcome === 'confirmed' ||
          result.outcome === 'duplicate' ||
          result.outcome === 'reinstated'
        ) {
          const confirmed = result.booking;
          const serviceName = confirmed.serviceNameAtBooking ?? confirmed.service.name;
          summary = {
            service: serviceName,
            barber: confirmed.barber.name,
            date: formatInTimeZone(confirmed.startAt, shopTimezone, 'EEE, d MMM yyyy'),
            time: formatInTimeZone(confirmed.startAt, shopTimezone, 'HH:mm'),
          };
          ok = true;
        } else if (result.outcome === 'late_refunded') {
          errorMessage =
            'Your payment was received, but this appointment slot was released after the payment window closed and is no longer available. Your deposit is being refunded to the original payment method.';
        } else if (result.outcome === 'not_found') {
          errorMessage = 'Booking not found for this payment.';
        } else {
          errorMessage =
            'Payment is already recorded for this booking. If you were charged twice, contact the barbershop.';
        }
      } else {
        errorMessage = 'Payment is not complete yet. If you were charged, contact the barbershop.';
      }
    }
  } catch {
    errorMessage = 'Payment confirmation failed. If you were charged, contact the barbershop.';
  }
} else {
  errorMessage = 'Missing payment session. Return from Stripe checkout and try again.';
}

const calendarHref =
  ok && shopId && sessionId
    ? `/book/${encodeURIComponent(shopId)}/calendar.ics?session_id=${encodeURIComponent(sessionId)}`
    : null;
---

<MinimalLayout
  title={ok ? 'Booking confirmed' : 'Booking payment'}
  description="Deposit confirmation"
  canonicalPath={shopId ? `/book/${shopId}/success` : '/book'}
  bodyClass="admin-theme-premium-black"
  showCookieConsent={false}
>
  <main class="container page-wrap booking-page-wrap">
    <BookingThemeRoot client:load preset="kersivo">
    <section class="surface booking-shell booking-flow booking-flow--wizard" aria-live="polite">
      <div class="booking-form-content">
        {
          ok && summary ? (
            <BookingConfirmationPanel
              client:load
              variant="booked"
              summary={summary}
              postConfirmCta={
                calendarHref
                  ? { label: 'Add to your calendar', href: calendarHref }
                  : null
              }
            />
          ) : (
            <section class="booking-confirmation booking-confirmation--error" role="alert">
              <div class="booking-confirmation__header">
                <div class="booking-confirmation__copy">
                  <p class="booking-confirmation__eyebrow">Payment</p>
                  <h2 class="booking-confirmation__heading">Could not confirm</h2>
                  <p class="booking-confirmation__body">{errorMessage}</p>
                </div>
              </div>
              {
                shopId ? (
                  <div class="booking-confirmation__cta">
                    <a class="btn btn--secondary btn--lg" href={`/book/${shopId}`}>
                      Back to booking
                    </a>
                  </div>
                ) : null
              }
            </section>
          )
        }
      </div>
    </section>
    </BookingThemeRoot>
  </main>
</MinimalLayout>
