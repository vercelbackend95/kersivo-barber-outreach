---
import MinimalLayout from '@/layouts/MinimalLayout.astro';
import BookingFlow from '../../components/booking/BookingFlow';
import { PAGE_DESCRIPTIONS } from '@/lib/seo/defaults';
import '../../styles/tokens.css';
import '../../styles/fonts.css';
import '../../styles/global.css';
import '../../styles/components/booking.css';
import '../../styles/components/booking-flow.css';
import '../../styles/components/booking-mobile.css';
import '../../styles/components/booking-review.css';
import '../../styles/components/empty-state.css';
import '../../styles/components/skeleton.css';
import '../../styles/components/buttons.css';
import '../../styles/components/badge.css';
import { prisma } from '../../lib/db/client';
import { DEMO_SHOP_ID } from '../../lib/db/shopScope';
import { getRescheduleTokenStatus } from '../../lib/booking/service';
import {
  PUBLIC_BOOKING_UNAVAILABLE_MESSAGE,
  PUBLIC_FALLBACK_SHOP_SETTINGS,
  withPrismaQuotaFallback
} from '../../lib/db/resilience';
const token = Astro.url.searchParams.get('token') ?? '';
const bookingPageData = await withPrismaQuotaFallback(
  'book/reschedule.astro',
  async () => {
    const [services, barbers, shopSettings] = await Promise.all([
      prisma.service.findMany({ where: { isActive: true, shopId: DEMO_SHOP_ID }, orderBy: [{ displayOrder: 'asc' }, { createdAt: 'asc' }] }),
      prisma.barber.findMany({
        where: { active: true, shopId: DEMO_SHOP_ID },
        orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }],
        include: { barberServices: { select: { serviceId: true } } }
      }),
      prisma.shopSettings.findUnique({
        where: { id: DEMO_SHOP_ID },
        select: {
          timezone: true,
          cancellationWindowHours: true,
          rescheduleWindowHours: true
        }
      })
    ]);

    return {
      services,
      barbers,
      shopSettings,
      bookingUnavailable: false
    };
  },
  {
    services: [],
    barbers: [],
    shopSettings: {
      timezone: PUBLIC_FALLBACK_SHOP_SETTINGS.timezone,
      cancellationWindowHours: PUBLIC_FALLBACK_SHOP_SETTINGS.cancellationWindowHours,
      rescheduleWindowHours: PUBLIC_FALLBACK_SHOP_SETTINGS.rescheduleWindowHours
    },
    bookingUnavailable: true
  }
);
const { services, barbers, shopSettings, bookingUnavailable } = bookingPageData;
const tokenStatus = bookingUnavailable ? { valid: false as const, message: PUBLIC_BOOKING_UNAVAILABLE_MESSAGE } : await getRescheduleTokenStatus(token);
---

<MinimalLayout
  title="Reschedule booking | Kersivo"
  description={PAGE_DESCRIPTIONS.bookReschedule}
  canonicalPath="/book/reschedule"
  bodyClass="admin-theme-premium-black"
  showCookieConsent={false}
>
  <main class="container page-wrap booking-page-wrap">
     {
        bookingUnavailable ? (
          <section class="surface booking-shell">
            <h1>Reschedule your booking</h1>
            <p class="admin-inline-error">{PUBLIC_BOOKING_UNAVAILABLE_MESSAGE}</p>
            <a class="btn btn--secondary" href="/book">Back to booking</a>
          </section>
        ) : tokenStatus.valid ? (
          <BookingFlow
            client:load
            mode="reschedule"
            token={token}
            themePreset="kersivo"
            services={services}
            barbers={barbers.map((barber) => ({
              id: barber.id,
              name: barber.name,
                            avatarUrl: barber.avatarUrl,
              serviceIds: barber.barberServices.map((link) => link.serviceId)
            }))}
                        shopDetails={
              shopSettings
                ? {
                    timezone: shopSettings.timezone,
                    cancellationWindowHours: shopSettings.cancellationWindowHours,
                    rescheduleWindowHours: shopSettings.rescheduleWindowHours
                  }
                : undefined
            }
          />
        ) : (
          <section class="surface booking-shell">
            <h1>Reschedule your booking</h1>
            <p class="admin-inline-error">{tokenStatus.message}</p>
            <a class="btn btn--secondary" href="/book">Back to booking</a>
          </section>
        )
      }
    </main>
</MinimalLayout>
