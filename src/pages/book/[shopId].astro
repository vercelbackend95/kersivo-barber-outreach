---
import MinimalLayout from '@/layouts/MinimalLayout.astro';
import BookingFlow from '../../components/booking/BookingFlow';
import { prisma } from '../../lib/db/client';
import { DEMO_SHOP_ID } from '../../lib/db/shopScope';
import {
  PUBLIC_BOOKING_UNAVAILABLE_MESSAGE,
  withPrismaQuotaFallback,
} from '../../lib/db/resilience';
import { canCollectBookingDeposit } from '../../lib/booking/depositGate';
import { shopAcceptsPublicBookings } from '../../lib/setup/shopPublicBookingGate';
import {
  publicBookingPageSeo,
  resolvePublicBookingIdentifier,
} from '../../lib/booking/resolvePublicBookingIdentifier';
import '../../styles/tokens.css';
import '../../styles/fonts.css';
import '../../styles/global.css';
import '../../styles/components/buttons.css';
import '../../styles/components/badge.css';
import '../../styles/components/booking.css';
import '../../styles/components/booking-flow.css';
import '../../styles/components/booking-mobile.css';
import '../../styles/components/booking-review.css';
import '../../styles/components/empty-state.css';
import '../../styles/components/skeleton.css';

export const prerender = false;

/** Public identifier: a stable bookingSlug or a legacy raw shop id. Never an internal API id. */
const identifier = Astro.params.shopId?.trim() ?? '';

if (!identifier || identifier === DEMO_SHOP_ID) {
  return Astro.redirect('/book');
}

/**
 * Database outage: the identifier may be a slug, so it is never used as an internal shop id.
 * Render a generic "temporarily unavailable" page with no shop-scoped APIs or cart.
 */
const OUTAGE = { kind: 'outage' as const };

async function loadBookingPage() {
  const resolution = await resolvePublicBookingIdentifier(identifier, Astro.url.search);
  if (resolution.kind !== 'shop') return resolution;
  const shopId = resolution.shopId;

  const shop = await prisma.shopSettings.findUnique({
    where: { id: shopId },
    select: {
      id: true,
      name: true,
      logoUrl: true,
      bookingSlug: true,
      timezone: true,
      cancellationWindowHours: true,
      rescheduleWindowHours: true,
      shopPaidAt: true,
      smsRemindersEnabled: true,
      depositsEnabled: true,
      stripeConnectAccountId: true,
      stripeConnectChargesEnabled: true,
      publicActivityPaused: true,
    },
  });

  if (!shop) {
    return { kind: 'not_found' as const };
  }

  const acceptsPublic = await shopAcceptsPublicBookings(shopId);
  if (!acceptsPublic) {
    return {
      kind: 'shop' as const,
      shop,
      services: [],
      barbers: [],
      depositRequired: false,
      bookingUnavailable: true,
    };
  }

  const [services, barbers] = await Promise.all([
    prisma.service.findMany({
      where: { isActive: true, shopId },
      orderBy: [{ displayOrder: 'asc' }, { createdAt: 'asc' }],
    }),
    prisma.barber.findMany({
      where: { active: true, shopId },
      orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }],
      select: {
        id: true,
        name: true,
        barberServices: { select: { serviceId: true } },
      },
    }),
  ]);

  return {
    kind: 'shop' as const,
    shop,
    services,
    barbers,
    depositRequired: canCollectBookingDeposit(shop),
    bookingUnavailable: false,
  };
}

type BookingPageData = Awaited<ReturnType<typeof loadBookingPage>> | typeof OUTAGE;

const bookingPageData = await withPrismaQuotaFallback<BookingPageData>(
  'book/[shopId].astro',
  loadBookingPage,
  OUTAGE,
);

if (bookingPageData.kind === 'demo') {
  return Astro.redirect('/book');
}
if (bookingPageData.kind === 'redirect') {
  return Astro.redirect(bookingPageData.location, bookingPageData.status);
}
if (bookingPageData.kind === 'not_found') {
  return new Response('Shop not found', { status: 404 });
}

const resolvedPage = bookingPageData.kind === 'shop' ? bookingPageData : null;
const shop = resolvedPage?.shop ?? null;
const services = resolvedPage?.services ?? [];
const barbers = resolvedPage?.barbers ?? [];
const depositRequired = resolvedPage?.depositRequired ?? false;
const bookingUnavailable = !resolvedPage || resolvedPage.bookingUnavailable;
const seo = shop ? publicBookingPageSeo(shop) : null;
const pageTitle = shop ? `Book — ${shop.name}` : 'Book — KERSIVO';
const createUrl = shop ? `/api/public/bookings/${shop.id}/create` : '';
---

<MinimalLayout
  title={pageTitle}
  description={shop ? `Book an appointment at ${shop.name} with KERSIVO.` : 'Book an appointment with KERSIVO.'}
  canonicalPath={seo?.canonicalPath ?? '/book'}
  noindex={true}
  robotsFollow={true}
  bodyClass="admin-theme-premium-black"
  showCookieConsent={false}
  enableAnalytics={false}
  enableProductionCart={Boolean(shop)}
  shopId={shop?.id}
  shopName={shop?.name}
>
  {
    bookingUnavailable || !shop ? (
      <main class="container page-wrap booking-page-wrap">
        <p class="muted">{PUBLIC_BOOKING_UNAVAILABLE_MESSAGE}</p>
      </main>
    ) : (
      <main class="container page-wrap booking-page-wrap">
        <BookingFlow
          client:load
          mode="create"
          publicShopId={shop.id}
          publicCreateUrl={createUrl}
          depositRequired={depositRequired}
          services={services.map((s) => ({
            id: s.id,
            name: s.name,
            durationMinutes: s.durationMinutes,
            pricePence: s.pricePence,
            category: s.category,
            description: s.description,
          }))}
          barbers={barbers.map((b) => ({
            id: b.id,
            name: b.name,
            serviceIds: b.barberServices.map((x) => x.serviceId),
          }))}
          shopDetails={{
            timezone: shop.timezone,
            name: shop.name,
            cancellationWindowHours: shop.cancellationWindowHours,
            rescheduleWindowHours: shop.rescheduleWindowHours,
          }}
        />
      </main>
    )
  }
</MinimalLayout>
