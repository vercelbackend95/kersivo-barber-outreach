---
import DemoLayout from '@/layouts/DemoLayout.astro';
import StorefrontProductDetail from '@/components/shop/storefront/StorefrontProductDetail';
import { getBlacklineRetailProducts } from '@/lib/demo/blacklineShop';
import { DEMO_HOURS, DEMO_LOCATION, DEMO_SHOP_NAME } from '@/lib/demo/site';
import { relatedStorefrontProducts, storefrontProductFromDemo } from '@/lib/shop/storefrontCatalog';
import '@/styles/components/storefront.css';

export const prerender = false;

const id = Astro.params.id?.trim() ?? '';
const products = (await getBlacklineRetailProducts()).map(storefrontProductFromDemo);
const product = id ? products.find((item) => item.id === id) ?? null : null;

if (!product) {
  return Astro.redirect('/demo/shop');
}

const related = relatedStorefrontProducts(products, product.id);
---

<DemoLayout
  title={`${product.name} | ${DEMO_SHOP_NAME}`}
  description={`${product.name} at Blackline Barbers. Demo product — no payment is taken.`}
  canonicalPath={`/demo/shop/${product.id}`}
>
  <StorefrontProductDetail
    client:load
    product={product}
    related={related}
    themeId="blackline"
    shopName={DEMO_SHOP_NAME}
    backHref="/demo/shop"
    productHrefPrefix="/demo/shop"
    priceFormat="demo"
    imageFallback="wordmark"
    fulfilmentLabel={`Collect in shop at ${DEMO_LOCATION}. Opening hours ${DEMO_HOURS[0].days} ${DEMO_HOURS[0].hours}.`}
    safetyNote="No real payment or fulfilment is created."
    addToBagLabel="Add to bag"
  />
</DemoLayout>
