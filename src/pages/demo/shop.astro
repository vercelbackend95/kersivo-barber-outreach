---
import DemoLayout from '@/layouts/DemoLayout.astro';
import StorefrontShopPage from '@/components/shop/storefront/StorefrontShopPage';
import { getBlacklineRetailProducts } from '@/lib/demo/blacklineShop';
import { DEMO_SHOP_NAME } from '@/lib/demo/site';
import { parseStorefrontCategoryParam, storefrontCategoryOptions, storefrontProductFromDemo } from '@/lib/shop/storefrontCatalog';
import '@/styles/components/storefront.css';

export const prerender = false;

const products = (await getBlacklineRetailProducts()).map(storefrontProductFromDemo);
const selectedCategory = parseStorefrontCategoryParam(
  Astro.url.searchParams.get('category'),
  storefrontCategoryOptions(products).map((option) => option.value),
);
---

<DemoLayout
  title={`Shop | ${DEMO_SHOP_NAME}`}
  description="The Blackline Edit — a curated grooming selection. Demo shop, no payment is taken."
  canonicalPath="/demo/shop"
>
  <div class="shop-page" data-bl-shop data-active-category={selectedCategory}>
    <StorefrontShopPage
      client:load
      products={products}
      themeId="blackline"
      shopName={DEMO_SHOP_NAME}
      productHrefPrefix="/demo/shop"
      priceFormat="demo"
      imageFallback="wordmark"
      selectedCategory={selectedCategory}
      intro={{
        eyebrow: 'THE SHOP',
        heading: 'THE BLACKLINE EDIT.',
        headingId: 'blackline-shop-heading',
        description: 'Grooming essentials selected by the shop, ready to collect.',
        fulfilmentLabel: 'COLLECT IN SHOP',
        meta: ['DEMO CHECKOUT'],
      }}
      collectionHeading="Shop the shelf."
      copy={{
        addToBagLabel: 'Add',
        viewProductLabel: 'View product',
        addedLabel: 'Added',
      }}
    />
  </div>
</DemoLayout>
