---
/**
 * Heritage Grooming owner dashboard — the live KERSIVO demo.
 * Same AdminPanel as a real shop, fed by `src/lib/admin/heritageDemoFixtures` through
 * `/api/demo/heritage/admin/*`, plus the bookings and orders a visitor makes on the
 * Heritage Grooming website (`public/demo/heritage-grooming`, bridged by its js/kersivo.js).
 */
import MinimalLayout from '@/layouts/MinimalLayout.astro';
import DemoBanner from '@/components/demo/DemoBanner.astro';
import AdminPanel from '@/components/admin/AdminPanel';
import InitDataTrackScript from '@/components/InitDataTrackScript.astro';
import AdminHeroEmbedStyles from '@/components/admin/AdminHeroEmbedStyles.astro';
import { HERO_SHOWCASE_DAY, heroShowcaseNow } from '@/lib/admin/heroShowcase';
import { getHeritageBookingsResponse } from '@/lib/admin/heritageDemoFixtures/schedule';
import { blacklineDayKey } from '@/lib/admin/blacklineDemoFixtures/time';
import { HERITAGE_ADMIN_DEMO_PATH } from '@/lib/admin/demoConfig';
import { HERITAGE_SHOP_NAME } from '@/lib/demo/heritage/data';
import '@/styles/tokens.css';
import '@/styles/fonts-admin.css';
import '@/styles/demo/fonts-blackline.css';
import '@/styles/demo/blackline-wordmark.css';
import '@/styles/demo/heritage-wordmark.css';
import '@/styles/global.css';
import '@/styles/components/booking.css';
import '@/styles/components/admin-mobile-sticky-overrides.css';
import '@/styles/components/inputs.css';
import '@/styles/components/buttons.css';
import '@/styles/components/badge.css';
import '@/styles/components/admin-login.css';
import '@/styles/components/admin-section-header.css';
import '@/styles/components/admin-demo.css';
import '@/styles/components/empty-state.css';
import '@/styles/components/skeleton.css';
import '@/styles/components/admin-services.css';
import '@/styles/components/admin-service-wizard.css';
import '@/styles/components/admin-product-wizard.css';
import '@/styles/components/admin-barber-wizard.css';
import '@/styles/components/shop-products-polish.css';
import '@/styles/components/admin-retail-onboarding.css';
import '@/styles/components/table.css';
import '@/styles/components/admin-ui.css';
import '@/styles/components/admin-ai.css';

// `?embed=hero`: the marketing hero frames this dashboard at a fixed, busy afternoon (see heroShowcase.ts).
const heroEmbed = Astro.url.searchParams.get('embed') === 'hero';
const now = heroEmbed ? heroShowcaseNow() : new Date();
const { bookings: initialBookings } = getHeritageBookingsResponse(
  new URLSearchParams({ date: heroEmbed ? HERO_SHOWCASE_DAY : blacklineDayKey(now), mode: 'day' }),
  now,
);
---

<MinimalLayout
  title={`Owner dashboard | ${HERITAGE_SHOP_NAME}`}
  description="Fictional Heritage Grooming owner dashboard using sample KERSIVO admin data. No real appointments, orders or payments are created."
  canonicalPath={HERITAGE_ADMIN_DEMO_PATH}
  htmlClass="admin-app-scroll"
  bodyClass={heroEmbed ? 'admin-theme-premium-black admin-hero-embed-body' : 'admin-theme-premium-black'}
  viewportContent="width=device-width, initial-scale=1, viewport-fit=cover"
  noindex={true}
  enableAnalytics={!heroEmbed}
  showCookieConsent={!heroEmbed}
  enableClientRouter={!heroEmbed}
>
  <link
    slot="head"
    rel="preload"
    href="/fonts/inter-latin-400-normal.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link
    slot="head"
    rel="preload"
    href="/fonts/inter-latin-600-normal.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Display&display=swap"
  />
  {heroEmbed ? null : <DemoBanner view="admin" shop="heritage" />}
  <main
    class={heroEmbed ? 'page-wrap admin-page-wrap admin-page-wrap--hero-embed' : 'container page-wrap admin-page-wrap'}
    data-demo-tenant="heritage"
    data-hero-embed={heroEmbed ? 'true' : undefined}
  >
    <h1 class="sr-only">Heritage Grooming owner dashboard</h1>
    <AdminPanel
      client:load
      demoMode={true}
      demoTenant="heritage"
      initialBookings={initialBookings}
      initialSection={Astro.url.searchParams.get('section')}
      showcaseMode={heroEmbed}
    />
  </main>
  {heroEmbed ? null : <InitDataTrackScript />}
  {heroEmbed ? <AdminHeroEmbedStyles /> : null}
</MinimalLayout>
