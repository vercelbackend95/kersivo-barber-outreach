---
import DemoLayout from '@/layouts/DemoLayout.astro';
import DemoServicesClose from '@/components/demo/DemoServicesClose.astro';
import DemoServicesHero from '@/components/demo/DemoServicesHero.astro';
import DemoServicesMenu from '@/components/demo/DemoServicesMenu.astro';
import { DEMO_SHOP_NAME } from '@/lib/demo/site';
---

<DemoLayout
  title={`Services | ${DEMO_SHOP_NAME}`}
  description="Cuts, fades, and finishes at Blackline Barbers."
  canonicalPath="/demo/services"
>
  <script is:inline slot="head">
    try {
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.setAttribute('data-bl-services-motion', '');
      }
    } catch (error) {
      /* Keep server-rendered content visible if matchMedia is unavailable. */
    }
  </script>

  <div class="bl-services" data-bl-services>
    <DemoServicesHero />
    <DemoServicesMenu />
    <DemoServicesClose />
  </div>
</DemoLayout>

<script>
  import { pickActiveServiceCategory, serviceMenuReadingY } from '@/lib/demo/serviceMenuSpy';

  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function isInViewport(el: Element) {
    const rect = el.getBoundingClientRect();
    return rect.bottom > 0 && rect.top < window.innerHeight;
  }

  function revealBlock(el: Element, instant: boolean) {
    el.classList.add('is-inview');
    if (instant) el.classList.add('is-settled');
  }

  function headerHeight() {
    const header = document.querySelector('.sf-header, .bl-header');
    if (header instanceof HTMLElement) return header.getBoundingClientRect().height;
    const raw = getComputedStyle(document.documentElement).getPropertyValue('--sf-header-height').trim();
    const parsed = Number.parseFloat(raw);
    return Number.isFinite(parsed) ? parsed * 16 : 66;
  }

  function bindServiceMenuSpy(root: Element) {
    const menu = root.querySelector('[data-bl-service-menu]');
    if (!(menu instanceof HTMLElement) || menu.dataset.blMenuBound === 'true') return;
    menu.dataset.blMenuBound = 'true';

    const sections = [...menu.querySelectorAll<HTMLElement>('.bl-service-group[data-category-slug]')];
    const copy = menu.querySelector('[data-bl-viewing-copy]');
    const nameEl = menu.querySelector('[data-bl-viewing-name]');
    const metaEl = menu.querySelector('[data-bl-viewing-meta]');
    const progressEl = menu.querySelector<HTMLElement>('[data-bl-viewing-progress]');
    if (sections.length === 0) return;

    const reduceMotion = prefersReducedMotion();
    let activeSlug = menu.dataset.activeCategory || sections[0]?.dataset.categorySlug || '';

    const applyViewing = (section: HTMLElement, animate: boolean) => {
      const slug = section.dataset.categorySlug ?? '';
      if (!slug) return;
      const changed = slug !== activeSlug;
      activeSlug = slug;
      menu.dataset.activeCategory = slug;
      if (nameEl) nameEl.textContent = section.dataset.categoryLabel ?? '';
      if (metaEl) {
        metaEl.textContent = `${section.dataset.countLabel ?? ''} · ${section.dataset.fromPrice ?? ''}`.replace(
          /^\s·\s|\s·\s$/g,
          '',
        );
      }
      const index = Number(section.dataset.categoryIndex ?? '0');
      if (progressEl) {
        progressEl.style.transform = `scaleX(${(index + 1) / sections.length})`;
      }
      if (changed && animate && copy instanceof HTMLElement && !reduceMotion) {
        copy.classList.remove('is-changing');
        void copy.offsetWidth;
        copy.classList.add('is-changing');
      }
    };

    const syncFromHash = () => {
      const hash = window.location.hash.replace(/^#/, '');
      if (!hash) return false;
      const match = sections.find(
        (section) => section.id === hash || section.dataset.categorySlug === hash || section.dataset.categoryAnchor === hash,
      );
      if (!match) return false;
      applyViewing(match, false);
      return true;
    };

    const updateActive = () => {
      const readingY = serviceMenuReadingY(headerHeight());
      const menuBottom = menu.getBoundingClientRect().bottom;
      const picked = pickActiveServiceCategory(
        sections.map((section) => {
          const rect = section.getBoundingClientRect();
          return { id: section.dataset.categorySlug ?? section.id, top: rect.top, bottom: rect.bottom };
        }),
        readingY,
        menuBottom,
      );
      const next = sections.find((section) => (section.dataset.categorySlug ?? section.id) === picked);
      if (next) applyViewing(next, true);
    };

    if (!syncFromHash()) {
      applyViewing(sections[0]!, false);
      updateActive();
    }

    if (typeof IntersectionObserver === 'undefined') return;

    const observer = new IntersectionObserver(
      () => {
        updateActive();
      },
      {
        root: null,
        threshold: [0, 0.25, 0.5, 0.75, 1],
        rootMargin: `-${Math.round(headerHeight() + 48)}px 0px -45% 0px`,
      },
    );

    sections.forEach((section) => observer.observe(section));
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }

  function bindBlacklineServicesMotion(root: Element) {
    if (!(root instanceof HTMLElement) || root.dataset.blServicesBound === 'true') return;
    root.dataset.blServicesBound = 'true';

    bindServiceMenuSpy(root);

    if (prefersReducedMotion() || typeof IntersectionObserver === 'undefined') {
      document.documentElement.removeAttribute('data-bl-services-motion');
      return;
    }

    const blocks = [...root.querySelectorAll('[data-bl-reveal]')];
    const hero = root.querySelector('.bl-page-hero');
    const scrolledPastHero =
      window.scrollY >
      (hero instanceof HTMLElement ? Math.min(hero.offsetHeight * 0.35, 240) : 80);

    if (scrolledPastHero) {
      document.documentElement.setAttribute('data-bl-services-instant', '');
      blocks.forEach((block) => revealBlock(block, true));
      return;
    }

    let remaining = blocks.length;
    let observerFired = false;

    const observer = new IntersectionObserver(
      (entries) => {
        observerFired = true;
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          revealBlock(entry.target, false);
          observer.unobserve(entry.target);
          remaining -= 1;
        }
        if (remaining <= 0) observer.disconnect();
      },
      { threshold: 0.16, rootMargin: '0px 0px -10% 0px' },
    );

    blocks.forEach((block) => observer.observe(block));

    window.setTimeout(() => {
      if (!observerFired) {
        blocks.forEach((block) => revealBlock(block, true));
        observer.disconnect();
        return;
      }
      blocks.forEach((block) => {
        if (!block.classList.contains('is-inview') && isInViewport(block)) {
          revealBlock(block, true);
          observer.unobserve(block);
          remaining -= 1;
        }
      });
      if (remaining <= 0) observer.disconnect();
    }, 1000);

    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      if (window.scrollY <= 80) return;
      document.documentElement.setAttribute('data-bl-services-instant', '');
      blocks.forEach((block) => revealBlock(block, true));
      observer.disconnect();
    });
  }

  document.querySelectorAll('[data-bl-services]').forEach(bindBlacklineServicesMotion);
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-bl-services]').forEach(bindBlacklineServicesMotion);
  });
</script>
