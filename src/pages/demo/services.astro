---
import DemoLayout from '@/layouts/DemoLayout.astro';
import DemoServicesClose from '@/components/demo/DemoServicesClose.astro';
import DemoServicesHero from '@/components/demo/DemoServicesHero.astro';
import DemoServicesMenu from '@/components/demo/DemoServicesMenu.astro';
import { DEMO_SHOP_NAME } from '@/lib/demo/site';
---

<DemoLayout
  title={`Services | ${DEMO_SHOP_NAME}`}
  description="Cuts, fades, and finishes at Blackline Barbers."
  canonicalPath="/demo/services"
>
  <script is:inline slot="head">
    try {
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.setAttribute('data-bl-services-motion', '');
      }
    } catch (error) {
      /* Keep server-rendered content visible if matchMedia is unavailable. */
    }
  </script>

  <div class="bl-services" data-bl-services>
    <DemoServicesHero />
    <DemoServicesMenu />
    <DemoServicesClose />
  </div>
</DemoLayout>

<script>
  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function isInViewport(el: Element) {
    const rect = el.getBoundingClientRect();
    return rect.bottom > 0 && rect.top < window.innerHeight;
  }

  function revealBlock(el: Element, instant: boolean) {
    el.classList.add('is-inview');
    if (instant) el.classList.add('is-settled');
  }

  function parseCategorySlug(raw: string | null | undefined) {
    const slug = raw?.trim().toLowerCase() ?? '';
    if (!slug || slug === 'all') return 'all';
    const known = [...document.querySelectorAll('[data-bl-service-menu] [data-category-slug]')]
      .map((node) => (node instanceof HTMLElement ? node.dataset.categorySlug : undefined))
      .filter((value): value is string => Boolean(value && value !== 'all'));
    return known.includes(slug) ? slug : 'all';
  }

  function bindActiveServiceMenu(root: Element) {
    const menu = root.querySelector('[data-bl-service-menu]');
    if (!(menu instanceof HTMLElement) || menu.dataset.blMenuBound === 'true') return;
    menu.dataset.blMenuBound = 'true';

    const buttons = [...menu.querySelectorAll<HTMLButtonElement>('.bl-services-cat[data-category-slug]')];
    const groups = [...menu.querySelectorAll<HTMLElement>('.bl-service-group[data-category-slug]')];
    const rows = [...menu.querySelectorAll<HTMLElement>('[data-service-slug]')];
    const live = menu.querySelector('[data-bl-filter-live]');
    const summary = menu.querySelector('[data-bl-results-summary]');
    const quickSummary = menu.querySelector('[data-bl-quick-mode="summary"]');
    const quickService = menu.querySelector('[data-bl-quick-mode="service"]');
    const quickKicker = menu.querySelector('[data-bl-quick-kicker]');
    const quickName = menu.querySelector('[data-bl-quick-name]');
    const quickFacts = menu.querySelector('[data-bl-quick-facts]');
    const serviceCategory = menu.querySelector('[data-bl-quick-service-category]');
    const serviceName = menu.querySelector('[data-bl-quick-service-name]');
    const serviceDuration = menu.querySelector('[data-bl-quick-service-duration]');
    const servicePrice = menu.querySelector('[data-bl-quick-service-price]');
    const quickBook = menu.querySelector<HTMLAnchorElement>('[data-bl-quick-book]');
    const allMeta = buttons.find((button) => button.dataset.categorySlug === 'all');
    const reduceMotion = prefersReducedMotion();

    const allSummary = {
      kicker: 'All services',
      name: 'The Blackline menu',
      facts: menu.dataset.allFacts?.trim() || allMeta?.querySelector('.bl-services-cat-meta')?.textContent?.trim() || '',
    };

    const setQuickSummary = (slug: string) => {
      const group = groups.find((entry) => entry.dataset.categorySlug === slug);
      if (quickKicker) quickKicker.textContent = group?.dataset.categoryLabel ?? allSummary.kicker;
      if (quickName) quickName.textContent = group ? group.dataset.categoryLabel ?? allSummary.name : allSummary.name;
      if (quickFacts) {
        quickFacts.textContent = group
          ? `${group.dataset.countLabel ?? ''} · ${group.dataset.durationRange ?? ''} · ${group.dataset.fromPrice ?? ''}`.replace(
              /^\s·\s|\s·\s$/g,
              '',
            )
          : allSummary.facts;
      }
      if (quickSummary instanceof HTMLElement) {
        quickSummary.classList.add('is-active');
      }
      if (quickService instanceof HTMLElement) {
        quickService.classList.remove('is-active');
      }
    };

    const setQuickService = (row: HTMLElement) => {
      if (serviceCategory) serviceCategory.textContent = row.dataset.categoryLabel ?? '';
      if (serviceName) serviceName.textContent = row.dataset.serviceName ?? '';
      if (serviceDuration) serviceDuration.textContent = row.dataset.duration ?? '';
      if (servicePrice) servicePrice.textContent = row.dataset.price ?? '';
      if (quickBook && row.dataset.bookHref) quickBook.href = row.dataset.bookHref;
      if (quickSummary instanceof HTMLElement) {
        quickSummary.classList.remove('is-active');
      }
      if (quickService instanceof HTMLElement) {
        quickService.classList.add('is-active');
      }
    };

    const announce = (slug: string) => {
      const visible = groups.filter((group) => !group.hidden);
      const count = visible.reduce(
        (total, group) => total + group.querySelectorAll('.bl-service-item').length,
        0,
      );
      const group = groups.find((entry) => entry.dataset.categorySlug === slug);
      const message =
        slug === 'all'
          ? `Showing ${count} services.`
          : `Showing ${group?.dataset.countLabel ?? `${count} services`} in ${group?.dataset.categoryLabel ?? 'this category'}.`;
      if (live) live.textContent = message;
      if (summary) summary.textContent = message;
    };

    const applyCategory = (slug: string, options: { persist?: boolean } = {}) => {
      const next = parseCategorySlug(slug);
      menu.dataset.activeCategory = next;
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.categorySlug === next));
      });
      groups.forEach((group) => {
        const visible = next === 'all' || group.dataset.categorySlug === next;
        group.hidden = !visible;
        group.classList.toggle('is-entering', visible && !reduceMotion);
      });
      announce(next);
      setQuickSummary(next);
      if (options.persist === false) return;
      const url = new URL(window.location.href);
      if (next === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category', next);
      if (`${url.pathname}${url.search}` !== `${window.location.pathname}${window.location.search}`) {
        window.history.pushState({ category: next }, '', `${url.pathname}${url.search}${url.hash}`);
      }
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        applyCategory(button.dataset.categorySlug ?? 'all');
      });
    });

    rows.forEach((row) => {
      row.addEventListener('focusin', () => setQuickService(row));
      row.addEventListener('focusout', (event) => {
        const next = event.relatedTarget;
        if (next instanceof Node && row.contains(next)) return;
        setQuickSummary(menu.dataset.activeCategory ?? 'all');
      });
    });

    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const onPointerEnter = (event: Event) => {
      const target = event.currentTarget;
      if (target instanceof HTMLElement) setQuickService(target);
    };
    const onPointerLeave = () => setQuickSummary(menu.dataset.activeCategory ?? 'all');
    const bindHover = () => {
      rows.forEach((row) => {
        row.removeEventListener('pointerenter', onPointerEnter);
        row.removeEventListener('pointerleave', onPointerLeave);
        if (finePointer.matches) {
          row.addEventListener('pointerenter', onPointerEnter);
          row.addEventListener('pointerleave', onPointerLeave);
        }
      });
    };
    bindHover();
    if (typeof finePointer.addEventListener === 'function') {
      finePointer.addEventListener('change', bindHover);
    }

    window.addEventListener('popstate', () => {
      if (!menu.isConnected) return;
      applyCategory(new URL(window.location.href).searchParams.get('category'), { persist: false });
    });

    applyCategory(menu.dataset.activeCategory ?? new URL(window.location.href).searchParams.get('category'), {
      persist: false,
    });
  }

  function bindBlacklineServicesMotion(root: Element) {
    if (!(root instanceof HTMLElement) || root.dataset.blServicesBound === 'true') return;
    root.dataset.blServicesBound = 'true';

    bindActiveServiceMenu(root);

    if (prefersReducedMotion() || typeof IntersectionObserver === 'undefined') {
      document.documentElement.removeAttribute('data-bl-services-motion');
      return;
    }

    const blocks = [...root.querySelectorAll('[data-bl-reveal]')];
    const hero = root.querySelector('.bl-page-hero');
    const scrolledPastHero =
      window.scrollY >
      (hero instanceof HTMLElement ? Math.min(hero.offsetHeight * 0.35, 240) : 80);

    if (scrolledPastHero) {
      document.documentElement.setAttribute('data-bl-services-instant', '');
      blocks.forEach((block) => revealBlock(block, true));
      return;
    }

    let remaining = blocks.length;
    let observerFired = false;

    const observer = new IntersectionObserver(
      (entries) => {
        observerFired = true;
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          revealBlock(entry.target, false);
          observer.unobserve(entry.target);
          remaining -= 1;
        }
        if (remaining <= 0) observer.disconnect();
      },
      { threshold: 0.16, rootMargin: '0px 0px -10% 0px' },
    );

    blocks.forEach((block) => observer.observe(block));

    window.setTimeout(() => {
      if (!observerFired) {
        blocks.forEach((block) => revealBlock(block, true));
        observer.disconnect();
        return;
      }
      blocks.forEach((block) => {
        if (!block.classList.contains('is-inview') && isInViewport(block)) {
          revealBlock(block, true);
          observer.unobserve(block);
          remaining -= 1;
        }
      });
      if (remaining <= 0) observer.disconnect();
    }, 1000);

    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      if (window.scrollY <= 80) return;
      document.documentElement.setAttribute('data-bl-services-instant', '');
      blocks.forEach((block) => revealBlock(block, true));
      observer.disconnect();
    });
  }

  document.querySelectorAll('[data-bl-services]').forEach(bindBlacklineServicesMotion);
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-bl-services]').forEach(bindBlacklineServicesMotion);
  });
</script>
