---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Faq4 from '@/components/faq4.astro';
import Footer50 from '@/components/footer50.astro';
import Contact16 from '@/components/contact16.astro';
import BooksyHero from '@/components/booksyAlternative/BooksyHero.astro';
import BooksyQuickAnswer from '@/components/booksyAlternative/BooksyQuickAnswer.astro';
import BooksyWhy from '@/components/booksyAlternative/BooksyWhy.astro';
import BooksyCosts from '@/components/booksyAlternative/BooksyCosts.astro';
import BooksyCompare from '@/components/booksyAlternative/BooksyCompare.astro';
import BooksyProof from '@/components/booksyAlternative/BooksyProof.astro';
import BooksyFit from '@/components/booksyAlternative/BooksyFit.astro';
import BooksySwitching from '@/components/booksyAlternative/BooksySwitching.astro';
import BooksyPricing from '@/components/booksyAlternative/BooksyPricing.astro';
import BooksyFinalCta from '@/components/booksyAlternative/BooksyFinalCta.astro';
import BooksySources from '@/components/booksyAlternative/BooksySources.astro';
import CompareHubLink from '@/components/alternativesHub/CompareHubLink.astro';
import {
  BOOKSY_ALTERNATIVE_DESCRIPTION,
  BOOKSY_ALTERNATIVE_FAQ_ITEMS,
  BOOKSY_ALTERNATIVE_PAGE_PATH,
  BOOKSY_ALTERNATIVE_TITLE,
  buildBooksyAlternativeFaqJsonLd,
} from '@/lib/seo/booksyAlternativeFaq';
import {
  buildBooksyAlternativeBreadcrumbJsonLd,
  buildBooksyAlternativeWebPageJsonLd,
} from '@/lib/seo/booksyAlternativeJsonLd';
import {
  FOOTER_LEGAL_LINKS,
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';
import '@/styles/components/fresha-alternative.css';

const currentYear = new Date().getFullYear();
---

<LandingLayout
  title={BOOKSY_ALTERNATIVE_TITLE}
  description={BOOKSY_ALTERNATIVE_DESCRIPTION}
  canonicalPath={BOOKSY_ALTERNATIVE_PAGE_PATH}
  jsonLd={[buildBooksyAlternativeWebPageJsonLd(), buildBooksyAlternativeBreadcrumbJsonLd(), buildBooksyAlternativeFaqJsonLd()]}
>
  <main class="fresha-alt landing-overflow-guard">
    <BooksyHero />
    <BooksyQuickAnswer />
    <BooksyWhy />
    <BooksyCosts />
    <BooksyCompare />
    <BooksyProof />
    <BooksyFit />
    <BooksySwitching />
    <BooksyPricing />

    <Faq4
      className="faq4--landing"
      heading="Questions about comparing Booksy and KERSIVO?"
      subHeading="Clear answers on Booksy pricing, Boost, commission, switching and client booking."
      supportHeading="Still comparing options?"
      supportText="Tell us what you use today and what you want your booking journey to look like."
      supportLinkLabel="Ask KERSIVO a question"
      supportLinkHref="#contact"
      faqs={BOOKSY_ALTERNATIVE_FAQ_ITEMS}
    />

    <BooksyFinalCta />

    <Contact16
      eyebrow="CONTACT KERSIVO"
      title="Still comparing KERSIVO and Booksy?"
      description="Tell us what you use today and what you want to change. We’ll reply with a clear, practical answer for your barbershop."
      note="We’ll reply by email — no sales call required."
      submitLabel="Send my question"
      messagePlaceholder="For example: switching from Booksy, setting up deposits, moving client data or launching a new booking website."
    />

    <CompareHubLink />
    <BooksySources />

    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      navigation={[
        { name: 'Home', href: '/' },
        { name: 'Live demo', href: '/demo' },
        { name: 'Pricing', href: '/pricing' },
        { name: 'FAQ', href: '#faq' },
        { name: 'About', href: '/about' },
        { name: 'Contact', href: '#contact' },
        { name: 'Start KERSIVO Starter', href: '/admin' },
      ]}
      social={getFooterSocialLinks()}
      legal={[
        FOOTER_LEGAL_LINKS.privacy,
        FOOTER_LEGAL_LINKS.cookies,
        FOOTER_LEGAL_LINKS.cookieSettings,
        FOOTER_LEGAL_LINKS.dpa,
        FOOTER_LEGAL_LINKS.termsAndCancellation,
      ]}
    />
  </main>
</LandingLayout>

<script>
  import { initFeature261StaggerReveal } from '@/lib/landing/initFeature261StaggerReveal';

  const scheduleInit = () => {
    requestAnimationFrame(() => {
      const section = document.querySelector('.feature261');
      if (!(section instanceof HTMLElement) || section.dataset.feature261Enhanced === 'true') return;
      const cleanup = initFeature261StaggerReveal(section);
      document.addEventListener('astro:before-swap', cleanup, { once: true });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleInit, { once: true });
  } else {
    scheduleInit();
  }
  document.addEventListener('astro:page-load', scheduleInit);
</script>

<script>
  import { destroyProductRails, initProductRails } from '@/lib/shop/initProductRail';

  const bootProductRails = () => {
    destroyProductRails();
    initProductRails();
  };

  bootProductRails();
  document.addEventListener('astro:page-load', bootProductRails);
</script>

<style is:global>
  .landing-overflow-guard {
    overflow-x: clip;
  }
</style>
