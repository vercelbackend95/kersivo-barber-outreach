---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Footer50 from '@/components/footer50.astro';
import ComparisonFinalCta from '@/components/comparison/ComparisonFinalCta.astro';
import { buildKersivoEntityJsonLd } from '@/lib/seo/kersivoEntityJsonLd';
import { KERSIVO_CONTACT_EMAIL, getFooterSocialLinks } from '@/lib/seo/footerSocialLinks';
import {
  FREE_TOOLS,
  FREE_TOOLS_BREADCRUMB_NAME,
  FREE_TOOLS_DESCRIPTION,
  FREE_TOOLS_EYEBROW,
  FREE_TOOLS_H1,
  FREE_TOOLS_LAST_UPDATED_ISO,
  FREE_TOOLS_LAST_UPDATED_LABEL,
  FREE_TOOLS_LEAD,
  FREE_TOOLS_PAGE_PATH,
  FREE_TOOLS_TITLE,
  FREE_TOOL_GROUPS,
  buildFreeToolsJsonLd,
} from '@/lib/seo/freeToolsPage';
import '@/styles/components/ks-glass-card.css';
import '@/styles/components/data-report.css';
import '@/styles/components/free-tools.css';

const currentYear = new Date().getFullYear();
const calculators = FREE_TOOLS.filter((tool) => tool.kind === 'Calculator').length;
const templates = FREE_TOOLS.length - calculators;
---

<LandingLayout
  title={FREE_TOOLS_TITLE}
  description={FREE_TOOLS_DESCRIPTION}
  canonicalPath={FREE_TOOLS_PAGE_PATH}
  jsonLd={[buildKersivoEntityJsonLd(), ...buildFreeToolsJsonLd()]}
>
  <main class="dr-page ft-page landing-overflow-guard">
    <header class="dr-hero ft-hero">
      <div class="dr-shell ft-hero__inner">
        <div class="ft-hero__copy">
          <nav class="dr-breadcrumb" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              <li aria-hidden="true">/</li>
              <li><span aria-current="page">{FREE_TOOLS_BREADCRUMB_NAME}</span></li>
            </ol>
          </nav>
          <p class="ks-eyebrow">{FREE_TOOLS_EYEBROW}</p>
          <h1 class="dr-hero__title">{FREE_TOOLS_H1}</h1>
          <p class="dr-hero__lead">{FREE_TOOLS_LEAD}</p>
          <nav class="ft-jump" aria-label="Jump to a topic">
            {FREE_TOOL_GROUPS.map((group) => <a class="ft-jump__link" href={`#${group.id}`}>{group.heading}</a>)}
          </nav>
        </div>

        <aside class="ks-glass-card ks-glass-card--accent ft-glance" aria-label="What is here">
          <p class="ks-eyebrow">In the kit</p>
          <dl class="ks-facts ft-glance__facts">
            <div class="ks-facts__value">
              <dt>Calculators</dt>
              <dd>{calculators}</dd>
            </div>
            <div class="ks-facts__value">
              <dt>Templates</dt>
              <dd>{templates}</dd>
            </div>
          </dl>
          <ul class="ft-glance__list">
            <li>No account or email needed</li>
            <li>Worked out in your browser</li>
            <li>Updated <time datetime={FREE_TOOLS_LAST_UPDATED_ISO}>{FREE_TOOLS_LAST_UPDATED_LABEL}</time></li>
          </ul>
        </aside>
      </div>
    </header>

    {FREE_TOOL_GROUPS.map((group) => (
      <section id={group.id} class="dr-section ft-group" aria-labelledby={`ft-${group.id}-title`}>
        <div class="dr-shell ft-group__inner">
          <div class="ft-group__head">
            <p class="ks-eyebrow ks-eyebrow--neutral">{group.tools.length === 1 ? '1 tool' : `${group.tools.length} tools`}</p>
            <h2 id={`ft-${group.id}-title`} class="ft-group__title">{group.heading}</h2>
          </div>
          <ul class:list={['ft-cards', { 'ft-cards--single': group.tools.length === 1 }]} role="list">
            {group.tools.map((tool) => (
              <li>
                <a class="ks-glass-card ft-card" href={tool.href} data-track="cta_click" data-track-placement={`free_tools_${group.id}`}>
                  <span class="ft-card__top">
                    <span class="ft-card__icon" aria-hidden="true">
                      {tool.kind === 'Calculator' ? (
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2.5" /><path d="M8.5 7.5h7" /><path d="M8.5 12h.01M12 12h.01M15.5 12h.01M8.5 15.5h.01M12 15.5h.01M15.5 15.5h.01" stroke-width="2.2" /></svg>
                      ) : (
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7.5A2.5 2.5 0 0 0 5 5.5v13A2.5 2.5 0 0 0 7.5 21h9a2.5 2.5 0 0 0 2.5-2.5V8z" /><path d="M14 3v5h5" /><path d="M8.5 12.5h7M8.5 16h4.5" /></svg>
                      )}
                    </span>
                    <span class="ft-card__kind">{tool.kind}</span>
                  </span>
                  <span class="ft-card__body">
                    <span class="ft-card__label">{tool.label}</span>
                    <span class="ft-card__desc">{tool.description}</span>
                  </span>
                  <span class="ft-card__go">
                    <span>Open the {tool.kind.toLowerCase()}</span>
                    <span class="ft-card__arrow" aria-hidden="true">
                      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))}

    <section class="dr-section ft-why-section" aria-labelledby="ft-why-title">
      <div class="dr-shell">
        <div class="ks-glass-card ks-glass-card--accent ft-why">
          <div class="ft-why__main">
            <p class="ks-eyebrow">Why they are free</p>
            <h2 id="ft-why-title" class="ft-why__title">Made by KERSIVO, booking software for independent UK barbershops</h2>
            <p class="ft-why__body">
              They cover the sums and paperwork that come with running a chair, and you do not need KERSIVO to use them. Everything is worked out in your browser: nothing you type is sent to us or stored.
            </p>
          </div>
          <ul class="ft-why__points">
            <li>
              <span class="ft-why__point-title">You do not need KERSIVO</span>
              <span class="ft-why__point-body">Every tool works on its own, for any shop.</span>
            </li>
            <li>
              <span class="ft-why__point-title">Nothing is sent or stored</span>
              <span class="ft-why__point-body">Your numbers stay in your browser.</span>
            </li>
            <li>
              <span class="ft-why__point-title">No account or email</span>
              <span class="ft-why__point-body">Open a tool and start typing.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <ComparisonFinalCta placement="free_tools" />

    <div class="dr-end"></div>

    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      social={getFooterSocialLinks()}
    />
  </main>
</LandingLayout>

<style is:global>
  .landing-overflow-guard {
    overflow-x: clip;
  }
</style>
