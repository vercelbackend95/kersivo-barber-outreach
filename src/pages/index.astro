---
import MainLayout from '@/layouts/MainLayout.astro';
import '../styles/components/hero.css';
import '../styles/components/compare3.css';
import '../styles/components/timeline13.css';
import '../styles/components/trustStrip3.css';
import { TrustStrip3 } from '../components/trustStrip3';
import Compare3 from '../components/compare3.astro';
import Timeline13 from '../components/timeline13.astro';
import { Feature261 } from '../components/feature261';
import Feature228 from '../components/feature228.astro';
import '../styles/components/feature228.css';
import '../styles/components/hero108.css';
import Hero108 from '../components/hero108.astro';
import SettingsIntegrations3a from '../components/settingsIntegrations3a.astro';
import ShopProductCards6 from '../components/shopProductCards6.astro';
import '../styles/components/settingsIntegrations3a.css';
import '../styles/components/shopProductCards6.css';
import Faq4 from '../components/faq4.astro';
import Cta10 from '../components/cta10.astro';
import '../styles/components/faq4.css';
import '../styles/components/cta10.css';
import Contact16 from '../components/contact16.astro';
import '../styles/components/contact16.css';
import Footer50 from '../components/footer50.astro';
import '../styles/components/footer50.css';
const DEMO_ADMIN_PASSWORD = import.meta.env.PUBLIC_DEMO_ADMIN_PASSWORD
  ?? import.meta.env.PUBLIC_ADMIN_DEMO_PASSWORD
  ?? import.meta.env.ADMIN_SECRET
  ?? 'demo-access';


---

<MainLayout title="Kersivo Barber Outreach">
  <main class="hero103">
    <section class="hero103__section">
      <div class="container hero103__layout">
        <div class="hero103__content">
          <p class="hero103__eyebrow">Barber website system</p>
          <h1>A Barber Website That Books, Sells and Keeps the Shop Running</h1>

          <p class="hero103__lead">
            Give clients a clean way to book, browse products and contact your shop — while you
            manage schedules, updates and pickup orders in one place.

          </p>
          <div class="hero103__actions">
            <button class="btn btn--primary" type="button" data-system-chooser-open>
              See the system
            </button>

            <a class="btn btn--secondary" href="#book-demo" data-demo-cta>Book a demo</a>

          </div>
        </div>
        <div class="hero103__media" aria-hidden="true">
          <article class="hero103__panel hero103__panel--main">
            <p class="hero103__panel-label">Operations overview</p>
            <div class="hero103__kpis">
              <div class="hero103__kpi">
                <span>Today bookings</span>
                <strong>18</strong>
              </div>
              <div class="hero103__kpi">
                <span>Pickup orders</span>
                <strong>7</strong>
              </div>
              <div class="hero103__kpi">
                <span>Client enquiries</span>
                <strong>5</strong>
              </div>
            </div>
            <div class="hero103__schedule">
              <span>Jordan</span>
              <div class="hero103__progress"><i style="width: 78%"></i></div>
            </div>
            <div class="hero103__schedule">
              <span>Marcus</span>
              <div class="hero103__progress"><i style="width: 62%"></i></div>
            </div>
            <div class="hero103__schedule">
              <span>Levi</span>
              <div class="hero103__progress"><i style="width: 85%"></i></div>
            </div>
          </article>

          <article class="hero103__panel hero103__panel--bookings">
            <p class="hero103__panel-label">Bookings</p>
            <p class="hero103__panel-value">12:30 Fade + Beard</p>
            <small>2 seats available</small>
          </article>

          <article class="hero103__panel hero103__panel--schedule">
            <p class="hero103__panel-label">Barber schedule</p>
            <p class="hero103__panel-value">4 shifts live</p>
            <small>Next break 14:00</small>
          </article>

          <article class="hero103__panel hero103__panel--shop">
            <p class="hero103__panel-label">Shop pickup</p>
            <p class="hero103__panel-value">Pomade + Brush</p>
            <small>Order #249 ready</small>
          </article>

          <article class="hero103__panel hero103__panel--admin">
            <p class="hero103__panel-label">Admin enquiries</p>
            <p class="hero103__panel-value">3 new messages</p>
            <small>Response rate 98%</small>
          </article>

        </div>
      </div>
    </section>
    
    <div class="system-chooser" data-system-chooser hidden>
      <div class="system-chooser__backdrop" data-system-chooser-close aria-hidden="true"></div>
      <section
        class="system-chooser__dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="system-chooser-title"
        aria-describedby="system-chooser-description"
      >
        <div class="system-chooser__header">
          <div>
            <p class="system-chooser__eyebrow">Guided demo entry</p>
            <h2 id="system-chooser-title">Explore the barber system</h2>
            <p id="system-chooser-description">Choose the part of the barber system you want to explore first.</p>
          </div>
          <button
            class="system-chooser__close"
            type="button"
            data-system-chooser-close
            aria-label="Close system chooser"
          >
            ×
          </button>
        </div>

        <div class="system-chooser__grid">
          <article class="system-chooser__tile system-chooser__tile--default" role="link" tabindex="0" data-tile-href="/book">
            <span class="system-chooser__tile-badge" aria-hidden="true">Start here</span>

            <h3>Client Booking Flow</h3>
                        <p>See how clients choose services and lock in appointments.</p>
            <p class="system-chooser__tile-meta">No password needed</p>

          </article>

          <article class="system-chooser__tile system-chooser__tile--admin" role="link" tabindex="0" data-tile-href="/admin?section=bookings_dashboard">
            <span class="system-chooser__tile-badge" aria-hidden="true">Admin view</span>
            <h3>Bookings Dashboard</h3>
            <p>View schedules, bookings and daily availability in the admin.</p>
            <div class="system-chooser__auth-note">
              <p>Protected demo area</p>
              <p>Password: <strong>{DEMO_ADMIN_PASSWORD}</strong></p>
              <button
                class="system-chooser__copy-password"
                type="button"
                data-copy-password
                data-password={DEMO_ADMIN_PASSWORD}
              >
                <span data-copy-label>Copy password</span>
              </button>
            </div>
          </article>


          <article class="system-chooser__tile system-chooser__tile--admin" role="link" tabindex="0" data-tile-href="/admin?section=shop_products">
            <span class="system-chooser__tile-badge" aria-hidden="true">Retail admin</span>

            <h3>Shop &amp; Pickup</h3>
            <p>Open the retail area and manage pickup-ready products.</p>
            <div class="system-chooser__auth-note">
              <p>Protected demo area</p>
              <p>Password: <strong>{DEMO_ADMIN_PASSWORD}</strong></p>
              <button
                class="system-chooser__copy-password"
                type="button"
                data-copy-password
                data-password={DEMO_ADMIN_PASSWORD}
              >
                <span data-copy-label>Copy password</span>
              </button>
            </div>
          </article>

        </div>
      </section>
    </div>


    <TrustStrip3 />
    <Compare3 />
    <Feature261 />
    <Feature228 />
    <Timeline13 />
    <Hero108 />
    <SettingsIntegrations3a />
    <ShopProductCards6 />
    <Faq4 />
    <Cta10 />
    <Contact16 />
    <Footer50
      heading="Ready to Fill Your Chairs?"
      description="Book a quick strategy call and we will map a predictable outreach plan for your barbershop in under 20 minutes."
      ctaText="Book a Strategy Call"
      ctaHref="#"
      brandName="Kersivo"
      navigation={[
        { name: 'Services', href: '#' },
        { name: 'Case Studies', href: '#' },
        { name: 'Pricing', href: '#' },
        { name: 'FAQ', href: '#' },
        { name: 'Contact', href: '#' }
      ]}
      social={[
        { name: 'Instagram', href: '#' },
        { name: 'Facebook', href: '#' }
      ]}
      legal={[
        { name: 'Privacy Policy', href: '#' },
        { name: 'Terms', href: '#' }
      ]}
    />
  </main>
</MainLayout>

<script>
  
  const demoCtas = document.querySelectorAll('[data-demo-cta]');
  const demoSection = document.querySelector('#book-demo');
    const demoForm = document.querySelector('.contact16__form');
  const DEMO_MESSAGE = "Hi, I’m interested in a barber website demo with bookings, admin and retail features.";

  const applyDemoPrefill = () => {
    if (!(demoForm instanceof HTMLFormElement)) return;

    const messageField = demoForm.querySelector('[data-demo-message]');
    const intentField = demoForm.querySelector('[data-demo-intent]');

    if (intentField instanceof HTMLInputElement) {
      intentField.value = 'demo';
    }

    if (!(messageField instanceof HTMLTextAreaElement)) return;

    const currentValue = messageField.value.trim();

    if (!currentValue || currentValue === DEMO_MESSAGE) {
      messageField.value = DEMO_MESSAGE;
    }
  };

  demoCtas.forEach((demoCta) => {
    if (!(demoCta instanceof HTMLAnchorElement || demoCta instanceof HTMLButtonElement)) return;


    demoCta.addEventListener('click', () => {
      applyDemoPrefill();

      if (demoSection instanceof HTMLElement) {
        window.requestAnimationFrame(() => {
          demoSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
    });
});


  const chooser = document.querySelector('[data-system-chooser]');
  const openTrigger = document.querySelector('[data-system-chooser-open]');

  if (chooser && openTrigger) {
    const closeTriggers = chooser.querySelectorAll('[data-system-chooser-close]');
    const focusTarget = chooser.querySelector('.system-chooser__close');
    let isChooserOpen = false;

    const setChooserOpen = (nextOpen) => {
      isChooserOpen = nextOpen;
      chooser.hidden = !nextOpen;
      chooser.setAttribute('aria-hidden', String(!nextOpen));
      document.body.classList.toggle('body--modal-open', nextOpen);

      if (nextOpen) {
        focusTarget?.focus();
      } else {
        openTrigger.focus();
      }
    };
    const openChooser = () => {
      setChooserOpen(true);
    };

    const closeChooser = () => {
      setChooserOpen(false);
    };
    setChooserOpen(false);
    openTrigger.addEventListener('click', openChooser);
    closeTriggers.forEach((trigger) => trigger.addEventListener('click', closeChooser));
    const navigateToTile = (target) => {
      if (!(target instanceof HTMLElement)) return;
      const tile = target.closest('[data-tile-href]');
      if (!(tile instanceof HTMLElement)) return;
      const href = tile.dataset.tileHref;
      if (!href) return;
      closeChooser();
      window.location.href = href;
    };


    chooser.addEventListener('click', (event) => {
     const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      if (target.closest('[data-copy-password]')) return;
      navigateToTile(target);
    });

    chooser.addEventListener('keydown', (event) => {
      if (!(event.target instanceof HTMLElement)) return;
      if (!event.target.closest('[data-tile-href]')) return;
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      navigateToTile(event.target);
    });

    const copyPasswordButtons = chooser.querySelectorAll('[data-copy-password]');
        const copyWithClipboardApi = async (value) => {
      if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') {
        return false;
      }

      await navigator.clipboard.writeText(value);
      return true;
    };

    const copyWithExecCommandFallback = (value) => {
      const tempTextarea = document.createElement('textarea');
      tempTextarea.value = value;
      tempTextarea.setAttribute('readonly', 'true');
      tempTextarea.setAttribute('aria-hidden', 'true');
      tempTextarea.style.position = 'fixed';
      tempTextarea.style.top = '-9999px';
      tempTextarea.style.left = '-9999px';
      tempTextarea.style.opacity = '0';

      document.body.append(tempTextarea);
      tempTextarea.focus();
      tempTextarea.select();
      tempTextarea.setSelectionRange(0, tempTextarea.value.length);

      let copied = false;
      try {
        copied = document.execCommand('copy');
      } catch {
        copied = false;
      }

      tempTextarea.remove();
      return copied;
    };

    const copyPasswordText = async (value) => {
      try {
        const copiedWithClipboard = await copyWithClipboardApi(value);
        if (copiedWithClipboard) return true;
      } catch {
        // continue to fallback for mobile browsers with restricted Clipboard API support
      }

      return copyWithExecCommandFallback(value);
    };


    copyPasswordButtons.forEach((button) => {
      button.addEventListener('click', async (event) => {
        event.stopPropagation();
        event.preventDefault();

        const buttonElement = event.currentTarget;
        if (!(buttonElement instanceof HTMLButtonElement)) return;

        const password = buttonElement.dataset.password ?? '';
        const label = buttonElement.querySelector('[data-copy-label]');
        if (!password || !(label instanceof HTMLElement)) return;

        const originalText = 'Copy password';
        const copied = await copyPasswordText(password);
        if (copied) {
          label.textContent = 'Copied';
          buttonElement.disabled = true;
          window.setTimeout(() => {
            label.textContent = originalText;
            buttonElement.disabled = false;
          }, 1200);
          return;
        }
        
        label.textContent = 'Copy failed';
        window.setTimeout(() => {
          label.textContent = originalText;
        }, 1200);
      });

    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isChooserOpen) {
        closeChooser();
      }
    });
  }
</script>
