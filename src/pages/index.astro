---
import LandingLayout from '@/layouts/LandingLayout.astro';
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE } from '@/lib/seo/defaults';
import Faq4 from '@/components/faq4.astro';
import Contact16 from '@/components/contact16.astro';
import LandingDemoCapture from '@/components/landingDemoCapture.astro';
import LandingFinalCta from '@/components/landingFinalCta.astro';
import SystemChooser from '@/components/SystemChooser.astro';
import LandingValueCards from '@/components/landingValueCards.astro';
import LandingDemoPreview from '@/components/landingDemoPreview.astro';
import LandingPostPurchaseSteps from '@/components/landingPostPurchaseSteps.astro';
import LandingSwitcherReassurance from '@/components/landingSwitcherReassurance.astro';
import LandingDifference from '@/components/landingDifference.astro';
import Footer50 from '@/components/footer50.astro';
import {
  BARBERSHOP_BOOKING_FAQ_ITEMS,
  buildBarbershopBookingFaqJsonLd,
} from '@/lib/seo/barbershopBookingFaq';
import { getFooterSocialLinks } from '@/lib/seo/footerSocialLinks';
import { resolveLandingDemoCarouselProducts } from '@/lib/shop/landingDemoCarouselProducts';
import { resolveLandingDemoBarbers } from '@/lib/landing/landingDemoBarbers';
import { resolveLandingBookingData } from '@/lib/landing/landingBookingData';
import { Pricing36 } from '../components/pricing36';
import { RateCard1 } from '../components/rateCard1';
import { SHOW_SETUP_PLAN_CARDS } from '@/lib/pricing/offerMode';
import BarbershopBookingHero from '@/components/barbershopBookingHero.astro';
import '../styles/components/system-chooser.css';
import '../styles/components/hero227.css';
import '../styles/components/landingValueCards.css';

const [carouselProducts, demoBarbers, landingBookingData] = await Promise.all([
  resolveLandingDemoCarouselProducts(),
  resolveLandingDemoBarbers(),
  resolveLandingBookingData(),
]);
const currentYear = new Date().getFullYear();
---

<LandingLayout
  title={DEFAULT_TITLE}
  description={DEFAULT_DESCRIPTION}
  canonicalPath="/"
  jsonLd={buildBarbershopBookingFaqJsonLd()}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/hero/phone-5.webp"
    fetchpriority="high"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/brand/logo-navbar-228.webp"
  />
  <main class="landing-overflow-guard">
    <SystemChooser />
    <BarbershopBookingHero />
    <LandingValueCards />
    <LandingDemoPreview retailProducts={carouselProducts} barbers={demoBarbers} bookingData={landingBookingData} />
    {SHOW_SETUP_PLAN_CARDS ? (
      <Pricing36 client:visible={{ rootMargin: '200px' }} variant="landing" />
    ) : null}
    <RateCard1 variant="landing" />
    <LandingDemoCapture />
    <LandingPostPurchaseSteps />
    <LandingSwitcherReassurance />
    <LandingDifference />
    <Faq4
      className="faq4--landing"
      heading="Questions before you choose your setup?"
      subHeading="Clear answers on commission, fees, switching, setup and what happens after purchase."
      supportHeading="Still deciding?"
      supportText="Explore the live demo or go straight to your setup package when you are ready."
      supportLinkLabel="Get started"
      supportLinkHref="#pricing"
      supportSecondaryLinkLabel="View Live Demo"
      supportSecondaryLinkOpensDemo={true}
      faqs={BARBERSHOP_BOOKING_FAQ_ITEMS}
    />
    <LandingFinalCta />
    <Contact16
      submitLabel="↳ Ask About My Setup"
      title="NOT READY TO CHOOSE A SETUP YET?"
      description="Tell us about your barbershop and we’ll point you to the right KERSIVO setup."
      note="No pressure. We’ll reply with the clearest next step for your shop."
    />
    <Footer50
      heading="Your booking. Your brand. Zero KERSIVO commission."
      description="Whether you are switching from a marketplace profile or starting your first system, we set you up in about two weeks — with 0% KERSIVO commission on bookings and retail."
      ctaText="PLAN MY SETUP"
      ctaHref="#pricing"
      ctaIsDemo={false}
      ctaTrack="plan_my_setup_click"
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      navigation={[
        { name: 'Pricing', href: '#pricing' },
        { name: 'FAQ', href: '#faq' },
        { name: 'Contact', href: '#contact' },
      ]}
      social={getFooterSocialLinks()}
      legal={[
        { name: 'Privacy Policy', href: '/privacy' },
        { name: 'Cookie Policy', href: '/cookies' },
        { name: 'Cookie settings', href: '#cookie-settings' },
        { name: 'Terms', href: '/terms' },
      ]}
    />
  </main>
</LandingLayout>

<script>
  import { initSystemChooser } from '@/lib/initSystemChooser';

  const scheduleInit = () => {
    requestAnimationFrame(() => initSystemChooser());
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleInit, { once: true });
  } else {
    scheduleInit();
  }
</script>

<script>
  import { initFeature261StaggerReveal } from '@/lib/landing/initFeature261StaggerReveal';

  const scheduleInit = () => {
    requestAnimationFrame(() => initFeature261StaggerReveal());
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleInit, { once: true });
  } else {
    scheduleInit();
  }
</script>

<script>
  import { initShop6Carousels } from '@/lib/shop/initShop6Carousel';

  initShop6Carousels();
</script>

<style>
  .landing-overflow-guard {
    overflow-x: clip;
  }
</style>
