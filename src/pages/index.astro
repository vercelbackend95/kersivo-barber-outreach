---
import MainLayout from '@/layouts/MainLayout.astro';
import '../styles/components/hero.css';
import '../styles/components/stats10.css';
import '../styles/components/compare3.css';
import '../styles/components/timeline13.css';
import Stats10 from '../components/stats10.astro';
import Compare3 from '../components/compare3.astro';
import Timeline13 from '../components/timeline13.astro';
import Feature43 from '../components/feature43.astro';
import Feature228 from '../components/feature228.astro';
import '../styles/components/feature43.css';
import '../styles/components/feature228.css';
import '../styles/components/hero108.css';
import Hero108 from '../components/hero108.astro';
import SettingsIntegrations3a from '../components/settingsIntegrations3a.astro';
import ShopProductCards6 from '../components/shopProductCards6.astro';
import '../styles/components/settingsIntegrations3a.css';
import '../styles/components/shopProductCards6.css';
import Faq4 from '../components/faq4.astro';
import Cta10 from '../components/cta10.astro';
import '../styles/components/faq4.css';
import '../styles/components/cta10.css';
import Contact16 from '../components/contact16.astro';
import '../styles/components/contact16.css';
import Footer50 from '../components/footer50.astro';
import '../styles/components/footer50.css';

---

<MainLayout title="Kersivo Barber Outreach">
  <main class="hero103">
    <section class="hero103__section">
      <div class="container hero103__layout">
        <div class="hero103__content">
          <p class="hero103__eyebrow">Barber website system</p>
          <h1>A Barber Website That Books, Sells and Keeps the Shop Running</h1>

          <p class="hero103__lead">
            Give clients a clean way to book, browse products and contact your shop — while you
            manage schedules, updates and pickup orders in one place.

          </p>
          <div class="hero103__actions">
            <a class="btn btn--primary" href="#">See the system</a>
            <a class="btn btn--secondary" href="#">Book a demo</a>

          </div>
        </div>
        <div class="hero103__media" aria-hidden="true">
          <article class="hero103__panel hero103__panel--main">
            <p class="hero103__panel-label">Operations overview</p>
            <div class="hero103__kpis">
              <div class="hero103__kpi">
                <span>Today bookings</span>
                <strong>18</strong>
              </div>
              <div class="hero103__kpi">
                <span>Pickup orders</span>
                <strong>7</strong>
              </div>
              <div class="hero103__kpi">
                <span>Client enquiries</span>
                <strong>5</strong>
              </div>
            </div>
            <div class="hero103__schedule">
              <span>Jordan</span>
              <div class="hero103__progress"><i style="width: 78%"></i></div>
            </div>
            <div class="hero103__schedule">
              <span>Marcus</span>
              <div class="hero103__progress"><i style="width: 62%"></i></div>
            </div>
            <div class="hero103__schedule">
              <span>Levi</span>
              <div class="hero103__progress"><i style="width: 85%"></i></div>
            </div>
          </article>

          <article class="hero103__panel hero103__panel--bookings">
            <p class="hero103__panel-label">Bookings</p>
            <p class="hero103__panel-value">12:30 Fade + Beard</p>
            <small>2 seats available</small>
          </article>

          <article class="hero103__panel hero103__panel--schedule">
            <p class="hero103__panel-label">Barber schedule</p>
            <p class="hero103__panel-value">4 shifts live</p>
            <small>Next break 14:00</small>
          </article>

          <article class="hero103__panel hero103__panel--shop">
            <p class="hero103__panel-label">Shop pickup</p>
            <p class="hero103__panel-value">Pomade + Brush</p>
            <small>Order #249 ready</small>
          </article>

          <article class="hero103__panel hero103__panel--admin">
            <p class="hero103__panel-label">Admin enquiries</p>
            <p class="hero103__panel-value">3 new messages</p>
            <small>Response rate 98%</small>
          </article>

        </div>
      </div>
    </section>
    <Stats10 />
    <Compare3 />
    <Feature43 />
    <Feature228 />
    <Timeline13 />
    <Hero108 />
    <SettingsIntegrations3a />
    <ShopProductCards6 />
    <Faq4 />
    <Cta10 />
    <Contact16 />
    <Footer50
      heading="Ready to Fill Your Chairs?"
      description="Book a quick strategy call and we will map a predictable outreach plan for your barbershop in under 20 minutes."
      ctaText="Book a Strategy Call"
      ctaHref="#"
      brandName="Kersivo"
      navigation={[
        { name: 'Services', href: '#' },
        { name: 'Case Studies', href: '#' },
        { name: 'Pricing', href: '#' },
        { name: 'FAQ', href: '#' },
        { name: 'Contact', href: '#' }
      ]}
      social={[
        { name: 'Instagram', href: '#' },
        { name: 'Facebook', href: '#' }
      ]}
      legal={[
        { name: 'Privacy Policy', href: '#' },
        { name: 'Terms', href: '#' }
      ]}
    />
  </main>
</MainLayout>

