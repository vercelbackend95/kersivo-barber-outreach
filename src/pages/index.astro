---
import MainLayout from '@/layouts/MainLayout.astro';
import { buildFaqJsonLd } from '@/lib/seo/faqJsonLd';
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE } from '@/lib/seo/defaults';
import '../styles/components/system-chooser.css';
import '../styles/components/compare3.css';
import '../styles/components/brandValues.css';
import '../styles/components/audiencePicker.css';
import '../styles/components/newcomerPath.css';
import '../styles/components/trustBlock.css';
import BrandValues from '../components/brandValues.astro';
import AudiencePicker from '../components/audiencePicker.astro';
import NewcomerPath from '../components/newcomerPath.astro';
import TrustBlock from '../components/trustBlock.astro';
import { Feature261 } from '../components/feature261';
import { Process2 } from '../components/process2';
import '../styles/components/shopProductCards6.css';
import { Pricing36 } from '../components/pricing36';
import { RateCard1 } from '../components/rateCard1';
import '../styles/pricing36.css';
import '../styles/rateCard1.css';
import Faq4 from '../components/faq4.astro';
import Cta10 from '../components/cta10.astro';
import '../styles/components/faq4.css';
import '../styles/components/cta10.css';
import Contact16 from '../components/contact16.astro';
import '../styles/components/contact16.css';
import Footer50 from '../components/footer50.astro';
import '../styles/components/footer50.css';
import { getFooterSocialLinks } from '@/lib/seo/footerSocialLinks';
import '../styles/components/feature261.css';
import '../styles/components/migrationGuide.css';
import MigrationGuide from '../components/migrationGuide.astro';
import '../styles/components/process2.css';
import '../styles/components/hero227.css';
import { Hero227 } from '../components/hero227';
import SystemChooser from '../components/SystemChooser.astro';
import { fetchCarouselProducts } from '@/lib/shop/carouselProducts';

const carouselProducts = await fetchCarouselProducts();

---

<MainLayout
  title={DEFAULT_TITLE}
  description={DEFAULT_DESCRIPTION}
  canonicalPath="/"
  barberDemoJsonLd={true}
  jsonLd={buildFaqJsonLd()}
>
    <main>

    <SystemChooser />

    <Hero227 client:load />

    <BrandValues />
    <AudiencePicker />
    <MigrationGuide />
    <NewcomerPath />
    <Feature261 retailProducts={carouselProducts} />
    <Pricing36 client:load />
    <RateCard1 />
    <Process2 client:load />
    <TrustBlock />
    <Faq4 />
    <Cta10 />
    <Contact16 />
    <Footer50
      heading="Your booking. Your brand. Zero commission."
      description="Whether you are switching from Booksy/Fresha or starting your first system, we set you up in about two weeks and never take a cut of your bookings."
      ctaText="PLAN MY SETUP"

      ctaHref="#book-demo"
      ctaIsDemo={true}
      brandName="Kersivo"
      navigation={[
        { name: 'Home', href: '#home' },
        { name: 'Paths', href: '#paths' },
        { name: 'Pricing', href: '#pricing' },
        { name: 'FAQ', href: '#faq' },
        { name: 'Contact', href: '#contact' },
        { name: 'Barbershop Booking System', href: '/barbershop-booking-system' },
        { name: 'Retail Demo', href: '/shop' }
      ]}
            social={getFooterSocialLinks()}
      legal={[
        { name: 'Privacy Policy', href: '/privacy' },
        { name: 'Terms', href: '/terms' }
      ]}
    />
  </main>
</MainLayout>
<script>
  const demoCtas = document.querySelectorAll('[data-demo-cta]');
  const demoSection = document.querySelector('#book-demo');
    const demoForm = document.querySelector('.contact16__form');
  const DEMO_MESSAGE = "Hi, I'm interested in setting up Kersivo with bookings, admin and retail features.";

  const applyDemoPrefill = () => {
    if (!(demoForm instanceof HTMLFormElement)) return;

    const messageField = demoForm.querySelector('[data-demo-message]');
    const intentField = demoForm.querySelector('[data-demo-intent]');

    if (intentField instanceof HTMLInputElement) {
      intentField.value = 'setup';
    }

    if (!(messageField instanceof HTMLTextAreaElement)) return;

    const currentValue = messageField.value.trim();

    if (!currentValue || currentValue === DEMO_MESSAGE) {
      messageField.value = DEMO_MESSAGE;
    }
  };

  demoCtas.forEach((demoCta) => {
    if (!(demoCta instanceof HTMLAnchorElement || demoCta instanceof HTMLButtonElement)) return;


    demoCta.addEventListener('click', () => {
      applyDemoPrefill();

      if (demoSection instanceof HTMLElement) {
        window.requestAnimationFrame(() => {
          demoSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
    });
});


  const initFeature261StaggerReveal = () => {
    const section = document.querySelector('.feature261');
    if (!(section instanceof HTMLElement)) return;

    const cards = Array.from(section.querySelectorAll('[data-feature261-card]'));
    if (cards.length === 0) return;

    const revealCard = (card, index) => {
      if (!(card instanceof HTMLElement)) return;
      card.style.transitionDelay = `${index * 140}ms`;
      card.dataset.feature261Visible = 'true';
    };

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    section.dataset.feature261Enhanced = 'true';

    cards.forEach((card) => {
      if (!(card instanceof HTMLElement)) return;
      card.dataset.feature261Visible = 'false';
    });

    if (prefersReducedMotion || !('IntersectionObserver' in window)) {
      cards.forEach((card, index) => revealCard(card, index));
      return;
    }

    let hasRevealed = false;
    const observer = new IntersectionObserver(
      (entries) => {
        const shouldReveal = entries.some((entry) => entry?.isIntersecting);
        if (!shouldReveal || hasRevealed) return;

        hasRevealed = true;
        cards.forEach((card, index) => revealCard(card, index));
        observer.disconnect();
      },
      {
        threshold: 0.01,
        rootMargin: '0px 0px -6% 0px',
      },
    );
    cards.forEach((card) => {
      if (!(card instanceof HTMLElement)) return;
      observer.observe(card);
    });
  };

  initFeature261StaggerReveal();

  const comparisonToggle = document.querySelector('[data-comparison-toggle]');
  const comparisonPanel = document.getElementById('mg-comparison-panel');
  const comparisonAutoOpenLinks = document.querySelectorAll('[data-comparison-auto-open]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const setComparisonOpen = (nextOpen, { focusToggle = false } = {}) => {
    if (!(comparisonPanel instanceof HTMLElement) || !(comparisonToggle instanceof HTMLButtonElement)) {
      return;
    }

    const showLabel = comparisonToggle.dataset.comparisonLabelShow ?? 'See full comparison';
    const hideLabel = comparisonToggle.dataset.comparisonLabelHide ?? 'Hide comparison';

    comparisonToggle.setAttribute('aria-expanded', String(nextOpen));
    comparisonToggle.textContent = nextOpen ? hideLabel : showLabel;

    if (nextOpen) {
      comparisonPanel.hidden = false;
      window.requestAnimationFrame(() => {
        comparisonPanel.classList.add('mg__comparison--open');
      });
    } else {
      comparisonPanel.classList.remove('mg__comparison--open');

      const finishCollapse = () => {
        if (comparisonToggle.getAttribute('aria-expanded') !== 'false') {
          return;
        }
        comparisonPanel.hidden = true;
      };

      if (prefersReducedMotion) {
        finishCollapse();
      } else {
        window.setTimeout(finishCollapse, 300);
      }
    }

    if (focusToggle) {
      comparisonToggle.focus();
    }
  };

  const openComparisonFromDeepLink = () => {
    const migrationSection = document.getElementById('migration');
    if (!(migrationSection instanceof HTMLElement)) {
      return;
    }

    setComparisonOpen(true);

    window.requestAnimationFrame(() => {
      migrationSection.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' });
    });
  };

  if (comparisonToggle && comparisonPanel) {
    comparisonToggle.addEventListener('click', () => {
      const isOpen = comparisonToggle.getAttribute('aria-expanded') === 'true';
      setComparisonOpen(!isOpen);
    });

    comparisonAutoOpenLinks.forEach((link) => {
      link.addEventListener('click', () => {
        window.setTimeout(() => {
          openComparisonFromDeepLink();
        }, 0);
      });
    });

    const handleComparisonHash = () => {
      if (window.location.hash === '#switcher-path') {
        openComparisonFromDeepLink();
      }
    };

    handleComparisonHash();
    window.addEventListener('hashchange', handleComparisonHash);
  }
</script>

<script>
  import { initSystemChooser } from '@/lib/initSystemChooser';

  initSystemChooser();
</script>

<script>
  import { initShop6Carousels } from '@/lib/shop/initShop6Carousel';

  initShop6Carousels();
</script>
