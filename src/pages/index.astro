---
import MainLayout from '@/layouts/MainLayout.astro';
import '../styles/components/hero.css';
import '../styles/components/compare3.css';
import '../styles/components/trustStrip3.css';
import { TrustStrip3 } from '../components/trustStrip3';
import Compare3 from '../components/compare3.astro';
import { Feature261 } from '../components/feature261';
import { Process2 } from '../components/process2';
import Feature228 from '../components/feature228.astro';
import '../styles/components/hero108.css';
import Hero108 from '../components/hero108.astro';
import SettingsIntegrations3a from '../components/settingsIntegrations3a.astro';
import ShopProductCards6 from '../components/shopProductCards6.astro';
import '../styles/components/settingsIntegrations3a.css';
import '../styles/components/shopProductCards6.css';
import { Pricing36 } from '../components/pricing36';
import { RateCard1 } from '../components/rateCard1';
import '../styles/pricing36.css';
import '../styles/rateCard1.css';
import Faq4 from '../components/faq4.astro';
import Cta10 from '../components/cta10.astro';
import '../styles/components/faq4.css';
import '../styles/components/cta10.css';
import Contact16 from '../components/contact16.astro';
import '../styles/components/contact16.css';
import Footer50 from '../components/footer50.astro';
import '../styles/components/footer50.css';
import '../styles/components/feature261.css';
import '../styles/components/feature228.css';
import '../styles/components/process2.css';
const DEMO_ADMIN_PASSWORD = import.meta.env.PUBLIC_DEMO_ADMIN_PASSWORD
  ?? import.meta.env.PUBLIC_ADMIN_DEMO_PASSWORD
  ?? import.meta.env.ADMIN_SECRET
  ?? 'demo-access';


---

<MainLayout title="Kersivo — Barber website, bookings & retail (UK)">
    <main class="hero10">
    <section id="home" class="hero10__section">
      <div class="hero10__bg" aria-hidden="true">
        <div class="hero10__bg-layer hero10__bg-layer--grid"></div>
        <div class="hero10__bg-layer hero10__bg-layer--radial"></div>
        <div class="hero10__bg-layer hero10__bg-layer--grain"></div>
        <div class="hero10__bg-layer hero10__bg-layer--panel"></div>
      </div>

      <div class="container hero10__container">

        <!-- COPY SIDE -->
        <div class="hero10__content">
          <span class="hero10__badge">BARBER WEBSITE SYSTEM</span>

          <h1 class="hero10__title">
            <span class="hero10__title-line">CLIENTS BOOK ONLINE.</span>
            <span class="hero10__title-line">NO PLATFORM FEES.</span>
            <span class="hero10__title-line">ONE SYSTEM.</span>
          </h1>

          <p class="hero10__lead">
            Give clients a clean way to book and shop — while you manage bookings, retail orders and daily updates from one dashboard.
          </p>

          <div class="hero10__proofline" role="list" aria-label="Key facts">
            <span class="hero10__proof-chip" role="listitem">
              <span class="hero10__proof-dot" aria-hidden="true"></span>
              Live in 14 days
            </span>
            <span class="hero10__proof-chip" role="listitem">
              <span class="hero10__proof-dot" aria-hidden="true"></span>
              No third-party fees
            </span>
            <span class="hero10__proof-chip" role="listitem">
              <span class="hero10__proof-dot" aria-hidden="true"></span>
              Bookings, retail &amp; admin in one
            </span>
          </div>

          <ul class="hero10__impact" aria-label="Core advantages">
            <li class="hero10__impact-item">
              <svg class="hero10__impact-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.25"/>
                <path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div class="hero10__impact-text">
                <strong>Keep 100% of every booking</strong>
                <span>No platform taking a cut — revenue goes straight to your shop.</span>
              </div>
            </li>
            <li class="hero10__impact-item">
              <svg class="hero10__impact-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <rect x="1.5" y="3" width="13" height="10" rx="1" stroke="currentColor" stroke-width="1.25"/>
                <path d="M1.5 7h13M5 3V1.5M11 3V1.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
              </svg>
              <div class="hero10__impact-text">
                <strong>One dashboard for everything</strong>
                <span>Bookings, retail and admin — not spread across 3 separate apps.</span>
              </div>
            </li>
            <li class="hero10__impact-item">
              <svg class="hero10__impact-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.25"/>
                <path d="M8 4.5V8l2.5 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div class="hero10__impact-text">
                <strong>Up and running in 14 days</strong>
                <span>Full system from day one — no months of agency back-and-forth.</span>
              </div>
            </li>
          </ul>

          <div class="hero10__actions-wrap">
            <div class="hero10__actions">
              <button class="btn btn--primary" type="button" data-system-chooser-open>
                SEE THE SYSTEM
              </button>
              <a class="btn btn--secondary" href="#book-demo" data-demo-cta>BOOK A DEMO</a>
            </div>
            <p class="hero10__actions-note">
              Live demo — explore booking flow, admin and retail. No signup needed.
            </p>
          </div>
        </div>

        <!-- PRODUCT VISUAL SIDE -->
        <div class="hero10__visual" aria-hidden="true">
          <div class="hero10__product">
            <!-- Browser chrome -->
            <div class="hero10__product-chrome">
              <span class="hero10__product-dots">
                <i></i><i></i><i></i>
              </span>
              <span class="hero10__product-url">kersivo.com/admin</span>
            </div>
            <!-- App layout -->
            <div class="hero10__product-app">
              <aside class="hero10__product-sidebar">
                <div class="hero10__product-logomark">K</div>
                <nav class="hero10__product-nav">
                  <span class="hero10__product-nav-item is-active">
                    <svg viewBox="0 0 14 14" fill="none"><rect x="1" y="2" width="12" height="10" rx="1" stroke="currentColor" stroke-width="1.2"/><path d="M1 6h12M5 2V1M9 2V1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                  </span>
                  <span class="hero10__product-nav-item">
                    <svg viewBox="0 0 14 14" fill="none"><path d="M2 4h10l-1 7H3L2 4z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M5 4V3a2 2 0 014 0v1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                  </span>
                  <span class="hero10__product-nav-item">
                    <svg viewBox="0 0 14 14" fill="none"><circle cx="7" cy="5" r="2.5" stroke="currentColor" stroke-width="1.2"/><path d="M2.5 12c0-2.5 2-3.5 4.5-3.5s4.5 1 4.5 3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                  </span>
                  <span class="hero10__product-nav-item">
                    <svg viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="2" stroke="currentColor" stroke-width="1.2"/><path d="M7 1v1.5M7 11.5V13M1 7h1.5M11.5 7H13M2.5 2.5l1 1M10.5 10.5l1 1M2.5 11.5l1-1M10.5 3.5l1-1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                  </span>
                </nav>
              </aside>
              <!-- Main content area -->
              <div class="hero10__product-main">
                <div class="hero10__product-topbar">
                  <div>
                    <p class="hero10__product-shop">FADE &amp; EDGE</p>
                    <p class="hero10__product-today">Mon 31 Mar &middot; 12 bookings</p>
                  </div>
                  <span class="hero10__product-live">&#x25CF; Live</span>
                </div>
                <div class="hero10__product-stats">
                  <div class="hero10__product-stat">
                    <span class="hero10__product-stat-val">12</span>
                    <span class="hero10__product-stat-label">Bookings</span>
                  </div>
                  <div class="hero10__product-stat is-accent">
                    <span class="hero10__product-stat-val">&pound;840</span>
                    <span class="hero10__product-stat-label">Revenue</span>
                  </div>
                  <div class="hero10__product-stat">
                    <span class="hero10__product-stat-val">3</span>
                    <span class="hero10__product-stat-label">Orders</span>
                  </div>
                </div>
                <p class="hero10__product-section">Today's Schedule</p>
                <div class="hero10__product-slots">
                  <div class="hero10__product-slot is-done">
                    <span class="hero10__product-slot-time">09:00</span>
                    <div class="hero10__product-slot-info">
                      <span class="hero10__product-slot-name">Marcus T.</span>
                      <span class="hero10__product-slot-svc">Fade + Beard &middot; 45 min</span>
                    </div>
                    <span class="hero10__product-slot-barber">Jay</span>
                    <span class="hero10__product-slot-badge is-confirmed">Done</span>
                  </div>
                  <div class="hero10__product-slot is-done">
                    <span class="hero10__product-slot-time">09:45</span>
                    <div class="hero10__product-slot-info">
                      <span class="hero10__product-slot-name">Jamie K.</span>
                      <span class="hero10__product-slot-svc">Skin Fade &middot; 30 min</span>
                    </div>
                    <span class="hero10__product-slot-barber">Leo</span>
                    <span class="hero10__product-slot-badge is-confirmed">Done</span>
                  </div>
                  <div class="hero10__product-slot is-now">
                    <span class="hero10__product-slot-time">10:30</span>
                    <div class="hero10__product-slot-info">
                      <span class="hero10__product-slot-name">Ryan O.</span>
                      <span class="hero10__product-slot-svc">Beard Shape &middot; 20 min</span>
                    </div>
                    <span class="hero10__product-slot-barber">Jay</span>
                    <span class="hero10__product-slot-badge is-now">Now</span>
                  </div>
                  <div class="hero10__product-slot">
                    <span class="hero10__product-slot-time">14:30</span>
                    <div class="hero10__product-slot-info">
                      <span class="hero10__product-slot-name">Daniel W.</span>
                      <span class="hero10__product-slot-svc">Full Groom &middot; 60 min</span>
                    </div>
                    <span class="hero10__product-slot-barber">Leo</span>
                    <span class="hero10__product-slot-badge">14:30</span>
                  </div>
                </div>
                <div class="hero10__product-toast">
                  <span class="hero10__product-toast-dot"></span>
                  <span>New: James K. booked Skin Fade &middot; 16:00 today</span>
                </div>
              </div>
            </div>
          </div>
          <!-- Floating pill badge -->
          <div class="hero10__visual-pill">
            <span class="hero10__visual-pill-dot"></span>
            <div>
              <p class="hero10__visual-pill-label">Pickup ready</p>
              <p class="hero10__visual-pill-val">Order #47 &middot; &pound;32.50</p>
            </div>
          </div>
        </div>

      </div>
    </section>
    
    <div class="system-chooser" data-system-chooser hidden>
      <div class="system-chooser__backdrop" data-system-chooser-close aria-hidden="true"></div>
      <section
        class="system-chooser__dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="system-chooser-title"
        aria-describedby="system-chooser-description"
      >
        <div class="system-chooser__header">
          <div class="system-chooser__header-copy">
            <p class="system-chooser__eyebrow">Live demo &middot; 3 areas to explore</p>
            <h2 id="system-chooser-title">Choose your entry point</h2>
            <p id="system-chooser-description" class="system-chooser__header-lead">Each demo opens in a new tab — close it to return here.</p>
          </div>
          <button
            class="system-chooser__close"
            type="button"
            data-system-chooser-close
            aria-label="Close system chooser"
          >
            <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <div class="system-chooser__grid">

          <!-- Tile 1: Client Booking Flow -->
          <article
            class="system-chooser__tile system-chooser__tile--featured"
            role="link"
            tabindex="0"
            data-tile-href="/book"
          >
            <div class="system-chooser__tile-preview" aria-hidden="true">
              <img
                src="/hero-assets/screens/booking.webp"
                alt=""
                class="system-chooser__tile-img"
                loading="eager"
                decoding="async"
                width="600"
                height="400"
              />
              <div class="system-chooser__tile-preview-overlay"></div>
              <span class="system-chooser__tile-badge">Start here</span>
            </div>
            <div class="system-chooser__tile-body">
              <h3>Client Booking Flow</h3>
              <p class="system-chooser__tile-desc">Exactly what your clients see — pick a barber, choose a service and lock in a slot in under a minute.</p>
              <div class="system-chooser__tile-footer">
                <span class="system-chooser__tile-access">
                  <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.2"/><path d="M4 6l1.5 1.5 2.5-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  No password
                </span>
                <span class="system-chooser__tile-footer-sep" aria-hidden="true"></span>
                <span class="system-chooser__tile-tab">
                  <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M5 2H2.5a.5.5 0 00-.5.5v7a.5.5 0 00.5.5h7a.5.5 0 00.5-.5V7M7.5 2H10v2.5M6 6l4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  New tab
                </span>
              </div>
              <p class="system-chooser__tile-loading" role="status" aria-live="polite">
                <span class="system-chooser__tile-spinner" aria-hidden="true"></span>
                <span>Opening demo&hellip;</span>
              </p>
            </div>
          </article>

          <!-- Tile 2: Bookings Dashboard -->
          <article
            class="system-chooser__tile"
            role="link"
            tabindex="0"
            data-tile-href="/admin?section=bookings_dashboard"
          >
            <div class="system-chooser__tile-preview" aria-hidden="true">
              <img
                src="/hero-assets/screens/timeline.webp"
                alt=""
                class="system-chooser__tile-img"
                loading="eager"
                decoding="async"
                width="600"
                height="400"
              />
              <div class="system-chooser__tile-preview-overlay"></div>
              <span class="system-chooser__tile-badge">Admin view</span>
            </div>
            <div class="system-chooser__tile-body">
              <h3>Bookings Dashboard</h3>
              <p class="system-chooser__tile-desc">The owner's daily view — schedule per barber, live statuses, cancellations and updates in one screen.</p>
              <div class="system-chooser__tile-footer">
                <span class="system-chooser__tile-access">
                  <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><rect x="3" y="5.5" width="6" height="5" rx=".5" stroke="currentColor" stroke-width="1.2"/><path d="M4.5 5.5V4a1.5 1.5 0 013 0v1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                  Password auto-filled
                </span>
                <span class="system-chooser__tile-footer-sep" aria-hidden="true"></span>
                <span class="system-chooser__tile-tab">
                  <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M5 2H2.5a.5.5 0 00-.5.5v7a.5.5 0 00.5.5h7a.5.5 0 00.5-.5V7M7.5 2H10v2.5M6 6l4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  New tab
                </span>
              </div>
              <p class="system-chooser__tile-loading" role="status" aria-live="polite">
                <span class="system-chooser__tile-spinner" aria-hidden="true"></span>
                <span>Opening demo&hellip;</span>
              </p>
            </div>
          </article>

          <!-- Tile 3: Shop & Pickup -->
          <article
            class="system-chooser__tile"
            role="link"
            tabindex="0"
            data-tile-href="/admin?section=shop_products"
          >
            <div class="system-chooser__tile-preview" aria-hidden="true">
              <img
                src="/hero-assets/screens/shop.webp"
                alt=""
                class="system-chooser__tile-img"
                loading="eager"
                decoding="async"
                width="600"
                height="400"
              />
              <div class="system-chooser__tile-preview-overlay"></div>
              <span class="system-chooser__tile-badge">Retail admin</span>
            </div>
            <div class="system-chooser__tile-body">
              <h3>Shop &amp; Pickup</h3>
              <p class="system-chooser__tile-desc">Manage products, track orders and mark them ready for pickup — all from the same admin panel.</p>
              <div class="system-chooser__tile-footer">
                <span class="system-chooser__tile-access">
                  <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><rect x="3" y="5.5" width="6" height="5" rx=".5" stroke="currentColor" stroke-width="1.2"/><path d="M4.5 5.5V4a1.5 1.5 0 013 0v1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                  Password auto-filled
                </span>
                <span class="system-chooser__tile-footer-sep" aria-hidden="true"></span>
                <span class="system-chooser__tile-tab">
                  <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M5 2H2.5a.5.5 0 00-.5.5v7a.5.5 0 00.5.5h7a.5.5 0 00.5-.5V7M7.5 2H10v2.5M6 6l4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  New tab
                </span>
              </div>
              <p class="system-chooser__tile-loading" role="status" aria-live="polite">
                <span class="system-chooser__tile-spinner" aria-hidden="true"></span>
                <span>Opening demo&hellip;</span>
              </p>
            </div>
          </article>

        </div>
      </section>
    </div>


    <TrustStrip3 />
    <Compare3 />
    <Feature261 />
        <Process2 client:load />
    <Hero108 />
    <SettingsIntegrations3a />
    <ShopProductCards6 />
        <Pricing36 />
            <RateCard1 />
    <Faq4 />
    <Cta10 />
    <Contact16 />
    <Footer50
      heading="Ready to replace patchwork tools with one barber website system?"
      description="Book a demo and we’ll show which setup gives your shop cleaner operations and a stronger sales flow."
      ctaText="BOOK A DEMO"

      ctaHref="#book-demo"
      ctaIsDemo={true}
      brandName="Kersivo"
      navigation={[
        { name: 'Home', href: '#home' },
        { name: 'System', href: '#system' },
        { name: 'Pricing', href: '#pricing' },
        { name: 'FAQ', href: '#faq' },
        { name: 'Contact', href: '#contact' },
        { name: 'Shop', href: '/shop' }
      ]}
            social={[]}
      legal={[
        { name: 'Privacy Policy', href: '#' },
        { name: 'Terms', href: '#' }
      ]}
    />
  </main>
</MainLayout>
<script define:vars={{ DEMO_ADMIN_SECRET: DEMO_ADMIN_PASSWORD }}>
  const ADMIN_SECRET_STORAGE_KEY = 'kersivo.admin.secret';


  const demoCtas = document.querySelectorAll('[data-demo-cta]');
  const demoSection = document.querySelector('#book-demo');
    const demoForm = document.querySelector('.contact16__form');
  const DEMO_MESSAGE = "Hi, I’m interested in a barber website demo with bookings, admin and retail features.";

  const applyDemoPrefill = () => {
    if (!(demoForm instanceof HTMLFormElement)) return;

    const messageField = demoForm.querySelector('[data-demo-message]');
    const intentField = demoForm.querySelector('[data-demo-intent]');

    if (intentField instanceof HTMLInputElement) {
      intentField.value = 'demo';
    }

    if (!(messageField instanceof HTMLTextAreaElement)) return;

    const currentValue = messageField.value.trim();

    if (!currentValue || currentValue === DEMO_MESSAGE) {
      messageField.value = DEMO_MESSAGE;
    }
  };

  demoCtas.forEach((demoCta) => {
    if (!(demoCta instanceof HTMLAnchorElement || demoCta instanceof HTMLButtonElement)) return;


    demoCta.addEventListener('click', () => {
      applyDemoPrefill();

      if (demoSection instanceof HTMLElement) {
        window.requestAnimationFrame(() => {
          demoSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
    });
});


  const chooser = document.querySelector('[data-system-chooser]');
  const openTriggers = document.querySelectorAll('[data-system-chooser-open]');

  if (chooser && openTriggers.length > 0) {
    const closeTriggers = chooser.querySelectorAll('[data-system-chooser-close]');
    const focusTarget = chooser.querySelector('.system-chooser__close');
    let isChooserOpen = false;
    let lastOpenTrigger = null;
    const setChooserOpen = (nextOpen) => {
      isChooserOpen = nextOpen;
      chooser.hidden = !nextOpen;
      chooser.setAttribute('aria-hidden', String(!nextOpen));
      document.body.classList.toggle('body--modal-open', nextOpen);

      if (nextOpen) {
                window.requestAnimationFrame(() => {
          if (focusTarget instanceof HTMLElement) {
            focusTarget.focus();
          }
        });
      } else if (lastOpenTrigger instanceof HTMLElement) {
        lastOpenTrigger.focus();
      }
    };
    const handleClose = () => {
      if (!isChooserOpen) {
        return;
      }
      setChooserOpen(false);

    };
    setChooserOpen(false);
    openTriggers.forEach((trigger) => {
      if (!(trigger instanceof HTMLButtonElement)) {
        return;
      }

      trigger.addEventListener('click', () => {
        lastOpenTrigger = trigger;
        setChooserOpen(true);
      });
    });
    closeTriggers.forEach((trigger) => {
      trigger.addEventListener('click', handleClose);
    });

    chooser.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        handleClose();
      }
    });

    const tiles = chooser.querySelectorAll('[data-tile-href]');
    let tileNavigationInFlight = false;

    const setTileLoadingState = (activeTile) => {
      chooser.classList.add('system-chooser--navigating');
      tiles.forEach((tile) => {
        if (!(tile instanceof HTMLElement)) {
          return;
        }

        const isActive = tile === activeTile;
        tile.classList.toggle('is-loading', isActive);
        tile.setAttribute('aria-busy', String(isActive));
      });
    };

    const resetTileLoadingState = () => {
      tileNavigationInFlight = false;
      chooser.classList.remove('system-chooser--navigating');
      tiles.forEach((t) => {
        if (!(t instanceof HTMLElement)) return;
        t.classList.remove('is-loading');
        t.setAttribute('aria-busy', 'false');
      });
    };

    const activateTile = (tile) => {
      if (tileNavigationInFlight) {
        return;
      }

      const href = tile.getAttribute('data-tile-href');
      if (!href) {
        return;
      }
      tileNavigationInFlight = true;
      setTileLoadingState(tile);

      if (href.startsWith('/admin')) {
        try {
          localStorage.setItem(ADMIN_SECRET_STORAGE_KEY, DEMO_ADMIN_SECRET);
        } catch {
          // Ignore storage failures to avoid breaking navigation.
        }
      }

      // Brief visual feedback before opening new tab
      setTimeout(() => {
        window.open(href, '_blank', 'noopener');
        // Reset tile state — user stays on this page after new tab opens
        setTimeout(resetTileLoadingState, 600);
      }, 260);
    };

    tiles.forEach((tile) => {
      if (!(tile instanceof HTMLElement)) {
        return;
      }
      
      tile.addEventListener('click', () => {
        activateTile(tile);
      });

      tile.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activateTile(tile);
        }
      });
    });
  }
    const initFeature261StaggerReveal = () => {
    const section = document.querySelector('.feature261');
    if (!(section instanceof HTMLElement)) return;

    const cards = Array.from(section.querySelectorAll('[data-feature261-card]'));
    if (cards.length === 0) return;

    const revealCard = (card, index) => {
      if (!(card instanceof HTMLElement)) return;
      card.style.transitionDelay = `${index * 140}ms`;
      card.dataset.feature261Visible = 'true';
    };

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    section.dataset.feature261Enhanced = 'true';

    cards.forEach((card) => {
      if (!(card instanceof HTMLElement)) return;
      card.dataset.feature261Visible = 'false';
    });

    if (prefersReducedMotion || !('IntersectionObserver' in window)) {
      cards.forEach((card, index) => revealCard(card, index));
      return;
    }

    let hasRevealed = false;
    const observer = new IntersectionObserver(
      (entries) => {
        const shouldReveal = entries.some((entry) => entry?.isIntersecting);
        if (!shouldReveal || hasRevealed) return;

        hasRevealed = true;
        cards.forEach((card, index) => revealCard(card, index));
        observer.disconnect();
      },
      {
        threshold: 0.01,
        rootMargin: '0px 0px -6% 0px',
      },
    );
    cards.forEach((card) => {
      if (!(card instanceof HTMLElement)) return;
      observer.observe(card);
    });
  };

  initFeature261StaggerReveal();
</script>
