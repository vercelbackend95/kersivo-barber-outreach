---
import MainLayout from '@/layouts/MainLayout.astro';
import '../styles/components/hero.css';
import '../styles/components/compare3.css';
import '../styles/components/trustStrip3.css';
import { TrustStrip3 } from '../components/trustStrip3';
import Compare3 from '../components/compare3.astro';
import { Feature261 } from '../components/feature261';
import { Process2 } from '../components/process2';
import Feature228 from '../components/feature228.astro';
import '../styles/components/hero108.css';
import Hero108 from '../components/hero108.astro';
import SettingsIntegrations3a from '../components/settingsIntegrations3a.astro';
import ShopProductCards6 from '../components/shopProductCards6.astro';
import '../styles/components/settingsIntegrations3a.css';
import '../styles/components/shopProductCards6.css';
import { Pricing36 } from '../components/pricing36';
import { RateCard1 } from '../components/rateCard1';
import '../styles/pricing36.css';
import '../styles/rateCard1.css';
import Faq4 from '../components/faq4.astro';
import Cta10 from '../components/cta10.astro';
import '../styles/components/faq4.css';
import '../styles/components/cta10.css';
import Contact16 from '../components/contact16.astro';
import '../styles/components/contact16.css';
import Footer50 from '../components/footer50.astro';
import '../styles/components/footer50.css';
import '../styles/components/feature261.css';
import '../styles/components/feature228.css';
import '../styles/components/process2.css';
const DEMO_ADMIN_PASSWORD = import.meta.env.PUBLIC_DEMO_ADMIN_PASSWORD
  ?? import.meta.env.PUBLIC_ADMIN_DEMO_PASSWORD
  ?? import.meta.env.ADMIN_SECRET
  ?? 'demo-access';


---

<MainLayout title="Kersivo Barber Outreach">
    <main class="hero10">
    <section id="home" class="hero10__section">
      <div class="container hero10__container">
        <div class="hero10__content">
          <span class="hero10__badge">BARBER WEBSITE SYSTEM</span>
          <h1 class="hero10__title">A BARBER WEBSITE WITH BOOKINGS, RETAIL AND REAL SHOP CONTROL</h1>
          <p class="hero10__lead">
Built for bookings, retail and day-to-day barber shop control
          </p>
          <div class="hero10__actions">
            <button class="btn btn--primary" type="button" data-system-chooser-open>
              Get Started
            </button>
            <a class="btn btn--secondary" href="#book-demo" data-demo-cta>Learn More</a>

          </div>
          <div class="hero10__logos">
            <p>Powering the next generation of digital products</p>
            <div class="hero10__logo-grid">

              <img
                src="https://deifkwefumgah.cloudfront.net/shadcnblocks/block/logos/shadcn-ui-wordmark.svg"
                alt="ShadCN UI"
                class="hero10__logo hero10__logo--invert"
                loading="lazy"
              />
              <img
                src="https://deifkwefumgah.cloudfront.net/shadcnblocks/block/logos/vercel-wordmark.svg"
                alt="Vercel"
                class="hero10__logo hero10__logo--invert"
                loading="lazy"
              />
              <img
                src="https://deifkwefumgah.cloudfront.net/shadcnblocks/block/logos/supabase-wordmark.svg"
                alt="Supabase"
                class="hero10__logo hero10__logo--light"
                loading="lazy"
              />
              <img
                src="https://deifkwefumgah.cloudfront.net/shadcnblocks/block/logos/supabase-wordmark-dark.svg"
                alt="Supabase dark"
                class="hero10__logo hero10__logo--dark"
                loading="lazy"
              />
              <img
                src="https://deifkwefumgah.cloudfront.net/shadcnblocks/block/logos/tailwind-wordmark-light.svg"
                alt="Tailwind CSS"
                class="hero10__logo hero10__logo--light"
                loading="lazy"
              />
              <img
                src="https://deifkwefumgah.cloudfront.net/shadcnblocks/block/logos/tailwind-wordmark-dark.svg"
                alt="Tailwind CSS dark"
                class="hero10__logo hero10__logo--dark"
                loading="lazy"

              />

            </div>


          </div>



        </div>
      </div>
    </section>
    
    <div class="system-chooser" data-system-chooser hidden>
      <div class="system-chooser__backdrop" data-system-chooser-close aria-hidden="true"></div>
      <section
        class="system-chooser__dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="system-chooser-title"
        aria-describedby="system-chooser-description"
      >
        <div class="system-chooser__header">
          <div>
            <p class="system-chooser__eyebrow">Guided demo entry</p>
            <h2 id="system-chooser-title">Explore the barber system</h2>
            <p id="system-chooser-description">Choose the part of the barber system you want to explore first.</p>
          </div>
          <button
            class="system-chooser__close"
            type="button"
            data-system-chooser-close
            aria-label="Close system chooser"
          >
            ×
          </button>
        </div>

        <div class="system-chooser__grid">
          <article class="system-chooser__tile system-chooser__tile--default" role="link" tabindex="0" data-tile-href="/book">
            <span class="system-chooser__tile-badge" aria-hidden="true">Start here</span>

            <h3>Client Booking Flow</h3>
                        <p>See how clients choose services and lock in appointments.</p>
            <p class="system-chooser__tile-meta">No password needed</p>

          </article>

          <article class="system-chooser__tile system-chooser__tile--admin" role="link" tabindex="0" data-tile-href="/admin?section=bookings_dashboard">
            <span class="system-chooser__tile-badge" aria-hidden="true">Admin view</span>
            <h3>Bookings Dashboard</h3>
            <p>Preview schedules, bookings and day-to-day admin in the guided demo view.</p>
          </article>


          <article class="system-chooser__tile system-chooser__tile--admin" role="link" tabindex="0" data-tile-href="/admin?section=shop_products">
            <span class="system-chooser__tile-badge" aria-hidden="true">Retail admin</span>

            <h3>Shop &amp; Pickup</h3>
            <p>Open the retail demo to explore pickup-ready products and admin tools.</p>
          </article>

        </div>
      </section>
    </div>


    <TrustStrip3 />
    <Compare3 />
    <Feature261 />
        <Process2 client:load />
    <Hero108 />
    <SettingsIntegrations3a />
    <ShopProductCards6 />
        <Pricing36 />
            <RateCard1 />
    <Faq4 />
    <Cta10 />
    <Contact16 />
    <Footer50
      heading="Ready to launch a better website system for your barbershop?"
      description="Book a demo and we’ll help you choose the right setup for your website, booking flow, shop and admin tools."
      ctaText="BOOK A DEMO"

      ctaHref="#book-demo"
      ctaIsDemo={true}
      brandName="Kersivo"
      navigation={[
        { name: 'Services', href: '#' },
        { name: 'Case Studies', href: '#' },
        { name: 'Pricing', href: '#' },
        { name: 'FAQ', href: '#' },
        { name: 'Contact', href: '#' }
      ]}
      social={[
        { name: 'Instagram', href: '#' },
        { name: 'Facebook', href: '#' }
      ]}
      legal={[
        { name: 'Privacy Policy', href: '#' },
        { name: 'Terms', href: '#' }
      ]}
    />
  </main>
</MainLayout>
<script define:vars={{ DEMO_ADMIN_SECRET: DEMO_ADMIN_PASSWORD }}>
  const ADMIN_SECRET_STORAGE_KEY = 'kersivo.admin.secret';


  const demoCtas = document.querySelectorAll('[data-demo-cta]');
  const demoSection = document.querySelector('#book-demo');
    const demoForm = document.querySelector('.contact16__form');
  const DEMO_MESSAGE = "Hi, I’m interested in a barber website demo with bookings, admin and retail features.";

  const applyDemoPrefill = () => {
    if (!(demoForm instanceof HTMLFormElement)) return;

    const messageField = demoForm.querySelector('[data-demo-message]');
    const intentField = demoForm.querySelector('[data-demo-intent]');

    if (intentField instanceof HTMLInputElement) {
      intentField.value = 'demo';
    }

    if (!(messageField instanceof HTMLTextAreaElement)) return;

    const currentValue = messageField.value.trim();

    if (!currentValue || currentValue === DEMO_MESSAGE) {
      messageField.value = DEMO_MESSAGE;
    }
  };

  demoCtas.forEach((demoCta) => {
    if (!(demoCta instanceof HTMLAnchorElement || demoCta instanceof HTMLButtonElement)) return;


    demoCta.addEventListener('click', () => {
      applyDemoPrefill();

      if (demoSection instanceof HTMLElement) {
        window.requestAnimationFrame(() => {
          demoSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
    });
});


  const chooser = document.querySelector('[data-system-chooser]');
  const openTriggers = document.querySelectorAll('[data-system-chooser-open]');

  if (chooser && openTriggers.length > 0) {
    const closeTriggers = chooser.querySelectorAll('[data-system-chooser-close]');
    const focusTarget = chooser.querySelector('.system-chooser__close');
    let isChooserOpen = false;
    let lastOpenTrigger = null;
    const setChooserOpen = (nextOpen) => {
      isChooserOpen = nextOpen;
      chooser.hidden = !nextOpen;
      chooser.setAttribute('aria-hidden', String(!nextOpen));
      document.body.classList.toggle('body--modal-open', nextOpen);

      if (nextOpen) {
                window.requestAnimationFrame(() => {
          if (focusTarget instanceof HTMLElement) {
            focusTarget.focus();
          }
        });
      } else if (lastOpenTrigger instanceof HTMLElement) {
        lastOpenTrigger.focus();
      }
    };
    const handleClose = () => {
      if (!isChooserOpen) {
        return;
      }


    };
    setChooserOpen(false);
    openTriggers.forEach((trigger) => {
      if (!(trigger instanceof HTMLButtonElement)) {
        return;
      }

      trigger.addEventListener('click', () => {
        lastOpenTrigger = trigger;
        setChooserOpen(true);
      });
    });
    closeTriggers.forEach((trigger) => {
      trigger.addEventListener('click', handleClose);
    });

    chooser.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        handleClose();
      }
    });

    const tiles = chooser.querySelectorAll('[data-tile-href]');

    const activateTile = (tile) => {
      const href = tile.getAttribute('data-tile-href');
      if (!href) {
        return;
      }

      if (href.startsWith('/admin')) {
        try {
          localStorage.setItem(ADMIN_SECRET_STORAGE_KEY, DEMO_ADMIN_SECRET);
        } catch {
          // Ignore storage failures to avoid breaking navigation.
        }
      }

      window.location.assign(href);
    };

    tiles.forEach((tile) => {
      if (!(tile instanceof HTMLElement)) {
        return;
      }
      
      tile.addEventListener('click', () => {
        activateTile(tile);
      });

      tile.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activateTile(tile);
        }
      });
    });
  }
</script>
