---
import LandingLayout from '@/layouts/LandingLayout.astro';
import { DEFAULT_TITLE, getHomepageDescription } from '@/lib/seo/defaults';
import Faq4 from '@/components/faq4.astro';
import Contact16 from '@/components/contact16.astro';
import LandingFinalCta from '@/components/landingFinalCta.astro';
import LandingDemoPreview from '@/components/landingDemoPreview.astro';
import LandingPostPurchaseSteps from '@/components/landingPostPurchaseSteps.astro';
import LandingSwitcherReassurance from '@/components/landingSwitcherReassurance.astro';
import LandingDifference from '@/components/landingDifference.astro';
import Footer50 from '@/components/footer50.astro';
import { buildHomepageJsonLd } from '@/lib/seo/barberDemoJsonLd';
import { getHomepageFaqItems } from '@/lib/seo/barbershopBookingFaq';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import {
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';
import { RateCard1 } from '../components/rateCard1';
import HomepageHero from '@/components/homepage/HomepageHero.astro';
import HomepagePricingNotes from '@/components/homepage/HomepagePricingNotes.astro';

const currentYear = new Date().getFullYear();
// FREE_PREVIEW_FLOW_ENABLED (docs/free-preview-spec.md §10.3); off renders the page unchanged.
const freePreview = isFreePreviewFlowEnabled();
const faqItems = getHomepageFaqItems(freePreview);
---

<LandingLayout
  title={DEFAULT_TITLE}
  description={getHomepageDescription(freePreview)}
  canonicalPath="/"
  jsonLd={buildHomepageJsonLd(freePreview)}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/brand/logo-navbar-228.webp"
  />
  <main class="landing-overflow-guard">
    <HomepageHero />
    <LandingDifference />
    <LandingDemoPreview />
    <RateCard1 variant="landing" freePreview={freePreview} />
    <HomepagePricingNotes />
    <LandingPostPurchaseSteps />
    <LandingSwitcherReassurance showBooksyCompareLink showFreshaCompareLink />
    <Faq4
      className="faq4--landing"
      heading="Questions about Full KERSIVO?"
      subHeading="Price, payments, setup, switching, your domain and cancelling."
      supportHeading="Still have a question?"
      supportText="Send us a message and we’ll give you a clear answer about your shop."
      supportLinkLabel="Ask a question"
      supportLinkHref="#contact"
      faqs={faqItems}
    />
    <Contact16
      eyebrow="CONTACT KERSIVO"
      submitLabel="Send my question"
      title="Tell us about your barbershop"
      description="Already have a booking system or a website? Tell us where you are today and what you want to change. We’ll reply with the relevant next steps."
      note="We’ll reply by email — no sales call required."
    />
    <LandingFinalCta />
    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      social={getFooterSocialLinks()}
    />
  </main>
</LandingLayout>

<script>
  import { initFeature261StaggerReveal } from '@/lib/landing/initFeature261StaggerReveal';

  const scheduleInit = () => {
    requestAnimationFrame(() => {
      const section = document.querySelector('.feature261');
      if (!(section instanceof HTMLElement) || section.dataset.feature261Enhanced === 'true') return;
      const cleanup = initFeature261StaggerReveal(section);
      document.addEventListener('astro:before-swap', cleanup, { once: true });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleInit, { once: true });
  } else {
    scheduleInit();
  }
  document.addEventListener('astro:page-load', scheduleInit);
</script>

<style>
  .landing-overflow-guard {
    overflow-x: clip;
  }
</style>
