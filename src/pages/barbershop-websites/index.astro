---
/**
 * /barbershop-websites — pillar for "barbershop website": why a shop needs its own site, what it should
 * include, how clients book and what a professional presence looks like, closing on Full KERSIVO.
 * Design-specific queries belong to /barbershop-website-design. The previous design is kept at
 * /design-preview/barbershop-websites-v1.
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import Footer50 from '@/components/footer50.astro';
import BwHero from '@/components/barbershopWebsite/BwHero.astro';
import BwSceneIndex from '@/components/barbershopWebsite/BwSceneIndex.astro';
import BwWhy from '@/components/barbershopWebsite/BwWhy.astro';
import BwAnatomy from '@/components/barbershopWebsite/BwAnatomy.astro';
import BwBooking from '@/components/barbershopWebsite/BwBooking.astro';
import BwPresence from '@/components/barbershopWebsite/BwPresence.astro';
import BwOffer from '@/components/barbershopWebsite/BwOffer.astro';
import BwFaqClose from '@/components/barbershopWebsite/BwFaqClose.astro';
import '@/styles/barbershop-website/page.css';
import '@/styles/barbershop-website/cinematic.css';
import '@/styles/barbershop-website/system.css';
import {
  BARBERSHOP_WEBSITES_PAGE_DESCRIPTION,
  BARBERSHOP_WEBSITES_PAGE_INDEXABLE,
  BARBERSHOP_WEBSITES_PAGE_PATH,
  BARBERSHOP_WEBSITES_PAGE_TITLE,
  buildBarbershopWebsitesJsonLd,
} from '@/lib/seo/barbershopWebsitesPage';
import {
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';

const currentYear = new Date().getFullYear();
---

<LandingLayout
  title={BARBERSHOP_WEBSITES_PAGE_TITLE}
  description={BARBERSHOP_WEBSITES_PAGE_DESCRIPTION}
  canonicalPath={BARBERSHOP_WEBSITES_PAGE_PATH}
  noindex={!BARBERSHOP_WEBSITES_PAGE_INDEXABLE}
  robotsFollow
  jsonLd={buildBarbershopWebsitesJsonLd()}
>
  <link slot="head" rel="preload" as="image" href="/images/barbershop-websites/site-hero-1100.webp" fetchpriority="high" />
  <main class="bw">
    <div class="bw-grain" aria-hidden="true"></div>
    <BwSceneIndex />
    <div class="bw-film" data-bw-film>
      <canvas class="bw-film__canvas" data-bw-film-canvas aria-hidden="true"></canvas>
      <BwHero />
      <BwWhy />
    </div>
    <BwAnatomy />
    <BwBooking />
    <BwPresence />
    <BwOffer />
    <BwFaqClose />
  </main>

  <Footer50
    showIntro={false}
    brandLine="Own your brand. Own your bookings."
    contactEmail={KERSIVO_CONTACT_EMAIL}
    brandName="KERSIVO"
    copyright={`© ${currentYear} KERSIVO`}
    social={getFooterSocialLinks()}
  />
</LandingLayout>

<script>
  import { initBarbershopWebsite } from '@/lib/barbershopWebsite/init';

  let cleanup: (() => void) | null = null;
  const start = () => {
    cleanup?.();
    cleanup = document.querySelector('.bw') ? initBarbershopWebsite(document) : null;
  };
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
