---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Footer50 from '@/components/footer50.astro';
import BarbershopWebsitesHero from '@/components/barbershop-websites/BarbershopWebsitesHero.astro';
import WhatIsBarbershopWebsite from '@/components/barbershop-websites/WhatIsBarbershopWebsite.astro';
import WebsiteEssentials from '@/components/barbershop-websites/WebsiteEssentials.astro';
import BrandToBooking from '@/components/barbershop-websites/BrandToBooking.astro';
import FullOffer from '@/components/barbershop-websites/FullOffer.astro';
import SetupProcess from '@/components/barbershop-websites/SetupProcess.astro';
import FaqAndClose from '@/components/barbershop-websites/FaqAndClose.astro';
import '@/styles/components/barbershop-websites-definition.css';
import {
  BARBERSHOP_WEBSITES_PAGE_DESCRIPTION,
  BARBERSHOP_WEBSITES_PAGE_INDEXABLE,
  BARBERSHOP_WEBSITES_PAGE_PATH,
  BARBERSHOP_WEBSITES_PAGE_TITLE,
  buildBarbershopWebsitesJsonLd,
} from '@/lib/seo/barbershopWebsitesPage';
import { BARBERSHOP_WEBSITE_DESIGN_PAGE_PATH } from '@/lib/seo/barbershopWebsiteDesignPage';
import { BARBERSHOP_ONLINE_BOOKING_PAGE_PATH } from '@/lib/seo/barbershopOnlineBookingPage';
import {
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';

const currentYear = new Date().getFullYear();
---

<LandingLayout
  title={BARBERSHOP_WEBSITES_PAGE_TITLE}
  description={BARBERSHOP_WEBSITES_PAGE_DESCRIPTION}
  canonicalPath={BARBERSHOP_WEBSITES_PAGE_PATH}
  noindex={!BARBERSHOP_WEBSITES_PAGE_INDEXABLE}
  robotsFollow
  jsonLd={buildBarbershopWebsitesJsonLd()}
>
  <main class="bsw-page">
    <BarbershopWebsitesHero />
    <WhatIsBarbershopWebsite />
    <WebsiteEssentials />
    <BrandToBooking />
    <FullOffer />
    <SetupProcess />
    <FaqAndClose />
  </main>

  <Footer50
    showIntro={false}
    brandLine="Own your brand. Own your bookings."
    contactEmail={KERSIVO_CONTACT_EMAIL}
    brandName="KERSIVO"
    copyright={`© ${currentYear} KERSIVO`}
    social={getFooterSocialLinks()}
  />
</LandingLayout>
