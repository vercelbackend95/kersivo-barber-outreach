---
import LandingLayout from '@/layouts/LandingLayout.astro';
import { SAAS_MONTHLY_GBP } from '@/lib/seo/defaults';
import { MARKETING_NAV_ICONS } from '@/lib/nav/marketingNavIcons';
import BarbershopShowcase from '@/components/barbershopWebsites/BarbershopShowcase.astro';
// Reuse the same hero typography and button styles as the KERSIVO homepage.
import '@/styles/components/homepage-hero.css';
import '@/styles/components/barbershop-websites-hero.css';

const title = 'Barbershop Websites UK | Design & Booking | KERSIVO';
const description = 'Professional barbershop websites on your own domain, with online booking and business tools. Full KERSIVO costs £39/month with no setup fee.';
---

<LandingLayout
  title={title}
  description={description}
  canonicalPath="/barbershop-websites"
  noindex={true}
  robotsFollow={false}
>
  <!-- STAGE 1 ONLY: non-indexed design review. Publish sitemap/schema + the remaining
       10 approved pillar sections together when the complete page passes QA. -->
  <main class="bw-page">
    <section class="bw-hero" aria-labelledby="bw-hero-heading">
      <div class="bw-hero__ambient" aria-hidden="true"></div>
      <div class="bw-container">
        <div class="bw-hero__intro">
          <p class="home-hero__eyebrow bw-hero__eyebrow"><span class="home-hero__eyebrow-dot" aria-hidden="true"></span>Barbershop websites</p>
          <h1 id="bw-hero-heading" class="home-hero__title bw-hero__title">Websites for barbershops<br class="bw-desktop-break" /> that are built to book.</h1>
          <p class="home-hero__lead bw-hero__lead">
            A professional website for your barbershop, with your own domain,
            online booking and the tools behind Full KERSIVO.
          </p>
          <p class="home-hero__meta bw-hero__price">
            <strong>£{SAAS_MONTHLY_GBP}/month</strong>
            <span aria-hidden="true">·</span>
            <span>No setup fee</span>
            <span aria-hidden="true">·</span>
            <span>0% KERSIVO commission</span>
          </p>
          <div class="home-hero__actions bw-hero__actions">
            <a class="home-hero__action home-hero__action--primary" href="/demo" data-track="view_live_demo_click" data-track-placement="barbershop_websites_hero">
              See a real working demo <span aria-hidden="true">↗</span>
            </a>
            <a class="home-hero__action home-hero__action--secondary" href="/pricing" data-track="barbershop_websites_full_click" data-track-placement="hero">
              Explore Full KERSIVO
            </a>
          </div>
        </div>

        <BarbershopShowcase />

        <ul class="bw-benefits" aria-label="Full KERSIVO website highlights">
          <li><svg class="bw-benefits__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={MARKETING_NAV_ICONS.overview} /></svg><span><strong>Own domain</strong><small>Your brand. Your domain.</small></span></li>
          <li><svg class="bw-benefits__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={MARKETING_NAV_ICONS.booking} /></svg><span><strong>Online booking</strong><small>A connected booking journey.</small></span></li>
          <li><svg class="bw-benefits__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={MARKETING_NAV_ICONS.system} /></svg><span><strong>Business tools</strong><small>Bookings, clients and more.</small></span></li>
        </ul>
        <p class="bw-hero__footnote">BLACKLINE BARBERS is a fictional KERSIVO demonstration. The previews are illustrative and do not show live availability. Standard Stripe processing fees apply to online payments.</p>
      </div>
    </section>
    <!-- SECTION 02–11 will be added sequentially following the approved master specification. -->
  </main>
</LandingLayout>
