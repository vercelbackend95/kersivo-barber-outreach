---
/**
 * /barbershop-price-list-template — the hero is the tool: the live sheet sits on the right of the
 * first screen and stays beside the form while the owner edits. Then one moment (the annotated
 * sheet), the UK pricing rules, where to use the list, related tools, FAQ and the closing CTA.
 * Client code: src/lib/priceList/initPriceListPage.ts (GSAP; nothing hidden under reduced motion).
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import Faq4 from '@/components/faq4.astro';
import Footer50 from '@/components/footer50.astro';
import ComparisonFinalCta from '@/components/comparison/ComparisonFinalCta.astro';
import { buildKersivoEntityJsonLd } from '@/lib/seo/kersivoEntityJsonLd';
import { KERSIVO_CONTACT_EMAIL, getFooterSocialLinks } from '@/lib/seo/footerSocialLinks';
import {
  PRICE_LIST_DURATION_OPTIONS,
  PRICE_LIST_FOOTER_MAX,
  PRICE_LIST_MAX_ITEMS,
  PRICE_LIST_NAME_MAX,
  PRICE_LIST_QUICK_ADD,
  PRICE_LIST_SHOP_MAX,
  PRICE_LIST_SUGGESTED_SERVICES,
  formatMinutes,
} from '@/lib/priceList/priceListText';
import {
  PRICE_LIST_DEFAULT_THEME,
  PRICE_LIST_THEMES,
  getPriceListTheme,
  priceListThemeStyle,
} from '@/lib/priceList/priceListThemes';
import { PRICE_LIST_FALLBACK_TITLE } from '@/lib/priceList/priceListImage';
import {
  PRICE_LIST_ANATOMY,
  PRICE_LIST_ANATOMY_LEAD,
  PRICE_LIST_ANATOMY_TITLE,
  PRICE_LIST_BREADCRUMB_NAME,
  PRICE_LIST_DESCRIPTION,
  PRICE_LIST_DIRECT_ANSWER,
  PRICE_LIST_EYEBROW,
  PRICE_LIST_FAIR_LEAD,
  PRICE_LIST_FAIR_NOTE,
  PRICE_LIST_FAIR_RULES,
  PRICE_LIST_FAIR_TITLE,
  PRICE_LIST_FAQ_ITEMS,
  PRICE_LIST_KEY_FACTS,
  PRICE_LIST_LAST_UPDATED_ISO,
  PRICE_LIST_LAST_UPDATED_LABEL,
  PRICE_LIST_PAGE_PATH,
  PRICE_LIST_PLACEMENTS,
  PRICE_LIST_PLACEMENTS_LEAD,
  PRICE_LIST_PLACEMENTS_TITLE,
  PRICE_LIST_RELATED_LINKS,
  PRICE_LIST_STEPS,
  PRICE_LIST_TITLE,
  buildPriceListJsonLd,
} from '@/lib/seo/priceListTemplatePage';
import '@/styles/components/ks-glass-card.css';
import '@/styles/components/price-list-template.css';

const currentYear = new Date().getFullYear();
const theme = getPriceListTheme(PRICE_LIST_DEFAULT_THEME);
const paper = getPriceListTheme('paper');
const [stepShop, stepServices, stepStyle, stepExport] = PRICE_LIST_STEPS;
const stepNumber = (index: number) => String(index + 1).padStart(2, '0');
const initialTotal = PRICE_LIST_SUGGESTED_SERVICES.length;
const RING = (2 * Math.PI * 15).toFixed(2);

const icons = {
  up: '<path d="m6 15 6-6 6 6"/>',
  down: '<path d="m6 9 6 6 6-6"/>',
  remove: '<path d="M18 6 6 18M6 6l12 12"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  print: '<path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M6 14h12v7H6z"/>',
  image: '<rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="9" r="2"/><path d="m21 15-4.5-4.5L6 21"/>',
  copy: '<rect x="8" y="8" width="13" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/>',
  check: '<path d="m5 12 5 5 9-10"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  pound: '<path d="M17 20H7c2-1.5 2.5-3.5 2.5-6V8.5a3.5 3.5 0 0 1 6.6-1.6"/><path d="M6.5 13h8"/>',
  receipt: '<path d="M5 3h14v18l-3-2-2 2-2-2-2 2-2-2-3 2z"/><path d="M9 8h6M9 12h6"/>',
  deposit: '<rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18M7 15h3"/>',
  sync: '<path d="M4 12a8 8 0 0 1 14-5.3L20 9"/><path d="M20 4v5h-5"/><path d="M20 12a8 8 0 0 1-14 5.3L4 15"/><path d="M4 20v-5h5"/>',
} as const;
type IconName = keyof typeof icons;
const svg = (name: IconName) =>
  `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name]}</svg>`;

const actionIcon: Record<'print' | 'image' | 'copy', IconName> = { print: 'print', image: 'image', copy: 'copy' };

/** Example sheet for the annotated moment: names and blanks only, never prices. */
const anatomyRows = [
  { name: 'Haircut', time: '30 min' },
  { name: 'Skin fade', time: '45 min' },
  { name: 'Scissor cut', time: '45 min' },
  { name: 'Beard trim', time: '20 min' },
  { name: 'Haircut and beard', time: '1 hr' },
  { name: 'Long or thick hair', time: '1 hr', from: true },
];
const ANATOMY_CORE_ROWS = 5;
---

<LandingLayout
  title={PRICE_LIST_TITLE}
  description={PRICE_LIST_DESCRIPTION}
  canonicalPath={PRICE_LIST_PAGE_PATH}
  jsonLd={[buildKersivoEntityJsonLd(), ...buildPriceListJsonLd()]}
>
  <main class="pl landing-overflow-guard" data-pl>
    <script is:inline>
      // Hide the hero pieces before first paint only when they will animate; a failsafe shows them.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('pl-js');
        window.setTimeout(function () {
          var hero = document.querySelector('[data-pl-hero]');
          if (hero) hero.classList.add('is-in');
        }, 2500);
      }
    </script>

    <!-- 1 · Hero and tool: the live sheet is the hero picture -->
    <section class="pl-studio" aria-labelledby="pl-title" data-pl-hero>
      <div class="pl-wrap pl-studio__grid">
        <header class="pl-intro">
          <nav class="pl-breadcrumb" aria-label="Breadcrumb" data-pl-enter>
            <ol>
              <li><a href="/">Home</a></li>
              <li aria-hidden="true">/</li>
              <li><span aria-current="page">{PRICE_LIST_BREADCRUMB_NAME}</span></li>
            </ol>
          </nav>
          <p class="ks-eyebrow" data-pl-enter>{PRICE_LIST_EYEBROW}</p>
          <h1 id="pl-title" class="pl-title">
            <span class="pl-title__line"><span class="pl-title__inner" data-pl-rise>Barber price</span></span>
            {' '}
            <span class="pl-title__line"><span class="pl-title__inner" data-pl-rise>list <em>template</em></span></span>
          </h1>
          <p class="pl-lead" data-pl-enter>{PRICE_LIST_DIRECT_ANSWER}</p>
          <dl class="pl-facts" data-pl-enter>
            {PRICE_LIST_KEY_FACTS.map((fact) => (
              <div class="pl-facts__item">
                <dt>{fact.term}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
          <p class="pl-updated" data-pl-enter>
            Updated <time datetime={PRICE_LIST_LAST_UPDATED_ISO}>{PRICE_LIST_LAST_UPDATED_LABEL}</time>
          </p>
        </header>

        <form id="pl-form" class="pl-form" novalidate data-pl-enter>
          <!-- Step 1 -->
          <div class="pl-step" id={`step-${stepShop.id}`}>
            <div class="pl-step__head">
              <span class="pl-step__num" aria-hidden="true">{stepNumber(0)}</span>
              <div>
                <h2 class="pl-step__title"><label for="pl-shop">{stepShop.name}</label></h2>
                <p class="pl-step__text">{stepShop.text}</p>
              </div>
            </div>
            <input
              id="pl-shop"
              name="shop"
              class="pl-input pl-input--hero"
              type="text"
              maxlength={PRICE_LIST_SHOP_MAX}
              autocomplete="organization"
              placeholder="Your barbershop"
            />
          </div>

          <!-- Step 2 -->
          <div class="pl-step" id={`step-${stepServices.id}`}>
            <div class="pl-step__head">
              <span class="pl-step__num" aria-hidden="true">{stepNumber(1)}</span>
              <div>
                <h2 class="pl-step__title" id="pl-services-title">{stepServices.name}</h2>
                <p class="pl-step__text">{stepServices.text}</p>
              </div>
            </div>

            <ol id="pl-rows" class="pl-rows" aria-labelledby="pl-services-title">
              {PRICE_LIST_SUGGESTED_SERVICES.map((service, index) => (
                <li class="pl-row" data-pl-row>
                  <span class="pl-row__index" aria-hidden="true" data-pl-index>{stepNumber(index)}</span>
                  <label class="pl-row__name">
                    <span class="sr-only">Service name</span>
                    <input class="pl-input" data-pl-name type="text" value={service} maxlength={PRICE_LIST_NAME_MAX} />
                  </label>
                  <div class="pl-row__move">
                    <button type="button" class="pl-icon-btn" data-pl-move="-1" aria-label={`Move ${service} up`} set:html={svg('up')} />
                    <button type="button" class="pl-icon-btn" data-pl-move="1" aria-label={`Move ${service} down`} set:html={svg('down')} />
                  </div>
                  <button type="button" class="pl-icon-btn pl-icon-btn--remove" data-pl-remove aria-label={`Remove ${service}`} set:html={svg('remove')} />
                  <label class="pl-row__price">
                    <span class="pl-row__prefix" aria-hidden="true">£</span>
                    <span class="sr-only" data-pl-price-label>{`Price of ${service} in pounds`}</span>
                    <input class="pl-input" data-pl-price type="text" inputmode="decimal" placeholder="Price" autocomplete="off" />
                  </label>
                  <label class="pl-row__time">
                    <span class="sr-only">Time</span>
                    <select class="pl-input" data-pl-minutes>
                      <option value="">No time</option>
                      {PRICE_LIST_DURATION_OPTIONS.map((m) => <option value={m}>{formatMinutes(m)}</option>)}
                    </select>
                  </label>
                  <label class="pl-toggle">
                    <input type="checkbox" data-pl-from />
                    <span class="pl-toggle__track" aria-hidden="true"></span>
                    <span>“from”</span>
                  </label>
                  <span class="pl-row__rate" data-pl-rate></span>
                </li>
              ))}
            </ol>
            <template id="pl-row-template">
              <li class="pl-row" data-pl-row>
                <span class="pl-row__index" aria-hidden="true" data-pl-index></span>
                <label class="pl-row__name">
                  <span class="sr-only">Service name</span>
                  <input class="pl-input" data-pl-name type="text" maxlength={PRICE_LIST_NAME_MAX} placeholder="New service" />
                </label>
                <div class="pl-row__move">
                  <button type="button" class="pl-icon-btn" data-pl-move="-1" aria-label="Move this service up" set:html={svg('up')} />
                  <button type="button" class="pl-icon-btn" data-pl-move="1" aria-label="Move this service down" set:html={svg('down')} />
                </div>
                <button type="button" class="pl-icon-btn pl-icon-btn--remove" data-pl-remove aria-label="Remove this service" set:html={svg('remove')} />
                <label class="pl-row__price">
                  <span class="pl-row__prefix" aria-hidden="true">£</span>
                  <span class="sr-only" data-pl-price-label>Price in pounds</span>
                  <input class="pl-input" data-pl-price type="text" inputmode="decimal" placeholder="Price" autocomplete="off" />
                </label>
                <label class="pl-row__time">
                  <span class="sr-only">Time</span>
                  <select class="pl-input" data-pl-minutes>
                    <option value="">No time</option>
                    {PRICE_LIST_DURATION_OPTIONS.map((m) => <option value={m}>{formatMinutes(m)}</option>)}
                  </select>
                </label>
                <label class="pl-toggle">
                  <input type="checkbox" data-pl-from />
                  <span class="pl-toggle__track" aria-hidden="true"></span>
                  <span>“from”</span>
                </label>
                <span class="pl-row__rate" data-pl-rate></span>
              </li>
            </template>

            <div class="pl-adders">
              <button id="pl-add" type="button" class="btn btn--secondary btn--md pl-add">
                <Fragment set:html={svg('plus')} />
                Add a service
              </button>
              <div class="pl-chips" role="group" aria-label="Quick add a common service">
                {PRICE_LIST_QUICK_ADD.map((name) => (
                  <button type="button" class="pl-chip" data-pl-quick={name} aria-label={`Add ${name}`}>
                    <span class="pl-chip__plus" aria-hidden="true">+</span>{name}
                  </button>
                ))}
              </div>
            </div>
            <p class="pl-limit" data-pl-limit hidden>That is the limit of {PRICE_LIST_MAX_ITEMS} services.</p>
          </div>

          <!-- Step 3 -->
          <div class="pl-step" id={`step-${stepStyle.id}`}>
            <div class="pl-step__head">
              <span class="pl-step__num" aria-hidden="true">{stepNumber(2)}</span>
              <div>
                <h2 class="pl-step__title">{stepStyle.name}</h2>
                <p class="pl-step__text">{stepStyle.text}</p>
              </div>
            </div>
            <fieldset class="pl-themes">
              <legend class="sr-only">Style</legend>
              {PRICE_LIST_THEMES.map((option) => (
                <label class="pl-theme" style={priceListThemeStyle(option)}>
                  <input type="radio" name="theme" value={option.id} checked={option.id === theme.id} />
                  <span class="pl-theme__swatch" aria-hidden="true">
                    <span class:list={['pl-theme__title', { 'pl-theme__title--ui': option.titleFace === 'ui' }]}>Aa</span>
                    <span class="pl-theme__rule"></span>
                    <span class="pl-theme__line"></span>
                    <span class="pl-theme__line"></span>
                    <span class="pl-theme__line pl-theme__line--short"></span>
                  </span>
                  <span class="pl-theme__label">
                    {option.label}
                    <span class="sr-only">: {option.hint}</span>
                  </span>
                </label>
              ))}
            </fieldset>
            <div class="pl-options">
              <label class="pl-toggle pl-toggle--wide">
                <input name="duration" type="checkbox" />
                <span class="pl-toggle__track" aria-hidden="true"></span>
                <span>Show times on the price list</span>
              </label>
              <div class="pl-field">
                <label for="pl-footer">Line at the bottom (optional)</label>
                <input
                  id="pl-footer"
                  name="footer"
                  class="pl-input"
                  type="text"
                  maxlength={PRICE_LIST_FOOTER_MAX}
                  placeholder="For example: Book online, link in bio"
                />
              </div>
            </div>
          </div>
        </form>

        <!-- Step 4 and the sheet (sticky beside the form on wide screens) -->
        <div class="pl-board" id={`step-${stepExport.id}`} data-pl-board>
          <div class="pl-board__inner ks-glass-card ks-glass-card--accent">
            <div class="pl-board__bar">
              <div class="pl-progress">
                <svg class="pl-progress__ring" viewBox="0 0 36 36" aria-hidden="true">
                  <circle cx="18" cy="18" r="15" class="pl-progress__track"></circle>
                  <circle
                    cx="18"
                    cy="18"
                    r="15"
                    class="pl-progress__value"
                    data-pl-ring
                    style={`stroke-dasharray:${RING};stroke-dashoffset:${RING}`}
                  ></circle>
                </svg>
                <p class="pl-progress__text">
                  <span data-pl-priced>0</span> of <span data-pl-total>{initialTotal}</span> priced
                </p>
              </div>
              <p class="pl-board__style">Style: <span data-pl-theme-label>{theme.label}</span></p>
            </div>

            <div class="pl-paper">
              <div
                id="pl-sheet"
                class:list={['pl-sheet', { 'pl-sheet--ui': theme.titleFace === 'ui' }]}
                data-theme={theme.id}
                style={priceListThemeStyle(theme)}
                role="region"
                aria-label="Price list preview"
                data-pl-sheet
              >
                <p class="pl-sheet__eyebrow" aria-hidden="true">Price list</p>
                <p class="pl-sheet__title" data-pl-sheet-title>{PRICE_LIST_FALLBACK_TITLE}</p>
                <ul class="pl-sheet__list" data-pl-sheet-list>
                  {PRICE_LIST_SUGGESTED_SERVICES.map((service) => (
                    <li class="pl-sheet__item">
                      <span class="pl-sheet__name">{service}</span>
                      <span class="pl-sheet__leader" aria-hidden="true"></span>
                      <span class="pl-sheet__price" data-missing="true">£—</span>
                    </li>
                  ))}
                </ul>
                <p class="pl-sheet__footer" data-pl-sheet-footer hidden></p>
              </div>
            </div>

            <h2 class="pl-board__title">{stepExport.name}</h2>
            <div class="pl-actions">
              <button type="button" class="btn btn--primary btn--md pl-action" data-pl-action="print">
                <Fragment set:html={svg('print')} />
                Print or save as PDF
              </button>
              <button type="button" class="btn btn--secondary btn--md pl-action" data-pl-action="image">
                <Fragment set:html={svg('image')} />
                Download image
              </button>
              <button type="button" class="btn btn--secondary btn--md pl-action pl-action--copy" data-pl-action="copy">
                <span class="pl-action__swap" aria-hidden="true">
                  <span class="pl-action__icon" set:html={svg('copy')} />
                  <span class="pl-action__icon pl-action__icon--done" set:html={svg('check')} />
                </span>
                <span>Copy as text</span>
              </button>
            </div>
            <p class="pl-missing" data-pl-missing hidden></p>
            <p class="pl-status" role="status" aria-live="polite" data-pl-status></p>
          </div>
        </div>
      </div>

      <!-- Phones and tablets: progress and a jump to the preview while the form is on screen -->
      <div class="pl-dock" data-pl-dock>
        <span class="pl-dock__text"><span data-pl-dock-priced>0</span> of <span data-pl-dock-total>{initialTotal}</span> priced</span>
        <a class="btn btn--primary btn--md pl-dock__btn" href={`#step-${stepExport.id}`}>See your price list</a>
      </div>
    </section>

    <!-- 2 · Moment: the annotated sheet. A ring glides to each part as its note reaches the middle of the screen. -->
    <section class="pl-section pl-anatomy" aria-labelledby="pl-anatomy-title" data-pl-anatomy>
      <div class="pl-wrap pl-anatomy__grid">
        <div class="pl-anatomy__stage">
          <div class="pl-sheet pl-anatomy__sheet" data-theme="paper" style={priceListThemeStyle(paper)} aria-hidden="true" data-pl-anatomy-sheet>
            <span class="pl-anatomy__ring" data-pl-anatomy-ring></span>
            <p class="pl-sheet__eyebrow">Price list</p>
            <p class="pl-sheet__title"><span data-part="title">Your barbershop</span></p>
            <ul class="pl-sheet__list">
              {anatomyRows.map((row, index) => (
                <li class="pl-sheet__item" data-part={index < ANATOMY_CORE_ROWS ? 'core' : undefined}>
                  <span class="pl-sheet__name">
                    <span data-part={index === 1 ? 'names' : undefined}>{row.name}</span>{' '}
                    <span class="pl-sheet__time" data-part={index === 1 ? 'time' : undefined}>{row.time}</span>
                  </span>
                  <span class="pl-sheet__leader"></span>
                  <span class="pl-sheet__price" data-part={row.from ? 'from' : undefined}>
                    {row.from && <span class="pl-sheet__from">from </span>}£<span class="pl-blank"></span>
                  </span>
                </li>
              ))}
            </ul>
            <p class="pl-sheet__footer"><span data-part="footer">Book online, link in bio. Deposit taken when you book.</span></p>
          </div>
        </div>

        <div class="pl-anatomy__copy">
          <div class="pl-head">
            <p class="ks-eyebrow">The parts of a good list</p>
            <h2 id="pl-anatomy-title" class="pl-h2">{PRICE_LIST_ANATOMY_TITLE}</h2>
            <p class="pl-head__lead">{PRICE_LIST_ANATOMY_LEAD}</p>
          </div>
          <ol class="pl-anatomy__list">
            {PRICE_LIST_ANATOMY.map((item, index) => (
              <li class="pl-anatomy__item" data-pl-part={item.part} data-active={index === 0 ? 'true' : 'false'}>
                <h3 class="pl-anatomy__heading">
                  <button type="button" class="pl-anatomy__btn" aria-pressed={index === 0 ? 'true' : 'false'} data-pl-part-btn={item.part}>
                    <span class="pl-anatomy__num" aria-hidden="true">{stepNumber(index)}</span>
                    <span>{item.heading}</span>
                  </button>
                </h3>
                <p>{item.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- 3 · Fair prices -->
    <section class="pl-section pl-fair" aria-labelledby="pl-fair-title">
      <div class="pl-wrap">
        <div class="pl-head pl-head--split">
          <div>
            <p class="ks-eyebrow">Before you print</p>
            <h2 id="pl-fair-title" class="pl-h2">{PRICE_LIST_FAIR_TITLE}</h2>
          </div>
          <p class="pl-head__lead">{PRICE_LIST_FAIR_LEAD}</p>
        </div>
        <ul class="pl-rules">
          {PRICE_LIST_FAIR_RULES.map((rule, index) => (
            <li class="pl-rule ks-glass-card">
              <div class="pl-rule__top">
                <span class="pl-rule__icon" set:html={svg(rule.icon)} />
                <span class="pl-rule__num" aria-hidden="true">{stepNumber(index)}</span>
              </div>
              <h3 class="pl-rule__title">{rule.heading}</h3>
              <p>{rule.text}</p>
            </li>
          ))}
        </ul>
        <p class="pl-note">{PRICE_LIST_FAIR_NOTE}</p>
      </div>
    </section>

    <!-- 4 · Where to use it: each tile runs the tool -->
    <section class="pl-section pl-places" aria-labelledby="pl-places-title">
      <div class="pl-wrap">
        <div class="pl-head pl-head--split">
          <div>
            <p class="ks-eyebrow">Use it everywhere</p>
            <h2 id="pl-places-title" class="pl-h2">{PRICE_LIST_PLACEMENTS_TITLE}</h2>
          </div>
          <p class="pl-head__lead">{PRICE_LIST_PLACEMENTS_LEAD}</p>
        </div>
        <ul class="pl-places__grid">
          {PRICE_LIST_PLACEMENTS.map((place) => (
            <li class:list={['pl-place', 'ks-glass-card', `pl-place--${place.id}`]}>
              <div class="pl-place__visual" aria-hidden="true">
                {place.id === 'wall' && (
                  <span class="pl-mini pl-mini--wall">
                    <span class="pl-mini__mirror"></span>
                    <span class="pl-mini__paper"><i></i><b></b><b></b><b></b><b></b></span>
                  </span>
                )}
                {place.id === 'instagram' && (
                  <span class="pl-mini pl-mini--phone">
                    <span class="pl-mini__post"><i></i><b></b><b></b><b></b></span>
                    <span class="pl-mini__bar"><i></i><i></i><i></i></span>
                  </span>
                )}
                {place.id === 'google' && (
                  <span class="pl-mini pl-mini--profile">
                    <span class="pl-mini__head"><i></i><b></b></span>
                    <span class="pl-mini__svc"><b></b><em></em></span>
                    <span class="pl-mini__svc"><b></b><em></em></span>
                    <span class="pl-mini__svc"><b></b><em></em></span>
                  </span>
                )}
                {place.id === 'website' && (
                  <span class="pl-mini pl-mini--site">
                    <span class="pl-mini__chrome"><i></i><i></i><i></i></span>
                    <span class="pl-mini__svc"><b></b><em></em></span>
                    <span class="pl-mini__svc"><b></b><em></em></span>
                    <span class="pl-mini__book">Book</span>
                  </span>
                )}
              </div>
              <h3 class="pl-place__title">{place.heading}</h3>
              <p>{place.text}</p>
              {place.action.kind === 'link' ? (
                <a class="pl-place__link" href={place.action.href} data-track="view_pricing_click" data-placement="price_list_template_places">
                  {place.action.label}
                  <Fragment set:html={svg('arrow')} />
                </a>
              ) : (
                <button type="button" class="pl-place__link" data-pl-action={place.action.kind}>
                  <Fragment set:html={svg(actionIcon[place.action.kind])} />
                  {place.action.label}
                </button>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5 · Related tools -->
    <section class="pl-section pl-related" aria-labelledby="pl-related-title">
      <div class="pl-wrap">
        <div class="pl-head">
          <p class="ks-eyebrow">Keep going</p>
          <h2 id="pl-related-title" class="pl-h2">Related free tools</h2>
        </div>
        <ul class="pl-related__grid">
          {PRICE_LIST_RELATED_LINKS.map((link) => (
            <li>
              <a class="pl-related__card ks-glass-card" href={link.href}>
                <span class="pl-related__label">{link.label}</span>
                <span class="pl-related__desc">{link.description}</span>
                <span class="pl-related__arrow" set:html={svg('arrow')} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Faq4
      className="faq4--landing"
      heading="Price list questions"
      subHeading="Printing, Instagram, Google, “from” prices, VAT and working out what to charge."
      supportHeading="Want clients to book at these prices?"
      supportText="Full KERSIVO puts your services and prices on your own website with online booking."
      supportLinkLabel="See Full KERSIVO pricing"
      supportLinkHref="/pricing#plan"
      faqs={[...PRICE_LIST_FAQ_ITEMS]}
    />

    <ComparisonFinalCta placement="price_list_template" />

    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      social={getFooterSocialLinks()}
    />
  </main>
</LandingLayout>

