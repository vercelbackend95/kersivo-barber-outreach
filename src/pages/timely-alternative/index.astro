---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Faq4 from '@/components/faq4.astro';
import Footer50 from '@/components/footer50.astro';
import Contact16 from '@/components/contact16.astro';
import EditorialIntro from '@/components/editorial/EditorialIntro.astro';
import InsightCards from '@/components/editorial/InsightCards.astro';
import ModelComparison from '@/components/editorial/ModelComparison.astro';
import ProcessTimeline from '@/components/editorial/ProcessTimeline.astro';
import HeroDashboardShowcase from '@/components/marketing/HeroDashboardShowcase.astro';
import NearcutProof from '@/components/nearcutAlternative/NearcutProof.astro';
import NearcutPricing from '@/components/nearcutAlternative/NearcutPricing.astro';
import NearcutFinalCta from '@/components/nearcutAlternative/NearcutFinalCta.astro';
import { SAAS_MONTHLY_GBP, KERSIVO_BOOKING_DEPOSIT_GBP } from '@/lib/seo/defaults';
import { getPublicSiteUrl } from '@/lib/setup/siteUrl';
import { getKersivoOrganizationId, getKersivoWebsiteId } from '@/lib/seo/barberDemoJsonLd';
import { FOOTER_LEGAL_LINKS, KERSIVO_CONTACT_EMAIL, getFooterSocialLinks } from '@/lib/seo/footerSocialLinks';
import '@/styles/components/fresha-alternative.css';

const path='/timely-alternative';
const url=getPublicSiteUrl()+path;
const title='Timely Alternative UK | Pricing & Features | KERSIVO';
const description='Compare Timely vs KERSIVO for UK barbershops: pricing, online bookings, deposits, websites, salon features and switching. Explore the live KERSIVO demo.';
const checked='8 October 2026';
const faqs=[
 {question:'Is KERSIVO a Timely alternative for UK barbershops?',answer:'Yes. Both offer online appointment booking. KERSIVO Starter is £0/month for up to four active bookable barbers at one location. Full KERSIVO costs £39/month per physical location and includes a branded website and standard domain. Timely is a broader salon and beauty business platform.'},
 {question:'How much does Timely cost in the UK?',answer:'Timely offers subscription plans, with pricing and included features dependent on the selected plan and market. Check Timely’s official pricing page for the current UK checkout currency, billing period, VAT treatment, team-size rules and add-ons. We do not assume a universal UK price.'},
 {question:'Does Timely charge a booking commission?',answer:'Do not confuse payment processing fees, optional marketing or discovery programmes, and subscription fees with a universal commission on every appointment. Confirm the charges applicable to your Timely plan directly with Timely. KERSIVO charges 0% KERSIVO commission on booking payments; Stripe processing fees still apply.'},
 {question:'Can clients book online with Timely?',answer:'Yes. Timely supports online appointment scheduling for salon and beauty businesses, including configurable booking tools. KERSIVO provides a hosted booking page on Starter and a full branded website with booking on Full.'},
 {question:'Does Timely support deposits and online payments?',answer:'Timely offers online payment and deposit-related tools, subject to plan, location and payment setup. Confirm Timely’s current processing charges and conditions. KERSIVO Starter requires a £5 deposit towards the appointment or full online prepayment via Stripe.'},
 {question:'Does Timely include a website?',answer:'Timely provides online booking tools and options for embedding or linking bookings from a business website. A complete independently branded barbershop website and standard domain are included in Full KERSIVO; Starter uses a hosted booking page. Check exact Timely website options for your plan.'},
 {question:'Is KERSIVO cheaper than Timely?',answer:'It depends on the Timely quote, number of staff, options and payment volume. KERSIVO Starter is £0/month for up to four bookable barbers; Full KERSIVO is £39/month per location. Compare the full feature requirements and payment-processing costs instead of monthly subscription alone.'},
 {question:'Does KERSIVO charge per barber?',answer:'Starter supports up to four active bookable barbers at one location. Full KERSIVO is £39/month per location with no per-barber subscription charge, subject to fair use.'},
 {question:'Can I migrate client details from Timely to KERSIVO?',answer:'Ask Timely which client, service and future appointment data you can export. KERSIVO can review compatible exports, including supported CSV files, and help with migration. Availability and completeness of a specific Timely export are not guaranteed.'},
 {question:'Can I keep Timely active while setting up KERSIVO?',answer:'Yes. Continue using Timely while KERSIVO is configured and checked. Review the new booking flow first, then change public booking links only once you are ready.'},
 {question:'Does KERSIVO replace every Timely feature?',answer:'No. Timely offers salon-oriented workflows and capabilities that may not have direct KERSIVO equivalents. Compare your must-have features, such as inventory, marketing tools, reporting and staff management, before switching.'},
 {question:'Can I try KERSIVO before changing booking software?',answer:'Yes. Explore the live booking experience and Full KERSIVO dashboard via the public demo, or start with the free Starter plan.'},
];
const sources=[
 {name:'Timely official website',url:'https://www.gettimely.com/',note:'Timely positioning, products and online booking features'},
 {name:'Timely plans and pricing',url:'https://www.gettimely.com/pricing/',note:'Current market-specific subscriptions, inclusions and terms'},
 {name:'Timely Help Centre',url:'https://help.gettimely.com/',note:'Product documentation, payments and data export guidance'},
 {name:'KERSIVO pricing',url:'/pricing',note:'Official Starter and Full KERSIVO plans'},
];
const compare=[
 {title:'Online bookings',subtitle:'Appointment scheduling and the customer journey',timely:['Online appointment calendar and client self-booking','Tools designed for salon, beauty and wellness operations','Booking links and integrations for existing websites'],kersivo:['Starter: free hosted booking page for up to four barbers','Full: branded website and booking flow on your domain','Service, barber, availability and appointment management']},
 {title:'Payments and deposits',subtitle:'What the customer pays and when',timely:['Online payments and deposit options, depending on setup','Processing charges and payment rules should be verified for your market','No assumed universal per-booking commission or processing rate'],kersivo:['Starter: £5 deposit toward the service or full prepayment','0% KERSIVO commission; Stripe fees apply','Full adds editable options including Pay at shop']},
 {title:'Brand and website',subtitle:'Who owns the customer-facing experience',timely:['Online booking tools linked to your business','Website booking integrations and branded booking options','Confirm included website scope and domain terms with Timely'],kersivo:['Full includes a branded barbershop website and standard domain','Starter offers a hosted KERSIVO booking page','Direct booking journey without a consumer marketplace']},
 {title:'Retail and stock',subtitle:'Products, orders and inventory requirements',timely:['Salon retail and stock-related tools are part of the wider Timely offering','Check plan-specific inventory features and any costs','Useful for shops requiring broader inventory workflows'],kersivo:['Full includes an online retail pickup shop','Clients buy products online and collect in-store','No full inventory management or shipping feature is claimed']},
 {title:'Client tools and marketing',subtitle:'Records, return visits and communication',timely:['Client records and salon-focused retention tools','Marketing and messaging availability varies by plan','Check specific loyalty and promotional requirements'],kersivo:['Starter Clients Core and email reminders','Full Advanced Clients / CRM and SMS reminders','Full booking and retail data within the dashboard']},
 {title:'Reporting and teams',subtitle:'Operational visibility and staff',timely:['Reporting, schedules and team-management capabilities','Subscription costs and eligibility may depend on selected setup','Check payroll, commissions and reporting needs carefully'],kersivo:['Starter supports four active bookable barbers at one location','Full reports and larger teams under per-location pricing','£39/month Full per physical location, fair use applies']},
];
const insights=[
 {icon:'seats',title:'Compare the true team cost',body:'Timely plans and eligibility depend on the configuration you choose. KERSIVO Starter supports four bookable barbers and Full charges £39 per location rather than a separate per-barber subscription.'},
 {icon:'storefront',title:'Think beyond the booking widget',body:'Timely already supports online booking and website integration. Full KERSIVO bundles a branded barbershop website, standard domain and booking journey into one subscription.'},
 {icon:'discovery',title:'Keep payment charges separate',body:'A subscription, optional product add-ons and card processing are different costs. Check your real Timely quote and compare it with KERSIVO’s zero platform commission plus Stripe processing.'},
 {icon:'stack',title:'Keep features you genuinely need',body:'Timely is built for a wider salon and beauty market. For advanced stock and specialist salon workflows it may be the better fit; KERSIVO focuses on independent UK barbershops.'}
] as const;
const models=[
 {label:'Timely',descriptor:'Broader salon and beauty appointment platform',icon:'network',summary:[{label:'Pricing',value:'Check plan and UK quote'},{label:'Focus',value:'Salon and beauty workflows'}],heading:'Timely may fit better if…',points:['You need salon-specific stock or advanced retail workflows','Your team uses Timely’s marketing and operational toolset','You have complex needs beyond barber booking and pickup retail','Your existing Timely setup already works well']},
 {label:'KERSIVO',descriptor:'Purpose-built for independent UK barbers',icon:'direct',summary:[{label:'Starter',value:'£0/month · up to 4 barbers'},{label:'Full',value:'£39/month per location'}],heading:'KERSIVO may fit better if…',points:['You want a free hosted booking page for your core team','You want your own branded barbershop website and domain with Full','You prefer direct appointments with 0% KERSIVO platform commission','You need deposits, straightforward reports and retail pickup']}
] as const;
const steps=[
 {title:'Keep Timely running',body:'Leave existing bookings and reminders active while you build your KERSIVO setup.'},
 {title:'Check exports with Timely',body:'Confirm which customer, service and future booking information you can obtain and its format.'},
 {title:'Review data compatibility',body:'KERSIVO can review supported CSV files. Not every Timely field or appointment will necessarily transfer.'},
 {title:'Configure your team and services',body:'Create bookable barbers, opening hours, services and payment rules; prepare your Full website if needed.'},
 {title:'Test the public booking journey',body:'Make test bookings and check payments, notifications and existing future appointments.'},
 {title:'Change links only when ready',body:'Switch your website and social booking links after reviewing the cutover plan.'},
];
const ld=[
 {'@context':'https://schema.org','@type':'WebPage','@id':url+'#webpage',url,name:title,description,inLanguage:'en-GB',dateModified:'2026-10-08',isPartOf:{'@id':getKersivoWebsiteId(getPublicSiteUrl())},publisher:{'@id':getKersivoOrganizationId(getPublicSiteUrl())},breadcrumb:{'@id':url+'#breadcrumb'}},
 {'@context':'https://schema.org','@type':'BreadcrumbList','@id':url+'#breadcrumb',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:getPublicSiteUrl()+'/'},{'@type':'ListItem',position:2,name:'Timely alternative',item:url}]},
 {'@context':'https://schema.org','@type':'FAQPage','@id':url+'#faq',mainEntity:faqs.map(x=>({'@type':'Question',name:x.question,acceptedAnswer:{'@type':'Answer',text:x.answer}}))}
];
const currentYear=new Date().getFullYear();
---
<LandingLayout title={title} description={description} canonicalPath={path} jsonLd={ld}>
<main class="fresha-alt landing-overflow-guard">
 <section class="fresha-alt-hero" aria-labelledby="timely-alt-title">
  <div class="fresha-alt-hero__content">
   <nav class="timely-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Timely alternative</span></nav>
   <p class="fresha-alt-hero__eyebrow"><span class="fresha-alt-hero__eyebrow-dot" aria-hidden="true"></span> Timely alternative for UK barbershops</p>
   <h1 id="timely-alt-title" class="fresha-alt-hero__title"><span class="fresha-alt-hero__title-line fresha-alt-hero__title-line--primary">A Timely alternative</span><span class="fresha-alt-hero__title-line">built around your</span><span class="fresha-alt-hero__title-line">barbershop.</span></h1>
   <p class="fresha-alt-hero__lead">Comparing Timely salon software with a barber-first booking platform? KERSIVO Starter is £0/month for up to four bookable barbers. Full KERSIVO is £{SAAS_MONTHLY_GBP}/month per location with your branded website and standard domain. Explore bookings, deposits, pricing and what you gain — or give up — by switching.</p>
   <div class="fresha-alt-hero__actions"><a href="/demo" class="fresha-alt-hero__action fresha-alt-hero__action--primary" data-track="view_live_demo_click">Open the full demo</a><a href="#comparison" class="fresha-alt-hero__action fresha-alt-hero__action--secondary">Compare Timely and KERSIVO</a></div>
   <div class="fresha-alt-hero__meta"><span><strong>Starter £0/month</strong></span><span aria-hidden="true">·</span><span><strong>Full £{SAAS_MONTHLY_GBP}/month per location</strong></span><span aria-hidden="true">·</span><span>0% KERSIVO commission</span><span aria-hidden="true">·</span><span>Independent UK barbershops</span></div>
  </div><HeroDashboardShowcase />
 </section>
 <EditorialIntro id="quick-answer" titleId="timely-quick-title" class="fresha-alt-quick" kicker="THE SHORT VERSION" title="Timely vs KERSIVO: which is right for your barbershop?" lead="Timely is established salon and beauty appointment software with online bookings, business tools and payment options. KERSIVO is built for independent UK barbers: choose £0/month Starter for core online bookings or £39/month Full for your own branded website, domain, reports, retail pickup and more." detail="Timely may be more suitable if you need broader salon stock and business workflows. KERSIVO may suit you if a simpler barber-first platform and a direct booking experience matter more. Compare current Timely UK plan terms rather than relying on a single headline price." facts={[{label:'KERSIVO Starter',value:'£0/month · up to 4 barbers'},{label:'Full KERSIVO',value:'£39/month per location'},{label:'Timely pricing',value:'Plan and market dependent'},{label:'KERSIVO commission',value:'0% · Stripe fees apply'}]}/>
 <section class="fresha-alt__section" aria-labelledby="timely-why-title"><div class="container"><header class="fresha-alt__intro"><p class="fresha-alt__eyebrow">WHY BARBERS COMPARE</p><h2 id="timely-why-title" class="fresha-alt__h2">Why consider a Timely alternative in the UK?</h2><p class="fresha-alt__lead">Timely offers real advantages for salons. These are the practical questions worth asking before choosing a different setup.</p></header><InsightCards items={insights}/></div></section>
 <section id="timely-pricing" class="fresha-alt__section" aria-labelledby="timely-cost-title"><div class="container"><header class="fresha-alt__intro"><p class="fresha-alt__eyebrow">PRICING EXPLAINED</p><h2 id="timely-cost-title" class="fresha-alt__h2">Timely pricing vs KERSIVO in the UK</h2><p class="fresha-alt__lead">Timely subscriptions are tied to plans and the services you choose. Its public pricing can vary by market and billing period, so verify the UK price and included capabilities directly. KERSIVO publishes two clear options.</p><p class="fresha-alt-costs__checked">Comparison checked {checked} · <a href="https://www.gettimely.com/pricing/" target="_blank" rel="noopener noreferrer">Official Timely pricing</a></p></header>
  <ul class="fresha-alt-costs__grid">
   <li class="fresha-alt-card fresha-alt-costs__item"><p class="fresha-alt-costs__kicker">TIMELY</p><p class="fresha-alt-costs__figure">Check plan</p><p class="fresha-alt-costs__unit">Confirm UK billing and options</p><ul class="fresha-alt-costs__notes"><li>Subscription and feature access depend on your selected plan.</li><li>Check team size, marketing features, online payment fees and VAT.</li><li>Request the actual total for your barbershop.</li></ul></li>
   <li class="fresha-alt-card fresha-alt-costs__item"><p class="fresha-alt-costs__kicker">KERSIVO STARTER</p><p class="fresha-alt-costs__figure">£0</p><p class="fresha-alt-costs__unit">per month, up to 4 bookable barbers</p><ul class="fresha-alt-costs__notes"><li>Hosted booking page and essential calendar management.</li><li>Public bookings require a £{KERSIVO_BOOKING_DEPOSIT_GBP} deposit or full prepayment through Stripe.</li><li>No KERSIVO platform commission; Stripe fees apply.</li></ul></li>
   <li class="fresha-alt-card fresha-alt-costs__item"><p class="fresha-alt-costs__kicker">FULL KERSIVO</p><p class="fresha-alt-costs__figure">£{SAAS_MONTHLY_GBP}</p><p class="fresha-alt-costs__unit">per physical location / month</p><ul class="fresha-alt-costs__notes"><li>Branded website and standard domain included.</li><li>Reports, advanced client tools, SMS and retail pickup.</li><li>No per-barber subscription fee, subject to fair use.</li></ul></li>
  </ul>
  <div class="fresha-alt-card fresha-alt-costs__marketplace"><div class="fresha-alt-costs__marketplace-body"><h3 class="fresha-alt-costs__h3">Compare the full cost — not just the subscription</h3><ul class="fresha-alt-list"><li>Ask Timely for the UK quote for your current staff, plan, payment configuration and optional tools.</li><li>KERSIVO Starter: the £5 deposit is deducted from the appointment price, not an added platform booking fee.</li><li>KERSIVO Full: £39 per location per month, plus applicable third-party payment processing.</li><li>Neither platform's advanced features should be assumed identical.</li></ul></div><div class="fresha-alt-costs__marketplace-aside"><p class="fresha-alt-costs__example">A £20 haircut with a £5 KERSIVO Starter deposit leaves £15 due for the haircut. The deposit is part of the price — standard Stripe fees still apply.</p><p class="fresha-alt-costs__checked"><a href="/pricing">See KERSIVO plan details</a></p></div></div>
 </div></section>
 <section id="comparison" class="fresha-alt-compare scroll-mt-24" aria-labelledby="timely-compare-title"><div class="fresha-alt-compare__container"><header class="fresha-alt-compare__header"><p class="fresha-alt-compare__eyebrow">COMPARISON</p><h2 id="timely-compare-title" class="fresha-alt-compare__title"><span class="fresha-alt-compare__title-line">KERSIVO</span><span class="fresha-alt-compare__title-line fresha-alt-compare__title-line--vs">VS</span><span class="fresha-alt-compare__title-line">Timely</span></h2><p class="fresha-alt-compare__lead">Explore six practical differences between barber-first booking and a broader salon management platform.</p></header>
 <div class="fresha-alt-compare__accordion">{compare.map((section,index)=><details class="fresha-alt-compare__item timely-compare-item" open={index===0}><summary class="fresha-alt-compare__summary"><span class="fresha-alt-compare__summary-copy"><span class="fresha-alt-compare__summary-kicker">{String(index+1).padStart(2,'0')} / 06</span><strong>{section.title}</strong><span>{section.subtitle}</span></span><span class="timely-arrow" aria-hidden="true">⌄</span></summary><div class="fresha-alt-compare__panel"><article class="fresha-alt-compare__provider fresha-alt-compare__provider--fresha"><div class="fresha-alt-compare__provider-label">TIMELY SALON SOFTWARE</div><div class="fresha-alt-compare__provider-head"><div><p class="fresha-alt-compare__provider-name">Timely</p></div></div><ul class="fresha-alt-compare__points">{section.timely.map(point=><li><span>{point}</span></li>)}</ul></article><div class="fresha-alt-compare__vs" aria-hidden="true">VS</div><article class="fresha-alt-compare__provider fresha-alt-compare__provider--kersivo"><div class="fresha-alt-compare__provider-label fresha-alt-compare__provider-label--kersivo">BARBER-FIRST PLATFORM</div><div class="fresha-alt-compare__provider-head"><div><p class="fresha-alt-compare__provider-name">KERSIVO</p></div></div><ul class="fresha-alt-compare__points">{section.kersivo.map(point=><li><span>{point}</span></li>)}</ul></article></div></details>)}</div><a href="/demo" class="fresha-alt-compare__demo-cta" data-track="view_live_demo_click">See the KERSIVO demo →</a><p class="fresha-alt-compare__footnote">Timely plan features and pricing can change. <a href="#sources">See official sources</a>.</p></div></section>
 <NearcutProof />
 <section id="which-model" class="fresha-alt__section" aria-labelledby="timely-fit-title"><div class="container"><header class="fresha-alt__intro"><p class="fresha-alt__eyebrow">TWO MODELS</p><h2 id="timely-fit-title" class="fresha-alt__h2">Which system fits your barbershop?</h2></header><ModelComparison idPrefix="timely-fit" models={models} conclusion="A feature you rely on is worth more than a low headline price. Compare your actual requirements before changing systems.">Also comparing other software? <a href="/nearcut-alternative">Nearcut</a> · <a href="/fresha-alternative">Fresha</a> · <a href="/booksy-alternative">Booksy</a></ModelComparison></div></section>
 <section id="switching" class="fresha-alt__section" aria-labelledby="timely-switch-title"><div class="container"><header class="fresha-alt__intro"><p class="fresha-alt__eyebrow">MIGRATION</p><h2 id="timely-switch-title" class="fresha-alt__h2">Switching from Timely to KERSIVO</h2><p class="fresha-alt-switching__reassurance">Keep your Timely bookings live while your new setup is prepared.</p></header><ProcessTimeline steps={steps} noteTitle="Before you switch" notePoints={['Check Timely’s export formats and any current contract or billing obligations.','A complete transfer of future appointments, client history or automations is not guaranteed.']}><a href="#contact">Ask about a Timely migration →</a></ProcessTimeline></div></section>
 <NearcutPricing />
 <Faq4 className="faq4--landing" heading="Questions about Timely and KERSIVO?" subHeading="Answers about Timely alternatives, UK pricing, bookings, deposits and moving your barbershop." supportHeading="Still comparing options?" supportText="Tell us which Timely features you use and we’ll help you evaluate the differences." supportLinkLabel="Ask KERSIVO a question" supportLinkHref="#contact" faqs={faqs}/>
 <NearcutFinalCta />
 <Contact16 eyebrow="CONTACT KERSIVO" title="Still comparing Timely and KERSIVO?" description="Tell us what you use today and what you want to change. We’ll reply with a clear, practical answer for your barbershop." note="We’ll reply by email — no sales call required." submitLabel="Send my question" messagePlaceholder="For example: Timely pricing, client exports, booking deposits or a branded website."/>
 <section id="sources" class="fresha-alt-sources" aria-labelledby="timely-sources-title"><div class="container"><header class="fresha-alt-sources__header"><h2 id="timely-sources-title" class="fresha-alt-sources__title">Sources &amp; comparison notes</h2><p class="fresha-alt-sources__meta">Reviewed <time datetime="2026-10-08">{checked}</time></p></header><p>This independent comparison relies on Timely’s official product, pricing and support resources. Availability, charges, terms and functionality can vary by market and plan; verify current UK terms directly before making a decision.</p><ul class="fresha-alt-sources__list">{sources.map(s=><li><a href={s.url} target={s.url.startsWith('https')?'_blank':undefined} rel={s.url.startsWith('https')?'noopener noreferrer':undefined}>{s.name}</a><span class="fresha-alt-sources__supports">{s.note}</span></li>)}</ul><p class="fresha-alt-sources__trademark">Timely is a trademark of its respective owner. KERSIVO is not affiliated with, endorsed by or sponsored by Timely.</p></div></section>
 <Footer50 showIntro={false} brandLine="Own your brand. Own your bookings." contactEmail={KERSIVO_CONTACT_EMAIL} brandName="KERSIVO" copyright={`© ${currentYear} KERSIVO`} navigation={[{name:'Home',href:'/'},{name:'Live demo',href:'/demo'},{name:'Pricing',href:'/pricing'},{name:'FAQ',href:'#faq'},{name:'About',href:'/about'},{name:'Contact',href:'#contact'},{name:'Start KERSIVO Starter',href:'/admin'}]} social={getFooterSocialLinks()} legal={[FOOTER_LEGAL_LINKS.privacy,FOOTER_LEGAL_LINKS.cookies,FOOTER_LEGAL_LINKS.cookieSettings,FOOTER_LEGAL_LINKS.dpa,FOOTER_LEGAL_LINKS.termsAndCancellation]}/>
</main>
</LandingLayout>
<script>
 import { initFeature261StaggerReveal } from '@/lib/landing/initFeature261StaggerReveal';
 const scheduleInit=()=>{requestAnimationFrame(()=>{const section=document.querySelector('.feature261');if(!(section instanceof HTMLElement)||section.dataset.feature261Enhanced==='true')return;const cleanup=initFeature261StaggerReveal(section);document.addEventListener('astro:before-swap',cleanup,{once:true});});};
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',scheduleInit,{once:true});else scheduleInit();
 document.addEventListener('astro:page-load',scheduleInit);
</script>
<script>
 import { destroyProductRails,initProductRails } from '@/lib/shop/initProductRail';
 const boot=()=>{destroyProductRails();initProductRails();};boot();document.addEventListener('astro:page-load',boot);
</script>
<style is:global>
 .landing-overflow-guard{overflow-x:clip}
 .timely-breadcrumb{display:flex;align-items:center;flex-wrap:wrap;gap:.55rem;margin-bottom:1rem;color:#9ca3af;font-size:.75rem;line-height:1.5}
 .timely-breadcrumb a{color:inherit;text-decoration:none}.timely-breadcrumb a:hover{text-decoration:underline}
 .timely-compare-item>summary{list-style:none;cursor:pointer}.timely-compare-item>summary::-webkit-details-marker{display:none}
 .timely-compare-item .timely-arrow{font-size:1.6rem;color:#a6a6ab;margin-left:auto;transition:transform .2s}
 .timely-compare-item[open] .timely-arrow{transform:rotate(180deg)}
 .timely-compare-item:not([open]) .fresha-alt-compare__panel{display:none}
 .timely-compare-item .fresha-alt-compare__panel{padding-top:1.5rem;padding-bottom:1.5rem}
</style>
