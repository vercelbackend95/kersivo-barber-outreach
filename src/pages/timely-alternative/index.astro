---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Faq4 from '@/components/faq4.astro';
import Footer50 from '@/components/footer50.astro';
import Contact16 from '@/components/contact16.astro';
import ComparisonFinalCta from '@/components/comparison/ComparisonFinalCta.astro';
import CompareHubLink from '@/components/alternativesHub/CompareHubLink.astro';
import TimelyHero from '@/components/timelyAlternative/TimelyHero.astro';
import TimelyVerdict from '@/components/timelyAlternative/TimelyVerdict.astro';
import TimelyModel from '@/components/timelyAlternative/TimelyModel.astro';
import TimelyBuilder from '@/components/timelyAlternative/TimelyBuilder.astro';
import TimelyWeek from '@/components/timelyAlternative/TimelyWeek.astro';
import TimelyTable from '@/components/timelyAlternative/TimelyTable.astro';
import TimelySwitching from '@/components/timelyAlternative/TimelySwitching.astro';
import TimelyPricing from '@/components/timelyAlternative/TimelyPricing.astro';
import TimelySources from '@/components/timelyAlternative/TimelySources.astro';
import {
  TIMELY_ALTERNATIVE_PAGE_PATH,
  TIMELY_ALTERNATIVE_TITLE,
  TIMELY_ALTERNATIVE_DESCRIPTION,
  TIMELY_ALTERNATIVE_FAQ_ITEMS,
  buildTimelyAlternativeFaqJsonLd,
} from '@/lib/seo/timelyAlternativeFaq';
import { buildTimelyAlternativeWebPageJsonLd, buildTimelyAlternativeBreadcrumbJsonLd } from '@/lib/seo/timelyAlternativeJsonLd';
import { KERSIVO_CONTACT_EMAIL, getFooterSocialLinks } from '@/lib/seo/footerSocialLinks';
import '@/styles/components/ks-glass-card.css';
import '@/styles/components/timely-alternative.css';

const path = TIMELY_ALTERNATIVE_PAGE_PATH;
const title = TIMELY_ALTERNATIVE_TITLE;
const description = TIMELY_ALTERNATIVE_DESCRIPTION;
const faqs = TIMELY_ALTERNATIVE_FAQ_ITEMS;
const ld = [buildTimelyAlternativeWebPageJsonLd(), buildTimelyAlternativeBreadcrumbJsonLd(), buildTimelyAlternativeFaqJsonLd()];
const currentYear = new Date().getFullYear();
---

<LandingLayout title={title} description={description} canonicalPath={path} jsonLd={ld}>
  <main class="ta landing-overflow-guard">
    <TimelyHero />
    <TimelyVerdict />
    <TimelyModel />
    <TimelyBuilder />
    <TimelyWeek />
    <TimelyTable />
    <TimelySwitching />
    <TimelyPricing />

    <Faq4
      className="faq4--landing"
      heading="Timely alternative questions, answered"
      subHeading="Straight answers on Timely’s UK pricing, weekly billing, fees, websites and moving your barbershop."
      supportHeading="Still comparing options?"
      supportText="Tell us which Timely features you use and we’ll tell you honestly how KERSIVO compares."
      supportLinkLabel="Ask KERSIVO a question"
      supportLinkHref="#contact"
      faqs={faqs}
    />

    <ComparisonFinalCta placement="timely" competitor="Timely" />

    <Contact16
      eyebrow="CONTACT KERSIVO"
      title="Thinking about leaving Timely?"
      description="Tell us how your shop runs today and what you want to change. We’ll reply with a clear, practical answer for your barbershop."
      note="We’ll reply by email — no sales call required."
      submitLabel="Send my question"
      messagePlaceholder="For example: my weekly Timely bill, moving my client list, booking deposits or a website on my own domain."
    />

    <CompareHubLink />
    <TimelySources />

    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      social={getFooterSocialLinks()}
    />
  </main>
</LandingLayout>

<script>
  import { initTimelyAlternative } from '@/lib/landing/timelyAlternative';

  const boot = () => {
    const root = document.querySelector<HTMLElement>('main.ta');
    if (!root || root.dataset.taBound === 'true') return;
    root.dataset.taBound = 'true';
    const cleanup = initTimelyAlternative(document);
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  };

  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style is:global>
  .landing-overflow-guard {
    overflow-x: clip;
  }
</style>
