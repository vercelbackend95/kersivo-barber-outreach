---
export const prerender = false;

import AdminPanel from '@/components/admin/AdminPanel';
import PreviewHubFrame from '@/components/adminHub/PreviewHubFrame.astro';
import { HubDraftShopSetup } from '@/components/adminHub/HubDraftShopSetup';
import PreviewHubAdminDocument from '@/layouts/PreviewHubAdminDocument.astro';
import {
  hubChromeFromPage,
  pageHasDraftShop,
  preparePreviewHubRealAdminPage,
} from '@/lib/adminHub/previewHubAdminPage';

const prepared = await preparePreviewHubRealAdminPage({
  context: Astro,
  section: 'team',
});
if (prepared.kind === 'response') return prepared.response;
const { data } = prepared;
const hasDraftShop = pageHasDraftShop(data);
const hubChrome = hubChromeFromPage(data, 'team');
---

<PreviewHubAdminDocument title={`${data.title} — ${data.shopName} | KERSIVO`}>
  {
    hasDraftShop ? (
      <AdminPanel client:load initialSection="bookings_blocks" hubChrome={hubChrome} />
    ) : (
      <PreviewHubFrame data={data} section="team">
        <HubDraftShopSetup client:load />
      </PreviewHubFrame>
    )
  }
</PreviewHubAdminDocument>
