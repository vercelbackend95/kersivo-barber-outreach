---
export const prerender = false;

import PreviewHubDocument from '@/layouts/PreviewHubDocument.astro';
import PreviewHubFrame from '@/components/adminHub/PreviewHubFrame.astro';
import { AdminHubChanges } from '@/components/adminHub/AdminHubChanges';
import { ADMIN_HUB_CHANGES_SELF_EDIT, ADMIN_HUB_CHANGES_SUB } from '@/lib/adminHub/copy';
import { ADMIN_HUB_API_BASE } from '@/lib/adminHub/links';
import { preparePreviewHubPage } from '@/lib/adminHub/previewHubPage';
import { HUB_LOCKED_REASON_PREVIEW, HUB_NAV, HUB_WEBSITE_LOCKED_BODY } from '@/lib/freePreview/hubCopy';

const prepared = await preparePreviewHubPage({
  context: Astro,
  section: 'changes',
  fallbackFullToAdmin: true,
});
if (prepared.kind === 'response') return prepared.response;
const { data } = prepared;
const caps = data.ctx.state.capabilities;
---

<PreviewHubDocument title={`${data.title} — ${data.shopName} | KERSIVO`}>
  <PreviewHubFrame data={data} section="changes">
    {
      caps.canDraftChanges ? (
        <AdminHubChanges
          client:load
          token=""
          apiBase={ADMIN_HUB_API_BASE}
          initialItems={data.view.changeItems}
          includedChangeRounds={data.ctx.request.includedChangeRounds}
          changeRoundsUsed={data.ctx.request.changeRoundsUsed}
          canDraft={caps.canDraftChanges}
          canSend={caps.canSendChanges}
        />
      ) : (
        <section class="admin-hub-locked" data-testid="admin-hub-changes-locked">
          <header class="admin-hub-head">
            <div>
              <span class="admin-hub-head__eyebrow">{HUB_NAV.changes}</span>
              <h1>{HUB_NAV.changes}</h1>
              <p class="admin-hub-head__sub">{ADMIN_HUB_CHANGES_SUB} {ADMIN_HUB_CHANGES_SELF_EDIT}</p>
            </div>
          </header>
          <div class="admin-hub-tile admin-hub-calm">
            <h2>{HUB_LOCKED_REASON_PREVIEW}</h2>
            <p>{HUB_WEBSITE_LOCKED_BODY}</p>
          </div>
        </section>
      )
    }
  </PreviewHubFrame>
</PreviewHubDocument>
