---
export const prerender = false;

import MinimalLayout from '@/layouts/MinimalLayout.astro';
import StorefrontHeader from '@/components/shop/storefront/StorefrontHeader.astro';
import TestShopClientScripts from '@/components/admin/TestShopClientScripts.astro';
import OwnerPreviewToolbar from '@/components/shop/OwnerPreviewToolbar.astro';
import CartDrawerMount from '@/components/shop/CartDrawerMount.astro';
import RetailOnboardingTaskCard from '@/components/admin/retail-onboarding/RetailOnboardingTaskCard';
import StorefrontShopPage from '@/components/shop/storefront/StorefrontShopPage';
import { isTenantAdminAccess, resolveAdminAccess } from '@/lib/admin/auth';
import { resolveRetailOnboardingProduct } from '@/lib/admin/retailOnboardingProduct';
import { prisma } from '@/lib/db/client';
import {
  parseStorefrontCategoryParam,
  storefrontCategoryOptions,
  storefrontProductFromPrisma,
} from '@/lib/shop/storefrontCatalog';
import '@/styles/tokens.css';
import '@/styles/fonts-admin.css';
import '@/styles/global.css';
import '@/styles/components/buttons.css';
import '@/styles/components/badge.css';
import '@/styles/components/owner-preview-toolbar.css';
import '@/styles/components/shop.css';
import '@/styles/components/shop-product.css';
import '@/styles/components/storefront.css';
import '@/styles/components/storefront-cart.css';
import '@/styles/components/empty-state.css';
import '@/styles/components/inputs.css';

const access = await resolveAdminAccess(Astro);
if (!isTenantAdminAccess(access)) {
  return Astro.redirect('/admin');
}

const shop = await prisma.shopSettings.findUnique({
  where: { id: access.shopId },
  select: {
    name: true,
    logoUrl: true,
  },
});

const retailContext = await resolveRetailOnboardingProduct(access.shopId);

let verifiedTestOrderId: string | null = null;
if (retailContext.retailTestOrderId) {
  const testOrder = await prisma.order.findFirst({
    where: {
      id: retailContext.retailTestOrderId,
      shopId: access.shopId,
      isTestOrder: true,
    },
    select: { id: true },
  });
  verifiedTestOrderId = testOrder?.id ?? null;
}

const showRetailTaskCard =
  !retailContext.retailOnboardingSkipped &&
  !retailContext.retailPickupWalkthroughCompleted &&
  (Boolean(retailContext.product) || retailContext.retailOnboardingCompleted);

const onboardingProductId = retailContext.product?.id ?? null;
const highlightRequested = Astro.url.searchParams.get('highlight') === '1';
const rows = await prisma.product.findMany({
  where: {
    shopId: access.shopId,
    OR: onboardingProductId
      ? [{ active: true }, { id: onboardingProductId }]
      : [{ active: true }],
  },
  orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }],
  select: {
    id: true,
    name: true,
    description: true,
    pricePence: true,
    imageUrl: true,
    featured: true,
    category: true,
    sortOrder: true,
    active: true,
  },
});

const products = rows.map((row) => storefrontProductFromPrisma({
  ...row,
  active: row.active || row.id === onboardingProductId,
}));
const selectedCategory = parseStorefrontCategoryParam(
  Astro.url.searchParams.get('category'),
  storefrontCategoryOptions(products).map((option) => option.value),
);
const shopTitle = shop?.name?.trim() || 'My shop';
const currentPath = Astro.url.pathname;
---

<MinimalLayout
  title={`${shopTitle} | Kersivo Admin`}
  description="Preview your retail storefront with your shop products."
  canonicalPath="/admin/test-shop"
  noindex={true}
  htmlClass="admin-app-scroll"
  bodyClass="admin-theme-premium-black has-owner-preview-toolbar"
  showCookieConsent={false}
>
  <div data-sf-page-shell>
  <OwnerPreviewToolbar adminHref="/admin" />
  <StorefrontHeader
    themeId="kersivo"
    currentPath={currentPath}
    homeHref="/admin/test-shop"
    navHomeHref="/"
    homeLabel={`${shopTitle} shop`}
    items={[{ href: '/admin/test-shop', label: 'Shop' }]}
    bookHref="/admin/test-book"
    shopName={shopTitle}
    logoUrl={shop?.logoUrl}
    showBag
  />
  <main class="container shop-page" aria-labelledby="storefront-heading" data-active-category={selectedCategory} data-sf-header-inert>
    {
      showRetailTaskCard ? (
        <RetailOnboardingTaskCard
          client:load
          product={retailContext.product}
          testOrderId={verifiedTestOrderId}
          source="test-shop"
        />
      ) : null
    }

    <StorefrontShopPage
      client:load
      products={products}
      themeId="kersivo"
      shopName={shopTitle}
      productHrefPrefix="/admin/test-shop"
      priceFormat="gbp"
      imageFallback="initial"
      selectedCategory={selectedCategory}
      intro={{
        eyebrow: 'Your storefront',
        heading: shopTitle,
        headingId: 'storefront-heading',
        description: 'Browse your products, add them to the cart, and complete a test checkout.',
        fulfilmentLabel: 'Collect in shop',
      }}
      highlightProductId={highlightRequested ? onboardingProductId : null}
      itemIdPrefix="test-shop-product-"
      showPoweredBy
      emptyTitle="No products yet"
      emptyDescription="Add your first product to preview your storefront."
      emptyActionHref="/admin/retail-onboarding?step=1"
      emptyActionLabel="Add a product"
    />
  </main>
  </div>

  <CartDrawerMount
    mode="testOrder"
    shopId=""
    shopName={shopTitle}
    themeId="kersivo"
    priceFormat="gbp"
    exploreHref="/admin/test-shop"
    checkout={{ type: 'testOrder' }}
  />
</MinimalLayout>

<TestShopClientScripts />
