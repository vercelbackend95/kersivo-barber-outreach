---
export const prerender = false;

import MinimalLayout from '@/layouts/MinimalLayout.astro';
import Navbar17 from '@/components/navbar17.astro';
import OwnerPreviewToolbar from '@/components/shop/OwnerPreviewToolbar.astro';
import CartDrawerMount from '@/components/shop/CartDrawerMount.astro';
import RetailOnboardingTaskCard from '@/components/admin/retail-onboarding/RetailOnboardingTaskCard';
import { resolveAdminAccess } from '@/lib/admin/auth';
import { resolveRetailOnboardingProduct } from '@/lib/admin/retailOnboardingProduct';
import { prisma } from '@/lib/db/client';
import { formatGbp } from '@/lib/shop/money';
import {
  SHOP_FILTER_LABELS,
  type ProductCategory,
} from '@/lib/shop/productPresentation';
import '@/styles/tokens.css';
import '@/styles/fonts-admin.css';
import '@/styles/global.css';
import '@/styles/components/buttons.css';
import '@/styles/components/badge.css';
import '@/styles/components/navbar17.css';
import '@/styles/components/owner-preview-toolbar.css';
import '@/styles/components/shop.css';
import '@/styles/components/shop-product.css';
import '@/styles/components/empty-state.css';
import '@/styles/components/inputs.css';

const access = await resolveAdminAccess(Astro);
if (!access || access.via !== 'session') {
  return Astro.redirect('/admin');
}

const shop = await prisma.shopSettings.findUnique({
  where: { id: access.shopId },
  select: {
    name: true,
    logoUrl: true,
  },
});

const retailContext = await resolveRetailOnboardingProduct(access.shopId);

let verifiedTestOrderId: string | null = null;
if (retailContext.retailTestOrderId) {
  const testOrder = await prisma.order.findFirst({
    where: {
      id: retailContext.retailTestOrderId,
      shopId: access.shopId,
      isTestOrder: true,
    },
    select: { id: true },
  });
  verifiedTestOrderId = testOrder?.id ?? null;
}

// Hide when skipped or pickup walkthrough done. retailOnboardingCompleted = product stage only, not journey end.
const showRetailTaskCard =
  !retailContext.retailOnboardingSkipped &&
  !retailContext.retailPickupWalkthroughCompleted &&
  (Boolean(retailContext.product) || retailContext.retailOnboardingCompleted);

const products = await prisma.product.findMany({
  where: { shopId: access.shopId, active: true },
  orderBy: [{ featured: 'desc' }, { sortOrder: 'asc' }, { createdAt: 'asc' }],
  select: {
    id: true,
    name: true,
    pricePence: true,
    imageUrl: true,
    featured: true,
    category: true,
    updatedAt: true,
  },
});

const categoryFilters = [
  { value: 'ALL', label: 'All products', count: products.length },
  ...Object.entries(SHOP_FILTER_LABELS).map(([value, label]) => ({
    value,
    label,
    count: products.filter((product) => product.category === value).length,
  })),
].filter((filter) => filter.value === 'ALL' || filter.count > 0);

const categoryValues = new Set(categoryFilters.map((filter) => filter.value));
const selectedCategoryParam = Astro.url.searchParams.get('category') || 'ALL';
const selectedCategory = categoryValues.has(selectedCategoryParam) ? selectedCategoryParam : 'ALL';
const shopTitle = shop?.name?.trim() || 'My shop';
---

<MinimalLayout
  title={`${shopTitle} | Kersivo Admin`}
  description="Preview your retail storefront with your shop products."
  canonicalPath="/admin/test-shop"
  noindex={true}
  htmlClass="admin-app-scroll"
  bodyClass="admin-theme-premium-black has-owner-preview-toolbar"
  showCookieConsent={false}
>
  <OwnerPreviewToolbar adminHref="/admin" />
  <Navbar17
    variant="testShop"
    brandLogoUrl={shop?.logoUrl}
    brandAriaLabel={shopTitle}
  />
  <main class="container shop-page" aria-labelledby="shop-page-title" data-active-category={selectedCategory}>
    {
      showRetailTaskCard ? (
        <RetailOnboardingTaskCard
          client:load
          product={retailContext.product}
          testOrderId={verifiedTestOrderId}
          source="test-shop"
        />
      ) : null
    }

    <header class="shop-header-block" id="about">
      <p class="shop-eyebrow">Your storefront</p>
      <h1 id="shop-page-title">{shopTitle}</h1>
      <p class="shop-intro">Browse your products, add them to the cart, and complete a test checkout.</p>

      {
        products.length > 0 ? (
          <div class="shop-header-toolbar">
            <div class="shop-category-filters" role="group" aria-label="Filter by category">
              {categoryFilters.map((filter) => {
                const isActive = filter.value === selectedCategory;
                return (
                  <button
                    type="button"
                    class:list={['filter-chip', isActive && 'is-active']}
                    data-category-filter={filter.value}
                    aria-pressed={isActive ? 'true' : 'false'}
                  >
                    <span>{filter.label}</span>
                    <span class="filter-chip__count" aria-hidden="true">
                      {filter.count}
                    </span>
                  </button>
                );
              })}
            </div>

            <div class="shop-sort-wrap">
              <select class="shop-sort-select" aria-label="Sort products" data-shop-sort>
                <option value="default">Sort: Featured</option>
                <option value="price-asc">Price: Low → High</option>
                <option value="price-desc">Price: High → Low</option>
                <option value="newest">Newest</option>
              </select>
              <svg class="shop-sort-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M4 5.5l4 4 4-4"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
          </div>
        ) : null
      }
    </header>

    <section class="shop-layout" id="products" aria-label="Products">
      {
        products.length === 0 ? (
          <article class="shop-promo-card shop-promo-card--empty">
            <p class="shop-promo-kicker">Retail setup</p>
            <h2>No products yet</h2>
            <p>Add your first product to preview your storefront.</p>
            <div style="display:flex;flex-direction:column;gap:0.75rem;margin-top:1rem;max-width:20rem;">
              <a class="btn btn--primary" href="/admin/retail-onboarding?step=1">Add a product</a>
              <a class="btn btn--secondary" href="/admin?section=shop_products">Manage products</a>
            </div>
          </article>
        ) : (
          <ul class="shop-grid" aria-label="Products">
            {products.map((product) => (
              <li
                id={`test-shop-product-${product.id}`}
                data-product-item
                data-product-id={product.id}
                data-product-category={product.category}
                data-product-featured={product.featured ? '1' : '0'}
                data-product-sort-price={String(product.pricePence)}
                data-product-sort-date={product.updatedAt.toISOString()}
                hidden={selectedCategory !== 'ALL' && product.category !== selectedCategory}
              >
                <article class="shop-card" data-category={product.category}>
                  <a
                    href={`/admin/test-shop/${product.id}`}
                    class="shop-media-link"
                    aria-label={`View ${product.name}`}
                  >
                    <div class="shop-media">
                      {product.featured ? <span class="shop-badge">Featured</span> : null}
                      {product.imageUrl ? (
                        <img src={product.imageUrl} alt={product.name} class="shop-image" loading="lazy" />
                      ) : (
                        <div class="shop-image--placeholder" aria-hidden="true" />
                      )}
                    </div>
                  </a>

                  <div class="shop-card-body">
                    <span class="badge badge--neutral">
                      {SHOP_FILTER_LABELS[product.category as ProductCategory] ?? 'Styling'}
                    </span>
                    <h3>
                      <a href={`/admin/test-shop/${product.id}`}>{product.name}</a>
                    </h3>
                    <p class="shop-price">{formatGbp(product.pricePence)}</p>

                    <div class="shop-card-actions">
                      <button
                        type="button"
                        class="btn btn--primary btn--atc"
                        data-add-to-cart
                        data-product-id={product.id}
                        data-product-name={product.name}
                        data-product-price-pence={String(product.pricePence)}
                        data-product-image-url={product.imageUrl ?? ''}
                        data-atc-label="Add to cart"
                      >
                        Add to cart
                      </button>
                    </div>
                  </div>
                </article>
              </li>
            ))}

            <li class="shop-empty-filter" aria-live="polite" role="status">
              <p class="shop-empty-filter__title">No products in this category</p>
              <p class="shop-empty-filter__desc">Try selecting a different category or view all products.</p>
            </li>
          </ul>
        )
      }
    </section>
  </main>

  <CartDrawerMount testOrderMode />
</MinimalLayout>

<script>
  const root = document.querySelector('.shop-page');

  if (root) {
    const filterButtons = Array.from(root.querySelectorAll('[data-category-filter]'));
    const productItems = Array.from(root.querySelectorAll('[data-product-item]'));
    const validCategories = new Set(
      filterButtons.map((button) => button.getAttribute('data-category-filter') || 'ALL'),
    );

    const updateEmptyFilterState = () => {
      const emptyEl = root.querySelector('.shop-empty-filter');
      const items = root.querySelectorAll('[data-product-item]');
      if (!emptyEl) return;
      const anyVisible = [...items].some((item) => !(item as HTMLElement).hidden);
      emptyEl.classList.toggle('is-visible', !anyVisible);
    };

    const getCategoryFromUrl = () => {
      const searchParams = new URLSearchParams(window.location.search);
      const categoryParam = searchParams.get('category') || 'ALL';
      return validCategories.has(categoryParam) ? categoryParam : 'ALL';
    };

    const getInitialCategory = () => {
      const initialFromUrl = getCategoryFromUrl();
      const initialFromMarkup = root.getAttribute('data-active-category') || 'ALL';
      if (validCategories.has(initialFromUrl)) return initialFromUrl;
      return validCategories.has(initialFromMarkup) ? initialFromMarkup : 'ALL';
    };

    let currentCategory = getInitialCategory();

    const applyCategoryFilter = (category: string) => {
      const resolvedCategory = validCategories.has(category) ? category : 'ALL';

      for (const item of productItems) {
        const productCategory = item.getAttribute('data-product-category') || 'STYLING';
        (item as HTMLElement).hidden = !(
          resolvedCategory === 'ALL' || productCategory === resolvedCategory
        );
      }

      for (const button of filterButtons) {
        const isActive = button.getAttribute('data-category-filter') === resolvedCategory;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      }

      currentCategory = resolvedCategory;
      root.setAttribute('data-active-category', resolvedCategory);
      updateEmptyFilterState();
    };

    const syncUrlWithCategory = (category: string) => {
      const nextUrl = new URL(window.location.href);
      if (category === 'ALL') {
        nextUrl.searchParams.delete('category');
      } else {
        nextUrl.searchParams.set('category', category);
      }
      window.history.pushState({ category }, '', nextUrl);
    };

    for (const button of filterButtons) {
      button.addEventListener('click', () => {
        const category = button.getAttribute('data-category-filter') || 'ALL';
        if (category === currentCategory) return;
        applyCategoryFilter(category);
        syncUrlWithCategory(category);
      });
    }

    window.addEventListener('popstate', () => {
      applyCategoryFilter(getCategoryFromUrl());
    });

    applyCategoryFilter(currentCategory);
  }

  const sortSelect = document.querySelector('[data-shop-sort]') as HTMLSelectElement | null;
  const shopGrid = document.querySelector('.shop-grid');

  if (sortSelect && shopGrid) {
    sortSelect.addEventListener('change', () => {
      const value = sortSelect.value;
      const items = Array.from(shopGrid.querySelectorAll('[data-product-item]')) as HTMLElement[];

      const sorted = [...items].sort((a, b) => {
        if (value === 'price-asc') {
          return Number(a.dataset.productSortPrice ?? 0) - Number(b.dataset.productSortPrice ?? 0);
        }
        if (value === 'price-desc') {
          return Number(b.dataset.productSortPrice ?? 0) - Number(a.dataset.productSortPrice ?? 0);
        }
        if (value === 'newest') {
          const da = new Date(a.dataset.productSortDate ?? 0).getTime();
          const db = new Date(b.dataset.productSortDate ?? 0).getTime();
          return db - da;
        }
        // default: Featured first, then original SSR order
        const featuredDelta =
          Number(b.dataset.productFeatured ?? 0) - Number(a.dataset.productFeatured ?? 0);
        if (featuredDelta !== 0) return featuredDelta;
        return items.indexOf(a) - items.indexOf(b);
      });

      const emptyEl = shopGrid.querySelector('.shop-empty-filter');
      sorted.forEach((el) => shopGrid.insertBefore(el, emptyEl));
    });
  }
</script>
