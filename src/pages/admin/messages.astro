---
export const prerender = false;

import PreviewHubDocument from '@/layouts/PreviewHubDocument.astro';
import PreviewHubFrame from '@/components/adminHub/PreviewHubFrame.astro';
import { AdminHubMessages } from '@/components/adminHub/AdminHubMessages';
import { ADMIN_HUB_API_BASE } from '@/lib/adminHub/links';
import { preparePreviewHubPage } from '@/lib/adminHub/previewHubPage';

const prepared = await preparePreviewHubPage({
  context: Astro,
  section: 'messages',
  fallbackFullToAdmin: true,
});
if (prepared.kind === 'response') return prepared.response;
const { data } = prepared;
---

<PreviewHubDocument title={`${data.title} — ${data.shopName} | KERSIVO`}>
  <PreviewHubFrame data={data} section="messages">
    <AdminHubMessages
      client:load
      token=""
      apiBase={ADMIN_HUB_API_BASE}
      viewer={data.appCtx.viewer}
      requestId={data.appCtx.requestId}
      shopName={data.shopName}
      initialMessages={data.view.messages}
      initialDraft={data.appCtx.initialDraft}
      canAttach={data.appCtx.canAttach}
    />
  </PreviewHubFrame>
</PreviewHubDocument>
