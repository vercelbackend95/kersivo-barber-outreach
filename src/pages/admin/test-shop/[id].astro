---
export const prerender = false;

import MinimalLayout from '@/layouts/MinimalLayout.astro';
import StorefrontHeader from '@/components/shop/storefront/StorefrontHeader.astro';
import TestShopProductClientScripts from '@/components/admin/TestShopProductClientScripts.astro';
import OwnerPreviewToolbar from '@/components/shop/OwnerPreviewToolbar.astro';
import CartDrawerMount from '@/components/shop/CartDrawerMount.astro';
import RetailOnboardingTaskCard from '@/components/admin/retail-onboarding/RetailOnboardingTaskCard';
import StorefrontProductDetail from '@/components/shop/storefront/StorefrontProductDetail';
import { isTenantAdminAccess, resolveAdminAccess } from '@/lib/admin/auth';
import { resolveRetailOnboardingProduct } from '@/lib/admin/retailOnboardingProduct';
import { prisma } from '@/lib/db/client';
import {
  relatedStorefrontProducts,
  storefrontProductFromPrisma,
} from '@/lib/shop/storefrontCatalog';
import '@/styles/tokens.css';
import '@/styles/fonts-admin.css';
import '@/styles/global.css';
import '@/styles/components/buttons.css';
import '@/styles/components/badge.css';
import '@/styles/components/owner-preview-toolbar.css';
import '@/styles/components/storefront.css';
import '@/styles/components/storefront-cart.css';
import '@/styles/components/empty-state.css';
import '@/styles/components/inputs.css';

const access = await resolveAdminAccess(Astro);
if (!isTenantAdminAccess(access)) {
  return Astro.redirect('/admin');
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/admin/test-shop');
}

const rows = await prisma.product.findMany({
  where: { shopId: access.shopId, active: true },
  orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }],
  select: {
    id: true,
    name: true,
    description: true,
    pricePence: true,
    imageUrl: true,
    category: true,
    featured: true,
    sortOrder: true,
    active: true,
  },
});

const catalog = rows.map(storefrontProductFromPrisma);
const product = catalog.find((item) => item.id === id) ?? null;

if (!product) {
  return Astro.redirect('/admin/test-shop');
}

const related = relatedStorefrontProducts(catalog, product.id);

const retailContext = await resolveRetailOnboardingProduct(access.shopId);
let verifiedTestOrderId: string | null = null;
if (retailContext.retailTestOrderId) {
  const testOrder = await prisma.order.findFirst({
    where: {
      id: retailContext.retailTestOrderId,
      shopId: access.shopId,
      isTestOrder: true,
    },
    select: { id: true },
  });
  verifiedTestOrderId = testOrder?.id ?? null;
}
const showRetailTaskCard =
  !retailContext.retailOnboardingSkipped &&
  !retailContext.retailPickupWalkthroughCompleted &&
  (Boolean(retailContext.product) || retailContext.retailOnboardingCompleted);

const shop = await prisma.shopSettings.findUnique({
  where: { id: access.shopId },
  select: { name: true, logoUrl: true },
});
const shopTitle = shop?.name?.trim() || 'My shop';
const currentPath = Astro.url.pathname;
---

<MinimalLayout
  title={`${product.name} | Kersivo Admin`}
  description={product.description || `${product.name} at ${shopTitle}`}
  canonicalPath={`/admin/test-shop/${product.id}`}
  noindex={true}
  htmlClass="admin-app-scroll"
  bodyClass="admin-theme-premium-black has-owner-preview-toolbar"
  showCookieConsent={false}
>
  <div data-sf-page-shell>
  <OwnerPreviewToolbar adminHref="/admin" />
  <StorefrontHeader
    themeId="kersivo"
    currentPath={currentPath}
    homeHref="/admin/test-shop"
    navHomeHref="/"
    homeLabel={`${shopTitle} shop`}
    items={[{ href: '/admin/test-shop', label: 'Shop' }]}
    bookHref="/admin/test-book"
    shopName={shopTitle}
    logoUrl={shop?.logoUrl}
    showBag
  />
  <main class="container shop-page" data-sf-header-inert>
    <div class="test-shop-topbar">
      <a href="/admin/test-shop" class="sf-pdp-back product-back-link">← Back to my shop</a>
    </div>

    {
      showRetailTaskCard ? (
        <RetailOnboardingTaskCard
          client:load
          product={retailContext.product}
          testOrderId={verifiedTestOrderId}
          compact
          source="test-shop-pdp"
        />
      ) : null
    }

    <StorefrontProductDetail
      client:load
      product={product}
      related={related}
      themeId="kersivo"
      shopName={shopTitle}
      backHref="/admin/test-shop"
      productHrefPrefix="/admin/test-shop"
      priceFormat="gbp"
      imageFallback="initial"
      fulfilmentLabel="Ready for pickup"
      addToBagLabel="Add to bag"
    />
  </main>
  </div>

  <CartDrawerMount
    mode="testOrder"
    shopId=""
    shopName={shopTitle}
    themeId="kersivo"
    priceFormat="gbp"
    exploreHref="/admin/test-shop"
    checkout={{ type: 'testOrder' }}
  />
</MinimalLayout>

<style>
  .test-shop-topbar {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-md);
  }
</style>

<TestShopProductClientScripts />
