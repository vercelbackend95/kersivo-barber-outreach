---
export const prerender = false;

import MinimalLayout from '@/layouts/MinimalLayout.astro';
import CartDrawerMount from '@/components/shop/CartDrawerMount.astro';
import { resolveAdminAccess } from '@/lib/admin/auth';
import { prisma } from '@/lib/db/client';
import { formatGbp } from '@/lib/shop/money';
import {
  CATEGORY_LABELS,
  createHighlights,
  splitDescription,
  type ProductCategory,
} from '@/lib/shop/productPresentation';
import '@/styles/tokens.css';
import '@/styles/fonts-admin.css';
import '@/styles/global.css';
import '@/styles/components/buttons.css';
import '@/styles/components/badge.css';
import '@/styles/components/shop.css';
import '@/styles/components/shop-product.css';
import '@/styles/components/empty-state.css';
import '@/styles/components/inputs.css';

const access = await resolveAdminAccess(Astro);
if (!access || access.via !== 'session') {
  return Astro.redirect('/admin');
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/admin/test-shop');
}

const product = await prisma.product.findFirst({
  where: { id, shopId: access.shopId },
  select: {
    id: true,
    name: true,
    description: true,
    pricePence: true,
    imageUrl: true,
    category: true,
    active: true,
  },
});

if (!product || !product.active) {
  return Astro.redirect('/admin/test-shop');
}

const relatedProducts = await prisma.product.findMany({
  where: {
    shopId: access.shopId,
    active: true,
    id: { not: product.id },
    category: product.category,
  },
  orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }],
  take: 3,
  select: {
    id: true,
    name: true,
    pricePence: true,
    imageUrl: true,
    category: true,
  },
});

const { intro, details } = splitDescription(product.description);
const highlights = createHighlights(product.description, product.category);
const categoryLabel = CATEGORY_LABELS[product.category as ProductCategory] ?? 'Styling';
---

<MinimalLayout
  title={`${product.name} | Kersivo Admin`}
  description={intro}
  canonicalPath={`/admin/test-shop/${product.id}`}
  noindex={true}
  htmlClass="admin-app-scroll"
  bodyClass="admin-theme-premium-black"
  showCookieConsent={false}
>
  <main class="container product-page">
    <div class="test-shop-topbar">
      <a href="/admin/test-shop" class="product-back-link">← Back to my shop</a>
      <button type="button" class="btn btn--secondary btn--sm test-shop-cart-btn" data-navbar-cart-button aria-label="Open cart">
        Cart
        <span class="test-shop-cart-badge is-empty" data-navbar-cart-badge>0</span>
      </button>
    </div>

    <section class="retail-demo-banner" aria-label="Test order guidance">
      <p class="retail-demo-banner__label">Test order</p>
      <p class="retail-demo-banner__lead">Place your first test order</p>
      <p class="retail-demo-banner__support">
        Add your new product to the basket and experience the checkout as your customer would.
      </p>
    </section>

    <section class="product-hero" aria-label="Product details">
      <div class="product-media">
        {
          product.imageUrl ? (
            <img src={product.imageUrl} alt={product.name} class="product-image" loading="eager" />
          ) : (
            <div class="product-image-placeholder">No image available</div>
          )
        }
      </div>

      <div class="product-content">
        <p class="product-overline">{categoryLabel}</p>
        <h1>{product.name}</h1>
        <p class="product-price">{formatGbp(product.pricePence)}</p>
        <p class="product-intro">{intro}</p>

        {
          highlights.length > 0 ? (
            <ul class="product-highlights" aria-label="Product highlights">
              {highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : null
        }

        <div class="product-actions">
          <button
            type="button"
            class="btn btn--primary"
            data-add-to-cart
            data-product-id={product.id}
            data-product-name={product.name}
            data-product-price-pence={String(product.pricePence)}
            data-product-image-url={product.imageUrl ?? ''}
          >
            Add to cart
          </button>
          <a href="/admin/test-shop" class="btn btn--secondary">Continue shopping</a>
        </div>

        <aside class="pickup-box" aria-label="Pickup information">
          <p class="pickup-box-title">Ready for pickup</p>
          <p>Order online in seconds and collect in the shop when it suits your day.</p>
        </aside>
      </div>
    </section>

    {
      details ? (
        <section class="product-detail-section" aria-label="Product information">
          <h2>Details</h2>
          <p>{details}</p>
        </section>
      ) : null
    }

    {
      relatedProducts.length > 0 ? (
        <section class="related-products" aria-label="Related products">
          <header class="related-products-header">
            <h2>You may also like</h2>
            <p>More products from your shop in the same category.</p>
          </header>

          <div class="related-products-carousel">
            <div class="related-products-grid">
              {relatedProducts.map((item) => (
                <article class="shop-card" data-category={item.category}>
                  <a
                    href={`/admin/test-shop/${item.id}`}
                    class="shop-media-link"
                    aria-label={`View ${item.name}`}
                  >
                    <div class="shop-media">
                      {item.imageUrl ? (
                        <img src={item.imageUrl} alt={item.name} class="shop-image" loading="lazy" />
                      ) : (
                        <div class="shop-image shop-image--placeholder" aria-hidden="true" />
                      )}
                    </div>
                  </a>
                  <div class="shop-card-body">
                    <p class="shop-category">
                      {CATEGORY_LABELS[item.category as ProductCategory] ?? 'Styling'}
                    </p>
                    <h3>
                      <a href={`/admin/test-shop/${item.id}`}>{item.name}</a>
                    </h3>
                    <p class="shop-price">{formatGbp(item.pricePence)}</p>
                    <div class="shop-card-actions">
                      <button
                        type="button"
                        class="btn btn--primary btn--atc"
                        data-add-to-cart
                        data-product-id={item.id}
                        data-product-name={item.name}
                        data-product-price-pence={String(item.pricePence)}
                        data-product-image-url={item.imageUrl ?? ''}
                        data-atc-label="Add to cart"
                      >
                        Add to cart
                      </button>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      ) : null
    }
  </main>

  <CartDrawerMount />
</MinimalLayout>

<style>
  .test-shop-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  .test-shop-cart-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .test-shop-cart-badge {
    min-width: 1.35rem;
    height: 1.35rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    display: inline-grid;
    place-items: center;
    font-size: 0.72rem;
    font-weight: 700;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--fg);
  }

  .test-shop-cart-badge.is-empty {
    opacity: 0.55;
  }
</style>

<script>
  const CART_OPEN_REQUEST_EVENT = 'kersivo:cart-open-request';
  const cartButton = document.querySelector('[data-navbar-cart-button]');
  if (cartButton instanceof HTMLButtonElement) {
    cartButton.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent(CART_OPEN_REQUEST_EVENT));
    });
  }
</script>
