---
export const prerender = false;

import MinimalLayout from '@/layouts/MinimalLayout.astro';
import PrivateDemoAuthPanel from '@/components/admin/PrivateDemoAuthPanel';
import PreviewLaunchOnboarding from '@/components/freePreview/PreviewLaunchOnboarding';
import HubLaunchChecklist from '@/components/previewHub/HubLaunchChecklist';
import { resolveAdminAccess } from '@/lib/admin/auth';
import { accessCan } from '@/lib/admin/rbac/can';
import { PREVIEW_ONBOARDING_PATH, isPreviewHubEnabled } from '@/lib/freePreview/config';
import { HUB_LAUNCH_SIGN_IN } from '@/lib/freePreview/hubCopy';
import { loadPreviewOnboarding } from '@/lib/freePreview/previewOnboarding';
import { PRIVATE_PREVIEW_HEADERS } from '@/lib/freePreview/previewHeaders';
import '@/styles/tokens.css';
import '@/styles/fonts-admin.css';
import '@/styles/global.css';
import '@/styles/components/inputs.css';
import '@/styles/components/buttons.css';
import '@/styles/components/free-preview-onboarding.css';
import '@/styles/components/ks-glass-card.css';
import '@/styles/components/domain-searcher.css';
import '@/styles/components/preview-hub.css';
import '@/styles/components/admin-login.css';

const hubOn = isPreviewHubEnabled();
if (hubOn) {
  for (const [name, value] of Object.entries(PRIVATE_PREVIEW_HEADERS)) {
    Astro.response.headers.set(name, value);
  }
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}

const access = await resolveAdminAccess(Astro);
const canManage = Boolean(access && access.via === 'session' && accessCan(access, 'billing.manage'));

if (!hubOn && !canManage) return Astro.redirect('/admin');

const prefill = canManage ? await loadPreviewOnboarding(access!.shopId) : null;
if (canManage && !prefill) return Astro.redirect('/admin/client-onboarding');
---

<MinimalLayout
  title="Finish launching your website | KERSIVO"
  description="Confirm your details, domain and payments to launch your KERSIVO website."
  canonicalPath={PREVIEW_ONBOARDING_PATH}
  noindex={true}
  enableAnalytics={false}
  htmlClass="admin-app-scroll"
  bodyClass="admin-theme-premium-black"
  viewportContent="width=device-width, initial-scale=1, viewport-fit=cover"
>
  <main class="container page-wrap">
    {
      !hubOn && prefill ? (
        <PreviewLaunchOnboarding client:load prefill={prefill} />
      ) : hubOn && !canManage ? (
        <div class="hub-launch-gate">
          <h1>{HUB_LAUNCH_SIGN_IN}</h1>
          <PrivateDemoAuthPanel
            client:load
            initialMode="login"
            callbackURL={PREVIEW_ONBOARDING_PATH}
            title="Sign in"
            subtitle="Finish your launch checklist in your dashboard."
            showGoogle={false}
            allowSignup={false}
          />
        </div>
      ) : hubOn && canManage ? (
        <HubLaunchChecklist client:load />
      ) : null
    }
  </main>
</MinimalLayout>
