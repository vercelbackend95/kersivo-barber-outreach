---
export const prerender = false;

import MinimalLayout from '@/layouts/MinimalLayout.astro';
import BookingFlow from '@/components/booking/BookingFlow';
import { resolveAdminAccess } from '@/lib/admin/auth';
import { prisma } from '@/lib/db/client';
import {
  PUBLIC_BOOKING_UNAVAILABLE_MESSAGE,
  PUBLIC_FALLBACK_SHOP_SETTINGS,
} from '@/lib/db/resilience';
import '@/styles/tokens.css';
import '@/styles/fonts.css';
import '@/styles/global.css';
import '@/styles/components/buttons.css';
import '@/styles/components/badge.css';
import '@/styles/components/booking.css';
import '@/styles/components/booking-flow.css';
import '@/styles/components/booking-mobile.css';
import '@/styles/components/booking-review.css';
import '@/styles/components/empty-state.css';
import '@/styles/components/skeleton.css';

const access = await resolveAdminAccess(Astro);
if (!access || access.via !== 'session') {
  return Astro.redirect('/admin');
}

const shop = await prisma.shopSettings.findUnique({
  where: { id: access.shopId },
  select: {
    onboardingCompleted: true,
    timezone: true,
    cancellationWindowHours: true,
    rescheduleWindowHours: true,
  },
});

if (shop && shop.onboardingCompleted === false) {
  return Astro.redirect('/admin/onboarding');
}

const [services, barbers] = await Promise.all([
  prisma.service.findMany({
    where: { isActive: true, shopId: access.shopId },
    orderBy: [{ displayOrder: 'asc' }, { createdAt: 'asc' }],
  }),
  prisma.barber.findMany({
    where: { active: true, shopId: access.shopId },
    orderBy: [{ sortOrder: 'asc' }, { createdAt: 'asc' }],
    include: {
      barberServices: {
        select: { serviceId: true },
      },
    },
  }),
]);

const bookingUnavailable = services.length === 0 || barbers.length === 0;
const shopSettings = shop ?? {
  timezone: PUBLIC_FALLBACK_SHOP_SETTINGS.timezone,
  cancellationWindowHours: PUBLIC_FALLBACK_SHOP_SETTINGS.cancellationWindowHours,
  rescheduleWindowHours: PUBLIC_FALLBACK_SHOP_SETTINGS.rescheduleWindowHours,
};
---

<MinimalLayout
  title="Test booking | Kersivo Admin"
  description="Book a test appointment with your barbershop setup."
  canonicalPath="/admin/test-book"
  noindex={true}
  bodyClass="admin-theme-premium-black"
  showCookieConsent={false}
>
  <main class="container page-wrap booking-page-wrap">
    {
      bookingUnavailable ? (
        <section class="surface booking-shell">
          <h1>Test booking</h1>
          <p class="admin-inline-error">
            {PUBLIC_BOOKING_UNAVAILABLE_MESSAGE}
          </p>
          <p class="admin-inline-error">
            Add at least one active service and barber, then try again.
          </p>
          <a class="btn btn--secondary" href="/admin?section=bookings_dashboard">Go to dashboard</a>
        </section>
      ) : (
        <BookingFlow
          client:load
          services={services}
          barbers={barbers.map((barber) => ({
            id: barber.id,
            name: barber.name,
            avatarUrl: barber.avatarUrl,
            serviceIds: barber.barberServices.map((link) => link.serviceId),
          }))}
          shopDetails={{
            timezone: shopSettings.timezone,
            cancellationWindowHours: shopSettings.cancellationWindowHours,
            rescheduleWindowHours: shopSettings.rescheduleWindowHours,
          }}
          postConfirmCta={{
            label: 'See your timeline',
            destination: 'admin-timeline',
          }}
        />
      )
    }
  </main>
</MinimalLayout>
