---
export const prerender = false;

import type { APIContext } from 'astro';
import { ADMIN_PRIVATE_HEADERS, adminSessionShopFor, resolveAdminPageMode } from '@/lib/adminHub/adminMode';
import { ADMIN_HUB_LINKS, adminHubUrlFor } from '@/lib/adminHub/links';
import { parseAdminHubLocation } from '@/lib/adminHub/hubView';
import { previewHubLegacyRedirect } from '@/lib/adminHub/previewHubPaths';
import { hubNotFound } from '@/lib/freePreview/hubPage';

/** Legacy /admin/hub → the path route. Token is never exposed. */
const now = new Date();
const mode =
  Astro.locals.adminHubMode ??
  (await resolveAdminPageMode({
    request: Astro.request,
    now,
    sessionShop: () => adminSessionShopFor(Astro as unknown as APIContext),
  }));
if (!mode) return hubNotFound();
if (mode.kind !== 'hub') {
  const headers = new Headers({ Location: '/admin', ...ADMIN_PRIVATE_HEADERS });
  if (mode.setCookie) headers.append('Set-Cookie', mode.setCookie);
  return new Response(null, { status: 303, headers });
}

const fromQuery = previewHubLegacyRedirect(Astro.url);
const location = parseAdminHubLocation(Astro.url);
const mapped =
  fromQuery ??
  (location.section === 'changes'
    ? ADMIN_HUB_LINKS.changes
    : location.section === 'website'
      ? location.view === 'booking'
        ? ADMIN_HUB_LINKS.booking
        : ADMIN_HUB_LINKS.website
      : location.section === 'messages'
        ? location.draft
          ? ADMIN_HUB_LINKS.messagesDraft(location.draft)
          : ADMIN_HUB_LINKS.messages
        : adminHubUrlFor('overview', Astro.url.searchParams));

const headers = new Headers({ Location: mapped, ...ADMIN_PRIVATE_HEADERS });
if (mode.setCookie) headers.append('Set-Cookie', mode.setCookie);
return new Response(null, { status: 303, headers });
---
