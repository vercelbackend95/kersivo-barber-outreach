---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Faq4 from '@/components/faq4.astro';
import Footer50 from '@/components/footer50.astro';
import Contact16 from '@/components/contact16.astro';
import NearcutHero from '@/components/nearcutAlternative/NearcutHero.astro';
import NearcutCompare from '@/components/nearcutAlternative/NearcutCompare.astro';
import NearcutProof from '@/components/nearcutAlternative/NearcutProof.astro';
import NearcutPricing from '@/components/nearcutAlternative/NearcutPricing.astro';
import ComparisonFinalCta from '@/components/comparison/ComparisonFinalCta.astro';
import NearcutQuickAnswer from '@/components/nearcutAlternative/NearcutQuickAnswer.astro';
import NearcutWhy from '@/components/nearcutAlternative/NearcutWhy.astro';
import NearcutCosts from '@/components/nearcutAlternative/NearcutCosts.astro';
import NearcutFit from '@/components/nearcutAlternative/NearcutFit.astro';
import NearcutSwitching from '@/components/nearcutAlternative/NearcutSwitching.astro';
import NearcutSources from '@/components/nearcutAlternative/NearcutSources.astro';
import CompareHubLink from '@/components/alternativesHub/CompareHubLink.astro';
import {
  NEARCUT_ALTERNATIVE_DESCRIPTION,
  NEARCUT_ALTERNATIVE_FAQ_ITEMS,
  NEARCUT_ALTERNATIVE_PAGE_PATH,
  NEARCUT_ALTERNATIVE_TITLE,
  buildNearcutAlternativeFaqJsonLd,
} from '@/lib/seo/nearcutAlternativeFaq';
import {
  buildNearcutAlternativeBreadcrumbJsonLd,
  buildNearcutAlternativeWebPageJsonLd,
} from '@/lib/seo/nearcutAlternativeJsonLd';
import {
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';
import '@/styles/components/fresha-alternative.css';

const currentYear = new Date().getFullYear();
---

<LandingLayout
  title={NEARCUT_ALTERNATIVE_TITLE}
  description={NEARCUT_ALTERNATIVE_DESCRIPTION}
  canonicalPath={NEARCUT_ALTERNATIVE_PAGE_PATH}
  jsonLd={[buildNearcutAlternativeWebPageJsonLd(), buildNearcutAlternativeBreadcrumbJsonLd(), buildNearcutAlternativeFaqJsonLd()]}
>
  <main class="fresha-alt landing-overflow-guard">
    <NearcutHero />
    <NearcutQuickAnswer />
    <NearcutWhy />
    <NearcutCosts />
    <NearcutCompare />
    <NearcutProof />
    <NearcutFit />
    <NearcutSwitching />
    <NearcutPricing />

    <Faq4
      className="faq4--landing"
      heading="Questions about Nearcut and KERSIVO?"
      subHeading="Clear answers on booking charges, pricing, switching, websites and the live demo."
      supportHeading="Still comparing options?"
      supportText="Tell us what you use today and what you want your booking journey to look like."
      supportLinkLabel="Ask KERSIVO a question"
      supportLinkHref="#contact"
      faqs={NEARCUT_ALTERNATIVE_FAQ_ITEMS}
    />

    <ComparisonFinalCta placement="nearcut" competitor="Nearcut" />

    <Contact16
      eyebrow="CONTACT KERSIVO"
      title="Still comparing KERSIVO and Nearcut?"
      description="Tell us what you use today and what you want to change. We’ll reply with a clear, practical answer for your barbershop."
      note="We’ll reply by email — no sales call required."
      submitLabel="Send my question"
      messagePlaceholder="For example: Nearcut booking charges, deposits, client data exports or an own-domain booking website."
    />

    <CompareHubLink />
    <NearcutSources />

    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      social={getFooterSocialLinks()}
    />
  </main>
</LandingLayout>

<script>
  import { initFeature261StaggerReveal } from '@/lib/landing/initFeature261StaggerReveal';

  const scheduleInit = () => {
    requestAnimationFrame(() => {
      const section = document.querySelector('.feature261');
      if (!(section instanceof HTMLElement) || section.dataset.feature261Enhanced === 'true') return;
      const cleanup = initFeature261StaggerReveal(section);
      document.addEventListener('astro:before-swap', cleanup, { once: true });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleInit, { once: true });
  } else {
    scheduleInit();
  }
  document.addEventListener('astro:page-load', scheduleInit);
</script>

<script>
  import { destroyProductRails, initProductRails } from '@/lib/shop/initProductRail';

  const bootProductRails = () => {
    destroyProductRails();
    initProductRails();
  };

  bootProductRails();
  document.addEventListener('astro:page-load', bootProductRails);
</script>

<style is:global>
  .landing-overflow-guard {
    overflow-x: clip;
  }
</style>
