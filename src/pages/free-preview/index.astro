---
export const prerender = false;

import { CreditCard, EyeOff, LayoutTemplate, CalendarCheck, PenLine, PhoneOff, Smartphone } from 'lucide-react';
import LandingLayout from '@/layouts/LandingLayout.astro';
import Footer50 from '@/components/footer50.astro';
import Accordion from '@/components/ui/Accordion.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import FreePreviewForm from '@/components/freePreview/FreePreviewForm.astro';
import FreePreviewShowcase from '@/components/freePreview/FreePreviewShowcase.astro';
import PageBreadcrumbs from '@/components/seo/PageBreadcrumbs.astro';
import { isFreePreviewFlowEnabled, isPreviewHubEnabled } from '@/lib/freePreview/config';
import {
  FREE_PREVIEW_BREADCRUMBS,
  FREE_PREVIEW_PAGE,
  buildFreePreviewBreadcrumbJsonLd,
  buildFreePreviewFaqJsonLd,
  buildFreePreviewWebPageJsonLd,
  getFreePreviewFaqItems,
} from '@/lib/seo/freePreviewPage';
import { buildKersivoEntityJsonLd } from '@/lib/seo/kersivoEntityJsonLd';
import { KERSIVO_CONTACT_EMAIL, getFooterSocialLinks } from '@/lib/seo/footerSocialLinks';
import '@/styles/components/ks-glass-card.css';
import '@/styles/components/free-preview.css';

// Flag off: the page does not exist (docs/free-preview-discovery.md §13).
if (!isFreePreviewFlowEnabled()) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const trustIcons = [CreditCard, PhoneOff, EyeOff] as const;
const getIcons = [LayoutTemplate, CalendarCheck, Smartphone, PenLine] as const;
const hubEnabled = isPreviewHubEnabled();
const faqItems = getFreePreviewFaqItems(hubEnabled).map((faq, index) => ({
  id: `free-preview-faq-${index + 1}`,
  title: faq.question,
  body: faq.answer,
}));
---

<LandingLayout
  title={FREE_PREVIEW_PAGE.title}
  description={FREE_PREVIEW_PAGE.description}
  canonicalPath={FREE_PREVIEW_PAGE.path}
  jsonLd={[
    buildKersivoEntityJsonLd(),
    buildFreePreviewWebPageJsonLd(),
    buildFreePreviewBreadcrumbJsonLd(),
    buildFreePreviewFaqJsonLd(hubEnabled),
  ]}
>
  <main class="free-preview">
    <section class="free-preview__hero" aria-labelledby="free-preview-title">
      <div class="container free-preview__hero-grid">
        <div class="free-preview__copy">
          <PageBreadcrumbs trail={FREE_PREVIEW_BREADCRUMBS} />
          <p class="free-preview__eyebrow">
            <span class="free-preview__eyebrow-dot" aria-hidden="true"></span>
            {FREE_PREVIEW_PAGE.eyebrow}
          </p>
          <h1 id="free-preview-title" class="free-preview__title">
            <span class="free-preview__title-line free-preview__title-line--primary">{FREE_PREVIEW_PAGE.h1Lines[0]}</span>{' '}
            <span class="free-preview__title-line">{FREE_PREVIEW_PAGE.h1Lines[1]}</span>
          </h1>
          <p class="free-preview__intro">{FREE_PREVIEW_PAGE.intro}</p>
          <ul class="free-preview__trust" aria-label="What to expect">
            {FREE_PREVIEW_PAGE.trustLine.map((item, index) => {
              const Icon = trustIcons[index] ?? CreditCard;
              return (
                <li>
                  <span class="free-preview__trust-icon" aria-hidden="true">
                    <Icon size={14} strokeWidth={1.8} />
                  </span>
                  {item}
                </li>
              );
            })}
          </ul>
        </div>

        <div id="request" class="free-preview__form-col" aria-labelledby="free-preview-form-title">
          <FreePreviewForm />
        </div>

        <section class="free-preview__timeline ks-glass-card" aria-labelledby="free-preview-next-title">
          <h2 id="free-preview-next-title" class="free-preview__timeline-title">{FREE_PREVIEW_PAGE.timelineHeading}</h2>
          <ol class="free-preview__steps">
            {FREE_PREVIEW_PAGE.steps.map((step, index) => (
              <li class:list={['free-preview__step', `free-preview__step--${step.owner === 'KERSIVO' ? 'kersivo' : 'you'}`]}>
                <span class="free-preview__step-node" aria-hidden="true">{index + 1}</span>
                <span class="free-preview__step-title">{step.title}</span>
                <span class="free-preview__step-owner">{step.owner}</span>
              </li>
            ))}
          </ol>
        </section>
      </div>
    </section>

    <section class="free-preview__section free-preview__section--showcase" aria-labelledby="free-preview-showcase-title">
      <div class="container">
        <SectionHeader
          eyebrow={FREE_PREVIEW_PAGE.showcaseEyebrow}
          title={FREE_PREVIEW_PAGE.showcaseHeading}
          titleId="free-preview-showcase-title"
        />
        <FreePreviewShowcase />
      </div>
    </section>

    <section class="free-preview__section" aria-labelledby="free-preview-get-title">
      <div class="container">
        <SectionHeader title={FREE_PREVIEW_PAGE.whatYouGetHeading} titleId="free-preview-get-title" />
        <ul class="free-preview__get">
          {FREE_PREVIEW_PAGE.whatYouGet.map((item, index) => {
            const Icon = getIcons[index] ?? LayoutTemplate;
            return (
              <li class="free-preview__get-card ks-glass-card">
                <span class="free-preview__get-icon" aria-hidden="true">
                  <Icon size={18} strokeWidth={1.7} />
                </span>
                <p>{item}</p>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <section id="faq" class="free-preview__section free-preview__faq" aria-labelledby="free-preview-faq-title">
      <div class="container">
        <SectionHeader title={FREE_PREVIEW_PAGE.faqHeading} titleId="free-preview-faq-title" />
        <Accordion items={faqItems} />
        <p class="free-preview__starter">
          {FREE_PREVIEW_PAGE.starterBefore} <a href="/starter">{FREE_PREVIEW_PAGE.starterLink}</a>
        </p>
      </div>
    </section>

    <a class="free-preview__sticky-bar" href="#request" data-fp-sticky-bar hidden>
      {FREE_PREVIEW_PAGE.submitLabel}
    </a>

    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${new Date().getFullYear()} KERSIVO`}
      social={getFooterSocialLinks()}
    />
  </main>
</LandingLayout>

<script>
  let teardown: AbortController | null = null;

  function initFreePreviewPage() {
    teardown?.abort();
    teardown = null;

    const card = document.querySelector('[data-free-preview]');
    const column = document.querySelector('#request');
    if (!(card instanceof HTMLElement) || !(column instanceof HTMLElement)) return;

    const controller = new AbortController();
    teardown = controller;
    const { signal } = controller;
    const observe = (observer: IntersectionObserver | ResizeObserver, target: Element) => {
      observer.observe(target);
      signal.addEventListener('abort', () => observer.disconnect());
    };

    // Sticky only when the whole card fits in the viewport; a validation error can change that.
    const desktop = window.matchMedia('(min-width: 64rem)');
    const updateSticky = () => {
      column.toggleAttribute('data-fp-sticky', desktop.matches && card.offsetHeight < window.innerHeight - 48);
    };
    updateSticky();
    observe(new ResizeObserver(updateSticky), card);
    window.addEventListener('resize', updateSticky, { signal });

    // Mobile bar: only once the card is fully off screen, never over the footer or a focused field.
    const bar = document.querySelector('[data-fp-sticky-bar]');
    const form = card.querySelector('[data-free-preview-form]');
    const footer = document.querySelector('.free-preview footer');
    if (bar instanceof HTMLElement && form instanceof HTMLElement) {
      let cardVisible = true;
      let footerVisible = false;
      let fieldFocused = false;
      const updateBar = () => {
        bar.hidden = cardVisible || footerVisible || fieldFocused || form.hidden;
      };
      observe(
        new IntersectionObserver(([entry]) => {
          cardVisible = entry.isIntersecting;
          updateBar();
        }),
        card,
      );
      if (footer) {
        observe(
          new IntersectionObserver(([entry]) => {
            footerVisible = entry.isIntersecting;
            updateBar();
          }),
          footer,
        );
      }
      const isField = (target: EventTarget | null) =>
        target instanceof Element && target.matches('input, select, textarea');
      document.addEventListener(
        'focusin',
        (event) => {
          fieldFocused = isField(event.target);
          updateBar();
        },
        { signal },
      );
      document.addEventListener(
        'focusout',
        () => {
          fieldFocused = false;
          updateBar();
        },
        { signal },
      );
    }

    // Showcase fade-in: only when it starts below the fold, so nothing in the first viewport waits.
    const reveal = document.querySelector('[data-fp-reveal]');
    if (
      reveal instanceof HTMLElement &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      reveal.getBoundingClientRect().top > window.innerHeight
    ) {
      reveal.classList.add('is-pending');
      const revealObserver = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          reveal.classList.remove('is-pending');
          revealObserver.disconnect();
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      observe(revealObserver, reveal);
    }
  }

  initFreePreviewPage();
  document.addEventListener('astro:page-load', initFreePreviewPage);
</script>
