---
import LandingLayout from '@/layouts/LandingLayout.astro';
import { buildKersivoEntityJsonLd } from '@/lib/seo/kersivoEntityJsonLd';
import Faq4 from '@/components/faq4.astro';
import Footer50 from '@/components/footer50.astro';
import Contact16 from '@/components/contact16.astro';
import TreatwellHero from '@/components/treatwellAlternative/TreatwellHero.astro';
import TreatwellAnswer from '@/components/treatwellAlternative/TreatwellAnswer.astro';
import TreatwellOutcomes from '@/components/treatwellAlternative/TreatwellOutcomes.astro';
import TreatwellRule from '@/components/treatwellAlternative/TreatwellRule.astro';
import TreatwellCosts from '@/components/treatwellAlternative/TreatwellCosts.astro';
import TreatwellCompare from '@/components/treatwellAlternative/TreatwellCompare.astro';
import TreatwellProof from '@/components/treatwellAlternative/TreatwellProof.astro';
import TreatwellFit from '@/components/treatwellAlternative/TreatwellFit.astro';
import TreatwellSwitching from '@/components/treatwellAlternative/TreatwellSwitching.astro';
import TreatwellPricing from '@/components/treatwellAlternative/TreatwellPricing.astro';
import TreatwellSources from '@/components/treatwellAlternative/TreatwellSources.astro';
import ComparisonFinalCta from '@/components/comparison/ComparisonFinalCta.astro';
import CompareHubLink from '@/components/alternativesHub/CompareHubLink.astro';
import {
  TREATWELL_ALTERNATIVE_DESCRIPTION,
  TREATWELL_ALTERNATIVE_FAQ_ITEMS,
  TREATWELL_ALTERNATIVE_PAGE_PATH,
  TREATWELL_ALTERNATIVE_TITLE,
  buildTreatwellAlternativeFaqJsonLd,
} from '@/lib/seo/treatwellAlternativeFaq';
import {
  buildTreatwellAlternativeBreadcrumbJsonLd,
  buildTreatwellAlternativeWebPageJsonLd,
} from '@/lib/seo/treatwellAlternativeJsonLd';
import { TW_FAQ_HEADING, TW_FAQ_SUBHEADING } from '@/lib/seo/treatwellAlternativeContent';
import {
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';
import '@/styles/components/fresha-alternative.css';
import '@/styles/components/treatwell-alternative.css';

const currentYear = new Date().getFullYear();
---

<LandingLayout
  title={TREATWELL_ALTERNATIVE_TITLE}
  description={TREATWELL_ALTERNATIVE_DESCRIPTION}
  canonicalPath={TREATWELL_ALTERNATIVE_PAGE_PATH}
  jsonLd={[buildKersivoEntityJsonLd(), buildTreatwellAlternativeWebPageJsonLd(), buildTreatwellAlternativeBreadcrumbJsonLd(), buildTreatwellAlternativeFaqJsonLd()]}
>
  <main class="fresha-alt tw landing-overflow-guard">
    <TreatwellHero />
    <TreatwellAnswer />
    <TreatwellOutcomes />
    <TreatwellRule />
    <TreatwellCosts />
    <TreatwellCompare />
    <TreatwellProof />
    <TreatwellFit />
    <TreatwellSwitching />
    <TreatwellPricing />

    <Faq4
      className="faq4--landing"
      heading={TW_FAQ_HEADING}
      subHeading={TW_FAQ_SUBHEADING}
      supportHeading="Still comparing options?"
      supportText="Tell us how you take bookings today and what you want to change."
      supportLinkLabel="Ask KERSIVO a question"
      supportLinkHref="#contact"
      faqs={TREATWELL_ALTERNATIVE_FAQ_ITEMS}
    />

    <ComparisonFinalCta placement="treatwell" competitor="Treatwell" />

    <Contact16
      eyebrow="CONTACT KERSIVO"
      title="Still comparing KERSIVO and Treatwell?"
      description="Tell us what you use today and what you want to change. We’ll reply with a clear, practical answer for your barbershop."
      note="We’ll reply by email — no sales call required."
      submitLabel="Send my question"
      messagePlaceholder="For example: Treatwell marketplace commission, prepayment fees, data exports or an own-domain booking website."
    />

    <CompareHubLink />
    <TreatwellSources />

    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      social={getFooterSocialLinks()}
    />
  </main>
</LandingLayout>

<script>
  import { initTreatwellPage } from '@/lib/landing/treatwellPage';

  const boot = () => {
    const root = document.querySelector<HTMLElement>('main.tw');
    if (!root || root.dataset.twBound === 'true') return;
    root.dataset.twBound = 'true';
    const cleanup = initTreatwellPage(document);
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  };

  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<script>
  import { initFeature261StaggerReveal } from '@/lib/landing/initFeature261StaggerReveal';

  const scheduleInit = () => {
    requestAnimationFrame(() => {
      const section = document.querySelector('.feature261');
      if (!(section instanceof HTMLElement) || section.dataset.feature261Enhanced === 'true') return;
      const cleanup = initFeature261StaggerReveal(section);
      document.addEventListener('astro:before-swap', cleanup, { once: true });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleInit, { once: true });
  } else {
    scheduleInit();
  }
  document.addEventListener('astro:page-load', scheduleInit);
</script>

<script>
  import { destroyProductRails, initProductRails } from '@/lib/shop/initProductRail';

  const bootProductRails = () => {
    destroyProductRails();
    initProductRails();
  };

  bootProductRails();
  document.addEventListener('astro:page-load', bootProductRails);
</script>

<style is:global>
  .landing-overflow-guard {
    overflow-x: clip;
  }
</style>
