---
export const prerender = false;

import HubDocument from '@/layouts/HubDocument.astro';
import HubOverview from '@/components/previewHub/HubOverview.astro';
import HubShell from '@/components/previewHub/HubShell.astro';
import { analyticsClientIdFromRequest } from '@/lib/analytics/serverEvents';
import { buildHubChecklist, checklistFlagsFromAssets } from '@/lib/freePreview/hubChecklist';
import { loadActiveHubAssets } from '@/lib/freePreview/hubAssets';
import { countOpenHubChanges } from '@/lib/freePreview/hubChanges';
import { countUnreadKersivoMessages } from '@/lib/freePreview/hubMessages';
import { cardStateFromReview, loadHubReviewShopData, loadLatestHubReviews, reviewNowNeed } from '@/lib/freePreview/hubReviews';
import { loadHubLaunchProgress } from '@/lib/freePreview/hubLaunch';
import { isHubRouteEnabled, hubNotFound, loadHubOverviewExtras, designingAtFromEvents, hubActivityItems, hubStepper, recordHubOwnerView, resolveHubPageContext } from '@/lib/freePreview/hubPage';
import { applyPrivatePreviewHeaders } from '@/lib/freePreview/previewHeaders';
import { PREVIEW_PAGE_RATE } from '@/lib/freePreview/previewApi';
import { resolveOperatorAccess } from '@/lib/ops/operatorAuth';
import { enforceIpRateLimit } from '@/lib/rate-limit/enforceIpRateLimit';

applyPrivatePreviewHeaders(Astro.response.headers);

if (!isHubRouteEnabled()) return hubNotFound();

const limited = await enforceIpRateLimit(
  Astro.request,
  PREVIEW_PAGE_RATE.action,
  PREVIEW_PAGE_RATE.limit,
  PREVIEW_PAGE_RATE.windowMs,
);
if (limited) return limited;

const token = (Astro.params.token ?? '').trim();
const now = new Date();
const operator = await resolveOperatorAccess(Astro.request);
const ctx = await resolveHubPageContext({ token, isOperator: operator.ok, now });
if (!ctx) return hubNotFound();

if (ctx.state.stage === 'expired') Astro.response.status = 410;

await recordHubOwnerView({
  requestId: ctx.request.id,
  stage: ctx.state.stage,
  isOperator: ctx.isOperator,
  now,
  clientId: analyticsClientIdFromRequest(Astro.request),
}).catch((error) => {
  console.error('[preview-hub] view tracking failed', error instanceof Error ? error.message : error);
});

const [events, assets, unreadMessages, openChanges, reviews, reviewShop, launchProgress] = await Promise.all([
  loadHubOverviewExtras(ctx.request.id),
  loadActiveHubAssets(ctx.request.id),
  ctx.isOperator ? Promise.resolve(0) : countUnreadKersivoMessages(ctx.request.id),
  countOpenHubChanges(ctx.request.id),
  loadLatestHubReviews(ctx.request.id),
  ctx.request.draftShopId ? loadHubReviewShopData(ctx.request.draftShopId, ctx.request.id) : Promise.resolve(null),
  ctx.state.stage === 'launch' || ctx.state.stage === 'live'
    ? loadHubLaunchProgress(ctx.request.id)
    : Promise.resolve(null),
]);
const reviewNeed = reviewNowNeed({
  SERVICES: cardStateFromReview(reviews.SERVICES?.state ?? null),
  TEAM: cardStateFromReview(reviews.TEAM?.state ?? null),
  HOURS: cardStateFromReview(reviews.HOURS?.state ?? null),
});
const steps = hubStepper({
  stage: ctx.state.stage,
  createdAt: ctx.request.createdAt,
  designingAt: designingAtFromEvents(events),
  previewReadyAt: ctx.request.previewReadyAt,
  convertedAt: ctx.request.convertedAt,
  liveAt: ctx.request.liveAt,
});
const activity = hubActivityItems(events, now);
const checklist = buildHubChecklist({
  stage: ctx.state.stage,
  ...checklistFlagsFromAssets(assets, ctx.request.aboutText),
});
const shopName = ctx.request.shopName;
---

<HubDocument title={`Shop hub — ${shopName} | KERSIVO`}>
  <HubShell
    token={token}
    shopName={shopName}
    stage={ctx.state.stage}
    current="overview"
    capabilities={ctx.state.capabilities}
    unreadMessages={unreadMessages}
    openChanges={openChanges}
  >
    <HubOverview
      token={token}
      request={ctx.request}
      state={ctx.state}
      isOperator={ctx.isOperator}
      steps={steps}
      activity={activity}
      hasWebsitePreview={Boolean(ctx.draft?.shop.sitePreviewUrl)}
      checklist={checklist}
      reviews={reviews}
      reviewShop={reviewShop}
      reviewNeed={reviewNeed}
      launchProgress={launchProgress}
    />
  </HubShell>
</HubDocument>
