---
export const prerender = false;

import HubDocument from '@/layouts/HubDocument.astro';
import { adminHubBridge } from '@/lib/adminHub/bridge';
import HubShell from '@/components/previewHub/HubShell.astro';
import { HubChanges } from '@/components/previewHub/HubChanges';
import { analyticsClientIdFromRequest } from '@/lib/analytics/serverEvents';
import { HUB_LOCKED_REASON_PREVIEW, HUB_NAV, HUB_WEBSITE_LOCKED_BODY } from '@/lib/freePreview/hubCopy';
import { countOpenHubChanges, loadHubChanges } from '@/lib/freePreview/hubChanges';
import { countUnreadKersivoMessages } from '@/lib/freePreview/hubMessages';
import { hubNotFound, isHubRouteEnabled, recordHubOwnerView, resolveHubPageContext } from '@/lib/freePreview/hubPage';
import { applyPrivatePreviewHeaders } from '@/lib/freePreview/previewHeaders';
import { PREVIEW_PAGE_RATE } from '@/lib/freePreview/previewApi';
import { resolveOperatorAccess } from '@/lib/ops/operatorAuth';
import { enforceIpRateLimit } from '@/lib/rate-limit/enforceIpRateLimit';

applyPrivatePreviewHeaders(Astro.response.headers);

const bridged = await adminHubBridge({
  request: Astro.request,
  url: Astro.url,
  token: Astro.params.token ?? '',
  subroute: 'changes',
  rateLimit: true,
});
if (bridged) return bridged;

if (!isHubRouteEnabled()) return hubNotFound();

const limited = await enforceIpRateLimit(
  Astro.request,
  PREVIEW_PAGE_RATE.action,
  PREVIEW_PAGE_RATE.limit,
  PREVIEW_PAGE_RATE.windowMs,
);
if (limited) return limited;

const token = (Astro.params.token ?? '').trim();
const now = new Date();
const operator = await resolveOperatorAccess(Astro.request);
const ctx = await resolveHubPageContext({ token, isOperator: operator.ok, now });
if (!ctx) return hubNotFound();
if (ctx.state.stage === 'expired') Astro.response.status = 410;

await recordHubOwnerView({
  requestId: ctx.request.id,
  stage: ctx.state.stage,
  isOperator: ctx.isOperator,
  now,
  clientId: analyticsClientIdFromRequest(Astro.request),
}).catch((error) => {
  console.error('[preview-hub] view tracking failed', error instanceof Error ? error.message : error);
});

const [unreadMessages, changeItems, openChanges] = await Promise.all([
  ctx.isOperator ? Promise.resolve(0) : countUnreadKersivoMessages(ctx.request.id),
  ctx.state.capabilities.canDraftChanges ? loadHubChanges(ctx.request.id) : Promise.resolve([]),
  ctx.state.capabilities.canDraftChanges ? countOpenHubChanges(ctx.request.id) : Promise.resolve(0),
]);
---

<HubDocument title={`${HUB_NAV.changes} — ${ctx.request.shopName} | KERSIVO`}>
  <HubShell
    token={token}
    shopName={ctx.request.shopName}
    stage={ctx.state.stage}
    current="changes"
    capabilities={ctx.state.capabilities}
    unreadMessages={unreadMessages}
    openChanges={openChanges}
  >
    {
      ctx.state.capabilities.canDraftChanges ? (
        <HubChanges
          client:load
          token={token}
          initialItems={changeItems}
          includedChangeRounds={ctx.request.includedChangeRounds}
          changeRoundsUsed={ctx.request.changeRoundsUsed}
          canDraft={ctx.state.capabilities.canDraftChanges}
          canSend={ctx.state.capabilities.canSendChanges}
        />
      ) : (
        <section class="hub-card ks-glass-card ks-glass-card--accent hub-placeholder">
          <h1>{HUB_LOCKED_REASON_PREVIEW}</h1>
          <p class="hub-card__body">{HUB_WEBSITE_LOCKED_BODY}</p>
        </section>
      )
    }
  </HubShell>
</HubDocument>
