---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Faq4 from '@/components/faq4.astro';
import Footer50 from '@/components/footer50.astro';
import Contact16 from '@/components/contact16.astro';
import FreshaHero from '@/components/freshaAlternative/FreshaHero.astro';
import FreshaVerdict from '@/components/freshaAlternative/FreshaVerdict.astro';
import FreshaReasons from '@/components/freshaAlternative/FreshaReasons.astro';
import FreshaCosts from '@/components/freshaAlternative/FreshaCosts.astro';
import FreshaOutcomes from '@/components/freshaAlternative/FreshaOutcomes.astro';
import FreshaCompare from '@/components/freshaAlternative/FreshaCompare.astro';
import FreshaFit from '@/components/freshaAlternative/FreshaFit.astro';
import FreshaSwitching from '@/components/freshaAlternative/FreshaSwitching.astro';
import FreshaPricing from '@/components/freshaAlternative/FreshaPricing.astro';
import FreshaSources from '@/components/freshaAlternative/FreshaSources.astro';
import FreshaJourneyRail from '@/components/freshaAlternative/FreshaJourneyRail.astro';
import ComparisonFinalCta from '@/components/comparison/ComparisonFinalCta.astro';
import CompareHubLink from '@/components/alternativesHub/CompareHubLink.astro';
import {
  FRESHA_ALTERNATIVE_DESCRIPTION,
  FRESHA_ALTERNATIVE_FAQ_ITEMS,
  FRESHA_ALTERNATIVE_PAGE_PATH,
  FRESHA_ALTERNATIVE_TITLE,
  buildFreshaAlternativeFaqJsonLd,
} from '@/lib/seo/freshaAlternativeFaq';
import {
  buildFreshaAlternativeBreadcrumbJsonLd,
  buildFreshaAlternativeWebPageJsonLd,
} from '@/lib/seo/freshaAlternativeJsonLd';
import {
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';
import '@/styles/components/ks-glass-card.css';
import '@/styles/components/fresha-alternative.css';
import '@/styles/components/fresha-journey.css';

const currentYear = new Date().getFullYear();
---

<LandingLayout
  title={FRESHA_ALTERNATIVE_TITLE}
  description={FRESHA_ALTERNATIVE_DESCRIPTION}
  canonicalPath={FRESHA_ALTERNATIVE_PAGE_PATH}
  jsonLd={[buildFreshaAlternativeWebPageJsonLd(), buildFreshaAlternativeBreadcrumbJsonLd(), buildFreshaAlternativeFaqJsonLd()]}
>
  <main class="fresha-alt fj landing-overflow-guard">
    <FreshaHero />
    <FreshaVerdict />
    <FreshaReasons />
    <FreshaCosts />
    <FreshaOutcomes />
    <FreshaCompare />
    <FreshaFit />
    <FreshaSwitching />
    <FreshaPricing />

    <Faq4
      className="faq4--landing"
      heading="Fresha alternative questions, answered"
      subHeading="Straight answers on commission, fees, pricing, switching and who each platform suits."
      supportHeading="Still comparing options?"
      supportText="Tell us what you use today and what you want your booking journey to look like."
      supportLinkLabel="Ask KERSIVO a question"
      supportLinkHref="#contact"
      faqs={FRESHA_ALTERNATIVE_FAQ_ITEMS}
    />

    <ComparisonFinalCta placement="fresha" competitor="Fresha" />

    <Contact16
      eyebrow="CONTACT KERSIVO"
      title="Thinking about leaving Fresha?"
      description="Tell us how your shop runs today and what you want to change. We’ll reply with a clear, practical answer for your barbershop."
      note="We’ll reply by email — no sales call required."
      submitLabel="Send my question"
      messagePlaceholder="For example: switching from Fresha, setting up deposits, moving client data or launching a new booking website."
    />

    <CompareHubLink />
    <FreshaSources />

    <Footer50
      showIntro={false}
      brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL}
      brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      social={getFooterSocialLinks()}
    />
  </main>
  <FreshaJourneyRail />
</LandingLayout>

<script>
  import { initFreshaJourney } from '@/lib/landing/freshaJourney';

  const boot = () => {
    const root = document.querySelector<HTMLElement>('main.fj');
    if (!root || root.dataset.fjBound === 'true') return;
    root.dataset.fjBound = 'true';
    const cleanup = initFreshaJourney(document);
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  };

  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style is:global>
  .landing-overflow-guard {
    overflow-x: clip;
  }
</style>
