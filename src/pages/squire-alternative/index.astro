---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Faq4 from '@/components/faq4.astro';
import Footer50 from '@/components/footer50.astro';
import Contact16 from '@/components/contact16.astro';
import SquireHero from '@/components/squireAlternative/SquireHero.astro';
import SquireSections from '@/components/squireAlternative/SquireSections.astro';
import FreshaProof from '@/components/freshaAlternative/FreshaProof.astro';
import FreshaPricing from '@/components/freshaAlternative/FreshaPricing.astro';
import FreshaFinalCta from '@/components/freshaAlternative/FreshaFinalCta.astro';
import {
  SQUIRE_ALTERNATIVE_DESCRIPTION,
  SQUIRE_ALTERNATIVE_FAQ_ITEMS,
  SQUIRE_ALTERNATIVE_PAGE_PATH,
  SQUIRE_ALTERNATIVE_TITLE,
  buildSquireAlternativeFaqJsonLd,
} from '@/lib/seo/squireAlternativeFaq';
import { buildSquireAlternativeWebPageJsonLd } from '@/lib/seo/squireAlternativeJsonLd';
import { FOOTER_LEGAL_LINKS, KERSIVO_CONTACT_EMAIL, getFooterSocialLinks } from '@/lib/seo/footerSocialLinks';
import '@/styles/components/fresha-alternative.css';
const currentYear = new Date().getFullYear();
---
<LandingLayout title={SQUIRE_ALTERNATIVE_TITLE} description={SQUIRE_ALTERNATIVE_DESCRIPTION}
  canonicalPath={SQUIRE_ALTERNATIVE_PAGE_PATH}
  jsonLd={[buildSquireAlternativeWebPageJsonLd(), buildSquireAlternativeFaqJsonLd()]}>
  <main class="fresha-alt landing-overflow-guard">
    <SquireHero />
    <SquireSections />
    <FreshaProof />
    <FreshaPricing />
    <Faq4 className="faq4--landing"
      heading="Questions about comparing SQUIRE and KERSIVO?"
      subHeading="Straight answers on UK availability, published prices, bookings, payments, branding and switching."
      supportHeading="Still comparing?"
      supportText="Tell us what your shop needs and we’ll help you work through the differences."
      supportLinkLabel="Ask KERSIVO a question"
      supportLinkHref="#contact"
      faqs={SQUIRE_ALTERNATIVE_FAQ_ITEMS} />
    <FreshaFinalCta />
    <Contact16 eyebrow="CONTACT KERSIVO" title="Still comparing KERSIVO and SQUIRE?"
      description="Tell us what you use today and what you want to change. We’ll reply with a practical answer for your barbershop."
      note="We’ll reply by email — no sales call required."
      submitLabel="Send my question"
      messagePlaceholder="For example: switching from SQUIRE, migrating bookings, own website and domain, or choosing the right KERSIVO plan." />
    <Footer50 showIntro={false} brandLine="Own your brand. Own your bookings."
      contactEmail={KERSIVO_CONTACT_EMAIL} brandName="KERSIVO"
      copyright={`© ${currentYear} KERSIVO`}
      navigation={[
        { name:'Home',href:'/' }, {name:'Live demo',href:'/demo'}, {name:'Pricing',href:'/pricing'},
        {name:'FAQ',href:'#faq'}, {name:'About',href:'/about'}, {name:'Contact',href:'#contact'},
        {name:'Start KERSIVO Starter',href:'/admin'}
      ]}
      social={getFooterSocialLinks()}
      legal={[FOOTER_LEGAL_LINKS.privacy,FOOTER_LEGAL_LINKS.cookies,FOOTER_LEGAL_LINKS.cookieSettings,FOOTER_LEGAL_LINKS.dpa,FOOTER_LEGAL_LINKS.termsAndCancellation]} />
  </main>
</LandingLayout>
<script>
  import { initFeature261StaggerReveal } from '@/lib/landing/initFeature261StaggerReveal';
  const scheduleInit = () => {
    requestAnimationFrame(() => {
      const section = document.querySelector('.feature261');
      if (!(section instanceof HTMLElement) || section.dataset.feature261Enhanced === 'true') return;
      const cleanup = initFeature261StaggerReveal(section);
      document.addEventListener('astro:before-swap', cleanup, { once: true });
    });
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', scheduleInit, {once:true});
  else scheduleInit();
  document.addEventListener('astro:page-load', scheduleInit);
</script>
<script>
  import { destroyProductRails, initProductRails } from '@/lib/shop/initProductRail';
  const bootProductRails = () => { destroyProductRails(); initProductRails(); };
  bootProductRails();
  document.addEventListener('astro:page-load',bootProductRails);
</script>
<style is:global>.landing-overflow-guard {overflow-x:clip;}</style>
