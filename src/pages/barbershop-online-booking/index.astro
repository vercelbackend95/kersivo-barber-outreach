---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Footer50 from '@/components/footer50.astro';
import OnlineBookingHero from '@/components/barbershop-online-booking/OnlineBookingHero.astro';
import OnlineBookingJourney from '@/components/barbershop-online-booking/OnlineBookingJourney.astro';
import OnlineBookingAvailability from '@/components/barbershop-online-booking/OnlineBookingAvailability.astro';
import OnlineBookingPayments from '@/components/barbershop-online-booking/OnlineBookingPayments.astro';
import OnlineBookingEntryPoints from '@/components/barbershop-online-booking/OnlineBookingEntryPoints.astro';
import OnlineBookingAfterBooking from '@/components/barbershop-online-booking/OnlineBookingAfterBooking.astro';
import OnlineBookingPlanChoice from '@/components/barbershop-online-booking/OnlineBookingPlanChoice.astro';
import {
  BARBERSHOP_ONLINE_BOOKING_PAGE_DESCRIPTION,
  BARBERSHOP_ONLINE_BOOKING_PAGE_INDEXABLE,
  BARBERSHOP_ONLINE_BOOKING_PAGE_PATH,
  BARBERSHOP_ONLINE_BOOKING_PAGE_TITLE,
  buildBarbershopOnlineBookingJsonLd,
} from '@/lib/seo/barbershopOnlineBookingPage';
import { BARBERSHOP_WEBSITES_PAGE_PATH } from '@/lib/seo/barbershopWebsitesPage';
import { BARBERSHOP_WEBSITE_DESIGN_PAGE_PATH } from '@/lib/seo/barbershopWebsiteDesignPage';
import {
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';

const currentYear = new Date().getFullYear();
---

<LandingLayout
  title={BARBERSHOP_ONLINE_BOOKING_PAGE_TITLE}
  description={BARBERSHOP_ONLINE_BOOKING_PAGE_DESCRIPTION}
  canonicalPath={BARBERSHOP_ONLINE_BOOKING_PAGE_PATH}
  noindex={!BARBERSHOP_ONLINE_BOOKING_PAGE_INDEXABLE}
  robotsFollow
  jsonLd={buildBarbershopOnlineBookingJsonLd()}
>
  <main class="bob-page">
    <OnlineBookingHero />
    <OnlineBookingJourney />
    <OnlineBookingAvailability />
    <OnlineBookingPayments />
    <OnlineBookingEntryPoints />
    <OnlineBookingAfterBooking />
    <OnlineBookingPlanChoice />
  </main>

  <Footer50
    showIntro={false}
    brandLine="Own your brand. Own your bookings."
    contactEmail={KERSIVO_CONTACT_EMAIL}
    brandName="KERSIVO"
    copyright={`© ${currentYear} KERSIVO`}
    social={getFooterSocialLinks()}
  />
</LandingLayout>
