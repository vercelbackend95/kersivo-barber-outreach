---
/**
 * /barbershop-website-design — owns "barbershop website design" (UK): a design guide (layout, visual
 * hierarchy, mobile UX, branding and photography) that also sells KERSIVO's design, with the free preview
 * as the primary action (audit P2-1). "Do I need a website / what should it include" intent belongs
 * to /barbershop-websites; do not repeat that page here. City pages own the local queries.
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import Footer50 from '@/components/footer50.astro';
import WdHero from '@/components/websiteDesign/WdHero.astro';
import WdAnswer from '@/components/websiteDesign/WdAnswer.astro';
import WdGlance from '@/components/websiteDesign/WdGlance.astro';
import WdMobile from '@/components/websiteDesign/WdMobile.astro';
import WdBrand from '@/components/websiteDesign/WdBrand.astro';
import WdPhoto from '@/components/websiteDesign/WdPhoto.astro';
import WdAudit from '@/components/websiteDesign/WdAudit.astro';
import WdOffer from '@/components/websiteDesign/WdOffer.astro';
import WdFaqClose from '@/components/websiteDesign/WdFaqClose.astro';
import {
  BARBERSHOP_WEBSITE_DESIGN_PAGE_INDEXABLE,
  BARBERSHOP_WEBSITE_DESIGN_PAGE_PATH,
  buildBarbershopWebsiteDesignFaqJsonLd,
  buildBarbershopWebsiteDesignJsonLd,
  buildBarbershopWebsiteDesignServiceJsonLd,
  getBarbershopWebsiteDesignSeo,
} from '@/lib/seo/barbershopWebsiteDesignPage';
import { isFreePreviewFlowEnabled } from '@/lib/freePreview/config';
import { getStaticPageLastModified } from '@/lib/seo/pageDates';
import {
  KERSIVO_CONTACT_EMAIL,
  getFooterSocialLinks,
} from '@/lib/seo/footerSocialLinks';
import '@/styles/components/website-design.css';

const currentYear = new Date().getFullYear();
const freePreview = isFreePreviewFlowEnabled();
const seo = getBarbershopWebsiteDesignSeo(freePreview);
---

<LandingLayout
  title={seo.title}
  description={seo.description}
  canonicalPath={BARBERSHOP_WEBSITE_DESIGN_PAGE_PATH}
  noindex={!BARBERSHOP_WEBSITE_DESIGN_PAGE_INDEXABLE}
  robotsFollow
  jsonLd={[
    buildBarbershopWebsiteDesignJsonLd(getStaticPageLastModified(BARBERSHOP_WEBSITE_DESIGN_PAGE_PATH), freePreview),
    buildBarbershopWebsiteDesignServiceJsonLd(),
    buildBarbershopWebsiteDesignFaqJsonLd(),
  ]}
>
  <link slot="head" rel="preload" as="image" href="/images/website-design/inspector-phone-top.webp" fetchpriority="high" />
  <main class="wd">
    <WdHero />
    <WdAnswer />
    <WdGlance />
    <WdMobile />
    <WdBrand />
    <WdPhoto />
    <WdAudit />
    <WdOffer />
    <WdFaqClose />
  </main>

  <Footer50
    showIntro={false}
    brandLine="Own your brand. Own your bookings."
    contactEmail={KERSIVO_CONTACT_EMAIL}
    brandName="KERSIVO"
    copyright={`© ${currentYear} KERSIVO`}
    social={getFooterSocialLinks()}
  />
</LandingLayout>

<script>
  import { initWebsiteDesign } from '@/lib/websiteDesign/initWebsiteDesign';

  let cleanup: (() => void) | null = null;
  const start = () => {
    cleanup?.();
    cleanup = document.querySelector('main.wd') ? initWebsiteDesign(document) : null;
  };
  start();
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
