generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  BOOKED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_ADMIN
  CANCELLED_BY_SHOP
  RESCHEDULED
  EXPIRED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum OrderStatus {
  PAID
  READY_FOR_PICKUP
  COLLECTED
}
enum ProductCategory {
  POMADES_AND_CLAYS
  BEARD_CARE
  HAIR_WASH
  STYLING
  TOOLS
  GIFT_SETS
}

// Dashboard login role within one shop (shopId).
enum ShopRole {
  OWNER
  MANAGER
  BARBER
}

/// Team membership usability. ACTIVE is written on invite acceptance.
/// NEW is legacy (pre–Phase 1C manual Activate); treat as joined in presentation/RBAC
/// until a future suspension model exists. Do not migrate away NEW yet.
enum TeamMemberStatus {
  NEW
  ACTIVE
}


model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  ownedShop     ShopSettings?
  shopMembers   ShopMember[]
  barberProfile Barber?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ShopSettings {
  id                          String   @id @default(cuid())
  name                        String
  timezone                    String   @default("Europe/London")
  cancellationWindowHours     Int      @default(2)
  rescheduleWindowHours       Int      @default(2)
  pendingConfirmationMins     Int      @default(15)
  slotIntervalMinutes         Int      @default(15)
  defaultBufferMinutes        Int      @default(0)
  customServiceCategories     String[] @default([])
  townCity                    String?
  logoUrl                     String?
  publicActivityPaused        Boolean  @default(false)
  publicActivityPausedAt      DateTime?
  publicActivityPauseFrom     DateTime?
  publicActivityPauseUntil    DateTime?
  publicActivityPauseReason   String?
  onboardingCompleted         Boolean  @default(false)
  onboardingCurrentStep       Int      @default(0)
  onboardingCompletedAt       DateTime?
  retailOnboardingCompleted   Boolean  @default(false)
  retailOnboardingSkipped     Boolean  @default(false)
  retailOnboardingCompletedAt DateTime?
  retailOnboardingProductId          String?
  retailTestOrderId                  String?
  retailTestOrderCompletedAt         DateTime?
  retailPickupWalkthroughCompletedAt DateTime?
  analyticsIncludeTestActivity       Boolean  @default(true)
  ownerUserId                 String?  @unique
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  owner                       User?    @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  members                     ShopMember[]
  invites                     ShopInvite[]
  clients                     Client[]
  timeBlocks                  TimeBlock[]
  products                    Product[]
  orders                      Order[]
  barbers                     Barber[]
  services                    Service[]
  openingHours                ShopOpeningHours[]
}

// Login membership for one shop — roles never keyed by shop name.
model ShopMember {
  id         String           @id @default(cuid())
  shopId     String
  userId     String
  role       ShopRole
  barberId   String?          @unique
  teamStatus TeamMemberStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  shop   ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  barber Barber?      @relation(fields: [barberId], references: [id], onDelete: SetNull)

  @@unique([shopId, userId])
  @@index([userId])
  @@index([shopId, role])
}

model ShopInvite {
  id              String   @id @default(cuid())
  shopId          String
  email           String
  role            ShopRole
  tokenHash       String   @unique
  barberId        String?
  displayName     String?
  bookable        Boolean  @default(true)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime @default(now())

  shop ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, email])
  @@index([expiresAt])
}


model Client {
  id        String   @id @default(cuid())
  shopId    String
  fullName  String?
  email     String
  phone     String?
  notes     String?
  avatarUrl String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop        ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  clientNotes ClientNote[]

  @@unique([shopId, email])
  @@index([shopId])
}

model ClientNote {
  id         String   @id @default(cuid())
  clientId   String
  barberId   String?
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  barber Barber? @relation(fields: [barberId], references: [id], onDelete: SetNull)
  likes  ClientNoteLike[]
  images ClientNoteImage[]

  @@index([clientId, createdAt])
}

model ClientNoteImage {
  id        String   @id @default(cuid())
  noteId    String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  note ClientNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, sortOrder])
}

model ClientNoteLike {
  id        String   @id @default(cuid())
  noteId    String
  barberId  String
  createdAt DateTime @default(now())

  note   ClientNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  barber Barber     @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([noteId, barberId])
  @@index([noteId])
}

model Service {
  id              String   @id @default(cuid())
  shopId          String
  name            String
  description     String?
  imageUrl        String?
  pricePence      Int
  durationMinutes Int
  bufferMinutes   Int      @default(0)
  displayOrder    Int      @default(0)
  category        String?
  featured        Boolean  @default(false)
  isActive        Boolean  @default(true) @map("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  shop            ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  barberServices  BarberService[]

  @@index([shopId, isActive, displayOrder])
  @@index([isActive, displayOrder])
}

model Barber {
  id           String             @id @default(cuid())
  shopId       String
  userId       String?            @unique
  name         String
  email        String?
  avatarUrl    String?
  active       Boolean            @default(true)
  sortOrder    Int                @default(0)
  // Intended dashboard role when Owner later invites this seat (MANAGER | BARBER).
  intendedRole ShopRole           @default(BARBER)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  shop         ShopSettings       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  membership   ShopMember?
  bookings     Booking[]
  rules        AvailabilityRule[]
  timeOff      BarberTimeOff[]
  timeBlocks   TimeBlock[]
  barberServices BarberService[]
  clientNotes    ClientNote[]
  noteLikes      ClientNoteLike[]

  @@index([shopId, active, sortOrder])
  @@index([active, sortOrder])
}

model ShopOpeningHours {
  id           String       @id @default(cuid())
  shopId       String
  dayOfWeek    Int
  startMinutes Int
  endMinutes   Int
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  shop         ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, dayOfWeek])
  @@index([shopId])
}

model BarberService {
  barberId  String
  serviceId String
  createdAt DateTime @default(now())

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@index([serviceId])
}


model AvailabilityRule {
  id            String   @id @default(cuid())
  barberId      String
  dayOfWeek     Int
  startMinutes  Int
  endMinutes    Int
  breakStartMin Int?
  breakEndMin   Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, dayOfWeek])
}

model BarberTimeOff {
  id        String   @id @default(cuid())
  barberId  String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startsAt, endsAt])
}

model TimeBlock {
  id        String   @id @default(cuid())
  shopId    String
  barberId  String?
  title     String
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop   ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barber Barber?      @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startAt])
  @@index([shopId, startAt])
}


model Booking {
  id                      String        @id @default(cuid())
  serviceId               String
  barberId                String
  fullName                String
  email                   String
  phone                   String?
  clientId                String?
  startAt                 DateTime
  endAt                   DateTime
  originalStartAt         DateTime?
  originalEndAt           DateTime?
  rescheduledAt           DateTime?
  status                  BookingStatus @default(BOOKED)
  notes                   String?
  parentBookingId         String?
  newBookingId            String?

  confirmTokenHash        String?
  confirmTokenExpiresAt   DateTime?
  manageTokenHash         String?
  manageTokenExpiresAt    DateTime?

  paymentRequired         Boolean       @default(false)
  depositAmountPence      Int?
  paymentStatus           PaymentStatus?
  stripeCheckoutSessionId String?
  paidAt                  DateTime?

  serviceNameAtBooking            String?
  servicePricePenceAtBooking      Int?
  serviceDurationMinutesAtBooking Int?
  totalPricePence                 Int?


  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  service Service @relation(fields: [serviceId], references: [id])
  barber  Barber  @relation(fields: [barberId], references: [id])
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([barberId, startAt, endAt])
  @@index([status])
  @@index([email])
  @@index([clientId])
}


model Product {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  description String?
  pricePence  Int
  imageUrl    String?
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
    category    ProductCategory @default(STYLING)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([shopId, active])
  @@index([shopId, sortOrder])
    @@unique([shopId, sortOrder])
}
model Order {
  id              String      @id @default(cuid())
  shopId          String
  customerEmail   String
  status          OrderStatus @default(PAID)
  currency        String      @default("gbp")
  totalPence      Int
  stripeSessionId String?     @unique
  isTestOrder     Boolean     @default(false)
  paidAt          DateTime?
  collectedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  shop  ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@index([shopId, isTestOrder])
}

model OrderItem {
  id                     String @id @default(cuid())
  orderId                String
  productId              String
  nameSnapshot           String
  unitPricePenceSnapshot Int
  quantity               Int
  lineTotalPence         Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}



model RateLimitEvent {
  id        String   @id @default(cuid())
  ip        String
  action    String
  createdAt DateTime @default(now())

  @@index([ip, action, createdAt])
}

enum SetupPlan {
  LAUNCH
  PRIORITY
}

enum SetupDepositStatus {
  PENDING
  PAID
}

model SetupDeposit {
  id                    String             @id @default(cuid())
  stripeSessionId       String             @unique
  paymentIntentId       String?
  plan                  SetupPlan
  status                SetupDepositStatus @default(PAID)
  customerName          String
  customerEmail         String
  shopName              String
  shopSize              String
  currentStack          String
  depositPence          Int
  currency              String             @default("gbp")
  paidAt                DateTime?
  customerEmailSentAt   DateTime?
  internalEmailSentAt   DateTime?
  onboardingSubmittedAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([customerEmail])
  @@index([customerEmail, status])
  @@index([plan, paidAt])
  @@index([paymentIntentId])
}

enum SaasSubscriptionStatus {
  PENDING
  ACTIVE
}

model SaasSubscription {
  id                    String                 @id @default(cuid())
  stripeSessionId       String                 @unique
  stripeSubscriptionId  String?
  status                SaasSubscriptionStatus @default(PENDING)
  customerName          String
  customerEmail         String
  shopName              String
  shopSize              String
  currentStack          String
  monthlyPence          Int
  currency              String                 @default("gbp")
  activatedAt           DateTime?
  customerEmailSentAt   DateTime?
  internalEmailSentAt   DateTime?
  onboardingSubmittedAt DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([customerEmail])
  @@index([customerEmail, status])
  @@index([stripeSubscriptionId])
}
