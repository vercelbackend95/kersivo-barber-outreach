generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  BOOKED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_ADMIN
  CANCELLED_BY_SHOP
  RESCHEDULED
  EXPIRED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum OrderStatus {
  PAID
  COLLECTED
}
enum ProductCategory {
  POMADES_AND_CLAYS
  BEARD_CARE
  HAIR_WASH
  STYLING
  TOOLS
  GIFT_SETS
}


model ShopSettings {
  id                          String   @id @default(cuid())
  name                        String
  timezone                    String   @default("Europe/London")
  cancellationWindowHours     Int      @default(2)
  rescheduleWindowHours       Int      @default(2)
  pendingConfirmationMins     Int      @default(15)
  slotIntervalMinutes         Int      @default(15)
  defaultBufferMinutes        Int      @default(0)
  customServiceCategories     String[] @default([])
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  clients                     Client[]
  timeBlocks                  TimeBlock[]
  products                    Product[]
  orders                      Order[]
}


model Client {
  id        String   @id @default(cuid())
  shopId    String
  fullName  String?
  email     String
  phone     String?
  notes     String?
  avatarUrl String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop     ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([shopId, email])
  @@index([shopId])
}

model Service {
  id              String   @id @default(cuid())
  name            String
    description     String?
  pricePence      Int
  durationMinutes Int
  bufferMinutes   Int      @default(0)
  displayOrder    Int      @default(0)
  category        String?
  isActive        Boolean  @default(true) @map("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bookings        Booking[]
  barberServices  BarberService[]
    @@index([isActive, displayOrder])
}

model Barber {
  id         String             @id @default(cuid())
  name       String
  email      String?
  avatarUrl  String?
  active     Boolean            @default(true)
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  bookings   Booking[]
  rules      AvailabilityRule[]
  timeOff    BarberTimeOff[]
  timeBlocks TimeBlock[]
  barberServices BarberService[]
  @@index([active, sortOrder])
}
model BarberService {
  barberId  String
  serviceId String
  createdAt DateTime @default(now())

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@index([serviceId])
}


model AvailabilityRule {
  id            String   @id @default(cuid())
  barberId      String
  dayOfWeek     Int
  startMinutes  Int
  endMinutes    Int
  breakStartMin Int?
  breakEndMin   Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, dayOfWeek])
}

model BarberTimeOff {
  id        String   @id @default(cuid())
  barberId  String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startsAt, endsAt])
}

model TimeBlock {
  id        String   @id @default(cuid())
  shopId    String
  barberId  String?
  title     String
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop   ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barber Barber?      @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startAt])
  @@index([shopId, startAt])
}


model Booking {
  id                      String        @id @default(cuid())
  serviceId               String
  barberId                String
  fullName                String
  email                   String
  phone                   String?
  clientId                String?
  startAt                 DateTime
  endAt                   DateTime
  originalStartAt         DateTime?
  originalEndAt           DateTime?
  rescheduledAt           DateTime?
  status                  BookingStatus @default(BOOKED)
  notes                   String?
  parentBookingId         String?
  newBookingId            String?

  confirmTokenHash        String?
  confirmTokenExpiresAt   DateTime?
  manageTokenHash         String?
  manageTokenExpiresAt    DateTime?

  paymentRequired         Boolean       @default(false)
  depositAmountPence      Int?
  paymentStatus           PaymentStatus?
  stripeCheckoutSessionId String?
  paidAt                  DateTime?

  serviceNameAtBooking            String?
  servicePricePenceAtBooking      Int?
  serviceDurationMinutesAtBooking Int?
  totalPricePence                 Int?


  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  service Service @relation(fields: [serviceId], references: [id])
  barber  Barber  @relation(fields: [barberId], references: [id])
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([barberId, startAt, endAt])
  @@index([status])
  @@index([email])
  @@index([clientId])
}


model Product {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  description String?
  pricePence  Int
  imageUrl    String?
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
    category    ProductCategory @default(STYLING)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([shopId, active])
  @@index([shopId, sortOrder])
    @@unique([shopId, sortOrder])
}
model Order {
  id              String      @id @default(cuid())
  shopId          String
  customerEmail   String
  status          OrderStatus @default(PAID)
  currency        String      @default("gbp")
  totalPence      Int
  stripeSessionId String?     @unique
  paidAt          DateTime?
  collectedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  shop  ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([shopId, createdAt])
  @@index([shopId, status])
}

model OrderItem {
  id                     String @id @default(cuid())
  orderId                String
  productId              String
  nameSnapshot           String
  unitPricePenceSnapshot Int
  quantity               Int
  lineTotalPence         Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}



model RateLimitEvent {
  id        String   @id @default(cuid())
  ip        String
  action    String
  createdAt DateTime @default(now())

  @@index([ip, action, createdAt])
}

enum SetupPlan {
  LAUNCH
  PRIORITY
}

enum SetupDepositStatus {
  PAID
}

model SetupDeposit {
  id                    String             @id @default(cuid())
  stripeSessionId       String             @unique
  plan                  SetupPlan
  status                SetupDepositStatus @default(PAID)
  customerName          String
  customerEmail         String
  shopName              String
  shopSize              String
  currentStack          String
  depositPence          Int
  currency              String             @default("gbp")
  paidAt                DateTime
  onboardingSubmittedAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([customerEmail])
  @@index([plan, paidAt])
}
