generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  BOOKED
  PENDING_PAYMENT
  CANCELLED_BY_CLIENT
  CANCELLED_BY_ADMIN
  CANCELLED_BY_SHOP
  RESCHEDULED
  EXPIRED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DepositRefundStatus {
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

enum SmsOutboundPurpose {
  APPOINTMENT_REMINDER
}

enum SmsOutboundStatus {
  QUEUED
  SENT
  FAILED
}

enum EmailOutboundPurpose {
  APPOINTMENT_REMINDER
  BOOKING_CONFIRMATION
  BOOKING_RESCHEDULED
  SHOP_ORDER_CONFIRMATION
  /// Late deposit payment after hold release when the slot was taken — refund notice.
  DEPOSIT_REFUNDED_SLOT_LOST
}

enum EmailOutboundStatus {
  QUEUED
  SENT
  FAILED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  READY_FOR_PICKUP
  COLLECTED
}

enum ProductCategory {
  POMADES_AND_CLAYS
  BEARD_CARE
  HAIR_WASH
  STYLING
  TOOLS
  GIFT_SETS
}

// Dashboard login role within one shop (shopId).
enum ShopRole {
  OWNER
  MANAGER
  BARBER
}

/// Team membership usability. ACTIVE is written on invite acceptance.
/// NEW is legacy (pre–Phase 1C manual Activate); treat as joined in presentation/RBAC
/// until a future suspension model exists. Do not migrate away NEW yet.
enum TeamMemberStatus {
  NEW
  ACTIVE
}

model User {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  ownedShop     ShopSettings?
  shopMembers   ShopMember[]
  barberProfile Barber?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ShopSettings {
  id                                 String             @id @default(cuid())
  name                               String
  timezone                           String             @default("Europe/London")
  cancellationWindowHours            Int                @default(24)
  rescheduleWindowHours              Int                @default(24)
  maxClientReschedules               Int                @default(2)
  pendingConfirmationMins            Int                @default(15)
  slotIntervalMinutes                Int                @default(15)
  defaultBufferMinutes               Int                @default(0)
  customServiceCategories            String[]           @default([])
  townCity                           String?
  logoUrl                            String?
  publicActivityPaused               Boolean            @default(false)
  publicActivityPausedAt             DateTime?
  publicActivityPauseFrom            DateTime?
  publicActivityPauseUntil           DateTime?
  publicActivityPauseReason          String?
  onboardingCompleted                Boolean            @default(false)
  onboardingCurrentStep              Int                @default(0)
  onboardingCompletedAt              DateTime?
  retailOnboardingCompleted          Boolean            @default(false)
  retailOnboardingSkipped            Boolean            @default(false)
  retailOnboardingCompletedAt        DateTime?
  retailOnboardingProductId          String?
  retailTestOrderId                  String?
  retailTestOrderCompletedAt         DateTime?
  retailPickupWalkthroughCompletedAt DateTime?
  analyticsIncludeTestActivity       Boolean            @default(true)
  /// Set true on paid SaaS subscription webhook; SMS cron skips shops where false.
  smsRemindersEnabled                Boolean            @default(false)
  /// Shared paid-tenant marker (SaaS webhook). Prefer this over coupling features to SMS flag.
  shopPaidAt                         DateTime?
  /// Owner toggle: require £5 deposit on online bookings (paid shops + Connect only).
  depositsEnabled                    Boolean            @default(false)
  /// Owner toggle: accept public retail checkout on Connect (paid shops + Connect only).
  retailEnabled                      Boolean            @default(false)
  /// Stripe Connect Express account id for booking deposits (and future shop payouts).
  stripeConnectAccountId             String?
  stripeConnectChargesEnabled        Boolean            @default(false)
  stripeConnectDetailsSubmitted      Boolean            @default(false)
  /// Stripe event.created of the last applied account.updated (ordering guard).
  connectStatusEventAt               DateTime?
  /// Private preview URL set by OPS when tenant site is ready for owner review.
  sitePreviewUrl                     String?
  /// Canonical site version label (e.g. "2026-07-29a") set alongside preview URL.
  sitePreviewVersion                 String?
  sitePreviewReadyAt                 DateTime?
  /// Set when Owner clicks Approve & launch for the current sitePreviewVersion.
  launchApprovedAt                   DateTime?
  launchApprovedByUserId             String?
  launchApprovedByEmail              String?
  launchApprovedVersion              String?
  /// Recorded at approve time; physical DNS switch = OPS.
  goLiveAt                           DateTime?
  ownerUserId                        String?            @unique
  createdAt                          DateTime           @default(now())
  updatedAt                          DateTime           @updatedAt
  owner                              User?              @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  members                            ShopMember[]
  invites                            ShopInvite[]
  clients                            Client[]
  timeBlocks                         TimeBlock[]
  products                           Product[]
  orders                             Order[]
  barbers                            Barber[]
  services                           Service[]
  openingHours                       ShopOpeningHours[]
  clientOnboarding                   ClientOnboarding?
  clientOnboardingBarberProfiles     ClientOnboardingBarberProfile[]
  clientOnboardingAssets             ClientOnboardingAsset[]
}

// Login membership for one shop — roles never keyed by shop name.
model ShopMember {
  id         String           @id @default(cuid())
  shopId     String
  userId     String
  role       ShopRole
  barberId   String?          @unique
  teamStatus TeamMemberStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  shop   ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  barber Barber?      @relation(fields: [barberId], references: [id], onDelete: SetNull)

  @@unique([shopId, userId])
  @@index([userId])
  @@index([shopId, role])
}

model ShopInvite {
  id              String    @id @default(cuid())
  shopId          String
  email           String
  role            ShopRole
  tokenHash       String    @unique
  barberId        String?
  displayName     String?
  bookable        Boolean   @default(true)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  shop ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, email])
  @@index([expiresAt])
}

model Client {
  id        String   @id @default(cuid())
  shopId    String
  fullName  String?
  email     String
  phone     String?
  notes     String?
  avatarUrl String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop        ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  clientNotes ClientNote[]

  @@unique([shopId, email])
  @@index([shopId])
}

model ClientNote {
  id         String   @id @default(cuid())
  clientId   String
  barberId   String?
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  client Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  barber Barber?           @relation(fields: [barberId], references: [id], onDelete: SetNull)
  likes  ClientNoteLike[]
  images ClientNoteImage[]

  @@index([clientId, createdAt])
}

model ClientNoteImage {
  id        String   @id @default(cuid())
  noteId    String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  note ClientNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, sortOrder])
}

model ClientNoteLike {
  id        String   @id @default(cuid())
  noteId    String
  barberId  String
  createdAt DateTime @default(now())

  note   ClientNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  barber Barber     @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([noteId, barberId])
  @@index([noteId])
}

model Service {
  id              String          @id @default(cuid())
  shopId          String
  name            String
  description     String?
  imageUrl        String?
  pricePence      Int
  durationMinutes Int
  bufferMinutes   Int             @default(0)
  displayOrder    Int             @default(0)
  category        String?
  featured        Boolean         @default(false)
  isActive        Boolean         @default(true) @map("active")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  shop            ShopSettings    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  barberServices  BarberService[]

  @@index([shopId, isActive, displayOrder])
  @@index([isActive, displayOrder])
}

model Barber {
  id             String             @id @default(cuid())
  shopId         String
  userId         String?            @unique
  name           String
  email          String?
  avatarUrl      String?
  active         Boolean            @default(true)
  sortOrder      Int                @default(0)
  // Intended dashboard role when Owner later invites this seat (MANAGER | BARBER).
  intendedRole   ShopRole           @default(BARBER)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  shop           ShopSettings       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  membership     ShopMember?
  bookings       Booking[]
  rules          AvailabilityRule[]
  timeOff        BarberTimeOff[]
  timeBlocks     TimeBlock[]
  barberServices BarberService[]
  clientNotes    ClientNote[]
  noteLikes      ClientNoteLike[]
  clientOnboardingProfile ClientOnboardingBarberProfile?

  @@index([shopId, active, sortOrder])
  @@index([active, sortOrder])
}

model ShopOpeningHours {
  id           String       @id @default(cuid())
  shopId       String
  dayOfWeek    Int
  startMinutes Int
  endMinutes   Int
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  shop         ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, dayOfWeek])
  @@index([shopId])
}

model BarberService {
  barberId  String
  serviceId String
  createdAt DateTime @default(now())

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@index([serviceId])
}

model AvailabilityRule {
  id            String   @id @default(cuid())
  barberId      String
  dayOfWeek     Int
  startMinutes  Int
  endMinutes    Int
  breakStartMin Int?
  breakEndMin   Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, dayOfWeek])
}

model BarberTimeOff {
  id        String   @id @default(cuid())
  barberId  String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startsAt, endsAt])
}

model TimeBlock {
  id        String   @id @default(cuid())
  shopId    String
  barberId  String?
  title     String
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop   ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barber Barber?      @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startAt])
  @@index([shopId, startAt])
}

model Booking {
  id              String        @id @default(cuid())
  serviceId       String
  barberId        String
  fullName        String
  email           String
  phone           String?
  clientId        String?
  startAt         DateTime
  endAt           DateTime
  originalStartAt DateTime?
  originalEndAt   DateTime?
  rescheduledAt   DateTime?
  status          BookingStatus @default(BOOKED)
  notes           String?
  parentBookingId String?
  newBookingId    String?

  confirmTokenHash      String?
  confirmTokenExpiresAt DateTime?
  manageTokenHash       String?
  manageTokenExpiresAt  DateTime?

  paymentRequired         Boolean        @default(false)
  depositAmountPence      Int?
  paymentStatus           PaymentStatus?
  /// Stripe Checkout Session for the deposit; unique so one session maps to one booking.
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  depositRefundedAt       DateTime?
  depositForfeitedAt      DateTime?
  clientRescheduleCount   Int            @default(0)
  paymentExpiresAt        DateTime?

  serviceNameAtBooking            String?
  servicePricePenceAtBooking      Int?
  serviceDurationMinutesAtBooking Int?
  totalPricePence                 Int?

  /// When the appointment reminder SMS was successfully sent.
  smsReminderSentAt     DateTime?
  /// `startAt` value the reminder SMS was sent for (reschedule clears / re-arms).
  smsReminderForStartAt DateTime?

  /// When the appointment reminder email was successfully sent.
  emailReminderSentAt     DateTime?
  /// `startAt` value the reminder email was sent for (reschedule clears / re-arms).
  emailReminderForStartAt DateTime?

  /// Client-supplied key scoped as `${shopId}:${key}` — prevents duplicate bookings on retry.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service       Service               @relation(fields: [serviceId], references: [id])
  barber        Barber                @relation(fields: [barberId], references: [id])
  client        Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  smsOutbound   SmsOutbound[]
  emailOutbound EmailOutbound[]
  depositRefund BookingDepositRefund?

  @@index([barberId, startAt, endAt])
  @@index([status])
  @@index([email])
  @@index([clientId])
  @@index([status, startAt])
  @@index([status, paymentExpiresAt])
}

/// Durable ledger for booking-deposit refunds (retry, webhook confirm, ops repair).
model BookingDepositRefund {
  id                    String              @id @default(cuid())
  bookingId             String              @unique
  shopId                String
  status                DepositRefundStatus @default(REFUND_PENDING)
  amountPence           Int
  reason                String
  idempotencyKey        String              @unique
  stripeRefundId        String?             @unique
  stripePaymentIntentId String
  connectAccountId      String?
  attempts              Int                 @default(0)
  maxAttempts           Int                 @default(6)
  nextAttemptAt         DateTime?
  lastAttemptAt         DateTime?
  lastError             String?
  confirmedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([shopId, createdAt])
}

/// Internal SMS send log (ops/debug — no admin UI in v1).
model SmsOutbound {
  id                String             @id @default(cuid())
  shopId            String
  bookingId         String?
  toE164            String
  body              String
  purpose           SmsOutboundPurpose
  provider          String
  providerMessageId String?
  status            SmsOutboundStatus  @default(QUEUED)
  error             String?
  createdAt         DateTime           @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([shopId, createdAt])
}

/// Durable email outbox (transactional + reminders). Payload cleared on SENT.
model EmailOutbound {
  id                String               @id @default(cuid())
  shopId            String
  bookingId         String?
  toEmail           String
  subject           String
  purpose           EmailOutboundPurpose
  provider          String
  providerMessageId String?
  status            EmailOutboundStatus  @default(QUEUED)
  error             String?
  /// Replayable send payload: { to, subject, html, replyTo? }. Cleared when SENT.
  payload           Json?
  attempts          Int                  @default(0)
  maxAttempts       Int                  @default(6)
  nextAttemptAt     DateTime?
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([shopId, createdAt])
  @@index([status, nextAttemptAt])
}

model Product {
  id          String          @id @default(cuid())
  shopId      String
  name        String
  description String?
  pricePence  Int
  imageUrl    String?
  active      Boolean         @default(true)
  featured    Boolean         @default(false)
  category    ProductCategory @default(STYLING)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  shop       ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([shopId, sortOrder])
  @@index([shopId, active])
  @@index([shopId, sortOrder])
}

model Order {
  id                     String      @id @default(cuid())
  shopId                 String
  customerEmail          String
  status                 OrderStatus @default(PAID)
  currency               String      @default("gbp")
  totalPence             Int
  /// Human pickup reference shown at the chair (e.g. KRV-A1B2).
  reference              String?     @unique
  stripeSessionId        String?     @unique
  stripePaymentIntentId  String?
  stripeConnectAccountId String?
  isTestOrder            Boolean     @default(false)
  paidAt                 DateTime?
  collectedAt            DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  shop  ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@index([shopId, isTestOrder])
}

model OrderItem {
  id                     String @id @default(cuid())
  orderId                String
  productId              String
  nameSnapshot           String
  unitPricePenceSnapshot Int
  quantity               Int
  lineTotalPence         Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  ip        String
  action    String
  createdAt DateTime @default(now())

  @@index([ip, action, createdAt])
}

enum SetupPlan {
  LAUNCH
  PRIORITY
}

enum SetupDepositStatus {
  PENDING
  PAID
}

model SetupDeposit {
  id                    String             @id @default(cuid())
  stripeSessionId       String             @unique
  paymentIntentId       String?
  plan                  SetupPlan
  status                SetupDepositStatus @default(PAID)
  customerName          String
  customerEmail         String
  shopName              String
  shopSize              String
  currentStack          String
  depositPence          Int
  currency              String             @default("gbp")
  paidAt                DateTime?
  customerEmailSentAt   DateTime?
  internalEmailSentAt   DateTime?
  onboardingSubmittedAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([customerEmail])
  @@index([customerEmail, status])
  @@index([plan, paidAt])
  @@index([paymentIntentId])
}

enum SaasSubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

model SaasSubscription {
  id                     String                 @id @default(cuid())
  stripeSessionId        String                 @unique
  stripeSubscriptionId   String?                @unique
  /// Stable client checkout attempt id (UUID) for session reuse / Stripe Idempotency-Key.
  checkoutAttemptId      String?                @unique
  stripeCustomerId       String?
  shopId                 String?
  status                 SaasSubscriptionStatus @default(PENDING)
  cancelAtPeriodEnd      Boolean                @default(false)
  currentPeriodEnd       DateTime?
  canceledAt             DateTime?
  pastDueSince           DateTime?
  suspendedAt            DateTime?
  retentionEndsAt        DateTime?
  dataExportDownloadedAt DateTime?
  customerName           String
  customerEmail          String
  shopName               String
  shopSize               String
  currentStack           String
  monthlyPence           Int
  currency               String                 @default("gbp")
  activatedAt            DateTime?
  customerEmailSentAt    DateTime?
  internalEmailSentAt    DateTime?
  onboardingSubmittedAt  DateTime?
  /// Stripe event.created of the last applied lifecycle webhook (ordering guard).
  lastStripeEventAt      DateTime?
  lastStripeEventId      String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([customerEmail])
  @@index([customerEmail, status])
  @@index([stripeCustomerId])
  @@index([shopId])
  @@index([status, pastDueSince])
  @@index([status, retentionEndsAt])
}

/// Survives user/shop deletion (snapshot fields only — no FK cascade).
model AccountLifecycleEvent {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  email     String?
  shopId    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([userId])
  @@index([shopId])
  @@index([email])
}

/// Proof of Terms acceptance at checkout (H05). No FK cascade — audit survives deletes.
model LegalAcceptance {
  id              String   @id @default(cuid())
  purpose         String
  termsVersion    String
  acceptedAt      DateTime @default(now())
  userId          String?
  email           String
  shopId          String?
  stripeSessionId String?
  ip              String?
  userAgent       String?
  meta            Json?
  createdAt       DateTime @default(now())

  @@index([email, createdAt])
  @@index([stripeSessionId])
  @@index([purpose, createdAt])
}

/// Audit trail for site preview delivery and Approve & launch (H05 cz.2). No FK cascade.
model SiteLaunchEvent {
  id          String   @id @default(cuid())
  shopId      String
  action      String // PREVIEW_READY | APPROVED | PREVIEW_UPDATED
  siteVersion String?
  previewUrl  String?
  userId      String?
  email       String?
  ip          String?
  userAgent   String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([action, createdAt])
}

enum StripeWebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

/// Ledger of Stripe webhook events (evt_…) for ops alerting / replay triage (M02).
model StripeWebhookEvent {
  id             String                   @id // evt_…
  type           String
  livemode       Boolean                  @default(false)
  status         StripeWebhookEventStatus @default(RECEIVED)
  error          String?
  httpStatus     Int?
  /// Stripe event.created (for replay/triage); distinct from local createdAt.
  eventCreatedAt DateTime?
  createdAt      DateTime                 @default(now())
  processedAt    DateTime?

  @@index([status, createdAt])
  @@index([type, createdAt])
}

/// Durable alert cooldown keys for AlertSink (M02).
model OpsAlertDedupe {
  dedupeKey  String   @id
  lastSentAt DateTime @default(now())
}

/// Post-purchase delivery onboarding (replaces Tally materials form). Distinct from workspace `/admin/onboarding`.
enum ClientOnboardingStatus {
  DRAFT
  SUBMITTED
  NEEDS_CHANGES
  READY_FOR_BUILD
}

enum ClientOnboardingDomainMode {
  EXISTING
  KERSIVO_REGISTER
  UNDECIDED
}

enum ClientOnboardingAssetKind {
  BRAND_LOGO
  GALLERY_IMAGE
  BRAND_GUIDELINES
  MIGRATION_CSV
  OTHER
}

model ClientOnboarding {
  id     String @id @default(cuid())
  shopId String @unique

  status      ClientOnboardingStatus @default(DRAFT)
  currentStep Int                    @default(0)
  submittedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  /// Business / contact (delivery snapshot — not a second ShopSettings)
  legalBusinessName  String?
  businessType       String?
  companyNumber      String?
  addressLine1       String?
  addressLine2       String?
  townCity           String?
  postcode           String?
  publicEmail        String?
  publicPhone        String?
  primaryContactName String?
  primaryContactEmail String?

  /// Website / brand
  tagline                 String?
  shopDescription         String? @db.Text
  websiteNotes            String? @db.Text
  currentWebsiteUrl       String?
  instagramUrl            String?
  facebookUrl             String?
  tiktokUrl               String?
  otherSocialUrl          String?
  brandNotes              String? @db.Text
  preferredPrimaryColour  String?
  preferredSecondaryColour String?

  /// Domain
  domainMode                       ClientOnboardingDomainMode @default(UNDECIDED)
  existingDomain                   String?
  domainRegistrar                  String?
  preferredDomain1                 String?
  preferredDomain2                 String?
  preferredDomain3                 String?
  domainRegistrationAuthorised     Boolean                   @default(false)
  domainRegistrationAuthorisedAt   DateTime?

  /// Migration intake (no automated import in this foundation)
  migrationRequested            Boolean @default(false)
  migrationSource               String?
  migrationSourceOther          String?
  migrationNotes                String? @db.Text
  migrationDataConfirmedLawful  Boolean @default(false)
  migrationDataConfirmedAt      DateTime?

  /// Launch preferences
  launchRetail             Boolean?
  launchDeposits           Boolean?
  retailProductsDeferred   Boolean  @default(false)
  notificationReplyToEmail String?
  additionalNotes          String?  @db.Text

  /// Optional marketing / portfolio permissions — never default true
  portfolioConsent           Boolean   @default(false)
  socialMediaConsent         Boolean   @default(false)
  advertisingConsent         Boolean   @default(false)
  caseStudyConsent           Boolean   @default(false)
  marketingConsentUpdatedAt  DateTime?

  /// Final declarations
  contentRightsConfirmed       Boolean   @default(false)
  informationAccuracyConfirmed Boolean   @default(false)
  declarationsConfirmedAt      DateTime?

  shop           ShopSettings                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barberProfiles ClientOnboardingBarberProfile[]
  assets         ClientOnboardingAsset[]

  @@index([status, submittedAt])
}

/// Delivery-only website profile for a workspace Barber (bio / showOnWebsite). Avatar stays on Barber.
model ClientOnboardingBarberProfile {
  id             String   @id @default(cuid())
  shopId         String
  onboardingId   String
  barberId       String   @unique
  bio            String?  @db.Text
  showOnWebsite  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop       ShopSettings     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  onboarding ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  barber     Barber           @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([onboardingId])
}

/// Private Blob metadata for post-purchase onboarding files (never store file bytes / base64 here).
model ClientOnboardingAsset {
  id               String                    @id @default(cuid())
  shopId           String
  onboardingId     String
  kind             ClientOnboardingAssetKind
  storagePath      String
  originalFileName String
  contentType      String
  sizeBytes        Int
  createdAt        DateTime                  @default(now())

  shop       ShopSettings     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  onboarding ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@index([shopId, kind])
  @@index([onboardingId])
  @@unique([onboardingId, storagePath])
}
