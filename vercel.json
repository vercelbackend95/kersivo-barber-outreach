{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.kersivo.co.uk" }],
      "destination": "https://kersivo.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "barberdemo.kersivo.co.uk" }],
      "destination": "https://kersivo.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/barbershop-booking-system",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/barbershop-booking-system/",
      "destination": "/",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sms-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/email-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/expire-deposit-holds",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/retry-deposit-refunds",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/email-outbox",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/saas-lifecycle",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ops-health",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/ops/synthetic-booking",
      "schedule": "*/15 * * * *"
    }
  ]
}
