  "devDependencies": {
    "@astrojs/vercel": "^9.0.4",
    "@fontsource/caveat": "^5.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "playwright": "^1.59.1",
    "prisma": "^5.22.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "to-ico": "^1.1.5",
    "tsx": "^4.20.3",
    "vitest": "^2.1.9"
