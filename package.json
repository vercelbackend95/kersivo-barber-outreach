{
  "name": "kersivo-barber-outreach",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run prisma:generate && astro build",
    "preview": "npm run prisma:generate && astro preview",
    "astro": "astro",
    "prisma": "prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "dev:with-generate": "npm run prisma:generate && astro dev",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "seed": "prisma db seed",
    "test": "vitest run",
    "vercel:dev": "vercel dev",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "screenshots:feature261": "node scripts/capture-feature261-screens.mjs",
    "enhance:timeline": "node scripts/enhance-timeline-screenshot.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^4.0.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@astrojs/vercel": "^9.0.4",
    "@tailwindcss/vite": "^4.2.2",
    "playwright": "^1.59.1",
    "prisma": "^5.22.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.3",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
