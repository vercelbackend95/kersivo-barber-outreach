# Neon Postgres: copy the connection string from the Neon dashboard (project must be active).
# Append ?sslmode=require if the URL does not already include sslmode.
# For Vercel or other serverless hosts, prefer the pooled connection string (hostname contains "-pooler").
# If Prisma returns P1001 but TCP 5432 is reachable, append:
#   &options=endpoint%3D<your_neon_endpoint_id>
DATABASE_URL=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=   # verified Resend sender
CONTACT_INBOX_EMAIL=hello@kersivo.co.uk

# Public site + setup flow
PUBLIC_SITE_URL=https://kersivo.co.uk
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Comma-separated or JSON array of public profile URLs for schema.org sameAs
PUBLIC_SOCIAL_PROFILES=
# Optional footer social profile URLs (only rendered when set to real https URLs)
PUBLIC_INSTAGRAM_URL=https://www.instagram.com/kersivo.barber/
PUBLIC_TIKTOK_URL=https://www.tiktok.com/@kersivo
PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61570721186194
# Optional @handle for twitter:site (e.g. kersivo or @kersivo)
PUBLIC_TWITTER_HANDLE=
SETUP_ONBOARDING_FORM_URL=https://tally.so/r/XXXXX
# Required for setup-deposit confirmation emails + /setup/success CTA. Use the real production Tally form URL.

PUBLIC_CALENDLY_URL=   # optional

ALLOWED_ORIGINS=
ALLOW_VERCEL_PREVIEW_ORIGINS=
# Use sk_test_… locally / sandbox; sk_live_… only in production live checkout.
STRIPE_SECRET_KEY=
# Must match the Stripe webhook endpoint mode (test vs live) for https://kersivo.co.uk/api/shop/webhook
STRIPE_WEBHOOK_SECRET=
ADMIN_SECRET=

# Admin AI Assistant (OpenAI). Required for /api/admin/ai/chat streaming.
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# shadcnblocks Pro: CLI only (https://www.shadcnblocks.com/dashboard/api). Not used at runtime.
SHADCNBLOCKS_API_KEY=
