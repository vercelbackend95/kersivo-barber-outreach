# Copy into .env / Vercel. Required for private demo auth.

# Better Auth (required for sessions)
BETTER_AUTH_SECRET=
# Base URL of this app (no trailing slash). Used to build OAuth callback URLs.
BETTER_AUTH_URL=http://localhost:4321

# Google OAuth — required for "Continue with Google"
# Create a Web application OAuth client in Google Cloud Console, then set:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI (must match exactly):
#   http://localhost:4321/api/auth/callback/google
#   https://kersivo.co.uk/api/auth/callback/google  (production)
# Optional public hint for the frontend (same value as GOOGLE_CLIENT_ID):
PUBLIC_GOOGLE_CLIENT_ID=

# Existing
# ADMIN_SECRET=
# DATABASE_URL=
# PUBLIC_SITE_URL=
