# Copy into .env / Vercel. Required for private demo auth.

# Better Auth (required for sessions)
BETTER_AUTH_SECRET=
# Base URL of this app (no trailing slash). Used to build OAuth callback URLs.
BETTER_AUTH_URL=http://localhost:4321

# Google OAuth — required for "Continue with Google"
# Create a Web application OAuth client in Google Cloud Console, then set:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI (must match exactly):
#   http://localhost:4321/api/auth/callback/google
#   https://kersivo.co.uk/api/auth/callback/google  (production)
# Optional public hint for the frontend (same value as GOOGLE_CLIENT_ID):
PUBLIC_GOOGLE_CLIENT_ID=

# Existing
# ADMIN_SECRET=
# DATABASE_URL=
# PUBLIC_SITE_URL=

# Vercel Blob — public website images (logos, product/service images, avatars)
# BLOB_READ_WRITE_TOKEN=
# VERCEL_BLOB_READ_WRITE_TOKEN=
# Exact public store hostname only (no token parsing). Fail-closed when unset/invalid.
# Example shape only — replace with your public store host, never commit real production values:
# PUBLIC_BLOB_STORE_HOST=your_store_id.public.blob.vercel-storage.com
PUBLIC_BLOB_STORE_HOST=
# Private Blob store (Client notes / onboarding) — never use for public list/delete
# PRIVATE_BLOB_READ_WRITE_TOKEN=

# Analytics / Ads (public; set on Vercel Production for live measurement)
# GA4 measurement ID (G-...)
PUBLIC_GA4_MEASUREMENT_ID=
# GA4 Measurement Protocol API secret (Admin > Data streams). Server-side free-preview events; without it they are skipped.
GA4_MEASUREMENT_PROTOCOL_API_SECRET=
# Google Ads tag ID (AW-...)
PUBLIC_GOOGLE_ADS_ID=
# Purchase conversion label only (the part after AW-…/ in send_to), not the full send_to string
PUBLIC_GOOGLE_ADS_PURCHASE_CONVERSION_LABEL=

# Smart Retail recommendations
# OPENAI_API_KEY is required for production recommendation catalogue builds and for live calibration.
# Configure it separately for local development and for each required Vercel environment (Preview/Production).
# Never commit a real key — leave this placeholder empty.
OPENAI_API_KEY=
# OPENAI_RECOMMENDATION_MODEL controls the production recommendation model (and live calibration snapshot).
OPENAI_RECOMMENDATION_MODEL=gpt-4o-mini-2024-07-18

# Smart Retail Control Room (server-only). Comma-separated exact Better Auth emails
# that may access /api/ops/recommendations*. Emails must be verified. Never expose
# this value to the browser. Leave empty to deny all operator access (fail closed).
KERSIVO_OPS_EMAILS=

# Free website preview (src/lib/freePreview/config.ts). Only the exact value "true" switches the public flow on.
FREE_PREVIEW_FLOW_ENABLED=
# Requests per Europe/London day before owners are told it may take longer. Default 3; 0 flags every request.
FREE_PREVIEW_DAILY_CAP=3
# Internal notifications for new requests. Defaults to hello@kersivo.co.uk.
PREVIEW_NOTIFY_EMAIL=
